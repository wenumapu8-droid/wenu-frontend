---
/**
 * /experience/cosmos — DIMENSIONAL PORTAL (restored 2026-07-06).
 *
 * WHY THIS IS A REDIRECT:
 * Every "dimensional portal" door on the site (home portal-seal, RitualProductHero,
 * contact portal, EmberCore, Immersive) links to `/experience/cosmos` and promises
 * "a map of Mapuche cosmovision" — the star-map experience with Kai Kai Vilu &
 * Treng Treng (flood serpents), Wüñelfe (the morning star / Venus, the eight-pointed
 * star of platería mapuche), Pewma (dream), and the interactive word-explore glossary.
 *
 * That dimensional experience is the standalone app at `/experience/` (a 4.6k-line
 * self-contained HTML with its own service worker + wenu-assets/). It was NEVER an
 * Astro page. For a stretch, `/experience/cosmos` served a product-forward "Enter the
 * Collection" demo instead — so the dimensional doors landed on a shop page, not the
 * cosmovision map. This redirect reconnects the doors to the real portal.
 *
 * The product-forward version is preserved (not deleted) at
 *   src/pages/experience/cosmos-collection.astro.bak
 * If Ocin wants that staged-collection page back at its own URL, revive the .bak.
 *
 * SSG-safe redirect: static meta-refresh + canonical + JS fallback. No runtime.
 */
const target = '/experience/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <title>Entering the portal — Wenu Mapu</title>
    <style>
      html, body { margin: 0; height: 100%; background: #080706; color: #f0ede8; }
      body {
        display: grid; place-items: center; min-height: 100svh;
        font-family: 'Cormorant Garamond', Georgia, serif; letter-spacing: 0.08em;
      }
      a { color: #c9a84c; }
      @media (prefers-reduced-motion: no-preference) {
        .dot { animation: pulse 1.6s ease-in-out infinite; }
      }
      @keyframes pulse { 0%,100% { opacity: .35 } 50% { opacity: 1 } }
    </style>
  </head>
  <body>
    <p class="dot">Entering the portal… <a href={target}>continue →</a></p>
    <script is:inline>window.location.replace('/experience/');</script>
  </body>
</html>
