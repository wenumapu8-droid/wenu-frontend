---
import Base from '../layouts/Base.astro';

/* /initial-jewelry — the complete, closed menu of what we put in a FRESH piercing.
 *
 * Why this page exists (Ocin, 2026-07-13): the studio only ever installs
 * implant-grade titanium (Ti-6Al-4V ELI ASTM F-136), factory-sterilised by
 * ethylene oxide, individually packaged with a lot number and a sterilisation
 * date. The shop catalogue (horn, bloodwood, brass, resin, stone) is for HEALED
 * wear only. This page makes that boundary impossible to misread.
 *
 * The titanium is INCLUDED in the piercing fee. Solid 14kt gold ends are an
 * UPGRADE priced in three tiers. Nothing else is offered for a fresh piercing —
 * that closure is the point of the page, not a limitation to apologise for.
 *
 * Artwork is authored as inline SVG on purpose: dark-first, on-brand, no
 * supplier photography on white backgrounds, no image pipeline dependency.
 * Prices mirror 20-Operaciones/lista-precios-piercing-2026-07-13.md and the
 * service fees already encoded in constelaciones.astro.
 */

/* TITANIUM — real photography on black (Ocin sent the knockout shots 2026-07-13),
 * to match the gold. The old inline SVGs are gone: real hardware on obsidian reads
 * as the actual thing we open in front of the client, not a diagram of it. */
type Piece = {
  id: string;
  name: string;
  spec: string;         // gauge / length, as printed by the manufacturer
  use: string;          // where it goes, terse
  img: string;
  alt: string;
};

const titanium: Piece[] = [
  {
    id: 'labret-threadless',
    name: 'Threadless labret post',
    spec: '16g · 7/16"–5/16" · also 18g',
    use: 'Lobe · helix · flat · tragus · conch',
    img: '/img/initial/titanium-labret-post.png',
    alt: 'A titanium labret post with a ball top and a flat disc back, on black.',
  },
  {
    id: 'labret-internal',
    name: 'Internally threaded labret',
    spec: '16g · 5/16" · 3mm back',
    use: 'Lobe · helix · flat',
    img: '/img/initial/titanium-labret-internal.png',
    alt: 'Two titanium labret posts with flat disc backs, on black.',
  },
  {
    id: 'barbell-straight',
    name: 'Straight barbell',
    spec: '14g · 5/8"',
    use: 'Industrial · tongue · nipple',
    img: '/img/initial/titanium-barbell-straight.png',
    alt: 'Two straight titanium barbells with a ball at each end, on black.',
  },
  {
    id: 'barbell-curved',
    name: 'Curved barbell',
    spec: '16g · 5/16"',
    use: 'Rook · eyebrow · daith',
    img: '/img/initial/titanium-barbell-curved.png',
    alt: 'Two curved titanium barbells with a ball at each end, on black.',
  },
  {
    id: 'barbell-curved-disc',
    name: 'Curved barbell, flat disc',
    spec: '3/8"',
    use: 'Deeper anatomy',
    img: '/img/initial/titanium-barbell-curved-disc.png',
    alt: 'Two curved titanium barbells with a flat disc back, on black.',
  },
  {
    id: 'ring-segment',
    name: 'Hinged segment ring',
    spec: '16g · 5/16" & 3/8"',
    use: 'Septum · daith · helix · nostril',
    img: '/img/initial/titanium-segment-ring.png',
    alt: 'Three seamless hinged titanium segment rings in ascending sizes, on black.',
  },
  {
    id: 'barbell-circular',
    name: 'Circular barbell',
    spec: '16g · 3/8" · 4mm beads',
    use: 'Septum · nostril',
    img: '/img/initial/titanium-circular-barbell.png',
    alt: 'A titanium circular barbell (horseshoe) with a ball at each end, on black.',
  },
  {
    id: 'end-flat-disc',
    name: 'Threadless flat disc end',
    spec: '3mm',
    use: 'Flat · low-profile back',
    img: '/img/initial/titanium-flat-disc.png',
    alt: 'Three titanium flat disc ends in ascending sizes beside a threadless post, on black.',
  },
  {
    id: 'navel-cz',
    name: 'Bezel-set CZ navel ring',
    spec: '14g · 7/16" · clear CZ',
    use: 'Navel',
    img: '/img/initial/titanium-navel-cz.png',
    alt: 'A titanium navel curved barbell with a large clear CZ below and a small one above, on black.',
  },
];

const steel: Piece = {
  id: 'cbr',
  name: 'Captive bead ring',
  spec: '16g · surgical steel · pre-sterilised',
  use: 'The only steel piece here — a captive bead when the placement calls for one.',
  img: '/img/initial/steel-cbr.png',
  alt: 'A surgical-steel captive bead ring, its bead held in the gap, on black.',
};

/* GOLD — real photography, not SVG.
 *
 * Deliberate split (Ocin sent the black-background shots on 2026-07-13):
 *   · Titanium is a SPEC. Nine forms, told as diagram — an SVG reads cleaner
 *     than nine photos of near-identical silver hardware, and it scales.
 *   · Gold is DESIRE. Nobody upgrades to a 14kt end because of a diagram. The
 *     opal has to shimmer, the amethyst has to be violet, the hammered disk has
 *     to catch light unevenly. That only happens in a photograph.
 *
 * The files are the supplier shots with the background knocked out to pure
 * black by Ocin, so they sit on obsidian with no seam. Drop them in
 * public/img/initial/ under exactly these names.
 */
type Gold = {
  id: string;
  name: string;
  spec: string;
  note: string;
  tier: 1 | 2 | 3;
  img: string;
  alt: string;
};

const gold: Gold[] = [
  {
    id: 'g-cz',
    name: 'Gold CZ prong pin',
    spec: '14kt yellow gold · 1.5mm · clear CZ',
    note: 'The smallest light you can wear. Reads as a single point of white.',
    tier: 1,
    img: '/img/initial/gold-cz-prong.png',
    alt: 'A clear cubic zirconia held in gold claws on a threadless post, photographed on black.',
  },
  {
    id: 'g-opal',
    name: 'Gold opal cabochon',
    spec: '14kt yellow gold · 2mm · opal',
    note: 'A dome, not a facet. It shifts colour with the angle of the room.',
    tier: 1,
    img: '/img/initial/gold-opal-cabochon.png',
    alt: 'An opal cabochon in a polished gold bezel, its surface flashing green and pink, on black.',
  },
  {
    id: 'g-disk',
    name: 'Gold disk',
    spec: '14kt yellow gold · 2.5mm',
    note: 'Plain, polished, absolute. The end that never goes out of date.',
    tier: 2,
    img: '/img/initial/gold-disk.png',
    alt: 'A plain polished gold disc on a threadless post, photographed on black.',
  },
  {
    id: 'g-hammer',
    name: 'Hammered disk',
    spec: '14kt yellow gold · 3mm',
    note: 'Struck by hand so the surface holds light unevenly, like water.',
    tier: 2,
    img: '/img/initial/gold-hammered-disk.png',
    alt: 'A gold disc covered in hand-struck dimples that catch the light unevenly, on black.',
  },
  {
    id: 'g-ceres',
    name: 'Ceres top',
    spec: '14kt yellow gold · pear + round amethyst',
    note: 'A drop and a point above it. Worn vertically, it lengthens the ear.',
    tier: 3,
    img: '/img/initial/gold-ceres-top.png',
    alt: 'A pear-cut violet amethyst with a small round stone above it, set in gold claws, on black.',
  },
  {
    id: 'g-trinity',
    name: 'Trinity top',
    spec: '14kt yellow gold · three stones',
    note: 'Three stones in a trefoil. The most light on the smallest footprint.',
    tier: 3,
    img: '/img/initial/gold-trinity-top.png',
    alt: 'Three round white stones set in a trefoil in gold claws, photographed on black.',
  },
];

const tiers = [
  { n: 1, label: 'Tier I',   price: 60,  members: 'CZ prong pin · Opal cabochon' },
  { n: 2, label: 'Tier II',  price: 80,  members: 'Gold disk · Hammered disk' },
  { n: 3, label: 'Tier III', price: 120, members: 'Ceres top · Trinity top' },
];

const fees = [
  { zone: 'Lobe · second lobe · high lobe · stacked lobe', fee: 80 },
  { zone: 'Helix · flat · forward helix · tragus', fee: 85 },
  { zone: 'Rook · daith · conch · snug', fee: 90 },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What jewellery do you put in a fresh piercing?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Implant-grade titanium only — Ti-6Al-4V ELI, ASTM F-136. It arrives sterilised by the manufacturer with ethylene oxide gas, individually packaged, and every pouch carries a sterilisation date and a lot number. The titanium is included in the piercing fee. Solid 14kt gold ends are available as an upgrade.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I bring my own jewellery, or use a piece from the shop?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Not for a fresh piercing. The pieces in our shop — horn, bloodwood, brass, resin, stone — are made for healed wear. They are porous or reactive and cannot be sterilised to the standard a fresh wound requires. Once you are fully healed, all of it is open to you.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is the gold an extra cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The titanium is included in the piercing fee. A solid 14kt gold end is an upgrade, priced in three tiers: 60, 80 or 120 US dollars added to the fee.',
      },
    },
  ],
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wenumapuonline.com/' },
    { '@type': 'ListItem', position: 2, name: 'Piercing', item: 'https://wenumapuonline.com/piercing' },
    { '@type': 'ListItem', position: 3, name: 'Initial jewelry', item: 'https://wenumapuonline.com/initial-jewelry' },
  ],
};
---

<Base
  title="Initial jewelry — implant-grade titanium, and nothing else | Wenu Mapu"
  description="The complete menu of what we install in a fresh piercing: implant-grade titanium (Ti-6Al-4V ELI, ASTM F-136), factory-sterilised, individually packaged with lot number and date. Included in the fee. Solid 14kt gold available as an upgrade."
  ogImage="/img/brand/meteorite-collection.webp"
  jsonLd={[faqLd, breadcrumbLd]}
>
  <article class="ij">

    <!-- ── HERO ─────────────────────────────────────────────── -->
    <header class="ij__head">
      <p class="eyebrow">Initial jewelry · Piercing service</p>
      <h1 class="ij__title">These are the options. All of them.</h1>
      <p class="ij__lede">
        Every fresh piercing starts in implant-grade titanium — included in the fee.
        Solid 14kt gold is the only upgrade. Nothing else goes into a new piercing.
      </p>
      <ul class="ij__chips" role="list">
        <li>Ti-6Al-4V ELI · ASTM F-136</li>
        <li>Factory-sterilised (EtO)</li>
        <li>Sealed, lot &amp; date</li>
        <li>Titanium included</li>
      </ul>
    </header>

    <!-- ── TITANIUM ─────────────────────────────────────────── -->
    <section class="ij__band" aria-labelledby="ti-title">
      <div class="ij__band-head">
        <p class="ij__band-n">01</p>
        <h2 class="ij__band-title" id="ti-title">Titanium</h2>
        <p class="ij__band-price">Included</p>
      </div>
      <p class="ij__band-lede">
        Nine forms, one for every placement. Which one you get is chosen at the
        appointment, by your anatomy.
      </p>

      <ul class="ij__grid" role="list">
        {titanium.map(p => (
          <li class="ij__card">
            <figure class="ij__photo ij__photo--ti">
              <img src={p.img} alt={p.alt} width="620" height="620" loading="lazy" decoding="async" />
            </figure>
            <h3 class="ij__card-name">{p.name}</h3>
            <p class="ij__card-spec">{p.spec}</p>
            <p class="ij__card-where">{p.use}</p>
          </li>
        ))}
      </ul>

      <!-- the single steel exception, called out honestly -->
      <div class="ij__exception">
        <figure class="ij__photo ij__photo--ti ij__photo--sm">
          <img src={steel.img} alt={steel.alt} width="440" height="440" loading="lazy" decoding="async" />
        </figure>
        <div class="ij__exception-body">
          <p class="ij__exception-tag">One exception</p>
          <h3 class="ij__card-name">{steel.name}</h3>
          <p class="ij__card-spec">{steel.spec}</p>
          <p class="ij__card-use">{steel.use}</p>
        </div>
      </div>
    </section>

    <!-- ── GOLD ─────────────────────────────────────────────── -->
    <section class="ij__band ij__band--gold" aria-labelledby="gold-title">
      <div class="ij__band-head">
        <p class="ij__band-n">02</p>
        <h2 class="ij__band-title" id="gold-title">Solid 14kt gold</h2>
        <p class="ij__band-price ij__band-price--gold">Upgrade</p>
      </div>
      <p class="ij__band-lede">
        The post stays titanium — only the end that shows is gold. Six ends, three
        prices. Added to the fee.
      </p>

      <ul class="ij__tiers" role="list">
        {tiers.map(t => (
          <li class="ij__tier">
            <p class="ij__tier-label">{t.label}</p>
            <p class="ij__tier-price">+${t.price}</p>
            <p class="ij__tier-members">{t.members}</p>
          </li>
        ))}
      </ul>

      <ul class="ij__grid ij__grid--gold" role="list">
        {gold.map(g => (
          <li class="ij__card ij__card--gold">
            <figure class="ij__photo">
              <img
                src={g.img}
                alt={g.alt}
                width="620"
                height="620"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <p class="ij__card-tier">Tier {['', 'I', 'II', 'III'][g.tier]} · +${tiers[g.tier - 1].price}</p>
            <h3 class="ij__card-name">{g.name}</h3>
            <p class="ij__card-spec">{g.spec}</p>
            <p class="ij__card-use">{g.note}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── WHAT IT COSTS ────────────────────────────────────── -->
    <section class="ij__band" aria-labelledby="cost-title">
      <div class="ij__band-head">
        <p class="ij__band-n">03</p>
        <h2 class="ij__band-title" id="cost-title">What it costs</h2>
      </div>
      <p class="ij__band-lede">
        The fee covers everything — consultation, piercing, titanium, aftercare.
        Gold is the only extra.
      </p>

      <div class="ij__table-wrap">
        <table class="ij__table">
          <thead>
            <tr>
              <th scope="col">Placement</th>
              <th scope="col">Titanium<span>included</span></th>
              <th scope="col">+ Tier I<span>+$60</span></th>
              <th scope="col">+ Tier II<span>+$80</span></th>
              <th scope="col">+ Tier III<span>+$120</span></th>
            </tr>
          </thead>
          <tbody>
            {fees.map(f => (
              <tr>
                <th scope="row">{f.zone}</th>
                <td class="ij__td-base">${f.fee}</td>
                <td>${f.fee + 60}</td>
                <td>${f.fee + 80}</td>
                <td>${f.fee + 120}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="ij__table-foot">
        Prices in USD. Fresh piercings only: titanium and gold. The shop —
        horn, wood, brass, stone — is for healed wear.
        <a href="/care-guide">Why →</a>
      </p>
    </section>

    <!-- ── CTA ──────────────────────────────────────────────── -->
    <section class="ij__cta" aria-labelledby="cta-title">
      <p class="eyebrow">Truckee, California</p>
      <h2 class="ij__cta-title" id="cta-title">Come and be pierced</h2>
      <div class="ij__cta-row">
        <a class="btn btn--solid" href="/piercing">Book a piercing</a>
        <a class="btn btn--ghost" href="/constelaciones">Design your ear</a>
      </div>
    </section>

  </article>

  <style>
    .ij {
      max-width: 1180px;
      margin: 0 auto;
      padding: clamp(2.5rem, 6vw, 5rem) clamp(1.1rem, 4vw, 2.5rem) 6rem;
      color: var(--bone);
    }

    /* ── head ── */
    .ij__head { max-width: 46rem; margin-bottom: clamp(3rem, 7vw, 5rem); }
    .ij__title {
      font-family: 'Instrument Serif', serif;
      font-size: clamp(2.4rem, 6.4vw, 4.2rem);
      line-height: 1.04;
      letter-spacing: -0.015em;
      margin: 0.5rem 0 1.4rem;
      color: var(--bone);
    }
    .ij__lede {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.12rem, 2.1vw, 1.42rem);
      line-height: 1.62;
      color: var(--silver);
      max-width: 40rem;
      margin: 0 0 1.5rem;
    }

    /* ── spec chips (replace the old prose "standard" block) ── */
    .ij__chips {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .ij__chips li {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--silver);
      border: 1px solid rgba(201, 168, 76, 0.3);
      padding: 0.4rem 0.7rem;
      white-space: nowrap;
    }

    /* ── bands ── */
    .ij__band { margin-bottom: clamp(3.5rem, 8vw, 6rem); }
    .ij__band-head {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      flex-wrap: wrap;
      padding-bottom: 0.9rem;
      border-bottom: 1px solid rgba(184, 180, 170, 0.18);
      margin-bottom: 1.5rem;
    }
    .ij__band-n {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 0.66rem;
      letter-spacing: 0.2em;
      color: var(--bronze);
      margin: 0;
    }
    .ij__band-title {
      font-family: 'Instrument Serif', serif;
      font-size: clamp(1.7rem, 4vw, 2.6rem);
      margin: 0;
      color: var(--bone);
      flex: 1 1 auto;
    }
    .ij__band-price {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 0.64rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--obsidian);
      background: var(--silver);
      padding: 0.36rem 0.7rem;
      margin: 0;
      white-space: nowrap;
    }
    .ij__band-price--gold { background: var(--ember); }
    .ij__band-lede {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.06rem, 2vw, 1.28rem);
      line-height: 1.6;
      color: var(--sand);
      max-width: 42rem;
      margin: 0 0 2.2rem;
    }

    /* ── grid of pieces ── */
    .ij__grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
      gap: 1px;
      background: rgba(184, 180, 170, 0.14);
      border: 1px solid rgba(184, 180, 170, 0.14);
    }
    .ij__card {
      background: var(--charcoal);
      padding: 1.5rem 1.25rem 1.6rem;
      min-width: 0;
      display: flex;
      flex-direction: column;
      transition: background 0.4s ease;
    }
    .ij__card:hover { background: #171717; }

    /* Real photography (titanium AND gold), on a FIXED-DARK plate.
       The shots are knocked out to pure black. The plate is near-black, so the
       seam vanishes — and because the plate is fixed (not themed), the pieces
       keep their volume in the Solar theme too instead of blowing out on white.
       Same pattern as .design-ear-plate on /piercing. No blend modes: those
       invert on a light background. */
    .ij__photo {
      margin: 0 auto 1.1rem;
      width: 100%;
      max-width: 9.5rem;
      aspect-ratio: 1 / 1;
      background: #050505;
      border: 1px solid rgba(201, 168, 76, 0.14);
      display: grid;
      place-items: center;
      overflow: hidden;
    }
    /* titanium plate: cooler hairline (silver, not ember) to read as steel not gold */
    .ij__photo--ti { border-color: rgba(184, 180, 170, 0.16); }
    .ij__photo--sm { max-width: 6rem; margin: 0; }
    .ij__photo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
      transform: scale(1.02);
      transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .ij__card:hover .ij__photo img { transform: scale(1.08); }
    @media (prefers-reduced-motion: reduce) {
      .ij__photo img,
      .ij__card:hover .ij__photo img { transition: none; transform: none; }
    }
    .ij__card-tier {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 0.6rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ember);
      margin: 0 0 0.5rem;
    }
    .ij__card-name {
      font-family: 'Instrument Sans', system-ui, sans-serif;
      font-size: 0.98rem;
      font-weight: 500;
      line-height: 1.3;
      color: var(--bone);
      margin: 0 0 0.45rem;
    }
    .ij__card-spec {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 0.66rem;
      line-height: 1.6;
      letter-spacing: 0.03em;
      color: var(--bronze);
      margin: 0 0 0.8rem;
      word-break: break-word;
    }
    .ij__card--gold .ij__card-spec { color: var(--ember); opacity: 0.8; }
    /* titanium cards: placement as a terse label, not prose */
    .ij__card-where {
      font-family: 'Instrument Sans', system-ui, sans-serif;
      font-size: 0.78rem;
      line-height: 1.45;
      color: var(--sand);
      margin: auto 0 0;
      padding-top: 0.6rem;
    }
    /* gold cards + steel exception: one short desire line */
    .ij__card-use {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.02rem;
      line-height: 1.5;
      color: var(--sand);
      margin: 0;
    }

    /* ── steel exception ── */
    .ij__exception {
      margin-top: 1.6rem;
      border: 1px dashed rgba(184, 180, 170, 0.28);
      padding: 1.4rem;
      display: flex;
      gap: 1.4rem;
      align-items: center;
      flex-wrap: wrap;
    }
    .ij__exception-body { flex: 1 1 16rem; min-width: 0; }
    .ij__exception-tag {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--bronze);
      margin: 0 0 0.4rem;
    }

    /* ── tiers ── */
    .ij__tiers {
      list-style: none;
      margin: 0 0 2.2rem;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
      gap: 1px;
      background: rgba(201, 168, 76, 0.24);
      border: 1px solid rgba(201, 168, 76, 0.24);
    }
    .ij__tier {
      background: var(--obsidian);
      padding: 1.25rem 1.15rem;
      min-width: 0;
    }
    .ij__tier-label {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
