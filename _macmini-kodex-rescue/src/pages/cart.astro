---
import Base from '../layouts/Base.astro';
---
<Base
  title="Your selection — Wenu Mapu"
  description="Your cart — review your gathered pieces and continue to checkout."
  noQuote
>
  <section class="section section--mega">
    <div class="container" style="min-height: 46vh;">
      <p class="eyebrow">Your selection</p>
      <h1 class="page-title">The bundle</h1>
      <p class="lede" data-cart-page-msg>
        Loading your gathered pieces…
      </p>
      <div class="cart-page__actions" style="display:flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-4);">
        <button type="button" class="btn btn--solid" data-cart-open>Open cart &amp; checkout →</button>
        <a href="/shop" class="btn btn--ghost">Continue browsing</a>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const msg = document.querySelector('[data-cart-page-msg]');
      const c = (window).wmCart;
      const n = c ? c.count() : 0;
      if (msg) {
        msg.innerHTML = n > 0
          ? `You have <strong>${n}</strong> ${n === 1 ? 'piece' : 'pieces'} gathered. Opening your cart…`
          : 'Your cart is empty. <a href="/shop" class="text-accent">Browse the archive →</a>';
      }
      if (c && n > 0) c.open();
    });
  </script>
</Base>
