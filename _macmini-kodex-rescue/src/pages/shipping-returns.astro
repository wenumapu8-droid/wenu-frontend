---
/**
 * /shipping-returns — legacy URL, now a 301-style redirect to the canonical
 * /shipping policy page. Kept so old inbound links keep working, but no longer
 * duplicates the content (SEO fix, audit 2026-07-17). SSG-safe: meta-refresh +
 * canonical + JS fallback, noindex. No runtime.
 */
const target = '/shipping/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <title>Shipping &amp; Returns — Wenu Mapu</title>
    <style>
      html, body { margin: 0; height: 100%; background: #080706; color: #f0ede8; }
      body { display: grid; place-items: center; min-height: 100svh;
        font-family: 'Cormorant Garamond', Georgia, serif; letter-spacing: 0.08em; }
      a { color: #c9a84c; }
    </style>
  </head>
  <body>
    <p>Taking you to shipping &amp; returns… <a href={target}>continue →</a></p>
    <script is:inline>window.location.replace('/shipping/');</script>
  </body>
</html>
