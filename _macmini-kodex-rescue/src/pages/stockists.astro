---
import Base from '../layouts/Base.astro';
import PatternBand from '../components/PatternBand.astro';
import en from '../i18n/en.json';
import { buildLocalBusinessLd } from '../lib/localBusiness';

const presence = [
  { city: 'Truckee, California',          context: 'Workshop visits by appointment. Pickup for online orders.', kind: 'workshop', current: true },
  { city: 'Reno, Nevada',                 context: 'Quarterly piercing pop-ups at partner studios.',             kind: 'popup',    current: true },
  { city: 'North Lake Tahoe, California', context: 'Local pickup zone, no permanent presence.',                  kind: 'pickup',   current: true },
  { city: 'Southern Chile',               context: 'Annual return for Mapuche craft markets and material sourcing.', kind: 'travel',  current: true },
];

// LocalBusiness (JewelryStore) JSON-LD — same canonical NAP as /contact, see
// src/lib/localBusiness.ts. NO street address (private, shared after
// booking).
const localBusinessLd = buildLocalBusinessLd({
  description: "Private appointments and free local delivery in the Truckee / North Lake Tahoe / Reno area. Handcrafted ritual body jewelry and professional piercing — implant-grade titanium, sterling silver, 14k gold, Atacama meteorite.",
  image: 'https://wenumapuonline.com/img/truckee/showcase.webp',
});
---
<Base
  title="Presences & Appointments — Wenu Mapu"
  description="Where Wenu Mapu is met in person — Truckee appointments, Lake Tahoe pickup and occasional pop-ups. Wholesale remains unavailable."
  ogImage="/img/truckee/showcase.webp"
  jsonLd={localBusinessLd}
>
  <section class="section section--mega">
    <div class="container">
      <p class="eyebrow">PRESENCE · IN PERSON</p>
      <h1 class="page-title">{en.about.stockists.heading}</h1>
      <p class="lede">{en.about.stockists.intro}</p>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>

      <ul class="stockists-list">
        {presence.map(p => (
          <li class="stockists-list__item">
            <div class="stockists-list__row">
              <span class="stockists-list__kind">{p.kind}</span>
              <h2 class="stockists-list__city">{p.city}</h2>
              {p.current && <span class="stockists-list__active">Active</span>}
            </div>
            <p class="stockists-list__context">{p.context}</p>
          </li>
        ))}
      </ul>

      <div class="stockists-apply">
        <h2 class="stockists-apply__title">Wholesale is not open right now.</h2>
        <p class="stockists-apply__body">
          Wenu Mapu is staying focused on direct retail, private appointments and careful stock growth before opening any stockist or wholesale lane.
        </p>
        <p class="stockists-apply__body">
          If you want to experience the work in person, request a private appointment in Truckee or coordinate local pickup after ordering online.
        </p>
        <a href="/local" class="btn btn--solid stockists-apply__cta">Request appointment →</a>
      </div>
    </div>
  </section>
</Base>
