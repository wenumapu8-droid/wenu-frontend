---
import Base from '../../layouts/Base.astro';
import KodexObserveScene from '../../components/kodex/scenes/KodexObserveScene.astro';

const sceneNotes = [
  'Carril aislado: no toca el deck live de /kodex/.',
  'Shader OBSERVE en violeta + WebGL pointer/audio/state contract.',
  'Siguiente etapa: enchufe con motores KDX y transición real hacia threshold/descent.',
];
---

<Base
  title="KODEX Lab — Observe Prototype"
  description="Private KODEX shader lab for OBSERVE prototype validation."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div class="kdx-lab-shell">
    <KodexObserveScene sceneIndex={1} sceneTotal={7} signalLabel="LAB · OBSERVE" />

    <aside class="kdx-lab-meta">
      <a href="/kodex/">← volver a /kodex/</a>
      <strong>KODEX LAB / OBSERVE</strong>
      <ul>
        {sceneNotes.map((note) => <li>{note}</li>)}
      </ul>
      <p>Tip: agregá <code>?debug=1</code> para overlay técnico.</p>
    </aside>
  </div>

  <style>
    .kdx-lab-shell {
      position: relative;
      min-height: 100vh;
      background: #050409;
    }

    .kdx-lab-meta {
      position: fixed;
      left: 18px;
      bottom: 88px;
      z-index: 20;
      width: min(320px, calc(100vw - 36px));
      padding: 12px 14px;
      border: 1px solid rgba(196, 176, 255, 0.24);
      background: rgba(5, 4, 9, 0.78);
      color: #d7d0e7;
      font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      backdrop-filter: blur(8px);
    }

    .kdx-lab-meta a,
    .kdx-lab-meta code {
      color: #b59aff;
    }

    .kdx-lab-meta strong {
      display: block;
      margin-top: 8px;
      letter-spacing: 0.14em;
    }

    .kdx-lab-meta ul {
      margin: 10px 0 0;
      padding-left: 16px;
    }

    .kdx-lab-meta p {
      margin: 10px 0 0;
      color: #a7a0b7;
    }

    @media (max-width: 760px) {
      .kdx-lab-meta {
        top: auto;
        bottom: 76px;
        font-size: 11px;
      }
    }
  </style>
</Base>
