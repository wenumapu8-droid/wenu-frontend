---
/**
 * Ear stretching / upsize guide (2026-06-29).
 * Resuelve el link "Full stretching guide →" de PiercingAftercare.astro (antes 404).
 * DOWNSIZE no se duplica: vive en PiercingAftercare + healing-reminder → se enlaza a /piercing#aftercare.
 * Fuentes verificadas en Obsidian `20-Operaciones/contraindicaciones-piercing-2026-06-29.md`
 * (Urban Body Jewelry, PlugYourHoles, Body Art Forms, Lynn Loheide, BodyCandy, Omerica, Healthline).
 * Encuadre OBLIGATORIO: guía educativa + "consult your piercer". Sin promesas médicas.
 */
import Base from '../layouts/Base.astro';
import PatternBand from '../components/PatternBand.astro';

const rules = [
  {
    k: 'One size at a time',
    v: 'Move up a single gauge per stretch — about 1 mm. Never skip a size: forcing two or three gauges at once is how lobes tear.',
  },
  {
    k: 'Never rush the wait',
    v: 'Give a stretch time to fully heal before the next. A common rhythm is 4–6+ weeks at smaller gauges, and 2–3 months or more once you reach larger sizes.',
  },
  {
    k: 'Stretch only when healed',
    v: 'A stretch is ready for the next size only when the last one is calm — flexible, no redness, no discharge, no tenderness. If in doubt, wait longer.',
  },
];

const readySigns = [
  'The previous stretch is fully healed and calm.',
  'The lobe feels soft and flexible, not tight or shiny.',
  'Jewelry moves freely with no pain.',
  'No redness, swelling, or discharge.',
];

const stopSigns = [
  'Pain while inserting — pain is never part of a correct stretch.',
  'Bleeding, or a tight, shiny, stretched-thin look.',
  'Redness, irritation, or weeping from the channel.',
  'A "blowout" — a ring of tissue pushed out behind the lobe.',
];

const practices = [
  {
    k: 'Tapers are for insertion only',
    v: 'Use a taper to ease jewelry in slowly — then wear a plug, not the taper. Lubricate both the taper and the lobe before inserting.',
  },
  {
    k: 'Safe materials',
    v: 'Borosilicate glass and implant-grade titanium (ASTM F-136) are non-porous, autoclavable and kind to fresh stretches. Skip acrylic — it is porous and harbours bacteria. Organic plugs (wood, stone, bone) are for healed, settled lobes only.',
  },
  {
    k: 'Lubricate & massage',
    v: 'Massage the lobes daily with jojoba or coconut oil to keep them supple and encourage elasticity. Healthy tissue stretches; dry, tired tissue tears.',
  },
  {
    k: 'Listen to your body',
    v: 'Your lobe sets the pace, not the calendar. When something feels off, drop a size, wait, and ask your piercer before going further.',
  },
];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Ear Stretching — a slow, safe upsize guide',
  description:
    'How to stretch (gauge) earlobes safely: one size at a time, never skip a gauge, how long to wait between size-ups, readiness signs, the point of no return, blowout risks, safe materials, and how downsizing fits in. Educational guidance from Wenu Mapu.',
  author: { '@type': 'Organization', name: 'Wenu Mapu' },
  publisher: { '@type': 'Organization', name: 'Wenu Mapu' },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wenumapuonline.com/' },
    { '@type': 'ListItem', position: 2, name: 'Piercing', item: 'https://wenumapuonline.com/piercing' },
    { '@type': 'ListItem', position: 3, name: 'Ear stretching', item: 'https://wenumapuonline.com/ear-stretching' },
  ],
};
---
<Base
  title="Ear Stretching — A Slow, Safe Upsize Guide | Wenu Mapu"
  description="How to stretch your earlobes safely: one size at a time, never skip a gauge, how long to wait, readiness signs, the point of no return, blowout risks, and safe materials. Educational guidance — consult your piercer."
  ogImage="/img/brand/meteorite-collection.webp"
  jsonLd={[articleLd, breadcrumbLd]}
>
  <section class="section section--mega es-hero">
    <div class="container">
      <p class="eyebrow">RECOMMENDATIONS · EAR STRETCHING</p>
      <h1 class="page-title">Stretch slow.<br/>The lobe keeps the time.</h1>
      <p class="lede">
        Stretching — gauging a healed lobe up in size — is a long, patient practice, not a weekend project.
        Done one size at a time it builds strong, healthy tissue that can carry jewelry for years. Rushed, it
        tears, thins, and scars. This is a guide, not medical advice: when in doubt, ask your piercer.
      </p>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>
    </div>
  </section>

  <!-- ── THE THREE RULES ── -->
  <section class="section es-rules" aria-labelledby="rules-title">
    <div class="container">
      <p class="eyebrow">THE GROUND RULES</p>
      <h2 id="rules-title" class="section-title">Three rules that protect your lobes.</h2>
      <ul class="es-grid" role="list">
        {rules.map((r) => (
          <li class="es-card">
            <h3 class="es-card__title">{r.k}</h3>
            <p class="es-card__body">{r.v}</p>
          </li>
        ))}
      </ul>
      <p class="es-fine">
        Wait times are typical ranges — your body, your skin and your gauge all change the math. Larger sizes always ask for more patience.
      </p>
    </div>
  </section>

  <!-- ── READY vs NOT READY ── -->
  <section class="section es-signs" aria-labelledby="signs-title">
    <div class="container">
      <p class="eyebrow">READING THE LOBE</p>
      <h2 id="signs-title" class="section-title">Ready to size up — or not.</h2>
      <div class="es-signs-grid">
        <div class="es-signs-col es-signs-col--go">
          <h3 class="es-signs-col__head">Signs you're ready</h3>
          <ul class="es-signs-list">
            {readySigns.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div class="es-signs-col es-signs-col--stop">
          <h3 class="es-signs-col__head">Signs to stop &amp; wait</h3>
          <ul class="es-signs-list es-signs-list--stop">
            {stopSigns.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </div>
      <p class="es-fine">
        If you see any stop sign, drop back a size, let it settle, and give it longer before trying again. A quick check: if your regular
        piercings tend to close without jewelry, your lobes may also struggle to come back after stretching — go gently and conservatively.
      </p>
    </div>
  </section>

  <!-- ── POINT OF NO RETURN + RISKS ── -->
  <section class="section es-limits" aria-labelledby="limits-title">
    <div class="container">
      <p class="eyebrow">KNOW THE LIMITS</p>
      <h2 id="limits-title" class="section-title">The point of no return.</h2>
      <div class="landing__copy es-copy">
        <p>
          Up to a certain gauge a stretched lobe will often shrink back if you retire the jewelry. Past it, the change is usually
          permanent. For most people that line falls somewhere around <strong>0g–4g (roughly 6–8 mm)</strong> — but it is deeply
          individual and never guaranteed in either direction. Your anatomy, skin, how carefully you stretched, and your aftercare all
          decide where your own line sits. Treat any stretch as potentially permanent and choose accordingly.
        </p>
        <p>
          Going too fast or skipping sizes is what causes lasting damage: <strong>blowouts</strong> (a ring of tissue forced out behind
          the lobe), <strong>tears</strong>, <strong>thinning</strong> of the lobe, and <strong>scar tissue</strong> that stiffens the
          lobe and makes every future stretch harder. None of this is a race — slower is the shortcut.
        </p>
      </div>
    </div>
  </section>

  <!-- ── BEST PRACTICES ── -->
  <section class="section es-practices" aria-labelledby="practices-title">
    <div class="container">
      <p class="eyebrow">DO IT WELL</p>
      <h2 id="practices-title" class="section-title">Good practice, every size up.</h2>
      <ul class="es-grid" role="list">
        {practices.map((p) => (
          <li class="es-card">
            <h3 class="es-card__title">{p.k}</h3>
            <p class="es-card__body">{p.v}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── DOWNSIZE CROSS-LINK (no duplica el tool existente) ── -->
  <section class="section es-downsize" aria-labelledby="downsize-title">
    <div class="container">
      <div class="es-downsize-card">
        <p class="es-downsize__kicker">RELATED · FRESH PIERCINGS</p>
        <h2 id="downsize-title" class="es-downsize__title">Downsizing is the opposite move — and just as important.</h2>
        <p class="es-downsize__body">
          Stretching grows a <em>healed</em> lobe. <strong>Downsizing</strong> is for a <em>new</em> piercing: your first jewelry is
          deliberately long to leave room for early swelling, and once that settles it needs to be shortened so it doesn't snag or migrate.
          We keep the downsize windows by zone — plus a reminder tool that emails you and exports to your calendar — on the piercing page.
        </p>
        <div class="es-downsize__actions">
          <a href="/piercing#aftercare" class="btn btn--solid">Downsize windows &amp; reminder →</a>
          <a href="/care-guide" class="btn btn--ghost">Full aftercare guide</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CONSULT / CTA ── -->
  <section class="section es-consult" aria-labelledby="consult-title">
    <div class="container">
      <p class="eyebrow">WHEN IN DOUBT</p>
      <h2 id="consult-title" class="section-title">Ask before the next size.</h2>
      <p class="section-lede">
        Not sure if your lobe is ready, which gauge comes next, or which jewelry is safe for a fresh stretch? Bring us your ears — or a
        photo — and we'll plan a pace that keeps them healthy. This guide is educational and not medical advice; if a lobe looks or feels
        wrong, see your piercer or a clinician.
      </p>
      <div class="es-consult__actions">
        <a href="mailto:marimari@wenumapuonline.com?subject=Ear%20stretching%20question" class="btn btn--solid">Ask about stretching →</a>
        <a href="/piercing#book" class="btn btn--ghost">Book a session</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .es-hero { padding-bottom: var(--space-5); }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: var(--fw-regular);
    line-height: 1.1;
    color: var(--bone);
    text-transform: uppercase;
    margin: var(--space-3) 0 var(--space-3);
  }
  .section-lede {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-size: var(--fs-body-lg);
    line-height: 1.6;
    color: var(--fg-soft);
    max-width: 62ch;
    margin-bottom: var(--space-5);
  }
  .es-copy { max-width: 64ch; }
  .es-copy p {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-size: var(--fs-body-lg);
    line-height: 1.7;
    color: var(--fg-soft);
    margin: 0 0 var(--space-4);
  }
  .es-copy strong { color: var(--bone); font-weight: var(--fw-regular); }

  .es-rules { background: var(--charcoal); padding: var(--space-7) 0; border-top: var(--border-thin); border-bottom: var(--border-thin); }
  .es-practices { padding: var(--space-7) 0; }
  .es-grid {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-5);
  }
  .es-card {
    background: var(--obsidian);
    border: var(--border-thin);
    padding: var(--space-5);
  }
  .es-card__title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--ember);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid rgba(196, 147, 90, 0.25);
  }
  .es-card__body {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--fg-soft);
    margin: 0;
  }
  .es-fine {
    margin-top: var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    color: var(--silver);
    line-height: 1.6;
    letter-spacing: 0.03em;
    max-width: 70ch;
  }

  .es-signs { padding: var(--space-7) 0; background: var(--charcoal); border-top: var(--border-thin); border-bottom: var(--border-thin); }
  .es-signs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  .es-signs-col { background: var(--obsidian); border: var(--border-thin); padding: var(--space-5); }
  .es-signs-col--go { border-left: 3px solid var(--ember); }
  .es-signs-col--stop { border-left: 3px solid var(--clay); }
  .es-signs-col__head {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--bone);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 0 0 var(--space-4);
  }
  .es-signs-list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  .es-signs-list li {
    position: relative;
    padding-left: 1.3rem;
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    color: var(--fg-soft);
    line-height: 1.6;
  }
  .es-signs-list li::before {
    content: '◆';
    position: absolute;
    left: 0;
    top: 0.2em;
    color: var(--ember);
    font-size: 0.7rem;
  }
  .es-signs-list--stop li::before { content: '✕'; color: var(--clay); font-size: 0.85rem; top: 0.05em; }

  .es-limits { padding: var(--space-7) 0; }

  .es-downsize { padding: var(--space-7) 0; background: var(--charcoal); border-top: var(--border-thin); border-bottom: var(--border-thin); }
  .es-downsize-card {
    padding: var(--space-6) var(--space-5);
    background: linear-gradient(180deg, rgba(201, 168, 76, 0.10), rgba(201, 168, 76, 0.02)), var(--obsidian);
    border: 1px solid rgba(201, 168, 76, 0.40);
    max-width: 80ch;
  }
  .es-downsize__kicker {
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    letter-spacing: var(--letter-spacing-ritual);
    text-transform: uppercase;
    color: var(--ember);
    margin: 0 0 var(--space-2);
  }
  .es-downsize__title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    color: var(--bone);
    line-height: 1.15;
    margin: 0 0 var(--space-3);
    text-transform: none;
  }
  .es-downsize__body {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--fg-soft);
    margin: 0 0 var(--space-5);
    max-width: 64ch;
  }
  .es-downsize__body strong { color: var(--bone); font-weight: var(--fw-regular); }
  .es-downsize__actions, .es-consult__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .es-consult { padding: var(--space-7) 0; }
</style>
