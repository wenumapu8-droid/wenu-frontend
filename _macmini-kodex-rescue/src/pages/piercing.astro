---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import PatternBand from '../components/PatternBand.astro';
import AtelierGallery from '../components/AtelierGallery.astro';
import CertificationsGallery from '../components/CertificationsGallery.astro';
import PiercingAftercare from '../components/PiercingAftercare.astro';
import BookingBuilder from '../components/BookingBuilder.astro';
import { getProducts } from '../lib/woo';
import { buildLocalBusinessLd, WENU_PHONE, WENU_EMAIL, WENU_AREA_SERVED } from '../lib/localBusiness';
import en from '../i18n/en.json';

const L = en.landing.piercing;

// Curated subset of piercing products with images
const KEYWORDS = ['piercing', 'septum', 'labret', 'plug', 'tunnel', 'tapón', 'tunel'];
const all = await getProducts();
const matched = all.filter(p =>
  p.images.length > 0 && p.images[0].src &&
  p.categories.some(c => KEYWORDS.some(k => c.slug.toLowerCase().includes(k)))
);
const featured = matched.slice(0, 6);

// Service pricing — sourced from Wenu_Mapu_Pricing_List_Truckee.pdf (Nov 2025)
const services = [
  { zone: 'Nose',     items: [
    { name: 'Nostril (one side)',                   price: 80 },
    { name: 'Septum',                                price: 90 },
  ]},
  { zone: 'Ear',      items: [
    { name: 'Lobe (each)',                           price: 80 },
    { name: 'Helix / Flat / Tragus / Forward Helix', price: 85 },
    { name: 'Rook / Daith / Conch',                  price: 90 },
  ]},
  { zone: 'Face',     items: [
    { name: 'Eyebrow — classic placement',           price: 85 },
    { name: 'Lip · Labret / Side Labret / Medusa',   price: 85 },
    { name: 'Tongue — center',                       price: 95 },
  ]},
  { zone: 'Body',     items: [
    { name: 'Navel — classic belly button',          price: 110 },
  ]},
  { zone: 'Service',  items: [
    { name: 'Jewelry change or removal',             price: 25 },
    { name: 'Titanium jewelry replacement',          priceRange: '30–60' },
  ]},
];

const includes = [
  'Implant-grade titanium starter jewelry (ASTM F-136)',
  'Sterile single-use needle',
  'Pre-procedure consultation & marking',
  'Aftercare guide + 14-day check-in',
  'Sterilized, single-use setup for every appointment',
];

/**
 * Credentials canónicas de Nicolás Ortega (verificadas vs CV oficial 2026-05-30).
 * Cada item lleva año + institución + un breve descriptor + path al PDF (si existe).
 * Los PDFs viven en /public/credentials/ — Ocin los sube cuando esté en el Mac;
 * mientras tanto el link queda en "#" y el card se muestra sin descarga.
 * Fuente canon: Obsidian `brand/01-identity/credenciales-y-cv.md`.
 */
interface Credential {
  name: string;
  org: string;
  period: string;
  body: string;
  pdf?: string;        // ej '/credentials/app-core-essentials-2025.pdf'
  status?: 'active' | 'expiring' | 'expired';
}

const credentials: Credential[] = [
  {
    name: 'APP Core Essentials Vol. 4',
    org: 'Association of Professional Piercers',
    period: 'Oct – Dec 2025',
    body: 'Professional training in jewelry for initial piercings, anatomy-based techniques (nostril, high nostril, forward helix, flat, faux rook), point-of-use sterilization, and APP-aligned hygiene standards.',
    status: 'active',
  },
  {
    name: 'Mentorship — Bryan Gutiérrez',
    org: '@modifica.tu.ser',
    period: '2025 – Present',
    body: 'Ongoing guidance in anatomy, needle handling theory, jewelry standards, and safe studio practices.',
    status: 'active',
  },
  {
    name: 'Bloodborne Pathogens (OSHA-compliant)',
    org: 'American Heart Association',
    period: '2023 – 2027',
    body: 'OSHA-compliant bloodborne pathogens safety for body art environments. Cross-contamination prevention, PPE protocols, exposure control.',
    status: 'active',
  },
  {
    name: 'First Aid · CPR · AED',
    org: 'American Heart Association',
    period: 'Valid through 2025',
    body: 'Emergency response, CPR, AED operation, and workplace safety protocols.',
    status: 'expiring',
  },
  {
    name: 'Continuing Education',
    org: 'Professional Piercers Collective',
    period: 'Nov 2025',
    body: 'Continuing-education seminars covering ear and facial piercing theory, anatomy fundamentals, needle-modification concepts, jewelry selection, studio hygiene, and sustainable studio operations.',
    status: 'active',
  },
  {
    name: 'Hepatitis B Declination on file',
    org: 'OSHA documentation',
    period: 'On file',
    body: 'Hepatitis B declination statement is documented per OSHA bloodborne pathogens standard for the body art workplace.',
    status: 'active',
  },
];

const studioStandards = [
  'Starter jewelry begins with implant-grade titanium (ASTM F-136).',
  'Threadless systems; 14k solid gold available for initial piercings.',
  'Exposure control, cleaning, and sterilization records exist as part of the studio documentation.',
  'No mystery alloys for fresh piercings. No rushed, anonymous setup.',
];

const reservationNotes = [
  'Private appointment only — no rushed walk-ins.',
  'Bring a government-issued photo ID. Minors must come with a parent or legal guardian.',
  'If you have anatomy, healing, or jewelry questions, ask before reserving and we will confirm fit first.',
];

/**
 * Contraindications / "before you book".
 * Fuente canónica: Obsidian `20-Operaciones/contraindicaciones-piercing-2026-06-29.md`
 * (APP / safepiercing.org, CA Penal Code §652, AAFP, HemAware — verificado 2026-06-29).
 * Encuadre OBLIGATORIO: política del estudio + "consult your physician".
 * NUNCA diagnóstico ni promesa médica; sin afirmaciones médicas absolutas.
 */
const beforeBook = [
  {
    title: 'Pregnancy & breastfeeding',
    body: 'We ask you to wait. A new piercing takes months to heal, and during pregnancy or nursing your body is already doing important work. Please talk to your physician about the right time — most piercers suggest waiting until after this season.',
  },
  {
    title: 'Minors',
    body: 'Under California law, anyone under 18 must be pierced in the presence of a parent or legal guardian, who also shows their own photo ID. Nipple and genital piercings on minors are not permitted by law. Please bring your guardian and plan to talk it through together.',
  },
  {
    title: 'No alcohol or drugs',
    body: 'We cannot pierce anyone under the influence. It comes down to informed consent and your safety — intoxication affects bleeding, fainting and healing. Come sober and rested, and we will take good care of you.',
  },
  {
    title: 'Medications',
    body: 'If you take blood thinners, isotretinoin (Accutane), immunosuppressants or other regular medication, tell us before booking. Some need clearance from your doctor, and Accutane usually means waiting. Never stop a medication on your own — ask your physician first.',
  },
  {
    title: 'Health conditions',
    body: 'If you live with diabetes, a heart or valve condition, a bleeding or clotting disorder, an autoimmune condition, metal allergies, a skin condition at the site, or a history of keloids, please consult your physician first and let us know. We may ask for medical clearance.',
  },
];

// Canonical LocalBusiness (JewelryStore) — NAP kept in sync via the shared
// helper. Service-area business: NO PostalAddress; geography lives in
// areaServed (the fake-locality pattern Google penalizes is avoided here).
const businessLd = buildLocalBusinessLd({
  name: 'Wenu Mapu — Piercing',
  description:
    'Ritual body piercing by private appointment in the Truckee / North Lake Tahoe / Reno area. ASTM F-136 implant-grade titanium starter jewelry, sterile single-use needles.',
  image: 'https://wenumapuonline.com/img/categories/piercing.png',
});

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Body Piercing',
  provider: {
    '@type': 'JewelryStore',
    name: 'Wenu Mapu — Piercing',
    telephone: WENU_PHONE,
    email: WENU_EMAIL,
    areaServed: WENU_AREA_SERVED,
  },
  areaServed: WENU_AREA_SERVED,
  offers: services.flatMap(s => s.items.map(item => ({
    '@type': 'Offer',
    name: `${s.zone} — ${item.name}`,
    price: item.price ?? item.priceRange,
    priceCurrency: 'USD',
  }))),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',     item: 'https://wenumapuonline.com/' },
    { '@type': 'ListItem', position: 2, name: 'Piercing', item: 'https://wenumapuonline.com/piercing' },
  ],
};
---
<Base
  title="Piercing — Ritual Body Piercing in Truckee, CA | Wenu Mapu"
  description="Ritual body piercing by private appointment in the Truckee / North Lake Tahoe area. ASTM F-136 implant-grade titanium starter jewelry. Sterile single-use needles. Book a session."
  ogImage="/img/categories/piercing.png"
  jsonLd={[businessLd, collectionLd, breadcrumbLd]}
>
  <div class="cat-masthead">
    <picture>
      <source type="image/avif" srcset="/img/banners/category/piercing.avif" />
      <img src="/img/banners/category/piercing.webp" alt="Wenu Mapu — ritual body piercing" width="1600" height="670" loading="eager" decoding="async" fetchpriority="high" />
    </picture>
  </div>

  <section class="section section--mega piercing-hero">
    <div class="container">
      <p class="eyebrow">RITUAL PIERCING · TRUCKEE, CALIFORNIA</p>
      <h1 class="page-title">Piercing as a passage,<br/>not a transaction.</h1>
      <p class="lede">
        Ritual body piercing by private appointment in the Truckee / North Lake Tahoe area.
        Every piercing starts with implant-grade titanium (ASTM F-136),
        a sterile single-use needle, and a slow conversation about placement.
      </p>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>

      <div class="landing__cta">
        <a href="#book" class="btn btn--solid">Book a session →</a>
        <a href="#aftercare" class="btn btn--ghost">Aftercare &amp; healing reminder</a>
      </div>
    </div>
  </section>

  {/* ── ATELIER GALLERY ── prueba visual del trabajo real (screenshots IG @wenu_mapu). */}
  <AtelierGallery />

  <!-- ── PRICING TABLE ── -->
  <section class="section piercing-pricing" aria-labelledby="pricing-title">
    <div class="container">
      <p class="eyebrow">SERVICES · USD</p>
      <h2 id="pricing-title" class="section-title">Pricing list</h2>
      <p class="section-lede">
        Prices are <strong>per piercing</strong> and include implant-grade titanium jewelry, sterile
        single-use setup, and an aftercare brief. Solid 14kt gold is an optional upgrade.
        <a href="/initial-jewelry">See every piece we install →</a>
      </p>

      <div class="pricing-grid">
        {services.map(s => (
          <div class="pricing-group">
            <h3 class="pricing-group__title">{s.zone}</h3>
            <ul class="pricing-list">
              {s.items.map(item => (
                <li class="pricing-row">
                  <span class="pricing-row__name">{item.name}</span>
                  <span class="pricing-row__dots" aria-hidden="true"></span>
                  <span class="pricing-row__price">
                    {item.price ? `$${item.price}` : `$${item.priceRange}`}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── DESIGN YOUR EAR ── Ear Constellations tool, nested inside piercing services */}
  <section class="section piercing-design" aria-labelledby="design-title">
    <div class="container">
      <div class="design-feature">
        <div class="design-feature__media">
          {/* Ocin's own labelled ear map (his art) — the shaded ear with gold placements
              named. Framed on a fixed-dark plate so it reads with volume in every theme
              (Solar included) instead of flattening to a black blob. */}
          <figure class="design-ear-plate">
            <img src="/img/ear/ear-map-teaser.webp" width="1200" height="1190" loading="lazy" decoding="async"
                 class="design-ear-plate__img"
                 alt="Ocin's curated ear map — a shaded ear with gold placements labelled: high helix, forward helix, rook, daith, conch, tragus, snug, industrial, lobe and more." />
            <figcaption class="design-ear-plate__cap">Your canvas · every placement, named</figcaption>
          </figure>
        </div>
        <div class="design-feature__copy">
          <p class="eyebrow">PLAN YOUR CURATION</p>
          <h2 id="design-title" class="section-title">Design your ear.</h2>
          <p class="section-lede">
            Not sure how to combine a helix, a conch and a daith? Open the Ear
            Constellations tool — hover any point to learn the piercing, tap to place a
            jewel, and watch your composition connect like a constellation. Build the ear
            you dream of, then bring it to your session and we'll plan the order that heals best.
          </p>
          <div class="design-feature__cta">
            <a href="/constelaciones" class="btn btn--solid">Design your ear →</a>
            <a href="#book" class="btn btn--ghost">Book a session</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── INCLUDES ── -->
  <section class="section piercing-includes" aria-labelledby="includes-title">
    <div class="container">
      <p class="eyebrow">EVERY SESSION INCLUDES</p>
      <h2 id="includes-title" class="section-title">What you receive.</h2>
      <ul class="includes-list">
        {includes.map(item => (
          <li class="includes-item">
            <span class="includes-bullet" aria-hidden="true">◆</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── BEFORE YOU BOOK / CONTRAINDICATIONS ── (research: contraindicaciones-piercing-2026-06-29.md) -->
  <section class="section piercing-before" aria-labelledby="before-title">
    <div class="container">
      <p class="eyebrow">YOUR SAFETY · BEFORE YOU BOOK</p>
      <h2 id="before-title" class="section-title">Before you book.</h2>
      <p class="section-lede">
        A piercing is a passage your body has to heal, so a few things help us keep it safe.
        None of this is medical advice — when in doubt, talk to your physician. Where it matters,
        we may ask for medical clearance before we pierce.
      </p>

      <ul class="before-grid" role="list">
        {beforeBook.map((c) => (
          <li class="before-card">
            <h3 class="before-card__title">{c.title}</h3>
            <p class="before-card__body">{c.body}</p>
          </li>
        ))}
      </ul>

      <aside class="before-policy" role="note" aria-label="Piercing policy">
        <p class="before-policy__kicker">PIERCING POLICY</p>
        <p class="before-policy__rule">Maximum of <strong>2 piercings per day</strong>.</p>
        <p class="before-policy__body">
          Your body heals one passage at a time. If you want a fuller curation, we will plan it
          across separate sessions so each piercing has the room it needs to settle.
        </p>
      </aside>

      <p class="before-note">
        Not sure whether something applies to you? Ask before you reserve — write to
        <a href="mailto:marimari@wenumapuonline.com?subject=Piercing%20question">marimari@wenumapuonline.com</a>
        and we will confirm first.
      </p>
    </div>
  </section>

  <!-- ── TRAINING / DOCUMENTATION / RESERVATION ── -->
  <section class="section piercing-credentials" aria-labelledby="credentials-title">
    <div class="container">
      <p class="eyebrow">TRAINING · DOCUMENTATION · RESERVATION</p>
      <h2 id="credentials-title" class="section-title">What you can review before you reserve.</h2>
      <p class="section-lede">
        A piercing appointment should come with clear standards. If you want to review training, aftercare,
        or studio documentation before reserving, ask first and we will walk you through what applies to your session.
      </p>

      {/* Credentials grid — replaces previous generic copy with real CV-verified certs (2026-05-30). */}
      <ul class="credentials-grid credentials-grid--certs" role="list">
        {credentials.map((c) => (
          <li class="credentials-card credentials-card--cert">
            <p class="credentials-card__org">{c.org}</p>
            <h3 class="credentials-card__title">{c.name}</h3>
            <p class="credentials-card__period">
              {c.period}
              {c.status === 'expiring' && (
                <span class="credentials-card__status credentials-card__status--expiring">· renewing</span>
              )}
              {c.status === 'expired' && (
                <span class="credentials-card__status credentials-card__status--expired">· expired</span>
              )}
            </p>
            <p class="credentials-card__body">{c.body}</p>
            {c.pdf && (
              <a class="credentials-card__pdf" href={c.pdf} target="_blank" rel="noopener">
                View certificate <span aria-hidden="true">↗</span>
              </a>
            )}
          </li>
        ))}
      </ul>

      <div class="credentials-grid">
        <article class="credentials-card">
          <h3 class="credentials-card__title">Material & sterilization standards</h3>
          <ul class="credentials-list">
            {studioStandards.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>

        <article class="credentials-card credentials-card--reservation">
          <h3 class="credentials-card__title">Before you reserve</h3>
          <ul class="credentials-list">
            {reservationNotes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="credentials-card__actions">
            <a href="#book" class="btn btn--solid">Build your session →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ── CERTIFICATIONS GALLERY ── certificados reales (PPC + mentores) -->
  <CertificationsGallery />

  <!-- ── SAFETY ── -->
  <section class="section piercing-safety" aria-labelledby="safety-title">
    <div class="container">
      <p class="eyebrow">SAFETY · STANDARDS</p>
      <h2 id="safety-title" class="section-title">Body-safe by default.</h2>
      <div class="landing__copy">
        <p>
          All starter jewelry is <strong>ASTM F-136 implant-grade titanium</strong> — bio-compatible,
          hypoallergenic, and safe to wear during healing. No mystery alloys. No surgical steel
          for first piercings. We use only sterile single-use needles, autoclave-sterilized tools,
          and disposable gloves.
        </p>
        <p>
          Healing is a passage — your responsibility starts the moment your appointment ends.
          You'll receive a printed aftercare card with cleaning ritual, healing times by zone,
          and a 14-day check-in by email. The full online guide lives at
          <a href="https://aftercare.wenumapuonline.com/" target="_blank" rel="noopener">aftercare.wenumapuonline.com</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ── BOOKING ── The single point of conversion. Everything above earns the
       decision (proof, price, safety, credentials); everything below is for after
       it (aftercare, browse). One booking surface on the page, no competing CTA. -->
  <section id="book" class="section piercing-book" aria-labelledby="book-title">
    <div class="container">
      <p class="eyebrow">BOOK A SESSION</p>
      <h2 id="book-title" class="section-title">Reserve your passage.</h2>
      <p class="section-lede">
        By private appointment in Truckee / North Lake Tahoe. Build your session below —
        placement, jewelry, day and time — and a person confirms it, not a robot.
      </p>

      {/* The four-step builder (Ocin's mockup, on real prices). It composes a fully
          specified request so the first message already says everything. */}
      <BookingBuilder />

      <div class="book-grid book-grid--after">
        <div class="book-grid__col">
          <h3 class="book-subtitle">Good to know</h3>
          <ul class="book-list">
            <li><strong>Private appointment only</strong> — no rushed walk-ins. 30–60 min per session.</li>
            <li><strong>Direct contact:</strong> marimari@wenumapuonline.com · +1 (408) 500-6211</li>
            <li><strong>Instagram:</strong> <a href="https://instagram.com/wenu__mapu" target="_blank" rel="noopener">@wenu__mapu</a></li>
            <li><strong>Payment</strong> at your appointment: Zelle, Venmo or cash.</li>
            <li><strong>ID required:</strong> government-issued photo ID. Minors must be accompanied by a parent or legal guardian with their own ID.</li>
          </ul>
        </div>

        <div class="book-grid__col">
          <h3 class="book-subtitle">Prefer to just talk?</h3>
          <p class="book-cta-lede">
            The builder above is the fastest way — it sends everything at once. But if you'd
            rather ask first, or you're not sure yet, write or call. A person answers.
          </p>
          <div class="book-cta-stack">
            <a href="mailto:marimari@wenumapuonline.com?subject=Piercing%20booking%20request" class="btn btn--solid">Email to book →</a>
            <a href="tel:+14085006211" class="btn btn--ghost">Call +1 (408) 500-6211</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── AFTERCARE · DOWNSIZE · HEALING REMINDER ── full guide + tool (2026-06-24) */}
  <PiercingAftercare />

  <!-- ── FEATURED PIECES ── -->
  {featured.length > 0 && (
    <section class="section piercing-featured" aria-label="Selected piercing pieces">
      <div class="container">
        <div class="landing__rail-head">
          <p class="eyebrow">PIECES · TITANIUM &amp; SILVER</p>
          <a href={L.shop_target} class="text-accent">View all →</a>
        </div>
        <h2 class="section-title">Curated piercing pieces.</h2>
        <p class="section-lede">
          Selected pieces from our piercing line — septums, labrets, plugs, and titanium tops.
          All in implant-grade titanium or 925 silver.
        </p>
        <div class="featured-v2__rail">
          {featured.map(product => (
            <div class="featured-v2__cell">
              <ProductCard product={product} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .piercing-hero { padding-bottom: var(--space-5); }
  .piercing-pricing { background: var(--charcoal); padding: var(--space-7) 0; border-top: var(--border-thin); border-bottom: var(--border-thin); }
  /* The BookingBuilder now leads the #book section; the logistics grid follows it. */
  .book-grid--after { margin-top: var(--space-6); }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: var(--fw-regular);
    line-height: 1.1;
    color: var(--bone);
    text-transform: uppercase;
    margin: var(--space-3) 0 var(--space-3);
  }
  .section-lede {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-size: var(--fs-body-lg);
    line-height: 1.6;
    color: var(--fg-soft);
    max-width: 60ch;
    margin-bottom: var(--space-6);
  }
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  .pricing-group {
    background: var(--obsidian);
    padding: var(--space-5);
    border: var(--border-thin);
  }
  .pricing-group__title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--ember);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid rgba(196,147,90,0.25);
  }
  .pricing-list { list-style: none; padding: 0; margin: 0; }
  .pricing-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    font-family: var(--font-serif);
    color: var(--bone);
    line-height: 1.4;
  }
  .pricing-row__name { flex: 0 1 auto; font-weight: var(--fw-thin); }
  .pricing-row__dots {
    flex: 1 1 auto;
    border-bottom: 1px dotted rgba(168,163,154,0.35);
    transform: translateY(-3px);
    min-width: 12px;
  }
  .pricing-row__price {
    flex: 0 0 auto;
    font-family: var(--font-display);
    color: var(--ember);
    font-size: 1.05rem;
  }
  .piercing-design {
    padding: var(--space-7) 0;
    background: var(--charcoal);
    border-top: var(--border-thin);
    border-bottom: var(--border-thin);
  }
  .design-feature {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: center;
