---
/**
 * /kai — "Kai's home" (sistema tamagotchi, 2026-07-12).
 *
 * Deliberately dumb page: it only provides the mount point. The entire game
 * (state, meters, actions, rewards, ranks, event hooks) lives in
 * public/kai/kai-home.js + public/kai/kai-home.css, which Astro copies verbatim
 * and never compiles — so the game can never break the build. The same room
 * opens as a full-screen overlay when you click Kai in the nav drawer.
 */
import Base from '../layouts/Base.astro';
---
<Base
  title="Kai's home — Wenu Mapu"
  description="Kai lives here between your visits. Feed him, play with him, and let him bring pieces back to you from the shop."
  robots="noindex, follow"
>
  <section class="section section--mega kaipage">
    <div class="container-narrow kaipage__inner">
      <header class="kaipage__head">
        <p class="eyebrow">The companion</p>
        <h1 class="page-title">Kai</h1>
        <p class="lede">
          Kai is the little guardian of this shop. He waits in the menu, he
          celebrates when you gather a piece, and he keeps the things you linger
          on. Look after him and he grows with you.
        </p>
      </header>

      <div class="kaipage__mount" data-kai-home-inline></div>

      <noscript>
        <p class="kaipage__noscript">
          Kai needs JavaScript to wake up. The shop works fine without him —
          <a href="/shop">browse the jewelry</a>.
        </p>
      </noscript>
    </div>
  </section>

  <style>
    .kaipage__inner { display: flex; flex-direction: column; gap: var(--space-5); }
    .kaipage__head .lede { margin-top: var(--space-3); max-width: 56ch; }
    .kaipage__mount { min-height: 200px; }
    .kaipage__noscript {
      font-family: var(--font-sans);
      font-size: var(--fs-small);
      color: var(--fg-soft);
    }
    .kaipage__noscript a { color: var(--ember); }
  </style>
</Base>
