---
// PROJECTS — physical / stage / sculptural work (separate from KODEX & photo gallery).
// Quinto Fuego (RAVE VIRTUAL festival/stage design + video) · Ballena Jorobada (sculpture).
import Base from '../layouts/Base.astro';

const quinto = Array.from({ length: 9 }, (_, k) => 'quinto-' + String(k + 1).padStart(2, '0'));
const ballena = Array.from({ length: 19 }, (_, k) => 'ballena-' + String(k + 1).padStart(2, '0'));
const VIDEO = 'https://www-ccv.adobe.io/v1/player/ccv/9tKIQmaEvGy/embed';
---

<Base
  title="Projects — Stage & Sculpture · Nicolás Ortega"
  description="Physical, stage and sculptural work by Nicolás Ortega (Wenu Mapu): Quinto Fuego / RAVE VIRTUAL and Ballena Jorobada."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true}
>
  <div class="gx" data-gx>
    <header class="gx-head">
      <a class="gx-word" href="/">WENU MAPU</a>
      <nav class="gx-nav"><a href="/gallery">GALLERY</a> <a href="/kodex">KODEX−∞</a></nav>
    </header>

    <section class="gx-intro">
      <p class="gx-over" data-reveal>STAGE · SCULPTURE · SPACE</p>
      <h1 class="gx-title" data-reveal>Projects</h1>
      <p class="gx-lede" data-reveal>Where the system leaves the screen and takes physical form — stage, matter, structure.</p>
    </section>

    <!-- QUINTO FUEGO — stage / festival design + video -->
    <section class="gx-series" id="quinto-fuego">
      <div class="gx-series__head" data-reveal>
        <h2 class="gx-series__name">Quinto Fuego</h2>
        <span class="gx-series__place">RAVE VIRTUAL · stage &amp; identity</span>
        <p class="gx-series__note">Design for a virtual festival of Chilean music, technology and psychedelic art. 3D geometry, identity and motion.</p>
      </div>
      <div class="gx-video" data-reveal>
        <iframe src={VIDEO} title="Quinto Fuego — video" loading="lazy" allow="autoplay; fullscreen; encrypted-media" allowfullscreen frameborder="0"></iframe>
      </div>
      <div class="gx-grid gx-grid--wide">
        {quinto.map((p, i) => (
          <figure class="gx-photo" data-reveal>
            <img src={`/img/physical/${p}.webp`} loading="lazy" alt={`Quinto Fuego — ${i + 1}`} />
          </figure>
        ))}
      </div>
    </section>

    <!-- BALLENA JOROBADA — sculpture / physical -->
    <section class="gx-series" id="ballena">
      <div class="gx-series__head" data-reveal>
        <h2 class="gx-series__name">Ballena Jorobada</h2>
        <span class="gx-series__place">sculpture · fabrication</span>
        <p class="gx-series__note">A humpback whale brought from 3D model into physical matter — process, build and result.</p>
      </div>
      <div class="gx-grid">
        {ballena.map((p, i) => (
          <figure class="gx-photo" data-reveal>
            <img src={`/img/physical/${p}.webp`} loading="lazy" alt={`Ballena Jorobada — ${i + 1}`} />
          </figure>
        ))}
      </div>
    </section>

    <footer class="gx-foot">
      <p data-reveal>Wenu Mapu · Truckee, CA</p>
    </footer>
  </div>

  <style>
    .gx {
      --ink:#f2efe9; --gray:#8f8f8f; --dim:#585858; --line:#1c1c1c;
      background:#0a0a0a; color:var(--ink);
      font-family:'Instrument Sans',system-ui,sans-serif; min-height:100vh;
    }
    .gx :where(a){ color:inherit; text-decoration:none; }
    .gx-head{ position:sticky; top:0; z-index:20; display:flex; align-items:center; justify-content:space-between;
      padding:18px clamp(18px,5vw,52px); background:linear-gradient(#0a0a0a 60%,transparent); }
    .gx-word{ font-family:'Instrument Serif',serif; font-size:20px; letter-spacing:.04em; }
    .gx-nav{ display:flex; gap:22px; }
    .gx-nav a{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.18em; color:var(--gray); transition:.3s; }
    .gx-nav a:hover{ color:var(--ink); }

    .gx-intro{ text-align:center; padding:clamp(40px,10vh,120px) 20px clamp(30px,6vh,60px); }
    .gx-over{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.3em; color:var(--gray); margin:0; }
    .gx-title{ font-family:'Instrument Serif',serif; font-weight:400; font-size:clamp(3rem,9vw,6.5rem); margin:14px 0 0; }
    .gx-lede{ max-width:42ch; margin:20px auto 0; font-size:15px; line-height:1.6; color:var(--gray); }

    .gx-series{ max-width:1200px; margin:0 auto; padding:clamp(30px,7vh,80px) clamp(18px,5vw,52px); }
    .gx-series__head{ border-top:1px solid var(--line); padding-top:22px; margin-bottom:clamp(22px,4vh,40px); }
    .gx-series__name{ font-family:'Instrument Serif',serif; font-weight:400; font-size:clamp(1.8rem,5vw,3rem); margin:0; display:inline; }
    .gx-series__place{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.16em; color:var(--gold,#c9a84c); margin-left:14px; }
    .gx-series__note{ font-size:14px; color:var(--gray); margin:12px 0 0; max-width:48ch; }

    .gx-video{ position:relative; width:100%; aspect-ratio:16/9; margin:0 0 clamp(14px,2vw,22px); background:#000; border:1px solid var(--line); }
    .gx-video iframe{ position:absolute; inset:0; width:100%; height:100%; }

    .gx-grid{ column-count:2; column-gap:clamp(10px,1.6vw,18px); }
    .gx-grid--wide{ column-count:3; }
    .gx-photo{ break-inside:avoid; margin:0 0 clamp(10px,1.6vw,18px); background:#050505; overflow:hidden; }
    .gx-photo img{ width:100%; height:auto; display:block; opacity:.92; transition:opacity .5s, transform .6s; }
    .gx-photo:hover img{ opacity:1; transform:scale(1.02); }
    @media (min-width:1000px){ #ballena .gx-grid{ column-count:3; } }
    @media (max-width:620px){ .gx-grid, .gx-grid--wide{ column-count:1; } }

    .gx-foot{ text-align:center; padding:clamp(50px,10vh,120px) 20px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.2em; color:var(--dim); }

    [data-reveal]{ opacity:0; transform:translateY(16px); transition:opacity .9s ease, transform .9s ease; }
    [data-reveal].gx-in{ opacity:1; transform:none; }
    @media (prefers-reduced-motion:reduce){ [data-reveal]{ transition:opacity .01s; transform:none; } .gx-photo:hover img{ transform:none; } }
  </style>

  <script>
    (() => {
      const root = document.querySelector('[data-gx]'); if (!root) return;
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting){ e.target.classList.add('gx-in'); io.unobserve(e.target); } }), { threshold: 0.1 });
      root.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    })();
  </script>
</Base>
