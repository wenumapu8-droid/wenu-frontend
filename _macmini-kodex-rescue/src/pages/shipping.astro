---
import Base from '../layouts/Base.astro';
import PatternBand from '../components/PatternBand.astro';
import en from '../i18n/en.json';

// /shipping renders the canonical shipping policy. /shipping-returns
// (legacy URL) is kept for backward compatibility of inbound links and
// renders the same content. Both reference the same i18n source.
const s = en.shipping;
---
<Base
  title="Shipping & Returns — Wenu Mapu"
  description="Shipping policy, return policy and processing times for Wenu Mapu body jewelry. USPS Priority within the US, DHL Express international."
>
  <section class="section section--mega">
    <div class="container shipping">
      <p class="eyebrow">{s.eyebrow}</p>
      <h1 class="page-title">{s.title}</h1>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>

      <div class="shipping__grid">
        <div class="shipping__col">
          <h2 class="shipping__heading">{s.domestic_heading}</h2>
          <ul class="shipping__list">
            {s.domestic.map(item => <li>{item}</li>)}
          </ul>
        </div>
        <div class="shipping__col">
          <h2 class="shipping__heading">{s.international_heading}</h2>
          <ul class="shipping__list">
            {s.international.map(item => <li>{item}</li>)}
          </ul>
        </div>
        <div class="shipping__col">
          <h2 class="shipping__heading">{s.returns_heading}</h2>
          <ul class="shipping__list">
            {s.returns.map(item => <li>{item}</li>)}
          </ul>
        </div>
        <div class="shipping__col">
          <h2 class="shipping__heading">{s.processing_heading}</h2>
          <ul class="shipping__list">
            {s.processing.map(item => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <p class="shipping__note">{s.note}</p>
    </div>
  </section>
</Base>
