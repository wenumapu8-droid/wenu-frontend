---
/**
 * RitualGlyph — the Wenu ritual glyph SYSTEM (Ocin 2026-07-06).
 *
 * A small, consistent set of geometric ritual markers drawn from Wenu's OWN
 * motifs — used everywhere the site previously reached for a generic ✦ / ⟁ /
 * bullet in the cosmic sections (SignalBand chips, EmberCore HUD, FrequencyBand).
 * One set, one language, so the cosmic bands read as a single world.
 *
 * NONE of these are lifted from the Rage-Nation / Stoic moodboard (no katakana,
 * no cyberpunk sigils). They are the brand's documented geometry:
 *   · wunelfe  — the 8-point star (Wüñelfe / morning star · the brand's north)
 *   · kultrun  — 4 quadrants of the kültrún drum (Meli Witran Mapu · 4 directions)
 *   · chakana  — the Andean stepped cross (cosmic order)
 *   · rombo    — the textile rhombus (Mapuche weaving lozenge)
 *   · antu     — the sun rays / radiant point (Antü)
 *
 * Monochrome, vector, inherits colour via `currentColor` (use var(--ember) etc.).
 * The canonical full brand emblem stays WenuSigil.astro; this is the small marker
 * vocabulary that surrounds it. Keep this the single source for these markers.
 */
interface Props {
  /** Which glyph. */
  name: 'wunelfe' | 'kultrun' | 'chakana' | 'rombo' | 'antu';
  /** Size in px (square). Default 16. */
  size?: number;
  /** Stroke weight relative to the 24-unit viewBox. Default 1.4. */
  weight?: number;
  /** Accessible label; omit → decorative (aria-hidden). */
  label?: string;
  class?: string;
}
const { name, size = 16, weight = 1.4, label, class: className = '' } = Astro.props;
const a11y = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true' };
---
<svg
  class:list={['rglyph', `rglyph--${name}`, className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={weight}
  stroke-linejoin="round"
  stroke-linecap="round"
  xmlns="http://www.w3.org/2000/svg"
  {...a11y}
>
  {name === 'wunelfe' && (
    <g>
      {/* 8-point star — Wüñelfe / morning star */}
      <polygon points="12,2 14,9.4 18,6 15,10 22,12 15,14 18,18 14,14.6 12,22 10,14.6 6,18 9,14 2,12 9,10 6,6 10,9.4" />
      <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === 'kultrun' && (
    <g>
      {/* kültrún face — ring split into 4 quadrants (Meli Witran Mapu) */}
      <circle cx="12" cy="12" r="9.2" />
      <path d="M12 2.8 V21.2 M2.8 12 H21.2" />
      <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === 'chakana' && (
    <g>
      {/* Andean stepped cross (simplified 12-point chakana silhouette) */}
      <path d="M9 3 H15 V6 H18 V9 H21 V15 H18 V18 H15 V21 H9 V18 H6 V15 H3 V9 H6 V6 H9 Z" />
      <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === 'rombo' && (
    <g>
      {/* textile lozenge — nested rhombus with an inner eye (Mapuche weaving) */}
      <path d="M12 2 L21 12 L12 22 L3 12 Z" />
      <path d="M12 6.5 L16.6 12 L12 17.5 L7.4 12 Z" />
      <circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === 'antu' && (
    <g>
      {/* Antü — radiant point / sun with short rays */}
      <circle cx="12" cy="12" r="4" />
      <path d="M12 1.6 V4.6 M12 19.4 V22.4 M1.6 12 H4.6 M19.4 12 H22.4 M4.7 4.7 L6.8 6.8 M17.2 17.2 L19.3 19.3 M19.3 4.7 L17.2 6.8 M6.8 17.2 L4.7 19.3" />
    </g>
  )}
</svg>

<style>
  .rglyph { display: inline-block; line-height: 0; vertical-align: middle; }
</style>
