---
interface Props {
  text?: string;
  size?: number;
  /** When true, renders the spinning white portal mandala in the centre + a
      slowly rotating text ring (matches the home / PDP portal-seal). */
  mandala?: boolean;
}
const { text = 'WENU · MAPU · 2026', size = 120, mandala = false } = Astro.props;
const id = `seal-${Math.random().toString(36).slice(2, 8)}`;
const r = size / 2 - 6;
const cx = size / 2;
const cy = size / 2;
const pathR = r - 8;

// Wenu sigil embedded in the plain seal: the ritual emblem seats inside the
// inscribed (rotating-text) ring. Sigil is authored in a 0–200 box (centre
// 100,100); scale it so its own outer ring tucks just inside the text baseline.
const sigScale = (2 * pathR - 8) / 200;
const sigT = `translate(${cx - 100 * sigScale} ${cy - 100 * sigScale}) scale(${sigScale})`;
const sigArm = 'M121 46 A70 70 0 0 1 156 104 C154 112 147 114 141 111 A44 44 0 0 0 121 46 Z';
const rot = (a: number) => `rotate(${a} 100 100)`;
---
{mandala ? (
  <span class="eseal" style={`width:${size}px;height:${size}px;`} aria-hidden="true">
    <svg class="eseal__ring" width={size} height={size} viewBox={`0 0 ${size} ${size}`} xmlns="http://www.w3.org/2000/svg">
      <defs>
        <path id={id} d={`M ${cx},${cy} m -${pathR},0 a ${pathR},${pathR} 0 1,1 ${pathR * 2},0 a ${pathR},${pathR} 0 1,1 -${pathR * 2},0`} fill="none" />
      </defs>
      <circle cx={cx} cy={cy} r={r} fill="none" stroke="currentColor" stroke-width="1" opacity="0.7" />
      <circle cx={cx} cy={cy} r={r - 12} fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.4" />
      <text fill="currentColor" font-family="var(--font-sans)" font-size="9" letter-spacing="3">
        <textPath href={`#${id}`} startOffset="0%">{text}</textPath>
      </text>
    </svg>
    <img class="eseal__mandala" src="/img/portal-mandala-white.png" alt="" loading="lazy" decoding="async" />
  </span>
) : (
  <svg
    width={size}
    height={size}
    viewBox={`0 0 ${size} ${size}`}
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    style="display:inline-block;"
  >
    <defs>
      <path id={id} d={`M ${cx},${cy} m -${pathR},0 a ${pathR},${pathR} 0 1,1 ${pathR * 2},0 a ${pathR},${pathR} 0 1,1 -${pathR * 2},0`} fill="none" />
    </defs>
    {/* Ritual emblem (Wenu sigil) seated inside the inscribed text ring. */}
    <g transform={sigT} fill="currentColor" stroke="currentColor">
      <g fill="none" stroke-width="1">
        <circle cx="100" cy="100" r="92" opacity="0.34" />
        <circle cx="100" cy="100" r="86" opacity="0.16" />
      </g>
      <g>
        <path d={sigArm} />
        <path transform={rot(90)} d={sigArm} />
        <path transform={rot(180)} d={sigArm} />
        <path transform={rot(270)} d={sigArm} />
      </g>
      {[0, 90, 180, 270].map((a) => (
        <g transform={rot(a)}>
          <path d="M100 22 L103.4 41 L100 51 L96.6 41 Z" />
          <circle cx="100" cy="14" r="2.4" />
        </g>
      ))}
      <circle cx="100" cy="100" r="21" fill="none" stroke-width="1.3" />
      {[0, 90, 180, 270].map((a) => (
        <path transform={rot(a)} d="M100 78 L103 99 L100 100 L97 99 Z" />
      ))}
      {[45, 135, 225, 315].map((a) => (
        <path transform={rot(a)} d="M100 88 L101.6 98 L100 100 L98.4 98 Z" />
      ))}
      <circle cx="100" cy="100" r="2.8" />
    </g>
    <text fill="currentColor" font-family="var(--font-sans)" font-size="9" letter-spacing="3">
      <textPath href={`#${id}`} startOffset="0%">{text}</textPath>
    </text>
  </svg>
)}

<style>
  .eseal { position: relative; display: inline-block; line-height: 0; }
  .eseal__ring {
    position: absolute; inset: 0; width: 100%; height: 100%;
    animation: eseal-ring-spin 30s linear infinite;
  }
  .eseal__mandala {
    position: absolute; top: 50%; left: 50%;
    width: 56%; height: 56%; object-fit: contain;
    transform: translate(-50%, -50%);
    animation: eseal-mandala-spin 52s linear infinite, eseal-mandala-glow 5s ease-in-out infinite;
  }
  @keyframes eseal-ring-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes eseal-mandala-spin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to   { transform: translate(-50%, -50%) rotate(360deg); }
  }
  @keyframes eseal-mandala-glow {
    0%, 100% { filter: drop-shadow(0 0 5px rgba(255,255,255,0.35)); }
    50%      { filter: drop-shadow(0 0 12px rgba(255,255,255,0.7)) drop-shadow(0 0 26px rgba(240,192,96,0.12)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .eseal__ring, .eseal__mandala { animation: none !important; }
  }
</style>
