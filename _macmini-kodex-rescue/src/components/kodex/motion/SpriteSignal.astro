---
const {
  scene = 'prologue',
  sprite = '',
  frames = 12,
  width = 128,
  height = 128,
  label = 'sprite signal',
  class: className = '',
} = Astro.props;
const frameWidth = width * frames;
---
<div
  class={`kdx-sprite-signal ${className}`.trim()}
  data-kdx-sprite-signal
  data-kdx-scene={scene}
  data-kdx-frames={frames}
  style={`--kdx-sprite-url:url(${sprite});--kdx-sprite-width:${width}px;--kdx-sprite-height:${height}px;--kdx-sprite-sheet-width:${frameWidth}px;`}
  role="img"
  aria-label={label}
></div>
