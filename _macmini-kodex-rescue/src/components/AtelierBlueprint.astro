---
/**
 * AtelierBlueprint — "Every piece starts as a drawing."
 *
 * Cuenta el background de diseño industrial de Wenu Mapu: las planimetrías
 * técnicas (proyecto Tranalu Üñekai) y el catálogo 2019, mostrados como el
 * linaje de oficio detrás de cada commission.
 *
 * Assets:
 *   - Planimetrías técnicas: /public/img/atelier/planimetrias/*.webp
 *   - Catálogo 2019:         /public/img/atelier/catalog-2019/*.webp
 *
 * Self-contained: copy + estilos propios (no depende de i18n). Tokens del
 * design system (var(--obsidian) etc). Honra prefers-reduced-motion.
 */

// Planimetría hero — la lámina técnica que mejor lee como blueprint.
const blueprints = [
  { img: '/img/atelier/planimetrias/tranalu-01.webp', alt: 'Technical planimetry — front and section views of a stretched-ear piece' },
  { img: '/img/atelier/planimetrias/tranalu-03.webp', alt: 'Technical planimetry — dimensioned drawing of an ornamental hanger' },
  { img: '/img/atelier/planimetrias/tranalu-05.webp', alt: 'Technical planimetry — assembly and profile study' },
  { img: '/img/atelier/planimetrias/planimetria-ocin-01.webp', alt: 'Hand-annotated planimetry by the founder' },
];

// Catálogo 2019 — el archivo de diseño que precede a la marca actual.
const catalog2019 = [
  '/img/atelier/catalog-2019/catalog2019-01.webp',
  '/img/atelier/catalog-2019/catalog2019-02.webp',
  '/img/atelier/catalog-2019/catalog2019-03.webp',
  '/img/atelier/catalog-2019/catalog2019-04.webp',
  '/img/atelier/catalog-2019/catalog2019-05.webp',
  '/img/atelier/catalog-2019/catalog2019-06.webp',
];
---

<section id="blueprint" class="blueprint" aria-labelledby="blueprint-title">
  <div class="container">
    <header class="blueprint__head">
      <p class="eyebrow">Blueprint · 2019 → now</p>
      <h2 id="blueprint-title" class="blueprint__title">Every piece starts as a drawing.</h2>
      <p class="blueprint__intro">
        Before the forge, before the stone, there is a planimetry — front view, section,
        dimensions in millimetres. Wenu Mapu grew out of years of industrial-design work:
        the same technical eye that draws a stretched-ear piece to scale draws your commission.
        These are real plates from the <em>Tranalu Üñekai</em> studies and the 2019 catalogue.
      </p>
    </header>

    <div class="blueprint__plates">
      {blueprints.map((b, i) => (
        <figure class={`blueprint__plate${i === 0 ? ' blueprint__plate--lead' : ''}`}>
          <img src={b.img} alt={b.alt} loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>

    <div class="blueprint__archive">
      <p class="eyebrow">Catálogo 2019 — design archive</p>
      <ul class="blueprint__strip" aria-label="2019 catalogue archive">
        {catalog2019.map((src, i) => (
          <li class="blueprint__strip-item">
            <img src={src} alt={`Wenu Mapu 2019 catalogue plate ${i + 1}`} loading="lazy" decoding="async" />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .blueprint {
    padding: clamp(3.5rem, 8vw, 7rem) 0;
    background:
      linear-gradient(rgba(10, 10, 10, 0.92), rgba(10, 10, 10, 0.92)),
      repeating-linear-gradient(0deg, var(--obsidian) 0 39px, rgba(154, 148, 138, 0.10) 39px 40px),
      repeating-linear-gradient(90deg, var(--obsidian) 0 39px, rgba(154, 148, 138, 0.10) 39px 40px);
    border-top: 1px solid rgba(154, 148, 138, 0.18);
    border-bottom: 1px solid rgba(154, 148, 138, 0.18);
  }

  .blueprint__head {
    max-width: 60ch;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .blueprint__title {
    font-family: var(--font-display, 'Instrument Serif', serif);
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    line-height: 1.05;
    color: var(--bone);
    margin: 0.4rem 0 1rem;
  }

  .blueprint__intro {
    color: var(--silver);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.65;
    max-width: 58ch;
  }

  .blueprint__intro em {
    color: var(--bone);
    font-style: italic;
  }

  /* Plates — technical drawings as blueprint sheets */
  .blueprint__plates {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .blueprint__plate {
    margin: 0;
    position: relative;
    border: 1px solid rgba(154, 148, 138, 0.25);
    background: #f4f1ea;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .blueprint__plate--lead {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  .blueprint__plate img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 0.5rem;
    filter: saturate(0.9) contrast(1.02);
    transition: transform 0.6s ease;
  }

  .blueprint__plate:hover img {
    transform: scale(1.03);
  }

  /* 2019 archive strip */
  .blueprint__archive {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .blueprint__strip {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: clamp(0.5rem, 1.5vw, 1rem);
  }

  .blueprint__strip-item {
    border: 1px solid rgba(154, 148, 138, 0.20);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--charcoal, #121212);
  }

  .blueprint__strip-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.86;
    transition: opacity 0.4s ease, transform 0.6s ease;
  }

  .blueprint__strip-item:hover img {
    opacity: 1;
    transform: scale(1.04);
  }

  @media (max-width: 640px) {
    .blueprint__plates {
      grid-template-columns: 1fr;
    }
    .blueprint__plate,
    .blueprint__plate--lead {
      aspect-ratio: 4 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blueprint__plate img,
    .blueprint__strip-item img {
      transition: none;
    }
    .blueprint__plate:hover img,
    .blueprint__strip-item:hover img {
      transform: none;
    }
  }
</style>
