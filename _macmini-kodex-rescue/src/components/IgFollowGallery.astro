---
/**
 * IgFollowGallery — "Follow @wenu__mapu" grid on the home page.
 *
 * Product policy (owner decision 2026-07-18): tiles show REAL catalog macro
 * photos already on the site (no Instagram screenshots — those carry the
 * phone status bar / app chrome and go against the handmade-brand photo
 * policy). Only the LINK target may point at Instagram.
 *
 * Link behavior: every tile has an optional `igUrl`. If set, it links to
 * that specific post. If not set (or not yet confirmed), it falls back to
 * the profile URL. This lets the owner paste real per-post URLs over time
 * without ever touching this component's layout/markup.
 *
 * To add/replace a tile:
 *   1. Use an existing clean macro from /public/img/products/** (or add a
 *      new one via scripts/clean-images.mjs + scripts/gen-avif.mjs).
 *   2. Add an entry to `items` below with img/alt/label.
 *   3. Optional: set igUrl to the exact post
 *      (see instagram-product-map.json at repo root for a working seed list
 *      of confirmed SKU → post matches gathered 2026-07-18).
 */
interface IgTile {
  img: string;      // path under /public
  alt: string;      // descriptive alt, not decorative
  label: string;    // short on-brand label shown under the tile
  igUrl?: string;   // specific post — falls back to IG_PROFILE when absent
}

const IG_PROFILE = 'https://www.instagram.com/wenu__mapu/';

// Seed set — best available clean macros, matched to real posts where the
// pairing is obvious (see instagram-product-map.json). Unmatched tiles fall
// back to the profile link, per owner instruction — never invent a post URL.
const items: IgTile[] = [
  {
    img: '/img/products/wm-tun-008-flower-of-life-silver-macro.webp',
    alt: 'Flower-of-life sacred geometry tunnel, sterling silver macro shot',
    label: 'Sacred geometry · tunnel',
    igUrl: 'https://www.instagram.com/wenu__mapu/p/DXo9Lh6FCfx/', // FLOWER CORE ⊹ TUNNEL
  },
  {
    img: '/img/products/tribal-arch/arch-1.webp',
    alt: 'Tribal architecture hangers, engraved brass, pair',
    label: 'Tribal architecture · hangers',
    igUrl: 'https://www.instagram.com/wenu__mapu/p/DXjy_gYlB9K/', // hanger/coil post
  },
  {
    img: '/img/products/piercing-tops/ti-cluster-violet-cz.png',
    alt: 'Titanium cluster earring with violet CZ and trinity ball detail',
    label: 'Trinity cluster · titanium',
    igUrl: 'https://www.instagram.com/wenu__mapu/p/DXYUyLBlJvx/', // Trinity Cluster post
  },
  {
    img: '/img/products/ammonite/ammonite-1.webp',
    alt: 'Ammonite fossil-spiral labret, sterling silver macro shot',
    label: 'Fractal geometry · ammonite',
    // no confirmed post yet — falls back to profile
  },
  {
    img: '/img/products/snake-hangers/wm-han-019-snake-crystal-coil.webp',
    alt: 'Coiled snake hanger wrapped around a black tourmaline crystal point',
    label: 'Ouroboros · crystal coil',
    // no confirmed post yet — falls back to profile
  },
  {
    img: '/img/products/opal-green/opal-green-1.webp',
    alt: 'Green opal cabochon labret, titanium, macro shot',
    label: 'Opal cabochon · labret',
    // no confirmed post yet — falls back to profile
  },
  {
    img: '/img/products/heavy-hook/heavy-hook-1.webp',
    alt: 'Sculptural gold heavy hook ear weight, teardrop silhouette',
    label: 'Sculptural weight · hook',
    // no confirmed post yet — falls back to profile
  },
  {
    img: '/img/products/organic-hangers/black-spiral.webp',
    alt: 'Black horn spiral hangers, natural material, pair',
    label: 'Spiral · natural horn',
    // no confirmed post yet — falls back to profile
  },
];
---

<section class="ig-follow" aria-labelledby="ig-follow-title">
  <div class="container ig-follow__head">
    <p class="eyebrow">On Instagram</p>
    <h2 id="ig-follow-title" class="ig-follow__title">Follow @wenu__mapu</h2>
    <p class="ig-follow__lede">
      New pieces, process and rituals as they happen —
      <a href={IG_PROFILE} target="_blank" rel="noopener noreferrer" class="ig-follow__link">
        see the full feed on Instagram <span aria-hidden="true">↗</span>
      </a>
    </p>
  </div>

  <ul class="container ig-follow__grid" data-fade-in-stagger>
    {items.map(it => {
      const href = it.igUrl || IG_PROFILE;
      return (
        <li class="ig-tile">
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="ig-tile__link"
            aria-label={`${it.label} — view on Instagram`}
          >
            <span class="ig-tile__img-wrap">
              <img
                src={it.img}
                alt={it.alt}
                loading="lazy"
                decoding="async"
                width="800"
                height="800"
              />
              <span class="ig-tile__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="2.5" y="2.5" width="19" height="19" rx="5"/>
                  <circle cx="12" cy="12" r="4.5"/>
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
                </svg>
              </span>
            </span>
            <span class="ig-tile__label">{it.label}</span>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .ig-follow {
    background: var(--obsidian);
    padding: clamp(64px, 8vw, 112px) 0;
    border-top: var(--border-thin);
  }

  .ig-follow__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--space-6);
  }

  .ig-follow__title {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.05;
    color: var(--bone);
    margin: var(--space-3) 0 var(--space-4);
  }

  .ig-follow__lede {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-style: italic;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.6;
    color: var(--fg-soft);
    margin: 0;
  }

  .ig-follow__link {
    font-style: normal;
    color: var(--ember);
    border-bottom: 1px solid rgba(196, 147, 90, 0.45);
    padding-bottom: 1px;
    text-decoration: none;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .ig-follow__link:hover,
  .ig-follow__link:focus-visible {
    color: var(--bone);
    border-bottom-color: var(--bone);
  }

  .ig-follow__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2px;
  }

  .ig-tile__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ig-tile__img-wrap {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--bg-lift);
  }
  .ig-tile__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(6%) contrast(1.05);
    transition: transform var(--t-slow), filter var(--t-slow);
  }
  .ig-tile__link:hover .ig-tile__img-wrap img,
  .ig-tile__link:focus-visible .ig-tile__img-wrap img {
    transform: scale(1.05);
    filter: grayscale(0%) contrast(1.05) brightness(1.05);
  }

  .ig-tile__icon {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(10, 10, 10, 0.55);
    color: var(--bone);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity var(--t-fast), transform var(--t-fast);
    backdrop-filter: blur(2px);
  }
  .ig-tile__link:hover .ig-tile__icon,
  .ig-tile__link:focus-visible .ig-tile__icon {
    opacity: 1;
    transform: translateY(0);
  }

  .ig-tile__label {
    display: block;
    padding: var(--space-2) 2px 0;
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    letter-spacing: var(--letter-spacing-ritual);
    text-transform: uppercase;
    color: var(--silver);
    text-align: center;
  }

  @media (max-width: 900px) {
    .ig-follow__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .ig-follow__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
