---
/**
 * HandmadeArchive — Hand-forged jewelry portfolio from @wenu__mapu Instagram.
 *
 * 65 piezas handmade reales del archivo IG @wenu__mapu (~2017–2021),
 * recortadas desde screenshots del iPad de Ocin (junio 2026). NO son piezas
 * de servicio piercing (esas viven en AtelierGallery); estas son trabajo
 * handmade pasado que respalda las commissions actuales.
 *
 * Cada card abre el PERFIL general de Instagram (el mapping a posts puntuales
 * se perdió al recortar). `alt`, `caption` y `yearApprox` quedan genéricos
 * como placeholders — Ocin los completa caso a caso después.
 *
 * Assets en /public/img/handmade/archive/portfolio-NNN.webp.
 * Si una foto falta, el card cae al placeholder "Photo pending".
 */
interface ArchiveItem {
  n: number;            // índice 1-based, también el sufijo del archivo
  img: string;          // path bajo /public
  alt: string;          // alt descriptivo (placeholder genérico por ahora)
  caption: string;      // 1 línea breve, voz brand (placeholder por ahora)
  yearApprox: number;   // año aproximado — placeholder hasta confirmar por pieza
}

const IG_PROFILE = 'https://www.instagram.com/wenu__mapu/';

/* 65 piezas del portfolio handmade. alt/caption/yearApprox son placeholders
   genéricos; Ocin los completa pieza por pieza más adelante. */
const items: ArchiveItem[] = [
