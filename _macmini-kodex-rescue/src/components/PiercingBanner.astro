---
/**
 * PiercingBanner — home banner for the piercing service (Ocin 2026-07-05).
 *
 * Replaces the abstract CollectionCarousel with REAL content: it replicates the
 * banner already live on /piercing (the `cat-masthead` full-bleed image + the
 * `piercing-hero` intro). Same asset (/img/banners/category/piercing.*), same
 * eyebrow / title / lede language, same CTA pattern — just condensed for the home
 * as a full-bleed masthead with copy overlaid, linking straight to /piercing,
 * booking, and the /constelaciones curated-ear tool.
 *
 * Effects budget: image + CSS scrim only. No JS, no canvas, no timers. The banner
 * is a plain <section> with an eager LCP-friendly image. Cheap on mobile.
 */
---
<section class="pbnr" aria-labelledby="pbnr-title">
  <picture class="pbnr__media">
    {/* Text-free portrait crop of the piercing banner (Ocin 2026-07-07): the shared
        /img/banners/category/piercing.* asset has "PIERCING · BODY JEWELRY" typography
        + a sacred sigil BAKED INTO the right half of the image. On this home masthead
        the copy overlays the left, so that baked-in type bled off the right edge cut-off
        ("PIE…" / "B O…") and read as a broken watermark. This uses a dedicated crop of
        just the portrait (public/img/banners/category/piercing-portrait.*, left 850px,
        zero baked text/sigil). The /piercing + /piercing-jewelry mastheads keep the full
        piercing.* asset where the typography is intentional. */}
    <source type="image/avif" srcset="/img/banners/category/piercing-portrait.avif" />
    <img
      src="/img/banners/category/piercing-portrait.webp"
      alt="Wenu Mapu — ritual body piercing, Truckee California"
      width="850" height="900"
      loading="lazy" decoding="async"
    />
  </picture>
  <span class="pbnr__veil" aria-hidden="true"></span>

  <div class="container pbnr__inner">
    <p class="eyebrow pbnr__eyebrow">Ritual piercing · Truckee, California</p>
    <h2 id="pbnr-title" class="pbnr__title">Piercing as a passage,<br/>not a transaction.</h2>
    <p class="pbnr__lede">
      Ritual body piercing by private appointment in the Truckee / North Lake Tahoe
      area. Implant-grade titanium (ASTM F-136), a sterile single-use needle, and a
      slow conversation about placement.
    </p>
    <div class="pbnr__cta">
      <a href="/piercing" class="btn btn--solid">Explore piercing →</a>
    </div>
    <a href="/piercing" class="pbnr__all">See piercing services &amp; pricing <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .pbnr {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(440px, 62vh, 640px);
    display: flex;
    align-items: flex-end;
    background: var(--obsidian);
    border-block: var(--border-thin);
  }
  .pbnr__media { position: absolute; inset: 0; z-index: 0; display: block; }
  .pbnr__media img {
    width: 100%; height: 100%; object-fit: cover;
    /* portrait crop: bias RIGHT so the face stays in frame on wide masthead ratios
       while the copy overlays the darker left. */
    object-position: 78% 28%;
    filter: saturate(0.95) contrast(1.04);
  }
  @media (max-width: 700px) {
    .pbnr__media img { object-position: 62% 26%; }
  }
  .pbnr__veil {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(180deg, var(--scrim-0) 30%, var(--scrim-strong) 100%),
      linear-gradient(90deg, var(--scrim-mid) 0%, var(--scrim-0) 60%);
  }
  .pbnr__inner {
    position: relative; z-index: 2;
    width: 100%;
    padding-block: clamp(32px, 6vw, 72px);
    display: flex; flex-direction: column; align-items: flex-start;
    gap: var(--space-3);
    max-width: 640px;
  }
  .pbnr__eyebrow { color: var(--ember); margin: 0; }
  .pbnr__title {
    font-family: var(--font-display); font-weight: var(--fw-regular);
    font-size: clamp(2rem, 6vw, 3.6rem); line-height: 1.02;
    color: var(--brand-bone); margin: 0; text-wrap: balance;
    text-shadow: 0 2px 22px var(--scrim-strong);
  }
  .pbnr__lede {
    font-family: var(--font-serif); font-weight: var(--fw-thin);
    font-size: var(--fs-body); line-height: 1.6;
    color: var(--brand-bone); max-width: 52ch; margin: 0;
    opacity: 0.92; text-shadow: 0 1px 14px var(--scrim-strong);
  }
  .pbnr__cta {
    display: flex; flex-wrap: wrap; gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .pbnr__all {
    font-family: var(--font-sans); font-size: var(--fs-eyebrow);
    letter-spacing: var(--letter-spacing-ritual); text-transform: uppercase;
    color: var(--ember); text-decoration: none; margin-top: var(--space-1);
    transition: color var(--t-fast);
  }
  .pbnr__all:hover { color: var(--brand-bone); }
  @media (max-width: 700px) {
    .pbnr { min-height: clamp(440px, 74vh, 600px); }
  }
</style>
