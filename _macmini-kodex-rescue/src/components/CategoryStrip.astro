---
/**
 * CategoryStrip — horizontal-scroll category rail.
 * Slugs map 1:1 to real WooCommerce category slugs so /shop?cat=<slug> filters correctly.
 * (Verified against live getCategories() 2026-07-03: piercing-en, septum, plug,
 *  stretching, hangers-weights, earrings, ring, classic — all resolve to real
 *  /shop filter tabs.)
 * Images: editorial model crops from the maestro folder (public/img/categories).
 */
interface CatItem {
  slug: string;   // WC category slug — must match a real filter tab in /shop
  label: string;
  base: string;   // image basename in /img/categories
}

const items: CatItem[] = [
  { slug: 'piercing-en',     label: 'Piercing',          base: 'cat-piercing' },
  { slug: 'septum',          label: 'Septum',            base: 'cat-septum' },
  { slug: 'plug',            label: 'Plug',              base: 'cat-plug' },
  { slug: 'stretching',      label: 'Stretching',        base: 'cat-stretching' },
  { slug: 'hangers-weights', label: 'Hangers / Weights', base: 'cat-hangers' },
  { slug: 'earrings',        label: 'Ear Jewelry',       base: 'cat-ear-jewelry' },
  { slug: 'ring',            label: 'Ring',              base: 'cat-ring' },
  { slug: 'classic',         label: 'Classic',           base: 'cat-classic' },
];
---
<section class="category-strip" aria-label="Browse categories">
  <div class="category-strip__head">
    <p class="eyebrow">SHOP BY CATEGORY</p>
    <span class="category-strip__hint" aria-hidden="true">Start with the form you wear →</span>
  </div>
  <ul class="category-strip__list" data-fade-in-stagger>
    {items.map(item => (
      <li class="category-strip__item">
        <a href={`/shop?cat=${item.slug}`} class="category-strip__tile">
          <span class="category-strip__media">
            <picture>
              <source srcset={`/img/categories/${item.base}.avif`} type="image/avif" />
              <img src={`/img/categories/${item.base}.webp`} alt="" loading="lazy" decoding="async" width="780" height="784" />
            </picture>
            <span class="category-strip__veil" aria-hidden="true"></span>
          </span>
          <span class="category-strip__label">
            <span class="category-strip__name">{item.label}</span>
            <span class="category-strip__cta">
              <span class="category-strip__cta-text">Shop</span>
              <span class="category-strip__arrow" aria-hidden="true">→</span>
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
