---
import MandalaPortal from '../MandalaPortal.astro';
// Ritual product hero — frames a product macro photo inside an obsidian
// atmosphere (textile pattern + smoke veil + vignette + ember halo) so any
// product photo, even on a neutral background, reads as "museum sagrado"
// rather than e-commerce listing. Reproduces the energy of the Ritual
// Guardian mockup (img-5) without needing a re-shoot.
interface Props {
  imgSrc: string;
  imgAlt: string;
  imgWidth?: number;
  imgHeight?: number;
  /** Eyebrow above the title (category, e.g. "SEPTUM PIERCING") */
  eyebrow: string;
  /** Main piece name */
  title: string;
  /** Material line (e.g. "STERLING SILVER") */
  material?: string;
  /** Optional limited / one-of-a-kind badge */
  badge?: string;
}
const { imgSrc, imgAlt, imgWidth = 1200, imgHeight = 1500, eyebrow, title, material, badge } = Astro.props;
---
<section class="rph" aria-labelledby="rph-title">
  {/* Atmosphere layers — all decorative, behind the product */}
  <div class="rph__atmosphere" aria-hidden="true">
    {/* Subtle textile pattern as background texture */}
    <picture class="rph__textile">
      <source type="image/avif" srcset="/img/brand/wenu-textil-pattern-real.avif"/>
      <img src="/img/brand/wenu-textil-pattern-real.webp" alt="" loading="lazy" decoding="async"/>
    </picture>
    {/* Radial ember halo under the piece */}
    <div class="rph__halo"></div>
    {/* Smoke veil — uses the altar photo as a soft drift */}
    <picture class="rph__smoke">
      <source type="image/avif" srcset="/img/brand/wenu-altar-humo-real.avif"/>
      <img src="/img/brand/wenu-altar-humo-real.webp" alt="" loading="lazy" decoding="async"/>
    </picture>
    {/* Vignette so edges fall to pure obsidian */}
    <div class="rph__vignette"></div>
  </div>

  {/* The piece itself — centred, on a "stone slab" plinth */}
  <div class="rph__piece">
    {badge && <span class="rph__badge">{badge}</span>}
    <div class="rph__plinth">
      <img
        class="rph__img"
        src={imgSrc}
        alt={imgAlt}
        width={imgWidth}
        height={imgHeight}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  {/* Symmetric caption — eyebrow / title / material with bullet dividers */}
  <figcaption class="rph__caption">
    <span class="rph__eyebrow">{eyebrow}</span>
    <h1 id="rph-title" class="rph__title">{title}</h1>
    {material && (
      <span class="rph__material">· {material} ·</span>
    )}
  </figcaption>

  {/* Cosmos access — the same unified spinning mandala portal used across the
       site, kept small and non-invasive. A quiet doorway to the dimensional map. */}
  <MandalaPortal variant="inline" size="clamp(46px, 7vw, 66px)" class="rph__portal" label="Enter the dimensional portal — a map of Mapuche cosmovision" />
</section>

<style>
  .rph {
    position: relative;
    background: var(--obsidian, #080706);
    padding: clamp(18px, 2.6vw, 36px) clamp(16px, 3vw, 48px) clamp(28px, 4vw, 48px);
    overflow: hidden;
    isolation: isolate;
  }

  /* Atmosphere stack */
  .rph__atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .rph__textile,
  .rph__textile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.12;
    mix-blend-mode: screen;
  }
  .rph__halo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -42%);
    width: clamp(520px, 76vw, 900px);
    height: clamp(520px, 76vw, 900px);
    background: radial-gradient(circle, rgba(196, 147, 90, 0.22) 0%, rgba(196, 147, 90, 0.08) 28%, transparent 60%);
    border-radius: 50%;
    filter: blur(20px);
  }
  .rph__smoke,
  .rph__smoke img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.28;
    mix-blend-mode: screen;
    filter: blur(2px);
  }
  .rph__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 30%, rgba(8, 7, 6, 0.6) 75%, rgba(8, 7, 6, 0.95) 100%);
  }
  .rph__watermark {
    position: absolute;
    top: clamp(16px, 3vw, 36px);
    right: clamp(16px, 3vw, 40px);
    width: clamp(44px, 5vw, 72px);
    opacity: 0.12;
    mix-blend-mode: screen;
  }
  .rph__watermark img {
    display: block;
    width: 100%;
    height: auto;
    filter: brightness(1.2) sepia(0.18) hue-rotate(-12deg);
  }
  @media (max-width: 480px) {
    .rph__watermark { opacity: 0.09; }
  }

  /* Piece + plinth */
  .rph__piece {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: clamp(20px, 3vw, 36px);
  }
  .rph__badge {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 9.5px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ember, #C4935A);
    background: rgba(8, 7, 6, 0.72);
    border: 1px solid rgba(196, 147, 90, 0.4);
    padding: 6px 14px;
    margin-bottom: 22px;
  }
  .rph__plinth {
    width: min(640px, 88vw);
    aspect-ratio: 1;
    /* 2026-06-25 (Ocin · "fondo blanco"): the piece now rests on a warm SHELL
       slab (off-white, NOT #fff), framed by the obsidian atmosphere. Studio
       white-bg photos dissolve into the slab instead of reading as a hard white
       box; dark-bg pieces sit on it like a museum mat. The slab leads; the
       textile + smoke + vignette + halo still surround it. */
    background:
      linear-gradient(158deg, #f3eee4 0%, var(--product-panel) 64%, #ddd6c8 100%);
    border-radius: clamp(8px, 1.4vw, 18px);
    border: 1px solid rgba(196, 147, 90, 0.22);
    box-shadow:
      0 26px 64px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.55);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(22px, 5vw, 58px);
  }
  .rph__img {
    position: relative;
    z-index: 1;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    /* 2026-06-24 (Ocin): show the WHOLE piece, never clipped. Soft warm drop on
       the shell slab gives the piece lift without the old obsidian/ember glow,
       which muddied on the light slab. */
    filter: drop-shadow(0 14px 30px rgba(40, 30, 18, 0.30));
  }

  /* Caption — perfectly axial, generous spacing */
  .rph__caption {
    position: relative;
    z-index: 1;
    text-align: center;
    color: var(--bone, #F2EDE4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .rph__eyebrow {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 10.5px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--silver, #A8A39A);
  }
  .rph__title {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1;
    margin: 0;
    color: var(--bone, #F2EDE4);
    text-transform: uppercase;
  }
  .rph__material {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 10.5px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: var(--ember, #C4935A);
    margin-top: 4px;
  }

  /* Cosmos access — unified MandalaPortal component, small + non-invasive.
     Small signature seal tucked in the lower-right corner — does NOT compete with
     the piece (which leads). The big centred portal lives on the home / cosmos. */
  :global(.rph__portal) {
    position: absolute !important;
    bottom: clamp(12px, 2.5vw, 26px);
    right: clamp(12px, 2.5vw, 26px);
    z-index: 2;
    margin: 0;
    opacity: 0.55;
  }
  :global(.rph__portal:hover) { opacity: 0.9; }
</style>
