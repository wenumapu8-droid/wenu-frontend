---
// ── ArtistCredit ── mini-banners de crédito para la PDP.
// Renderiza condicionalmente dos créditos discretos, en lenguaje bronze/ember:
//   1. Artist credit  → piezas curadas de un artista independiente (Alai Wakan).
//   2. Material origin → piezas con meteorito Vaca Muerta / Atacama.
// Ambos son opcionales: solo se renderiza el bloque cuyo dato venga definido.
// Si ninguna prop está presente, el componente no emite nada (no frame vacío).
interface Props {
  artist?: string;
  igHandle?: string;
  igUrl?: string;
  materialOrigin?: string;
  materialOriginUrl?: string;
}
const { artist, igHandle, igUrl, materialOrigin, materialOriginUrl } = Astro.props;
const hasArtist = Boolean(artist);
const hasMaterial = Boolean(materialOrigin);
---

{(hasArtist || hasMaterial) && (
  <div class="artist-credit">
    {hasArtist && (
      <a
        class="credit-banner"
        href={igUrl}
        target="_blank"
        rel="noopener"
        aria-label={`Crafted by ${artist} — Spanish silversmith. Open Instagram in a new tab.`}
      >
        {/* Instagram glyph — inline SVG 18×18, ember */}
        <svg class="credit-banner__glyph" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
          <circle cx="12" cy="12" r="4" />
          <line x1="17.5" y1="6.5" x2="17.5" y2="6.5" />
        </svg>
        <span class="credit-banner__text">
          Crafted by <strong class="credit-banner__name">{artist}</strong> · Spanish silversmith
          {igHandle && <span class="credit-banner__handle"> {igHandle}</span>}
        </span>
      </a>
    )}

    {hasMaterial && (
      <a
        class="credit-banner"
        href={materialOriginUrl}
        aria-label={`${materialOrigin}. Read the material provenance.`}
      >
        {/* Meteorite glyph — inline SVG 18×18, ember */}
        <svg class="credit-banner__glyph" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="12" r="7" />
          <path d="M14 5l5-2-2 5" />
          <circle cx="9" cy="11" r="1" fill="currentColor" stroke="none" />
          <circle cx="13" cy="14" r="0.9" fill="currentColor" stroke="none" />
        </svg>
        <span class="credit-banner__text">
          <strong class="credit-banner__name">Atacama meteorite</strong> · {materialOrigin?.replace(/^Atacama meteorite\s*·\s*/i, '')} · Atacama Desert, Chile
        </span>
      </a>
    )}
  </div>
)}

<style>
  .artist-credit {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: var(--space-4) 0 var(--space-3);
  }
  .credit-banner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-alt);
    border: 1px solid var(--bronze);
    border-radius: 2px;
    text-decoration: none;
    color: var(--silver);
    transition: border-color var(--t-fast), color var(--t-fast), box-shadow var(--t-fast);
  }
  .credit-banner:hover,
  .credit-banner:focus-visible {
    border-color: var(--ember);
    color: var(--bone);
    box-shadow: 0 0 18px rgba(201, 168, 76, 0.16);
    outline: none;
  }
  .credit-banner__glyph {
    flex: 0 0 auto;
    color: var(--ember);
  }
  .credit-banner__text {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.4;
    color: inherit;
  }
  .credit-banner__name {
    font-family: var(--font-display);
    font-weight: var(--fw-regular, 400);
    color: var(--bone);
  }
  .credit-banner__handle {
    color: var(--ember);
    letter-spacing: 0.02em;
  }
  @media (prefers-reduced-motion: reduce) {
    .credit-banner { transition: none; }
  }
</style>
