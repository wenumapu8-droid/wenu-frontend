---
interface Props {
  variant?: 'default' | 'white' | 'square';
  height?: number;
  alt?: string;
}
const { variant = 'default', height = 36, alt = 'Wenu Mapu' } = Astro.props;

const sources = {
  default: '/logos/wenu-mapu-logo.png',
  white:   '/logos/wenu-mapu-logo-white.png',
  square:  '/logos/wenu-mapu-square.png',
};
const src = sources[variant];
---
<img
  src={src}
  alt={alt}
  height={height}
  loading="eager"
  style={`height:${height}px;width:auto;`}
/>
