---
import en from '../i18n/en.json';

interface Props {
  /** HTML tag for the section title. Use 'h1' on care-guide where this is
   *  the page primary heading; 'h2' elsewhere. */
  titleAs?: 'h1' | 'h2';
}

const { titleAs = 'h2' } = Astro.props;
const TitleTag = titleAs;
const groups = en.care.groups;
const order = ['ear', 'face', 'mouth', 'body'] as const;
---
<section class="healing" aria-labelledby="healing-title">
  <header class="healing__head">
    <p class="eyebrow">{en.care.eyebrow}</p>
    <TitleTag id="healing-title" class="healing__title">{en.care.title}</TitleTag>
    <p class="healing__intro">{en.care.intro}</p>
  </header>

  <div class="healing__groups">
    {order.map(key => {
      const g = (groups as any)[key];
      const headingId = `healing-${key}`;
      return (
        <article class="healing__group" aria-labelledby={headingId}>
          <header class="healing__group-head">
            <h3 id={headingId} class="healing__group-label">{g.label}</h3>
            <p class="healing__group-axis">{g.axis}</p>
          </header>
          <ul class="healing__list">
            {g.items.map((item: { zone: string; weeks: string }) => (
              <li class="healing__row">
                <span class="healing__zone">{item.zone}</span>
                <span class="healing__dots" aria-hidden="true"></span>
                <span class="healing__weeks">{item.weeks}</span>
              </li>
            ))}
          </ul>
        </article>
      );
    })}
  </div>

  <p class="healing__disclaimer">{en.care.disclaimer}</p>
</section>
