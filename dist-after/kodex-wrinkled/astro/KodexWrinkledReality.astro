---
import "./kodex-wrinkle.css";

interface Props {
  title?: string;
  description?: string;
  shaderBase?: string;
}

const {
  title =
    "REALITY WRINKLES AROUND THE SIGNAL.",

  description =
    "The room, grid and horizon deform as one continuous membrane.",

  shaderBase =
    "/assets/kodex/shaders",
} = Astro.props;
---

<section
  class="kdx-wrinkle"
  data-kdx-wrinkle
  data-shader-base={shaderBase}
  data-state="0"
>
  <canvas
    class="kdx-wrinkle__canvas"
    aria-hidden="true"
  ></canvas>

  <div
    class="kdx-fallback"
    aria-hidden="true"
  ></div>

  <div class="kdx-shell">
    <header class="kdx-header">
      <div class="kdx-logo">
        KODEX−∞
      </div>

      <div class="kdx-header__right">
        <span class="kdx-dot"></span>
        <span>REALITY · DEFORMING</span>
        <span>KDX_06</span>
      </div>
    </header>

    <div class="kdx-main">
      <div class="kdx-copy">
        <p class="kdx-kicker">
          06 / 08 · TOPOLOGICAL STRESS PROTOCOL
        </p>

        <h2 class="kdx-title">
          {title}
        </h2>

        <p class="kdx-description">
          {description}
        </p>

        <div class="kdx-actions">
          <button
            class="kdx-cta"
            type="button"
            data-kdx-activate
          >
            FOLD THE FIELD →
          </button>

          <button
            class="kdx-mic"
            type="button"
            data-kdx-mic
            aria-label="Activate microphone response"
            aria-pressed="false"
          >
            MIC
          </button>
        </div>
      </div>

      <div aria-hidden="true"></div>

      <aside class="kdx-rail">
        <div>
          State
          <strong data-kdx-state>
            DORMANT
          </strong>
        </div>

        <div>
          Crease
          <strong data-kdx-crease>
            DORMANT
          </strong>
        </div>

        <div>
          Topology
          <strong>
            MEMBRANE
          </strong>
        </div>

        <div>
          FPS
          <strong data-kdx-fps>
            —
          </strong>
        </div>
      </aside>
    </div>

    <footer class="kdx-footer">
      <span>PREVIOUS</span>

      <span
        class="kdx-progress"
        aria-hidden="true"
      ></span>

      <span class="kdx-footer__index">
        06 / 08 · INDEX
      </span>
    </footer>
  </div>
</section>

<script>
  import {
    mountKodexWrinkledReality
  } from "./kodex-wrinkle-client";

  document
    .querySelectorAll<HTMLElement>(
      "[data-kdx-wrinkle]"
    )
    .forEach((element) => {
      mountKodexWrinkledReality(
        element
      );
    });
</script>
