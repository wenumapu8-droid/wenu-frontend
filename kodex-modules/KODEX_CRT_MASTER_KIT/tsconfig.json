{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": [
      "astro/client"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.astro",
    "examples/**/*.ts"
  ]
}