---
interface Props {
  src: string;
  pageUrl: string;
  creator: string;
  alt: string;
  class?: string;
}
const { src, pageUrl, creator, alt, class: className = '' } = Astro.props;
---
<figure class={`kdx-giphy ${className}`}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  <figcaption>
    <a href={pageUrl} target="_blank" rel="noopener noreferrer">
      {creator} · Powered by GIPHY
    </a>
  </figcaption>
</figure>

<style>
  .kdx-giphy { margin: 0; position: relative; }
  .kdx-giphy img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .kdx-giphy figcaption {
    position: absolute; right: .4rem; bottom: .35rem;
    padding: .2rem .35rem; background: rgba(0,0,0,.72);
    font: 10px/1.2 ui-monospace, monospace; letter-spacing: .06em;
  }
  .kdx-giphy a { color: #eee; text-decoration: none; }
</style>
