---
interface Props {
  scene?: "observe" | "descent" | "cosmology" | "signal";
  glyphs?: "kodex" | "ascii" | "petscii" | "blocks";
  title?: string;
  class?: string;
}

const {
  scene = "observe",
  glyphs = "kodex",
  title = "THE ARCHIVE WATCHES.",
  class: className = "",
} = Astro.props;
---

<section class:list={["kdx-ascii-scene", className]} data-kdx-ascii-root data-scene={scene} data-glyphs={glyphs}>
  <canvas data-kdx-canvas aria-label={`Visual generativo ${scene}`}></canvas>
  <div class="kdx-ascii-scene__content">
    <p>KDX://{scene.toUpperCase()}/LIVE</p>
    <h2>{title}</h2>
    <div class="kdx-ascii-scene__actions">
      <button type="button" data-kdx-randomize>RANDOMIZE</button>
      <button type="button" data-kdx-set-scene="observe">OBSERVE</button>
      <button type="button" data-kdx-set-scene="descent">DESCENT</button>
      <button type="button" data-kdx-set-scene="cosmology">COSMOS</button>
      <button type="button" data-kdx-set-scene="signal">SIGNAL</button>
    </div>
  </div>
</section>

<script>
  import { mountKodexAsciiScene } from "../lib/kodex-ascii/mount";
  document.querySelectorAll<HTMLElement>("[data-kdx-ascii-root]:not([data-kdx-mounted])").forEach(root => {
    root.dataset.kdxMounted = "true";
    mountKodexAsciiScene(root);
  });
</script>
