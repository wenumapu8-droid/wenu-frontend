---
import "./kodex-flip.css";

interface Props {
  title?: string;
  description?: string;
  shaderBase?: string;
}

const {
  title =
    "THE WORLD TURNS WITHOUT ROTATING.",

  description =
    "Two incompatible projections occupy the same architecture.",

  shaderBase =
    "/assets/kodex/shaders",
} = Astro.props;
---

<section
  class="kdx-flip"
  data-kdx-flip
  data-shader-base={shaderBase}
  data-state="0"
>
  <canvas
    class="kdx-flip__canvas"
    aria-hidden="true"
  ></canvas>

  <div
    class="kdx-fallback"
    aria-hidden="true"
  ></div>

  <div class="kdx-shell">
    <header class="kdx-header">
      <div class="kdx-logo">
        KODEX−∞
      </div>

      <div class="kdx-header__right">
        <span class="kdx-dot"></span>
        <span>PROJECTION · UNSTABLE</span>
        <span>KDX_07</span>
      </div>
    </header>

    <div class="kdx-main">
      <div class="kdx-copy">
        <p class="kdx-kicker">
          07 / 08 · PROJECTION REVERSAL PROTOCOL
        </p>

        <h2 class="kdx-title">
          {title}
        </h2>

        <p class="kdx-description">
          {description}
        </p>

        <div class="kdx-actions">
          <button
            class="kdx-cta"
            type="button"
            data-kdx-activate
          >
            FLIP THE FRAME →
          </button>

          <button
            class="kdx-mic"
            type="button"
            data-kdx-mic
            aria-label="Activate microphone response"
            aria-pressed="false"
          >
            MIC
          </button>
        </div>
      </div>

      <div aria-hidden="true"></div>

      <aside class="kdx-rail">
        <div>
          State
          <strong data-kdx-state>
            DORMANT
          </strong>
        </div>

        <div>
          Phase
          <strong data-kdx-phase>
            PROJECTION A
          </strong>
        </div>

        <div>
          Geometry
          <strong>
            DUAL
          </strong>
        </div>

        <div>
          FPS
          <strong data-kdx-fps>
            —
          </strong>
        </div>
      </aside>
    </div>

    <footer class="kdx-footer">
      <span>PREVIOUS</span>

      <span
        class="kdx-progress"
        aria-hidden="true"
      ></span>

      <span class="kdx-footer__index">
        07 / 08 · INDEX
      </span>
    </footer>
  </div>
</section>

<script>
  import {
    mountKodexPerspectiveFlip
  } from "./kodex-flip-client";

  document
    .querySelectorAll<HTMLElement>(
      "[data-kdx-flip]"
    )
    .forEach((element) => {
      mountKodexPerspectiveFlip(
        element
      );
    });
</script>
