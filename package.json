{
  "name": "wenu-frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/verify-build.mjs && node scripts/audit-catalog.mjs --soft && node scripts/lamina/externalizar-svg-postbuild.mjs",
    "test:kodex:core": "node --test scripts/kodex-*.test.mjs",
    "test:kodex:lib": "node --test 'src/lib/kodex/**/*.test.ts' 'src/lib/kodex/*.test.ts' 'src/lib/kodex*.test.ts' 'src/lib/kodex/*.test.ts'",
    "test:kodex": "npm run test:kodex:core && npm run test:kodex:lib",
    "audit:kodex:integrity": "node scripts/kodex-integrity-audit.mjs",
    "validate:kodex:core": "npm run test:kodex && npm run audit:kodex:integrity && ALLOW_EMPTY_PRODUCTS=true npm run build && npm run gate:kodex:visual && npm run kodex:inventario",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "audit:catalog:strict": "node scripts/audit-catalog.mjs",
    "audit:catalog:soft": "node scripts/audit-catalog.mjs --soft",
    "metrics": "node scripts/metrics-report.mjs",
    "clean:images": "node scripts/clean-images.mjs",
    "gen:avif": "node scripts/gen-avif.mjs",
    "assets:inventory": "node scripts/asset-inventory.mjs",
    "assets:board": "node scripts/asset-board.mjs",
    "assets:chatgpt-intake": "node scripts/chatgpt-image-intake.mjs",
    "assets:brand-library": "node scripts/brand-asset-audit.mjs",
    "agents:autopilot": "unset npm_config_prefix && . \"$HOME/.nvm/nvm.sh\" && nvm use >/dev/null && node command-center/autopilot.mjs",
    "agents:autopilot:once": "unset npm_config_prefix && . \"$HOME/.nvm/nvm.sh\" && nvm use >/dev/null && node command-center/autopilot.mjs --once",
    "agents:autopilot:dispatch": "unset npm_config_prefix && . \"$HOME/.nvm/nvm.sh\" && nvm use >/dev/null && WENU_AUTOPILOT_MODE=dispatch node command-center/autopilot.mjs",
    "build:cloudflare": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "gate:kodex:visual": "node scripts/kodex-visual-fidelity-gate.mjs",
    "kodex:inventario": "node scripts/kodex-inventario-ensamblaje.mjs",
    "kodex:equipo": "node scripts/kodex-equipo.mjs",
    "prebuild": "node scripts/kodex-prebuild-lock.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/instrument-sans": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/space-grotesk": "^5.3.0",
    "animejs": "^4.5.0",
    "astro": "^6.2.1",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "sharp": "^0.34.5",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@neplex/vectorizer": "^0.1.0",
    "echarts": "^6.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0"
  }
}