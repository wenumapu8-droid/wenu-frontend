    {
      "id": "glitch-break",
      "numero": 7,
      "titulo": "GLITCH BREAK",
      "subtitulo": "Ruptura controlada / Fractura digital",
      "referencia": "reference/canon/t02-07-glitch-break.png",
      "acento": "#ff1e5a",
      "modos": ["ADD", "OVERLAY"],
      "conflicto": "El pliego lo llama 'GLITCH FRACTURE'; el poster 'GLITCH BREAK'. Se adopta el del poster.",
      "alias": ["glitch-fracture"],
      "parametros": {
        "glitch_amount": { "default": 0.62, "rango": [0, 1] },
        "block_size":    { "default": 64.0, "rango": [1, 256] },
        "speed":         { "default": 1.80, "rango": [0, 8] },
        "displacement":  { "default": 0.15, "rango": [0, 1] },
        "rgb_shift":     { "default": 0.50, "rango": [0, 1] }
      },
      "notas_poster": {
        "pipeline": ["inject noise matrix", "shift pixel drift", "slice data shear", "displace channel split", "collapse structure fail", "recode glitch signature", "archive rupture log"],
        "pseudo_glsl": [
          "vec2 uv = fragCoord.xy / resolution.xy;",
          "float n = texture(noiseTex, uv * time).r;",
          "float g = glitch(uv, time, n);",
          "vec3 col = texture(inputTex, uv + g).rgb;",
          "col = channelShift(col, n);",
          "col = slice(col, n, time);",
          "col = displace(col, n);",
          "if (n > 0.75) col = invert(col);"
        ]
      }
    },
