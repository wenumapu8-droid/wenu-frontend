{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "astro/client"
    ]
  },
  "include": [
    "src/lib/kodex/signals.ts",
    "src/lib/kodex/memory.ts",
    "src/lib/kodex/atlas.ts",
    "src/lib/kodex/nodes.ts",
    "src/lib/kodex/scene-states.ts",
    "src/lib/kodex/atlas-nodes.ts"
  ]
}
