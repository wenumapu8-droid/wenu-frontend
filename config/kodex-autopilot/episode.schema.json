{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenumapuonline.com/schemas/kdx-autopilot-episode-v0.1.json",
  "title": "KDX Autopilot Episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "title",
    "status",
    "format",
    "duration_sec",
    "aspect_ratio",
    "render",
    "gates",
    "outputs"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "pattern": "^KDX-[A-Z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["CONCEPT", "APPROVED_BRIEF", "PREPARED", "IN_PRODUCTION", "MASTER_CANDIDATE", "APPROVED", "RELEASED"]
    },
    "format": {
      "enum": ["film", "short", "longform", "transmission", "loop", "process"]
    },
    "duration_sec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "aspect_ratio": {
      "enum": ["16:9", "9:16", "1:1", "4:5"]
    },
    "source_assets": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "renderers", "allow_generative_video"],
      "properties": {
        "mode": {
          "enum": ["code_first", "hybrid"]
        },
        "renderers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["dom", "svg", "canvas2d", "three", "glsl", "hybrid"]
          }
        },
        "allow_generative_video": {
          "const": false
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": true
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_approval_required", "publish_automatically", "max_revision_cycles"],
      "properties": {
        "human_approval_required": { "const": true },
        "publish_automatically": { "const": false },
        "max_revision_cycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["master_16x9", "shorts_9x16", "subtitles", "thumbnail_candidates", "qa_report", "provenance_log"]
      }
    }
  }
}
