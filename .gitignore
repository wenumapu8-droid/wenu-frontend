# La obra pesa 1.9 GB y la stagea opencode: vive en su carpeta, no en el
# historial. Lo que SI se versiona es el manifiesto y las proporciones
# medidas — esa es la interfaz entre el contenido y el motor, y es lo que
# hace falta para reconstruir la lectura si los archivos se mueven.
public/kodex-content/opencode/assets/
# Material de origen: fotos RAW de camara, multimedia sin tratar. Es la
# materia prima de la que salen las laminas, no la entrega.
public/kodex-content/opencode/vol/*/raw/
reference/
capturas/
