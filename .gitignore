# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# defensive secrets block
.env
.env.local
.env.*.local
.env.production
.env.bak
.env.bak*
.env.backup-*
.env.save
*.env.bak*

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# claude code local settings
.claude/

# runtime logs
logs/
*.log

*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
tokens/
.cloudflared/

# catalog cleanup pipeline outputs (regenerated per run)
.runtime/

# command center runtime (dispatch logs are per-run)
command-center/dispatch-*.log

# in-progress product drafts (not source-of-truth)
drafts/

# large binary artefacts in reports/ — commit small ones, ignore big PDFs
reports/*.pdf

# raw brand asset dumps (too large for git — keep in ~/Obsidian/WenuAgent/brand/ or ~/WenuBackups/)
docs/brand/

# session scratch / personal bookmarks
tmp/
RETOMAR-AQUI.md
todo.md

# build / deploy logs (per-run, not source)
build*.out
deploy-now.sh

# alternate build output (cosmos preview)
dist-cosmos/

# QA visual captures (per-run screenshots)
qa-*.jpeg
qa-*.jpg
qa-*.png
.playwright-mcp/

# raw photo-shoot dumps / design references / QA verification captures
# (not build inputs, not referenced by src/ or scripts/ — large binary scratch)
design-refs/
verification-shots/
_verify_shots/
_shoot-list/
_shoot-list-corregido/
_shoot-list-integridad/
.captures/
scripts/_v/

# backup files anywhere in the tree (dated or plain .bak)
*.bak
*.bak-*
*.bak.*

# script editor backups
scripts/*.bak

# archived/unused assets (kept on disk, out of source)
_archive-unused-assets/

# replaced-asset backups (kept on disk, out of source)
public/img/**/*-old.avif
public/img/**/*-old.webp

# visual-studio pipeline outputs (regenerated per SKU)
visual-studio/

# data backups snapshot pile
data/backups/

# python bytecode
__pycache__/

# dated working scratch (classification sheets, inventory dumps — belong in Obsidian)
clasificacion-*.md
inventario-fotos-*.md
error-sheet-*.md
backlog-foto-*.md
_redirects.generated.txt
redirects-slug-to-sku.json
public/img/kodex/packs/*.zip

# Arte KODEX servido desde R2 (no en git)
public/kodex-content/art/

# Playwright CLI — artefactos de sesion (snapshots, estado del browser).
# La herramienta escribe a disco en vez de al contexto del agente; eso es
# scratch por corrida, no fuente. Ver KODEX-HERRAMIENTAS.md
.playwright-cli/
.playwright/
