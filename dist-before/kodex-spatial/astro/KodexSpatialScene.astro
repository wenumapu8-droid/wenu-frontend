---
export interface Props {
  sceneId?: string;
  initialMode?: 0 | 1 | 2 | 3;
  title?: string;
}

const {
  sceneId = 'kdx-spatial-scene',
  initialMode = 0,
  title = 'THE CORRIDOR DOES NOT LEAD. IT DECIDES.',
} = Astro.props;
---

<section
  id={sceneId}
  class="kdx-spatial-scene"
  data-kdx-spatial
  data-initial-mode={initialMode}
  aria-label="KODEX spatial distortion protocol"
>
  <canvas data-kdx-canvas></canvas>

  <header class="kdx-spatial-scene__topbar">
    <strong>KODEX−∞</strong>
    <span>SPATIAL DISTORTION · ACTIVE</span>
  </header>

  <div class="kdx-spatial-scene__copy">
    <small>03 / NON-EUCLIDEAN PROTOCOL</small>
    <h2>{title}</h2>
    <p>Perspective is an active signal.</p>
  </div>

  <nav class="kdx-spatial-scene__modes" aria-label="Spatial modes">
    <button data-kdx-mode="0">DUAL</button>
    <button data-kdx-mode="1">RIPPLE</button>
    <button data-kdx-mode="2">SPLIT</button>
    <button data-kdx-mode="3">WRINKLE</button>
  </nav>

  <button class="kdx-spatial-scene__cta" data-kdx-activate>
    ACTIVATE DISTORTION →
  </button>
</section>

<script>
  import { mountKodexSpatialScenes } from './kodex-spatial-client';
  mountKodexSpatialScenes();
</script>

<style>
  .kdx-spatial-scene { position:relative; width:100%; height:100dvh; overflow:hidden; background:#050608; color:#e7e5df; }
  .kdx-spatial-scene canvas { position:absolute; inset:0; width:100%; height:100%; }
  .kdx-spatial-scene__topbar { position:absolute; z-index:2; inset:20px 24px auto; display:flex; justify-content:space-between; border-bottom:1px solid rgba(255,255,255,.18); padding-bottom:12px; font:12px/1 ui-monospace,monospace; letter-spacing:.16em; }
  .kdx-spatial-scene__copy { position:absolute; z-index:2; left:6vw; top:22%; width:min(560px,46vw); }
  .kdx-spatial-scene__copy small { color:#ff3027; font:11px/1 ui-monospace,monospace; letter-spacing:.2em; }
  .kdx-spatial-scene__copy h2 { margin:12px 0; font:900 clamp(54px,7vw,118px)/.84 Impact,sans-serif; }
  .kdx-spatial-scene__modes { position:absolute; z-index:2; right:24px; top:24%; display:grid; gap:8px; }
  .kdx-spatial-scene button { border:1px solid rgba(255,255,255,.22); background:rgba(0,0,0,.45); color:inherit; padding:12px 16px; font:10px/1 ui-monospace,monospace; letter-spacing:.13em; }
  .kdx-spatial-scene__cta { position:absolute; z-index:2; left:6vw; bottom:7vh; min-width:360px; border-color:#ff3027 !important; }
  @media (max-width:760px) {
    .kdx-spatial-scene__copy { left:16px; right:16px; top:52%; width:auto; }
    .kdx-spatial-scene__copy h2 { font-size:13vw; }
    .kdx-spatial-scene__modes { top:74px; right:12px; }
    .kdx-spatial-scene__cta { left:16px; right:16px; bottom:18px; min-width:0; }
  }
</style>
