---
import { KODEX_MICROGRAPHICS, type KodexMicrographicName, type KodexMotion } from '../../lib/kodex/micrographics';

type Props = {
  name: KodexMicrographicName;
  size?: number | string;
  tone?: 'inherit' | 'red' | 'orange' | 'cyan' | 'green' | 'violet' | 'magenta' | 'white';
  motion?: KodexMotion | 'auto';
  label?: string;
  class?: string;
};

const {
  name,
  size = 64,
  tone = 'inherit',
  motion = 'auto',
  label,
  class: className = '',
} = Astro.props;

const glyph = KODEX_MICROGRAPHICS[name];
const resolvedMotion = motion === 'auto' ? glyph.motion : motion;
const style = typeof size === 'number' ? `--kdx-glyph-size:${size}px` : `--kdx-glyph-size:${size}`;
---

<span
  class:list={['kdx-glyph', `kdx-tone-${tone}`, `kdx-motion-${resolvedMotion}`, className]}
  style={style}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <svg viewBox={glyph.viewBox} focusable="false">
    <use href={`/assets/kodex/kodex-micrographics.svg#${glyph.id}`} />
  </svg>
</span>
