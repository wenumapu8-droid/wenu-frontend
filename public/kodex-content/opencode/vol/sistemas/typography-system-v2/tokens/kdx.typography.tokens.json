{
  "name": "KODEX Typography Tokens",
  "version": "2.0.0",
  "base": {
    "rootPx": 16,
    "baselinePx": 4,
    "verticalRhythmPx": 8,
    "minimumTouchTargetPx": 44,
    "minimumFunctionalTextPx": 9,
    "maximumFamiliesPerScene": 4,
    "maximumHeadlineWords": 7,
    "maximumBodyWidthCh": 56,
    "maximumTechnicalWidthCh": 72
  },
  "families": {
    "displayCondensed": "\"Barlow Condensed\", \"Arial Narrow\", Impact, sans-serif",
    "displayTech": "\"Oxanium\", Eurostile, BankGothic, sans-serif",
    "ui": "\"Inter Tight\", Inter, \"Helvetica Neue\", Arial, sans-serif",
    "data": "\"IBM Plex Mono\", \"SFMono-Regular\", Consolas, monospace",
    "terminal": "\"Azeret Mono\", \"IBM Plex Mono\", Consolas, monospace",
    "editorialDisplay": "\"Bodoni Moda\", Didot, Bodoni, serif",
    "editorialReading": "\"Libre Baskerville\", Baskerville, Georgia, serif"
  },
