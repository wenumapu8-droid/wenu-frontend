      "letterSpacingEm": 0.09,
      "family": "data",
      "weight": 500,
      "maxWidthCh": 84
    }
  },
  "spacing": {
    "inline": {
      "iconTextGap": "0.55em",
      "labelValueGap": "0.75em",
      "metadataGap": "1.25em",
      "navItemGap": "1.5em",
      "wordmarkTracking": "0.02em"
    },
    "block": {
      "eyebrowToHeadline": "8px",
      "headlineToLead": "16px",
      "headlineToBody": "24px",
      "panelTitleToContent": "12px",
      "bodyParagraphGap": "0.9em",
      "sectionGapMobile": "48px",
      "sectionGapDesktop": "80px",
      "dataRowGap": "6px",
      "terminalRowGap": "2px"
    },
    "padding": {
      "microPanel": "8px",
      "smallPanel": "12px",
      "panelMobile": "16px",
      "panelDesktop": "20px",
      "heroModule": "clamp(20px, 2.4vw, 40px)"
    }
  },
  "rules": {
    "allCaps": [
      "posterXXL",
      "posterXL",
      "hero",
      "techHero",
      "section",
      "label",
      "data",
      "terminal",
      "micro"
    ],
    "sentenceCase": [
      "panel",
      "bodyLead",
      "body",
      "editorialBody"
    ],
    "hyphenation": "off for headlines; language-aware for longform only",
    "widows": "avoid single-word final lines in headlines",
    "minimumContrast": "WCAG AA for functional text",
    "textureRule": "Distress belongs to a mask/texture layer, never the only readable glyph layer.",
    "responsiveRule": "Never scale microtext below its minimum token; reduce density instead."
  }
}