{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "KODEX Design Tokens",
  "version": "1.0.0",
  "meta": {
    "principle": "Behavior, hierarchy and signal discipline over decorative density.",
    "baseUnitPx": 4,
    "defaultGridColumns": 12,
    "defaultBaselinePx": 8,
    "maxActiveAccentColors": 2,
    "maxConcurrentHighPriorityMotions": 2
  },
  "color": {
    "neutral": {
      "black000": "#030405",
      "black100": "#050608",
      "black200": "#0A0D10",
      "black300": "#11161A",
      "gray400": "#343B42",
      "gray500": "#68727A",
      "gray600": "#8B949C",
      "gray700": "#B8C0C5",
      "offwhite": "#E9EDE8",
      "white": "#F7F8F4"
    },
    "signal": {
      "red": "#FF1744",
      "coral": "#FF4D3A",
      "orange": "#FF7A1A",
      "acid": "#B9FF3B",
      "green": "#00E879",
      "cyan": "#10E9FF",
      "blue": "#3A56FF",
      "violet": "#8128FF",
      "magenta": "#FF0FA8",
      "gold": "#D8AE5A"
    },
    "semantic": {
      "background": "{color.neutral.black100}",
      "surface": "{color.neutral.black200}",
      "surfaceRaised": "{color.neutral.black300}",
      "border": "{color.neutral.gray400}",
      "textPrimary": "{color.neutral.offwhite}",
      "textSecondary": "{color.neutral.gray600}",
      "textMuted": "{color.neutral.gray500}",
      "focus": "{color.signal.cyan}",
      "success": "{color.signal.green}",
      "warning": "{color.signal.orange}",
      "danger": "{color.signal.red}"
    },
    "coverage": {
      "backgroundMinPct": 70,
      "backgroundMaxPct": 85,
      "structuralNeutralMinPct": 10,
      "structuralNeutralMaxPct": 20,
      "primaryAccentMinPct": 5,
      "primaryAccentMaxPct": 12,
      "secondaryAccentMinPct": 0,
      "secondaryAccentMaxPct": 4
    },
    "sceneThemes": {
      "threshold": {
        "accent": "#FF1744",
        "accentSecondary": "#E9EDE8",
        "background": "#050608"
      },
      "observe": {
        "accent": "#10E9FF",
        "accentSecondary": "#8128FF",
        "background": "#050608"
      },
      "descent": {
        "accent": "#FF7A1A",
        "accentSecondary": "#10E9FF",
        "background": "#050608"
      },
      "archive": {
        "accent": "#B9FF3B",
        "accentSecondary": "#E9EDE8",
        "background": "#050608"
      },
      "machine": {
        "accent": "#10E9FF",
        "accentSecondary": "#8128FF",
        "background": "#050608"
      },
      "cosmology": {
        "accent": "#FF0FA8",
        "accentSecondary": "#3A56FF",
        "background": "#050608"
      },
      "ghost": {
        "accent": "#E9EDE8",
        "accentSecondary": "#FF1744",
        "background": "#050608"
      },
      "return": {
        "accent": "#B9FF3B",
        "accentSecondary": "#D8AE5A",
        "background": "#050608"
      }
    }
  },
  "typography": {
    "family": {
      "display": "\"Arial Narrow\", \"Helvetica Neue\", Impact, sans-serif",
      "ui": "Inter, \"Helvetica Neue\", Arial, sans-serif",
      "mono": "\"IBM Plex Mono\", \"JetBrains Mono\", Consolas, monospace",
      "editorial": "Inter, \"Helvetica Neue\", Arial, sans-serif"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "black": 900
    },
    "desktop": {
      "hero": {
        "size": "clamp(64px, 7.8vw, 128px)",
        "lineHeight": 0.84,
        "trackingEm": -0.045
      },
      "section": {
        "size": "clamp(38px, 4.6vw, 72px)",
        "lineHeight": 0.9,
        "trackingEm": -0.03
      },
      "panel": {
        "size": "18px",
        "lineHeight": 1.1,
        "trackingEm": 0.02
      },
      "body": {
        "size": "14px",
        "lineHeight": 1.55,
        "trackingEm": 0
      },
      "label": {
        "size": "11px",
        "lineHeight": 1.2,
        "trackingEm": 0.14
      },
      "data": {
        "size": "10px",
        "lineHeight": 1.35,
        "trackingEm": 0.08
      },
      "micro": {
        "size": "8px",
        "lineHeight": 1.35,
        "trackingEm": 0.1
      }
    },
    "mobile": {
      "hero": {
        "size": "clamp(42px, 14vw, 72px)",
        "lineHeight": 0.86,
        "trackingEm": -0.04
      },
      "section": {
        "size": "clamp(26px, 9vw, 42px)",
        "lineHeight": 0.92,
        "trackingEm": -0.025
      },
      "panel": {
        "size": "15px",
        "lineHeight": 1.15,
        "trackingEm": 0.02
      },
      "body": {
        "size": "12px",
        "lineHeight": 1.5,
        "trackingEm": 0
      },
      "label": {
        "size": "9px",
        "lineHeight": 1.2,
        "trackingEm": 0.13
      },
      "data": {
        "size": "9px",
        "lineHeight": 1.3,
        "trackingEm": 0.07
      },
      "micro": {
        "size": "7px",
        "lineHeight": 1.3,
        "trackingEm": 0.09
      }
    },
    "rules": {
      "maxFamiliesPerScene": 3,
      "maxParagraphCharacters": 240,
      "maxHeadlineWords": 7,
      "headlineDefaultCase": "uppercase",
      "monoReservedFor": [
        "ids",
        "coordinates",
        "frequencies",
        "timestamps",
        "sensor_data",
        "system_labels"
      ]
    }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "grid": {
    "desktop": {
      "columns": 12,
      "margin": "clamp(32px, 4vw, 72px)",
      "gutter": "clamp(12px, 1.4vw, 24px)",
      "baseline": "8px"
    },
    "tablet": {
      "columns": 8,
      "margin": "24px",
      "gutter": "16px",
      "baseline": "8px"
    },
    "mobile": {
      "columns": 4,
      "margin": "16px",
      "gutter": "10px",
      "baseline": "8px"
    },
    "ratios": {
      "equal": "1:1",
      "editorial": "3:2",
      "machineData": "5:3",
      "heroSupport": "8:5",
      "dominantDomain": "2:1",
      "railField": "3:1"
    }
  },
  "border": {
    "width": {
      "hairline": "1px",
      "signal": "2px",
      "active": "3px"
    },
    "radius": {
      "none": "0px",
      "micro": "2px",
      "small": "6px",
      "medium": "12px",
      "large": "22px",
      "pill": "999px"
    }
  },
  "shadow": {
    "none": "none",
    "panel": "0 18px 50px rgba(0,0,0,.34)",
    "signalCyan": "0 0 24px rgba(16,233,255,.24)",
    "signalRed": "0 0 24px rgba(255,23,68,.22)",
    "signalAcid": "0 0 24px rgba(185,255,59,.20)"
  },
  "texture": {
    "grainIdle": 0.08,
    "grainActive": 0.16,
    "scanlineIdle": 0.06,
    "scanlineActive": 0.14,
    "halftoneIdle": 0.05,
    "halftoneActive": 0.18,
    "chromaticIdle": 0.0,
    "chromaticActive": 0.08,
    "glitchEventMin": 0.32,
    "glitchEventMax": 0.58
  },
  "motion": {
    "duration": {
      "instant": "120ms",
      "fast": "240ms",
      "medium": "520ms",
      "slow": "1200ms",
      "scene": "1800ms",
      "ambientShort": "6s",
      "ambient": "14s",
      "ambientLong": "24s",
      "orbit": "32s"
    },
    "easing": {
      "linear": "linear",
      "standard": "cubic-bezier(.2,.8,.2,1)",
      "enter": "cubic-bezier(.16,1,.3,1)",
      "exit": "cubic-bezier(.7,0,.84,0)",
      "signal": "cubic-bezier(.4,0,.2,1)",
      "glitch": "steps(2,end)"
    },
    "distribution": {
      "slowPct": 70,
      "mediumPct": 20,
      "fastPct": 10
    },
    "presets": {
      "breathSlow": {
        "duration": "14s",
        "amplitude": 0.025,
        "properties": [
          "scale",
          "luminance"
        ],
        "priority": "low"
      },
      "orbitalDrift": {
        "duration": "32s",
        "amplitude": 0.22,
        "properties": [
          "rotation",
          "phase"
        ],
        "priority": "low"
      },
      "scanSoft": {
        "duration": "5.2s",
        "amplitude": 0.12,
        "properties": [
          "mask_position",
          "luminance"
        ],
        "priority": "medium"
      },
      "gridWarpLow": {
        "duration": "10s",
        "amplitude": 0.06,
        "properties": [
          "displacement"
        ],
        "priority": "low"
      },
      "dataTick": {
        "duration": "1.4s",
        "amplitude": 0.04,
        "properties": [
          "value",
          "opacity"
        ],
        "priority": "medium"
      },
      "nodePing": {
        "duration": "860ms",
        "amplitude": 0.18,
        "properties": [
          "scale",
          "ring"
        ],
        "priority": "medium"
      },
      "glitchMicro": {
        "duration": "160ms",
        "amplitude": 0.44,
        "properties": [
          "slice",
          "rgb_split"
        ],
        "priority": "high"
      },
      "authFlash": {
        "duration": "420ms",
        "amplitude": 0.3,
        "properties": [
          "opacity",
          "border"
        ],
        "priority": "high"
      },
      "stateOpen": {
        "duration": "1800ms",
        "amplitude": 1,
        "properties": [
          "scene_progress"
        ],
        "priority": "critical"
      }
    },
    "reducedMotion": {
      "ambient": "freeze_at_readable_phase",
      "reactive": "disable_pointer_translation",
      "scene": "crossfade_240ms",
      "glitch": "single_border_flash",
      "audio": "luminance_only"
    }
  },
  "zIndex": {
    "background": 0,
    "artwork": 10,
    "geometry": 20,
    "overlay": 30,
    "content": 40,
    "navigation": 50,
    "modal": 100
  },
  "performance": {
    "desktopTargetFps": 60,
    "mobileTargetFpsMin": 45,
    "maxDprDesktop": 1.75,
    "maxDprMobile": 1.25,
    "maxActiveCanvases": 1,
    "maxConcurrentPostEffects": 3,
    "maxTextureSizeMobile": 2048,
    "maxTextureSizeDesktop": 4096
  }
}