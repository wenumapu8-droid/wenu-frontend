---
import "./kodex-observe.css";

interface Props {
  sceneIndex?: number;
  sceneTotal?: number;
  signalLabel?: string;
}

const {
  sceneIndex = 1,
  sceneTotal = 7,
  signalLabel = "SIGNAL · LATENT",
} = Astro.props;
---

<section class="kdx-observe" data-kdx-observe data-state="dormant">
  <canvas class="kdx-observe__canvas" data-kdx-canvas aria-hidden="true"></canvas>

  <div class="kdx-observe__ui">
    <header class="kdx-observe__header">
      <h1 class="kdx-logo">KODEX−∞</h1>
      <div class="kdx-header-meta">
        <span class="kdx-chip">◉ {signalLabel}</span>
        <button class="kdx-index" type="button" data-kodex-index>INDEX</button>
      </div>
    </header>

    <div class="kdx-observe__content">
      <p class="kdx-kicker">01 · PROLOGUE / OBSERVATION PROTOCOL</p>
      <h2 class="kdx-title">THE ARCHIVE<br />OBSERVES.</h2>
      <p class="kdx-copy">
        This is not a gallery. Every signal is a work. Read it. Generate from it. Carry it.
      </p>

      <div class="kdx-actions">
        <button class="kdx-primary" type="button" data-kdx-primary>
          BEGIN OBSERVATION →
        </button>
        <button class="kdx-secondary" type="button" data-kdx-protocol>
          READ THE PROTOCOL
        </button>
      </div>

      <div class="kdx-data-row">
        <span class="kdx-micro-chip">NODE <b>ND-01</b></span>
        <span class="kdx-micro-chip">PROTOCOL <b>PR-01</b></span>
        <span class="kdx-micro-chip">STATUS <b>OBSERVING</b></span>
      </div>
    </div>

    <footer class="kdx-observe__footer">
      <div class="kdx-barcode" aria-hidden="true"></div>
      <nav class="kdx-progress" aria-label="KODEX scene progress">
        <span>{String(sceneIndex).padStart(2, "0")} / {String(sceneTotal).padStart(2, "0")}</span>
        <span class="kdx-progress__nodes" aria-hidden="true">
          {Array.from({ length: sceneTotal }, (_, index) => (
            <i class:list={["kdx-progress__node", { "is-active": index === sceneIndex }]}></i>
          ))}
        </span>
        <button type="button" data-kodex-next>NEXT →</button>
      </nav>
      <span class="kdx-footer-status">KDX://OBSERVE/001 · CHECKSUM 8F21-A90C</span>
    </footer>
  </div>

  <aside class="kdx-observe__message" data-kdx-message>
    OBSERVER LOOP ACTIVE · RELATIONAL FIELD LOCKED
  </aside>

  <aside class="kdx-observe__rail" aria-hidden="true">
    <span class="kdx-rail-item">SOURCE · UNKNOWN</span>
    <span class="kdx-rail-item">MODE · AWARE</span>
    <span class="kdx-rail-item">MEMORY · ACTIVE</span>
  </aside>

  <output class="kdx-debug" data-kdx-debug></output>
</section>

<script>
  import { mountKodexObserveScenes } from "./kodex-observe-client";
  mountKodexObserveScenes();
</script>
