<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Wenu Mapu — Portal</title>
<link href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
* { margin:0; padding:0; box-sizing:border-box; }

:root {
  --gold: #d4a843;
  --gold2: #f0c060;
  --ember: #c4501a;
  --cream: #f5ead8;
  --portal-x-offset: 0px;
  --portal-y-offset: 0px;
  --mandala-x-offset: 0px;
  --mandala-y-offset: 0px;
}

html, body { height:100%; overflow:hidden; }
body {
  background: #060402;
  font-family: 'Share Tech Mono', monospace;
  cursor: none;
  user-select: none;
  color: var(--cream);
}

/* ─── COSMIC STARMAP BACKGROUND (anchors the whole scene) ─── */
#starmap-bg {
  position: fixed; inset:0; z-index:0;
  background-image: url('wenu-assets/wenu-bg-starmap.webp');
  background-size: cover;
  background-position: center;
  /* Very slow drift to feel alive */
  animation: starmap-drift 80s ease-in-out infinite alternate;
  filter: brightness(0.55) saturate(0.85);
}
@keyframes starmap-drift {
  from { background-position: 48% 50%; transform: scale(1); }
  to   { background-position: 52% 50%; transform: scale(1.04); }
}
/* ─── COSMOS LAYERS (procedural live stars over bg) ─── */
canvas#cosmos {
  position: fixed; inset:0; z-index:1;
  pointer-events:none;
  opacity: 0.55;
  mix-blend-mode: screen;
}
canvas#dust { position: fixed; inset:0; z-index:1; pointer-events:none; opacity: 0.55; mix-blend-mode: screen; }

/* ─── ORBITAL GUIDE RINGS (cinematic UI accent) ─── */
.guide-ring {
  position: fixed;
  top: 50%; left: 50%;
  border-radius: 50%;
  border: 1px dashed rgba(212,168,67,0.18);
  pointer-events: none;
  z-index: 5;
  transform: translate(-50%, -50%);
}
.guide-ring.outer {
  width: 88vmin; height: 88vmin;
  animation: ring-rotate 90s linear infinite;
}
.guide-ring.inner {
  width: 64vmin; height: 64vmin;
  border-style: solid;
  border-color: rgba(212,168,67,0.12);
  animation: ring-rotate 60s linear infinite reverse;
}
@keyframes ring-rotate { from { transform: translate(-50%,-50%) rotate(0deg); } to { transform: translate(-50%,-50%) rotate(360deg); } }

/* Tick marks at cardinal points on outer ring */
.guide-tick {
  position: fixed;
  width: 14px; height: 1px;
  background: rgba(212,168,67,0.32);
  top: 50%; left: 50%;
  z-index: 5;
  pointer-events: none;
  transform-origin: 50% 50%;
}

/* ─── PORTAL STAGE (one circular lens, shared center, all frames inside) ─── */
.portal-stage {
  position: fixed;
  top: 50%;
  left: 50%;
  width: min(80vmin, 1100px);
  height: min(80vmin, 1100px);
  transform: translate(calc(-50% + var(--portal-x-offset)), calc(-50% + var(--portal-y-offset)));
  z-index: 2;
  border-radius: 50%;
  overflow: hidden;
  pointer-events: none;
  /* Soft halo around the lens */
  box-shadow: 0 0 90px 10px rgba(212,168,67,0.18), inset 0 0 60px rgba(6,4,2,0.6);
}
/* Soft circular edge */
.portal-stage::after {
  content:''; position:absolute; inset:0;
  background: radial-gradient(circle at center, transparent 55%, rgba(6,4,2,0.55) 88%, rgba(6,4,2,1) 100%);
  pointer-events:none;
  z-index: 10;
}

.portal-frame {
  position: absolute;
  inset: 0;
  opacity: 0;
  transform: scale(1.04);
  filter: blur(14px) saturate(0.7) brightness(0.65);
  transition:
    opacity 1.2s cubic-bezier(.4,0,.2,1),
    transform 1.6s cubic-bezier(.25,.8,.35,1),
    filter 1.2s cubic-bezier(.4,0,.2,1);
  overflow: hidden;
  border-radius: 50%;
  will-change: opacity, transform, filter;
}
.portal-frame.active {
  opacity: 1;
  transform: scale(1);
  filter: blur(0) saturate(1.05) brightness(0.88);
}
.portal-frame video,
.portal-frame img {
  position: absolute;
  top: 50%; left: 50%;
  width: 100%; height: 100%;
  transform: translate(-50%, -50%);
  object-fit: cover;
  object-position: center center;
}

/* ─── VIGNETTE on top of portal ─── */
#vignette {
  position: fixed; inset:0; z-index:4;
  pointer-events:none;
  background: radial-gradient(ellipse at center, transparent 35%, rgba(6,4,2,0.55) 80%, rgba(6,4,2,0.95) 100%);
}

/* ─── CONSTELLATION STAR NODES (always visible, clickable) ─── */
.star {
  position: fixed;
  z-index: 7;
  pointer-events: all;
  cursor: none;
  transform: translate(-50%, -50%);
  display: flex; flex-direction: column;
  align-items: center; gap: 10px;
  /* Reset button defaults so only the SVG star shows */
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  outline: none;
  -webkit-appearance: none;
          appearance: none;
  font: inherit;
  color: inherit;
  transition: transform 0.5s cubic-bezier(.3,.8,.4,1.2), filter 0.4s;
}
.star::-moz-focus-inner { border: 0; padding: 0; }
.star:hover, .star.lit {
  filter: drop-shadow(0 0 22px rgba(240,192,96,0.85));
  transform: translate(-50%, -50%) scale(1.35);
}
.star .core {
  width: 32px; height: 32px;
  position: relative;
  display: flex; align-items:center; justify-content:center;
  filter: drop-shadow(0 0 8px rgba(240,192,96,0.6));
  animation: star-spin 26s linear infinite, star-breathe 3.5s ease-in-out infinite;
  transition: filter 0.4s;
}
.star.lit .core {
  animation: star-spin 10s linear infinite, star-breathe 1.8s ease-in-out infinite;
  filter: drop-shadow(0 0 16px rgba(255,220,140,1)) drop-shadow(0 0 32px rgba(240,192,96,0.6));
}
.star .core svg {
  width: 100%; height: 100%;
  overflow: visible;
}
.star .core svg .ray { fill: rgba(240,192,96,0.85); transition: fill 0.4s; }
.star .core svg .dot { fill: rgba(255,235,180,1); }
.star.lit .core svg .ray { fill: rgba(255,235,180,1); }

/* Wüñelfe — blue 8-point Mapuche star */
#star-wunelfe .core svg .ray { fill: rgba(150,190,250,0.85); }
#star-wunelfe .core svg .dot { fill: rgba(220,235,255,1); }
#star-wunelfe .core { filter: drop-shadow(0 0 10px rgba(140,180,240,0.75)); }
#star-wunelfe.lit .core { filter: drop-shadow(0 0 20px rgba(180,210,255,1)) drop-shadow(0 0 40px rgba(120,160,230,0.7)); }
#star-wunelfe.lit .core svg .ray { fill: rgba(220,235,255,1); }

/* Treng Treng — copper serpent ring with rotating dots */
#star-treng .core svg .ray { fill: rgba(220,120,50,0.85); }
#star-treng .core svg .dot { fill: rgba(255,200,140,1); }
#star-treng .core { filter: drop-shadow(0 0 10px rgba(196,80,26,0.75)); }
#star-treng.lit .core { filter: drop-shadow(0 0 18px rgba(255,150,80,1)) drop-shadow(0 0 36px rgba(196,80,26,0.7)); }
#star-treng.lit .core svg .ray { fill: rgba(255,200,140,1); }

@keyframes star-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}
@keyframes star-breathe {
  0%,100% { opacity: 0.85; }
  50%     { opacity: 1; }
}
.star .name {
  font-family: 'Share Tech Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.32em;
  color: rgba(240,192,96,0.95);
  text-transform: uppercase;
  white-space: nowrap;
  /* No box — pure text with deep shadow for legibility */
  background: none;
  padding: 0;
  text-shadow: 0 1px 4px rgba(0,0,0,0.95), 0 0 8px rgba(0,0,0,0.8);
  transition: opacity 0.5s, color 0.4s, text-shadow 0.4s;
  opacity: 0;
}
.star:hover .name, .star.lit .name {
  opacity: 1;
  color: rgba(255,235,180,1);
  text-shadow: 0 1px 4px rgba(0,0,0,0.95), 0 0 12px rgba(240,192,96,0.6);
}
.star.lit .name {
  color: rgba(255,235,180,1);
  text-shadow: 0 0 18px rgba(240,192,96,0.85);
}
@keyframes star-pulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(240,192,96,0); }
  50%     { box-shadow: 0 0 0 8px rgba(240,192,96,0.12); }
}
@keyframes star-flicker {
  0%,100% { opacity: 0.95; }
  50%     { opacity: 1; }
}

/* All 10 stars on geometric circles around viewport center.
   8 cardinals on outer ring (~44% from center).
   Wüñelfe + Treng Treng on inner orbital ring (~32% from center). */
#star-n  { top:  6%;  left: 50%; }
#star-s  { top: 94%;  left: 50%; }
#star-e  { top: 50%;  left: 94%; }
#star-w  { top: 50%;  left:  6%; }
#star-ne { top: 19%;  left: 81%; }
#star-se { top: 81%;  left: 81%; }
#star-sw { top: 81%;  left: 19%; }
#star-nw { top: 19%;  left: 19%; }
#star-wunelfe { top: 24%;  left: 72%; }
#star-treng   { top: 76%;  left: 28%; }

/* ─── GLYPH STREAM ─── */
#glyphs { position: fixed; inset:0; z-index:4; overflow: hidden; pointer-events: none; }
.glyph { position: absolute; font-family: 'Share Tech Mono', monospace; font-size: 10px;
  color: rgba(212,168,67,0.13); animation: glyph-fall linear forwards; }
@keyframes glyph-fall {
  from { opacity: 0; transform: translateY(-20px); }
  10% { opacity: 1; } 90% { opacity: 0.3; }
  to { opacity: 0; transform: translateY(100vh); }
}

/* ─── MANDALA (the gateway) ─── */
#mandala-wrap {
  width: min(38vmin, 320px);
  height: min(38vmin, 320px);
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(calc(-50% + var(--mandala-x-offset)), calc(-50% + var(--mandala-y-offset)));
  z-index: 6;
  transition: filter 0.4s;
  filter: drop-shadow(0 0 30px rgba(212,168,67,0.45));
  pointer-events: all;
  cursor: none;
}
#mandala-halo {
  position: absolute; inset: -10%;
  background: radial-gradient(circle, rgba(240,192,96,0.22) 0%, rgba(212,168,67,0.09) 40%, transparent 70%);
  animation: halo-breathe 6s ease-in-out infinite;
  z-index:-1;
  pointer-events:none;
}
@keyframes halo-breathe {
  0%,100% { transform: scale(1); opacity: 0.7; }
  50% { transform: scale(1.1); opacity: 1; }
}
#mandala { display: none; }
#mandala-wrap {
  width: min(20vmin, 180px);
  height: min(20vmin, 180px);
}
#mandala-halo {
  position: absolute; inset: 0;
  background: radial-gradient(circle, rgba(240,192,96,0.12) 0%, transparent 65%);
  z-index: 0;
  pointer-events: none;
  animation: halo-breathe 5s ease-in-out infinite;
}
#mandala-wrap.zoom {
  animation: enter-zoom 2.2s cubic-bezier(.5,.02,.4,1) forwards;
  pointer-events: none;
}
@keyframes enter-zoom {
  0% { transform: translate(calc(-50% + var(--mandala-x-offset)), calc(-50% + var(--mandala-y-offset))) scale(1); }
  60% { transform: translate(calc(-50% + var(--mandala-x-offset)), calc(-50% + var(--mandala-y-offset))) scale(4) rotate(540deg); opacity: 0.9; }
  100% { transform: translate(calc(-50% + var(--mandala-x-offset)), calc(-50% + var(--mandala-y-offset))) scale(14) rotate(720deg); opacity: 0; }
}

/* ─── CHOICE MENU (appears on mandala click) ─── */
#choice-menu {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 8;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.7s ease;
  width: min(90vw, 700px);
}
#choice-menu.open {
  opacity: 1;
  pointer-events: all;
}
.choice {
  position: absolute;
  font-family: 'IM Fell English', serif;
  font-style: italic;
  text-align: center;
  cursor: none;
  pointer-events: all;
  transition: all 0.4s ease;
  color: rgba(212,168,67,0.85);
  letter-spacing: 0.15em;
  /* Reset button defaults */
  background: none;
  border: none;
  padding: 0; margin: 0;
  outline: none;
  -webkit-appearance: none;
          appearance: none;
  font-size: inherit;
}
.choice::-moz-focus-inner { border: 0; padding: 0; }
.choice .ring {
  width: 60px; height: 60px;
  border: 1px solid rgba(212,168,67,0.5);
  border-radius: 50%;
  margin: 0 auto 12px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Share Tech Mono', monospace;
  font-size: 18px;
  color: var(--gold);
  background: radial-gradient(circle, rgba(240,192,96,0.15), transparent 70%);
  transition: all 0.4s ease;
}
.choice .ring::before {
  content:''; position:absolute; inset:-6px;
  border: 1px dashed rgba(212,168,67,0.25);
  border-radius:50%;
  animation: spin-slow 14s linear infinite;
}
.choice:hover .ring {
  background: radial-gradient(circle, rgba(240,192,96,0.55), rgba(240,192,96,0.1) 70%);
  border-color: var(--gold2);
  box-shadow: 0 0 28px rgba(240,192,96,0.6);
  transform: scale(1.1);
}
.choice .title {
  font-size: clamp(15px, 1.7vw, 19px);
  color: rgba(232,210,170,0.95);
  margin-bottom: 6px;
  text-shadow: 0 2px 8px rgba(0,0,0,0.7);
}
.choice .subtitle {
  font-family: 'Share Tech Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.4em;
  color: rgba(212,168,67,0.78);
  text-transform: uppercase;
  text-shadow: 0 1px 4px rgba(0,0,0,0.65);
}
#choice-enter   { top: -200px; left: 50%; transform: translateX(-50%); }
#choice-wunelfe { top: 60px;   left: -90px; }
#choice-treng   { top: 60px;   right: -90px; }

/* Backdrop dim when menu open */
#choice-backdrop {
  position: fixed; inset:0;
  background: rgba(6,4,2,0.5);
  z-index: 7;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.6s ease;
}
#choice-backdrop.open { opacity: 1; pointer-events: all; }

/* ─── CURSOR ─── */
#cur {
  position: fixed; z-index:999; pointer-events:none;
  width:4px; height:4px;
  background: var(--gold2);
  border-radius:50%;
  transform: translate(-50%,-50%);
  transition: width 0.25s, height 0.25s;
  box-shadow: 0 0 14px 3px rgba(240,192,96,0.9);
}
#cur.active { width:42px; height:42px; opacity:0.22; }

/* ─── CORNERS / METADATA ─── */
.corner {
  position: fixed;
  font-size: 9px;
  letter-spacing: 0.4em;
  color: rgba(240,192,96,0.85);
  text-transform: uppercase;
  padding: 5px 10px;
  background: rgba(6,4,2,0.55);
  border-radius: 2px;
  z-index:10;
}
.corner.tl { top:28px; left:32px; }
.corner.tr { top:28px; right:32px; text-align:right; }
.corner.bl { bottom:28px; left:32px; }
.corner.br { bottom:28px; right:32px; text-align:right; }

/* Status */
#status {
  position: fixed;
  top: 26px; left:50%; transform:translateX(-50%);
  font-size:10px; letter-spacing:0.42em;
  color: rgba(240,192,96,0.85);
  padding: 6px 14px;
  background: rgba(6,4,2,0.6);
  border-radius: 2px;
  z-index:20;
  text-transform:uppercase;
  transition: color 0.5s, background 0.5s;
  font-family: 'Share Tech Mono', monospace;
}
#status.active { color: rgba(255,235,180,1); background: rgba(6,4,2,0.75); }

/* Zone label (appears when hovering a star) */
#zone-label {
  position: fixed;
  bottom: 56px; left:50%; transform:translateX(-50%);
  font-family: 'IM Fell English', serif;
  font-style: italic;
  font-size: clamp(15px, 1.6vw, 18px);
  color: rgba(245,234,216,0.95);
  z-index: 20;
  opacity: 0;
  transition: opacity 0.7s ease;
  pointer-events: none;
  text-align: center;
  width: auto;
  max-width: min(560px, 84vw);
  line-height: 1.5;
  padding: 16px 28px;
  background: rgba(6,4,2,0.72);
  border-radius: 4px;
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
}
#zone-label.visible { opacity: 1; }
#zone-label .name {
  font-size: clamp(11px, 1.2vw, 13px);
  display: block;
  margin-bottom: 8px;
  font-family: 'Share Tech Mono', monospace;
  font-style: normal;
  letter-spacing: 0.5em;
  color: rgba(240,192,96,1);
  text-transform: uppercase;
}
#zone-label .line { width:70px; height:1px; margin: 14px auto 0;
  background: linear-gradient(to right, transparent, var(--gold), transparent); }

/* ─── LOADING ─── */
#loading {
  position: fixed; inset:0; z-index:100;
  background: #060402;
  display:flex; flex-direction:column;
  align-items:center; justify-content:center;
  gap: 36px;
  animation: loader-autofade 1.5s ease 1.5s forwards;
}
@keyframes loader-autofade {
  to { opacity: 0; visibility: hidden; pointer-events: none; }
}
#loader-mandala {
  width: 140px; height: 140px;
  animation: spin-slow 12s linear infinite;
  filter: drop-shadow(0 0 24px rgba(240,192,96,0.55));
  opacity: 0.9;
}
#loading p {
  font-family: 'Share Tech Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.5em;
  color: rgba(212,168,67,0.7);
  text-transform: uppercase;
  animation: blink 1.8s ease infinite;
}
@keyframes spin-slow { from { transform:rotate(0deg); } to { transform:rotate(360deg); } }
@keyframes blink { 0%,100%{opacity:0.5} 50%{opacity:1} }

/* ─── DEEP PORTAL (full-screen experience on star click) ─── */
#deep-portal {
  position: fixed;
  inset: 0;
  z-index: 80;
  opacity: 0;
  pointer-events: none;
  transition: opacity 1.2s cubic-bezier(.4,0,.2,1);
}
#deep-portal.open { opacity: 1; pointer-events: all; }
#deep-bg {
  position: absolute; inset: 0;
  background-size: cover;
  background-position: center center;
  filter: brightness(0.55) saturate(1.05);
  transform: scale(1.08);
  transition: transform 8s ease-out;
}
#deep-portal.open #deep-bg { transform: scale(1.0); }
#deep-vignette {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse at 30% 70%, transparent 0%, rgba(6,4,2,0.55) 50%, rgba(6,4,2,0.9) 100%),
    linear-gradient(to top, rgba(6,4,2,0.85) 0%, transparent 60%);
  pointer-events: none;
}
#deep-content {
  position: absolute;
  left: clamp(28px, 6vw, 90px);
  bottom: clamp(60px, 10vh, 120px);
  max-width: min(620px, 80vw);
  z-index: 2;
  color: var(--cream);
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 1.4s ease 0.5s, transform 1.4s cubic-bezier(.25,.8,.4,1) 0.5s;
}
#deep-portal.open #deep-content { opacity: 1; transform: translateY(0); }
.deep-aspect {
  font-family: 'Share Tech Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.5em;
  color: rgba(240,192,96,0.95);
  text-transform: uppercase;
  margin-bottom: 18px;
}
.deep-name {
  font-family: 'IM Fell English', serif;
  font-style: italic;
  font-size: clamp(40px, 6.5vw, 78px);
  color: rgba(255,235,180,1);
  line-height: 1;
  margin-bottom: 10px;
  letter-spacing: -0.01em;
  text-shadow: 0 4px 32px rgba(0,0,0,0.85);
}
.deep-english {
  font-family: 'Share Tech Mono', monospace;
  font-size: 12px;
  letter-spacing: 0.45em;
  color: rgba(212,168,67,0.95);
  text-transform: uppercase;
  margin-bottom: 30px;
}
.deep-poem {
  font-family: 'IM Fell English', serif;
  font-style: italic;
  font-size: clamp(17px, 1.8vw, 22px);
  color: rgba(232,210,170,1);
  margin-bottom: 24px;
  line-height: 1.45;
  text-shadow: 0 2px 14px rgba(0,0,0,0.85);
}
.deep-body {
  font-family: 'Source Serif Pro', 'IM Fell English', serif;
  font-size: clamp(13px, 1.1vw, 15px);
  color: rgba(245,234,216,0.92);
  line-height: 1.75;
  text-shadow: 0 1px 8px rgba(0,0,0,0.85);
}
.deep-body p { margin-bottom: 12px; }

#deep-return {
  position: absolute;
  top: clamp(28px, 3.5vw, 50px);
  left: clamp(28px, 3.5vw, 50px);
  z-index: 3;
  font-family: 'Share Tech Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.45em;
  color: rgba(240,192,96,0.85);
  text-transform: uppercase;
  cursor: none;
  background: none; border: none; padding: 6px 0;
  display: flex; align-items: center; gap: 14px;
  outline: none;
  transition: color 0.3s;
}
#deep-return:hover { color: rgba(255,235,180,1); }
#deep-return::before {
  content:'';
  width: 38px; height: 1px;
  background: currentColor;
  transition: width 0.3s;
}
#deep-return:hover::before { width: 56px; }

#deep-mandala {
  position: absolute;
  right: clamp(30px, 5vw, 70px);
  bottom: clamp(40px, 6vh, 80px);
  width: clamp(90px, 11vw, 140px);
  height: clamp(90px, 11vw, 140px);
  opacity: 0.42;
  animation: spin-slow 60s linear infinite;
  filter: drop-shadow(0 0 18px rgba(240,192,96,0.4));
  pointer-events: none;
  z-index: 2;
}

/* Enter fade (after zoom) */
#enter-fade {
  position: fixed; inset:0; z-index:200;
  background: var(--cream);
  opacity: 0; pointer-events: none;
  transition: opacity 1.5s ease;
}
#enter-fade.show { opacity: 1; pointer-events: all; }

/* Scan line */
body::after {
  content:''; position:fixed; inset:0;
  background: repeating-linear-gradient(to bottom,
    transparent 0px, transparent 2px,
    rgba(0,0,0,0.04) 2px, rgba(0,0,0,0.04) 4px);
  z-index:500; pointer-events:none;
}

/* ─── FILM GRAIN (SVG noise overlay) ─── */
#grain {
  position: fixed; inset:0; z-index:501;
  pointer-events:none;
  opacity: 0.18;
  mix-blend-mode: overlay;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.92' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.85 0 0 0 0 0.7 0 0 0 0 0.3 0 0 0 1 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  background-size: 200px 200px;
  animation: grain-shift 0.6s steps(4) infinite;
}
@keyframes grain-shift {
  0%   { transform: translate(0,0); }
  25%  { transform: translate(-3px,2px); }
  50%  { transform: translate(2px,-3px); }
  75%  { transform: translate(-2px,-2px); }
  100% { transform: translate(3px,3px); }
}

/* ─── PSYCHEDELIC HUE BREATHING (on cosmos layer) ─── */
canvas#cosmos { animation: hue-cycle 45s ease-in-out infinite; }
@keyframes hue-cycle {
  0%,100% { filter: hue-rotate(0deg)   brightness(1); }
  33%     { filter: hue-rotate(-18deg) brightness(1.12); }
  66%     { filter: hue-rotate(22deg)  brightness(0.92); }
}

/* ─── LIGHT LEAKS (random gold streaks) ─── */
#leaks {
  position: fixed; inset:0; z-index:5;
  pointer-events:none;
  mix-blend-mode: screen;
}
.leak {
  position: absolute;
  width: 300px; height: 600px;
  background: radial-gradient(ellipse 50% 70% at center, rgba(240,192,96,0.35), transparent 70%);
  filter: blur(40px);
  opacity: 0;
  animation: leak-pulse 14s ease-in-out infinite;
}
.leak.l1 { top: 5%;  left: -8%; transform: rotate(-22deg); animation-delay: 0s; }
.leak.l2 { top: 45%; right: -10%; transform: rotate(28deg); animation-delay: 6s;
  background: radial-gradient(ellipse 50% 70% at center, rgba(196,80,26,0.28), transparent 70%); }
.leak.l3 { bottom: 0%; left: 30%; transform: rotate(-8deg); animation-delay: 11s;
  background: radial-gradient(ellipse 50% 70% at center, rgba(240,212,160,0.25), transparent 70%); }
@keyframes leak-pulse {
  0%,90%,100% { opacity: 0; }
  10%,50% { opacity: 0.7; }
  30% { opacity: 1; }
}

/* ─── GLITCH FLASH on zone change ─── */
#glitch {
  position: fixed; inset:0; z-index:498;
  pointer-events:none;
  opacity: 0;
}
#glitch.flash {
  animation: glitch-burst 0.45s steps(3) forwards;
}
@keyframes glitch-burst {
  0%   { opacity: 1; background:
    linear-gradient(180deg, transparent 0%, rgba(196,80,26,0.18) 5%, transparent 8%, transparent 22%, rgba(140,180,240,0.18) 26%, transparent 30%, transparent 60%, rgba(240,192,96,0.22) 64%, transparent 70%);
    transform: translateX(-4px); }
  33%  { opacity: 0.9; background:
    linear-gradient(180deg, transparent 12%, rgba(196,80,26,0.15) 14%, transparent 18%, transparent 40%, rgba(140,180,240,0.2) 44%, transparent 48%);
    transform: translateX(6px); }
  66%  { opacity: 0.5; background:
    linear-gradient(180deg, transparent 50%, rgba(140,180,240,0.18) 53%, transparent 58%);
    transform: translateX(-2px); }
  100% { opacity: 0; transform: translateX(0); }
}

/* Subtle chroma pulse on activation — no position shift */
.portal-frame.active::before {
  content:''; position:absolute; inset:0;
  background: radial-gradient(circle at center, rgba(196,80,26,0.15), transparent 40%, rgba(140,180,240,0.12) 80%, transparent);
  mix-blend-mode: screen;
  pointer-events: none;
  animation: chroma-pulse 1.6s ease-out forwards;
  z-index: 5;
}
@keyframes chroma-pulse {
  0%   { opacity: 1; transform: scale(0.7); }
  100% { opacity: 0; transform: scale(1.3); }
}

/* ─── CURSOR TRAIL (gold dust following the cursor) ─── */
.trail {
  position: fixed;
  width: 6px; height: 6px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,235,180,0.85), rgba(240,192,96,0.3) 60%, transparent 100%);
  pointer-events: none;
  z-index: 998;
  transform: translate(-50%, -50%);
  animation: trail-fade 0.9s ease-out forwards;
}
@keyframes trail-fade {
  from { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  to   { opacity: 0; transform: translate(-50%, -50%) scale(0.25); }
}
</style>
</head>
<body>

<!-- LOADING (pure CSS auto-fade) -->
<div id="loading">
  <img id="loader-mandala" src="wenu-mandala.png" alt="Wenu Mapu">
  <p>Opening Wenu Mapu</p>
</div>

<!-- STARMAP BACKGROUND (anchors the scene) -->
<div id="starmap-bg"></div>

<!-- COSMOS (live stars on top, blend mode) -->
<canvas id="cosmos"></canvas>

<!-- PORTAL STAGE — circular lens, shared center, all frames inside -->
<div class="portal-stage">
  <div class="portal-frame active" id="frame-default">
    <video autoplay muted loop playsinline preload="metadata">
      <source src="wenu-assets/wenu-center-portal-default.webm" type="video/webm">
      <source src="wenu-assets/wenu-center-portal-default.mp4" type="video/mp4">
    </video>
  </div>
  <div class="portal-frame" id="frame-n-img"><img src="wenu-assets/wenu-n-antu.webp" alt=""></div>
  <div class="portal-frame" id="frame-s-img"><img src="wenu-assets/wenu-s-kuyen.webp" alt=""></div>
  <div class="portal-frame" id="frame-s-vid">
    <video muted loop playsinline preload="none">
      <source src="wenu-assets/wenu-s-kuyen.webm" type="video/webm">
      <source src="wenu-assets/wenu-s-kuyen.mp4" type="video/mp4">
    </video>
  </div>
  <div class="portal-frame" id="frame-e-img"><img src="wenu-assets/wenu-e-azmapu.webp" alt=""></div>
  <div class="portal-frame" id="frame-w-img"><img src="wenu-assets/wenu-w-lafken.webp" alt=""></div>
  <div class="portal-frame" id="frame-ne-img"><img src="wenu-assets/wenu-ne-dawn.webp" alt=""></div>
  <div class="portal-frame" id="frame-se-img"><img src="wenu-assets/wenu-se-tierra.webp" alt=""></div>
  <div class="portal-frame" id="frame-sw-img"><img src="wenu-assets/wenu-sw-nebula.webp" alt=""></div>
  <div class="portal-frame" id="frame-nw-img"><img src="wenu-assets/wenu-nw-void.webp" alt=""></div>
  <div class="portal-frame" id="frame-wunelfe">
    <video muted loop playsinline preload="none">
      <source src="wenu-assets/wenu-ne-wunelfe.webm" type="video/webm">
      <source src="wenu-assets/wenu-ne-wunelfe.mp4" type="video/mp4">
    </video>
  </div>
  <div class="portal-frame" id="frame-treng"><img src="wenu-assets/wenu-w-lafken.webp" alt=""></div>
</div>

<!-- ORBITAL GUIDE RINGS (cinematic accent) -->
<div class="guide-ring outer"></div>
<div class="guide-ring inner"></div>

<!-- LIGHT LEAKS (gold streaks bleeding in) -->
<div id="leaks">
  <div class="leak l1"></div>
  <div class="leak l2"></div>
  <div class="leak l3"></div>
</div>

<!-- DUST -->
<canvas id="dust"></canvas>

<!-- GLYPHS -->
<div id="glyphs"></div>

<!-- CONSTELLATION STARS (always visible, clickable) -->
<button class="star" id="star-n" data-frame-img="frame-n-img" data-frame-vid="" data-name="Antü">
  <div class="core"></div>
  <div class="name">Antü</div>
</button>
<button class="star" id="star-e" data-frame-img="frame-e-img" data-frame-vid="" data-name="Az Mapu">
  <div class="core"></div>
  <div class="name">Az Mapu</div>
</button>
<button class="star" id="star-s" data-frame-img="frame-s-img" data-frame-vid="frame-s-vid" data-name="Küyen">
  <div class="core"></div>
  <div class="name">Küyen</div>
</button>
<button class="star" id="star-w" data-frame-img="frame-w-img" data-frame-vid="" data-name="Lafken">
  <div class="core"></div>
  <div class="name">Lafken</div>
</button>
<button class="star" id="star-ne" data-frame-img="frame-ne-img" data-frame-vid="" data-name="Pelon">
  <div class="core"></div>
  <div class="name">Pelon</div>
</button>
<button class="star" id="star-se" data-frame-img="frame-se-img" data-frame-vid="" data-name="Mapu">
  <div class="core"></div>
  <div class="name">Mapu</div>
</button>
<button class="star" id="star-sw" data-frame-img="frame-sw-img" data-frame-vid="" data-name="Trafün">
  <div class="core"></div>
  <div class="name">Trafün</div>
</button>
<button class="star" id="star-nw" data-frame-img="frame-nw-img" data-frame-vid="" data-name="Pewma">
  <div class="core"></div>
  <div class="name">Pewma</div>
</button>
<button class="star" id="star-wunelfe" data-frame-img="frame-wunelfe" data-frame-vid="frame-wunelfe" data-name="Wüñelfe">
  <div class="core"></div>
  <div class="name">Wüñelfe</div>
</button>
<button class="star" id="star-treng" data-frame-img="frame-treng" data-frame-vid="" data-name="Treng Treng">
  <div class="core"></div>
  <div class="name">Treng Treng</div>
</button>

<!-- MANDALA (the gateway) -->
<div id="mandala-wrap" title="Touch to choose">
  <div id="mandala-halo"></div>
  <img id="mandala" src="wenu-mandala.png" alt="Wenu Mapu mandala">
</div>

<!-- CHOICE MENU (revealed on mandala click) -->
<div id="choice-backdrop"></div>
<div id="choice-menu">
  <button class="choice" id="choice-enter">
    <div class="ring">↗</div>
    <div class="title">Enter Wenu Mapu</div>
    <div class="subtitle">The site begins</div>
  </button>
  <button class="choice" id="choice-wunelfe">
    <div class="ring">✦</div>
    <div class="title">Wüñelfe</div>
    <div class="subtitle">The morning star</div>
  </button>
  <button class="choice" id="choice-treng">
    <div class="ring">∽</div>
    <div class="title">Treng Treng & Kai Kai</div>
    <div class="subtitle">The two serpents</div>
  </button>
</div>

<!-- CURSOR -->
<div id="cur"></div>

<!-- CORNERS -->
<div class="corner tl">Wenu Mapu</div>
<div class="corner tr" id="coord">— · —</div>
<div class="corner bl">Ancestral Jewelry</div>
<div class="corner br">@wenu__mapu</div>

<!-- STATUS -->
<div id="status">Hover to preview · click a star to enter</div>

<!-- ZONE LABEL -->
<div id="zone-label"><span class="name" id="zone-name"></span><span id="zone-text"></span><div class="line"></div></div>

<!-- GLITCH FLASH (triggered on zone change) -->
<div id="glitch"></div>

<!-- FILM GRAIN OVERLAY -->
<div id="grain"></div>

<!-- DEEP PORTAL — full-screen experience on star click -->
<div id="deep-portal">
  <div id="deep-bg"></div>
  <div id="deep-vignette"></div>
  <button id="deep-return">Return to portal</button>
  <div id="deep-content">
    <div class="deep-aspect" id="deep-aspect"></div>
    <h1 class="deep-name" id="deep-name"></h1>
    <div class="deep-english" id="deep-english"></div>
    <div class="deep-poem" id="deep-poem"></div>
    <div class="deep-body" id="deep-body"></div>
  </div>
  <img id="deep-mandala" src="wenu-mandala.png" alt="">
</div>

<!-- ENTER FADE -->
<div id="enter-fade"></div>

<script>
const $ = id => document.getElementById(id);
let W = window.innerWidth, H = window.innerHeight;
let mx = W/2, my = H/2;
let menuOpen = false;
let isEntering = false;

// ─── CURSOR ───
const cur = $('cur');
document.addEventListener('mousemove', e => {
  mx = e.clientX; my = e.clientY;
  cur.style.left = mx + 'px';
  cur.style.top = my + 'px';
  $('coord').textContent = `${Math.round(mx/W*360)}° · ${Math.round(my/H*180)}°`;
});

// ─── COSMOS ───
const cosmosCanvas = $('cosmos');
const ctx = cosmosCanvas.getContext('2d');
cosmosCanvas.width = W; cosmosCanvas.height = H;
const stars = Array.from({length: 220}, () => ({
  x: Math.random() * W, y: Math.random() * H,
  r: Math.random() * 1.3 + 0.2,
  speed: Math.random() * 0.15 + 0.02,
  phase: Math.random() * Math.PI * 2,
  color: Math.random() > 0.85 ? '#f0c060' : (Math.random() > 0.7 ? '#c4501a' : '#d4a843')
}));
function drawCosmos(t) {
  ctx.clearRect(0, 0, W, H);
  stars.forEach(s => {
    const twinkle = 0.4 + 0.6 * Math.sin(t * s.speed + s.phase);
    const px = s.x + (mx - W/2) * 0.004 * s.r;
    const py = s.y + (my - H/2) * 0.004 * s.r;
    ctx.beginPath();
    ctx.arc(px, py, s.r * twinkle, 0, Math.PI*2);
    ctx.fillStyle = s.color;
    ctx.globalAlpha = twinkle * 0.7;
    ctx.fill();
    ctx.globalAlpha = 1;
  });
}

// ─── DUST ───
const dustCanvas = $('dust');
const dctx = dustCanvas.getContext('2d');
dustCanvas.width = W; dustCanvas.height = H;
const dust = Array.from({length: 55}, () => ({
  x: Math.random() * W, y: Math.random() * H,
  vx: (Math.random()-0.5)*0.3, vy: (Math.random()-0.5)*0.3,
  r: Math.random() * 1.4 + 0.3, a: Math.random(),
  life: Math.random()
}));
function drawDust() {
  dctx.clearRect(0, 0, W, H);
  dust.forEach(p => {
    const dx = mx - p.x, dy = my - p.y;
    const dist = Math.sqrt(dx*dx+dy*dy);
    if (dist < 200) { p.vx += dx/dist * 0.04; p.vy += dy/dist * 0.04; }
    p.vx *= 0.98; p.vy *= 0.98;
    p.x += p.vx; p.y += p.vy;
    if (p.x < 0) p.x = W; if (p.x > W) p.x = 0;
    if (p.y < 0) p.y = H; if (p.y > H) p.y = 0;
    const alpha = p.a * (0.4 + 0.6 * Math.sin(Date.now()*0.001 + p.life*10));
    dctx.beginPath();
    dctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
    dctx.fillStyle = `rgba(212,168,67,${alpha * 0.5})`;
    dctx.fill();
  });
}

// ─── GLYPHS ───
const glyphChars = '◈◇◆◉○●▲△▽▿◎⊕⊗✦✧⬡⬢❋✴◐◑◒◓᛫ᛗᚱᚢᚠᛏ';
const glyphsContainer = $('glyphs');
function spawnGlyph() {
  const g = document.createElement('div');
  g.className = 'glyph';
  g.textContent = glyphChars[Math.floor(Math.random()*glyphChars.length)];
  g.style.left = Math.random()*100 + 'vw';
  g.style.top = '-20px';
  const dur = 9 + Math.random()*14;
  g.style.animationDuration = dur + 's';
  g.style.fontSize = (8 + Math.random()*8) + 'px';
  g.style.color = `rgba(212,168,67,${0.05 + Math.random()*0.10})`;
  glyphsContainer.appendChild(g);
  setTimeout(() => g.remove(), dur*1000);
}
setInterval(spawnGlyph, 500);

// ─── MANDALA rotation ───
const mandala = $('mandala');
let mandalaRot = 0;
function updateMandala() {
  mandalaRot += 0.08;
  const cx = W/2, cy = H/2;
  const dx = mx - cx, dy = my - cy;
  const dist = Math.sqrt(dx*dx + dy*dy);
  const maxDist = Math.sqrt(cx*cx + cy*cy);
  const proximity = 1 - Math.min(dist/maxDist, 1);
  const scl = 1 + proximity * 0.06;
  mandala.style.transform = `rotate(${mandalaRot}deg) scale(${scl})`;
  $('mandala-wrap').style.filter = `drop-shadow(0 0 ${28 + proximity*60}px rgba(212,168,67,${0.4 + proximity*0.4}))`;
}

// ─── STAR HOVER → PORTAL SWAP + DWELL→VIDEO ───
const STAR_TEXT = {
  'Antü':        'The Sun — Light, life, the sky above.',
  'Küyen':       'The Moon — Water, cycles, ancestral feminine.',
  'Az Mapu':     'The Way — Living right, caring for the land.',
  'Lafken':      'The Ocean — Threshold of transformation.',
  'Pelon':       'Dawn — The first light, the awakening.',
  'Mapu':        'Earth — The living land beneath our feet.',
  'Trafün':      'Meeting — Where waters and worlds converge.',
  'Pewma':       'Dream — The night vision, ancestral message.',
  'Wüñelfe':     'Venus — Morning star, eight-pointed guide of travelers.',
  'Treng Treng': 'The Serpent — Origin myth. The mountain rises with the flood.'
};
let activeFrame = 'frame-default';
let activeStar = null;
let dwellTimer = null;

function setActiveFrame(frameId) {
  if (frameId === activeFrame) return;
  document.querySelectorAll('.portal-frame').forEach(f => f.classList.remove('active'));
  const target = $(frameId);
  if (target) {
    target.classList.add('active');
    const v = target.querySelector('video');
    if (v) v.play().catch(() => {});
  }
  activeFrame = frameId;
  // Trigger glitch flash on every portal change — feels like tearing reality
  triggerGlitch();
}

function triggerGlitch() {
  const g = $('glitch');
  if (!g) return;
  g.classList.remove('flash');
  // Force reflow to restart animation
  void g.offsetWidth;
  g.classList.add('flash');
}

// ─── DEEP PORTAL CONTENT (cultural texts per star) ───
const DEEP_CONTENT = {
  'star-n': {
    bg: 'wenu-assets/wenu-n-antu.webp',
    aspect: 'Light · Life · Above',
    name: 'Antü',
    english: 'The Sun',
    poem: 'Light that crossed the sky before names existed.',
    body: `<p>Antü is the Sun — lord of <em>Wenu Mapu</em>, the celestial dimension arching above all worlds. He gives warmth, time, and the rhythm of days.</p>
<p>When silver catches morning light, it remembers Antü's first gesture. Every piercing made under his sky is a small horizon. Every aro a sun reborn.</p>`
  },
  'star-s': {
    bg: 'wenu-assets/wenu-s-kuyen.webp',
    aspect: 'Water · Cycles · Feminine',
    name: 'Küyen',
    english: 'The Moon',
    poem: 'Sister of Antü. The night counts in her breath.',
    body: `<p>Küyen is the Moon — companion and counterpart of Antü. She rules the waters, the tides of blood and ocean, the cycles that make all life possible.</p>
<p>In Mapuche tradition she is the ancestral feminine. Her phases teach patience: there is no light without the dark she carries first.</p>`
  },
  'star-e': {
    bg: 'wenu-assets/wenu-e-azmapu.webp',
    aspect: 'Code · Ethics · Right Living',
    name: 'Az Mapu',
    english: 'The Way',
    poem: 'How to walk so the land keeps walking with you.',
    body: `<p>Az Mapu is the law of right living — the woven code that binds a Mapuche person to the land, the ancestors, and the future not yet born.</p>
<p>It is not written. It is breathed. It teaches that taking is also giving, that silence is also speech, that the river is also you.</p>`
  },
  'star-w': {
    bg: 'wenu-assets/wenu-w-lafken.webp',
    aspect: 'Threshold · Transformation · Memory',
    name: 'Lafken',
    english: 'The Ocean',
    poem: 'Where the day ends, the dead step softly forward.',
    body: `<p>Lafken is the great water — the western horizon where the sun finishes its day and the spirits cross over.</p>
<p>The ocean is memory. It returns what was taken. The Mapuche relationship with the sea is one of respect — never to be conquered, only entered with permission.</p>`
  },
  'star-ne': {
    bg: 'wenu-assets/wenu-ne-dawn.webp',
    aspect: 'First Light · Awakening',
    name: 'Pelon',
    english: 'Dawn',
    poem: 'The eye opens before it knows what it sees.',
    body: `<p>Pelon is the dawn — the moment between Antü's absence and his return. The first light that names the silhouettes of the world.</p>
<p>It is the hour for the ceremonial cleansing — and for asking the day what it requires of you.</p>`
  },
  'star-se': {
    bg: 'wenu-assets/wenu-se-tierra.webp',
    aspect: 'Land · Body · Mother',
    name: 'Mapu',
    english: 'The Earth',
    poem: 'Beneath every step, an ancestor listening.',
    body: `<p>Mapu is the Earth — the living being beneath us. Not a resource. A relative.</p>
<p>In Mapuche cosmology, you do not own the land; you belong to it. The territory has its own name, its own memory, its own dignity. To be <em>Mapuche</em> is to remember this — <em>mapu-che</em>, <strong>people of the land</strong>.</p>`
  },
  'star-sw': {
    bg: 'wenu-assets/wenu-sw-nebula.webp',
    aspect: 'Convergence · Encounter',
    name: 'Trafün',
    english: 'The Meeting',
    poem: 'Two waters become one without losing themselves.',
    body: `<p>Trafün is the meeting — where rivers join, where worlds touch, where strangers become kin.</p>
<p>The Mapuche understand that nothing exists alone. Every encounter is a small treaty. Every conversation, a small Trafün.</p>`
  },
  'star-nw': {
    bg: 'wenu-assets/wenu-nw-void.webp',
    aspect: 'Night Vision · Ancestral Message',
    name: 'Pewma',
    english: 'The Dream',
    poem: 'What the day will not let you see, the night sends.',
    body: `<p>Pewma is the dream — but more than dream. It is the channel through which ancestors speak, warnings arrive, and the future leaves footprints.</p>
<p>Mapuche elders teach: listen to your pewma. The image at dawn is rarely random; the silver one finds in dream often becomes the silver one wears.</p>`
  },
  'star-wunelfe': {
    bg: 'wenu-assets/wenu-ne-wunelfe.webp',
    aspect: 'Morning Star · Eight Directions · Guide',
    name: 'Wüñelfe',
    english: 'Venus',
    poem: 'The first light, the last to fade.',
    body: `<p>Wüñelfe is Venus — the morning star, the eight-pointed marker that guided travelers and warriors across the great open.</p>
<p>Her symbol is sacred — the eight-pointed Mapuche star, present in silver, in weaving, in ceremony. She is brightness without violence.</p>`
  },
  'star-treng': {
    bg: 'wenu-assets/wenu-w-lafken.webp',
    aspect: 'Origin Myth · Mountain · Flood',
    name: 'Treng Treng',
    english: 'The Cosmic Serpent',
    poem: 'When the water rose, the mountain answered.',
    body: `<p>Treng Treng Vilu is the cosmic serpent of the highlands — she who raised the mountains when Kai Kai Vilu, serpent of the sea, brought the great flood.</p>
<p>The Mapuche origin story tells that those who climbed to Treng Treng's back survived. They became the Mapuche people. Every silver piece carries an echo of that climb.</p>`
  }
};

let deepOpen = false;
function enterDeepPortal(starId) {
  const c = DEEP_CONTENT[starId];
  if (!c) return;
  deepOpen = true;
  document.querySelectorAll('.star').forEach(s => s.classList.remove('lit'));
  activeStar = null;
  $('zone-label').classList.remove('visible');
  $('deep-bg').style.backgroundImage = `url('${c.bg}')`;
  $('deep-aspect').textContent = c.aspect;
  $('deep-name').textContent = c.name;
  $('deep-english').textContent = c.english;
  $('deep-poem').textContent = c.poem;
  $('deep-body').innerHTML = c.body;
  $('deep-portal').classList.add('open');
  triggerGlitch();
  // Pause any playing portal-frame videos
  document.querySelectorAll('.portal-frame video').forEach(v => v.pause());
}
function exitDeepPortal() {
  deepOpen = false;
  $('deep-portal').classList.remove('open');
  triggerGlitch();
}
// Wire return button
document.addEventListener('DOMContentLoaded', () => {
  const r = $('deep-return');
  if (r) r.addEventListener('click', (e) => { e.stopPropagation(); exitDeepPortal(); });
});
// Esc key also exits
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && deepOpen) exitDeepPortal();
});
// Click anywhere inside deep portal (except content + return button) → exit
document.addEventListener('DOMContentLoaded', () => {
  const dp = $('deep-portal');
  if (!dp) return;
  dp.addEventListener('click', (e) => {
    if (!deepOpen) return;
    // Don't exit if user clicked the content panel or return button
    if (e.target.closest('#deep-content') || e.target.closest('#deep-return')) return;
    exitDeepPortal();
  });
});

// ─── INJECT SVG STAR SHAPES (real stars, not squares) ───
const STAR_SVG = {
  sparkle4: `<svg viewBox="0 0 40 40">
    <path class="ray" d="M20 0 L22 17 L40 20 L22 23 L20 40 L18 23 L0 20 L18 17 Z"/>
    <circle class="dot" cx="20" cy="20" r="2.2"/>
  </svg>`,
  sparkle8: `<svg viewBox="0 0 40 40">
    <path class="ray" d="M20 0 L23 14 L34 6 L26 17 L40 20 L26 23 L34 34 L23 26 L20 40 L17 26 L6 34 L14 23 L0 20 L14 17 L6 6 L17 14 Z"/>
    <circle class="dot" cx="20" cy="20" r="2.6"/>
  </svg>`,
  ring: `<svg viewBox="0 0 40 40">
    <circle cx="20" cy="20" r="14" fill="none" stroke-width="1.2" class="ray" style="stroke:currentColor;fill:none" stroke="rgba(220,120,50,0.85)"/>
    <circle class="ray" cx="20" cy="6" r="2"/>
    <circle class="ray" cx="34" cy="20" r="2"/>
    <circle class="ray" cx="20" cy="34" r="2"/>
    <circle class="ray" cx="6" cy="20" r="2"/>
    <circle class="dot" cx="20" cy="20" r="3"/>
  </svg>`
};
document.querySelectorAll('.star').forEach(s => {
  const core = s.querySelector('.core');
  if (!core) return;
  if (s.id === 'star-wunelfe')      core.innerHTML = STAR_SVG.sparkle8;
  else if (s.id === 'star-treng')   core.innerHTML = STAR_SVG.ring;
  else                              core.innerHTML = STAR_SVG.sparkle4;
});

// ─── CONSTELLATION LINES (faint web connecting all stars to center) ───
(function buildConstellation() {
  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.setAttribute('id', 'constellation');
  svg.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;z-index:4;pointer-events:none;';
  document.body.appendChild(svg);

  function redrawLines() {
    svg.innerHTML = '';
    const cx = window.innerWidth / 2;
    const cy = window.innerHeight / 2;
    document.querySelectorAll('.star').forEach(s => {
      const r = s.getBoundingClientRect();
      const sx = r.left + r.width / 2;
      const sy = r.top + r.height / 2;
      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', cx);
      line.setAttribute('y1', cy);
      line.setAttribute('x2', sx);
      line.setAttribute('y2', sy);
      line.setAttribute('data-star-id', s.id);
      line.setAttribute('stroke', 'rgba(212,168,67,0.08)');
      line.setAttribute('stroke-width', '0.6');
      line.setAttribute('stroke-dasharray', '2 6');
      svg.appendChild(line);
    });
  }
  redrawLines();
  window.addEventListener('resize', redrawLines);
  window.__redrawConstellation = redrawLines;
})();

// ─── PARALLAX TILT on portal lens (subtle 3D feel) ───
const stage = document.querySelector('.portal-stage');
let tiltX = 0, tiltY = 0;
function updateTilt() {
  const nx = (mx / W - 0.5) * 2;
  const ny = (my / H - 0.5) * 2;
  // Subtle tilt — 1.8° max each way — feels alive, not nauseating
  tiltX += (ny * 1.8 - tiltX) * 0.05;
  tiltY += (-nx * 1.8 - tiltY) * 0.05;
  if (stage) {
    stage.style.transform = `translate(-50%, -50%) perspective(1800px) rotateX(${tiltX.toFixed(2)}deg) rotateY(${tiltY.toFixed(2)}deg)`;
  }
}

// ─── CLICK RIPPLE on portal area ───
document.addEventListener('click', (e) => {
  if (e.target.closest('.star') || e.target.closest('.choice')) return;
  const r = document.createElement('div');
  r.style.cssText = `
    position:fixed; left:${e.clientX}px; top:${e.clientY}px;
    width:6px; height:6px; border-radius:50%;
    border:1.5px solid rgba(240,192,96,0.85);
    transform:translate(-50%,-50%);
    pointer-events:none; z-index:600;
    animation: ripple-out 1.1s ease-out forwards;
  `;
  document.body.appendChild(r);
  setTimeout(() => r.remove(), 1200);
});
// Add ripple keyframe via stylesheet
(function () {
  const s = document.createElement('style');
  s.textContent = `@keyframes ripple-out {
    from { width: 6px; height: 6px; opacity: 1; border-width: 1.5px; }
    to   { width: 320px; height: 320px; opacity: 0; border-width: 0.5px; }
  }`;
  document.head.appendChild(s);
})();

// ─── BRIGHTEN constellation line for active star ───
function highlightConstellationFor(starId) {
  const lines = document.querySelectorAll('#constellation line');
  lines.forEach(l => {
    if (l.dataset.starId === starId) {
      l.setAttribute('stroke', 'rgba(255,220,140,0.55)');
      l.setAttribute('stroke-width', '1.4');
      l.setAttribute('stroke-dasharray', '0');
    } else {
      l.setAttribute('stroke', 'rgba(212,168,67,0.08)');
      l.setAttribute('stroke-width', '0.6');
      l.setAttribute('stroke-dasharray', '2 6');
    }
  });
}
function dimAllConstellation() {
  document.querySelectorAll('#constellation line').forEach(l => {
    l.setAttribute('stroke', 'rgba(212,168,67,0.08)');
    l.setAttribute('stroke-width', '0.6');
    l.setAttribute('stroke-dasharray', '2 6');
  });
}

// ─── CURSOR TRAIL (gold dust) ───
let lastTrailTime = 0;
document.addEventListener('mousemove', (e) => {
  const now = Date.now();
  if (now - lastTrailTime < 40) return; // throttle: ~25fps
  lastTrailTime = now;
  const t = document.createElement('div');
  t.className = 'trail';
  t.style.left = e.clientX + 'px';
  t.style.top = e.clientY + 'px';
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 900);
});

function activateStar(starEl) {
  if (menuOpen || isEntering) return;
  if (activeStar === starEl) return;
  // Reset previously lit star
  document.querySelectorAll('.star').forEach(s => s.classList.remove('lit'));
  starEl.classList.add('lit');
  activeStar = starEl;

  const name = starEl.dataset.name;
  const frameImg = starEl.dataset.frameImg;
  const frameVid = starEl.dataset.frameVid;

  setActiveFrame(frameImg);
  if (typeof highlightConstellationFor === 'function') highlightConstellationFor(starEl.id);
  $('zone-name').textContent = name;
  $('zone-text').textContent = STAR_TEXT[name] || '';
  $('zone-label').classList.add('visible');

  // Dwell 2.5s → upgrade to video if available
  clearTimeout(dwellTimer);
  if (frameVid) {
    dwellTimer = setTimeout(() => {
      if (activeStar === starEl) setActiveFrame(frameVid);
    }, 2500);
  }
}

function deactivateStars() {
  if (menuOpen || isEntering) return;
  document.querySelectorAll('.star').forEach(s => s.classList.remove('lit'));
  activeStar = null;
  clearTimeout(dwellTimer);
  if (typeof dimAllConstellation === 'function') dimAllConstellation();
  setTimeout(() => {
    if (!activeStar) {
      setActiveFrame('frame-default');
      $('zone-label').classList.remove('visible');
    }
  }, 400);
}

document.querySelectorAll('.star').forEach(s => {
  s.addEventListener('mouseenter', () => activateStar(s));
  s.addEventListener('mouseleave', () => {});
  // Click → enter the deep portal for this star
  s.addEventListener('click', (e) => {
    e.stopPropagation();
    enterDeepPortal(s.id);
  });
});

// ─── IMPLICIT ZONE DETECTION (cursor position → activate direction, 8 zones) ───
// atan2 angles: 0°=E, 90°=S, -90°=N, ±180°=W
function detectZone() {
  const cx = W/2, cy = H/2;
  const dx = mx - cx, dy = my - cy;
  const dist = Math.sqrt(dx*dx + dy*dy);
  const inner = Math.min(W, H) * 0.18;
  if (dist < inner) return null;
  let a = Math.atan2(dy, dx) * 180 / Math.PI;
  if (a >= -112.5 && a < -67.5) return 'n';
  if (a >= -67.5  && a < -22.5) return 'ne';
  if (a >= -22.5  && a < 22.5)  return 'e';
  if (a >= 22.5   && a < 67.5)  return 'se';
  if (a >= 67.5   && a < 112.5) return 's';
  if (a >= 112.5  && a < 157.5) return 'sw';
  if (a >= -157.5 && a < -112.5) return 'nw';
  return 'w';
}
const ZONE_TO_STAR = {
  n:  'star-n',  s:  'star-s',  e:  'star-e',  w:  'star-w',
  ne: 'star-ne', se: 'star-se', sw: 'star-sw', nw: 'star-nw'
};
let currentZone = undefined;
let zoneSettleTimer = null;
document.addEventListener('mousemove', () => {
  if (menuOpen || isEntering) return;
  const z = detectZone();
  if (z === currentZone) return;
  currentZone = z;
  clearTimeout(zoneSettleTimer);
  // 150ms grace = responsive but anti-flicker on fast moves
  zoneSettleTimer = setTimeout(() => {
    if (z === null) {
      deactivateStars();
    } else {
      const starEl = $(ZONE_TO_STAR[z]);
      if (starEl) activateStar(starEl);
    }
  }, 150);
});

// ─── MANDALA CLICK → ENTER WENU MAPU (the shop) directly ───
$('mandala-wrap').addEventListener('click', (e) => {
  e.stopPropagation();
  if (isEntering || deepOpen) return;
  // Direct entry: skip the choice menu, fire the zoom + transition
  $('choice-enter').click();
});

$('choice-backdrop').addEventListener('click', () => {
  menuOpen = false;
  $('choice-menu').classList.remove('open');
  $('choice-backdrop').classList.remove('open');
  $('status').textContent = 'Hover to preview · click a star to enter';
  $('status').classList.remove('active');
});

// ─── CHOICE: ENTER WENU MAPU (zoom + transition) ───
$('choice-enter').addEventListener('click', (e) => {
  e.stopPropagation();
  isEntering = true;
  menuOpen = false;
  $('choice-menu').classList.remove('open');
  $('choice-backdrop').classList.remove('open');
  cur.classList.add('active');
  $('status').textContent = '∿ Entering Wenu Mapu ∿';
  setTimeout(() => $('mandala-wrap').classList.add('zoom'), 200);
  setTimeout(() => $('enter-fade').classList.add('show'), 1800);
  setTimeout(() => {
    document.body.innerHTML = `
      <div style="height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#f5ead8;color:#060402;font-family:'IM Fell English',serif;text-align:center;padding:24px;">
        <img src="wenu-mandala.png" style="width:120px;filter:invert(1);opacity:0.7;margin-bottom:32px;" />
        <h1 style="font-size:32px;letter-spacing:0.08em;font-weight:400;margin-bottom:16px;">You have entered Wenu Mapu</h1>
        <p style="font-size:13px;letter-spacing:0.3em;text-transform:uppercase;opacity:0.6;">(here begins the rest of the site)</p>
      </div>`;
    document.body.style.cursor = 'auto';
  }, 3200);
});

// ─── CHOICE: WÜÑELFE → enter its deep portal ───
$('choice-wunelfe').addEventListener('click', (e) => {
  e.stopPropagation();
  menuOpen = false;
  $('choice-menu').classList.remove('open');
  $('choice-backdrop').classList.remove('open');
  enterDeepPortal('star-wunelfe');
});

// ─── CHOICE: TRENG TRENG → enter its deep portal ───
$('choice-treng').addEventListener('click', (e) => {
  e.stopPropagation();
  menuOpen = false;
  $('choice-menu').classList.remove('open');
  $('choice-backdrop').classList.remove('open');
  enterDeepPortal('star-treng');
});

// ─── MAIN LOOP ───
let t = 0;
function loop() {
  t += 0.016;
  drawCosmos(t);
  drawDust();
  updateMandala();
  if (typeof updateTilt === 'function') updateTilt();
  requestAnimationFrame(loop);
}

window.addEventListener('resize', () => {
  W = window.innerWidth; H = window.innerHeight;
  cosmosCanvas.width = W; cosmosCanvas.height = H;
  dustCanvas.width = W; dustCanvas.height = H;
});

// ─── LAUNCH ───
function launch() { loop(); }
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', launch);
} else {
  launch();
}
// Try to play default video (autoplay may be blocked on file://)
const def = $('frame-default').querySelector('video');
if (def) {
  def.play().catch(() => {
    document.addEventListener('mousemove', () => def.play().catch(()=>{}), { once: true });
  });
}
</script>
</body>
</html>
