---
import "./kodex-ripple.css";

interface Props {
  title?: string;
  description?: string;
  shaderBase?: string;
}

const {
  title = "THE FLOOR WAS NEVER SOLID.",
  description = "Every signal becomes displacement, memory and rupture.",
  shaderBase = "/assets/kodex/shaders",
} = Astro.props;
---

<section
  class="kdx-ripple"
  data-kdx-ripple
  data-shader-base={shaderBase}
  data-state="0"
>
  <canvas class="kdx-ripple__canvas" aria-hidden="true"></canvas>
  <div class="kdx-fallback" aria-hidden="true"></div>

  <div class="kdx-shell">
    <header class="kdx-header">
      <div class="kdx-logo">KODEX−∞</div>
      <div class="kdx-header__right">
        <span class="kdx-dot"></span>
        <span>MEMBRANE · LIVE</span>
        <span>KDX_04</span>
      </div>
    </header>

    <div class="kdx-main">
      <div class="kdx-copy">
        <p class="kdx-kicker">04 / 08 · SURFACE RESPONSE PROTOCOL</p>
        <h2 class="kdx-title">{title}</h2>
        <p class="kdx-description">{description}</p>

        <div class="kdx-actions">
          <button class="kdx-cta" type="button" data-kdx-activate>
            BREAK THE SURFACE →
          </button>
          <button
            class="kdx-mic"
            type="button"
            data-kdx-mic
            aria-label="Activate microphone response"
            aria-pressed="false"
          >
            MIC
          </button>
        </div>
      </div>

      <div aria-hidden="true"></div>

      <aside class="kdx-rail">
        <div>State<strong data-kdx-state>DORMANT</strong></div>
        <div>Surface<strong>MEMBRANE</strong></div>
        <div>Impact<strong>TOUCH</strong></div>
        <div>FPS<strong data-kdx-fps>—</strong></div>
      </aside>
    </div>

    <footer class="kdx-footer">
      <span>PREVIOUS</span>
      <span class="kdx-progress" aria-hidden="true"></span>
      <span class="kdx-footer__index">04 / 08 · INDEX</span>
    </footer>
  </div>
</section>

<script>
  import { mountKodexRippleFloor } from "./kodex-ripple-client";

  document.querySelectorAll<HTMLElement>("[data-kdx-ripple]").forEach((element) => {
    mountKodexRippleFloor(element);
  });
</script>
