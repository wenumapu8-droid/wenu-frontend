{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KODEX Hero Media Resolution v0.1",
  "type": "object",
  "required": [
    "id",
    "source_class",
    "resolution_status",
    "source_registry_ref",
    "public_export_allowed",
    "allowed_transformations"
  ],
  "properties": {
    "id": {"type":"string","minLength":1},
    "source_class": {"enum":["OCIN","REFERENCE","GENERATED","OTHER"]},
    "resolution_status": {"enum":["RESOLVED","UNRESOLVED","BLOCKED"]},
    "source_registry_ref": {"type":"string","minLength":1},
    "public_export_allowed": {"type":"boolean"},
    "allowed_transformations": {"type":"array","items":{"type":"string"}},
    "provenance_status": {"type":"string"},
    "rights_status": {"type":"string"},
    "fallback": {"type":["string","null"]},
    "notes": {"type":"array","items":{"type":"string"}}
  },
  "allOf": [
    {
      "if": {"properties":{"resolution_status":{"const":"UNRESOLVED"}},"required":["resolution_status"]},
      "then": {"properties":{"public_export_allowed":{"const":false}}}
    },
    {
      "if": {"properties":{"resolution_status":{"const":"BLOCKED"}},"required":["resolution_status"]},
      "then": {"properties":{"public_export_allowed":{"const":false}}}
    }
  ]
}
