{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KODEX Assembly Candidate v0.2",
  "type": "object",
  "required": [
    "visual_mode",
    "recipe_id",
    "hero_media_ids",
    "components",
    "color_mode",
    "viewport",
    "provenance_check",
    "text_slots",
    "motion_profile",
    "epistemic_notes",
    "reduced_motion"
  ],
  "properties": {
    "example_id": {
      "type": "string",
      "minLength": 1
    },
    "visual_mode": {
      "type": "string",
      "pattern": "^[0-9]{2}_[A-Z0-9_-]+$"
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^RCP-[A-Z0-9-]+$"
    },
    "hero_media_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stable_id",
          "slug",
          "x",
          "y",
          "w",
          "h"
        ],
        "properties": {
          "stable_id": {
            "type": "string",
            "pattern": "^KDX-VIS-[0-9]{4}$"
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "color_mode": {
      "enum": [
        "mono",
        "paper",
        "cyan",
        "violet",
        "magenta",
        "yellow",
        "red"
      ]
    },
    "viewport": {
      "enum": [
        "desktop",
        "mobile"
      ]
    },
    "provenance_check": {
      "enum": [
        "PASS",
        "FAIL",
        "NEEDS_CONFIRMATION"
      ]
    },
    "text_slots": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "motion_profile": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reduced_motion": {
      "type": "object",
      "required": [
        "mode",
        "continuous_motion",
        "preserve"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "continuous_motion": {
          "const": false
        },
        "preserve": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
