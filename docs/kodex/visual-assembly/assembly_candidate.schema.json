{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KODEX Assembly Candidate v0.2",
  "type": "object",
  "required": [
    "recipe_id",
    "hero_media_ids",
    "components",
    "color_mode",
    "viewport",
    "provenance_check"
  ],
  "properties": {
    "recipe_id": {
      "type": "string"
    },
    "hero_media_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stable_id",
          "slug",
          "x",
          "y",
          "w",
          "h"
        ],
        "properties": {
          "stable_id": {
            "type": "string",
            "pattern": "^KDX-VIS-[0-9]{4}$"
          },
          "slug": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "w": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "h": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "color_mode": {
      "enum": [
        "mono",
        "paper",
        "cyan",
        "violet",
        "magenta",
        "yellow",
        "red"
      ]
    },
    "viewport": {
      "enum": [
        "desktop",
        "mobile"
      ]
    },
    "provenance_check": {
      "enum": [
        "PASS",
        "FAIL",
        "NEEDS_CONFIRMATION"
      ]
    },
    "epistemic_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reduced_motion": {
      "type": "object"
    }
  }
}
