{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KODEX GIPHY Asset Manifest",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "giphy_id",
      "page_url",
      "kodex_category",
      "kodex_scene",
      "kodex_roles",
      "attribution"
    ],
    "properties": {
      "giphy_id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "page_url": {
        "type": "string",
        "format": "uri"
      },
      "username": {
        "type": [
          "string",
          "null"
        ]
      },
      "rating": {
        "type": "string"
      },
      "kodex_category": {
        "type": "string"
      },
      "kodex_scene": {
        "type": "string"
      },
      "kodex_roles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "priority": {
        "type": "integer"
      },
      "selected": {
        "type": "boolean"
      }
    }
  }
}