{
  "$schema": "kodex-visual-grammar/v1",
  "purpose": "Gramática visual KODEX: no guardamos assets, guardamos las REGLAS de comportamiento. Config-driven. Fase B (leer el ADN) + A (schema). Grids (C) = kdx-grids.json.",
  "note": "v1 derivado del storyboard real (KODEX-STORYBOARD-CONTENT.md) + copy extraída + 2 escenas ya renderizadas. Refinar los % de composición contra los píxeles cuando se bajen las láminas de Drive.",

  "record_schema": {
    "id": "string",
    "source_type": "poster|dossier|interface|transition|card|detail|commerce",
    "semantic_role": "string (qué ES en el journey)",
    "mood": ["retrofuturist","psy-tech","cyber-organic","ritual","archival"],
    "composition": {
      "grid_family": "KDX_GRID_A..F",
      "zones": "int",
      "hero_position": "center|center-left|left|right",
      "headline_position": "top|center|overlay",
      "data_density": "low|medium|high",
      "symmetry": "0..1 (0=asimétrico)",
      "depth": "flat|layered|deep"
    },
    "geometry": { "dominant": ["..."], "organic_ratio": "0..1", "technical_ratio": "0..1", "repetition": "low|medium|high" },
    "color": { "bg": "hex", "dominant": "hex", "accent": "hex", "coverage": {"bg":"%","dominant":"%","accent":"%"}, "contrast": "0..1" },
    "texture": { "grain": "0..1", "dither": "0..1", "scanline": "0..1", "halftone": "0..1", "chroma": "0..1", "glitch": "0..1", "glow": "0..1" },
    "motion": { "slow": ["..."], "medium": ["..."], "fast": ["..."], "reactive": ["..."] },
    "blocks": ["block_type ..."],
    "script_accent": "devanagari|arabic|kanji|kana|hangul|cyrillic|greek|none",
    "audio_state": "E00|T01|M11|R10"
  },

  "block_taxonomy": [
    "headline","subheadline","hero-artifact","data-panel","side-rail","barcode-strip",
    "icon-cluster","seal","microtext","diagram","waveform","warning-label","status-chip",
    "frame","index-list","script-band","system-log","checksum","cta","stratum-card"
  ],

  "motion_presets": {
    "slow":   ["ambient_glow","particle_drift","orbital_oscillation","soft_distortion","bg_parallax","grid_breath"],
    "medium": ["moving_scanlines","undulating_grid","wireframe_flux","ring_pulse","radar_sweep"],
    "fast":   ["glitch_burst","status_flash","text_flicker","signal_jump","signal_lost_found"],
    "reactive": ["hover","pointer_track","scroll_response","click_pulse","audio_reactive"]
  },
  "motion_rules": {
    "grain": "siempre presente, sutil",
    "glitch": "episódico, NUNCA permanente",
    "status_chip": "parpadea cada 3-6 s",
    "grid_overlay": "motion lento",
    "warning_flash": "solo por evento",
    "hierarchy": "headline nunca compite con microtext; un solo evento rápido a la vez",
    "reduced_motion": "prefers-reduced-motion desactiva medium+fast, conserva slow tenue"
  },

  "grid_families": {
    "KDX_GRID_A": "editorial poster (UMBRAL, transición, siguiente-capítulo)",
    "KDX_GRID_B": "dossier / specimen (detalle de obra, ficha)",
    "KDX_GRID_C": "interface / dashboard (lectura del sistema, loop activo)",
    "KDX_GRID_D": "tunnel / perspective (transición, portales)",
    "KDX_GRID_E": "collage / event flyer (ediciones, comisión)",
    "KDX_GRID_F": "central shrine / ritual object (archivo/capítulo, hero mandala)"
  },

  "references": [
