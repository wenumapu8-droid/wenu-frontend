---
import "../css/kdx.typography.v2.css";

interface Props {
  bundle?:
    | "core"
    | "threshold_error"
    | "machine_cosmology"
    | "ghost_editorial"
    | "longform";
}

const { bundle = "core" } = Astro.props;
---

<div data-kdx-font-provider={bundle}>
  <slot />
</div>

<script>
  import {
    loadKdxFontBundle,
  } from "../runtime/kdx-font-loader";

  const provider =
    document.currentScript?.previousElementSibling;

  const bundle =
    provider?.getAttribute("data-kdx-font-provider");

  if (bundle) {
    loadKdxFontBundle("core")
      .then(() => {
        if (bundle !== "core") {
          return loadKdxFontBundle(bundle);
        }
      })
      .catch((error) => {
        console.error(error);
      });
  }
</script>
