{
  "name": "KODEX Typography System",
  "version": "2.0.0",
  "policy": {
    "exactIdentification": "Not claimed from screenshots.",
    "selectionMethod": "Functional equivalence: proportion, contrast, width, rhythm, legibility and scene role.",
    "fontFilesIncluded": false,
    "maxFamiliesLoadedPerScene": 4,
    "maxDisplayFamiliesPerScene": 1,
    "maxMonoFamiliesPerScene": 1,
    "coreBundle": [
      "Inter Tight",
      "IBM Plex Mono",
      "Barlow Condensed"
    ],
    "glyphPolicy": "KODEX runes and sigils are SVG symbols, not a text font."
  },
  "families": [
    {
      "id": "kdx-display-condensed",
      "family": "Barlow Condensed",
      "role": "Primary condensed display",
      "source": "Google Fonts",
      "weights": [
        600,
        700,
        800,
        900
      ],
      "styles": [
        "normal"
      ],
      "fallback": "\"Arial Narrow\", \"Helvetica Neue Condensed\", Impact, sans-serif",
      "use": [
        "ACCESS DENIED scale headlines",
        "BEYOND HUMAN scale headlines",
        "threshold commands",
        "scene-number typography"
      ],
      "avoid": [
        "body copy",
        "labels below 12px",
        "paragraphs",
        "all-caps sentences longer than 10 words"
      ],
      "loading": "core",
      "variablePreferred": true
    },
    {
      "id": "kdx-display-tech",
      "family": "Oxanium",
      "role": "Techno display and machine headings",
      "source": "Google Fonts",
      "weights": [
        500,
        600,
        700
      ],
      "styles": [
        "normal"
      ],
      "fallback": "Eurostile, BankGothic, \"Arial Black\", sans-serif",
      "use": [
        "machine titles",
        "portal labels",
        "cosmology section names",
        "large technical numerals"
      ],
      "avoid": [
        "long paragraphs",
        "dense telemetry under 11px",
        "every headline in the product"
      ],
      "loading": "scene:machine|cosmology|portal",
      "variablePreferred": true
    },
    {
      "id": "kdx-ui",
      "family": "Inter Tight",
      "role": "UI, navigation and supporting sans",
      "source": "Google Fonts",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "styles": [
        "normal",
        "italic"
      ],
      "fallback": "Inter, \"Helvetica Neue\", Arial, sans-serif",
      "use": [
        "navigation",
        "buttons",
        "supporting body copy",
        "panel titles",
        "short editorial statements"
      ],
      "avoid": [
        "giant hero headlines when condensed display is required",
        "fake terminal output"
      ],
      "loading": "core",
      "variablePreferred": true
    },
    {
      "id": "kdx-data",
      "family": "IBM Plex Mono",
      "role": "Telemetry, metadata and code-like information",
      "source": "Google Fonts",
      "weights": [
        400,
        500,
        600
      ],
      "styles": [
        "normal",
        "italic"
      ],
      "fallback": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
      "use": [
        "IDs",
        "coordinates",
        "frequency",
        "timestamps",
        "metadata",
        "logs",
        "micro labels"
      ],
      "avoid": [
        "hero titles",
        "long editorial paragraphs",
        "all body copy"
      ],
      "loading": "core",
      "variablePreferred": false
    },
    {
      "id": "kdx-terminal",
      "family": "Azeret Mono",
      "role": "Error, access and OCR-influenced terminal language",
      "source": "Google Fonts",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "styles": [
        "normal"
      ],
      "fallback": "\"IBM Plex Mono\", Consolas, monospace",
      "use": [
        "ACCESS DENIED",
        "404",
        "authentication errors",
        "system warnings",
        "terminal prompts"
      ],
      "avoid": [
        "normal archive records",
        "large quantities of body copy",
        "loading together with another decorative mono"
      ],
      "loading": "scene:error|threshold",
      "variablePreferred": true
    },
    {
      "id": "kdx-editorial-display",
      "family": "Bodoni Moda",
      "role": "High-contrast editorial and ritual display serif",
      "source": "Google Fonts",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "styles": [
        "normal",
        "italic"
      ],
      "fallback": "Didot, Bodoni 72, \"Times New Roman\", serif",
      "use": [
        "Ghost Hardware interlude",
        "poetic statements",
        "ritual editorial titles",
        "selected pull quotes"
      ],
      "avoid": [
        "system labels",
        "data",
        "buttons",
        "more than one scene in succession"
      ],
      "loading": "scene:ghost|editorial",
      "variablePreferred": true
    },
    {
      "id": "kdx-editorial-reading",
      "family": "Libre Baskerville",
      "role": "Long-form archive reading",
      "source": "Google Fonts",
      "weights": [
        400,
        700
      ],
      "styles": [
        "normal",
        "italic"
      ],
      "fallback": "Baskerville, Georgia, serif",
      "use": [
        "manifesto excerpts",
        "archive essays",
        "citations",
        "book-like notes"
      ],
      "avoid": [
        "fullscreen scene UI",
        "telemetry",
        "large condensed posters"
      ],
      "loading": "route:longform",
      "variablePreferred": false
    },
    {
      "id": "kdx-glyphs",
      "family": "KODEX Glyph SVG Registry",
      "role": "Non-linguistic sigils, runes and technical micrographics",
      "source": "Internal SVG sprite",
      "weights": [],
      "styles": [],
      "fallback": "none",
      "use": [
        "runes",
        "constellation symbols",
        "ritual markers",
        "nonverbal navigation",
        "auth seals"
      ],
      "avoid": [
        "encoding words",
        "replacing accessible labels",
        "using arbitrary Unicode private-use characters without mapping"
      ],
      "loading": "sprite",
      "variablePreferred": false
    }
  ],
  "sceneBundles": {
    "threshold_error": [
      "Barlow Condensed",
      "Inter Tight",
      "Azeret Mono"
    ],
    "observe_archive": [
      "Barlow Condensed",
      "Inter Tight",
      "IBM Plex Mono"
    ],
    "machine_cosmology": [
      "Oxanium",
      "Inter Tight",
      "IBM Plex Mono"
    ],
    "ghost_editorial": [
      "Bodoni Moda",
      "Inter Tight",
      "IBM Plex Mono"
    ],
    "longform": [
      "Libre Baskerville",
      "Inter Tight",
      "IBM Plex Mono"
    ]
  }
}