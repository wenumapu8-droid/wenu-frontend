# WooCommerce REST API — read-only credentials
# Generate at: WP Admin → WooCommerce → Settings → Advanced → REST API
WC_URL=https://www.wenumapuonline.com/wp-json/wc/v3
WC_CONSUMER_KEY=ck_REPLACE_ME
WC_CONSUMER_SECRET=cs_REPLACE_ME

# Store origin (cart, checkout, account). Switch to https://shop.wenumapuonline.com
# during Fase C cutover. Leave commented to fall back to the legacy www. host.
# STORE_BASE_URL=https://www.wenumapuonline.com

# Analytics — leave unset to skip injection. Tracking scripts only render
# when these are present, so dev/preview builds stay clean.
# PUBLIC_GA_ID=G-XXXXXXXXXX
# PUBLIC_META_PIXEL_ID=1234567890

# Intentional empty-product builds (dev/migration only — NEVER set in CI)
# ALLOW_EMPTY_PRODUCTS=true
