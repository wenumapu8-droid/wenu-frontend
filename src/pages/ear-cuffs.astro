---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import PatternBand from '../components/PatternBand.astro';
import { getProducts } from '../lib/woo';
import en from '../i18n/en.json';

const L = en.landing.ear_cuffs;

const KEYWORDS = ['ear-cuff', 'ear-cuffs', 'earcuff', 'pinza-de-oreja', 'pinza'];
const all = await getProducts();
const matched = all.filter(p =>
  p.images.length > 0 && p.images[0].src &&
  p.categories.some(c => KEYWORDS.some(k => c.slug.toLowerCase().includes(k)))
);
const featured = matched.slice(0, 6);

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: L.title,
  description: L.intro,
  url: 'https://wenumapuonline.com/ear-cuffs',
  isPartOf: { '@type': 'WebSite', name: 'Wenu Mapu', url: 'https://wenumapuonline.com' },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wenumapuonline.com/' },
    { '@type': 'ListItem', position: 2, name: 'Ear Cuffs', item: 'https://wenumapuonline.com/ear-cuffs' },
  ],
};
---
<Base
  title="Ear Cuffs — Hand-forged silver, brass, titanium | Wenu Mapu"
  description="Sculpted ear cuffs for helix, conch and outer ear. Hand-forged in Truckee, California. No piercing required."
  ogImage="/img/categories/hangers.png"
  jsonLd={[collectionLd, breadcrumbLd]}
>
  <section class="section section--mega">
    <div class="container">
      <p class="eyebrow">{L.eyebrow}</p>
      <h1 class="page-title">{L.title}</h1>
      <p class="lede">{L.intro}</p>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>

      <div class="landing__copy">
        <p>{L.p1}</p>
        <p>{L.p2}</p>
      </div>

      <div class="landing__cta">
        <a href={L.shop_target} class="btn btn--solid">{L.cta_primary} →</a>
        <a href="/sizing-guide" class="btn btn--ghost">{L.cta_secondary}</a>
      </div>

      {featured.length > 0 && (
        <div class="landing__rail" aria-label="Selected ear cuffs">
          <div class="landing__rail-head">
            <p class="eyebrow">Selected pieces</p>
            <a href={L.shop_target} class="text-accent">View all →</a>
          </div>
          <div class="featured-v2__rail">
            {featured.map(product => (
              <div class="featured-v2__cell">
                <ProductCard product={product} />
              </div>
            ))}
          </div>
        </div>
      )}

      {featured.length === 0 && (
        <div class="landing__rail" aria-label="Ear cuff availability">
          <div class="landing__rail-head">
            <p class="eyebrow">Made by request</p>
            <a href="/custom-orders" class="text-accent">Start a commission →</a>
          </div>
          <p class="text-soft italic" style="max-width: 58ch;">
            Ear cuffs are not in the ready-to-ship catalogue today. Commission one in silver, brass, or titanium and we will size the curve for your ear.
          </p>
        </div>
      )}
    </div>
  </section>
</Base>
