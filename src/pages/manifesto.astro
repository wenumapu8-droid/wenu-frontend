---
import Base from '../layouts/Base.astro';
import ManifestoSpiral3D from '../components/ManifestoSpiral3D.astro';
import ManifestoKultrunSection from '../components/ManifestoKultrunSection.astro';
import PrefooterQuote from '../components/PrefooterQuote.astro';

/* /manifesto — página dedicada al manifiesto de marca.
   Acá vive la sección kultrún (que también aparece en la home como momento
   editorial) + la cita académica de Sonia Montecino sobre la cosmovisión
   astral mapuche. La cita es contexto/inspiración, NO atribución de autoría.
*/

const manifestoLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Manifesto — Wenu Mapu',
  description:
    'Wenu Mapu manifesto: the body is sacred territory. Adornment as ritual. The kultrún as cosmic map — east, south, west, north.',
  url: 'https://wenumapuonline.com/manifesto',
};
---

<Base
  title="Manifesto — The body is sacred territory | Wenu Mapu"
  description="Wenu Mapu manifesto — ritual jewelry born from the relationship between body, earth and cosmos. The kultrún as sacred map of the Mapuche universe."
  ogImage="/img/hero/hero-cosmos-eclipse.webp"
  jsonLd={manifestoLd}
>
  {/* SEO/a11y anchor — the manifesto opens as a visual scroll journey, so the page
      needs one true H1 for search + screen readers without altering the design. */}
  <h1 class="visually-hidden">The body is sacred territory — the Wenu Mapu manifesto</h1>

  {/* The cosmic journey (v5, 2026-07-18): Wenu Mapu/the sun -> planets -> moon
      -> Nag Mapu/the earth -> the four forces -> the kultrún -> the cosmic DNA
      -> the net of eyes -> Miñche Mapu/the black hole -> the void. WebGL when
      the device can, the hand-coded SVG spiral as poster/fallback otherwise.
      Opens the manifesto as a scroll journey, before the kultrún section. */}
  <ManifestoSpiral3D />

  <ManifestoKultrunSection showElementsLink={true} />

  {/* Sonia Montecino academic quote — anchored here as inspiration/source
      context for the manifesto, NOT as attribution of authorship to Wenu Mapu.
      The book belongs to Canio & Pozo. We are readers. */}
  <PrefooterQuote />
</Base>
