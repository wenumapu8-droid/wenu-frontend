---
import Base from '../layouts/Base.astro';
import en from '../i18n/en.json';
---

<Base
  title="Sets — Curated jewelry sets | Wenu Mapu"
  description="Curated ritual sets: rings, hangers, ear weights, septum and amulet in harmony. Pieces that speak to one another, forged to be worn as a single intention."
>
  <!-- ── HERO ── -->
  <section class="sets-hero" aria-label="Ritual sets — curated">
    <div class="sets-hero__inner">
      <p class="eyebrow">SETS · RITUAL PAIRINGS</p>
      <h1 class="sets-hero__headline">
        Pieces that speak<br/>as a single intention.
      </h1>
      <p class="sets-hero__sub">
        Hand-curated sets. Each one is a chord — ring, hanger, ear weight, septum and amulet — conceived as one body of adornment. Take the whole set with an honest, bundled price.
      </p>
    </div>
  </section>

  <!-- ── PLACEHOLDER SECTION ── -->
  <section class="sets-grid" aria-label="Available sets">
    <div class="container">
      <div class="sets-empty">
        <p class="eyebrow">COMING SOON</p>
        <h2 class="sets-empty__title">Sets in preparation</h2>
        <p class="sets-empty__body">
          We're curating the first five ritual sets — lifestyle photography in progress, modeled in Truckee.<br/>
          We'll announce one each week starting June 2026.
        </p>
        <a href="/contact" class="btn btn--solid">Reserve a made-to-order set →</a>
      </div>
    </div>
  </section>

  <!-- ── FUTURE: cuando estén las fotos ── -->
  <!--
    Estructura propuesta de cada conjunto:

    <article class="set-card">
      <picture>
        <source srcset="/img/sets/ritual-amanecer.avif" type="image/avif" />
        <img src="/img/sets/ritual-amanecer.webp" alt="Conjunto Ritual Amanecer" loading="lazy" />
      </picture>
      <div class="set-card__copy">
        <p class="eyebrow">CONJUNTO N°1 · RITUAL AMANECER</p>
        <h3>5 piezas · 1 acorde</h3>
        <p>...descripción ritual y materiales...</p>
        <ul class="set-pieces">
          <li><a href="/p/ritual-ring-vacamuerta-no3">Anillo Vacamuerta N°3</a></li>
          <li><a href="/p/...">Hanger madera + bronce</a></li>
          <li><a href="/p/...">Septum titanio</a></li>
          <li><a href="/p/...">Ear weights ammonite</a></li>
          <li><a href="/p/...">Amuleto cardinal</a></li>
        </ul>
        <p class="set-price">USD 1,250 · paq. set (15% off vs. piezas sueltas)</p>
        <a href="..." class="btn btn--solid">Llevar el conjunto</a>
      </div>
    </article>
  -->
</Base>

<style>
  .sets-hero {
    background: var(--obsidian);
    padding: var(--space-7) 0;
    border-bottom: var(--border-thin);
  }
  .sets-hero__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .sets-hero__headline {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: var(--fw-regular);
    line-height: 1.05;
    color: var(--bone);
    text-transform: uppercase;
    margin: var(--space-3) 0 var(--space-4);
    max-width: 14ch;
  }
  .sets-hero__sub {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-size: var(--fs-body-lg);
    line-height: 1.6;
    color: var(--fg-soft);
    max-width: 52ch;
  }
  .sets-grid {
    padding: var(--space-7) 0;
  }
  .sets-empty {
    text-align: center;
    padding: var(--space-7) var(--gutter);
    border: var(--border-thin);
    background: var(--charcoal);
  }
  .sets-empty__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    color: var(--bone);
    text-transform: uppercase;
    margin: var(--space-3) 0 var(--space-4);
  }
  .sets-empty__body {
    font-family: var(--font-serif);
    color: var(--fg-soft);
    margin: 0 auto var(--space-5);
    max-width: 56ch;
    line-height: 1.7;
  }
</style>
