---
import Base from '../layouts/Base.astro';
import en from '../i18n/en.json';
---

<Base
  title="Conjuntos — Curated jewelry sets | Wenu Mapu"
  description="Conjuntos rituales seleccionados: rings, hangers, ear weights, septum + amulet en armonía. Piezas que dialogan entre sí, forjadas para llevarse como una sola intención."
>
  <!-- ── HERO ── -->
  <section class="sets-hero" aria-label="Conjuntos rituales — sets curados">
    <div class="sets-hero__inner">
      <p class="eyebrow">CONJUNTOS · SETS RITUALES</p>
      <h1 class="sets-hero__headline">
        Piezas que dialogan<br/>como una sola intención.
      </h1>
      <p class="sets-hero__sub">
        Conjuntos seleccionados a mano. Cada set propone un acorde — anillo, hanger, ear weight, septum y amuleto — pensado como un solo cuerpo de adornamiento. Comprá el set completo con un acuerdo de precio honesto.
      </p>
    </div>
  </section>

  <!-- ── SECCIÓN PLACEHOLDER ── -->
  <section class="sets-grid" aria-label="Conjuntos disponibles">
    <div class="container">
      <div class="sets-empty">
        <p class="eyebrow">PRÓXIMAMENTE</p>
        <h2 class="sets-empty__title">Conjuntos en preparación</h2>
        <p class="sets-empty__body">
          Estamos curando los primeros 5 conjuntos rituales — fotografía lifestyle en proceso, modelado en Truckee.<br/>
          Anunciamos uno por semana a partir de junio 2026.
        </p>
        <a href="/contact" class="btn btn--solid">Reserva un conjunto a medida →</a>
      </div>
    </div>
  </section>

  <!-- ── FUTURE: cuando estén las fotos ── -->
  <!--
    Estructura propuesta de cada conjunto:

    <article class="set-card">
      <picture>
        <source srcset="/img/sets/ritual-amanecer.avif" type="image/avif" />
        <img src="/img/sets/ritual-amanecer.webp" alt="Conjunto Ritual Amanecer" loading="lazy" />
      </picture>
      <div class="set-card__copy">
        <p class="eyebrow">CONJUNTO N°1 · RITUAL AMANECER</p>
        <h3>5 piezas · 1 acorde</h3>
        <p>...descripción ritual y materiales...</p>
        <ul class="set-pieces">
          <li><a href="/p/ritual-ring-vacamuerta-no3">Anillo Vacamuerta N°3</a></li>
          <li><a href="/p/...">Hanger madera + bronce</a></li>
          <li><a href="/p/...">Septum titanio</a></li>
          <li><a href="/p/...">Ear weights ammonite</a></li>
          <li><a href="/p/...">Amuleto cardinal</a></li>
        </ul>
        <p class="set-price">USD 1,250 · paq. set (15% off vs. piezas sueltas)</p>
        <a href="..." class="btn btn--solid">Llevar el conjunto</a>
      </div>
    </article>
  -->
</Base>

<style>
  .sets-hero {
    background: var(--obsidian);
    padding: var(--space-7) 0;
    border-bottom: var(--border-thin);
  }
  .sets-hero__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .sets-hero__headline {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: var(--fw-regular);
    line-height: 1.05;
    color: var(--bone);
    text-transform: uppercase;
    margin: var(--space-3) 0 var(--space-4);
    max-width: 14ch;
  }
  .sets-hero__sub {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-size: var(--fs-body-lg);
    line-height: 1.6;
    color: var(--fg-soft);
    max-width: 52ch;
  }
  .sets-grid {
    padding: var(--space-7) 0;
  }
  .sets-empty {
    text-align: center;
    padding: var(--space-7) var(--gutter);
    border: var(--border-thin);
    background: var(--charcoal);
  }
  .sets-empty__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    color: var(--bone);
    text-transform: uppercase;
    margin: var(--space-3) 0 var(--space-4);
  }
  .sets-empty__body {
    font-family: var(--font-serif);
    color: var(--fg-soft);
    margin: 0 auto var(--space-5);
    max-width: 56ch;
    line-height: 1.7;
  }
</style>
