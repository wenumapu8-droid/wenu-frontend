---
import Base from '../layouts/Base.astro';
import en from '../i18n/en.json';

const sections = [
  { id: 'rituals',   label: en.footer.rituals,   blurb: 'Ceremonial use of body adornment across cultures and time.' },
  { id: 'cosmology', label: en.footer.cosmology, blurb: 'Mapuche cosmology, the four cardinals, and ancestral geometries we draw from.' },
  { id: 'ancestry',  label: en.footer.ancestry,  blurb: 'Pieces as memory: how form holds inheritance.' },
  { id: 'stories',   label: en.footer.stories,   blurb: 'Notes from the studio. Process, materials, fragments.' },
];
---
<Base
  title="Journal — Wenu Mapu"
  description="Field notes from the Wenu Mapu studio in Truckee, California. Ritual, cosmology, ancestry, process."
>
  <section class="section section--mega">
    <div class="container">
      <p class="eyebrow">{en.journal.eyebrow}</p>
      <h1 class="page-title">{en.journal.title}</h1>
      <p class="lede">{en.journal.intro}</p>

      <div class="journal-grid">
        {sections.map(s => (
          <article id={s.id} class="journal-card">
            <h2 class="journal-card__label">{s.label}</h2>
            <p class="journal-card__blurb">{s.blurb}</p>
            <p class="journal-card__soon">First entries forthcoming.</p>
          </article>
        ))}
      </div>

      <p class="muted" style="margin-top: var(--space-6);">{en.journal.soon}</p>
    </div>
  </section>
</Base>
