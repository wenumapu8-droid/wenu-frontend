---
import Base from '../layouts/Base.astro';
import en from '../i18n/en.json';
---
<Base title="Journal — Wenu Mapu" description="Field notes from the Wenu Mapu studio in Truckee, California.">
  <section class="section section--mega">
    <p class="eyebrow">{en.journal.eyebrow}</p>
    <h1 class="page-title">{en.journal.title}</h1>
    <p class="lede">{en.journal.intro}</p>
    <p class="muted" style="margin-top: var(--space-5);">{en.journal.soon}</p>
  </section>
</Base>
