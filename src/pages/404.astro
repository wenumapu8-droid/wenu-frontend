---
import Base from '../layouts/Base.astro';
import EmbossedSeal from '../components/EmbossedSeal.astro';

const popular = [
  { href: '/shop',          label: 'Catalogue',       blurb: 'All available pieces' },
  { href: '/custom-orders', label: 'Commissions',     blurb: 'Custom in silver or 14k gold' },
  { href: '/care-guide',    label: 'Care guide',      blurb: 'Healing times & aftercare' },
  { href: '/about',         label: 'About',           blurb: 'Our story, materials, artistry' },
  { href: '/contact',       label: 'Contact',         blurb: 'Email, IG, WhatsApp' },
  { href: '/local',         label: 'Local pickup',    blurb: 'Truckee · Reno · Tahoe' },
];
---
<Base
  title="404 — Lost in the upper land | Wenu Mapu"
  description="The page you're looking for doesn't exist. Return to the catalogue or read about Wenu Mapu."
>
  <section class="notfound">
    <div class="notfound__inner">
      <div class="notfound__seal" aria-hidden="true">
        <EmbossedSeal text="404 · WENU MAPU · LOST IN THE UPPER LAND" size={180} />
      </div>
      <p class="eyebrow">404 · NOT FOUND</p>
      <h1 class="notfound__title">This path doesn't lead anywhere.</h1>
      <p class="notfound__body">
        The page you're looking for isn't here — maybe it moved, maybe it was never here. Try one of these:
      </p>
      <div class="notfound__cta">
        <a href="/" class="btn btn--solid">Return home →</a>
        <a href="/shop" class="btn btn--ghost">See the catalogue</a>
      </div>

      <ul class="notfound__popular" aria-label="Popular destinations">
        {popular.map(p => (
          <li>
            <a href={p.href} class="notfound__pop-link">
              <span class="notfound__pop-label">{p.label}</span>
              <span class="notfound__pop-blurb">{p.blurb}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
