// ── Real prices (no placeholders) ──
// Per-piercing service fees come from the published /piercing pricing list (USD).
const SERVICE_FEE: Record<string, number> = {
  'Lobe': 80, 'Helix': 85, 'Forward Helix': 85, 'Flat': 85, 'Tragus': 85,
  'Rook': 90, 'Daith': 90, 'Conch': 90, 'Snug': 90, 'Anti-Tragus': 90, 'Industrial': 85,
};
// Jewelry "from" prices = minimum REAL WooCommerce price among in-stock pieces
// compatible with each placement. Used for HEALED-piercing upgrades only (fresh
// placements use pre-sterilized initial jewelry — see wearStage gating below).
const _all = await getProducts();
const _tagged = buildPiercingJewelry(_all);
const PLACEMENT_KEYS = ['lobe', 'helix', 'conch', 'tragus', 'daith'] as const;
const jewelryFrom: Record<string, number> = {};
for (const key of PLACEMENT_KEYS) {
  const prices = _tagged
    .filter((t) => t.placements.includes(key as any))
    .map((t) => parseFloat(t.product.price))
    .filter((n) => Number.isFinite(n) && n > 0);
  if (prices.length) jewelryFrom[key] = Math.round(Math.min(...prices));
}

// Placement-first curation: up to 3 REAL catalogue pieces per placement (with price
// + image + product link). Rendered in the drawer as "Recommended by Wültufe".
const jewelryByPlacement: Record<string, { sku: string; name: string; price: string; img: string; url: string }[]> = {};
for (const key of PLACEMENT_KEYS) {
  const picks = _tagged
    .filter((t) => t.placements.includes(key as any) && t.product.images[0]?.src && parseFloat(t.product.price) > 0)
    .slice(0, 3)
    .map((t) => ({ sku: t.product.sku, name: t.product.name, price: t.product.price, img: t.product.images[0].src, url: `/p/${t.product.slug}` }));
  if (picks.length) jewelryByPlacement[key] = picks;
}

// Connector segments for the LINES. Kind derives from endpoints: two Rook points => a
// curved banana barbell; two bar-jewel points (industrial / surface / snug) => a straight
// gold bar; anything else => a thin constellation/chain link. Dangling refs are skipped.
const anchorById = new Map(ANCHORS.map((a) => [a.id, a]));
// Only a bar that rides OVER the ear surface stays visible (the industrial). Rook banana,
// surface bar and snug go THROUGH/UNDER the cartilage, so the bar is hidden — only the two
// beads show. Helix links are thin chains lying over the surface. A bead at every end
// occludes the entry hole, so a visible bar reads as entering the ear.
// ix*/iy* = the bar inset toward the centre by INDUSTRIAL_INSET, so its ends tuck UNDER the
// big end beads (the "cut" that sells the through-the-cartilage illusion).
const INDUSTRIAL_INSET = 26;
interface LineSeg { kind: 'bar' | 'beads' | 'line'; x1: number; y1: number; x2: number; y2: number; ix1: number; iy1: number; ix2: number; iy2: number }
const lineSegs: LineSeg[] = LINES
  .map(([ia, ib]): LineSeg | null => {
    const a = anchorById.get(ia); const b = anchorById.get(ib);
    if (!a || !b) return null;
    const kind: 'bar' | 'beads' | 'line' =
      (a.zone === 'Industrial' && b.zone === 'Industrial') ? 'bar'
      : (a.zone === 'Rook' && b.zone === 'Rook') ? 'beads'
      : (a.jewel === 'bar' && b.jewel === 'bar') ? 'beads'
      : 'line';
    const dx = b.x - a.x, dy = b.y - a.y, len = Math.hypot(dx, dy) || 1;
    const ux = dx / len, uy = dy / len, ins = INDUSTRIAL_INSET;
    return {
      kind, x1: a.x, y1: a.y, x2: b.x, y2: b.y,
      ix1: Math.round(a.x + ux * ins), iy1: Math.round(a.y + uy * ins),
      ix2: Math.round(b.x - ux * ins), iy2: Math.round(b.y - uy * ins),
    };
  })
  .filter((s): s is LineSeg => s !== null);

// Real jewelry cutouts (transparent PNGs from Ocin's photos, bg removed). Placeholder set.
const REAL_JEWELRY = [
  'j_0ebf90df024b.png',
  'j_13db3e320f7e.png',
