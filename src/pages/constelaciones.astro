      <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="16" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M4 9h16M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></symbol>
      <symbol id="i-ear" viewBox="0 0 24 24"><path d="M7 9a5 5 0 019.8-1.4c.7 2.3-1 3.6-2 4.6-.8.8-1.3 1.6-1.3 2.6a2 2 0 01-3.6 1.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></symbol>
      <symbol id="i-sparkle" viewBox="0 0 24 24"><path d="M12 4v6M12 14v6M4 12h6M14 12h6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/></symbol>
      <symbol id="i-undo" viewBox="0 0 24 24"><path d="M8 5L4 9l4 4" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 9h10a5 5 0 010 10H8.5" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="i-redo" viewBox="0 0 24 24"><path d="M16 5l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 9H10a5 5 0 000 10h5.5" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="i-trash" viewBox="0 0 24 24"><path d="M4.5 7h15M10 7V4.6h4V7M6.5 7l1 12.6h9L17.5 7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 10.6v6.2M14 10.6v6.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></symbol>
    </defs>
  </svg>

  {/* ════════ ENTRY (compact, ear-first on mobile) ════════ */}
  <section class="section--tight wstudio-entry">
    <div class="container">
      <p class="eyebrow">Wültufe · Ritual Ear Curation</p>
      <h1 class="page-title wstudio-entry__title">Build your ear constellation</h1>
      <p class="wstudio-entry__sub">Mark your ear, choose real jewelry, and refine it with anatomical guidance — confirmed in person by Ocin.</p>
      <div class="wstudio-entry__cards" role="group" aria-label="Choose how to begin">
        <button type="button" class="wstudio-card" data-mode="existing">
          <svg class="ico wstudio-card__ico" aria-hidden="true"><use href="#i-check"></use></svg>
          <span class="wstudio-card__name">Map my current ear</span>
          <span class="wstudio-card__desc">Mark what you already have.</span>
        </button>
        <button type="button" class="wstudio-card" data-mode="new">
          <svg class="ico wstudio-card__ico" aria-hidden="true"><use href="#i-plus"></use></svg>
          <span class="wstudio-card__name">Plan a new piercing</span>
          <span class="wstudio-card__desc">Propose fresh placements.</span>
        </button>
        <button type="button" class="wstudio-card" data-explore>
          <svg class="ico wstudio-card__ico" aria-hidden="true"><use href="#i-star"></use></svg>
          <span class="wstudio-card__name">Explore curated constellations</span>
          <span class="wstudio-card__desc">Start from a ritual set.</span>
        </button>
      </div>
      <p class="wstudio-entry__trust"><strong>New piercings: Titanium ASTM F-136 / solid gold only.</strong> Healed spots open more material &amp; style. This is exploration &amp; pre-curation — not automatic anatomical approval.</p>
    </div>
  </section>

  {/* ════════ CURATED CONSTELLATIONS (collapsed until "Explore") ════════ */}
  <section class="section--tight wstudio-samplers" data-presets-wrap hidden>
    <div class="container">
      <p class="eyebrow">Ritual constellations · tap one to build it</p>
      <div class="wstudio-presets">
        {PRESETS.map((p) => (
          <button type="button" class="wstudio-preset" data-preset={p.key} data-items={p.items.join(',')} data-mat={p.mat || 'yellow-gold'}>
            <span class="wstudio-preset__kind">{p.kind === 'star' ? 'Star pattern' : 'Ritual set'}</span>
            <span class="wstudio-preset__name">{p.name}{p.mapuche && <em class="wstudio-preset__mapu"> · {p.mapuche}</em>}</span>
            <span class="wstudio-preset__sub">{p.sub}</span>
            <span class="wstudio-preset__build">Build this constellation →</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* ════════ STUDIO: CANVAS + PANEL ════════ */}
  <section class="wstudio is-empty" id="studio">
    <script type="application/json" id="w-jewelry-from" set:html={JSON.stringify(jewelryFrom)}></script>
    <script type="application/json" id="w-jewelry-by" set:html={JSON.stringify(jewelryByPlacement)}></script>
    <script type="application/json" id="w-lines" set:html={JSON.stringify(LINES)}></script>
    <div class="container wstudio__grid">

      {/* ── Ear canvas ── */}
      <div class="wstudio__stage" data-stage>
        <div class="wstudio__earhead">
          <div class="wstudio__earswap" role="group" aria-label="Choose ear">
            <button type="button" class="wstudio__earbtn is-active" data-ear="right" aria-pressed="true">Right ear</button>
            <button type="button" class="wstudio__earbtn" data-ear="left" aria-pressed="false">Left ear</button>
          </div>
          <p class="wstudio__earhint" data-hint>Choose a status, then tap a point on the ear.</p>
          <button type="button" class="wstudio__howto" data-tour-open>How it works <span aria-hidden="true">✦</span></button>
        </div>

        <div class="wstudio__earwrap">
          <div class="wstudio__starfield" aria-hidden="true"></div>
          {/* on-brand cosmic loader — shown until the ear image paints (never a black rectangle) */}
          <div class="wstudio__loader" data-ear-loader aria-hidden="true">
            <svg class="wstudio__mandala" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
              <g class="wstudio__mandala-spin" fill="none" stroke-linecap="round">
                <circle cx="60" cy="60" r="46" stroke="var(--ember)" stroke-width="0.8" stroke-dasharray="1 7" opacity=".5"/>
                <circle cx="60" cy="60" r="34" stroke="var(--bone)" stroke-width="0.8" stroke-dasharray="2 10" opacity=".35"/>
                <circle cx="60" cy="60" r="22" stroke="var(--ember)" stroke-width="1" stroke-dasharray="30 70" opacity=".7"/>
                <path d="M60 8 L60 20 M60 100 L60 112 M8 60 L20 60 M100 60 L112 60 M23 23 L31 31 M89 89 L97 97 M97 23 L89 31 M31 89 L23 97" stroke="var(--ember)" stroke-width="0.8" opacity=".55"/>
              </g>
              <circle cx="60" cy="60" r="3" fill="var(--ember)"/>
            </svg>
            <span class="wstudio__loader-txt">Summoning the ear…</span>
          </div>
          <svg class="wstudio__ear" data-ear-svg viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg"
               role="img" aria-label="Anatomical ear with piercing placement anchors">
            <defs>
              <radialGradient id="w-glow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="rgba(201,168,76,0.55)"/>
                <stop offset="100%" stop-color="rgba(201,168,76,0)"/>
              </radialGradient>
              <filter id="w-soft" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="2.2" result="b"/>
                <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <filter id="w-b2"><feGaussianBlur stdDeviation="6"/></filter>
              <radialGradient id="w-gold" cx="38%" cy="30%" r="72%">
                <stop offset="0%" stop-color="#f6e6ad"/>
                <stop offset="45%" stop-color="#d9b24a"/>
                <stop offset="100%" stop-color="#8a6a22"/>
              </radialGradient>
              {/* Soft contact shadow only — NOT an opaque black disc. Small offset + tight
                  blur + low opacity so a placed jewel reads as resting on the ear, never as
                  sitting on a black "coaster". */}
              <filter id="w-drop" x="-50%" y="-50%" width="200%" height="200%">
                <feDropShadow dx="0" dy="1.4" stdDeviation="2" flood-color="#000" flood-opacity="0.30"/>
              </filter>
            </defs>

            <g data-ear-group>
              {/* ── Ear base image slot ── Ocin's hand-drawn transparent PNG.
                   Anchors/jewelry overlay in the same 0–1024 coordinate space, so they
                   scale and mirror with it. */}
              <image data-ear-img href={EAR_IMAGE} x="0" y="0" width="1024" height="1024" preserveAspectRatio="xMidYMid meet" />

              {/* connecting jewelry: banana barbell (rook) / straight bar (industrial,
                  surface, snug) / thin chain link (helix constellation) */}
              {/* Nothing is shown by default — every piece (industrial included) behaves like
                  an anchor: ghost until hovered (preview) or placed. */}

              {/* constellation links + jewel markers (JS) */}
              <line class="w-industrial" data-industrial x1="0" y1="0" x2="0" y2="0" style="display:none"/>
              <polyline class="w-line" data-line points="" />
              <g data-chains></g>
              <g data-markers></g>

              {/* anchors (semantic, with generous click tolerance) */}
              <g data-anchors>
                {ANCHORS.map((a) => (
                  <g class="w-anchor" data-anchor data-id={a.id} data-name={a.name} data-zone={a.zone}
                     data-heal={a.heal} data-x={a.x} data-y={a.y} data-rot={a.rot} data-shop={a.shop}
                     data-fee={a.fee} data-jewel={a.jewel} data-size={a.size ?? 1} data-cut={a.cut ?? 74}
                     role="button" tabindex="0" aria-label={`${a.name} — tap to plan`}>
                    <circle class="w-anchor__hit" cx={a.x} cy={a.y} r="16" />
                    <circle class="w-anchor__dot" cx={a.x} cy={a.y} r="8" />
                  </g>
                ))}
              </g>
            </g>
          </svg>
          <div class="wstudio__tip" data-tip hidden aria-hidden="true"></div>

          {/* floating canvas actions — always reachable around the ear (≥44px tap targets) */}
          <div class="wstudio__tools" data-tools>
            <button type="button" class="wstudio__tool" data-undo2 aria-label="Undo" title="Undo (double-tap the canvas)" disabled>
              <svg class="ico" aria-hidden="true"><use href="#i-undo"></use></svg>
            </button>
            <button type="button" class="wstudio__tool" data-redo2 aria-label="Redo" title="Redo" disabled>
              <svg class="ico" aria-hidden="true"><use href="#i-redo"></use></svg>
            </button>
            <button type="button" class="wstudio__tool wstudio__tool--danger" data-del-sel aria-label="Delete selected point" title="Delete selected point" disabled>
              <svg class="ico" aria-hidden="true"><use href="#i-trash"></use></svg>
            </button>
          </div>

          {/* STATE selector — floating on the left edge of the canvas (thumb-reachable).
              Sets the active state for new points AND retags the selected point instantly. */}
          <div class="wstudio__states" data-states-cluster role="group" aria-label="Placement status">
            <button type="button" class="wstudio__statebtn" data-state="healed" aria-pressed="false" title="Existing — I already have this piercing"><i class="wj-dot wj-dot--healed" aria-hidden="true"></i><span>Existing</span></button>
            <button type="button" class="wstudio__statebtn" data-state="healing" aria-pressed="false" title="This piercing is currently healing"><i class="wj-dot wj-dot--healing" aria-hidden="true"></i><span>Healing</span></button>
            <button type="button" class="wstudio__statebtn is-active" data-state="planned" aria-pressed="true" title="New placement — I want to plan a new piercing"><i class="wj-dot wj-dot--planned" aria-hidden="true"></i><span>New placement</span></button>
          </div>
        </div>

        <p class="wstudio__legend">
          <span class="w-key w-key--empty">Open anchor</span>
          <span class="w-key w-key--healed">Existing</span>
          <span class="w-key w-key--healing">Healing</span>
          <span class="w-key w-key--planned">New placement (review)</span>
        </p>

        {/* ── Jewelry catalog (reference set — SVG placeholders until real PNGs) ── */}
        <div class="wstudio__catalog">
          <p class="wstudio__catalabel">Jewelry · your pieces ({REAL_JEWELRY.length})</p>
          <div class="wstudio__jrail" data-jrail role="listbox" aria-label="Jewelry pieces">
            {REAL_JEWELRY.map((f) => (
              <button type="button" class="wstudio__jtile" data-jpiece={f}>
                <img src={`/img/ear/jewelry/real/${f}`} loading="lazy" alt="" />
              </button>
