/**
 * WÜLTUFE · Ear Constellation Studio (rebuild MVP Phase 1 — Ocin 2026-06-29).
 *
 * Not a chart, not a zodiac graphic. A premium tool to PLAN a multi-session ear
 * project, mark existing piercings, propose new placements on anatomically fixed
 * anchors, pick a jewelry direction (material/gem/style), save/share via URL, and
 * submit the draft to the studio for in-person review.
 *
 * Governing rule (from research-proyecto-oreja-2026-06-29.md): everything here is a
 * DRAFT and a GUIDE. Nothing is confirmed without Ocin's in-person evaluation. No
 * "you can get N today" promises. Material gating on fresh placements: implant-grade
 * titanium (ASTM F-136) or solid 14k+ gold only. Gem guidance: lab-grown for fresh.
 * Quote = "from $—" placeholders until Ocin loads real amounts.
 *
 * Brand/nav/tokens/typography and the "Wültufe · the curation ritual" name are
 * preserved. Skin-drawing hex is the only allowed hardcoded-color exception.
 *
 * Anchor data structure (semantic objects, not free circles):
 *   { id, name, zone, heal:'lobe'|'outer'|'inner', x, y, rot, shop, link? }
 * Left ear = same geometry mirrored via scaleX(-1); anchors mirror with it.
 * Industrial is a linked pair (industrial-01-start / -end) drawn as one bar.
 */

/**
 * Product / SKU schema (Phase 2 jewelry configurator — documented here for MVP).
 *   interface StudioSku {
 *     sku: string; name: string; productImage: string;
 *     material: 'titanium'|'yellow-gold'|'rose-gold'|'white-gold'|'silver';
 *     threading: 'internal'|'threadless'|'ring';      // labrets internal by default
 *     gauge: string;                                   // e.g. '18g','16g'
 *     compatiblePlacements: string[];                  // anchor shop keys
 *     wearStage: ('fresh'|'healed')[];                 // GATING field
 *     gemstone?: 'amethyst'|'citrine'|'emerald'|'opal'|'clear'|'none';
 *     gemOrigin?: 'lab'|'natural';                     // lab preferred for fresh
 *     collection?: string; inventory: number; price: number;
 *   }
 * wearStage GATING (enforced): a "planned new" or "currently healing" placement may
 * only show SKUs whose wearStage includes 'fresh' (pre-sterilized, implant-grade,
 * internally threaded). UNTAGGED products default to NOT fresh-eligible (safe). A
 * "existing healed" placement may show the broader catalogue. In MVP the live SKU
 * grid is not wired in the drawer yet (jewelry is chosen as material/gem direction);
 * the gating RULE, copy and pricing are already enforced. Real jewelry "from" prices
 * come from WooCommerce (healed upgrades); fresh starter jewelry is included in the
 * piercing service fee from /piercing.
 */
type Heal = 'lobe' | 'outer' | 'inner';
type Jewel = 'stud' | 'hoop' | 'bar';
interface Anchor { id: string; name: string; zone: string; heal: Heal; x: number; y: number; rot: number; shop: string; jewel: Jewel; fee: number; size?: number; cut?: number; link?: string }

