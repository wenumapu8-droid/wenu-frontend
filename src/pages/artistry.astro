---
import Base from '../layouts/Base.astro';
import PatternBand from '../components/PatternBand.astro';
import en from '../i18n/en.json';

const stages = [
  {
    n: '01',
    title: 'Drawing',
    body: 'Every piece begins as a sketch. Symbols, proportions, body geometry — the page comes before the metal. We draw until the form earns the metal.',
  },
  {
    n: '02',
    title: 'Cutting',
    body: 'Sterling silver, gold or titanium sheet cut by hand from raw stock. The lines we drew become physical edges. No CNC, no laser — only hand and shears for most pieces.',
  },
  {
    n: '03',
    title: 'Forming',
    body: 'Forging on the anvil. Hammered, bent, rolled. Annealing between rounds to keep the metal alive. This is where the piece takes its volume.',
  },
  {
    n: '04',
    title: 'Setting',
    body: 'Stones, meteorite fragments, or inlay are set by hand using bezel or prong. The setting decides whether a stone is held — or trapped.',
  },
  {
    n: '05',
    title: 'Finishing',
    body: 'Files, sandpaper grit by grit (320 → 600 → 1200), polishing wheel, and final hand-rub with cloth. We leave a slight tool memory in pieces that ask for it.',
  },
  {
    n: '06',
    title: 'Blessing',
    body: 'A quiet moment with the piece before it goes into its packaging. Mapudungun word, sage smoke, or simple intention — depending on the piece. Then it leaves the studio.',
  },
];
---
<Base
  title="Artistry — Wenu Mapu"
  description="How a Wenu Mapu piece is made: drawing, cutting, forming, setting, finishing, blessing. Forged by hand in Truckee, California."
  ogImage="/img/brand/artistry-workbench.webp"
>
  <div class="cat-masthead cat-masthead--titled">
    <picture>
      <source type="image/avif" srcset="/img/banners/atmospheric/altar-candle-sparks.avif" />
      <img src="/img/banners/atmospheric/altar-candle-sparks.webp" alt="" width="1600" height="686" loading="eager" decoding="async" fetchpriority="high" />
    </picture>
    <div class="cat-masthead__label">
      <p class="cat-masthead__title">{en.about.artistry.heading}</p>
      <p class="cat-masthead__eyebrow">Artistry · By Hand</p>
    </div>
  </div>

  <section class="section section--mega">
    <div class="container">
      <p class="eyebrow">ARTISTRY · BY HAND</p>
      <h1 class="page-title">{en.about.artistry.heading}</h1>
      <p class="lede">{en.about.artistry.p1}</p>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>

      <picture class="artistry-media">
        <source srcset="/img/brand/artistry-workbench.avif" type="image/avif" />
        <img
          src="/img/brand/artistry-workbench.webp"
          alt="Wenu Mapu workshop bench with metalwork tools and a ring being heated"
          width="1400"
          height="2100"
          loading="lazy"
          decoding="async"
        />
      </picture>

      <ol class="artistry-stages">
        {stages.map(s => (
          <li class="artistry-stages__item">
            <span class="artistry-stages__num">{s.n}</span>
            <div class="artistry-stages__body">
              <h2 class="artistry-stages__title">{s.title}</h2>
              <p class="artistry-stages__text">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="italic text-soft" style="margin-top: var(--space-6); max-width: 60ch;">
        {en.about.artistry.p2}
      </p>

      <div style="margin-top: var(--space-5); display: flex; gap: var(--space-3); flex-wrap: wrap;">
        <a href="/custom-orders" class="btn btn--solid">Commission a piece →</a>
        <a href="/materials" class="btn btn--ghost">See materials</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .artistry-media {
    display: block;
    width: min(100%, 980px);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: var(--border-thin);
    margin: 0 0 var(--space-6);
    background: var(--bg-alt);
  }

  .artistry-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
