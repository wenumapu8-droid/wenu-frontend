---
import Base from '../layouts/Base.astro';
import PatternBand from '../components/PatternBand.astro';
import en from '../i18n/en.json';

const presence = [
  { city: 'Truckee, California',          context: 'Workshop visits by appointment. Pickup for online orders.', kind: 'workshop', current: true },
  { city: 'Reno, Nevada',                 context: 'Quarterly piercing pop-ups at partner studios.',             kind: 'popup',    current: true },
  { city: 'North Lake Tahoe, California', context: 'Local pickup zone, no permanent presence.',                  kind: 'pickup',   current: true },
  { city: 'Southern Chile',               context: 'Annual return for Mapuche craft markets and material sourcing.', kind: 'travel',  current: true },
];
---
<Base
  title="Stockists & Presences — Wenu Mapu"
  description="Where Wenu Mapu is found in person — Truckee workshop, Reno pop-ups, Lake Tahoe pickup, southern Chile annual returns."
  ogImage="/img/truckee/showcase.webp"
>
  <section class="section section--mega">
    <div class="container">
      <p class="eyebrow">STOCKISTS · IN PERSON</p>
      <h1 class="page-title">{en.about.stockists.heading}</h1>
      <p class="lede">{en.about.stockists.intro}</p>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>

      <ul class="stockists-list">
        {presence.map(p => (
          <li class="stockists-list__item">
            <div class="stockists-list__row">
              <span class="stockists-list__kind">{p.kind}</span>
              <h2 class="stockists-list__city">{p.city}</h2>
              {p.current && <span class="stockists-list__active">Active</span>}
            </div>
            <p class="stockists-list__context">{p.context}</p>
          </li>
        ))}
      </ul>

      <div class="stockists-apply">
        <h2 class="stockists-apply__title">Stock Wenu Mapu in your space.</h2>
        <p class="stockists-apply__body">
          We work with a very small number of partner studios — piercing studios, jewelry boutiques, ritual-aligned spaces — that carry a curated selection of our pieces with the same care we put into them.
        </p>
        <p class="stockists-apply__body">
          If your space resonates, write to <a href="mailto:contact@wenumapuonline.com?subject=Stockist inquiry" class="text-accent">contact@wenumapuonline.com</a> with a few photos of your space, your audience, and what you'd want to carry. We respond within 5 business days.
        </p>
        <a href="mailto:contact@wenumapuonline.com?subject=Stockist inquiry" class="btn btn--solid stockists-apply__cta">Reach out →</a>
      </div>
    </div>
  </section>
</Base>
