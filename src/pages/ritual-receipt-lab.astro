---
/**
 * Ritual Receipt — isolated experience prototype.
 * DEMO ONLY: No actual payments, order creation, inventory writes or fiscal invoice.
 * NOT attached to checkout. Requires server-verified payment event to go live.
 */
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---
<Base title="Ritual Receipt Lab — Wenu Mapu" description="Experimental printable ritual receipt (demo only)." robots="noindex, nofollow" noNav noFooter noQuote noKai noCart noImmersive noOverlays noThemes>
<main class="rr-lab">
  <header class="rr-head">
    <a href="/" class="rr-logo" aria-label="Wenu Mapu home"><Logo /></a>
    <div class="rr-wordmark">WENU MAPU <span> / RECEIPT LAB 001</span></div>
    <div class="rr-demo-flag">● INTERACTIVE DEMO</div>
  </header>

  <div class="rr-intro">
    <p class="rr-kicker">THE WORLD ABOVE / A COMMERCE EXPERIMENT</p>
    <h1>Commerce becomes <em>ceremony.</em></h1>
    <p>The payment experience ends. The relationship begins. A post-purchase artifact for the atelier and festival stand.</p>
  </div>

  <div class="rr-cols">
    <section class="rr-panel" aria-label="Demonstration order">
      <div class="rr-heading"><span>01 / SELECTION</span><span>USD</span></div>
      <h2>Gathered objects.</h2>
      <div id="rr-items"></div>
      <div class="rr-total"><span>Subtotal · sample</span><strong id="rr-sum">$0</strong></div>
      <p class="rr-note">Sample prices only. Tax and delivery are deliberately excluded from this UI experiment.</p>
      <fieldset class="rr-methods"><legend>SIMULATED PAYMENT METHOD</legend>
        <label><input type="radio" name="rr-method" value="Card" checked> Card</label>
        <label><input type="radio" name="rr-method" value="Venmo"> Venmo</label>
        <label><input type="radio" name="rr-method" value="Cash"> Cash</label>
      </fieldset>
      <button type="button" id="rr-pay" class="rr-primary">Simulate payment → Issue ticket</button>
      <p class="rr-safety">SIMULATION ONLY · NO REAL MONEY OR ORDERS</p>
      <p class="rr-status" id="rr-status" role="status" aria-live="polite">◇ Awaiting selection</p>
    </section>

    <section class="rr-output" aria-label="Receipt printer simulation">
      <div class="rr-heading"><span>02 / THERMAL OUTPUT</span><span id="rr-signal">STANDBY</span></div>
      <div class="rr-printer">
        <div class="rr-printer-label">WENU // 80MM THERMAL <span id="rr-light">●</span></div>
        <div class="rr-slot"></div>
        <div class="rr-printer-foot">PAPER FEED / 001 <span>FESTIVAL & ATELIER</span></div>
      </div>
      <div class="rr-tray">
        <p id="rr-placeholder">✧<br>YOUR RITUAL ARTIFACT<br>WILL EMERGE HERE.</p>
        <div id="rr-ticket" class="rr-ticket" hidden></div>
      </div>
      <div class="rr-actions">
        <button id="rr-print" type="button" disabled>↗ Print sample ticket</button>
        <button id="rr-reset" type="button">↻ Reset</button>
      </div>
    </section>
  </div>

  <footer class="rr-bottom">WENU MAPU · PROTOTYPE 001 <span>DOES NOT PROCESS PAYMENT · NOT A TAX INVOICE</span></footer>
</main>
</Base>

<script is:inline>
(function(){
  'use strict';
  const pieces=[
    {name:'Witral Vilu Hanger',kind:'HANGER',price:44,qty:1},
    {name:'Titanium Starburst Labret 16G',kind:'PIERCING',price:30,qty:1},
    {name:'Metatron Mandala Hanger',kind:'HANGER',price:50,qty:0}
  ];
  const el=id=>document.getElementById(id);
  const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(n);
  const total=()=>pieces.reduce((sum,p)=>sum+p.qty*p.price,0);
  let busy=false;let serial=0;

  function render(){
    const container=el('rr-items');
    container.replaceChildren();
    pieces.forEach(piece=>{
      const row=document.createElement('div');row.className='rr-piece';
      const text=document.createElement('div');text.className='rr-piece-name';
      const title=document.createElement('strong');title.textContent=piece.name;
      const kind=document.createElement('small');kind.textContent=piece.kind+' / '+money(piece.price);
      text.append(title,kind);
      const qty=document.createElement('div');qty.className='rr-qty';
      const minus=document.createElement('button');minus.type='button';minus.textContent='−';minus.disabled=busy||piece.qty===0;minus.setAttribute('aria-label','Remove one '+piece.name);minus.addEventListener('click',()=>{piece.qty--;render();});
      const output=document.createElement('output');output.textContent=String(piece.qty);
      const plus=document.createElement('button');plus.type='button';plus.textContent='+';plus.disabled=busy||piece.qty===9;plus.setAttribute('aria-label','Add one '+piece.name);plus.addEventListener('click',()=>{piece.qty++;render();});
      qty.append(minus,output,plus);row.append(text,qty);container.append(row);
    });
    el('rr-sum').textContent=money(total());
    el('rr-pay').disabled=busy||total()<=0;
  }

  function receipt(){
    const container=el('rr-ticket');container.replaceChildren();
    function line(className,value,parent=container){
      const node=document.createElement('div');node.className=className;node.textContent=value;parent.appendChild(node);return node;
    }
    line('rr-ticket-mark','✣');
    line('rr-ticket-brand','WENU MAPU');
    line('rr-ticket-label','THE WORLD ABOVE · RITUAL JEWELRY');
    line('rr-ticket-separator','- - - - - - - - - - - - - - - -');
    line('rr-ticket-label','DEMO ORDER / NOT PROOF OF PAYMENT');
    line('rr-ticket-ref','WM-DEMO-'+String(serial).padStart(4,'0'));
    line('rr-ticket-date',new Intl.DateTimeFormat('en-US',{dateStyle:'medium',timeStyle:'short'}).format(new Date()));
    line('rr-ticket-separator','- - - - - - - - - - - - - - - -');
    pieces.filter(p=>p.qty).forEach(p=>line('rr-ticket-row',p.qty+' × '+p.name+'   '+money(p.qty*p.price)));
    line('rr-ticket-separator','- - - - - - - - - - - - - - - -');
    line('rr-ticket-total','SUBTOTAL  '+money(total()));
    const method=document.querySelector('input[name="rr-method"]:checked');
    line('rr-ticket-small','METHOD: '+(method?method.value.toUpperCase():'CARD')+' (SIMULATED)');
    line('rr-ticket-small','TAX + SHIPPING NOT CALCULATED');
    line('rr-ticket-ritual','The body is the altar.\nThe adornment, the rite.');
    const a=document.createElement('a');a.href='https://wenumapuonline.com/care-guide/';a.textContent='wenumapuonline.com/care-guide';a.rel='noopener noreferrer';a.target='_blank';a.className='rr-ticket-link';container.append(a);
    line('rr-ticket-legal','DEMO · NO CHARGE · NOT A TAX INVOICE');
  }

  function reset(){
    if(busy)return;
    el('rr-ticket').classList.remove('rr-ticket-on');el('rr-ticket').hidden=true;
    el('rr-placeholder').hidden=false;el('rr-print').disabled=true;
    el('rr-light').classList.remove('rr-active');el('rr-signal').textContent='STANDBY';
    el('rr-status').textContent='◇ Awaiting selection';render();
  }
  el('rr-pay').addEventListener('click',async()=>{
    if(busy||total()===0)return;
    reset();busy=true;render();el('rr-status').textContent='◌ Simulating confirmation…';el('rr-signal').textContent='RECEIVED';
    await new Promise(resolve=>setTimeout(resolve,1000));
    serial++;receipt();el('rr-ticket').hidden=false;el('rr-placeholder').hidden=true;
    void el('rr-ticket').offsetHeight;el('rr-ticket').classList.add('rr-ticket-on');
    el('rr-light').classList.add('rr-active');el('rr-signal').textContent='PAPER ISSUED';
    el('rr-status').textContent='✧ Sample printed to screen. No payment occurred.';
    el('rr-print').disabled=false;busy=false;render();
  });
  el('rr-print').addEventListener('click',()=>{if(!el('rr-ticket').hidden)window.print();});
  el('rr-reset').addEventListener('click',reset);
  render();
})();
</script>

<style is:global>
  .rr-lab{--rr-gold:var(--ember);--rr-ink:var(--obsidian);--rr-paper:var(--bone);max-width:1300px;margin:auto;color:var(--bone);padding:24px clamp(18px,4.5vw,65px) 85px;}
  .rr-lab button{cursor:pointer;font:inherit}.rr-lab button:disabled{opacity:.4;cursor:default}.rr-lab [hidden]{display:none!important}
  .rr-head{display:flex;align-items:center;gap:16px;padding-bottom:24px;border-bottom:1px solid var(--line-soft);font:10px var(--font-mono);letter-spacing:.08em;}
  .rr-logo{display:block;width:38px;height:38px}.rr-logo svg,.rr-logo img{max-width:100%;max-height:100%}
  .rr-wordmark{flex:1;font:23px var(--font-display);letter-spacing:.08em}.rr-wordmark span{font:10px var(--font-mono);color:var(--sand)}
  .rr-demo-flag{border:1px solid var(--bronze);padding:8px;color:var(--ember);white-space:nowrap}
  .rr-intro{padding:65px 0 45px}.rr-kicker{font:11px var(--font-mono);letter-spacing:.16em;color:var(--ember)}
  .rr-intro h1{font:normal clamp(44px,6vw,84px)/1 var(--font-display);letter-spacing:-.035em;margin:16px 0 20px}.rr-intro em{color:var(--ember);font-style:italic}
  .rr-intro>p:last-child{max-width:560px;color:var(--silver);line-height:1.75}
  .rr-cols{display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:start}
  .rr-panel,.rr-output{padding:clamp(18px,3vw,35px);border:1px solid var(--line-soft);background:var(--charcoal)}
  .rr-output{background:radial-gradient(ellipse at 50% 22%,var(--ash),var(--obsidian) 75%);min-height:560px;overflow:hidden}
  .rr-heading{display:flex;justify-content:space-between;color:var(--ember);font:10px var(--font-mono);letter-spacing:.12em;margin-bottom:20px}
  .rr-panel h2{font:normal 34px var(--font-display);margin:0 0 15px}
  .rr-piece{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:17px 0;border-bottom:1px solid var(--line-soft)}
  .rr-piece-name{display:grid;gap:6px}.rr-piece-name strong{font-weight:400;font-size:14px}.rr-piece-name small{font:10px var(--font-mono);color:var(--sand)}
  .rr-qty{display:flex;align-items:center;gap:10px}.rr-qty button{background:transparent;border:1px solid var(--bronze);color:var(--bone);height:28px;width:28px}.rr-qty output{min-width:12px;text-align:center;font:12px var(--font-mono)}
  .rr-total{display:flex;justify-content:space-between;align-items:center;padding:26px 0 7px}.rr-total span{font-size:12px;color:var(--silver)}.rr-total strong{font:normal 26px var(--font-display)}
  .rr-note,.rr-safety{color:var(--sand);font:10px/1.7 var(--font-mono)}.rr-methods{padding:20px 0;border:0;margin:12px 0}.rr-methods legend{font:10px var(--font-mono);letter-spacing:.12em;color:var(--sand);padding:0 0 6px}
  .rr-methods label{display:inline-flex;align-items:center;margin-right:14px;gap:5px;font-size:13px}.rr-methods input{accent-color:var(--ember)}
  .rr-primary{background:var(--ember);color:var(--obsidian);border:0;width:100%;padding:17px 9px;font:11px var(--font-mono)!important;letter-spacing:.08em;text-transform:uppercase}
  .rr-status{font:11px var(--font-mono);color:var(--ember);margin-top:18px}.rr-printer{max-width:370px;margin:54px auto 0;background:linear-gradient(155deg,#29251e,#141310);border:1px solid #5a4a2c;padding:20px;border-radius:10px 10px 4px 4px;box-shadow:0 25px 55px #0009}
  .rr-printer-label{display:flex;justify-content:space-between;color:var(--silver);font:10px var(--font-mono);letter-spacing:.05em}.rr-printer-label span{color:var(--bronze)}.rr-printer-label span.rr-active{color:var(--ember);text-shadow:0 0 14px var(--ember)}
  .rr-slot{height:12px;margin-top:18px;border:1px solid #534a39;border-radius:5px;background:#030303;box-shadow:inset 0 4px 8px #000}.rr-printer-foot{display:flex;justify-content:space-between;font:9px var(--font-mono);color:var(--sand);margin-top:13px}
  .rr-tray{display:flex;justify-content:center;min-height:145px}.rr-tray>p{padding:50px 0 0;font:10px/2 var(--font-mono);color:var(--sand);text-align:center}
  .rr-ticket{width:min(310px,92%);padding:22px 19px 26px;background:#f5f1e7;color:#14120f;box-shadow:0 15px 45px #0009;text-align:center;white-space:normal;opacity:0;transform:translateY(-40px) scaleY(.15);transform-origin:top;transition:transform 1s cubic-bezier(.23,.82,.2,1),opacity .3s}
  .rr-ticket.rr-ticket-on{transform:none;opacity:1}
  .rr-ticket-mark{font:42px var(--font-serif)}.rr-ticket-brand{font:28px var(--font-display);letter-spacing:.14em}.rr-ticket-label,.rr-ticket-date,.rr-ticket-small,.rr-ticket-legal{font:9px/1.6 var(--font-mono)}.rr-ticket-ref{font:13px var(--font-mono);margin:4px}
  .rr-ticket-separator{font:10px var(--font-mono);margin:15px 0 9px}.rr-ticket-row{text-align:left;font:10px/1.65 var(--font-mono);margin:8px 0}
  .rr-ticket-total{margin:15px 0;font:bold 16px var(--font-mono)}.rr-ticket-small{color:#4b473e}.rr-ticket-ritual{font:italic 17px/1.3 var(--font-serif);white-space:pre-line;margin:22px 0 10px}
  .rr-ticket-link{display:block;color:#28221b;font:9px var(--font-mono);text-decoration:underline}.rr-ticket-legal{border:1px dashed #928a7b;margin-top:14px;padding:6px}
  .rr-actions{max-width:370px;display:flex;gap:8px;margin:25px auto 0}.rr-actions button{flex:1;border:1px solid var(--bronze);background:var(--ash);color:var(--bone);padding:13px;font:10px var(--font-mono)}
  .rr-bottom{border-top:1px solid var(--line-soft);padding:23px 0;margin-top:40px;color:var(--sand);font:10px var(--font-mono);display:flex;justify-content:space-between;gap:15px}
  @media(max-width:880px){.rr-cols{grid-template-columns:1fr}.rr-intro{padding:45px 0 30px}.rr-output{min-height:500px}}
  @media(max-width:490px){.rr-head{gap:9px}.rr-logo{width:29px;height:29px}.rr-wordmark{font-size:19px}.rr-wordmark span{display:none}.rr-demo-flag{font-size:8px;padding:6px}.rr-lab{padding-left:14px;padding-right:14px}.rr-bottom{display:block}.rr-bottom span{display:block;margin-top:10px}}
  @media(prefers-reduced-motion:reduce){.rr-ticket{transition:none!important}}
  @page{size:80mm auto;margin:0}
  @media print{
    html,body{margin:0!important;padding:0!important;width:80mm!important;background:white!important}
    body *{visibility:hidden!important}
    .rr-ticket,.rr-ticket *{visibility:visible!important}
    .rr-ticket{position:absolute!important;top:0!important;left:2mm!important;transform:none!important;opacity:1!important;box-shadow:none!important;width:76mm!important;margin:0!important;padding:5mm!important}
  }
</style>
