---
import Base from '../layouts/Base.astro';

const formEndpoint = 'https://formspree.io/f/mblrgwya';

const pageTitle = 'Feedback — Wenu Mapu';
const pageDescription = 'Share what you think of your piece, your ritual, or anything we can do better. Every message is read by hand.';
---
<Base title={pageTitle} description={pageDescription}>
  <section class="feedback">
    <div class="container feedback__head">
      <p class="eyebrow">Share · listen · refine</p>
      <h1 class="feedback__title">Tell us what worked. Tell us what didn't.</h1>
      <p class="feedback__lede">
        Every piece leaves a small trail when it arrives. We want to hear about yours — what surprised you,
        what fit, what didn't, what we should do differently. Each message is read by hand, by the maker.
        No bots, no triage queue.
      </p>
    </div>

    <form
      class="feedback__form"
      method="POST"
      action={formEndpoint}
      autocomplete="on"
      novalidate
    >
      <input type="hidden" name="_subject" value="Wenu Mapu — feedback" />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" />

      <fieldset class="feedback__fields">
        <label class="feedback__label" for="fb-name">
          Your name <span aria-hidden="true">·</span> <small>optional</small>
        </label>
        <input
          id="fb-name"
          class="feedback__input"
          type="text"
          name="name"
          placeholder="What we may call you"
        />

        <label class="feedback__label" for="fb-email">
          Email <span aria-hidden="true">·</span> <small>if you'd like a reply</small>
        </label>
        <input
          id="fb-email"
          class="feedback__input"
          type="email"
          name="email"
          placeholder="you@example.com"
        />

        <label class="feedback__label" for="fb-topic">
          What's this about?
        </label>
        <select id="fb-topic" class="feedback__input" name="topic" required>
          <option value="">Choose…</option>
          <option value="piece-experience">A piece I received</option>
          <option value="aftercare">My piercing or healing</option>
          <option value="site-bug">A glitch on the site</option>
          <option value="idea-suggestion">An idea or suggestion</option>
          <option value="press-collab">Press, collab, or interview</option>
          <option value="other">Something else</option>
        </select>

        <label class="feedback__label" for="fb-message">
          Your message
        </label>
        <textarea
          id="fb-message"
          class="feedback__input feedback__textarea"
          name="message"
          rows="7"
          required
          placeholder="The good, the off, the in-between. Take the space you need."
        ></textarea>

        <p class="feedback__note">
          By sending, you agree we may read, reply, and quote anonymously in our journal.
          Nothing is shared without your name attached unless you ask for it.
        </p>

        <button type="submit" class="btn btn--solid feedback__submit">
          Send the message →
        </button>
      </fieldset>
    </form>

    <aside class="feedback__altchan">
      <p class="eyebrow">Other ways to reach us</p>
      <ul class="feedback__altchan-list">
        <li>
          <a href="mailto:marimari@wenumapuonline.com">marimari@wenumapuonline.com</a>
        </li>
        <li>
          <a href="https://wa.me/message/UKOICGSNP332H1" target="_blank" rel="noopener noreferrer">
            WhatsApp · message Nicolás directly
          </a>
        </li>
        <li>
          <a href="https://www.instagram.com/wenu__mapu" target="_blank" rel="noopener noreferrer">
            Instagram · @wenu__mapu
          </a>
        </li>
      </ul>
    </aside>
  </section>
</Base>

<style>
  .feedback {
    padding: clamp(72px, 9vw, 128px) 0;
    background: var(--obsidian);
    color: var(--bone);
  }
  .feedback__head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
  }
  .feedback__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    line-height: 1.05;
    margin: 0.6rem 0 1.4rem;
  }
  .feedback__lede {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--sand);
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    line-height: 1.6;
    max-width: 620px;
    margin: 0 auto;
  }
  .feedback__form {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .feedback__fields {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .feedback__label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--sand);
    margin-top: 1.5rem;
  }
  .feedback__label small {
    text-transform: none;
    letter-spacing: 0.04em;
    color: var(--silver);
    font-size: 0.7rem;
  }
  .feedback__input {
    background: rgba(232, 193, 127, 0.02);
    border: 1px solid rgba(168, 163, 154, 0.22);
    color: var(--bone);
    padding: 0.85rem 1rem;
    font-family: var(--font-serif);
    font-size: 1rem;
    border-radius: 4px;
    transition: border-color 0.3s ease, background 0.3s ease;
    width: 100%;
  }
  .feedback__input:focus {
    outline: none;
    border-color: var(--ember);
    background: rgba(232, 193, 127, 0.05);
  }
  .feedback__textarea {
    font-family: var(--font-serif);
    resize: vertical;
    min-height: 140px;
  }
  .feedback__note {
    font-size: 0.78rem;
    color: var(--silver);
    font-style: italic;
    margin-top: 1.6rem;
    line-height: 1.5;
  }
  .feedback__submit {
    margin-top: 1.5rem;
    align-self: flex-start;
  }
  .feedback__altchan {
    max-width: 640px;
    margin: clamp(3rem, 5vw, 4.5rem) auto 0;
    padding: 0 24px;
    text-align: center;
  }
  .feedback__altchan-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .feedback__altchan-list a {
    color: var(--bone);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    text-decoration: none;
    border-bottom: 1px solid rgba(168, 163, 154, 0.2);
    padding-bottom: 2px;
  }
  .feedback__altchan-list a:hover {
    color: var(--ember);
    border-color: var(--ember);
  }
</style>
