---
import Base from '../../layouts/Base.astro';
import PatternBand from '../../components/PatternBand.astro';
import { collections } from '../../data/collections';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wenumapuonline.com/' },
    { '@type': 'ListItem', position: 2, name: 'Collections', item: 'https://wenumapuonline.com/collections' },
  ],
};
---
<Base
  title="Collections — the archive by world | Wenu Mapu"
  description="The Wenu Mapu collections — Origin, Atacama, Araucanía, Solar, Neo, Ornamental, Organic, Fossil and more. Ritual body jewelry curated by world, atmosphere and lineage."
  jsonLd={[breadcrumbLd]}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">The archive · by world</p>
      <h1 class="page-title">Collections</h1>
      <p class="lede" style="max-width: 60ch;">Browse by world, atmosphere and lineage — when you want to enter through feeling, not category. Each collection gathers the pieces that share a sky.</p>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>

      <ul class="colls">
        {collections.map(c => (
          <li class="colls__item">
            <a href={`/collection/${c.slug}`} class="colls__link" aria-label={`${c.title} collection`}>
              <div class="colls__media">
                <picture>
                  <source type="image/avif" srcset={`/img/banners/collection/${c.slug}.avif`} />
                  <img src={`/img/banners/collection/${c.slug}.webp`} alt={`Wenu Mapu — ${c.title} collection`} width="800" height="450" loading="lazy" decoding="async" />
                </picture>
                <span class="colls__veil" aria-hidden="true"></span>
                <span class="colls__label">
                  <span class="colls__eyebrow">{c.eyebrow}</span>
                  <span class="colls__title">{c.title}</span>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .colls {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-4);
  }
  .colls__link {
    display: block;
    text-decoration: none;
    color: inherit;
    border: var(--border-thin);
    transition: border-color var(--t-base), transform var(--t-base);
  }
  .colls__link:hover, .colls__link:focus-visible {
    border-color: var(--ember);
    transform: translateY(-2px);
    outline: none;
  }
  .colls__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--obsidian);
  }
  .colls__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.04);
    transition: transform var(--t-slow);
  }
  .colls__link:hover .colls__media img { transform: scale(1.04); }
  .colls__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--scrim-0) 35%, var(--scrim-strong) 100%);
  }
  .colls__label {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    right: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 1;
  }
  .colls__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    letter-spacing: var(--letter-spacing-ritual);
    text-transform: uppercase;
    color: var(--ember);
  }
  .colls__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    line-height: 1.05;
    color: var(--bone);
    text-shadow: 0 2px 18px var(--scrim-strong);
  }
</style>
