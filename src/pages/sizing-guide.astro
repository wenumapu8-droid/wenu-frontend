---
import Base from '../layouts/Base.astro';
import en from '../i18n/en.json';

const s = en.sizing;
---
<Base
  title="Sizing Guide — Wenu Mapu"
  description="Body jewelry sizing reference: gauge to millimeters, inner diameter recommendations, post and barbell length conventions."
>
  <section class="section section--mega">
    <div class="container sizing">
      <p class="eyebrow">{s.eyebrow}</p>
      <h1 class="page-title">{s.title}</h1>
      <p class="lede">{s.intro}</p>

      <h2 class="sizing__heading">{s.gauge_heading}</h2>
      <div class="sizing__table-wrap">
        <table class="sizing__table">
          <thead>
            <tr>
              <th>Gauge</th>
              <th>Millimeters</th>
              <th>Common use</th>
            </tr>
          </thead>
          <tbody>
            {s.gauge_table.map(row => (
              <tr>
                <td><strong>{row.g}</strong></td>
                <td>{row.mm}</td>
                <td>{row.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="sizing__heading">{s.diameter_heading}</h2>
      <p>{s.diameter_intro}</p>

      <h2 class="sizing__heading">{s.post_heading}</h2>
      <p>{s.post_intro}</p>

      <p class="sizing__note">{s.note}</p>
    </div>
  </section>
</Base>
