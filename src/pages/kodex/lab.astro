---
import Base from '../../layouts/Base.astro';
import KodexThresholdPortalScene from '../../components/kodex/scenes/KodexThresholdPortalScene.astro';
---

<Base
  title="KODEX Lab — Threshold Portal"
  description="Private KODEX shader lab for THRESHOLD PORTAL validation."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div class="kdx-lab-shell">
    <KodexThresholdPortalScene />

    <aside class="kdx-lab-meta">
      <a href="/kodex/">← volver a /kodex/</a>
      <strong>KODEX LAB / THRESHOLD PORTAL</strong>
      <ul>
        <li>Shader pipeline: source → feedback → composite (3-pass WebGL2).</li>
        <li>Estados: DORMANT → AWARE → OPEN con morph UV y breathing.</li>
        <li>Motion modes: live / paused / reduced / low-power.</li>
        <li><a href="/kodex/lab/observe-v2/">Lab OBSERVE V2 →</a></li>
        <li><a href="/kodex/lab/crystal-receiver/">Lab CRYSTAL RECEIVER →</a></li>
        <li><a href="/kodex/lab/crystal-receiver/phase-shift/">Lab PHASE SHIFT ENGINE →</a></li>
      </ul>
      <p>Tip: usá los controles a la derecha para debug.</p>
    </aside>
  </div>

  <style>
    .kdx-lab-shell {
      position: relative;
      min-height: 100vh;
      background: #050409;
    }

    .kdx-lab-meta {
      position: fixed;
      left: 18px;
      bottom: 88px;
      z-index: 20;
      width: min(320px, calc(100vw - 36px));
      padding: 12px 14px;
      border: 1px solid rgba(196, 176, 255, 0.24);
      background: rgba(5, 4, 9, 0.78);
      color: #d7d0e7;
      font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      backdrop-filter: blur(8px);
    }

    .kdx-lab-meta a,
    .kdx-lab-meta code {
      color: #b59aff;
    }

    .kdx-lab-meta strong {
      display: block;
      margin-top: 8px;
      letter-spacing: 0.14em;
    }

    .kdx-lab-meta ul {
      margin: 10px 0 0;
      padding-left: 16px;
    }

    .kdx-lab-meta p {
      margin: 10px 0 0;
      color: #a7a0b7;
    }

    @media (max-width: 760px) {
      .kdx-lab-meta {
        top: auto;
        bottom: 76px;
        font-size: 11px;
      }
    }
  </style>
</Base>
