---
import Base from '../../../layouts/Base.astro';
import { getKodexNodes, type KodexNode } from '../../../lib/kodex/nodes';

export function getStaticPaths() {
  const nodes = getKodexNodes();
  return nodes.map((node) => ({
    params: { slug: node.slug },
    props: { node },
  }));
}

interface Props {
  node: KodexNode;
}

const { node } = Astro.props;

const claimClass = node.epistemic?.claimClass || 'UNKNOWN';
const culturalStatus = node.epistemic?.culturalStatus || 'STANDARD';
const domains = node.epistemic?.domains || [];
const claims = node.epistemic?.claims || [];
const limitations = node.epistemic?.limitations || [];
const relationships = node.relationships || [];
const symbols = node.symbols || [];
const sources = node.sources || [];
const pending = node.pending || [];
---

<Base
  title={`${node.title} — KODEX Node Specimen`}
  description={node.summary || `KODEX node specification for ${node.title}`}
  noNav={true}
  noFooter={true}
  noOverlays={true}
  noCart={true}
  noKai={true}
  noImmersive={true}
  noThemes={true}
  kodexFonts={true}
>
  <div class="kdx-node-page" data-kdx-node={node.id}>
    <!-- Top Bar Navigation -->
    <header class="kdx-node__nav">
      <a href="/kodex/" class="kdx-node__back">← KODEX INDEX</a>
      <div class="kdx-node__meta-pills">
        <span class="kdx-pill kdx-pill--accent">{node.accent || 'gold'}</span>
        <span class="kdx-pill">{node.mode || 'dark-archive'}</span>
        <span class="kdx-pill kdx-pill--status">{node.status}</span>
      </div>
    </header>

    <!-- Main Container -->
    <main class="kdx-node__content">
      <!-- Title Header Section -->
      <section class="kdx-node__hero">
        <div class="kdx-node__id-tag">{node.id}</div>
        <h1 class="kdx-node__title">{node.title}</h1>
        {node.subtitle && <p class="kdx-node__subtitle">{node.subtitle}</p>}
        {node.summary && <p class="kdx-node__summary">{node.summary}</p>}
      </section>

      <!-- Proposition Section -->
      {node.proposition && (
        <section class="kdx-node__section kdx-node__section--prop">
          <h2 class="kdx-node__section-title">PROPOSITION</h2>
          <div class="kdx-node__proposition">{node.proposition}</div>
        </section>
      )}

      <!-- Visual Anchor Section -->
      {node.visualAnchor && (
        <section class="kdx-node__section">
          <h2 class="kdx-node__section-title">VISUAL ANCHOR</h2>
          <div class="kdx-node__card">
            <div class="kdx-node__card-row">
              <span class="kdx-node__card-label">Kind:</span>
              <span>{node.visualAnchor.kind}</span>
            </div>
            <div class="kdx-node__card-row">
              <span class="kdx-node__card-label">Label:</span>
              <span>{node.visualAnchor.label || '(pending authoring)'}</span>
            </div>
            {node.visualAnchor.role && (
              <div class="kdx-node__card-row">
                <span class="kdx-node__card-label">Role:</span>
                <span>{node.visualAnchor.role}</span>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- Epistemic Layer Section -->
      <section class="kdx-node__section kdx-node__section--epistemic">
        <h2 class="kdx-node__section-title">EPISTEMIC LAYER</h2>
        <div class="kdx-node__grid kdx-node__grid--2">
          <div class="kdx-node__card">
            <div class="kdx-node__card-row">
              <span class="kdx-node__card-label">Claim Class:</span>
              <span class={`kdx-badge kdx-badge--claim-${claimClass.toLowerCase()}`}>{claimClass}</span>
            </div>
            <div class="kdx-node__card-row">
              <span class="kdx-node__card-label">Cultural Status:</span>
              <span class="kdx-badge">{culturalStatus}</span>
            </div>
            {domains.length > 0 && (
              <div class="kdx-node__card-row">
                <span class="kdx-node__card-label">Domains:</span>
                <span>{domains.join(', ')}</span>
              </div>
            )}
          </div>

          <div class="kdx-node__card">
            <h3 class="kdx-node__subheading">Claims & Limitations</h3>
            {claims.length > 0 ? (
              <ul class="kdx-node__list">
                {claims.map((c) => <li>{c}</li>)}
              </ul>
            ) : (
              <p class="kdx-node__dim">No active claims asserted.</p>
            )}
            {limitations.length > 0 && (
              <div class="kdx-node__limitations">
                <h4>Boundaries & Limitations:</h4>
                <ul class="kdx-node__list">
                  {limitations.map((l) => <li>{l}</li>)}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>

      <!-- Relationships Section with Validity Badges -->
      <section class="kdx-node__section">
        <h2 class="kdx-node__section-title">RELATIONSHIPS</h2>
        {relationships.length > 0 ? (
          <div class="kdx-node__rel-grid">
            {relationships.map((rel) => (
              <div class="kdx-node__rel-card">
                <div class="kdx-node__rel-header">
                  <span class="kdx-node__rel-type">{rel.type}</span>
                  <span class={`kdx-validity kdx-validity--${rel.validity.toLowerCase()}`}>{rel.validity}</span>
                </div>
                <div class="kdx-node__rel-target">{rel.label}</div>
                {rel.descriptor && <p class="kdx-node__rel-desc">{rel.descriptor}</p>}
              </div>
            ))}
          </div>
        ) : (
          <p class="kdx-node__dim">No explicit relationships recorded.</p>
        )}
      </section>

      <!-- Symbols & Sources Grid -->
      <div class="kdx-node__grid kdx-node__grid--2">
        {symbols.length > 0 && (
          <section class="kdx-node__section">
            <h2 class="kdx-node__section-title">SYMBOLS</h2>
            <div class="kdx-node__tags">
              {symbols.map((sym) => <span class="kdx-tag">{sym}</span>)}
            </div>
          </section>
        )}

        {sources.length > 0 && (
          <section class="kdx-node__section">
            <h2 class="kdx-node__section-title">SOURCES</h2>
            <ul class="kdx-node__list">
              {sources.map((src) => <li>{src}</li>)}
            </ul>
          </section>
        )}
      </div>

      <!-- Pending Authoring & Version Footer -->
      <footer class="kdx-node__footer">
        {pending.length > 0 && (
          <div class="kdx-node__pending-box">
            <strong>PENDING AUTHORING:</strong> {pending.join(' · ')}
          </div>
        )}
        <div class="kdx-node__checksum-bar">
          <span>VERSION: {node.version || '0.1.0'}</span>
          <span>CHECKSUM: {node.checksum || 'N/A'}</span>
          <span>ATLAS STATUS: {node.atlasStatus || 'CANON_CANDIDATE'}</span>
        </div>
      </footer>
    </main>
  </div>
</Base>

<style>
  .kdx-node-page {
    min-height: 100vh;
    background: #08080a;
    color: #e2e2e8;
    font-family: 'IBM Plex Mono', monospace;
    padding: 2rem 1.5rem 4rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .kdx-node__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #1a1a24;
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }

  .kdx-node__back {
    color: #ffd700;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .kdx-node__back:hover {
    text-decoration: underline;
  }

  .kdx-node__meta-pills {
    display: flex;
    gap: 0.5rem;
  }

  .kdx-pill {
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
    background: #14141d;
    border: 1px solid #282836;
    text-transform: uppercase;
    color: #a0a0b0;
  }

  .kdx-pill--accent {
    color: #ffd700;
    border-color: rgba(255, 215, 0, 0.3);
  }

  .kdx-node__hero {
    margin-bottom: 2.5rem;
  }

  .kdx-node__id-tag {
    font-size: 0.75rem;
    color: #666680;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .kdx-node__title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
    line-height: 1.1;
  }

  .kdx-node__subtitle {
    font-size: 1rem;
    color: #ffd700;
    margin: 0 0 1rem 0;
    letter-spacing: 0.05em;
  }

  .kdx-node__summary {
    font-family: 'Libre Baskerville', serif;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #b0b0c2;
    border-left: 2px solid #ffd700;
    padding-left: 1rem;
    margin: 1.5rem 0 0 0;
  }

  .kdx-node__section {
    margin-bottom: 2.5rem;
  }

  .kdx-node__section-title {
    font-family: 'Oxanium', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: #666680;
    border-bottom: 1px solid #1a1a24;
    padding-bottom: 0.4rem;
    margin-bottom: 1rem;
  }

  .kdx-node__proposition {
    font-family: 'Libre Baskerville', serif;
    font-size: 1.1rem;
    line-height: 1.7;
    background: #0d0d14;
    border: 1px solid #1f1f2e;
    padding: 1.25rem;
    border-radius: 4px;
    color: #d8d8e6;
  }

  .kdx-node__grid {
    display: grid;
    gap: 1.5rem;
  }

  .kdx-node__grid--2 {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .kdx-node__card {
    background: #0c0c12;
    border: 1px solid #1a1a26;
    padding: 1.25rem;
    border-radius: 4px;
  }

  .kdx-node__card-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0;
    border-bottom: 1px dashed #161622;
    font-size: 0.85rem;
  }

  .kdx-node__card-row:last-child {
    border-bottom: none;
  }

  .kdx-node__card-label {
    color: #707088;
  }

  .kdx-badge {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
    background: #181824;
    color: #4da6ff;
    border: 1px solid rgba(77, 166, 255, 0.3);
  }

  .kdx-badge--claim-unknown {
    color: #a0a0b0;
    border-color: #333344;
  }

  .kdx-node__subheading {
    font-size: 0.9rem;
    color: #e2e2e8;
    margin: 0 0 0.75rem 0;
  }

  .kdx-node__list {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.85rem;
    color: #a0a0b8;
    line-height: 1.5;
  }

  .kdx-node__rel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .kdx-node__rel-card {
    background: #0a0a10;
    border: 1px solid #1e1e2c;
    padding: 1rem;
    border-radius: 4px;
  }

  .kdx-node__rel-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    margin-bottom: 0.5rem;
  }

  .kdx-node__rel-type {
    color: #ffd700;
  }

  .kdx-validity {
    padding: 0.1rem 0.4rem;
    border-radius: 2px;
    font-size: 0.65rem;
  }

  .kdx-validity--canonical {
    background: rgba(0, 230, 153, 0.15);
    color: #00e699;
    border: 1px solid rgba(0, 230, 153, 0.3);
  }

  .kdx-validity--valid {
    background: rgba(77, 166, 255, 0.15);
    color: #4da6ff;
    border: 1px solid rgba(77, 166, 255, 0.3);
  }

  .kdx-validity--hypothesis {
    background: rgba(255, 179, 0, 0.15);
    color: #ffb300;
    border: 1px solid rgba(255, 179, 0, 0.3);
  }

  .kdx-validity--needs_cultural_review {
    background: rgba(255, 77, 77, 0.15);
    color: #ff4d4d;
    border: 1px solid rgba(255, 77, 77, 0.3);
  }

  .kdx-node__rel-target {
    font-weight: 600;
    font-size: 0.9rem;
    color: #ffffff;
    margin-bottom: 0.4rem;
  }

  .kdx-node__rel-desc {
    font-size: 0.8rem;
    color: #88889e;
    margin: 0;
  }

  .kdx-node__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .kdx-tag {
    font-size: 0.75rem;
    background: #12121c;
    border: 1px solid #222233;
    padding: 0.25rem 0.6rem;
    border-radius: 3px;
    color: #c0c0d4;
  }

  .kdx-node__dim {
    font-size: 0.85rem;
    color: #555566;
    font-style: italic;
  }

  .kdx-node__footer {
    border-top: 1px solid #1a1a24;
    padding-top: 1.5rem;
    margin-top: 3rem;
  }

  .kdx-node__pending-box {
    background: rgba(255, 179, 0, 0.08);
    border: 1px solid rgba(255, 179, 0, 0.25);
    color: #ffb300;
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  .kdx-node__checksum-bar {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: #555566;
  }
</style>
