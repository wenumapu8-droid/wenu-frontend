---
// KODEX−∞ — THE COVER of the digital book (2026-07-25, owner request:
// "dividir la landing en páginas de un libro digital").
// The former monolith landing was split into 6 folios, each its own
// presentation: /kodex/folio/i..vi (src/pages/kodex/folio/[folio].astro).
// Shared pieces: src/lib/kodexBook.js (data) · src/styles/kodex.css (styles)
// · src/scripts/kodex-engine.js (engines) · KodexChrome/KodexOverlays.astro.
// NOTE for the world-session: /kodex/world is untouched; nothing here imports
// src/lib/kodex.js or src/kodex/**. Rule: the art is shown WHOLE, never
// cropped; all effects live in the frame/HUD, never on the work itself.
import Base from '../../layouts/Base.astro';
import KodexChrome from '../../components/KodexChrome.astro';
import KodexOverlays from '../../components/KodexOverlays.astro';
import '../../styles/kodex.css';
import { hero, portals, portalSigil, folios } from '../../lib/kodexBook.js';
---

<Base
  title="KODEX−∞ — Arquitecturas Tecno-Tribales"
  description="A living archive of pattern, memory, code and resonance inside the world of Wenu Mapu. A digital book: descend folio by folio."
  robots="noindex, nofollow"
  ogImage="/img/kodex/works/work-01.jpg"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div class="kx kx--deck" data-kx data-next-label="OPEN · FOLIO I ›" data-next-url={`/kodex/folio/${folios[0].slug}/`}>
    <KodexChrome segs={7} />

    <div class="kx-deck" data-deck>

    <!-- PLATE 1 · UMBRAL / boot — the cover -->
    <section class="kx-slide"><div class="kx-slide__in">
    <section class="kx-umbral">
      <div class="kx-frame kx-frame--hero" data-spec>
        <span class="kx-bracket kx-bracket--tl"></span><span class="kx-bracket kx-bracket--tr"></span>
        <span class="kx-bracket kx-bracket--bl"></span><span class="kx-bracket kx-bracket--br"></span>
        <span class="kx-scan"></span>
        <img src={hero.src} alt={`KODEX−∞ — ${hero.name}, complete work`} loading="eager" />
        <span class="kx-frame__tag">SPECIMEN 00 · {hero.name}</span>
      </div>
      <p class="kx-over" data-reveal>MOTHER SYSTEM · −∞ → 0 → +∞</p>
      <h1 class="kx-h1" data-reveal>KODEX<span style="color:var(--gray)">−∞</span></h1>
      <p class="kx-lede" data-reveal>
        Living archive of matter, symbol and technology.<br />
        A digital book in six folios. It descends before it rises — and when
        the whole codex has been seen, it turns to light.
      </p>
      <div class="kx-cta-row" data-reveal>
        <a class="kx-cta" href={`/kodex/folio/${folios[0].slug}/`}><span>OPEN THE CODEX → FOLIO I</span></a>
        <button class="kx-cta kx-cta--walk" type="button" data-gallery-open><span>◲ WALK THE GALLERY</span></button>
      </div>
      <p class="kx-cta-note" data-reveal>The archive does not begin at the surface. Click › and the book opens.</p>
      <span class="kx-descend-cue" aria-hidden="true">−∞ ›</span>
    </section>
    </div></section>

    <!-- PLATE 2 · ÍNDICE — the ring of folio-doors -->
    <section class="kx-slide"><div class="kx-slide__in">
    <section class="kx-index" id="index">
      <div class="kx-movement" data-reveal>
        <span class="kx-movement__n">INDEX · CONTENTS</span>
        <h2 class="kx-movement__t">The Codex</h2>
        <p class="kx-movement__d">Six folios. A descent and a return. Each page is its own presentation — read them in order, or choose a door.</p>
      </div>
      <nav class="kx-portals" data-reveal aria-label="folios">
        {portals.map((p) => (
          <a class="kx-portal" href={p.href} style={`left:${p.x}%; top:${p.y}%`}>
            <span class="kx-portal__ring"></span>
            <span class="kx-portal__glyph" set:html={portalSigil(p.seed, p.i)}></span>
            <span class="kx-portal__r">{p.r}</span>
            <span class="kx-portal__name">{p.name}</span>
          </a>
        ))}
        <span class="kx-portals__core" aria-hidden="true">
          <canvas class="kx-axis" data-axis width="150" height="150"></canvas>
          <span class="kx-portals__core-t">−∞<b>0</b>+∞</span>
        </span>
      </nav>
      <p class="kx-portals__hint" data-reveal data-glitch>A point that turns is a line without end. Choose a door — or descend in order.</p>
    </section>
    </div></section>

    <!-- PLATE 3 · annex doors + the key -->
    <section class="kx-slide"><div class="kx-slide__in">
    <footer class="kx-foot">
      <p class="kx-foot__punch" data-reveal>−∞ is not the end. It is the depth where form dissolves to remember what it was made of.</p>
      <div class="kx-doors" data-reveal>
        <a href="/kodex/archive/conjuncion/">ARCHIVE · CONJUNCIÓN</a>
        <span>·</span>
        <a href="/kodex/editions/">EDITIONS / COLLABORATIONS</a>
      </div>
      <p class="kx-foot__key" data-reveal>Some of this is written in a language only the SIGNAL can read.  <span>[ press S ]</span></p>
    </footer>
    </div></section>

    </div>

    <KodexOverlays gallery={true} />
  </div>

  <script>
    import { initKx } from '../../scripts/kodex-engine.js';
    initKx();
  </script>
</Base>
