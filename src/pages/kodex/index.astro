---
import Base from '../../layouts/Base.astro';
import KodexChrome from '../../components/KodexChrome.astro';
import KodexOverlays from '../../components/KodexOverlays.astro';
import '../../styles/kodex.css';
/* Sólo la capa de cromo: el umbral compone distinto y no firma el contrato de
   escena. Lo que sí comparte es la barra, la navegación y los blancos táctiles. */
import '../../styles/kodex-plate.css';
import '../../styles/kodex-instrumento.css';
import '../../styles/kodex-travesia.css';
import { plateId, KDX_PLATE_CONTRACT_VERSION } from '../../lib/kodex/plancha/plate-contract';
import '../../styles/kodex-motion.css';
import HiddenMessageBand from '../../components/kodex/motion/HiddenMessageBand.astro';
import ParticleField from '../../components/kodex/motion/ParticleField.astro';
import SpriteSignal from '../../components/kodex/motion/SpriteSignal.astro';
import KodexPortal from '../../components/kodex/portal/KodexPortal.astro';
import KodexTransition from '../../components/kodex/transition/KodexTransition.astro';
import TituloGlitch from '../../components/kodex/os/TituloGlitch.astro';
import CampoPortada from '../../components/kodex/os/CampoPortada.astro';
import KodexDebug from '../../components/kodex/debug/KodexDebug.astro';
import KodexQuietFrame from '../../components/kodex/interludes/KodexQuietFrame.astro';
/* El umbral registra el paso: es el primer evento del recorrido y el que
   RETURN lee para armar el espécimen. Ver KodexRecuerda.astro. */
import KodexRecuerda from '../../components/kodex/KodexRecuerda.astro';
/* El copy del umbral no se escribe acá: se lee de la definición de escena, que
   lo trae textual de la P0 Scene Bible. La compuerta de terminado exige "copy
   and visual behavior match the canon", y con el texto suelto en la plantilla
   eso no se puede verificar — se corrige tocando dos archivos y nadie se entera. */
import { THRESHOLD } from '../../lib/kodex/escenas/threshold';
import { quietFrames } from '../../lib/kodex/quietFrames';
import '../../styles/kodex-micrographics.css';
import '../../styles/kodex-quiet-frames.css';
import { hero } from '../../lib/kodexBook.js';
import { prologueObservationRecord } from '../../lib/kodexArchiveRecords.js';
import { SCENE_UNIVERSE } from '../../lib/kodexUniverse.js';
import { KODEX_MESSAGES } from '../../lib/kodex/motion-config.js';
import { motionVars, recipeFor, gridFor } from '../../lib/kodex/grammar';

// THRESHOLD toma el portal de marmol: su grilla dice "dream field, ambient
// scene", que es exactamente una puerta que todavia no se cruzo.
const thresholdRecipe = recipeFor('threshold');
const thresholdGrid = gridFor('threshold');
const thresholdMotion = motionVars('threshold');

const prologue = SCENE_UNIVERSE.prologue;

/* El único bloque de metadatos que queda en el margen. Es el panel NODE 00 de
   la pantalla de diseño (pend-11: STATE DORMANT · SIGNAL LATENT · ACCESS TYPE
   VOLUNTARY) — el resto del cromo de datos salió: el creador pidió que el
   umbral respire. */
const thresholdNodeRows = [
  ['NODE', 'KDX_00'],
  ['STATE', 'DORMANT'],
  ['SIGNAL', 'LATENT'],
  ['ACCESS', 'VOLUNTARY'],
];

const prologueMessages = KODEX_MESSAGES.prologue;

const prologueRows = [
  ['NODE', prologue.node],
  ['PROTOCOL', prologue.protocol],
  ['STATUS', prologueObservationRecord.status],
];
---

<Base
  title="KODEX−∞ — Living Visual-Computational Archive"
  description="A living archive of pattern, memory, code and resonance inside the world of Wenu Mapu. A digital book: descend folio by folio."
  robots="index, follow"
  ogImage={hero.src}
  kodexFonts={true}
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
  osShell={true}
>
  {/* EL GUARDIA DE LA PUERTA.
      Va EN LÍNEA y antes que todo lo demás porque tiene que ejecutarse
      mientras el documento se parsea: los módulos de Astro corren diferidos y
      para entonces el motor ya habría grabado la visita. La regla del creador
      es "sin memory mutation pasiva" — el archivo recuerda a quien entra, no a
      quien todavía está mirando la puerta.
      Y si el huésped ya cruzó en esta sesión, el velo no vuelve a pedirle
      permiso: volver atrás debe devolverlo donde estaba, no hacerle repetir la
      decisión que ya tomó. */}
  <script is:inline>
    (() => {
      let cruzado = false;
      try { cruzado = sessionStorage.getItem('kx-umbral') === 'cruzado'; } catch (_) {}
      if (cruzado) document.documentElement.setAttribute('data-kdx-umbral-cruzado', '');
      else document.documentElement.setAttribute('data-kdx-espera-eleccion', '');
    })();
  </script>

  <KodexRecuerda />
  <div
    class="kx kx--deck kx--threshold kx--entry"
    data-kx
    data-kdx-shell={KDX_PLATE_CONTRACT_VERSION}
    data-kdx-plate={plateId('threshold', 'interlude')}
    data-stage-idx="0"
    data-stage-base="0"
    data-stage-total="07"
    data-stage-name="THRESHOLD"
    data-stage-col="255,39,51"
    data-next-label="ENTER THE KODEX"
    data-next-url="/kodex/folio/i/"
    data-sync-deck-hash
    {/* La herramienta de esta lamina: la rueda gira el mandala. Cero scroll de
        pagina -- el documento no se mueve, la pieza si. */}
    data-kdx-tool="girar"
    data-kdx-recipe={thresholdRecipe.id}
    data-kdx-grid={thresholdGrid.id}
    style={thresholdMotion}
  >
    <KodexTransition router={true} />
    <KodexDebug />

    <KodexChrome segs={7} />

    <div class="kx-deck" data-deck>
      <section class="kx-slide kx-slide--threshold" id="threshold" aria-labelledby="kdx-threshold-title">
        <div class="kx-slide__in kx-threshold">
          {/* 2026-08-17 · Umbral respirado. La referencia es la pantalla de
              diseño del umbral (pend-11: 00/07 THRESHOLD · una obra central ·
              un titular · una pregunta · ENTER VOLUNTARILY) y el prototipo de
              portada aprobado por el creador (/tmp/kodex-threshold-live.html):
              campo rojo profundo atenuado, THRESHOLD en serif, HUD periférico
              casi invisible, una sola acción. El cromo de datos que había acá
              (rail, meta-zonas, chips, syslog, sysfoot, systemband, origin,
              waveform, panel de artefacto) salió: el diseño muestra UN panel
              de nodo en el margen y nada más compitiendo con la obra. */}

          <div class="kx-threshold__field" aria-hidden="true">
            <ParticleField class="kx-threshold__particles" scene="threshold" label="threshold particle field" />
            <span class="kx-threshold__aura"></span>
          </div>

          {/* El organismo. KodexPortal intacto: la obra ES la textura del
              shader; acá solo se ubica en el centro, como en el diseño. */}
          <div class="kx-threshold__organismo" data-kdx-threshold-parallax>
            <img
              class="kx-threshold__organismo-fallback"
              src="/img/kodex/works/mandala-0cin-negativo.png"
              alt=""
              loading="eager"
              decoding="async"
            />
            <KodexPortal
              artwork="/img/kodex/works/mandala-0cin-negativo.png"
              seed={0.382}
              label="THRESHOLD · portal vivo sobre la obra"
              class="kx-threshold__organismo-live"
            />
          </div>

          {/* Marcador de escena, arriba y al centro, como en el diseño:
              progreso siempre visible. */}
          <header class="kx-threshold__marcador" data-reveal>
            <p class="kx-threshold__progreso"><b>00</b> / 07</p>
            <p class="kx-threshold__escena">THRESHOLD · SCENE 00</p>
          </header>

          {/* La identidad sobre el organismo, con la jerarquía del prototipo
              aprobado: cejilla / marca en serif / decreto. El lema es canon
              (THE ARCHIVE DOES NOT STORE. IT REMEMBERS.) partido igual que en
              la portada del creador. */}
          <div class="kx-threshold__identidad">
            <p class="kx-threshold__cejilla" data-reveal>THE ARCHIVE DOES NOT STORE</p>
            <h1 class="kx-threshold__marca" id="kdx-threshold-title" data-reveal>KODEX−∞</h1>
            <p class="kx-threshold__decreto" data-reveal>IT&nbsp;&nbsp;<b>REMEMBERS</b></p>
          </div>

          {/* La voz del umbral. Copy canónico de la Scene Bible (líneas 19 y
              25) leído textual de la definición de escena: el pacto, la
              pregunta primaria, y UNA acción — ENTER VOLUNTARILY, que en la
              pantalla de diseño del umbral es literalmente la CTA. */}
          <main class="kx-threshold__voz">
            <p class="kx-threshold__pacto" data-reveal>{THRESHOLD.copy.agreement}</p>
            <p class="kx-threshold__pregunta" data-reveal>
              <span aria-hidden="true">↔</span> {THRESHOLD.copy.question} <span aria-hidden="true">↔</span>
            </p>
            <a class="kx-threshold__entrar" href="/kodex/folio/i/" data-kdx-cruzar data-reveal>
              {THRESHOLD.copy.invitation}
            </a>
          </main>

          {/* El panel de nodo: único cromo de datos del margen, casi
              invisible, como el HUD periférico del prototipo. */}
          <aside class="kx-threshold__nodo" aria-label="node status" data-reveal>
            {thresholdNodeRows.map(([label, value]) => (
              <p><span>{label}</span><b class={label === 'SIGNAL' ? 'is-latente' : undefined}>{value}</b></p>
            ))}
          </aside>

          {/* EL VELO — la portada que le encantó al creador. Cubre la escena
              con el campo respirando atenuado detrás; THRESHOLD en serif; una
              sola acción. Tocar en cualquier parte = entrar con sonido (la
              rama data-kdx-sonido="1" de la bifurcación canónica); el fantasma
              CONTINUE IN SILENCE es la otra rama. Al elegir, el velo se
              disuelve y revela la escena — no navega. */}
          <div class="kx-veil" data-kdx-veil>
            {/* LA PORTADA. El campo del prototipo que el creador aprobó, vivo detrás
                de la palabra: warp radial, mandala, dither Bayer, scanlines, croma y
                grano. Su shader, portado entero. */}
            <CampoPortada estado={0.15} class="kx-veil__campo" />
            <p class="kx-veil__cejilla">KODEX&nbsp;&nbsp;−∞</p>
            {/* La palabra de la puerta, con el eje partiéndose y volviendo.
        Ver src/components/kodex/os/TituloGlitch.astro: el texto real está en
        el HTML servido y se lee en el primer cuadro; el glitch corre encima y
        no retrasa ni la lectura ni la acción. */}
    <TituloGlitch texto="THRESHOLD" como="p" class="kx-veil__marca" tempo="umbral" />
            <button class="kx-veil__entrar" type="button" data-kdx-sonido="1">TAP TO ENTER — ENABLE SOUND</button>
            <button class="kx-veil__silencio" type="button" data-kdx-sonido="0">CONTINUE IN SILENCE →</button>
          </div>
        </div>
      </section>

      <section class="kx-slide kx-slide--quiet" id="quiet-threshold-slide" aria-labelledby="quiet-threshold-label">
        <KodexQuietFrame {...quietFrames["threshold-prologue"]} id="quiet-threshold" />
      </section>

      <section class="kx-slide kx-slide--prologue kx-os-scene kx-os-scene--prologue" id="prologue" aria-labelledby="kdx-prologue-title">
        <div class="kx-slide__in kx-prologue-stage">
          <div class="kx-prologue-stage__scan" aria-hidden="true"></div>
          <div class="kx-prologue-stage__ambient" aria-hidden="true"></div>
          <ParticleField class="kx-prologue-stage__particles" scene="prologue" label="prologue particle field" />
          <aside class="kx-prologue-stage__rail" data-reveal aria-label="prologue status">
            <span>{prologue.code}</span>
            <span>{prologueObservationRecord.status}</span>
          </aside>

          <main class="kx-prologue-stage__body">
            <p class="kx-prologue-stage__kicker" data-reveal>{prologue.kicker}</p>
            <h2 class="kx-prologue-stage__title" id="kdx-prologue-title" data-reveal>
              <span>THE ARCHIVE</span>
              <span>IS WATCHING.</span>
            </h2>
            <p class="kx-prologue-stage__statement" data-reveal>YOU ARE NOT ALONE.</p>
            <p class="kx-prologue-stage__mantra" data-reveal>A SIGNAL.<br />A SYSTEM.<br />A CHOICE.</p>
            <div class="kx-prologue-stage__actions" data-reveal>
              <a class="kx-prologue-stage__cta" href="/kodex/folio/ii/">{prologue.cta}</a>
              <button class="kx-prologue-stage__protocol-trigger" type="button" data-kdx-protocol-open aria-expanded="false" aria-controls="kdx-protocol-panel">READ THE PROTOCOL</button>
            </div>
            <dl class="kx-prologue-stage__meta" data-reveal>
              {prologueRows.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </main>

          <figure class="kx-prologue-stage__visual" data-reveal>
            <div class="kx-prologue-stage__eye-field" data-kdx-prologue-eye aria-hidden="true">
              <span class="kx-prologue-stage__dust"></span>
              <span class="kx-prologue-stage__pulse"></span>
              <svg class="kx-prologue-stage__orbit kx-prologue-stage__orbit--outer" viewBox="0 0 520 520" focusable="false">
                <circle cx="260" cy="260" r="212"></circle>
                <ellipse cx="260" cy="260" rx="238" ry="144"></ellipse>
                <ellipse cx="260" cy="260" rx="176" ry="236" transform="rotate(-28 260 260)"></ellipse>
                <path d="M84 260C120 160 198 86 260 86C338 86 414 152 448 260"></path>
              </svg>
              <svg class="kx-prologue-stage__orbit kx-prologue-stage__orbit--inner" viewBox="0 0 520 520" focusable="false">
                <circle cx="260" cy="260" r="164"></circle>
                <ellipse cx="260" cy="260" rx="198" ry="118" transform="rotate(14 260 260)"></ellipse>
                <path d="M112 214C154 186 212 170 260 170C318 170 372 188 408 220"></path>
                <path d="M118 308C164 340 214 354 260 354C314 354 366 338 406 302"></path>
              </svg>
              <svg class="kx-prologue-stage__reticle" viewBox="0 0 520 520" focusable="false">
                <path d="M260 52V132M260 388V468M52 260H132M388 260H468"></path>
                <path d="M132 132L176 176M344 344L388 388M388 132L344 176M176 344L132 388"></path>
                <circle cx="260" cy="260" r="94"></circle>
              </svg>
              <svg class="kx-prologue-stage__wave" viewBox="0 0 520 520" focusable="false">
                <path d="M74 266C104 250 124 228 150 228C184 228 192 292 228 292C254 292 262 230 292 230C324 230 334 310 374 310C402 310 420 286 446 270"></path>
              </svg>
              <div class="kx-prologue-stage__eye-art">
                <svg class="kx-prologue-stage__eye-shell" viewBox="0 0 520 520" focusable="false">
                  <path d="M54 260C106 170 186 110 260 110C334 110 414 170 466 260C414 350 334 410 260 410C186 410 106 350 54 260Z"></path>
                  <path d="M112 260C150 202 202 168 260 168C318 168 370 202 408 260C370 318 318 352 260 352C202 352 150 318 112 260Z"></path>
                </svg>
                <svg class="kx-prologue-stage__eye-iris" viewBox="0 0 520 520" focusable="false">
                  <circle cx="260" cy="260" r="82"></circle>
                  <circle cx="260" cy="260" r="54"></circle>
                  <path d="M260 178C304 178 342 216 342 260C342 304 304 342 260 342C216 342 178 304 178 260C178 216 216 178 260 178Z"></path>
                </svg>
                <div class="kx-prologue-stage__pupil-anchor">
                  <span class="kx-prologue-stage__pupil"></span>
                  <span class="kx-prologue-stage__pupil-glint"></span>
                </div>
                <SpriteSignal
                  class="kx-prologue-stage__sprite-signal"
                  scene="prologue"
                  sprite="/assets/kodex/sprites/observation-eye-blink.png"
                  frames={12}
                  width={180}
                  height={180}
                  label="prologue blink signal"
                />
              </div>
              <span class="kx-prologue-stage__crosshair" aria-hidden="true"></span>
            </div>
            <HiddenMessageBand class="kx-prologue-stage__message-band" scene="prologue" messages={prologueMessages} />
            <figcaption>{prologueObservationRecord.microLabel}</figcaption>
          </figure>

          <aside class="kx-prologue-stage__protocol-card" data-reveal aria-label="protocol status">
            <p>NODE · {prologue.node}</p>
            <p>PROTOCOL · {prologue.protocol}</p>
            <p>STATUS · {prologueObservationRecord.status}</p>
          </aside>

          <aside
            class="kx-prologue-stage__protocol-panel"
            id="kdx-protocol-panel"
            data-kdx-protocol-panel
            hidden
            aria-hidden="true"
            aria-modal="true"
            role="dialog"
            aria-labelledby="kdx-protocol-title"
          >
            <div class="kx-prologue-stage__protocol-inner">
              <button class="kx-prologue-stage__protocol-close" type="button" data-kdx-protocol-close aria-label="close protocol">CLOSE ✕</button>
              <p class="kx-prologue-stage__protocol-kicker">{prologue.kicker}</p>
              <h3 class="kx-prologue-stage__protocol-title" id="kdx-protocol-title">{prologueObservationRecord.title}</h3>
              <p class="kx-prologue-stage__protocol-copy">The archive detects relation before identity. Observation is reciprocal: the system reads the visitor, then returns a changed memory.</p>
              <ul class="kx-prologue-stage__protocol-list">
                {prologueObservationRecord.notes.map((note) => <li>{note}</li>)}
              </ul>
              <dl class="kx-prologue-stage__protocol-meta">
                <div><dt>Archive</dt><dd>{prologueObservationRecord.archive}</dd></div>
                <div><dt>Signal</dt><dd>{prologueObservationRecord.signal}</dd></div>
                <div><dt>Clearance</dt><dd>{prologueObservationRecord.clearance}</dd></div>
                <div><dt>Operator</dt><dd>{prologueObservationRecord.operator}</dd></div>
                <div><dt>Checksum</dt><dd>{prologueObservationRecord.checksum}</dd></div>
                <div><dt>Timestamp</dt><dd>{prologueObservationRecord.timestamp}</dd></div>
              </dl>
            </div>
          </aside>
        </div>
      </section>
    </div>

    <KodexOverlays gallery={false} />
  </div>

  <script>
    import { liberarMemoria } from "../../kodex/return/memory.js";

    import { initKx } from '../../scripts/kodex-engine.js';
    initKx();

    /* THRESHOLD contra los contratos compartidos. La Scene Bible manda hacer
       ésta primero y sola: "implement the shared contracts and THRESHOLD only".
       No dibuja nada —de eso ya se encarga KodexPortal—; lo que agrega es lo que
       ninguna escena hacía: emitir memoria y publicar señales normalizadas. */
    import { montarThreshold } from '../../lib/kodex/escenas/threshold-cliente';
    const umbral = document.querySelector('.kx-threshold');
    if (umbral instanceof HTMLElement) montarThreshold(umbral);

    /* La bifurcacion sonido/silencio: la eleccion se guarda donde el motor de
       audio la lee (sessionStorage kx-audio). Vive en el velo. */
    document.querySelectorAll('[data-kdx-sonido]').forEach((a) => {
      a.addEventListener('click', () => {
        try { sessionStorage.setItem('kx-audio', (a as HTMLElement).dataset.kdxSonido === '1' ? '1' : '0'); } catch (_) {}
      }, { capture: true });
    });

    /* EL VELO. Tocar en cualquier parte = entrar con sonido (TAP TO ENTER —
       ENABLE SOUND es la rama con-sonido de la bifurcacion canonica); el
       fantasma CONTINUE IN SILENCE ya fijo kx-audio=0 en su propio handler.
       Elegir disuelve el velo y revela la escena; no navega. */
    /* Se monta en función y no de una vez, porque con el router de vistas
       VOLVER no recarga el documento: intercambia el contenido y el guion de
       módulo no se ejecuta de nuevo. Sin esto, retroceder desde PROLOGUE traía
       el velo otra vez y le cobraba al huésped la misma decisión dos veces.
       Medido en los tres tamaños antes de arreglarlo. */
    const montarVelo = () => {
    const velo = document.querySelector('[data-kdx-veil]');
    if (velo instanceof HTMLElement) {
      let disuelto = false;
      const disolver = () => {
        if (disuelto) return;
        disuelto = true;
        /* Elegir es el acto que abre el archivo. Recién acá se libera la
           memoria: lo que se encoló mientras el velo estaba puesto se escribe
           ahora, con el consentimiento dado. */
        try { sessionStorage.setItem('kx-umbral', 'cruzado'); } catch (_) {}
        liberarMemoria();
        /* Se avisa una sola vez. Quien esperaba consentimiento para escribir
           -- la memoria de escena, el sincronizador de URL -- arranca acá. */
        document.dispatchEvent(new CustomEvent('kdx:eleccion'));
        velo.classList.add('is-disuelto');
        window.setTimeout(() => velo.remove(), 950);
      };

      /* Ya cruzó en esta sesión: el velo se retira sin ceremonia y sin volver
         a preguntar. Volver atrás no debe costar dos veces la misma decisión. */
      if (document.documentElement.hasAttribute('data-kdx-umbral-cruzado')) {
        velo.remove();
        disuelto = true;
        liberarMemoria();
        document.dispatchEvent(new CustomEvent('kdx:eleccion'));
      }
      velo.addEventListener('click', (e) => {
        const boton = e.target instanceof Element ? e.target.closest('[data-kdx-sonido]') : null;
        if (!boton) {
          try { sessionStorage.setItem('kx-audio', '1'); } catch (_) {}
        }
        disolver();
      });
    }
    };

    /* Al volver, la sesión ya sabe que cruzó: se marca antes de montar para
       que el velo se retire sin ceremonia en vez de aparecer y desvanecerse. */
    const marcarSiCruzo = () => {
      let cruzado = false;
      try { cruzado = sessionStorage.getItem('kx-umbral') === 'cruzado'; } catch (_) {}
      if (cruzado) {
        document.documentElement.setAttribute('data-kdx-umbral-cruzado', '');
        document.documentElement.removeAttribute('data-kdx-espera-eleccion');
      }
    };
    marcarSiCruzo();
    montarVelo();
    document.addEventListener('astro:page-load', () => { marcarSiCruzo(); montarVelo(); });
  </script>
</Base>
