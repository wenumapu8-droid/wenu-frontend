---
import Base from '../../layouts/Base.astro';
import KodexChrome from '../../components/KodexChrome.astro';
import KodexOverlays from '../../components/KodexOverlays.astro';
import '../../styles/kodex.css';
import '../../styles/kodex-motion.css';
import HiddenMessageBand from '../../components/kodex/motion/HiddenMessageBand.astro';
import ParticleField from '../../components/kodex/motion/ParticleField.astro';
import SignalWaveform from '../../components/kodex/motion/SignalWaveform.astro';
import SpriteSignal from '../../components/kodex/motion/SpriteSignal.astro';
import KodexPortal from '../../components/kodex/portal/KodexPortal.astro';
import KodexOriginVector from '../../components/kodex/density/KodexOriginVector.astro';
import KodexSystemLog from '../../components/kodex/density/KodexSystemLog.astro';
import KodexSystemFooter from '../../components/kodex/density/KodexSystemFooter.astro';
import KodexRegistration from '../../components/kodex/density/KodexRegistration.astro';
import KodexTransition from '../../components/kodex/transition/KodexTransition.astro';
import KodexDebug from '../../components/kodex/debug/KodexDebug.astro';
import KodexEje from '../../components/kodex/eje/KodexEje.astro';
import KodexTira from '../../components/kodex/museo/KodexTira.astro';
import KodexQuietFrame from '../../components/kodex/interludes/KodexQuietFrame.astro';
/* El umbral registra el paso: es el primer evento del recorrido y el que
   RETURN lee para armar el espécimen. Ver KodexRecuerda.astro. */
import KodexRecuerda from '../../components/kodex/KodexRecuerda.astro';
import { leerManifiesto, resolver } from '../../lib/kodex/volumenes';
import { quietFrames } from '../../lib/kodex/quietFrames';
import '../../styles/kodex-micrographics.css';
import '../../styles/kodex-quiet-frames.css';
import { hero } from '../../lib/kodexBook.js';
import { thresholdArtifactRecord, prologueObservationRecord } from '../../lib/kodexArchiveRecords.js';
import { SCENE_UNIVERSE } from '../../lib/kodexUniverse.js';
import { KODEX_MESSAGES } from '../../lib/kodex/motion-config.js';
import { motionVars, recipeFor, gridFor } from '../../lib/kodex/grammar';

// THRESHOLD toma el portal de marmol: su grilla dice "dream field, ambient
// scene", que es exactamente una puerta que todavia no se cruzo.
const thresholdRecipe = recipeFor('threshold');
const thresholdGrid = gridFor('threshold');
const thresholdMotion = motionVars('threshold');

// THRESHOLD es el estrato 02 · PORTALES -- "umbrales de transformacion", que
// es literalmente lo que esta lamina es. Los volumenes de ese estrato son lo
// que hay debajo del umbral.
const volumenesPortales = resolver(await leerManifiesto())
  .filter((v) => v.estrato === 'portales');

const threshold = SCENE_UNIVERSE.threshold;
const prologue = SCENE_UNIVERSE.prologue;

const thresholdRows = [
  ['NODE', 'KDX_00'],
  ['STATUS', threshold.status],
  ['ACCESS', 'UNVERIFIED'],
];

const thresholdRailRows = [
  ['NODE', 'KDX_00'],
  ['STATE', 'LATENT'],
  ['SIGNAL', 'SONIDO'],
  ['SOURCE', 'ARCHIVO VIVO'],
];

const thresholdMetaClusters = {
  upper: [
    ['NODE', 'KDX_00'],
    ['STATUS', 'LATENT'],
    ['ACCESS', 'UNVERIFIED'],
  ],
  lower: [
    ['TYPE', 'AUDIOVISUAL SYSTEM'],
    ['METHOD', 'SIGNAL / MATTER / MEMORY'],
    ['CHECKSUM', thresholdArtifactRecord.checksum],
  ],
};

const thresholdStatusChips = ['ARCHIVE SEALED', 'RITUAL MEMORY', 'OPERATIVE PORTAL'];

const thresholdSystemLog = [
  'PORTAL FIELD SEALED',
  'GEOMETRY CALIBRATED',
  'MEMORY CHANNEL LATENT',
  'ACCESS UNVERIFIED',
];

const thresholdMessages = KODEX_MESSAGES.threshold;
const prologueMessages = KODEX_MESSAGES.prologue;

const prologueRows = [
  ['NODE', prologue.node],
  ['PROTOCOL', prologue.protocol],
  ['STATUS', prologueObservationRecord.status],
];
---

<Base
  title="KODEX−∞ — Arquitecturas Tecno-Tribales"
  description="A living archive of pattern, memory, code and resonance inside the world of Wenu Mapu. A digital book: descend folio by folio."
  robots="index, follow"
  ogImage={hero.src}
  kodexFonts={true}
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <KodexRecuerda />
  <div
    class="kx kx--deck kx--threshold kx--entry"
    data-kx
    data-stage-idx="0"
    data-stage-base="0"
    data-stage-total="07"
    data-stage-name="THRESHOLD"
    data-stage-col="255,39,51"
    data-next-label="ENTER THE KODEX"
    data-next-url="/kodex/folio/i/"
    data-sync-deck-hash
    {/* La herramienta de esta lamina: la rueda gira el mandala. Cero scroll de
        pagina -- el documento no se mueve, la pieza si. */}
    data-kdx-tool="girar"
    data-kdx-recipe={thresholdRecipe.id}
    data-kdx-grid={thresholdGrid.id}
    style={thresholdMotion}
  >
    <KodexTransition />
    <KodexDebug />

    <KodexChrome segs={7} />

    <div class="kx-deck" data-deck>
      <section class="kx-slide kx-slide--threshold" id="threshold" aria-labelledby="kdx-threshold-title">
        <div class="kx-slide__in kx-threshold">
          {/* THRESHOLD ya NO corre el vortice de red. Su preset es el portal
              sobre la obra, y correr los dos deja dos sistemas peleando por el
              mismo fondo. La regla del proyecto es explicita: las siete
              escenas no pueden verse iguales -- distincion por receta, no por
              recolorear la misma lamina. */}

          <div class="kx-threshold__field" aria-hidden="true">
            <ParticleField class="kx-threshold__particles" scene="threshold" label="threshold particle field" />
            <span class="kx-threshold__grid"></span>
            <span class="kx-threshold__scanline"></span>
            <span class="kx-threshold__portal"></span>
            <span class="kx-threshold__ring kx-threshold__ring--a"></span>
            <span class="kx-threshold__ring kx-threshold__ring--b"></span>
            <span class="kx-threshold__signal-dots kx-threshold__signal-dots--a"></span>
            <span class="kx-threshold__signal-dots kx-threshold__signal-dots--b"></span>
            <span class="kx-threshold__dots"></span>
          </div>

          <aside class="kx-threshold__rail" aria-label="threshold metadata" data-reveal>
            {thresholdRailRows.map(([label, value]) => (
              <div>
                <span>{label}</span>
                <strong>{value}</strong>
              </div>
            ))}
          </aside>

          <main class="kx-threshold__body">
            <div class="kx-threshold__headerline" data-reveal>
              <p class="kx-threshold__kicker">SONIDO / ARCHIVO VIVO</p>
              <p class="kx-threshold__serial">{thresholdArtifactRecord.archive} // <span data-kdx-checksum>{thresholdArtifactRecord.checksum}</span> // {thresholdArtifactRecord.timestamp}</p>
            </div>
            <dl class="kx-threshold__meta-zone kx-threshold__meta-zone--upper" data-reveal>
              {thresholdMetaClusters.upper.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd data-kdx-access={label === 'ACCESS' ? '' : undefined}>{value}</dd>
                </div>
              ))}
            </dl>
            <h1 class="kx-threshold__command" id="kdx-threshold-title" data-reveal>
              <span>KODEX−∞</span>
            </h1>
            <p class="kx-threshold__decree" data-reveal>
              THE ARCHIVE RESPONDS TO PRESENCE.
            </p>
            <p class="kx-threshold__lede" data-reveal>
              THE ARCHIVE DOES NOT STORE. IT REMEMBERS.
            </p>
            <p class="kx-threshold__sublede" data-reveal>
              A LIVING AUDIOVISUAL SYSTEM FOR SIGNAL, MATTER, MEMORY AND GENERATIVE CODE.
            </p>
            <div class="kx-threshold__chips" data-reveal>
              {thresholdStatusChips.map((chip) => <span>{chip}</span>)}
            </div>
            <a class="kx-threshold__cta" href="/kodex/folio/i/" data-reveal>
              <span>ENTER THE KODEX</span>
            </a>

            {/* Franja de instrumentos del pie: registro, checksum y monitor.
                En el board es lo que da la sensacion de sistema encendido --
                algo esta corriendo mientras uno lee. */}
            <KodexSystemLog
              entries={[
                ['00:00:00', 'KDX-CORE INITIALIZED'],
                ['00:00:01', 'MEMORY MATRIX ONLINE'],
                ['00:00:02', `${thresholdArtifactRecord.protocol ?? 'THRESHOLD'} PROTOCOL STANDBY`],
                ['00:00:03', 'WAITING FOR INTENT…'],
              ]}
              checksum={thresholdArtifactRecord.checksum}
              verifyAt="KODEX-SYSTEMS/VERIFY"
              threatLabel={`${thresholdArtifactRecord.threat ?? 'NO ANOMALIES'} DETECTED`}
              accent="var(--kdx-red, #FF3833)"
              class="kx-threshold__syslog"
            />
          </main>

            {/* El pie de sistema del board, en lugar del bloque de metadatos
                que decia lo mismo en texto plano. Lleva la misma informacion
                -- tipo, metodo, checksum -- mas el barcode del identificador y
                el reloj: abajo de la lamina siempre hay algo corriendo. */}
            <KodexSystemFooter
              code={`${thresholdArtifactRecord.archive}-${thresholdArtifactRecord.checksum}`}
              checksum={thresholdArtifactRecord.checksum}
              kind="AUDIOVISUAL SYSTEM · SIGNAL / MATTER / MEMORY"
              accent="var(--kdx-red, #FF3833)"
              class="kx-threshold__sysfoot"
            />


          <figure class="kx-threshold__artifact" data-reveal>
            <div class="kx-threshold__artifact-system" aria-hidden="true">
              <span class="kx-threshold__system-grid"></span>
              <span class="kx-threshold__system-noise"></span>
              <span class="kx-threshold__system-particles"></span>
              <svg class="kx-threshold__system-orbits kx-threshold__system-orbits--outer" viewBox="0 0 100 100" focusable="false" aria-hidden="true">
                <circle cx="50" cy="50" r="42"></circle>
                <circle cx="50" cy="50" r="34"></circle>
                <path d="M12 50C20 24 38 12 50 12C74 12 88 30 88 50C88 70 74 88 50 88C30 88 12 74 12 50Z"></path>
              </svg>
              <svg class="kx-threshold__system-orbits kx-threshold__system-orbits--mid" viewBox="0 0 100 100" focusable="false" aria-hidden="true">
                <circle cx="50" cy="50" r="28"></circle>
                <circle cx="50" cy="50" r="22"></circle>
                <path d="M22 38C34 30 66 30 78 38"></path>
                <path d="M22 62C34 70 66 70 78 62"></path>
              </svg>
              <svg class="kx-threshold__system-traces" viewBox="0 0 100 100" focusable="false" aria-hidden="true">
                <path d="M50 4V20M50 80V96M4 50H20M80 50H96"></path>
                <path d="M18 18L30 30M70 70L82 82M82 18L70 30M30 70L18 82"></path>
                <path d="M50 14C68 14 86 32 86 50"></path>
                <path d="M50 86C32 86 14 68 14 50"></path>
              </svg>
            </div>

            <div class="kx-threshold__artifact-core" data-kdx-threshold-parallax>
              <span class="kx-threshold__focus kx-threshold__focus--h" aria-hidden="true"></span>
              <span class="kx-threshold__focus kx-threshold__focus--v" aria-hidden="true"></span>
              {/* El anchor era seis capas de SVG generado — circulos, elipses y
                  paths animados. Se leia "cargado y abstracto": un enredo de
                  lineas donde deberia haber una pieza.

                  Ahora el anchor es la OBRA, tratada como artefacto archivado:
                  pixelada, con dither Bayer, scanlines y glow del rojo de
                  THRESHOLD. La densidad se movio a los datos (rails, metadata),
                  que es donde el brief la queria. */}
              <div class="kx-threshold__symbol-wrap" aria-hidden="true">
                {/* El PORTAL, no un artefacto sobre un fondo.
                    La obra es la textura del shader: entra como u_tex y sale
                    en coordenadas polares, respirando, expandiendose con los
                    graves y con memoria corta de feedback. Es la diferencia
                    entre un sitio con efectos y un instrumento donde el
                    contenido vive DENTRO de la visualizacion.

                    El motor de tres pasadas ya existia en
                    src/kodex/threshold-portal y nunca se habia conectado. */}
                <img
                  class="kx-threshold__portal-fallback"
                  src="/img/kodex/works/mandala-0cin-negativo.png"
                  alt=""
                  loading="eager"
                  decoding="async"
                />
                <KodexPortal
                  artwork="/img/kodex/works/mandala-0cin-negativo.png"
                  seed={0.382}
                  label="THRESHOLD · portal vivo sobre la obra"
                  class="kx-threshold__portal-live"
                />
              </div>
              <span class="kx-threshold__focus-marker kx-threshold__focus-marker--tl" aria-hidden="true"></span>
              <span class="kx-threshold__focus-marker kx-threshold__focus-marker--tr" aria-hidden="true"></span>
              <span class="kx-threshold__focus-marker kx-threshold__focus-marker--bl" aria-hidden="true"></span>
              <span class="kx-threshold__focus-marker kx-threshold__focus-marker--br" aria-hidden="true"></span>
              <SignalWaveform class="kx-threshold__waveform" scene="threshold" />

              {/* Bloque de coordenadas al costado de la pieza. En el board es
                  lo que convierte el marco en un registro: el artefacto no solo
                  se ve, esta ubicado. Los valores salen del propio record. */}
              <KodexOriginVector
                ra={`RA ${thresholdArtifactRecord.signal ?? '23h00m'}`}
                dec={`DEC ${thresholdArtifactRecord.location ?? '+89° 06′ 18″'}`}
                sig={`SIG ${thresholdArtifactRecord.protocol ?? '0.1 – 0.77Hz'}`}
                mod={`MOD ${thresholdArtifactRecord.clearance ?? 'SPECTRAL'}`}
                id={`${thresholdArtifactRecord.archive}-${thresholdArtifactRecord.specimen}-${thresholdArtifactRecord.checksum}`}
                accent="var(--kdx-red, #FF3833)"
                class="kx-threshold__origin"
              />
            </div>

            <button
              class="kdx-artifact-tab"
              type="button"
              data-kdx-artifact-open
              aria-expanded="false"
              aria-controls="kdx-artifact-panel"
              aria-label="open artifact details"
            >
              <span class="kdx-artifact-tab__fold" aria-hidden="true"></span>
              <span class="kdx-artifact-tab__glyph">◈</span>
            </button>
            <figcaption>{thresholdArtifactRecord.title.toLowerCase()}</figcaption>
          </figure>

          <aside class="kx-threshold__systemband" data-reveal aria-label="threshold system band">
            <div class="kx-threshold__barcode-cluster">
              <div class="kx-threshold__barcode" aria-hidden="true">
                {Array.from({ length: 24 }).map(() => <i></i>)}
                <span>{thresholdArtifactRecord.archive} / {thresholdArtifactRecord.specimen}</span>
              </div>
              <p class="kx-threshold__serial-block">SERIAL // {threshold.subject} // {threshold.location} // {thresholdArtifactRecord.checksum}</p>
            </div>

            <div class="kx-threshold__systemlog">
              <p>SYSTEM LOG</p>
              <ul>
                {thresholdSystemLog.map((item) => <li>{item}</li>)}
              </ul>
              <HiddenMessageBand class="kx-threshold__message-band" scene="threshold" messages={thresholdMessages} />
            </div>

            <div class="kx-threshold__checksum">
              <p>CHECKSUM</p>
              {/* Mismo gancho que el resto: cuando el sistema recalcula, este
                  bloque cambia con los demas. Un checksum que difiere entre
                  dos paneles de la misma lamina delata que es decorado. */}
              <strong data-kdx-checksum>{thresholdArtifactRecord.checksum}</strong>
              {/* Los cuatro estados del archivo, del prototipo aprobado. Es el
                  eje que el visitante mueve; la maquina de escena corre por
                  debajo y no se ve. Uno es el pulso, el otro la perilla. */}
              {/* El eje del sistema. THRESHOLD esta en el borde de −∞: el
                  archivo antes de descender. */}
              <KodexEje posicion={0} accent="var(--kdx-red,#FF3833)" class="kx-threshold__eje" />
              <KodexTira
                volumenes={volumenesPortales}
                estrato="portales"
                accent="var(--kdx-red,#FF3833)"
                class="kx-threshold__tira"
              />
              <button class="kx-threshold__shift" type="button" data-kdx-archive-shift>
                <span data-kdx-archive-name>EXCAVATION · E00</span>
                <span aria-hidden="true">→</span>
              </button>
              <span>{thresholdArtifactRecord.timestamp}</span>
            </div>
          </aside>

          <aside
            class="kdx-artifact-panel"
            id="kdx-artifact-panel"
            data-kdx-artifact-panel
            hidden
            aria-hidden="true"
            aria-modal="true"
            role="dialog"
            aria-labelledby="kdx-artifact-title"
          >
            <div class="kdx-artifact-panel__inner">
              <button class="kdx-artifact-panel__close" type="button" data-kdx-artifact-close aria-label="close artifact tab">CLOSE ✕</button>
              <p class="kdx-artifact-panel__eyebrow">{thresholdArtifactRecord.status}</p>
              <h2 class="kdx-artifact-panel__title" id="kdx-artifact-title">{thresholdArtifactRecord.title}</h2>
              <dl class="kdx-artifact-panel__meta">
                <div><dt>Archive</dt><dd>{thresholdArtifactRecord.archive}</dd></div>
                <div><dt>Specimen</dt><dd>{thresholdArtifactRecord.specimen}</dd></div>
                <div><dt>Signal</dt><dd>{thresholdArtifactRecord.signal}</dd></div>
                <div><dt>Protocol</dt><dd>{thresholdArtifactRecord.protocol}</dd></div>
                <div><dt>Clearance</dt><dd>{thresholdArtifactRecord.clearance}</dd></div>
                <div><dt>Checksum</dt><dd>{thresholdArtifactRecord.checksum}</dd></div>
                <div><dt>Type</dt><dd>{thresholdArtifactRecord.type}</dd></div>
                <div><dt>Origin</dt><dd>{thresholdArtifactRecord.origin}</dd></div>
                <div><dt>Edition</dt><dd>{thresholdArtifactRecord.edition}</dd></div>
                <div><dt>Provenance</dt><dd>{thresholdArtifactRecord.provenance}</dd></div>
                <div><dt>License</dt><dd>{thresholdArtifactRecord.license}</dd></div>
                <div><dt>Availability</dt><dd>{thresholdArtifactRecord.availability}</dd></div>
              </dl>
              <div class="kdx-artifact-panel__actions">
                <a href={thresholdArtifactRecord.dossierHref}>View Dossier</a>
                <a href={thresholdArtifactRecord.collectHref}>Collect</a>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section class="kx-slide kx-slide--quiet" id="quiet-threshold-slide" aria-labelledby="quiet-threshold-label">
        <KodexQuietFrame {...quietFrames["threshold-prologue"]} id="quiet-threshold" />
      </section>

      <section class="kx-slide kx-slide--prologue kx-os-scene kx-os-scene--prologue" id="prologue" aria-labelledby="kdx-prologue-title">
        <div class="kx-slide__in kx-prologue-stage">
          <div class="kx-prologue-stage__scan" aria-hidden="true"></div>
          <div class="kx-prologue-stage__ambient" aria-hidden="true"></div>
          <ParticleField class="kx-prologue-stage__particles" scene="prologue" label="prologue particle field" />
          <aside class="kx-prologue-stage__rail" data-reveal aria-label="prologue status">
            <span>{prologue.code}</span>
            <span>{prologueObservationRecord.status}</span>
          </aside>

          <main class="kx-prologue-stage__body">
            <p class="kx-prologue-stage__kicker" data-reveal>{prologue.kicker}</p>
            <h2 class="kx-prologue-stage__title" id="kdx-prologue-title" data-reveal>
              <span>THE ARCHIVE</span>
              <span>IS WATCHING.</span>
            </h2>
            <p class="kx-prologue-stage__statement" data-reveal>YOU ARE NOT ALONE.</p>
            <p class="kx-prologue-stage__mantra" data-reveal>A SIGNAL.<br />A SYSTEM.<br />A CHOICE.</p>
            <div class="kx-prologue-stage__actions" data-reveal>
              <a class="kx-prologue-stage__cta" href="/kodex/folio/ii/">{prologue.cta}</a>
              <button class="kx-prologue-stage__protocol-trigger" type="button" data-kdx-protocol-open aria-expanded="false" aria-controls="kdx-protocol-panel">READ THE PROTOCOL</button>
            </div>
            <dl class="kx-prologue-stage__meta" data-reveal>
              {prologueRows.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </main>

          <figure class="kx-prologue-stage__visual" data-reveal>
            <div class="kx-prologue-stage__eye-field" data-kdx-prologue-eye aria-hidden="true">
              <span class="kx-prologue-stage__dust"></span>
              <span class="kx-prologue-stage__pulse"></span>
              <svg class="kx-prologue-stage__orbit kx-prologue-stage__orbit--outer" viewBox="0 0 520 520" focusable="false">
                <circle cx="260" cy="260" r="212"></circle>
                <ellipse cx="260" cy="260" rx="238" ry="144"></ellipse>
                <ellipse cx="260" cy="260" rx="176" ry="236" transform="rotate(-28 260 260)"></ellipse>
                <path d="M84 260C120 160 198 86 260 86C338 86 414 152 448 260"></path>
              </svg>
              <svg class="kx-prologue-stage__orbit kx-prologue-stage__orbit--inner" viewBox="0 0 520 520" focusable="false">
                <circle cx="260" cy="260" r="164"></circle>
                <ellipse cx="260" cy="260" rx="198" ry="118" transform="rotate(14 260 260)"></ellipse>
                <path d="M112 214C154 186 212 170 260 170C318 170 372 188 408 220"></path>
                <path d="M118 308C164 340 214 354 260 354C314 354 366 338 406 302"></path>
              </svg>
              <svg class="kx-prologue-stage__reticle" viewBox="0 0 520 520" focusable="false">
                <path d="M260 52V132M260 388V468M52 260H132M388 260H468"></path>
                <path d="M132 132L176 176M344 344L388 388M388 132L344 176M176 344L132 388"></path>
                <circle cx="260" cy="260" r="94"></circle>
              </svg>
              <svg class="kx-prologue-stage__wave" viewBox="0 0 520 520" focusable="false">
                <path d="M74 266C104 250 124 228 150 228C184 228 192 292 228 292C254 292 262 230 292 230C324 230 334 310 374 310C402 310 420 286 446 270"></path>
              </svg>
              <div class="kx-prologue-stage__eye-art">
                <svg class="kx-prologue-stage__eye-shell" viewBox="0 0 520 520" focusable="false">
                  <path d="M54 260C106 170 186 110 260 110C334 110 414 170 466 260C414 350 334 410 260 410C186 410 106 350 54 260Z"></path>
                  <path d="M112 260C150 202 202 168 260 168C318 168 370 202 408 260C370 318 318 352 260 352C202 352 150 318 112 260Z"></path>
                </svg>
                <svg class="kx-prologue-stage__eye-iris" viewBox="0 0 520 520" focusable="false">
                  <circle cx="260" cy="260" r="82"></circle>
                  <circle cx="260" cy="260" r="54"></circle>
                  <path d="M260 178C304 178 342 216 342 260C342 304 304 342 260 342C216 342 178 304 178 260C178 216 216 178 260 178Z"></path>
                </svg>
                <div class="kx-prologue-stage__pupil-anchor">
                  <span class="kx-prologue-stage__pupil"></span>
                  <span class="kx-prologue-stage__pupil-glint"></span>
                </div>
                <SpriteSignal
                  class="kx-prologue-stage__sprite-signal"
                  scene="prologue"
                  sprite="/assets/kodex/sprites/observation-eye-blink.png"
                  frames={12}
                  width={180}
                  height={180}
                  label="prologue blink signal"
                />
              </div>
              <span class="kx-prologue-stage__crosshair" aria-hidden="true"></span>
            </div>
            <HiddenMessageBand class="kx-prologue-stage__message-band" scene="prologue" messages={prologueMessages} />
            <figcaption>{prologueObservationRecord.microLabel}</figcaption>
          </figure>

          <aside class="kx-prologue-stage__protocol-card" data-reveal aria-label="protocol status">
            <p>NODE · {prologue.node}</p>
            <p>PROTOCOL · {prologue.protocol}</p>
            <p>STATUS · {prologueObservationRecord.status}</p>
          </aside>

          <aside
            class="kx-prologue-stage__protocol-panel"
            id="kdx-protocol-panel"
            data-kdx-protocol-panel
            hidden
            aria-hidden="true"
            aria-modal="true"
            role="dialog"
            aria-labelledby="kdx-protocol-title"
          >
            <div class="kx-prologue-stage__protocol-inner">
              <button class="kx-prologue-stage__protocol-close" type="button" data-kdx-protocol-close aria-label="close protocol">CLOSE ✕</button>
              <p class="kx-prologue-stage__protocol-kicker">{prologue.kicker}</p>
              <h3 class="kx-prologue-stage__protocol-title" id="kdx-protocol-title">{prologueObservationRecord.title}</h3>
              <p class="kx-prologue-stage__protocol-copy">The archive detects relation before identity. Observation is reciprocal: the system reads the visitor, then returns a changed memory.</p>
              <ul class="kx-prologue-stage__protocol-list">
                {prologueObservationRecord.notes.map((note) => <li>{note}</li>)}
              </ul>
              <dl class="kx-prologue-stage__protocol-meta">
                <div><dt>Archive</dt><dd>{prologueObservationRecord.archive}</dd></div>
                <div><dt>Signal</dt><dd>{prologueObservationRecord.signal}</dd></div>
                <div><dt>Clearance</dt><dd>{prologueObservationRecord.clearance}</dd></div>
                <div><dt>Operator</dt><dd>{prologueObservationRecord.operator}</dd></div>
                <div><dt>Checksum</dt><dd>{prologueObservationRecord.checksum}</dd></div>
                <div><dt>Timestamp</dt><dd>{prologueObservationRecord.timestamp}</dd></div>
              </dl>
            </div>
          </aside>
        </div>
      </section>
    </div>

    <KodexOverlays gallery={false} />
  </div>

  <script>
    import { initKx } from '../../scripts/kodex-engine.js';
    initKx();
  </script>
</Base>
