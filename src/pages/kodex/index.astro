  <script>
    import { liberarMemoria } from "../../kodex/return/memory.js";

    import { initKx } from '../../scripts/kodex-engine.js';
    initKx();

    /* THRESHOLD contra los contratos compartidos. La Scene Bible manda hacer
       ésta primero y sola: "implement the shared contracts and THRESHOLD only".
       No dibuja nada —de eso ya se encarga KodexPortal—; lo que agrega es lo que
       ninguna escena hacía: emitir memoria y publicar señales normalizadas. */
    import { montarThreshold } from '../../lib/kodex/escenas/threshold-cliente';
    const umbral = document.querySelector('.kx-threshold');
    if (umbral instanceof HTMLElement) montarThreshold(umbral);

    /* El estado en el DOM. La máquina ya corría acá —la comparten el portal,
       la compuerta y el CRT— pero nadie la escribía, así que la consecuencia
       visible no era verificable ni desde el gate ni desde el CSS. */
    import { montarEspejoEstado } from '../../lib/kodex/espejo-estado';
    if (umbral instanceof HTMLElement) { try { montarEspejoEstado(umbral); } catch (_) {} }

    /* LA VOZ · 2026-08-28. Va junto al espejo de estado porque las dos hacen
       lo mismo desde angulos distintos: el espejo hace VISIBLE el estado, la
       voz lo hace AUDIBLE. Ninguna inventa comportamiento nuevo.
       No arranca sola: voz.ts respeta la eleccion de la puerta
       (sessionStorage kx-audio) y prefers-reduced-motion, y espera el primer
       gesto real del visitante. Si el visitante eligio silencio, montarla no
       hace absolutamente nada. */
    import { montarVoz } from '../../lib/kodex/voz';
    if (umbral instanceof HTMLElement) {
      try {
        const callar = montarVoz(umbral);
        window.addEventListener('pagehide', callar, { once: true });
      } catch (_) {}
    }

    /* La bifurcacion sonido/silencio: la eleccion se guarda donde el motor de
       audio la lee (sessionStorage kx-audio). Vive en el velo. */
    document.querySelectorAll('[data-kdx-sonido]').forEach((a) => {
      a.addEventListener('click', () => {
        try { sessionStorage.setItem('kx-audio', (a as HTMLElement).dataset.kdxSonido === '1' ? '1' : '0'); } catch (_) {}
      }, { capture: true });
    });

    /* EL VELO. Tocar en cualquier parte = entrar con sonido (TAP TO ENTER —
       ENABLE SOUND es la rama con-sonido de la bifurcacion canonica); el
       fantasma CONTINUE IN SILENCE ya fijo kx-audio=0 en su propio handler.
       Elegir disuelve el velo y revela la escena; no navega. */
    /* Se monta en función y no de una vez, porque con el router de vistas
       VOLVER no recarga el documento: intercambia el contenido y el guion de
       módulo no se ejecuta de nuevo. Sin esto, retroceder desde PROLOGUE traía
       el velo otra vez y le cobraba al huésped la misma decisión dos veces.
       Medido en los tres tamaños antes de arreglarlo. */
    const montarVelo = () => {
    const velo = document.querySelector('[data-kdx-veil]');
    if (velo instanceof HTMLElement) {
      let disuelto = false;
      const disolver = () => {
        if (disuelto) return;
        disuelto = true;
        /* Elegir es el acto que abre el archivo. Recién acá se libera la
           memoria: lo que se encoló mientras el velo estaba puesto se escribe
           ahora, con el consentimiento dado. */
        try { sessionStorage.setItem('kx-umbral', 'cruzado'); } catch (_) {}
        liberarMemoria();
        /* Se avisa una sola vez. Quien esperaba consentimiento para escribir
           -- la memoria de escena, el sincronizador de URL -- arranca acá. */
        document.dispatchEvent(new CustomEvent('kdx:eleccion'));
        velo.classList.add('is-disuelto');
        window.setTimeout(() => velo.remove(), 950);
      };

      /* Ya cruzó en esta sesión: el velo se retira sin ceremonia y sin volver
         a preguntar. Volver atrás no debe costar dos veces la misma decisión. */
      if (document.documentElement.hasAttribute('data-kdx-umbral-cruzado')) {
        velo.remove();
        disuelto = true;
        liberarMemoria();
        document.dispatchEvent(new CustomEvent('kdx:eleccion'));
      } else if (document.documentElement.hasAttribute('data-kdx-umbral-reconocido')) {
        /* Ya cruzó, pero volvió a la puerta por su cuenta. La portada se queda
           -- el campo, la marca, la palabra -- y lo único que cambia es que no
           se le pregunta nada: una sola puerta y ya. Nada se encola ni se pide
           de nuevo, la memoria se libera acá mismo. */
        liberarMemoria();
        document.dispatchEvent(new CustomEvent('kdx:eleccion'));
      }
      velo.addEventListener('click', (e) => {
        const boton = e.target instanceof Element ? e.target.closest('[data-kdx-sonido]') : null;
        if (!boton) {
          try { sessionStorage.setItem('kx-audio', '1'); } catch (_) {}
        }
        disolver();
      });
    }
    };

    /* Al volver, la sesión ya sabe que cruzó: se marca antes de montar para
       que el velo se retire sin ceremonia en vez de aparecer y desvanecerse. */
    const marcarSiCruzo = () => {
      let cruzado = false;
      try { cruzado = sessionStorage.getItem('kx-umbral') === 'cruzado'; } catch (_) {}
      if (!cruzado) return;
      /* Misma distinción que el guardián de arriba, y hacía falta repetirla:
         esta función corre en cada `astro:page-load` y volvía a poner
         `umbral-cruzado` siempre, pisando lo que el guardián había decidido.
         Medido: la portada seguía sin volver aunque el guardián ya la
         marcaba como reconocida. Dos lugares deciden lo mismo, los dos tienen
         que decidirlo igual. */
      let atras = false;
      try { atras = (performance.getEntriesByType('navigation')[0] || {}).type === 'back_forward'; } catch (_) {}
      const raiz = document.documentElement;
      raiz.removeAttribute('data-kdx-espera-eleccion');
      if (atras) { raiz.setAttribute('data-kdx-umbral-cruzado', ''); raiz.removeAttribute('data-kdx-umbral-reconocido'); }
      else { raiz.setAttribute('data-kdx-umbral-reconocido', ''); raiz.removeAttribute('data-kdx-umbral-cruzado'); }
    };
    marcarSiCruzo();
    montarVelo();
    /* Y ACÁ ESTABA EL AGUJERO DEL DISCRIMINADOR. El tipo de navegación sólo
       sirve para el documento que se carga de verdad. Cuando el corredor vuelve
       a /kodex/ por su router, NO hay navegación nueva: el documento es el
       mismo y `performance` sigue diciendo 'navigate'. Con eso, volver desde un
       folio hacía reaparecer la portada -- justo lo que la regla del creador
       prohíbe, y el banco lo cazó: tres fallas de "volver NO vuelve a pedir la
       puerta".

       Después de la primera carga, todo lo que pase es movimiento DENTRO del
       corredor. Quien ya cruzó y vuelve por adentro no ve la puerta otra vez.
       La portada reconocida es para quien llega de nuevo al sitio. */
    let dentroDelCorredor = false;
    document.addEventListener('astro:page-load', () => {
      if (dentroDelCorredor) {
        let cruzado = false;
        try { cruzado = sessionStorage.getItem('kx-umbral') === 'cruzado'; } catch (_) {}
        if (cruzado) {
          document.documentElement.setAttribute('data-kdx-umbral-cruzado', '');
          document.documentElement.removeAttribute('data-kdx-umbral-reconocido');
          document.documentElement.removeAttribute('data-kdx-espera-eleccion');
        }
      } else {
        dentroDelCorredor = true;
        marcarSiCruzo();
      }
      montarVelo();
    });
  </script>
