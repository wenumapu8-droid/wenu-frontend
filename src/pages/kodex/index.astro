---
import Base from '../../layouts/Base.astro';
import KodexChrome from '../../components/KodexChrome.astro';
import KodexOverlays from '../../components/KodexOverlays.astro';
import '../../styles/kodex.css';
import '../../styles/kodex-motion.css';
import HiddenMessageBand from '../../components/kodex/motion/HiddenMessageBand.astro';
import ParticleField from '../../components/kodex/motion/ParticleField.astro';
import SpriteSignal from '../../components/kodex/motion/SpriteSignal.astro';
import KodexPortal from '../../components/kodex/portal/KodexPortal.astro';
import KodexTransition from '../../components/kodex/transition/KodexTransition.astro';
import KodexDebug from '../../components/kodex/debug/KodexDebug.astro';
import KodexTira from '../../components/kodex/museo/KodexTira.astro';
import KodexQuietFrame from '../../components/kodex/interludes/KodexQuietFrame.astro';
import KdxPanel from '../../components/kodex/panels/KdxPanel.astro';
import KdxBar from '../../components/kodex/panels/KdxBar.astro';
import '../../components/kodex/panels/kodex-panels.css';
import '../../components/kodex/panels/kodex-threshold-board.css';
import { leerManifiesto, resolver } from '../../lib/kodex/volumenes';
import { quietFrames } from '../../lib/kodex/quietFrames';
import '../../styles/kodex-micrographics.css';
import '../../styles/kodex-quiet-frames.css';
import { hero } from '../../lib/kodexBook.js';
import { thresholdArtifactRecord, prologueObservationRecord } from '../../lib/kodexArchiveRecords.js';
import { SCENE_UNIVERSE } from '../../lib/kodexUniverse.js';
import { KODEX_MESSAGES } from '../../lib/kodex/motion-config.js';
import { motionVars, recipeFor, gridFor } from '../../lib/kodex/grammar';
import manifest from '../../../public/kodex-content/manifest.json';
import { THRESHOLD_PORTAL_CONFIG } from '../../kodex/threshold-portal/config.js';
import { FASES } from '../../lib/kodex/archivo';

// THRESHOLD toma el portal de marmol: su grilla dice "dream field, ambient
// scene", que es exactamente una puerta que todavia no se cruzo.
const thresholdRecipe = recipeFor('threshold');
const thresholdGrid = gridFor('threshold');
const thresholdMotion = motionVars('threshold');

// THRESHOLD es el estrato 02 · PORTALES -- "umbrales de transformacion", que
// es literalmente lo que esta lamina es. Los volumenes de ese estrato son lo
// que hay debajo del umbral.
const volumenesPortales = resolver(await leerManifiesto())
  .filter((v) => v.estrato === 'portales');

/* CANON. El estrato 02 del manifiesto, que es al que pertenece esta lamina. */
const estratoPortales = (await leerManifiesto()).estratos.find((e) => e.id === 'portales');

const threshold = SCENE_UNIVERSE.threshold;
const prologue = SCENE_UNIVERSE.prologue;

/* ---------------------------------------------------------------------------
   THRESHOLD · DE DONDE SALE CADA VALOR DE LA HOJA
   ---------------------------------------------------------------------------
   La lamina anterior mostraba `SIGNAL 137.59 MHz`, `RA 23h00m / DEC +89°06′18″`,
   `CLEARANCE CL-5`, `THREAT T-1`, `ACCESS UNVERIFIED`, un registro de sistema
   con marcas de tiempo `00:00:01 MEMORY MATRIX ONLINE` y tres chips
   (`ARCHIVE SEALED` / `RITUAL MEMORY` / `OPERATIVE PORTAL`). Ninguno de esos
   valores lo puede respaldar nada: son telemetria inventada.

   docs/kodex/THRESHOLD_VISUAL_AUDIT_V1.md lo dice sin rodeos en D5:
     "Do not copy the reference board's invented energy, auth, clearance,
      harmonic, coordinates or similar claims."
   y el canon fija la conducta ante el vacio:
     "Absence is a valid informational state. It must not be filled."

   Asi que la densidad de esta hoja NO viene de inventar mas numeros: viene de
   que el proyecto ya tiene mucho dato real y no lo estaba mostrando. Tres
   fuentes, y cada panel declara la suya:

     CANON     public/kodex-content/manifest.json -> organismo 01
               `threshold-portal`. Nombre, rol, estados, verbos, paleta,
               ruteo de audio y cadena FX salen literalmente de ahi.
     ENGINE    src/kodex/threshold-portal/ -- la configuracion y los cuatro
               shaders que de verdad corren. Los numeros que se muestran son
               los que el runtime sube como uniform, leidos del codigo fuente.
     MEASURED  medido por el navegador en el momento: renderer, modo de
               movimiento, viewport, DPR, fase del portal.

   Y una cuarta, marcada aparte: AUTHORED, el texto de autor.
   --------------------------------------------------------------------------- */

/* CANON. El organismo 01 del manifiesto. Si el manifiesto cambia, cambia la
   lamina: no hay copia del dato en esta pagina. */
const organism = manifest.organismos.find((o) => o.id === 'threshold-portal');
if (!organism) throw new Error('manifest.json: falta el organismo threshold-portal');

/* ENGINE. Estos son los tres valores que el runtime sube tal cual:
     u_seed   = seed del componente (0.382)
     u_decay  = config.feedback.decay
     u_mix    = config.feedback.mix, y 0.0 exacto con movimiento reducido
              (KdxThresholdPortalRuntime.js:234)
   El u_state que ve el shader es `phaseValue / 2` (linea 217), de modo que
   DORMANT/AWARE/OPEN entran como 0.0 / 0.5 / 1.0. */
const portalSeed = THRESHOLD_PORTAL_CONFIG.defaultSeed;
const feedbackDecay = THRESHOLD_PORTAL_CONFIG.feedback.decay;
const feedbackMix = THRESHOLD_PORTAL_CONFIG.feedback.mix;

/* ENGINE. Las amplitudes por estado NO se leen de config.breathing/config.polar:
   esos campos existen pero el runtime nunca los sube. Lo que de verdad corre
   esta escrito en shaders/thresholdPortalSource.frag:41-43

     breathe   = sin(u_time * mix(0.12, 0.28, u_state)) * mix(0.02, 0.08, u_state)
     polarWarp = mix(0.06, 0.24, u_state) * sin(angle*4 + u_time*0.18 + u_seed*TAU)

   Evaluado en los tres u_state canonicos. Se muestran estos y no los de
   config.js porque son los que el portal esta usando. */
const uState = { DORMANT: 0, AWARE: 0.5, OPEN: 1 };
const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
const stateRows = organism.estados.map((e) => {
  const t = uState[e.id as keyof typeof uState] ?? 0;
  return {
    id: e.id,
    es: e.es,
    en: e.en,
    u: t.toFixed(1),
    breathe: lerp(0.02, 0.08, t).toFixed(3),
    warp: lerp(0.06, 0.24, t).toFixed(2),
  };
});

/* ENGINE. Los cuatro estados del archivo y el valor con el que cada uno entra
   al shader. Salen de src/lib/kodex/archivo.ts, que es lo que el boton de la
   hoja mueve: el MISMO numero alimenta u_state y el preset del audio. */
const archivePhases: [string, string, string][] = FASES.map((f) => [
  f.clave,
  f.nombre,
  f.valor.toFixed(2),
]);

/* ENGINE. Las cuatro pasadas reales, en el orden en que corren. */
const shaderChain = [
  ['VERT', 'screen.vert'],
  ['PASS 1', 'thresholdPortalSource.frag'],
  ['PASS 2', 'thresholdPortalFeedback.frag'],
  ['PASS 3', 'thresholdPortalComposite.frag'],
];

/* ENGINE. Cita literal de shaders/thresholdPortalSource.frag:41-43 y de
   runtime/KdxThresholdPortalRuntime.js:217,234. Va como dato y no como
   markup para que el compilador no tenga que parsear GLSL dentro de JSX. */
const shaderQuote: Array<[string, 'src' | 'note']> = [
  ['float breathe   = sin(u_time * mix(0.12, 0.28, u_state))', 'src'],
  ['                * mix(0.02, 0.08, u_state);', 'src'],
  ['float polarWarp = mix(0.06, 0.24, u_state)', 'src'],
  ['                * sin(angle * 4.0 + u_time * 0.18);', 'src'],
  ['// u_state = phaseValue / 2', 'note'],
  ['//   DORMANT 0.0 · AWARE 0.5 · OPEN 1.0', 'note'],
  ['// u_mix = 0.0 exacto con movimiento reducido', 'note'],
];

/* Marca de indice del pie. El ancho y la opacidad de cada barra salen del
   propio id del organismo: reproducible, y no afirma nada sobre nada. */
const stripBars = Array.from(organism.id).map((ch, i) => {
  const w = 1 + ((ch.charCodeAt(0) + i) % 4);
  const o = (0.3 + (ch.charCodeAt(0) % 6) / 9).toFixed(2);
  return 'width:' + w + 'px;opacity:' + o;
});

/* AUTHORED. Texto de autor de la pagina. No afirma nada del mundo. */
const lede = 'THE ARCHIVE DOES NOT STORE. IT REMEMBERS.';
const sublede = 'A LIVING AUDIOVISUAL SYSTEM FOR SIGNAL, MATTER, MEMORY AND GENERATIVE CODE.';

/* Los tres unicos enunciados de acceso que esta pagina puede sostener, de la
   lista permitida del audit (D3). Son ciertos porque describen lo que la
   pagina hace: no pide identidad, no escribe memoria hasta que se entra, y la
   entrada es un acto explicito. */
const entryTerms = [
  ['IDENTITY CLAIM', 'NONE'],
  ['MEMORY WRITE', 'NONE'],
  ['ENTRY', 'VOLUNTARY'],
];

const thresholdMessages = KODEX_MESSAGES.threshold;
const prologueMessages = KODEX_MESSAGES.prologue;

const prologueRows = [
  ['NODE', prologue.node],
  ['PROTOCOL', prologue.protocol],
  ['STATUS', prologueObservationRecord.status],
];
---

<Base
  title="KODEX−∞ — Arquitecturas Tecno-Tribales"
  description="A living archive of pattern, memory, code and resonance inside the world of Wenu Mapu. A digital book: descend folio by folio."
  robots="index, follow"
  ogImage={hero.src}
  kodexFonts={true}
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div
    class="kx kx--deck kx--threshold kx--entry"
    data-kx
    data-stage-idx="0"
    data-stage-base="0"
    data-stage-total="07"
    data-stage-name="THRESHOLD"
    data-stage-col="255,39,51"
    data-next-label="ENTER THE KODEX"
    data-next-url="/kodex/folio/i/"
    data-sync-deck-hash
    {/* La herramienta de esta lamina: la rueda gira el mandala. Cero scroll de
        pagina -- el documento no se mueve, la pieza si. */}
    data-kdx-tool="girar"
    data-kdx-recipe={thresholdRecipe.id}
    data-kdx-grid={thresholdGrid.id}
    style={thresholdMotion}
  >
    <KodexTransition />
    <KodexDebug />

    <KodexChrome segs={7} />

    <div class="kx-deck" data-deck>
      {/* ==================================================================
          THRESHOLD · LA HOJA
          ------------------------------------------------------------------
          Once zonas numeradas, dos barras de instrumentos y un objeto vivo.
          La numeracion corre en orden de lectura sobre la hoja entera --
          columna izquierda 01..04, centro 05, columna derecha 06..08, banda
          09..11 -- y no reinicia por columna: eso es lo que hace que se lea
          como UN documento y no como una coleccion de bloques.

          Cada panel declara de donde sale su contenido en su propia cabecera:
          CANON (manifiesto), ENGINE (el motor que corre), MEASURED (medido por
          el navegador ahora) o AUTHORED (texto de autor). Ningun panel afirma
          algo que no pueda respaldar, y el que no tiene dato lo dice.
          ================================================================== */}
      <section class="kx-slide kx-slide--threshold" id="threshold" aria-labelledby="kdx-threshold-title">
        <div class="kx-slide__in kx-threshold kdxp-board kdxp">
          <div class="kdxp-field" aria-hidden="true">
            <ParticleField class="kdxp-field__particles" scene="threshold" label="threshold particle field" />
          </div>

          {/* ---------- MASTHEAD + barra de instrumentos superior ---------- */}
          <header class="kdxp-masthead">
            <div class="kdxp-masthead__id">
              <h1 class="kdxp-masthead__title" id="kdx-threshold-title">
                <span>KODEX−∞</span>
                <span class="kdxp-masthead__slash">/</span>
                <em>{organism.name_en.toUpperCase()}</em>
              </h1>
              <p class="kdxp-masthead__sub">{organism.name_es} · {organism.rol}</p>
            </div>

            <KdxBar
              label="sheet identity"
              cells={[
                { k: 'ORGANISM', v: organism.n, accent: true },
                { k: 'ID', v: organism.id },
                { k: 'ROUTE', v: '/kodex/' },
                { k: 'STAGE', v: '00 / 07' },
                { k: 'RENDERER', v: '—', hook: 'renderer' },
                { k: 'MOTION', v: '—', hook: 'motion' },
              ]}
            />
          </header>

          <div class="kdxp-main">
            {/* ---------------- columna izquierda · 01..04 ---------------- */}
            <div class="kdxp-col kdxp-col--left">
              <KdxPanel n="01" label="SCENE" aside="CANON">
                <dl class="kdxp-rows">
                  <div class="kdxp-row"><dt class="kdxp-row__k">ROL</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v">{organism.rol}</dd></div>
                  <div class="kdxp-row"><dt class="kdxp-row__k">NAME ES</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v">{organism.name_es}</dd></div>
                  <div class="kdxp-row"><dt class="kdxp-row__k">NAME EN</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v">{organism.name_en}</dd></div>
                </dl>
              </KdxPanel>

              {/* 02 · La maquina de estado. Los tres estados son del
                  manifiesto; las amplitudes se leen del shader que corre. */}
              <KdxPanel n="02" label="STATE MACHINE" aside="CANON">
                <div class="kdxp-states">
                  {stateRows.map((s) => (
                    <div class="kdxp-state" data-kdxp-state={s.id}>
                      <span class="kdxp-state__id">{s.id}</span>
                      <span class="kdxp-state__es">{s.es} / {s.en}</span>
                      <span class="kdxp-state__amp">u {s.u}</span>
                    </div>
                  ))}
                </div>
              </KdxPanel>

              <KdxPanel n="03" label="MOTION VERBS" aside="CANON">
                <div class="kdxp-verbs">
                  {organism.verbos.en.map((en: string, i: number) => (
                    <div class="kdxp-verb">
                      <span class="kdxp-cell__k">{String(i + 1).padStart(2, '0')}</span>
                      <span class="kdxp-cell__v">{en.toUpperCase()}</span>
                      <span class="kdxp-cell__k">{organism.verbos.es[i]}</span>
                    </div>
                  ))}
                </div>
              </KdxPanel>

              {/* 04 · Lo unico que esta hoja MIDE. Todo lo escribe
                  kdx-runtime-readout.ts, que solo le pregunta al navegador. */}
              <KdxPanel n="04" label="RUNTIME" aside="MEASURED">
                <dl class="kdxp-rows">
                  <div class="kdxp-row kdxp-row--accent"><dt class="kdxp-row__k">PHASE</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v" data-kdxp-hook="state">DORMANT</dd></div>
                  <div class="kdxp-row"><dt class="kdxp-row__k">GPU</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v" data-kdxp-hook="gpu">—</dd></div>
                  <div class="kdxp-row"><dt class="kdxp-row__k">CANVAS · DPR</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v" data-kdxp-hook="canvas">—</dd></div>
                  <div class="kdxp-row"><dt class="kdxp-row__k">VIEWPORT</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v" data-kdxp-hook="viewport">—</dd></div>
                </dl>
              </KdxPanel>
            </div>

            {/* ------------------ centro · 05 · el objeto ------------------ */}
            <KdxPanel
              n="05"
              label="THRESHOLD PORTAL"
              aside="LIVE · SRC → FEEDBACK → COMPOSITE"
              focus={true}
              flush={true}
              class="kdxp-hero"
            >
              <div class="kdxp-stage">
                <span class="kdxp-stage__reticle" aria-hidden="true"></span>
                <div class="kdxp-stage__wrap" data-kdx-threshold-parallax>
                  {/* El motor de tres pasadas de src/kodex/threshold-portal
                      corriendo dentro del panel. La obra no va encima del
                      shader: ES la textura del shader. */}
                  <KodexPortal
                    artwork="/img/kodex/works/mandala-0cin-negativo.png"
                    seed={portalSeed}
                    label="THRESHOLD · portal vivo sobre la obra"
                    class="kdxp-stage__portal"
                  />
                </div>
              </div>
              <div class="kdxp-hero__foot">
                <div class="kdxp-cell"><span class="kdxp-cell__k">TEXTURE</span><span class="kdxp-cell__v">mandala-0cin-negativo</span></div>
                <div class="kdxp-cell"><span class="kdxp-cell__k">U_SEED</span><span class="kdxp-cell__v">{portalSeed}</span></div>
                <div class="kdxp-cell"><span class="kdxp-cell__k">U_DECAY</span><span class="kdxp-cell__v">{feedbackDecay}</span></div>
                <div class="kdxp-cell"><span class="kdxp-cell__k">U_MIX</span><span class="kdxp-cell__v">{feedbackMix}</span></div>
                <div class="kdxp-cell"><span class="kdxp-cell__k">TOOL</span><span class="kdxp-cell__v">WHEEL → U_WHEEL</span></div>
                {/* El dossier de la obra: procedencia real -- autor, edicion,
                    licencia -- no telemetria. Vive donde vive la obra. */}
                <button
                  class="kdxp-action kdxp-action--ghost kdxp-hero__dossier"
                  type="button"
                  data-kdx-artifact-open
                  aria-expanded="false"
                  aria-controls="kdx-artifact-panel"
                >DOSSIER →</button>
              </div>
            </KdxPanel>

            {/* ---------------- columna derecha · 06..08 ---------------- */}
            <div class="kdxp-col kdxp-col--right">
              {/* 06 · La accion. Un solo acto, explicito. */}
              <KdxPanel n="06" label="ENTRY" aside="AUTHORED">
                <div class="kdxp-entry">
                  <p class="kdxp-entry__lede">{lede}</p>
                  <p class="kdxp-entry__sub">{sublede}</p>
                  <a class="kdxp-action" href="/kodex/folio/i/" data-reveal>ENTER THE KODEX</a>
                  <dl class="kdxp-rows kdxp-entry__terms">
                    {entryTerms.map(([k, v]) => (
                      <div class="kdxp-row"><dt class="kdxp-row__k">{k}</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v">{v}</dd></div>
                    ))}
                  </dl>
                </div>
              </KdxPanel>

              {/* 07 · El eje del archivo. Es la perilla del instrumento: el
                  valor que sale de aca entra como u_state al shader y como
                  preset al audio -- el MISMO numero para imagen y sonido.
                  Los cuatro valores son los de src/lib/kodex/archivo.ts. */}
              <KdxPanel n="07" label="ARCHIVE AXIS" aside="ENGINE">
                <div class="kdxp-states">
                  {archivePhases.map(([clave, nombre, valor]) => (
                    <div class="kdxp-state" data-kdxp-phase={clave}>
                      <span class="kdxp-state__id">{clave}</span>
                      <span class="kdxp-state__es">{nombre}</span>
                      <span class="kdxp-state__amp">{valor}</span>
                    </div>
                  ))}
                </div>
                <button class="kdxp-action kdxp-action--ghost" style="margin-top:8px" type="button" data-kdx-archive-shift>
                  <span data-kdx-archive-name>EXCAVATION · E00</span>
                </button>
              </KdxPanel>

            </div>
          </div>

          {/* -------------------- banda inferior · 09..11 -------------------- */}
          <div class="kdxp-band">
            <KdxPanel n="08" label="RENDER CHAIN" aside="ENGINE">
              <dl class="kdxp-rows">
                {shaderChain.map(([k, v]) => (
                  <div class="kdxp-row"><dt class="kdxp-row__k">{k}</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v">{v}</dd></div>
                ))}
                <div class="kdxp-row kdxp-row--muted"><dt class="kdxp-row__k">FX CHAIN</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v">{organism.fx_chain.join(' · ')}</dd></div>
                <div class="kdxp-row kdxp-row--muted"><dt class="kdxp-row__k">AUDIO</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v">{organism.audio.routing}</dd></div>
              </dl>
            </KdxPanel>

            {/* 09 · El codigo que corre, citado literal. En el poster esta zona
                se llama SHADER NOTES / PSEUDO-CODE; aca no es pseudo. */}
            <KdxPanel n="09" label="SOURCE" aside="PORTALSOURCE.FRAG">
              <pre class="kdxp-code">{shaderQuote.map(([t, kind]) => (
                <span class:list={['kdxp-code__ln', kind === 'note' && 'kdxp-code__ln--note']}>{t}</span>
              ))}</pre>
            </KdxPanel>

            {/* 10 · La paleta canonica del organismo, con su hex. Es el unico
                sitio donde el color no cuenta contra el presupuesto de acento:
                aca el color ES el dato. */}
            <KdxPanel n="10" label="PALETTE" aside="CANON">
              <div class="kdxp-palette">
                <div class="kdxp-swatches">
                  {organism.paleta.map((hex: string) => (
                    <div class="kdxp-swatch">
                      <span class="kdxp-swatch__chip" style={'background:' + hex}></span>
                      <span class="kdxp-swatch__hex">{hex}</span>
                    </div>
                  ))}
                </div>
                <dl class="kdxp-rows">
                  <div class="kdxp-row kdxp-row--muted"><dt class="kdxp-row__k">SOURCE</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v">organismos[{organism.n}].paleta</dd></div>
                  <div class="kdxp-row kdxp-row--muted"><dt class="kdxp-row__k">COUNT</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v">{organism.paleta.length} HEX</dd></div>
                  <div class="kdxp-row kdxp-row--muted"><dt class="kdxp-row__k">ROLE</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v">ONE ACCENT PER ORGANISM</dd></div>
                </dl>
              </div>
            </KdxPanel>

            {/* 11 · El estrato al que pertenece esta lamina. Si el manifiesto
                no trae volumenes, la zona sale vacia y lo dice: el canon fija
                `preserve_empty_or_unresolved_state`. */}
            <KdxPanel
              n="11"
              label="STRATUM · PORTALES"
              aside={volumenesPortales.length ? volumenesPortales.length + ' VOL' : 'EMPTY'}
              sparse={volumenesPortales.length === 0}
            >
              {volumenesPortales.length ? (
                <div class="kdxp-stratum">
                  <KodexTira
                    volumenes={volumenesPortales}
                    estrato="portales"
                    accent="var(--kdx-red,#FF3833)"
                    class="kdxp-tira"
                  />
                  <dl class="kdxp-rows">
                    <div class="kdxp-row"><dt class="kdxp-row__k">STRATUM</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v">{estratoPortales.n} · {estratoPortales.titulo_es}</dd></div>
                    <div class="kdxp-row kdxp-row--muted"><dt class="kdxp-row__k">VOLUMES</dt><span class="kdxp-row__lead"></span><dd class="kdxp-row__v">{volumenesPortales.length}</dd></div>
                  </dl>
                </div>
              ) : (
                <span>NO VOLUMES IN MANIFEST<br />ABSENCE PRESERVED · NOT FILLED</span>
              )}
            </KdxPanel>
          </div>

          {/* --------- barra inferior: quien emite la hoja --------- */}
          <footer class="kdxp-footbar">
            <span class="kdxp-footbar__mark">KODEX−∞</span>
            <span>{organism.id}</span>
            <span class="kdxp-footbar__strip">
              {/* Marca de indice, no una credencial. El ancho de cada barra
                  sale del propio id del organismo: reproducible, y no afirma
                  nada sobre nada. */}
              <span class="kdxp-strip" aria-hidden="true">
                {stripBars.map((b) => <i style={b}></i>)}
              </span>
            </span>
            {/* Movimiento, no dato. Vive en la barra del pie, que es donde el
                poster pone el zumbido del sistema. */}
            <HiddenMessageBand class="kdxp-message-band" scene="threshold" messages={thresholdMessages} />
            <span class="kdxp-footbar__tag">PATTERN. PROTECT. PERPETUATE.</span>
          </footer>

          {/* El dossier de la obra. Procedencia real; ningun valor de
              telemetria. Se abre desde el panel 01. */}
          <aside
            class="kdx-artifact-panel"
            id="kdx-artifact-panel"
            data-kdx-artifact-panel
            hidden
            aria-hidden="true"
            aria-modal="true"
            role="dialog"
            aria-labelledby="kdx-artifact-title"
          >
            <div class="kdx-artifact-panel__inner">
              <button class="kdx-artifact-panel__close" type="button" data-kdx-artifact-close aria-label="close artifact tab">CLOSE ✕</button>
              <p class="kdx-artifact-panel__eyebrow">{thresholdArtifactRecord.status}</p>
              <h2 class="kdx-artifact-panel__title" id="kdx-artifact-title">{thresholdArtifactRecord.title}</h2>
              <dl class="kdx-artifact-panel__meta">
                <div><dt>Type</dt><dd>{thresholdArtifactRecord.type}</dd></div>
                <div><dt>Origin</dt><dd>{thresholdArtifactRecord.origin}</dd></div>
                <div><dt>Edition</dt><dd>{thresholdArtifactRecord.edition}</dd></div>
                <div><dt>Provenance</dt><dd>{thresholdArtifactRecord.provenance}</dd></div>
                <div><dt>License</dt><dd>{thresholdArtifactRecord.license}</dd></div>
                <div><dt>Availability</dt><dd>{thresholdArtifactRecord.availability}</dd></div>
              </dl>
              <div class="kdx-artifact-panel__actions">
                <a href={thresholdArtifactRecord.dossierHref}>View Dossier</a>
                <a href={thresholdArtifactRecord.collectHref}>Collect</a>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section class="kx-slide kx-slide--quiet" id="quiet-threshold-slide" aria-labelledby="quiet-threshold-label">
        <KodexQuietFrame {...quietFrames["threshold-prologue"]} id="quiet-threshold" />
      </section>

      <section class="kx-slide kx-slide--prologue kx-os-scene kx-os-scene--prologue" id="prologue" aria-labelledby="kdx-prologue-title">
        <div class="kx-slide__in kx-prologue-stage">
          <div class="kx-prologue-stage__scan" aria-hidden="true"></div>
          <div class="kx-prologue-stage__ambient" aria-hidden="true"></div>
          <ParticleField class="kx-prologue-stage__particles" scene="prologue" label="prologue particle field" />
          <aside class="kx-prologue-stage__rail" data-reveal aria-label="prologue status">
            <span>{prologue.code}</span>
            <span>{prologueObservationRecord.status}</span>
          </aside>

          <main class="kx-prologue-stage__body">
            <p class="kx-prologue-stage__kicker" data-reveal>{prologue.kicker}</p>
            <h2 class="kx-prologue-stage__title" id="kdx-prologue-title" data-reveal>
              <span>THE ARCHIVE</span>
              <span>IS WATCHING.</span>
            </h2>
            <p class="kx-prologue-stage__statement" data-reveal>YOU ARE NOT ALONE.</p>
            <p class="kx-prologue-stage__mantra" data-reveal>A SIGNAL.<br />A SYSTEM.<br />A CHOICE.</p>
            <div class="kx-prologue-stage__actions" data-reveal>
              <a class="kx-prologue-stage__cta" href="/kodex/folio/ii/">{prologue.cta}</a>
              <button class="kx-prologue-stage__protocol-trigger" type="button" data-kdx-protocol-open aria-expanded="false" aria-controls="kdx-protocol-panel">READ THE PROTOCOL</button>
            </div>
            <dl class="kx-prologue-stage__meta" data-reveal>
              {prologueRows.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </main>

          <figure class="kx-prologue-stage__visual" data-reveal>
            <div class="kx-prologue-stage__eye-field" data-kdx-prologue-eye aria-hidden="true">
              <span class="kx-prologue-stage__dust"></span>
              <span class="kx-prologue-stage__pulse"></span>
              <svg class="kx-prologue-stage__orbit kx-prologue-stage__orbit--outer" viewBox="0 0 520 520" focusable="false">
                <circle cx="260" cy="260" r="212"></circle>
                <ellipse cx="260" cy="260" rx="238" ry="144"></ellipse>
                <ellipse cx="260" cy="260" rx="176" ry="236" transform="rotate(-28 260 260)"></ellipse>
                <path d="M84 260C120 160 198 86 260 86C338 86 414 152 448 260"></path>
              </svg>
              <svg class="kx-prologue-stage__orbit kx-prologue-stage__orbit--inner" viewBox="0 0 520 520" focusable="false">
                <circle cx="260" cy="260" r="164"></circle>
                <ellipse cx="260" cy="260" rx="198" ry="118" transform="rotate(14 260 260)"></ellipse>
                <path d="M112 214C154 186 212 170 260 170C318 170 372 188 408 220"></path>
                <path d="M118 308C164 340 214 354 260 354C314 354 366 338 406 302"></path>
              </svg>
              <svg class="kx-prologue-stage__reticle" viewBox="0 0 520 520" focusable="false">
                <path d="M260 52V132M260 388V468M52 260H132M388 260H468"></path>
                <path d="M132 132L176 176M344 344L388 388M388 132L344 176M176 344L132 388"></path>
                <circle cx="260" cy="260" r="94"></circle>
              </svg>
              <svg class="kx-prologue-stage__wave" viewBox="0 0 520 520" focusable="false">
                <path d="M74 266C104 250 124 228 150 228C184 228 192 292 228 292C254 292 262 230 292 230C324 230 334 310 374 310C402 310 420 286 446 270"></path>
              </svg>
              <div class="kx-prologue-stage__eye-art">
                <svg class="kx-prologue-stage__eye-shell" viewBox="0 0 520 520" focusable="false">
                  <path d="M54 260C106 170 186 110 260 110C334 110 414 170 466 260C414 350 334 410 260 410C186 410 106 350 54 260Z"></path>
                  <path d="M112 260C150 202 202 168 260 168C318 168 370 202 408 260C370 318 318 352 260 352C202 352 150 318 112 260Z"></path>
                </svg>
                <svg class="kx-prologue-stage__eye-iris" viewBox="0 0 520 520" focusable="false">
                  <circle cx="260" cy="260" r="82"></circle>
                  <circle cx="260" cy="260" r="54"></circle>
                  <path d="M260 178C304 178 342 216 342 260C342 304 304 342 260 342C216 342 178 304 178 260C178 216 216 178 260 178Z"></path>
                </svg>
                <div class="kx-prologue-stage__pupil-anchor">
                  <span class="kx-prologue-stage__pupil"></span>
                  <span class="kx-prologue-stage__pupil-glint"></span>
                </div>
                <SpriteSignal
                  class="kx-prologue-stage__sprite-signal"
                  scene="prologue"
                  sprite="/assets/kodex/sprites/observation-eye-blink.png"
                  frames={12}
                  width={180}
                  height={180}
                  label="prologue blink signal"
                />
              </div>
              <span class="kx-prologue-stage__crosshair" aria-hidden="true"></span>
            </div>
            <HiddenMessageBand class="kx-prologue-stage__message-band" scene="prologue" messages={prologueMessages} />
            <figcaption>{prologueObservationRecord.microLabel}</figcaption>
          </figure>

          <aside class="kx-prologue-stage__protocol-card" data-reveal aria-label="protocol status">
            <p>NODE · {prologue.node}</p>
            <p>PROTOCOL · {prologue.protocol}</p>
            <p>STATUS · {prologueObservationRecord.status}</p>
          </aside>

          <aside
            class="kx-prologue-stage__protocol-panel"
            id="kdx-protocol-panel"
            data-kdx-protocol-panel
            hidden
            aria-hidden="true"
            aria-modal="true"
            role="dialog"
            aria-labelledby="kdx-protocol-title"
          >
            <div class="kx-prologue-stage__protocol-inner">
              <button class="kx-prologue-stage__protocol-close" type="button" data-kdx-protocol-close aria-label="close protocol">CLOSE ✕</button>
              <p class="kx-prologue-stage__protocol-kicker">{prologue.kicker}</p>
              <h3 class="kx-prologue-stage__protocol-title" id="kdx-protocol-title">{prologueObservationRecord.title}</h3>
              <p class="kx-prologue-stage__protocol-copy">The archive detects relation before identity. Observation is reciprocal: the system reads the visitor, then returns a changed memory.</p>
              <ul class="kx-prologue-stage__protocol-list">
                {prologueObservationRecord.notes.map((note) => <li>{note}</li>)}
              </ul>
              <dl class="kx-prologue-stage__protocol-meta">
                <div><dt>Archive</dt><dd>{prologueObservationRecord.archive}</dd></div>
                <div><dt>Signal</dt><dd>{prologueObservationRecord.signal}</dd></div>
                <div><dt>Clearance</dt><dd>{prologueObservationRecord.clearance}</dd></div>
                <div><dt>Operator</dt><dd>{prologueObservationRecord.operator}</dd></div>
                <div><dt>Checksum</dt><dd>{prologueObservationRecord.checksum}</dd></div>
                <div><dt>Timestamp</dt><dd>{prologueObservationRecord.timestamp}</dd></div>
              </dl>
            </div>
          </aside>
        </div>
      </section>
    </div>

    <KodexOverlays gallery={false} />
  </div>

  <script>
    import { initKx } from '../../scripts/kodex-engine.js';
    import '../../components/kodex/panels/kdx-runtime-readout.ts';
    initKx();
  </script>
</Base>
