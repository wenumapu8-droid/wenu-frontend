---
// KODEX−∞ — Threshold shell only.
// This route stays fullscreen, zero-scroll, and acts as the first persistent node
// of the KODEX journey. Other scenes remain untouched until owner approval.
import Base from '../../layouts/Base.astro';
import KodexChrome from '../../components/KodexChrome.astro';
import KodexOverlays from '../../components/KodexOverlays.astro';
import '../../styles/kodex.css';
import { hero, folios } from '../../lib/kodexBook.js';

const artifact = {
  state: '× ARCHIVED',
  title: `${hero.name} · Threshold Source`,
  type: 'Archive work / portal source',
  origin: 'Original archive work + live portal shell',
  edition: 'Uneditioned source',
  year: '2026',
  provenance: 'Ocin / Wenu Mapu / KODEX−∞',
  chain: 'Not on-chain',
  license: 'All rights reserved',
  availability: 'Threshold source only',
  dossierHref: '/kodex/works/',
  collectHref: '/kodex/store/',
};
---

<Base
  title="KODEX−∞ — Arquitecturas Tecno-Tribales"
  description="A living archive of pattern, memory, code and resonance inside the world of Wenu Mapu. A digital book: descend folio by folio."
  robots="index, follow"
  ogImage={hero.src}
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div
    class="kx kx--deck kx--threshold"
    data-kx
    data-stage-idx="0"
    data-stage-name="THRESHOLD"
    data-stage-col="255,39,51"
    data-next-label="ENTER THE SYSTEM"
    data-next-url={`/kodex/folio/${folios[0].slug}/`}
  >
    <KodexChrome segs={7} />

    <div class="kx-deck" data-deck>
      <!-- 00 · THRESHOLD — only the gate, no mixed scenes below the fold -->
      <section class="kx-slide kx-slide--threshold" id="threshold">
        <div class="kx-slide__in kx-threshold">
          <div class="kx-threshold__field" aria-hidden="true">
            <span class="kx-threshold__portal"></span>
            <span class="kx-threshold__ring kx-threshold__ring--a"></span>
            <span class="kx-threshold__ring kx-threshold__ring--b"></span>
            <span class="kx-threshold__dots"></span>
          </div>

          <aside class="kx-threshold__rail" aria-label="threshold metadata" data-reveal>
            <span>Threshold source</span>
            <span>{hero.name}</span>
          </aside>

          <main class="kx-threshold__body">
            <p class="kx-threshold__kicker" data-reveal>DESCENT · THRESHOLD SOURCE</p>
            <p class="kx-threshold__command" data-reveal>
              <span>THE ARCHIVE</span>
              <span>DOES NOT STORE.</span>
              <span>IT REMEMBERS.</span>
            </p>
            <p class="kx-threshold__lede" data-reveal>
              A living system of matter,<br />
              memory and generative code.
            </p>
            <a class="kx-threshold__cta" href={`/kodex/folio/${folios[0].slug}/`} data-reveal>
              <span>ENTER THE SYSTEM →</span>
            </a>
          </main>

          <figure class="kx-threshold__artifact" data-reveal>
            <div class="kx-threshold__artifact-core">
              <img src={hero.src} alt={`KODEX−∞ threshold source work ${hero.name}`} loading="eager" />
            </div>
            <button
              class="kdx-artifact-tab"
              type="button"
              data-kdx-artifact-open
              aria-expanded="false"
              aria-controls="kdx-artifact-panel"
              aria-label="open artifact details"
            >
              <span class="kdx-artifact-tab__fold" aria-hidden="true"></span>
              <span class="kdx-artifact-tab__glyph">◈</span>
            </button>
            <figcaption>{hero.name} · threshold source</figcaption>
          </figure>

          <aside
            class="kdx-artifact-panel"
            id="kdx-artifact-panel"
            data-kdx-artifact-panel
            hidden
            aria-hidden="true"
            aria-modal="true"
            role="dialog"
            aria-labelledby="kdx-artifact-title"
          >
            <div class="kdx-artifact-panel__inner">
              <button class="kdx-artifact-panel__close" type="button" data-kdx-artifact-close aria-label="close artifact tab">CLOSE ✕</button>
              <p class="kdx-artifact-panel__eyebrow">{artifact.state}</p>
              <h2 class="kdx-artifact-panel__title" id="kdx-artifact-title">{artifact.title}</h2>
              <dl class="kdx-artifact-panel__meta">
                <div><dt>Type</dt><dd>{artifact.type}</dd></div>
                <div><dt>Origin</dt><dd>{artifact.origin}</dd></div>
                <div><dt>Edition</dt><dd>{artifact.edition}</dd></div>
                <div><dt>Year</dt><dd>{artifact.year}</dd></div>
                <div><dt>Provenance</dt><dd>{artifact.provenance}</dd></div>
                <div><dt>Chain</dt><dd>{artifact.chain}</dd></div>
                <div><dt>License</dt><dd>{artifact.license}</dd></div>
                <div><dt>Availability</dt><dd>{artifact.availability}</dd></div>
              </dl>
              <div class="kdx-artifact-panel__actions">
                <a href={artifact.dossierHref}>View Dossier</a>
                <a href={artifact.collectHref}>Collect</a>
              </div>
            </div>
          </aside>

          <div class="kx-threshold__seal" data-reveal aria-hidden="true">
            <svg viewBox="0 0 100 100" focusable="false">
              <use href="/assets/kodex/kodex-sprite.svg#kdx-target" />
            </svg>
          </div>

          <div class="kx-threshold__barcode" aria-hidden="true" data-reveal>
            <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
            <span>KDX-00-THRESHOLD-ARCHIVED</span>
          </div>
        </div>
      </section>
    </div>

    <KodexOverlays gallery={false} />
  </div>

  <script>
    import { initKx } from '../../scripts/kodex-engine.js';
    initKx();
  </script>
</Base>
