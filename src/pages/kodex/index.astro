---
import Base from '../../layouts/Base.astro';
import DescansoVisual from '../../components/kodex/os/DescansoVisual.astro';
import KodexChrome from '../../components/KodexChrome.astro';
// P0 · el campo morfogenetico que sobrevive a la navegacion.
import CampoPersistente from '../../components/kodex/os/CampoPersistente.astro';
// P1 · la obra de Ocin entra al campo como materia computacional.
import CampoMateria from '../../components/kodex/os/CampoMateria.astro';
// TELAR · 2026-08-30 · THRESHOLD es la PUERTA: era la unica escena del
// corredor sin el instrumento completo. Tenia vector y registro (769f4a73)
// pero no riel, ni traza, ni punto, ni carril -- lo primero que ve
// cualquiera era lo menos KODEX del sitio.
import RielInstrumento from '../../components/kodex/os/RielInstrumento.astro';
// TELAR · 2026-08-30 · SignalWaveform existia con CERO importaciones, y
// kodex-engine.js:439 ya buscaba su selector para animarla. Dos huerfanos
// que se buscaban: el motor animaba algo que nunca se monto.
import SignalWaveform from '../../components/kodex/motion/SignalWaveform.astro';
import TrazaViva from '../../components/kodex/os/TrazaViva.astro';
import PuntoSenal from '../../components/kodex/os/PuntoSenal.astro';
import CarrilEstados from '../../components/kodex/os/CarrilEstados.astro';
import KodexOverlays from '../../components/KodexOverlays.astro';
import '../../styles/kodex.css';
/* Sólo la capa de cromo: el umbral compone distinto y no firma el contrato de
   escena. Lo que sí comparte es la barra, la navegación y los blancos táctiles. */
import '../../styles/kodex-plate.css';
import '../../styles/kodex-instrumento.css';
import { plateId, KDX_PLATE_CONTRACT_VERSION } from '../../lib/kodex/plancha/plate-contract';
import { contratoDe } from '../../lib/kodex/contrato-escena';

/**
 * CONTRATO DE THRESHOLD.
 *
 * Era la única de las siete que no declaraba nada, así que el gate no podía
 * medirle ni organismo ni causalidad — y es, con diferencia, la escena MÁS
 * viva del corredor (43.5% de vida en reposo el 26-08, contra 0.01% de
 * PROLOGUE). Medirla importa justamente porque es la que funciona.
 *
 * Su organismo es el campo de partículas, NO el campo de shaders: el canon
 * pide proteger la identidad rojo/negro de apertura de esta escena y no
 * reconstruirla sin evidencia. Acá sólo se declara lo que ya existe.
 */
const contratoUmbral = contratoDe('THRESHOLD', {
  organismo: '.kx-threshold__particles',
});
import '../../styles/kodex-motion.css';
import HiddenMessageBand from '../../components/kodex/motion/HiddenMessageBand.astro';
import ParticleField from '../../components/kodex/motion/ParticleField.astro';
import SpriteSignal from '../../components/kodex/motion/SpriteSignal.astro';
import KodexPortal from '../../components/kodex/portal/KodexPortal.astro';
import KodexTransition from '../../components/kodex/transition/KodexTransition.astro';
import TituloGlitch from '../../components/kodex/os/TituloGlitch.astro';
import CampoPortada from '../../components/kodex/os/CampoPortada.astro';
import KodexDebug from '../../components/kodex/debug/KodexDebug.astro';
import KodexQuietFrame from '../../components/kodex/interludes/KodexQuietFrame.astro';
/* El umbral registra el paso: es el primer evento del recorrido y el que
   RETURN lee para armar el espécimen. Ver KodexRecuerda.astro. */
import KodexRecuerda from '../../components/kodex/KodexRecuerda.astro';
/* El copy del umbral no se escribe acá: se lee de la definición de escena, que
   lo trae textual de la P0 Scene Bible. La compuerta de terminado exige "copy
   and visual behavior match the canon", y con el texto suelto en la plantilla
   eso no se puede verificar — se corrige tocando dos archivos y nadie se entera. */
import { THRESHOLD } from '../../lib/kodex/escenas/threshold';
/* 2026-08-28 · EL CHASIS DEL BOARD. Estos dos instrumentos existian en el
   repo con CERO importaciones: se construyeron desde los boards y nunca se
   montaron. Entran ahora, pero con dato REAL -- ver mas abajo. */
import KodexOriginVector from '../../components/kodex/density/KodexOriginVector.astro';
import KodexSystemLog from '../../components/kodex/density/KodexSystemLog.astro';
import { nodosDeEscena, coberturaDelAtlas } from '../../lib/kodex/atlas';
import { leerManifiesto } from '../../lib/kodex/volumenes';

/* El vector de origen del umbral: su posicion REAL en el mapa de conceptos,
   no coordenadas astronomicas inventadas. */
const conceptosUmbral = nodosDeEscena('THRESHOLD');
const atlas = coberturaDelAtlas();
const manifiesto = await leerManifiesto();
const estratosReales = (manifiesto.estratos || []).length;
const volumenesReales = (manifiesto.volumenes || []).length;

const vectorUmbral = {
  ra: `ZONE ${conceptosUmbral.flatMap((n) => n.zonas).filter((z, i, a) => a.indexOf(z) === i).slice(0, 2).join(' / ') || 'UMBRAL'}`,
  dec: `NODES ${conceptosUmbral.length} / ${atlas.total}`,
  sig: `STRATA ${estratosReales}`,
  mod: 'MOD THRESHOLD',
  lines: ['THE GATE IS A', 'LIVING AGREEMENT.'],
  id: conceptosUmbral[0]?.id || 'KDX-IMG-002',
};

/* El registro del sistema: hechos verificables del archivo en el build, no
   marcas de tiempo falsas. */
const registroUmbral = [
  ['ATLAS', `${atlas.total} CONCEPTS / ${atlas.zonas} ZONES`],
  ['MANIFEST', `${volumenesReales} VOLUMES / ${estratosReales} STRATA`],
  ['THRESHOLD', `${conceptosUmbral.length} CONCEPTS DECLARED`],
  ['GAPS', `${atlas.faltantes.length} NODES NOT LOCATED`],
];
import { quietFrames } from '../../lib/kodex/quietFrames';
import '../../styles/kodex-micrographics.css';
import '../../styles/kodex-quiet-frames.css';
import { hero } from '../../lib/kodexBook.js';
import { prologueObservationRecord } from '../../lib/kodexArchiveRecords.js';
import { SCENE_UNIVERSE } from '../../lib/kodexUniverse.js';
import { KODEX_MESSAGES } from '../../lib/kodex/motion-config.js';
import TituloCinetico from '../../components/kodex/os/TituloCinetico.astro';
import { motionVars, recipeFor, gridFor } from '../../lib/kodex/grammar';

// THRESHOLD toma el portal de marmol: su grilla dice "dream field, ambient
// scene", que es exactamente una puerta que todavia no se cruzo.
const thresholdRecipe = recipeFor('threshold');
const thresholdGrid = gridFor('threshold');
const thresholdMotion = motionVars('threshold');

const prologue = SCENE_UNIVERSE.prologue;

/* El único bloque de metadatos que queda en el margen. Es el panel NODE 00 de
   la pantalla de diseño (pend-11: STATE DORMANT · SIGNAL LATENT · ACCESS TYPE
   VOLUNTARY) — el resto del cromo de datos salió: el creador pidió que el
   umbral respire. */
const thresholdNodeRows = [
  ['NODE', 'KDX_00'],
  ['STATE', 'DORMANT'],
  ['SIGNAL', 'LATENT'],
  ['ACCESS', 'VOLUNTARY'],
];

const prologueMessages = KODEX_MESSAGES.prologue;

const prologueRows = [
  ['NODE', prologue.node],
  ['PROTOCOL', prologue.protocol],
  ['STATUS', prologueObservationRecord.status],
];
---

<Base
  title="KODEX−∞ — Living Visual-Computational Archive"
  description="A living archive of pattern, memory, code and resonance inside the world of Wenu Mapu. A digital book: descend folio by folio."
  robots="index, follow"
  ogImage={hero.src}
  kodexFonts={true}
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
  osShell={true}
>
  <CampoPersistente />
  <CampoMateria />
  {/* EL GUARDIA DE LA PUERTA.
      Va EN LÍNEA y antes que todo lo demás porque tiene que ejecutarse
      mientras el documento se parsea: los módulos de Astro corren diferidos y
      para entonces el motor ya habría grabado la visita. La regla del creador
      es "sin memory mutation pasiva" — el archivo recuerda a quien entra, no a
      quien todavía está mirando la puerta.
      Y si el huésped ya cruzó en esta sesión, el velo no vuelve a pedirle
      permiso: volver atrás debe devolverlo donde estaba, no hacerle repetir la
      decisión que ya tomó. */}
  <script is:inline>
    (() => {
      let cruzado = false;
      try { cruzado = sessionStorage.getItem('kx-umbral') === 'cruzado'; } catch (_) {}
      /* VOLVER ATRÁS NO ES LO MISMO QUE VOLVER A LA ENTRADA, y hasta ahora se
         trataban igual. La regla "quien ya cruzó no vuelve a ver el velo" está
         bien para el botón de atrás -- nadie debe pagar dos veces la misma
         decisión -- pero se aplicaba también al recargar y al ir a /kodex/ a
         propósito. Resultado medido: la portada se veía UNA sola vez en la
         vida. Todas las visitas siguientes empezaban en la escena de adentro.
         La portada del KODEX no puede ser una pantalla de un solo uso.
         El tipo de navegación los separa: `back_forward` es el botón de atrás;
         `navigate` y `reload` son alguien llegando a la puerta. */
      let atras = false;
      try { atras = (performance.getEntriesByType('navigation')[0] || {}).type === 'back_forward'; } catch (_) {}
      const raiz = document.documentElement;
      if (cruzado && atras) raiz.setAttribute('data-kdx-umbral-cruzado', '');
      else if (cruzado) raiz.setAttribute('data-kdx-umbral-reconocido', '');
      else raiz.setAttribute('data-kdx-espera-eleccion', '');
    })();
  </script>

  <KodexRecuerda />
  <div
    class="kx kx--deck kx--threshold kx--entry"
    data-kx
    data-kdx-shell={KDX_PLATE_CONTRACT_VERSION}
    data-kdx-plate={plateId('threshold', 'interlude')}
    data-stage-idx="0"
    data-stage-base="0"
    data-stage-total="07"
    data-stage-name="THRESHOLD"
    data-stage-col="255,39,51"
    data-next-label="ENTER THE KODEX"
    data-next-url="/kodex/folio/i/"
    data-sync-deck-hash
    {/* La herramienta de esta lamina: la rueda gira el mandala. Cero scroll de
        pagina -- el documento no se mueve, la pieza si. */}
    data-kdx-tool="girar"
    data-kdx-recipe={thresholdRecipe.id}
    data-kdx-grid={thresholdGrid.id}
    style={thresholdMotion}
  >
    <KodexTransition router={true} />
    <KodexDebug />

    <KodexChrome segs={7} />

    <div class="kx-deck" data-deck>
      <section class="kx-slide kx-slide--threshold" id="threshold" aria-labelledby="kdx-threshold-title">
        <div class="kx-slide__in kx-threshold" {...contratoUmbral}>
          {/* 2026-08-17 · Umbral respirado. La referencia es la pantalla de
              diseño del umbral (pend-11: 00/07 THRESHOLD · una obra central ·
              un titular · una pregunta · ENTER VOLUNTARILY) y el prototipo de
              portada aprobado por el creador (/tmp/kodex-threshold-live.html):
              campo rojo profundo atenuado, THRESHOLD en serif, HUD periférico
              casi invisible, una sola acción. El cromo de datos que había acá
              (rail, meta-zonas, chips, syslog, sysfoot, systemband, origin,
              waveform, panel de artefacto) salió: el diseño muestra UN panel
              de nodo en el margen y nada más compitiendo con la obra. */}

          <div class="kx-threshold__field" aria-hidden="true">
            <ParticleField class="kx-threshold__particles" scene="threshold" label="threshold particle field" />
            <span class="kx-threshold__aura"></span>
          </div>

          {/* ── EL MANDALA NO ABRE LA EXPERIENCIA ────────────────────────────
              El creador, muchas veces y la última hoy: "hay como un mandala al
              comienzo que no es lo que yo quería… está una flor que está buena
              pero no me gusta como para el comienzo".

              Comparado el prototipo que él aprobó (`kodex-threshold-live.html`)
              contra producción, la diferencia era exacta y medible:
                  prototipo    1 canvas · 0 imágenes   -> todo es campo
                  producción   7 canvas · mandala-0cin-negativo.png
              El umbral montaba la portada nueva Y ENCIMA este organismo: el PNG
              del mandala a la vista más un segundo portal alimentado por esa
              misma imagen. Eso es la flor dominando el centro.

              Y contradice su propia descripción del umbral en el manifiesto:
              "Negro casi total. Algo respira. Aparece una pequeña anomalía. La
              anomalía CRECE." Una flor de tamaño completo desde el primer
              cuadro no crece: ya llegó.

              NO SE BORRA NADA. La obra sigue en `/img/kodex/works/`, el
              componente `KodexPortal` sigue entero y se usa en otras
              superficies, y esta composición se puede reponer con un `git
              revert` de este commit. Lo que se retira es su lugar en la PRIMERA
              PANTALLA, que es lo único que él pidió cambiar.

              Lo que queda abriendo es `CampoPortada`, que ES el shader del
              prototipo aprobado. */}

          {/* Marcador de escena, arriba y al centro, como en el diseño:
              progreso siempre visible. */}
          <header class="kx-threshold__marcador" data-reveal>
            <p class="kx-threshold__progreso"><b>00</b> / 07</p>
            <p class="kx-threshold__escena">THRESHOLD · SCENE 00</p>
          </header>

          {/* La identidad sobre el organismo, con la jerarquía del prototipo
              aprobado: cejilla / marca en serif / decreto. El lema es canon
              (THE ARCHIVE DOES NOT STORE. IT REMEMBERS.) partido igual que en
              la portada del creador. */}
          <div class="kx-threshold__identidad">
            <p class="kx-threshold__cejilla" data-reveal>THE ARCHIVE DOES NOT STORE</p>
            {/* 2026-08-28: el titulo del umbral pasa a ser CINETICO.
                Reporte del creador: "el titulo se ve distinto y no es dinamico".
                Tenia razon en las dos cosas y la causa era una: THRESHOLD usaba
                TituloCinetico cero veces -- era un <h1> plano mientras las seis
                escenas de folio si lo usaban. Y el operador por defecto del
                componente, APERTURE, esta documentado en su propia cabecera
                como "el umbral se abre - las letras se separan desde el
                centro": se escribio para esta escena y nunca se le monto.
                El id se conserva porque la seccion lo referencia con
                aria-labelledby. */}
            <TituloCinetico
              texto="KODEX−∞"
              operador="APERTURE"
              id="kdx-threshold-title"
              clase="kx-threshold__marca-cinetico"
            />
            <p class="kx-threshold__decreto" data-reveal>IT&nbsp;&nbsp;<b>REMEMBERS</b></p>
          </div>

          {/* La voz del umbral. Copy canónico de la Scene Bible (líneas 19 y
              25) leído textual de la definición de escena: el pacto, la
              pregunta primaria, y UNA acción — ENTER VOLUNTARILY, que en la
              pantalla de diseño del umbral es literalmente la CTA. */}
          <main class="kx-threshold__voz">
            <p class="kx-threshold__pacto" data-reveal>{THRESHOLD.copy.agreement}</p>
            <p class="kx-threshold__pregunta" data-reveal>
              <span aria-hidden="true">↔</span> {THRESHOLD.copy.question} <span aria-hidden="true">↔</span>
            </p>
            <a class="kx-threshold__entrar" href="/kodex/folio/i/" data-kdx-cruzar data-reveal>
              {THRESHOLD.copy.invitation}
            </a>

            {/* LOS OTROS DOS CAMINOS · 2026-08-28
                El umbral tenia una sola salida: el corredor lineal. La boveda
                de conceptos (/kodex/atlas/) y la navegacion hacia adentro
                (/kodex/inward/) existian y estaban publicadas, pero no se
                llegaba a ellas desde la portada.
                Van DEBAJO y en linea fina a proposito: el pacto del umbral es
                cruzar, y esa sigue siendo la accion dominante. Estos dos
                dejan ver que el archivo tiene mas de una puerta, sin
                competirle a la principal. */}
            <nav class="kx-threshold__caminos" aria-label="other ways in" data-reveal>
              <a href="/kodex/inward/">
                <b>INWARD</b><span>the journey goes in, not down</span>
              </a>
              <a href="/kodex/atlas/">
                <b>THE ATLAS</b><span>every concept and its weave</span>
              </a>
            </nav>

            {/* LOS MUNDOS QUE ESTE UMBRAL ABRE · 2026-09-01
                THRESHOLD declara cinco conceptos en el atlas y hasta hoy los
                usaba solo para calcular lecturas del ORIGIN VECTOR: el numero
                se mostraba, la puerta no. Dos de los cinco (002 Portal Organism
                y 032 Pale Axolotl) no aparecen en ninguna otra escena, asi que
                sin esto quedaban sin una sola entrada desde el corredor.

                Va en LINEA FINA, sin recuadro, debajo de los caminos: la
                jerarquia del umbral es ENTER VOLUNTARILY primero, los dos
                caminos despues, y estos al final. Nombrar los mundos es lo que
                separa "prometo siete mundos" de "aca estan". */}
            {conceptosUmbral.length > 0 && (
              <nav class="kx-threshold__mundos" aria-label="worlds this threshold opens" data-reveal>
                <p class="kx-threshold__mundos-kicker">
                  THIS THRESHOLD OPENS
                  <span data-kdx-readout data-fuente="src/data/kodex-atlas.json:nodosDeEscena('THRESHOLD')">
                    {String(conceptosUmbral.length).padStart(2, '0')}
                  </span>
                </p>
                <ul>
                  {conceptosUmbral.map((n) => (
                    <li>
                      <a href={`/kodex/concepto/${n.id.toLowerCase()}/`}>{n.titulo}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
          </main>

          {/* EL CHASIS DEL BOARD · 2026-08-28
              Los boards muestran instrumentos flotando en los margenes:
              ORIGIN VECTOR arriba a la derecha, SYSTEM LOG abajo. Los dos
              componentes existian con cero importaciones -- construidos desde
              los boards y nunca montados.
              Entran con DATO REAL, no con sus defaults inventados: el vector
              de origen del umbral es su posicion en el mapa de conceptos del
              atlas, y el registro son hechos verificables del archivo en el
              build. Cada lectura lleva su data-fuente. */}
          <KodexOriginVector
            ra={vectorUmbral.ra}
            dec={vectorUmbral.dec}
            sig={vectorUmbral.sig}
            mod={vectorUmbral.mod}
            lines={vectorUmbral.lines}
            id={vectorUmbral.id}
            class="kx-threshold__vector"
          />
          {/* TELAR · el aparato compartido llega al umbral. THRESHOLD es
              escena 00 del corredor: monta el MISMO instrumento que las
              otras seis, con su ACCESS TYPE propio (todavia nadie entro). */}
          <RielInstrumento
            lado="izq"
            nodo="00"
            senal="LATENT"
            acceso="VISITOR"
            class="kx-os-stage__riel-izq"
          />
          <RielInstrumento
            lado="der"
            profundidad="00"
            class="kx-os-stage__riel-der"
          />
          <PuntoSenal base="LATENT" class="kx-os-stage__punto" />

          {/* La onda del umbral. `scene="threshold"` es lo que la engancha
              al motor: kodex-engine.js:439 busca exactamente ese selector.
              El CSS ya estaba escrito en kodex-motion.css, con su color
              propio y su respeto por prefers-reduced-motion. */}
          <div class="kx-threshold__waveform">
            <SignalWaveform scene="threshold" />
          </div>

          {/* El carril de estados: en el umbral el viaje todavia no
              empezo, asi que muestra los seis pasos con DORMANT encendido.
              Ver el camino completo ANTES de cruzarlo es parte del
              consentimiento -- nadie entra a ciegas. */}
          <CarrilEstados />

          {/* La barra de las siete con THRESHOLD (00) encendida. */}
          <TrazaViva actual={0} class="kx-os-stage__traza" />

          <KodexSystemLog
            entries={registroUmbral}
            checksum={`ATLAS-${atlas.total}-${atlas.zonas}Z`}
            verifyAt="src/data/kodex-atlas.json"
            threatLabel={`${atlas.total - atlas.conEscena} CONCEPTS AWAIT CURATION`}
            class="kx-threshold__registro"
          />

          {/* El panel de nodo: único cromo de datos del margen, casi
              invisible, como el HUD periférico del prototipo. */}
          <aside class="kx-threshold__nodo" aria-label="node status" data-reveal>
            {thresholdNodeRows.map(([label, value]) => (
              <p><span>{label}</span><b class={label === 'SIGNAL' ? 'is-latente' : undefined}>{value}</b></p>
            ))}
          </aside>

{/* DECISIÓN DE CANON, NO DE GUSTO.
    El linaje de PR #101 traía acá el umbral-tablero: kicker, serial con
    checksum, tabla de metadatos, chips de estado, log de sistema con
    timestamps y pie de sistema. Es trabajo real y está bien hecho, pero el
    manifiesto del 21-08 lo prohíbe con todas las letras:
    "ESCONDER EL SISTEMA, MOSTRAR EL UNIVERSO" y "nunca SYSTEM → METADATA →
    BUTTONS → explanation → artwork".
    Y la portada que queda -- campo del prototipo + palabra viva + dos puertas
    -- es la que el creador pidió tres veces por nombre de archivo.
    Lo de #101 no se pierde: su instrumentación vive en KodexSystemLog y
    KodexSystemFooter, que siguen en el árbol y se pueden invocar donde la
    densidad SÍ sea el punto. Lo que no vuelve es a la primera pantalla. */}
          {/* EL VELO — la portada que le encantó al creador. Cubre la escena
              con el campo respirando atenuado detrás; THRESHOLD en serif; una
              sola acción. Tocar en cualquier parte = entrar con sonido (la
              rama data-kdx-sonido="1" de la bifurcación canónica); el fantasma
              CONTINUE IN SILENCE es la otra rama. Al elegir, el velo se
              disuelve y revela la escena — no navega. */}
          <div class="kx-veil" data-kdx-veil>
            {/* LA PORTADA. El campo del prototipo que el creador aprobó, vivo detrás
                de la palabra: warp radial, mandala, dither Bayer, scanlines, croma y
                grano. Su shader, portado entero. */}
            <CampoPortada estado={0.15} class="kx-veil__campo" />
            {/* ── LA COMPOSICIÓN DEL PROTOTIPO, TEXTUAL ─────────────────────
                El creador señaló muchas veces que "la portada aún no se ve
                así". Comparando su `kodex-threshold-live.html` contra
                producción, la última diferencia no era el shader —ese ya está
                igualado— sino QUÉ DICE la primera pantalla:

                    prototipo    THE ARCHIVE DOES NOT STORE
                                 KODEX−∞
                                 IT REMEMBERS

                    producción   KODEX −∞
                                 THRESHOLD

                Producción abría con la ETIQUETA de la escena. El prototipo
                abre con el nombre y con la frase que lo define. No es lo
                mismo llegar a un rótulo que llegar a una declaración.

                Se toma la composición de su prototipo tal cual, en el mismo
                orden. Las dos puertas quedan: la elección sigue siendo suya. */}
            <p class="kx-veil__cejilla">THE ARCHIVE DOES NOT STORE</p>
            {/* La palabra, con el eje partiéndose y volviendo. El texto real
                está en el HTML servido y se lee en el primer cuadro; el glitch
                corre encima y no retrasa ni la lectura ni la acción. */}
            <TituloGlitch texto="KODEX−∞" como="p" class="kx-veil__marca" tempo="umbral" />
            <p class="kx-veil__decreto">IT&nbsp; <b>REMEMBERS</b></p>
            {/* 2026-08-28: subtitulo del board 00-THRESHOLD.png. */}
            <p class="kx-veil__lema">A LIVING SYSTEM OF MATTER, MEMORY AND GENERATIVE CODE</p>
            {/* ── EL PACTO SUBE A LA PORTADA ────────────────────────────
                Hasta acá la entrada eran dos pantallas: la portada elegía el
                sonido y, al disolverse, una segunda pantalla pedía el acuerdo
                y volvía a ofrecer entrar. El visitante entraba dos veces al
                mismo lugar y leía las mismas tres líneas seguidas.

                El canon 14 dice que THRESHOLD es "el centro parece una
                abertura", en singular. Una puerta. El acuerdo y la elección de
                sonido son la misma decisión y se piden en la misma respiración.

                Nada se mueve de sitio en el documento: el pacto sigue viviendo
                en la escena para quien llegue directo a ella. Acá se dice, y
