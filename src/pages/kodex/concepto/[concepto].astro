---
/**
 * KODEX−∞ · UN MUNDO POR CONCEPTO.
 *
 * POR QUE EXISTE (2026-08-28):
 * Los 36 conceptos del atlas estaban entrando al corredor como una LISTA
 * dentro de un cajon. Eso es un menu, no un multiverso: no se podia IR a un
 * concepto, solo leer su nombre. El creador lo dijo sin vueltas -- "siguen
 * habiendo solo 7 escenas, necesito que esten todos los multiversos".
 * Tenia razon.
 *
 * Cada concepto pasa a ser un LUGAR con direccion propia. Las siete escenas
 * son los umbrales; estos son los mundos que abren.
 *
 * EL ENTRELAZADO ES NAVEGABLE:
 * El atlas declara DOS o TRES zonas por concepto. Eso no es metadato suelto:
 * es lo que conecta mundos que en el corredor lineal quedan lejos. Event
 * Horizon (COSMOS/ANOMALIA/DESCENSO) y Altered State (CONCIENCIA/MAQUINA/
 * DESCENSO) comparten DESCENSO, y desde uno se salta al otro sin volver al
 * pasillo. Eso es el enlace entre mundos paralelos, hecho ruta.
 *
 * HONESTIDAD: solo se muestra lo que el atlas trae. Un concepto sin
 * implementacion declarada NO recibe una inventada -- se dice que falta.
 */
import KodexShell from '../../../layouts/KodexShell.astro';
import { nodosDelAtlas, nodoPorId, vecinosDe } from '../../../lib/kodex/atlas';

export function getStaticPaths() {
  return nodosDelAtlas().map((n) => ({
    params: { concepto: n.id.toLowerCase() },
    props: { id: n.id },
  }));
}

const { id } = Astro.props;
const n = nodoPorId(id)!;
const vecinos = vecinosDe(id);

/* Los vecinos se agrupan POR LA ZONA QUE COMPARTEN: asi el visitante ve por
   que dos mundos se tocan, en vez de una lista plana de "relacionados". */
const puentes = n.zonas
  .map((z) => ({ zona: z, otros: vecinos.filter((v) => v.zonas.includes(z)) }))
  .filter((p) => p.otros.length > 0);

const ACENTO: Record<string, string> = {
  THRESHOLD: '#FF3833', PROLOGUE: '#E8A33D', DESCENT: '#FF6A00',
  ARCHIVE: '#3DE8A3', MACHINE: '#8AA6FF', COSMOLOGY: '#FF00C8', RETURN: '#E8A33D',
};
const acento = ACENTO[n.escenas[0]] || '#E8A33D';

const RUTA: Record<string, string> = {
  THRESHOLD: '/kodex/', PROLOGUE: '/kodex/folio/i/', DESCENT: '/kodex/folio/ii/',
  ARCHIVE: '/kodex/folio/iii/', MACHINE: '/kodex/folio/iv/',
  COSMOLOGY: '/kodex/folio/v/', RETURN: '/kodex/folio/vi/',
};
---

<KodexShell title={`${n.titulo} — KODEX−∞`} description={n.concepto || n.titulo}>
  <main class="kdx-mundo" style={`--mundo-acento:${acento};`} data-kdx-concepto={n.id}>

    <header class="kdx-mundo__cabecera">
      <p class="kdx-mundo__id">{n.id}</p>
      <h1 class="kdx-mundo__titulo">{n.titulo}</h1>
      {n.copy && <p class="kdx-mundo__copy">{n.copy}</p>}
    </header>

    {n.concepto && (
      <section class="kdx-mundo__bloque">
        <h2>CONCEPT</h2>
        <p class="kdx-mundo__concepto">{n.concepto}</p>
      </section>
    )}

    {n.interaccion && (
      <section class="kdx-mundo__bloque kdx-mundo__bloque--vivo">
        <h2>HOW IT ANSWERS</h2>
        <p>{n.interaccion}</p>
        {/* Lo que este mundo hace cuando lo tocas. Esta declarado en el atlas
            y todavia no construido: se dice, no se finge. */}
        <p class="kdx-mundo__pendiente">SPECIFIED · NOT YET BUILT</p>
      </section>
    )}

    {n.implementacion && (
      <section class="kdx-mundo__bloque">
        <h2>IMPLEMENTATION</h2>
        <p class="kdx-mundo__tecnico">{n.implementacion}</p>
      </section>
    )}

    <section class="kdx-mundo__bloque">
      <h2>COORDINATES</h2>
      <dl class="kdx-mundo__coords">
        <div>
          <dt>ZONES</dt>
          <dd data-kdx-readout data-fuente="src/data/kodex-atlas.json:zonas">{n.zonas.join(' · ') || '—'}</dd>
        </div>
        <div>
          <dt>THRESHOLD</dt>
          <dd data-kdx-readout data-fuente="src/data/kodex-atlas.json:escenas">
            {n.escenas.length
              ? n.escenas.map((e) => <a href={RUTA[e] || '/kodex/'}>{e}</a>)
              : 'NOT DECLARED'}
          </dd>
        </div>
        {n.taxonomia && (
          <div>
            <dt>TAXONOMY</dt>
            <dd data-kdx-readout data-fuente="src/data/kodex-atlas.json:taxonomia">{n.taxonomia}</dd>
          </div>
        )}
        {n.geometria && (
          <div>
            <dt>GEOMETRY</dt>
            <dd data-kdx-readout data-fuente="src/data/kodex-atlas.json:geometria">{n.geometria}</dd>
          </div>
        )}
        {n.paleta && (
          <div>
            <dt>PALETTE</dt>
            <dd data-kdx-readout data-fuente="src/data/kodex-atlas.json:paleta">{n.paleta}</dd>
          </div>
        )}
        {n.sonido && (
          <div>
            <dt>SOUND</dt>
            <dd data-kdx-readout data-fuente="src/data/kodex-atlas.json:sonido">{n.sonido}</dd>
          </div>
        )}
        {n.procedencia && (
          <div class="kdx-mundo__coords-ancho">
            <dt>PROVENANCE</dt>
            <dd data-kdx-readout data-fuente="src/data/kodex-atlas.json:procedencia">{n.procedencia}</dd>
          </div>
        )}
      </dl>
    </section>

    {puentes.length > 0 && (
      <section class="kdx-mundo__bloque">
        <h2>BRIDGES</h2>
        {/* No es una lista de "relacionados": cada puente dice POR QUE dos
            mundos se tocan. Esa es la trama que el atlas declara al dar dos
            zonas por concepto. */}
        <p class="kdx-mundo__nota">Worlds that share a zone with this one.</p>
        {puentes.map(({ zona, otros }) => (
          <div class="kdx-mundo__puente">
            <p class="kdx-mundo__puente-zona">{zona}</p>
            <ul>
              {otros.map((v) => (
                <li>
                  <a href={`/kodex/concepto/${v.id.toLowerCase()}/`}>
                    <b>{v.titulo}</b>
                    <span>{v.id}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )}

    <footer class="kdx-mundo__pie">
      <a href="/kodex/atlas/">← THE ATLAS</a>
      {n.escenas[0] && <a href={RUTA[n.escenas[0]] || '/kodex/'}>{n.escenas[0]} →</a>}
    </footer>
  </main>
</KodexShell>

<style>
  .kdx-mundo{
    min-height:100dvh; padding:clamp(52px,8vh,96px) clamp(18px,5vw,64px) 88px;
    background:#08070a; color:#c9c6c0;
    font-family:'IBM Plex Mono',ui-monospace,monospace;
    max-width:940px; margin:0 auto;
  }
  .kdx-mundo__cabecera{ margin-bottom:clamp(34px,5vh,60px); }
  .kdx-mundo__id{ margin:0 0 1.4em; font-size:10px; letter-spacing:.3em; color:var(--mundo-acento); opacity:.8; }
  .kdx-mundo__titulo{
    margin:0; font-family:'Instrument Serif',ui-serif,serif; font-weight:400;
    font-size:clamp(2rem,7vw,3.4rem); line-height:1.05; color:#f0ede8;
  }
  .kdx-mundo__copy{
    margin:1.1em 0 0; font-family:'Instrument Serif',ui-serif,serif; font-style:italic;
    font-size:clamp(1rem,3vw,1.32rem); line-height:1.35;
    color:color-mix(in srgb, var(--mundo-acento) 82%, #f0ede8);
  }

  .kdx-mundo__bloque{
    margin-bottom:clamp(26px,4vh,44px); padding-top:16px;
    border-top:1px solid color-mix(in srgb, var(--mundo-acento) 20%, transparent);
  }
  .kdx-mundo__bloque h2{
    margin:0 0 .9em; font-size:9.5px; font-weight:400; letter-spacing:.28em;
    color:var(--mundo-acento);
  }
  .kdx-mundo__bloque p{ margin:0 0 .7em; font-size:12.5px; line-height:1.65; color:#a5a19a; }
  .kdx-mundo__concepto{ font-size:14px !important; color:#c9c6c0 !important; max-width:64ch; }
  .kdx-mundo__tecnico{ font-size:11.5px !important; color:#86827b !important; }
  .kdx-mundo__nota{ font-size:11px !important; color:#6f6c66 !important; font-style:italic; }

  .kdx-mundo__bloque--vivo{
    position:relative; padding-left:14px;
    border-left:1px solid color-mix(in srgb, var(--mundo-acento) 34%, transparent);
  }
  .kdx-mundo__pendiente{
    display:inline-block; margin-top:.4em !important; padding:3px 8px;
    font-size:9px !important; letter-spacing:.18em; color:var(--mundo-acento) !important;
    border:1px solid color-mix(in srgb, var(--mundo-acento) 30%, transparent);
  }

  .kdx-mundo__coords{ display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:1px; margin:0; }
  .kdx-mundo__coords div{ padding:11px 12px; border:1px solid color-mix(in srgb, var(--mundo-acento) 13%, transparent); }
  .kdx-mundo__coords-ancho{ grid-column:1 / -1; }
  .kdx-mundo__coords dt{ font-size:9px; letter-spacing:.2em; color:#6f6c66; }
  .kdx-mundo__coords dd{ margin:.55em 0 0; font-size:11px; line-height:1.5; color:#b4b0a9; }
  .kdx-mundo__coords dd a{ color:var(--mundo-acento); text-decoration:none; margin-right:.6em; }
  .kdx-mundo__coords dd a:hover{ text-decoration:underline; }

  .kdx-mundo__puente{ margin-bottom:18px; }
  .kdx-mundo__puente-zona{
    margin:0 0 .6em !important; font-size:9.5px !important; letter-spacing:.22em;
    color:var(--mundo-acento) !important; opacity:.85;
  }
  .kdx-mundo__puente ul{ display:grid; grid-template-columns:repeat(auto-fill,minmax(min(100%,240px),1fr)); gap:8px; margin:0; padding:0; list-style:none; }
  .kdx-mundo__puente a{
    position:relative; display:flex; flex-direction:column; gap:3px; padding:10px 12px;
    text-decoration:none;
    border:1px solid color-mix(in srgb, var(--mundo-acento) 15%, transparent);
    transition:border-color 380ms ease, transform 380ms ease;
  }
  .kdx-mundo__puente a::before{
    content:''; position:absolute; top:-1px; left:-1px; width:7px; height:7px;
    border:1px solid var(--mundo-acento); border-right:0; border-bottom:0; opacity:.5;
  }
  .kdx-mundo__puente a:hover{ border-color:color-mix(in srgb, var(--mundo-acento) 45%, transparent); transform:translateY(-2px); }
  .kdx-mundo__puente b{ font-family:'Instrument Serif',ui-serif,serif; font-weight:400; font-size:13px; color:#f0ede8; }
  .kdx-mundo__puente span{ font-size:9px; letter-spacing:.14em; color:#6f6c66; }

  .kdx-mundo__pie{
    display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap;
    margin-top:clamp(40px,6vh,72px); padding-top:18px;
    border-top:1px solid color-mix(in srgb, var(--mundo-acento) 20%, transparent);
  }
  .kdx-mundo__pie a{ font-size:10px; letter-spacing:.22em; color:var(--mundo-acento); text-decoration:none; }
  .kdx-mundo__pie a:hover{ text-decoration:underline; }

  @media (max-width:640px){
    .kdx-mundo__coords{ grid-template-columns:1fr; }
    .kdx-mundo__puente ul{ grid-template-columns:1fr; }
  }
  @media (prefers-reduced-motion: reduce){
    .kdx-mundo__puente a{ transition:none; }
    .kdx-mundo__puente a:hover{ transform:none; }
  }
</style>
