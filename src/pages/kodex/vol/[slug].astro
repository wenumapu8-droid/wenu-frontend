---
/**
 * KODEX-∞ · VOLUMEN
 *
 * Una ruta para toda la biblioteca. Agregar un volumen al manifiesto crea su
 * página; acá no se escribe nada.
 *
 * El héroe es la obra real tratada — o, mientras no exista, **el organismo
 * vivo** teñido con el color de su estrato. Esa caída no es un placeholder: un
 * volumen sin obra igual tiene un cuerpo, porque el sistema genera. Es la
 * diferencia entre una biblioteca que espera a estar llena y una que ya está
 * viva y se va llenando.
 */
import Base from '../../../layouts/Base.astro';
import '../../../styles/kodex-tacto.css';
import { existsSync, readdirSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import KodexChrome from '../../../components/KodexChrome.astro';
import KodexRecuerda from "../../../components/kodex/KodexRecuerda.astro";
import KodexOrganismo from "../../../components/kodex/organismo/KodexOrganismo.astro";
import { organismoDe } from "../../../components/kodex/organismo/organismos.js";
import KodexArtifact from '../../../components/kodex/artifact/KodexArtifact.astro';
import KodexField from '../../../components/kodex/field/KodexField.astro';
import KodexEje from '../../../components/kodex/eje/KodexEje.astro';
import KodexSystemFooter from '../../../components/kodex/density/KodexSystemFooter.astro';
import KodexRegistration from '../../../components/kodex/density/KodexRegistration.astro';
import KodexTransition from '../../../components/kodex/transition/KodexTransition.astro';
import KodexDebug from '../../../components/kodex/debug/KodexDebug.astro';
import '../../../styles/kodex.css';
import '../../../styles/kodex-micrographics.css';
import { leerManifiesto, resolver, razon, assetUrl, type VolumenResuelto } from '../../../lib/kodex/volumenes';

export async function getStaticPaths() {
  /* Se incluyen las descartadas A PROPÓSITO. Las 828 capturas salieron del
     listado del archivo, pero su página se sigue generando: el grafo tiene
     1.427 nodos, no sabe nada de esta limpieza, y el descenso mandaría al
     visitante a páginas muertas. Sacar algo de la vista no es hacerlo
     inexistente. */
  const vols = resolver(await leerManifiesto(), { incluirDescartados: true });
  return vols.map((v, index) => {
    const related = vols
      .filter((item) => item.slug !== v.slug && (item.estrato === v.estrato || item.tipo === v.tipo || item.marco === v.marco))
      .slice(0, 6);
    return { params: { slug: v.slug }, props: { v, related, prev: vols[index - 1] ?? null, next: vols[index + 1] ?? null } };
  });
}

const { v, related, prev, next } = Astro.props as {
  v: VolumenResuelto;
  related: VolumenResuelto[];
  prev: VolumenResuelto | null;
  next: VolumenResuelto | null;
};
const coverFor = (vol: VolumenResuelto) => {
  if (vol.slug === 'book-ocin-arte-digital-ritual') return '/kodex-content/books/ocin-cover-800.webp';
  const src = vol.hero?.src;
  if (!src || src.endsWith('.json')) return '';
  return assetUrl(src, 'hero');
};
const heroSrc = coverFor(v);

// El organismo sale de las resonancias del volumen, y la semilla de su slug:
// dos volumenes distintos con el mismo organismo no dan el mismo dibujo.
const organismo = organismoDe(v.resonancias);
const semillaVol = [...v.slug].reduce((a, c) => ((a * 31 + c.charCodeAt(0)) >>> 0), 7);
const r = razon(v.hero?.aspecto);
// La forma de la obra decide cuánta columna pide: apaisada más, vertical menos.
const forma = r >= 1.6 ? 'ancho' : r <= 0.75 ? 'alto' : 'cuadro';
const checksum = v.slug.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 4).padEnd(4, 'X') + '-' + v.numero;
const assetKey = (v.hero?.src?.match(/^art\/([^/]+)\//)?.[1] ?? v.slug).replace(/[^a-z0-9-]/gi, '-').toLowerCase();
/* Mismo caso que en /kodex/works/: el fondo de pantalla no existe para 250 de
   los 1.427 volumenes —conviven dos esquemas de nombre y ademas hay claves que
   salen vacias—, asi que estos dos enlaces eran 404 publicados. Se comprueba
   contra el disco en tiempo de build y, si no esta, no se ofrece la descarga.
   Un boton que no baja nada es peor que no tener boton. */
const wallpapersDir = fileURLToPath(new URL('../../../../public/kodex-content/free/wallpapers', import.meta.url));
const wallpapers = existsSync(wallpapersDir) ? new Set(readdirSync(wallpapersDir)) : new Set();
/* Mismo patrón que works.astro: href por R2, comprobación contra disco intacta. */
const wallpaperSi = (n) => (wallpapers.has(n) ? `https://pub-2b4562c758ed440ab047fe9523a2d99c.r2.dev/kodex-content/free/wallpapers/${n}` : null);
const wallpaperDesktop = wallpaperSi(`${assetKey}-desktop.webp`);
const wallpaperMobile = wallpaperSi(`${assetKey}-mobile.webp`);
const collectUrl = `/kodex/store/?signal=${encodeURIComponent(v.slug)}#editions`;
const verifyUrl = `/kodex/verify/?code=KDX-${v.numero}-${encodeURIComponent(v.slug)}`;
const treatmentByType = {
  specimen: 'dither',
  lore: 'linework',
  chapter: 'linework',
  habitat: 'crt',
  libro: 'halftone',
  math: 'linework',
  finding: 'thermal',
  nft: 'signal-corruption',
  artwork: 'duotone',
  gallery: 'duotone',
};
const liveTreatment = treatmentByType[v.tipo] ?? 'duotone';
const livePreset = {
  documentado: { field: 'network-vortex', dither: 0.64, scanlines: 0.24, glow: 0.34, chroma: 0.18, flicker: 0.16, speed: 0.48, spark: '#00EFFF' },
  ciencia: { field: 'network-vortex', dither: 0.58, scanlines: 0.28, glow: 0.36, chroma: 0.22, flicker: 0.12, speed: 0.52, spark: '#00EFFF' },
  ficcion: { field: 'network-vortex', dither: 0.88, scanlines: 0.34, glow: 0.5, chroma: 0.56, flicker: 0.34, speed: 0.72, spark: '#FF6A00' },
  esoterico: { field: 'network-vortex', dither: 0.72, scanlines: 0.3, glow: 0.48, chroma: 0.42, flicker: 0.22, speed: 0.62, spark: '#FF00CF' },
  estructura: { field: 'network-vortex', dither: 0.7, scanlines: 0.26, glow: 0.42, chroma: 0.34, flicker: 0.2, speed: 0.58, spark: '#A6FF00' },
}[v.marco ?? 'estructura'];

/**
 * Diagnósticos del dossier. Derivan del propio volumen, no del azar: el mismo
 * volumen muestra siempre lo mismo. Un número que cambia en cada carga no es
 * un dato, es ruido con forma de dato.
 */
const semilla = [...v.slug].reduce((a, c) => (a * 31 + c.charCodeAt(0)) % 9973, 7);
const diag = [
  { k: 'INTEGRIDAD', v: `${(90 + (semilla % 10))}.${semilla % 10}%` },
  { k: 'PROFUNDIDAD', v: `−${(semilla % 900) + 100}` },
  { k: 'ESCRITURA', v: (v.escritura ?? '—').toUpperCase() },
  { k: 'REGISTRO', v: (v.marco ?? 'estructura').toUpperCase() },
  { k: 'TOMO', v: v.tomo.toUpperCase() },
];

const marcoTexto = {
  ficcion: 'FICCIÓN · MITO Y ESPECULACIÓN · NO ES CIENCIA',
  ciencia: `CIENCIA DOCUMENTADA${v.fuente ? ` · ${v.fuente}` : ''}`,
  documentado: `FUENTE DOCUMENTADA${v.fuente ? ` · ${v.fuente}` : ''}`,
  estructura: 'ESTRUCTURA DEL ARCHIVO · SISTEMA VISUAL',
  esoterico: 'REGISTRO ESOTÉRICO · LECTURA SIMBÓLICA',
}[v.marco ?? 'estructura'];
---

<Base
  kodexFonts={true}
  title={`${v.numero} · ${v.titulo_es} — KODEX−∞`}
  description={v.curaduria_en ?? v.curaduria_es ?? v.titulo_es}
  robots="index, follow"
  ogImage={heroSrc || '/img/kodex/works/mandala-0cin-negativo.png'}
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div
    class={`kx kx--vol kx--vol-${v.tipo}`}
    data-kx
    data-kdx-tool="intensificar"
    data-kdx-recipe={`VOL_${v.numero}`}
    data-kdx-grid={v.estrato}
    style={`--acc:${v.color};--kdx-scene-accent:${v.color}`}
  >
    <KodexTransition />
    <KodexDebug />
    <KodexChrome segs={7} />
    <KodexRegistration accent={v.color} />

    <article class="kx-vol">
      <KodexField
        field={livePreset.field}
        intensity={v.hero ? 0.3 : 0.42}
        tint={v.color}
        spark={livePreset.spark}
        floor={0.06}
        detail={0.62}
        speed={livePreset.speed}
        seed={(semilla % 97) + 1}
        class="kx-vol__campo"
      />

      <header class="kx-vol__cab">
        <p class="kx-vol__tipo">
          <span>{v.tipo}</span>
          <span class="kx-vol__glifos" aria-hidden="true">{v.glifos}</span>
          <span>{v.capitulo ? `CAP ${v.capitulo}` : `VOL ${v.numero}`}</span>
        </p>
        <h1 class="kx-vol__titulo">{v.titulo_es}</h1>
        {v.titulo_en && <p class="kx-vol__titulo-en">{v.titulo_en}</p>}
        <p class="kx-vol__estrato">ESTRATO {v.estratoNumero} · {v.estratoTitulo}</p>

        {/* EL MARCO, DIBUJADO. Es regla dura del proyecto, no un adorno: el
            universo del Artefacto es ficcion y jamas se presenta como ciencia
            ni como salud. Un lector que no puede distinguir mito de
            astrofisica no esta leyendo un archivo, esta leyendo una confusion
            -- y esa confusion seria responsabilidad del sistema. */}
        {v.marco && (
          <p class={`kx-vol__marco kx-vol__marco--${v.marco}`}>
            {marcoTexto}
          </p>
        )}
      </header>

      <figure class={`kx-vol__hero kx-vol__hero--${forma}`} data-treatment={liveTreatment} data-registry={v.marco ?? 'estructura'}>
        {heroSrc ? (
          <KodexArtifact
            artwork={heroSrc}
            aspecto={v.hero.aspecto}
            accent={v.color}
            label={v.hero.alt ?? v.titulo_es}
            id={checksum}
            status={`${(v.marco ?? 'estructura').toUpperCase()} · ${v.tipo.toUpperCase()}`}
            coords={`${v.numero} · ${v.estratoTitulo}`}
            pixelSize={liveTreatment === 'bitmap' ? 5 : 3}
            dither={livePreset.dither}
            scanlines={livePreset.scanlines}
            glow={livePreset.glow}
            chroma={livePreset.chroma}
            flicker={livePreset.flicker}
          />
          <img class="kx-vol__hero-clean" src={heroSrc} alt="" loading="eager" aria-hidden="true" />
        ) : (
          <div class="kx-vol__organismo">
            <KodexField
              field="network-vortex"
              intensity={0.72}
              tint={v.color}
              spark="#7FE9FF"
              floor={0.05}
              detail={0.78}
              speed={0.85}
              seed={(semilla % 53) + 1}
            />
            <figcaption>ORGANISMO GENERADO · OBRA PENDIENTE DE ARCHIVO</figcaption>
          </div>
        )}
      </figure>

      <div class="kx-vol__cuerpo" data-kdx-scrollable>
        <!-- LA FICHA SE RETIRA DETRÁS DE UN PUNTO.
             Manifiesto operativo (rango CANON): "el visitante NO necesita ver
             constantemente «LAYER 1», «VERIFIED», «CANONICAL»… porque entonces
             el universo desaparece y aparece el software".
             Esta página es la LLEGADA de cada descenso y de cada agujero de
             gusano — 1.427 de ellas. Se cruza un túnel y se aterrizaba en una
             ficha de base de datos: REGISTRY / CATEGORY / TOME / SLUG en tabla.
             Eso deshacía todo lo anterior.
             No se borra: se retira. Mismo gesto que en la placa de descenso,
             para que el sistema tenga un solo modo de mostrar instrumentos. -->
        <button class="kx-vol__instr" type="button" data-kdx-vol-instr
          aria-expanded="false" aria-label="Show record">◦</button>
        <div class="kx-vol__dossier" data-kdx-vol-ficha hidden>
          <span>REGISTRY · {(v.marco ?? 'estructura').toUpperCase()}</span>
          <span>CATEGORY · {v.tipo.toUpperCase()}</span>
          <span>TOME · {v.tomo.toUpperCase()}</span>
          <span>SLUG · {v.slug.toUpperCase()}</span>
        </div>
        {v.formula && (
          <div class="kx-vol__formula">
            <p class="kx-vol__tex">{v.formula.tex}</p>
            <p class="kx-vol__lee">{v.formula.lee_es}</p>
            {v.formula.lee_en && <p class="kx-vol__lee kx-vol__lee--en">{v.formula.lee_en}</p>}
          </div>
        )}
        {v.curaduria_es && (
          <div class="kx-vol__parrafo">
            <p>{v.curaduria_es}</p>
            {v.curaduria_en && <p class="kx-vol__en">{v.curaduria_en}</p>}
          </div>
        )}
        {v.meditacion_es && (
          <div class="kx-vol__meditacion">
            <p class="kx-vol__rotulo">MEDITACIÓN</p>
            <p>{v.meditacion_es}</p>
            {v.meditacion_en && <p class="kx-vol__en">{v.meditacion_en}</p>}
          </div>
        )}
        {v.links && Object.entries(v.links).map(([k, url]) => {
          const external = /^(https?:|mailto:)/.test(url);
          return <a class="kx-vol__enlace" href={external ? url : assetUrl(url)} rel="noopener">{k.toUpperCase()} →</a>;
        })}
        {v.oferta?.url && (
          <a class="kx-vol__enlace" href={v.oferta.url} rel="noopener">
            {v.oferta.edicion ? `${v.oferta.edicion} · ` : ''}{v.oferta.precio ?? 'VER'} →
          </a>
        )}
        {v.slug === 'book-ocin-arte-digital-ritual' && <a class="kx-vol__enlace" href="/kodex/libro/">OPEN 81-PAGE VIEWER →</a>}
        {v.tipo === 'libro' && <a class="kx-vol__enlace" href="/kodex/libro/">READ BOOK SURFACE →</a>}
        <nav class="kx-vol__actions" aria-label="volume actions">
          {wallpaperDesktop && <a href={wallpaperDesktop} download data-kdx-action="download">DESCARGAR DESKTOP</a>}
          {wallpaperMobile && <a href={wallpaperMobile} download data-kdx-action="download">DESCARGAR MOBILE</a>}
          <a href={collectUrl} data-kdx-action="collect">COLECCIONAR</a>
          <a href={verifyUrl} data-kdx-action="verify">VERIFY</a>
        </nav>
      </div>

      {v.mensaje_es && (
          <div class="kx-vol__mensaje">
            <p class="kx-vol__rotulo">MENSAJE PARA LA NUEVA HUMANIDAD</p>
            <p class="kx-vol__mensaje-t">{v.mensaje_es}</p>
          {v.mensaje_en && <p class="kx-vol__en">{v.mensaje_en}</p>}
          </div>
        )}

      <aside class="kx-vol__rail">
        {diag.map((d) => (
          <div class="kx-vol__kv"><span>{d.k}</span><b>{d.v}</b></div>
        ))}
        {related.length > 0 && (
          <nav class="kx-vol__resonancias" aria-label="resonancias">
            <p>RESONANCIAS</p>
            {related.map((item) => (
              <a href={`/kodex/vol/${item.slug}/`} style={`--acc:${item.color}`}>
                <span>{item.numero}</span>
                <b>{item.titulo_es}</b>
              </a>
            ))}
          </nav>
        )}
        {/* El organismo no se elige: lo nombra el propio volumen en sus
            `resonancias`, que ya venían en el manifiesto. Si no nombra ninguno
            conocido, no se monta nada — asignarle uno a dedo sería asignar
            canon, y eso lo decide el creador. */}
        {organismo && (
          <section class="kx-vol__organismo">
            <KodexOrganismo
              organismo={organismo}
              semilla={semillaVol}
              etiqueta={`resonancia · ${v.slug}`}
            />
          </section>
        )}
        <KodexEje posicion={0.5} accent={v.color} class="kx-vol__eje" />
        <nav class="kx-vol__nav">
          <a href={prev ? `/kodex/vol/${prev.slug}/` : '/kodex/works/'}>‹ {prev ? 'PREV' : 'ARCHIVE'}</a>
          <a href="/kodex/works/">INDEX</a>
          <a href={next ? `/kodex/vol/${next.slug}/` : '/kodex/'}>{next ? 'NEXT' : 'THRESHOLD'} ›</a>
        </nav>
      </aside>

      <KodexSystemFooter
        code={`KDX-${v.slug.toUpperCase().replace(/[^A-Z0-9]/g, '-').slice(0, 18)}`}
        checksum={checksum}
        kind={`${v.tipo} · ESTRATO ${v.estratoNumero}`}
        accent={v.color}
        class="kx-vol__pie"
      />
    </article>
  </div>
  <KodexRecuerda registraVista />
</Base>

<style>
  .kx--vol { position: relative; min-height: 100dvh; isolation: isolate; }

  .kx-vol {
    position: relative;
    display: grid;
    /* height y no min-height: la lámina es UN viewport y su contenido se
       acomoda adentro. Con min-height el contenido la estira y la página
       scrollea, que es regla dura del proyecto. */
    height: 100dvh;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    grid-template-areas: "cab hero" "cuerpo hero" "mensaje hero" "rail hero" "pie pie";
    /* El rail se lleva la holgura para que el pie quede pegado abajo. Con
       align-content:start las filas se apilaban arriba y el pie flotaba a
       media pagina, que lo hacia leer como un bloque mas y no como pie. */
    grid-template-rows: auto auto auto 1fr auto;
    gap: clamp(12px, 1.8vw, 26px);
    /* La barra del deck es fija y se come los últimos ~73px de la ventana. */
    padding: clamp(68px, 8vh, 92px) clamp(18px, 4vw, 56px) clamp(84px, 10vh, 112px);
    box-sizing: border-box;
  }

  .kx-vol__campo { position: absolute; inset: 0; z-index: 0; opacity: 0.55; }
  .kx-vol > *:not(.kx-vol__campo) { position: relative; z-index: 1; }

  .kx-vol__cab { grid-area: cab; min-width: 0; }
  .kx-vol__tipo {
    display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
    margin: 0 0 8px; font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--acc);
  }
  /* Glifos del estrato: acento de archivo universal, nunca traducción. */
  .kx-vol__glifos { letter-spacing: 0.3em; opacity: 0.62; font-size: 12px; }

  .kx-vol__titulo {
    margin: 0; font-family: "Barlow Condensed", "Inter Tight", system-ui, sans-serif;
    font-weight: 800; font-size: clamp(1.9rem, 4.4vw, 3.8rem); line-height: 0.94;
    text-transform: uppercase; color: #e8e5df; text-wrap: balance;
  }
  .kx-vol__titulo-en, .kx-vol__estrato {
    margin: 4px 0 0; font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(232, 229, 222, 0.42);
    overflow-wrap: anywhere;
  }
  .kx-vol__estrato { margin-top: 10px; color: color-mix(in srgb, var(--acc) 62%, #8b8b8b); }

  .kx-vol__hero {
    grid-area: hero; position: relative; margin: 0; align-self: start;
    width: 100%; max-height: 54vh;
    border: 1px solid color-mix(in srgb, var(--acc) 24%, transparent);
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--acc) 13%, transparent), transparent 54%),
      #050505;
    box-shadow: 0 0 0 1px rgba(230,230,230,.04), 22px 22px 0 color-mix(in srgb, var(--acc) 8%, transparent);
  }
  .kx-vol__hero::before {
    content: "LAMINA · COLLAGE";
    position: absolute; top: 10px; left: 10px; z-index: 8;
    padding: 6px 8px; border: 1px solid color-mix(in srgb, var(--acc) 48%, transparent);
    background: rgba(5,5,5,.72); color: var(--acc);
    font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 8px;
    letter-spacing: .22em; text-transform: uppercase;
  }
  .kx-vol__hero::after {
    content: ""; position: absolute; inset: 0; z-index: 5; pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgba(255,255,255,.05) 0 1px, transparent 1px 4px),
      linear-gradient(90deg, color-mix(in srgb, var(--acc) 10%, transparent), transparent 20%, transparent 80%, color-mix(in srgb, var(--acc) 10%, transparent));
    mix-blend-mode: screen; opacity: .38;
    animation: kx-vol-scan 6.5s linear infinite;
  }
  .kx-vol__hero-clean {
    position: absolute; inset: clamp(16px, 2.4vw, 30px); z-index: 6;
    width: calc(100% - clamp(16px, 2.4vw, 30px) * 2);
    height: calc(100% - clamp(16px, 2.4vw, 30px) * 2);
    object-fit: contain; pointer-events: none;
    filter: grayscale(.1) contrast(1.05) saturate(.95);
    mix-blend-mode: normal; opacity: .74;
  }
  .kx-vol__hero[data-registry="documentado"]::before,
  .kx-vol__hero[data-registry="ciencia"]::before { content: "LAMINA · DOCUMENTED"; }
  .kx-vol__hero[data-registry="ficcion"]::before { content: "LAMINA · FICTION"; }
  .kx-vol__hero[data-registry="esoterico"]::before { content: "LAMINA · ESOTERIC"; }
  .kx-vol__hero[data-treatment="linework"] { filter: contrast(1.08); }
  .kx-vol__hero[data-treatment="halftone"]::after { background-size: 6px 6px, auto; opacity: .58; }
  .kx-vol__hero[data-treatment="thermal"]::after { mix-blend-mode: color-dodge; opacity: .5; }
  .kx-vol__hero[data-treatment="signal-corruption"] { animation: kx-vol-corrupt 5.8s steps(1,end) infinite; }
  @keyframes kx-vol-scan {
    0% { background-position: 0 -80px, 0 0; }
    100% { background-position: 0 120px, 0 0; }
  }
  @keyframes kx-vol-corrupt {
    0%, 86%, 100% { transform: none; }
    88% { transform: translateX(2px); }
    90% { transform: translateX(-1px); }
  }
  .kx-vol__hero--alto { justify-self: center; max-width: 70%; }

  .kx-vol__organismo { position: relative; width: 100%; aspect-ratio: 1; }
  .kx-vol__organismo figcaption {
    position: absolute; left: 10px; bottom: 8px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 8px; letter-spacing: 0.18em; color: rgba(232, 229, 222, 0.38);
  }

  .kx-vol__cuerpo {
    grid-area: cuerpo; display: grid; gap: 14px; max-width: 56ch;
    /* El cuerpo largo scrollea por DENTRO y la página no. Lleva
       data-kdx-scrollable, así que la rueda no le roba el gesto. */
    max-height: min(32vh, 280px); overflow-y: auto; padding-right: 10px;
  }
  .kx-vol__dossier {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px;
    border: 1px solid color-mix(in srgb, var(--acc) 24%, transparent);
    background: color-mix(in srgb, var(--acc) 20%, transparent);
  }
  .kx-vol__dossier span {
    min-height: 28px; display: flex; align-items: center; padding: 0 8px;
    background: rgba(5,5,5,.86); color: rgba(232,229,222,.68);
    font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 8px;
    letter-spacing: .16em; text-transform: uppercase;
  }
  .kx-vol__parrafo p {
    margin: 0; font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 0.95rem; line-height: 1.6; color: rgba(232, 229, 222, 0.82);
  }
  .kx-vol__en {
    margin-top: 6px !important; font-size: 0.82rem !important;
    color: rgba(232, 229, 222, 0.6) !important; font-style: italic;
  }

  /* El marco se lee antes que el contenido, a propósito. Ficción en el acento
     de advertencia; ciencia en el cian del sistema. Distintos de un vistazo,
     que es el punto: no hay que leerlos para distinguirlos. */
  .kx-vol__marco {
    margin: 10px 0 0; padding: 4px 8px; justify-self: start; display: inline-block;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 8.5px; letter-spacing: 0.2em; text-transform: uppercase;
    border: 1px solid currentColor;
    max-width: 100%; box-sizing: border-box; overflow-wrap: anywhere; line-height: 1.7;
  }
  .kx-vol__marco--ficcion { color: #FF8A33; }
  .kx-vol__marco--esoterico { color: #FF00C8; }
  .kx-vol__marco--estructura { color: var(--acc); }
  .kx-vol__marco--ciencia,
  .kx-vol__marco--documentado { color: #00D8FF; }

  .kx-vol__rotulo {
    margin: 0 0 4px; font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 8.5px; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(232, 229, 222, 0.4);
  }
  .kx-vol__meditacion p:not(.kx-vol__rotulo),
  .kx-vol__mensaje p:not(.kx-vol__rotulo) {
    margin: 0; font-family: "Inter Tight", system-ui, sans-serif;
    font-size: 0.95rem; line-height: 1.6; color: rgba(232, 229, 222, 0.82);
  }
  .kx-vol__meditacion { padding-left: 12px; border-left: 1px solid rgba(232,229,222,0.14); }
  /* El mensaje vive FUERA del cuerpo que scrollea. Es la linea de cierre del
     capitulo -- lo unico que pide que te lleves -- y adentro del bloque con
     altura maxima quedaba cortada justo ella. */
  .kx-vol__mensaje { grid-area: mensaje; max-width: 52ch; }
  /* El mensaje es el cierre del capítulo: se dice más grande y en el acento,
     porque es lo único que el capítulo pide que te lleves. */
  .kx-vol__mensaje-t {
    font-size: 1.15rem !important; line-height: 1.35 !important;
    color: var(--acc) !important; text-wrap: balance;
  }

  .kx-vol__formula { padding: 12px 14px; border-left: 2px solid var(--acc); background: rgba(255,255,255,0.02); }
  .kx-vol__tex { margin: 0 0 8px; font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 1rem; color: #e8e5df; }
  .kx-vol__lee { margin: 0; font-family: "Inter Tight", system-ui, sans-serif; font-size: 0.86rem; line-height: 1.5; color: rgba(232,229,222,0.72); }
  .kx-vol__lee--en { margin-top: 6px; font-size: 0.78rem; color: rgba(232,229,222,0.4); font-style: italic; }

  .kx-vol__enlace {
    justify-self: start; padding: 8px 13px;
    border: 1px solid color-mix(in srgb, var(--acc) 44%, transparent);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.2em; color: #e8e5df; text-decoration: none;
  }
  .kx-vol__enlace:hover { background: color-mix(in srgb, var(--acc) 14%, transparent); }
  .kx-vol__actions {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px;
    border: 1px solid color-mix(in srgb, var(--acc) 28%, transparent);
    background: color-mix(in srgb, var(--acc) 18%, transparent);
  }
  .kx-vol__actions a {
    min-height: 34px; display: grid; place-items: center; padding: 0 8px;
    background: rgba(5,5,5,.9); color: rgba(232,229,222,.76); text-decoration: none;
    font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 8px;
    letter-spacing: .16em; text-transform: uppercase;
  }
  .kx-vol__actions a[data-kdx-action="collect"] { color: var(--acc); }
  .kx-vol__actions a:hover { background: var(--acc); color: #050505; }

  .kx-vol__rail { grid-area: rail; display: grid; gap: 7px; align-content: start; min-width: 0; }
  .kx-vol__kv {
    display: flex; justify-content: space-between; gap: 14px;
    padding-bottom: 5px; border-bottom: 1px solid rgba(232,229,222,0.1);
    font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 9px;
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .kx-vol__kv span { color: rgba(232,229,222,0.44); }
  .kx-vol__kv b { color: #e8e5df; font-weight: 500; font-variant-numeric: tabular-nums; }
  /* El eje dibuja sus rotulos DEBAJO de la linea, asi que necesita reservar
     ese alto o se come lo que venga despues. */
  .kx-vol__eje { margin-top: 10px; margin-bottom: 26px; }
  .kx-vol__resonancias {
    display: grid; gap: 1px; margin-top: 10px;
    border: 1px solid rgba(232,229,222,.1); background: rgba(232,229,222,.1);
  }
  .kx-vol__resonancias p {
    margin: 0; padding: 8px 9px; background: rgba(5,5,5,.9);
    color: var(--acc); font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 8px; letter-spacing: .22em; text-transform: uppercase;
  }
  .kx-vol__resonancias a {
    display: grid; grid-template-columns: 38px 1fr; gap: 8px; align-items: center;
    min-height: 34px; padding: 0 9px; background: rgba(5,5,5,.82); text-decoration: none;
    font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 8.5px;
    letter-spacing: .12em; text-transform: uppercase;
  }
  .kx-vol__resonancias a span { color: var(--acc); }
  .kx-vol__resonancias a b { color: rgba(232,229,222,.72); font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .kx-vol__resonancias a:hover b { color: #e8e5df; }
  .kx-vol__nav { display: flex; gap: 16px; margin-top: 4px; }
  .kx-vol__nav a {
    font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 10px;
    letter-spacing: 0.2em; color: rgba(232,229,222,0.7); text-decoration: none;
  }
  .kx-vol__nav a:hover { color: var(--acc); }

  .kx-vol__pie { grid-area: pie; align-self: end; }

  @media (max-width: 900px) {
    .kx--vol {
      height: 100dvh;
      overflow: hidden;
    }
    .kx-vol {
      height: 100dvh; min-height: 100dvh;
      width: 100vw;
      max-width: 100vw;
      min-width: 0;
      grid-template-columns: 1fr;
      grid-template-areas: "cab" "hero" "cuerpo" "mensaje" "rail" "pie";
      grid-template-rows:
        auto
        minmax(132px, min(30dvh, 240px))
        minmax(0, 1fr)
        minmax(0, 58px)
        minmax(0, 94px)
        auto;
      gap: clamp(7px, 1.1dvh, 10px);
      padding-block: clamp(52px, 6dvh, 68px) clamp(64px, 7dvh, 80px);
      padding-inline: clamp(18px, 5vw, 30px);
      overflow-x: clip;
    }
    .kx-vol__cab { max-height: 19dvh; overflow: clip; }
    .kx-vol__cab,
    .kx-vol__cuerpo,
    .kx-vol__mensaje,
    .kx-vol__rail,
    .kx-vol__pie {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }
    .kx-vol__tipo { margin-bottom: 5px; gap: 8px; font-size: 8px; letter-spacing: .18em; }
    .kx-vol__glifos { display: none; }
    .kx-vol__titulo { font-size: clamp(1.55rem, 9.5vw, 2.45rem); line-height: .9; }
    .kx-vol__titulo-en,
    .kx-vol__estrato { font-size: 8px; letter-spacing: .13em; }
    .kx-vol__estrato { margin-top: 6px; }
    .kx-vol__marco {
      display: block;
      width: min(100%, calc(100vw - 60px));
      max-width: calc(100vw - 60px);
      margin-top: 6px;
      font-size: 7px;
      letter-spacing: .13em;
      line-height: 1.45;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      word-break: normal;
    }
    .kx-vol__hero {
      width: 100%;
      height: 100%;
      max-width: 100%;
      max-height: none;
      min-height: 0;
      box-sizing: border-box;
      justify-self: stretch;
      align-self: stretch;
      box-shadow: none;
    }
    .kx-vol__hero::before { top: 7px; left: 7px; padding: 4px 6px; font-size: 6.5px; letter-spacing: .14em; }
    .kx-vol__hero-clean {
      inset: 12px;
      width: calc(100% - 24px);
      height: calc(100% - 24px);
    }
    .kx-vol__hero :global(.kdx-artifact__meta) {
      display: none;
    }
    .kx-vol__hero--alto { max-width: 100%; }
    .kx-vol__cuerpo {
      min-height: 0;
      max-width: none;
      max-height: none;
      overflow-y: auto;
      padding-right: 8px;
      gap: 9px;
      overscroll-behavior: contain;
    }
    .kx-vol__dossier { grid-template-columns: 1fr; }
    .kx-vol__dossier span { min-height: 24px; font-size: 7px; letter-spacing: .11em; }
    .kx-vol__parrafo p,
    .kx-vol__meditacion p:not(.kx-vol__rotulo) { font-size: .86rem; line-height: 1.45; }
    .kx-vol__parrafo p,
    .kx-vol__meditacion p,
    .kx-vol__mensaje p,
    .kx-vol__lee,
    .kx-vol__en {
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    .kx-vol__en { font-size: .74rem !important; line-height: 1.42 !important; }
    .kx-vol__mensaje {
      min-height: 0;
      max-height: none;
      overflow-y: auto;
      padding-right: 8px;
      overscroll-behavior: contain;
    }
    .kx-vol__mensaje-t { font-size: .9rem !important; line-height: 1.25 !important; }
    .kx-vol__rail {
      min-height: 0;
      max-height: none;
      overflow-y: auto;
      align-content: start;
      gap: 4px;
      padding-right: 8px;
      overscroll-behavior: contain;
    }
    .kx-vol__resonancias { margin-top: 4px; }
    .kx-vol__resonancias p { padding: 6px 8px; }
    .kx-vol__resonancias a { min-height: 28px; }
    .kx-vol__eje { display: none; }
    .kx-vol__nav { margin-top: 2px; gap: 10px; flex-wrap: wrap; }
    .kx-vol__pie { min-width: 0; overflow: hidden; }
    .kx-vol__dossier span,
    .kx-vol__kv,
    .kx-vol__resonancias a,
    .kx-vol__nav a,
    .kx-vol__enlace,
    .kx-vol__actions a {
      overflow-wrap: anywhere;
    }
    .kx-vol__kv span { color: rgba(232,229,222,0.62); }
  }
  @media (prefers-reduced-motion: reduce) {
    .kx-vol__hero,
    .kx-vol__hero::after { animation: none !important; }
  }

  /* El punto de instrumentos, igual que en la placa de descenso. */
  .kx-vol__instr{
    width:44px; height:44px; padding:0; cursor:pointer;
    background:none; border:0; color:rgba(240,237,232,.3);
    font:13px/1 'IBM Plex Mono',ui-monospace,monospace;
    display:inline-flex; align-items:center; justify-content:center;
    transition:color .25s ease;
  }
  .kx-vol__instr:hover,.kx-vol__instr[aria-expanded="true"]{ color:#ff2733; }
  .kx-vol__dossier[hidden]{ display:none; }

  /* ── el texto se cortaba, y mi primer arreglo lo EMPEORÓ ─────────────────
     En 390px el texto terminaba en "...entre lo visible y lo" y ahí se cortaba.
     Puse `overflow-x:clip` y el medidor de desborde pasó a 0 — pero el texto
     seguía cortado: había tapado el síntoma y perdido contenido, que es peor
     que un scroll horizontal. Se vio en la captura, no en la métrica.
     La causa medida: `.kx-vol__cab`, `__titulo` y `__hero` miden 404px en una
     pantalla de 390. Catorce de más, de un ancho que no descuenta su relleno.
     Se corrige la CAUSA —que las cajas quepan— y no el síntoma. */
  .kx-vol, .kx-vol *{ box-sizing:border-box; }
  .kx-vol :is(.kx-vol__cab,.kx-vol__titulo,.kx-vol__hero,.kx-vol__organismo,
    .kx-vol__cuerpo,.kx-vol__dossier){ max-width:100%; }
  .kx-vol :is(p,h1,h2,li,span){ overflow-wrap:anywhere; }
</style>

<script>
  /* Los instrumentos, a pedido. Va al final del archivo y no antes de un
     </body> que esta pagina no tiene: usa el layout Base, asi que el cierre
     vive en otro archivo y la insercion anterior no llego nunca al HTML.
     Astro iza los <script> del template esten donde esten. */
  const bi = document.querySelector('[data-kdx-vol-instr]');
  const fi = document.querySelector('[data-kdx-vol-ficha]');
  bi?.addEventListener('click', () => {
    const abierto = bi.getAttribute('aria-expanded') === 'true';
    bi.setAttribute('aria-expanded', String(!abierto));
    if (fi) fi.hidden = abierto;
    bi.textContent = abierto ? '\u25E6' : '\u25C9';
  });
</script>
