---
/**
 * KODEX-∞ · VOLUMEN · lámina-collage
 *
 * Una ruta para toda la biblioteca. Agregar un volumen al manifiesto crea su
 * página; acá no se escribe nada.
 *
 * **Cada volumen es una lámina**, no una ficha. El modelo son los pósters del
 * sistema: una plancha de paneles numerados sobre negro, un solo acento, y en
 * cada margen un fragmento del sistema — glifos, diagnósticos, tiras, reloj.
 * Denso pero dosificado: el aire negro es parte de la composición, no lo que
 * sobró.
 *
 * Dos cosas que la lámina sostiene siempre:
 *
 *  · **El sello del registro.** Documentado y mito nunca se confunden, y la
 *    marca viaja pegada al contenido, no en una nota al pie que se pierde al
 *    recomponer la página. Es la regla madre del atlas.
 *  · **La proporción real de la obra.** Nunca se deforma una pieza para que
 *    entre en una caja.
 *
 * Un volumen sin obra igual tiene cuerpo: cae al organismo vivo teñido con el
 * color de su estrato. No es un placeholder — es la diferencia entre una
 * biblioteca que espera a estar llena y una que ya está viva y se va llenando.
 */
import Base from '../../../layouts/Base.astro';
import KodexChrome from '../../../components/KodexChrome.astro';
import KodexArtifact from '../../../components/kodex/artifact/KodexArtifact.astro';
import KodexField from '../../../components/kodex/field/KodexField.astro';
import KodexRegistration from '../../../components/kodex/density/KodexRegistration.astro';
import KodexTransition from '../../../components/kodex/transition/KodexTransition.astro';
import KodexDebug from '../../../components/kodex/debug/KodexDebug.astro';
import '../../../styles/kodex.css';
import '../../../styles/kodex-micrographics.css';
import { leerManifiesto, resolver, razon, distribuir, type VolumenResuelto } from '../../../lib/kodex/volumenes';
import { conjuntoDe } from '../../../lib/kodex/simbolos';

export async function getStaticPaths() {
  const vols = resolver(await leerManifiesto());
  return vols.map((v) => ({ params: { slug: v.slug }, props: { v } }));
}

const { v } = Astro.props as { v: VolumenResuelto };
const r = razon(v.hero?.aspecto);
const checksum = v.slug.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 4).padEnd(4, 'X') + '-' + v.numero;

/**
 * Los diagnósticos derivan del propio volumen, no del azar: el mismo volumen
 * muestra siempre lo mismo. Un número que cambia en cada carga no es un dato,
 * es ruido con forma de dato.
 */
const semilla = [...v.slug].reduce((a, c) => (a * 31 + c.charCodeAt(0)) % 9973, 7);

/** La serie, dosificada: el héroe ya se llevó la primera placa. */
const serie = distribuir((v.assets ?? []).slice(1) as any[], 8);
const totalPlacas = (v.assets ?? []).length;

/** El conjunto de símbolos que le toca, con su sello y su atribución. */
const conj = conjuntoDe(v.tema, v.estrato);

/**
 * El sello del volumen. El del conjunto es el de la tradición que se dibuja al
 * margen; éste es el del contenido central. Cuando el volumen declara `marco`
 * manda el volumen — es un dato curado y le gana a una inferencia por palabra.
 */
const selloVol = v.marco === 'ficcion' ? 'B' : v.marco ? 'A' : conj.sello;
const selloTexto = selloVol === 'A'
  ? 'REGISTRO ① · DOCUMENTADO'
  : 'REGISTRO ② · SIMBÓLICO / FICCIÓN — NO ES HECHO';

const diag = [
  { k: 'CLASE', v: v.tipo.toUpperCase() },
  { k: 'ESTRATO', v: v.estratoTitulo.toUpperCase() },
  { k: 'PLACAS', v: String(totalPlacas).padStart(3, '0') },
  { k: 'INTEGRIDAD', v: `${90 + (semilla % 10)}.${semilla % 10}%` },
  { k: 'PROFUNDIDAD', v: `−${(semilla % 900) + 100} M` },
  { k: 'REGISTRO', v: v.fecha ?? '—' },
];

const enlaces = Object.entries(v.links ?? {});
---

<Base
  kodexFonts={true}
  title={`${v.numero} · ${v.titulo_es} — KODEX−∞`}
  description={v.curaduria_en ?? v.curaduria_es ?? v.titulo_es}
  robots="index, follow"
  ogImage={v.hero?.src ?? '/img/kodex/works/mandala-0cin-negativo.png'}
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div
    class={`kx kx--vol kx--vol-${v.tipo}`}
    data-kx
    data-kdx-tool="intensificar"
    data-kdx-recipe={`VOL_${v.numero}`}
    data-kdx-grid={v.estrato}
    style={`--acc:${v.color};--kdx-scene-accent:${v.color}`}
  >
    <KodexTransition />
    <KodexDebug />
    <KodexChrome segs={7} />
    <KodexRegistration accent={v.color} />

    <div class:list={['kx-lam', serie.length === 0 && 'kx-lam--sinserie']} data-kdx-lamina>
      {/* El sistema corriendo debajo del papel. Bajo de intensidad a
          proposito: acá el protagonista es la obra, no el fondo. */}
      <KodexField
        field="network-vortex"
        intensity={0.4}
        tint={v.color}
        spark="#7FE9FF"
        floor={0.03}
        detail={0.6}
        speed={0.5}
        seed={(semilla % 97) + 1}
        class="kx-lam__campo"
      />

      {/* ── CABECERA ──────────────────────────────────────────────────── */}
      <header class="kx-lam__cab">
        <div class="kx-lam__marca">
          <p class="kx-lam__logo">KODEX−∞ <span>/ {v.titulo_es}</span></p>
          <p class="kx-lam__sub">{v.titulo_en} · {v.estratoTitulo}</p>
        </div>
        <dl class="kx-lam__tiraDatos">
          <div><dt>VOL</dt><dd>{v.numero}</dd></div>
          <div><dt>CLASE</dt><dd>{v.tipo.toUpperCase()}</dd></div>
          <div><dt>FECHA</dt><dd>{v.fecha ?? '—'}</dd></div>
          <div><dt>SEED</dt><dd>{checksum}</dd></div>
        </dl>
        <p class={`kx-lam__sello kx-lam__sello--${selloVol}`}>{selloTexto}</p>
      </header>

      {/* ── 01 · DOSSIER ──────────────────────────────────────────────── */}
      <section class="kx-lam__p kx-lam__p--dossier">
        <h2 class="kx-lam__rot">01 · DOSSIER</h2>
        <dl class="kx-lam__pares">
          {diag.map((d) => (
            <div><dt>{d.k}</dt><dd>{d.v}</dd></div>
          ))}
        </dl>
        <p class="kx-lam__glifos" aria-hidden="true">{v.glifos}</p>
        <p class="kx-lam__barra" aria-hidden="true"></p>
        <p class="kx-lam__id">ID · {checksum}</p>
      </section>

      {/* ── 02 · LÁMINA CENTRAL ───────────────────────────────────────── */}
      <section class="kx-lam__p kx-lam__p--obra">
        <h2 class="kx-lam__rot">02 · LÁMINA // DIAGRAMA CENTRAL <b>LIVE</b></h2>
        <div class="kx-lam__lienzo">
          {v.hero ? (
            <KodexArtifact
              artwork={v.hero.src}
              aspecto={v.hero.aspecto}
              accent={v.color}
              label={v.titulo_es}
              id={checksum}
              status={v.tipo.toUpperCase()}
              coords={`${v.numero} · ${v.estratoTitulo}`}
              pixelSize={3}
              dither={0.86}
              scanlines={0.3}
              glow={0.46}
              chroma={0.5}
              flicker={0.34}
            />
          ) : (
            <div class="kx-lam__organismo">
              <KodexField
                field="network-vortex"
                intensity={0.78}
                tint={v.color}
                spark="#7FE9FF"
                floor={0.05}
                detail={0.8}
                speed={0.85}
                seed={(semilla % 89) + 1}
              />
            </div>
          )}
        </div>
      </section>

      {/* ── 03 · CURADURÍA ────────────────────────────────────────────── */}
      <section class="kx-lam__p kx-lam__p--texto">
        <h2 class="kx-lam__rot">03 · CURADURÍA</h2>
        {v.curaduria_es && <p class="kx-lam__es">{v.curaduria_es}</p>}
        {v.curaduria_en && <p class="kx-lam__en">{v.curaduria_en}</p>}
        {v.tema && <p class="kx-lam__tema">TEMA · {v.tema}</p>}

        {v.meditacion_es && <p class="kx-lam__es">{v.meditacion_es}</p>}
        {v.mensaje_es && <p class="kx-lam__mensaje">{v.mensaje_es}</p>}

        {v.documentos && v.documentos.length > 0 && (
          <p class="kx-lam__docs">
            <b>{v.documentos.length}</b> {v.documentos.length === 1 ? 'PIEZA' : 'PIEZAS'} SIN LÁMINA ·
            {' '}{v.documentos.slice(0, 3).map((d) => d.replace(/\.[^.]+$/, '')).join(' · ')}
          </p>
        )}

        {enlaces.length > 0 && (
          <ul class="kx-lam__links">
            {enlaces.slice(0, 4).map(([n, u]) => (
              <li><a href={u} target="_blank" rel="noopener noreferrer">{n} ↗</a></li>
            ))}
          </ul>
        )}
      </section>

      {/* ── 04 · BIBLIOTECA DE GLIFOS ─────────────────────────────────── */}
      <section class="kx-lam__p kx-lam__p--simbolos">
        <h2 class="kx-lam__rot">04 · BIBLIOTECA DE GLIFOS</h2>
        <p class="kx-lam__tradicion">{conj.nombre_es}</p>

        {conj.glifos.length > 0 && (
          <ul class="kx-lam__signos" aria-label={conj.nombre_es}>
            {conj.glifos.map((g) => <li>{g}</li>)}
          </ul>
        )}

        {conj.terminos && (
          <dl class="kx-lam__voces">
            {conj.terminos.map((t) => (
              <div><dt>{t.voz}</dt><dd>{t.lee}</dd></div>
            ))}
          </dl>
        )}

        {/* El sello y la atribucion van PEGADOS al conjunto: si la lamina se
            recompone, la marca viaja con el simbolo y no se puede perder. */}
        <p class={`kx-lam__natura kx-lam__natura--${conj.sello}`}>{conj.naturaleza}</p>
        {conj.fuente && <p class="kx-lam__fuente">FUENTE · {conj.fuente}</p>}
      </section>

      {/* ── 05 · DIAGNÓSTICO VIVO ─────────────────────────────────────── */}
      <section class="kx-lam__p kx-lam__p--vivo">
        <h2 class="kx-lam__rot">05 · DIAGNÓSTICO <b data-lam-latido>●</b></h2>
        <dl class="kx-lam__pares kx-lam__pares--vivo">
          <div><dt>UTC</dt><dd data-lam-reloj>--:--:--</dd></div>
          <div><dt>DERIVA</dt><dd data-lam-coord>--</dd></div>
          <div><dt>CHECKSUM</dt><dd>{checksum}</dd></div>
        </dl>
        {/* Hora espejo: un hecho sobre el reloj. Se celebra, no se explica ni
            se le atribuye poder — eso seria un claim. */}
        <p class="kx-lam__espejo" data-lam-espejo hidden></p>
        <p class="kx-lam__onda" aria-hidden="true"></p>
      </section>

      {/* ── 06 · SERIE ────────────────────────────────────────────────── */}
      {serie.length > 0 && (
        <section class="kx-lam__p kx-lam__p--serie">
          <h2 class="kx-lam__rot">06 · SERIE <b>{totalPlacas} PLACAS EN EL ARCHIVO</b></h2>
          <ul>
            {serie.map((a: any) => (
              <li style={`aspect-ratio:${a.aspecto}`}>
                <img src={a.src} alt={a.alt ?? ''} loading="lazy" decoding="async" />
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* ── PIE ───────────────────────────────────────────────────────── */}
      <footer class="kx-lam__pie">
        <p class="kx-lam__barra kx-lam__barra--larga" aria-hidden="true"></p>
        <nav class="kx-lam__nav">
          <a href="/kodex/folio/iii/">‹ ÍNDICE</a>
          <a href="/kodex/">KODEX−∞</a>
        </nav>
        <p class="kx-lam__lema">CADA GLIFO ES UNA FUNCIÓN · CADA FUNCIÓN ES UNA PROMESA</p>
      </footer>
    </div>
  </div>
</Base>

<script>
  import { horaEspejo } from '../../../lib/kodex/simbolos';

  /**
   * El reloj de la lámina.
   *
   * Es el único dato de la plancha que NO deriva del volumen: el resto es
   * estable a propósito, y esto tiene que moverse para que la lámina se lea
   * viva y no impresa.
   */
  const montar = () => {
    const raiz = document.querySelector<HTMLElement>('[data-kdx-lamina]');
    if (!raiz || (raiz as any).__kdxLam) return;
    (raiz as any).__kdxLam = true;

    const reloj = raiz.querySelector<HTMLElement>('[data-lam-reloj]');
    const coord = raiz.querySelector<HTMLElement>('[data-lam-coord]');
    const espejo = raiz.querySelector<HTMLElement>('[data-lam-espejo]');
    const latido = raiz.querySelector<HTMLElement>('[data-lam-latido]');

    // Con movimiento reducido el reloj sigue andando — es informacion, no
    // decoracion — pero el latido se queda quieto.
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let t = 0;

    const tic = () => {
      const d = new Date();
      const p = (n: number) => String(n).padStart(2, '0');
      if (reloj) reloj.textContent = `${p(d.getUTCHours())}:${p(d.getUTCMinutes())}:${p(d.getUTCSeconds())}`;

      // Una deriva lenta y continua: coordenadas que se mueven como las de un
      // instrumento encendido, no numeros al azar cada segundo.
      t += 0.0035;
      if (coord) {
        const ra = (Math.sin(t) * 12 + 12).toFixed(2);
        const dec = Math.cos(t * 0.7) * 89;
        coord.textContent = `RA ${ra}h · DEC ${dec >= 0 ? '+' : ''}${dec.toFixed(1)}°`;
      }

      const e = horaEspejo(d.getHours(), d.getMinutes());
      if (espejo) {
        espejo.hidden = e === null;
        if (e) espejo.textContent = `HORA ESPEJO · ${e}`;
      }

      if (latido && !quieto) latido.style.opacity = String(0.35 + Math.abs(Math.sin(t * 8)) * 0.65);
    };

    tic();
    setInterval(tic, 1000);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', montar, { once: true });
  } else {
    montar();
  }
  document.addEventListener('astro:page-load', montar);
</script>

<style>
  /* ── La plancha ──────────────────────────────────────────────────────────
     Una sola pantalla, borde a borde. Los paneles se colocan por AREA para que
     la composicion sea deliberada y no el resultado de como caiga el flujo: es
     una lamina, no un documento. */
  .kx-lam {
    position: relative;
    /* ALTURA DEFINIDA, no `min-height`. Con minimo, el contenido estira la
       plancha y las filas `1fr` dejan de acotar nada: la obra se iba de largo
       y empujaba la serie y el pie fuera de la pantalla. Una lamina tiene el
       tamano que tiene. */
    height: 100dvh;
    overflow: hidden;
    display: grid;
    gap: 1px;
    /* La linea de tiempo del chrome esta FIJA al borde inferior y tapaba el
       pie de la lamina. Se le reserva su franja en vez de esconderla: es el
       latido del sistema y estar debajo del pie es justo donde va. */
    padding: clamp(8px, 1.1vw, 14px) clamp(8px, 1.1vw, 14px) 30px;
    box-sizing: border-box;
    grid-template-columns: minmax(200px, 19%) minmax(0, 1fr) minmax(200px, 21%);
    /* La serie lleva ALTURA FIJA en vez de `auto`. Con auto, su alto dependia
       de la placa mas alta de la fila y el pie se salia de la plancha por unos
       pocos pixeles — un margen que hay que volver a limar cada vez que cambia
       el contenido. Con una pista fija las filas son deterministas y el pie
       entra siempre. */
    grid-template-rows: auto minmax(0, 1fr) minmax(0, 0.9fr) 92px auto;
    grid-template-areas:
      "cab      cab   cab"
      "dossier  obra  simbolos"
      "texto    obra  vivo"
      "serie    serie serie"
      "pie      pie   pie";
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    color: #e8e5df;
    isolation: isolate;
  }

  /* Un volumen sin laminas — los hay: los que son documento — no debe reservar
     la pista de la serie. Una franja vacia con borde promete algo que no esta,
     que es peor que no tener franja. */
  .kx-lam--sinserie {
    grid-template-rows: auto minmax(0, 1fr) minmax(0, 0.9fr) 0 auto;
  }

  .kx-lam__campo { position: absolute; inset: 0; z-index: 0; opacity: 0.5; }

  /* La barra de navegacion del chrome flota fija al pie y cruzaba la obra por
     el medio. La lamina ya tiene su propio pie con indice y salida: dos
     navegaciones encimadas no son mas accesibles, son una tapando a la otra. */
  :global(.kx--vol .kx-deckbar) { display: none; }

  /* El lector de coordenadas del chrome flota fijo en la esquina inferior
     derecha, justo encima de la serie, y dice lo mismo que el panel 05. La
     lamina lo trae adentro y con su rotulo: afuera solo estorbaba. */
  :global(.kx--vol .kx-astro) { display: none; }

  /* ── Paneles ─────────────────────────────────────────────────────────── */
  .kx-lam__p {
    /* El campo del fondo es un elemento posicionado, y eso pinta por encima de
       cualquier hermano ESTATICO aunque venga despues en el DOM. Los paneles
       llevan position para ganarle. Sin esto la plancha se ve vacia. */
    position: relative;
    z-index: 1;
    border: 1px solid color-mix(in srgb, var(--acc) 22%, transparent);
    background: rgba(5, 5, 7, 0.72);
    padding: 9px 11px 11px;
    display: grid;
    gap: 7px;
    align-content: start;
    min-height: 0;
    /* Un panel que desborda scrollea por dentro. La plancha no crece: es una
       lamina de tamano fijo, como el poster del que sale. */
    overflow: auto;
    scrollbar-width: none;
  }
  .kx-lam__p::-webkit-scrollbar { display: none; }

  .kx-lam__rot {
    margin: 0;
    font-size: 8.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--acc);
    display: flex;
    gap: 8px;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid color-mix(in srgb, var(--acc) 18%, transparent);
    padding-bottom: 5px;
  }
  .kx-lam__rot b {
    font-weight: 400;
    color: rgba(232, 229, 222, 0.4);
    letter-spacing: 0.16em;
  }

  /* ── Cabecera ────────────────────────────────────────────────────────── */
  .kx-lam__cab {
    grid-area: cab;
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(10px, 2vw, 28px);
    border: 1px solid color-mix(in srgb, var(--acc) 26%, transparent);
    background: rgba(5, 5, 7, 0.8);
    padding: 8px 12px;
  }
  .kx-lam__marca { flex: 1 1 260px; min-width: 0; }
  .kx-lam__logo {
    margin: 0;
    font-family: "Archivo Black", "Anton", ui-sans-serif, sans-serif;
    font-size: clamp(15px, 2vw, 25px);
    line-height: 1.05;
    /* Un titulo largo no debe partir la cabecera en dos alturas. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .kx-lam__logo span { color: var(--acc); }
  .kx-lam__sub {
    margin: 3px 0 0;
    font-size: 8.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(232, 229, 222, 0.42);
  }

  .kx-lam__tiraDatos { display: flex; gap: clamp(8px, 1.6vw, 22px); margin: 0; flex-wrap: wrap; }
  .kx-lam__tiraDatos div { display: grid; gap: 1px; }
  .kx-lam__tiraDatos dt { font-size: 7.5px; letter-spacing: 0.2em; color: rgba(232, 229, 222, 0.36); }
  .kx-lam__tiraDatos dd {
    margin: 0; font-size: 10px; letter-spacing: 0.1em;
    color: var(--acc); font-variant-numeric: tabular-nums;
  }

  /* El sello del registro. Los dos se leen distinto de un vistazo: ese es todo
     el punto — un lector que no distingue hecho de mito no esta leyendo un
     archivo, esta leyendo una confusion. */
  .kx-lam__sello {
    margin: 0; font-size: 8px; letter-spacing: 0.18em;
    text-transform: uppercase; padding: 4px 9px; border: 1px solid;
    /* El sello no se parte en dos lineas: es la marca que hay que leer de un
       vistazo y partida pierde justamente eso. */
    white-space: nowrap;
  }
  .kx-lam__sello--A {
    color: #9FE870; border-color: rgba(159, 232, 112, 0.5);
    background: rgba(159, 232, 112, 0.07);
  }
  .kx-lam__sello--B {
    color: #FF8A5B; border-color: rgba(255, 138, 91, 0.5);
    /* Rayado: la ficcion se ve distinta incluso de reojo y sin leer. */
    background-image: repeating-linear-gradient(
      45deg, rgba(255, 138, 91, 0.12) 0 4px, transparent 4px 8px);
  }

  /* ── 01 Dossier ──────────────────────────────────────────────────────── */
  .kx-lam__p--dossier { grid-area: dossier; }
  .kx-lam__pares { display: grid; gap: 1px; margin: 0; }
  .kx-lam__pares div {
    display: flex; justify-content: space-between; gap: 10px;
    padding: 3px 0; border-bottom: 1px solid rgba(232, 229, 222, 0.07);
  }
  .kx-lam__pares dt { font-size: 8px; letter-spacing: 0.16em; color: rgba(232, 229, 222, 0.4); }
  .kx-lam__pares dd {
    margin: 0; font-size: 9px; letter-spacing: 0.08em; color: #e8e5df;
    text-align: right; font-variant-numeric: tabular-nums;
    /* Un valor largo se recorta antes que romper la columna. */
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  .kx-lam__glifos {
    margin: 0; font-size: 13px; letter-spacing: 0.2em;
    color: color-mix(in srgb, var(--acc) 70%, #8b8b8b);
  }
  .kx-lam__id { margin: 0; font-size: 8px; letter-spacing: 0.18em; color: rgba(232, 229, 222, 0.34); }

  .kx-lam__barra {
    margin: 0; height: 24px; opacity: 0.6; color: #e8e5df;
