---
/**
 * KODEX-∞ · CAPÍTULO 01 · COSMOLOGY CORE
 *
 * El póster de Ocín, corriendo.
 *
 * Los once paneles del plano están acá con sus mismos números y sus mismos
 * rótulos, en la misma grilla. Lo que cambia es que **respiran**: el mapa
 * orbital ejecuta el pseudocódigo del panel 08 sobre los datos del panel 09,
 * los cuatro estados del panel 02 son controles de verdad, la telemetría del
 * panel 10 tickea y las cartas del panel 07 escuchan el audio.
 *
 * La regla de dosificación se respeta donde más se nota, que es en lo que se
 * mueve: **una sola cosa por panel tiene derecho a animarse.** El mapa se
 * mueve porque es el hero; las cartas porque son señal; la telemetría porque
 * es medición. Los estudios y los glifos se dibujan UNA vez — son estudios y
 * arquetipos, no instrumentos, y quince bucles compitiendo convertirían el
 * capítulo en un protector de pantalla que además no corre en un iMac 2015.
 */
import Base from '../../../layouts/Base.astro';
import KodexChrome from '../../../components/KodexChrome.astro';
import KodexField from '../../../components/kodex/field/KodexField.astro';
import KodexTransition from '../../../components/kodex/transition/KodexTransition.astro';
import KodexDebug from '../../../components/kodex/debug/KodexDebug.astro';
import '../../../styles/kodex.css';
import {
  COSMOLOGY_CORE as C, CUERPOS, SECTORES, ESTADOS, MOVIMIENTO,
  LEYENDA, ARQUETIPOS, BANDAS, REFERENCIA, TELEMETRIA,
} from '../../../lib/kodex/capitulos';

const LOGICA = [
  'for each body in ORBIT_MAP:',
  '  angle  = body.angular_velocity * delta_time',
  '  radius = body.orbit_radius',
  '  x = cos(angle) * radius',
  '  y = sin(angle) * radius',
  '  z = sin(angle * 0.5) * body.inclination',
  '  body.position = vec3(x, y, z)',
  "  if body.type == 'NODE':",
  '    body.pulse = sin(time * body.frequency)',
  '  if body.linked:',
  '    draw_vector(body.position, body.linked_to)',
  'end',
];

const ESTUDIOS = ['ORBITAL GEOMETRY', 'VECTOR WEB', 'NODE STRUCTURE', 'GATE ARCHETYPE'];
---

<Base
  kodexFonts={true}
  title={`${C.titulo} — KODEX−∞`}
  description={`${C.subtitulo_en} / ${C.subtitulo_es} · capítulo ${C.tanda} del archivo KODEX−∞.`}
  robots="index, follow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div
    class="kx kx--cap"
    data-kx
    data-kdx-tool="orbitar"
    data-kdx-recipe={`CAP_${C.tanda}`}
    style={`--acc:${C.acento};--apoyo:${C.apoyo};--kdx-scene-accent:${C.acento}`}
  >
    <KodexTransition />
    <KodexDebug />
    <KodexChrome segs={7} />

    <div class="kxc" data-kdx-capitulo>
      {/* El escenario surrealista, muy bajo: acá el instrumento es el mapa. */}
      <KodexField
        field="surreal-dream"
        intensity={0.3}
        tint={C.acento}
        spark={C.apoyo}
        floor={0.04}
        detail={0.5}
        speed={0.45}
        seed={7}
        class="kxc__campo"
      />

      {/* ── CABECERA ─────────────────────────────────────────────────── */}
      <header class="kxc__cab">
        <div class="kxc__sigilo" aria-hidden="true"><span>{C.tanda.replace('-', ' ')}</span></div>
        <div class="kxc__titulo">
          <h1>KODEX−∞ <span>/ {C.titulo}</span></h1>
          <p>{C.subtitulo_en} / {C.subtitulo_es}</p>
        </div>
        <dl class="kxc__meta">
          <div><dt>CORE STYLE SEED</dt><dd>{C.tanda}</dd></div>
          <div><dt>ARCHIVE ID</dt><dd>{C.archiveId}</dd></div>
          <div><dt>DATE</dt><dd>{C.fecha}</dd></div>
          <div><dt>SYS VER.</dt><dd>{C.sysVer}</dd></div>
          <div><dt>BUILD</dt><dd>{C.build}</dd></div>
        </dl>
        <p class="kxc__barra" aria-hidden="true"></p>
        <p class="kxc__lema">PATTERN. PROTECT. PERPETUATE.<br />BUILT FOR ARCHIVES THAT REMEMBER.</p>
        <p class={`kxc__sello kxc__sello--${C.sello}`}>{C.selloTexto}</p>
      </header>

      {/* ── 01 · NAVIGATION PANEL ────────────────────────────────────── */}
      <section class="kxc__p kxc__p--nav">
        <h2 class="kxc__rot">01. NAVIGATION PANEL</h2>
        <div class="kxc__nav2">
          <div>
            <p class="kxc__sub">COORDINATE READOUT</p>
            <dl class="kxc__coord">
              <div><dt>X</dt><dd data-kdx-coord="x">0.000° N</dd><dd class="kxc__fijo">+17.382°</dd></div>
              <div><dt>Y</dt><dd data-kdx-coord="y">0.000° E</dd><dd class="kxc__fijo">−41.707°</dd></div>
              <div><dt>Z</dt><dd data-kdx-coord="z">0.000° Ω</dd><dd class="kxc__fijo">+06.618°</dd></div>
            </dl>
          </div>
          <div>
            <p class="kxc__sub">NAV STATUS</p>
            <dl class="kxc__pares">
              <div><dt>SIGNAL</dt><dd>STRONG</dd></div>
              <div><dt>ORIGIN</dt><dd>{C.archiveId}</dd></div>
              <div><dt>VECTOR</dt><dd>STABLE</dd></div>
              <div><dt>DRIFT</dt><dd data-kdx-drift>0.00087%</dd></div>
              <div><dt>PARALLAX</dt><dd>7 LAYERS</dd></div>
            </dl>
          </div>
          <div>
            <p class="kxc__sub">ORBITAL REFERENCE</p>
            <dl class="kxc__pares">
              {REFERENCIA.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            </dl>
          </div>
          <div>
            <p class="kxc__sub">LEGEND / GLYPH KEY</p>
            <ul class="kxc__leyenda">
              {LEYENDA.map((l) => (
                <li><b aria-hidden="true">{l.g}</b> {l.en} / {l.es}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      {/* ── 02 · SCENE STATES ────────────────────────────────────────── */}
      <section class="kxc__p kxc__p--estados">
        <h2 class="kxc__rot">02. SCENE STATES</h2>
        <ul class="kxc__estados">
          {ESTADOS.map((e) => (
            <li>
              <button type="button" data-kdx-fase={e.id} aria-pressed={e.id === 'MAP' ? 'true' : 'false'}>
                <b>{e.id}</b>
                <span>{e.lineas.map((l) => <em>{l}</em>)}</span>
              </button>
            </li>
          ))}
        </ul>
      </section>

      {/* ── 03 · MOTION NOTES ────────────────────────────────────────── */}
      <section class="kxc__p kxc__p--motion">
        <h2 class="kxc__rot">03. MOTION NOTES</h2>
        <div class="kxc__motion">
          {MOVIMIENTO.map((m) => (
            <div>
              <b>{m.n}</b>
              {m.lineas.map((l) => <span>{l}</span>)}
            </div>
          ))}
        </div>
      </section>

      {/* ── 04 · ORBIT MAP · el hero ─────────────────────────────────── */}
      <section class="kxc__p kxc__p--mapa">
        <h2 class="kxc__rot">04. ORBIT MAP / NÚCLEO COSMOLÓGICO <b data-kdx-fase-rot>MAP</b></h2>
        <div class="kxc__mapa" data-kdx-orbita data-acento={C.acento} data-apoyo={C.apoyo}>
          <canvas></canvas>
          <p class="kxc__rotulo" data-kdx-orbita-rotulo hidden></p>
        </div>
        <div class="kxc__capas">
          <span>PARALLAX LAYERS</span>
          {['L1', 'L2', 'L3', 'L4', 'L5', 'L6', 'L7'].map((l) => <b>{l}</b>)}
        </div>
      </section>

      {/* ── 05 · DIAGRAM STUDIES ─────────────────────────────────────── */}
      <section class="kxc__p kxc__p--estudios">
        <h2 class="kxc__rot">05. DIAGRAM STUDIES</h2>
        <ul>
          {ESTUDIOS.map((e, i) => (
            <li>
              <canvas data-kdx-estudio={i} width="150" height="110"></canvas>
              <span>{e}</span>
            </li>
          ))}
        </ul>
      </section>

      {/* ── 06 · CONSTELLATION GLYPHS ────────────────────────────────── */}
      <section class="kxc__p kxc__p--glifos">
        <h2 class="kxc__rot">06. CONSTELLATION GLYPHS</h2>
        <ul>
          {ARQUETIPOS.map((a, i) => (
            <li>
              <a href={`/kodex/vol/${a.destino}/`}>
                <span>{a.nombre}</span>
                <canvas data-kdx-arquetipo={i} data-nodos={a.nodos} width="110" height="110"></canvas>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {/* ── 07 · SIGNAL CHARTS ───────────────────────────────────────── */}
      <section class="kxc__p kxc__p--senales">
        <h2 class="kxc__rot">07. SIGNAL CHARTS</h2>
        <p class="kxc__sub">FREQUENCY BANDS</p>
        <canvas data-kdx-bandas width="460" height="54"></canvas>
        <ul class="kxc__bandas">{BANDAS.map((b) => <li>{b}</li>)}</ul>
        <p class="kxc__sub">SIGNAL STRENGTH <b data-kdx-fuerza>87.6%</b></p>
        <canvas data-kdx-fuerza-onda width="460" height="26"></canvas>
        <p class="kxc__sub">CORE RESONANCE <b>Ψ 0.618</b></p>
        <canvas data-kdx-resonancia width="460" height="26"></canvas>
      </section>

      {/* ── SPECTRUM READOUT ─────────────────────────────────────────── */}
      <section class="kxc__p kxc__p--espectro">
        <h2 class="kxc__rot">SPECTRUM READOUT</h2>
        <canvas data-kdx-espectro width="220" height="220"></canvas>
      </section>

      {/* ── 08 · ORBITAL LOGIC ───────────────────────────────────────── */}
      <section class="kxc__p kxc__p--logica">
        <h2 class="kxc__rot">08. ORBITAL LOGIC (PSEUDO CODE)</h2>
        <ol class="kxc__codigo">
          {LOGICA.map((l) => <li><code>{l}</code></li>)}
        </ol>
        <p class="kxc__nota">ESTE CÓDIGO ES EL QUE CORRE EN EL PANEL 04.</p>
      </section>

      {/* ── 09 · ORBITAL SYSTEM DATA ─────────────────────────────────── */}
      <section class="kxc__p kxc__p--datos">
        <h2 class="kxc__rot">09. ORBITAL SYSTEM DATA</h2>
        <table>
          <thead>
            <tr><th>ID</th><th>TYPE</th><th>NAME</th><th>MASS</th><th>ORBIT RADIUS</th><th>PERIOD</th><th>STATUS</th></tr>
          </thead>
          <tbody>
            {CUERPOS.map((c) => (
              <tr data-estado={c.estado.toLowerCase()}>
                <td>{c.id}</td>
                <td>{c.tipo.toUpperCase()}</td>
                <td>{c.nombre}</td>
                <td>{c.masa}</td>
                <td>{c.periodo > 0 ? `${c.radio.toFixed(2)} AU` : 'N/A'}</td>
                <td>{c.periodo > 0 ? c.periodo.toFixed(2) : 'N/A'}</td>
                <td>{c.estado}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      {/* ── 10 · CORE TELEMETRY ──────────────────────────────────────── */}
      <section class="kxc__p kxc__p--tele">
        <h2 class="kxc__rot">10. CORE TELEMETRY</h2>
        <dl class="kxc__pares">
          {TELEMETRIA.map((t) => (
            <div>
              <dt>{t.k}</dt>
              <dd data-kdx-tele={t.vivo ? t.v : ''} data-amp={t.amp ?? 0} data-u={t.u}>{t.v}{t.u}</dd>
            </div>
          ))}
        </dl>
      </section>

      {/* ── 11 · MOBILE SCENE TILE (9:16) ────────────────────────────── */}
      <section class="kxc__p kxc__p--movil">
        <h2 class="kxc__rot">11. MOBILE SCENE TILE (9:16)</h2>
        <div class="kxc__tile">
          <div class="kxc__tileCab"><b>KODEX−∞</b><span>/ ORBIT MAP</span></div>
          <canvas data-kdx-tile width="270" height="330"></canvas>
          <ul class="kxc__tileCtl">
            {['SCAN', 'ORBIT', 'ALIGN', 'REVEAL'].map((c) => <li>{c}</li>)}
          </ul>
        </div>
        <dl class="kxc__pares kxc__pares--tile">
          <div><dt>STATUS</dt><dd>SIGNAL ACTIVE</dd></div>
          <div><dt>LOCATION</dt><dd>SECTOR 02 · VOID SERPENTIS</dd></div>
          <div><dt>DEPTH</dt><dd>LAYER 5/7</dd></div>
          <div><dt>CORE SYNC</dt><dd data-kdx-sync>98.2%</dd></div>
        </dl>
      </section>

      {/* ── PIE ──────────────────────────────────────────────────────── */}
      <footer class="kxc__pie">
        <b>KODEX−∞</b>
        <p class="kxc__barra" aria-hidden="true"></p>
        <span>VISUAL SYSTEM v2.0</span>
        <span class="kxc__lemaPie">BUILT FOR ARCHIVES THAT REMEMBER.</span>
        <span>PATTERN. PROTECT. PERPETUATE.</span>
        <a href="/kodex/folio/iii/">ÍNDICE ›</a>
      </footer>
    </div>
  </div>
</Base>

<script>
  import '../../../components/kodex/capitulo/orbita-client.ts';
  import '../../../components/kodex/capitulo/capitulo-client.ts';
</script>

<style>
  /* ── La plancha del capítulo ────────────────────────────────────────────
     La grilla del póster, panel por panel. No es una interpretación libre: las
     áreas están donde el plano las pone. */
  .kxc {
    position: relative;
    /* Altura DEFINIDA. Con `min-height` el contenido estira la plancha y las
       filas dejan de acotar: el pie y media lámina se van abajo del pliegue.
       Ya pasó en la lámina de volumen; es la misma cura. */
    height: 100dvh;
    overflow: hidden;
    display: grid;
    gap: 1px;
    padding: clamp(8px, 1vw, 14px) clamp(8px, 1vw, 14px) 30px;
    box-sizing: border-box;
    grid-template-columns: minmax(210px, 17%) minmax(0, 1.15fr) minmax(0, 0.85fr) minmax(180px, 15%);
    /* Filas DECLARADAS. Sin esto son `auto` y la columna izquierda —  tres
       paneles apilados — estira la plancha hasta empujar el pie fuera de
       pantalla. Con pistas flexibles cada panel scrollea por dentro y la
       lámina conserva su tamaño, que es lo que la hace lámina. */
    grid-template-rows: auto minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.2fr) auto;
    grid-template-areas:
      "cab      cab     cab       cab"
      "nav      mapa    estudios  estudios"
      "estados  mapa    glifos    glifos"
      "motion   mapa    senales   espectro"
      "logica   datos   tele      movil"
      "pie      pie     pie       pie";
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    color: #e8e5df;
    background: #04050a;
    isolation: isolate;
  }
  .kxc__campo { position: absolute; inset: 0; z-index: 0; opacity: 0.42; }

  /* La barra del chrome flota fija al pie y cruzaba los paneles de abajo. El
     capítulo tiene su propio pie con índice: dos navegaciones encimadas no son
     más accesibles, son una tapando a la otra. */
  :global(.kx--cap .kx-deckbar) { display: none; }
  :global(.kx--cap .kx-astro) { display: none; }

  .kxc__p {
    /* El campo es un elemento posicionado y pintaría por encima de cualquier
       hermano estático. Los paneles llevan position para ganarle. */
    position: relative;
    z-index: 1;
    border: 1px solid color-mix(in srgb, var(--acc) 20%, transparent);
    background: rgba(4, 5, 10, 0.78);
    padding: 7px 9px 9px;
    display: grid;
    gap: 6px;
    align-content: start;
    min-height: 0;
    overflow: auto;
    scrollbar-width: none;
  }
  .kxc__p::-webkit-scrollbar { display: none; }

  .kxc__rot {
    margin: 0;
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--acc);
    display: flex;
    justify-content: space-between;
    gap: 8px;
    border-bottom: 1px solid color-mix(in srgb, var(--acc) 16%, transparent);
    padding-bottom: 4px;
  }
  .kxc__rot b { color: var(--apoyo); font-weight: 400; }

  .kxc__sub {
    margin: 0;
    font-size: 7.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(232, 229, 222, 0.42);
    display: flex;
    justify-content: space-between;
  }
  .kxc__sub b { color: var(--acc); font-weight: 500; }

  /* ── Cabecera ────────────────────────────────────────────────────────── */
  .kxc__cab {
    grid-area: cab;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.4vw, 22px);
    border: 1px solid color-mix(in srgb, var(--acc) 26%, transparent);
    background: rgba(4, 5, 10, 0.85);
    padding: 6px 10px;
    flex-wrap: wrap;
  }
  .kxc__sigilo {
    width: 58px; height: 58px; flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--acc) 45%, transparent);
    display: grid; place-items: end center; padding-bottom: 3px;
    background:
      radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--acc) 34%, transparent) 0 22%, transparent 60%);
  }
  .kxc__sigilo span { font-size: 6.5px; letter-spacing: 0.14em; color: var(--acc); }

  .kxc__titulo { flex: 1 1 260px; min-width: 0; }
  .kxc__titulo h1 {
    margin: 0;
    font-family: "Archivo Black", "Anton", ui-sans-serif, sans-serif;
    font-size: clamp(15px, 2.1vw, 27px);
    line-height: 1.04;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .kxc__titulo h1 span { color: var(--acc); }
  .kxc__titulo p {
    margin: 2px 0 0;
    font-size: 8.5px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--acc); opacity: 0.75;
  }

  .kxc__meta { display: flex; gap: clamp(7px, 1.2vw, 18px); margin: 0; flex-wrap: wrap; }
  .kxc__meta dt { font-size: 6.5px; letter-spacing: 0.16em; color: rgba(232, 229, 222, 0.34); }
  .kxc__meta dd {
    margin: 0; font-size: 9px; letter-spacing: 0.08em;
    color: var(--acc); font-variant-numeric: tabular-nums;
  }

  .kxc__barra {
    margin: 0; height: 22px; flex: 0 0 clamp(70px, 8vw, 130px);
    opacity: 0.55; color: #e8e5df;
    background: repeating-linear-gradient(
      90deg, currentColor 0 2px, transparent 2px 5px, currentColor 5px 6px, transparent 6px 10px);
  }
  .kxc__lema {
    margin: 0; font-size: 6.5px; letter-spacing: 0.16em; line-height: 1.7;
    color: rgba(232, 229, 222, 0.42);
  }
  .kxc__sello {
    margin: 0; font-size: 7px; letter-spacing: 0.14em; padding: 3px 7px;
    border: 1px solid;
    /* El sello se parte en dos líneas antes que salirse de la cabecera: es la
       marca de registro y tiene que leerse entera. */
    max-width: 190px; line-height: 1.5;
    color: #FF8A5B; border-color: rgba(255, 138, 91, 0.5);
    background-image: repeating-linear-gradient(
      45deg, rgba(255, 138, 91, 0.12) 0 4px, transparent 4px 8px);
  }

  /* ── 01 Nav ──────────────────────────────────────────────────────────── */
  .kxc__p--nav { grid-area: nav; }
  .kxc__nav2 { display: grid; gap: 8px; }
  .kxc__pares, .kxc__coord { display: grid; gap: 0; margin: 0; }
  .kxc__pares div, .kxc__coord div {
    display: flex; justify-content: space-between; gap: 8px;
    padding: 2px 0; border-bottom: 1px solid rgba(232, 229, 222, 0.06);
  }
  .kxc__pares dt, .kxc__coord dt {
    font-size: 7.5px; letter-spacing: 0.12em; color: rgba(232, 229, 222, 0.4);
  }
  .kxc__pares dd, .kxc__coord dd {
    margin: 0; font-size: 8px; letter-spacing: 0.06em;
    color: #e8e5df; font-variant-numeric: tabular-nums;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .kxc__coord .kxc__fijo { color: var(--acc); }

  .kxc__leyenda { display: grid; gap: 1px; margin: 0; padding: 0; list-style: none; }
  .kxc__leyenda li {
    font-size: 7.5px; letter-spacing: 0.08em; color: rgba(232, 229, 222, 0.62);
    display: flex; gap: 6px; align-items: baseline;
  }
  .kxc__leyenda b { color: var(--acc); font-size: 9px; width: 12px; }

  /* ── 02 Estados ──────────────────────────────────────────────────────── */
  .kxc__p--estados { grid-area: estados; }
  .kxc__estados { display: grid; gap: 3px; margin: 0; padding: 0; list-style: none; }
  .kxc__estados button {
    width: 100%; text-align: left; cursor: pointer;
    display: grid; gap: 2px; padding: 5px 7px;
    background: transparent; color: inherit;
    border: 1px solid color-mix(in srgb, var(--acc) 22%, transparent);
    font-family: inherit;
    transition: background 180ms ease, border-color 180ms ease;
  }
  .kxc__estados button b {
    font-family: "Archivo Black", "Anton", ui-sans-serif, sans-serif;
    font-size: 13px; letter-spacing: 0.06em; color: var(--acc);
  }
  .kxc__estados button span { display: grid; }
  .kxc__estados button em {
    font-style: normal; font-size: 7px; letter-spacing: 0.08em;
    color: rgba(232, 229, 222, 0.45);
  }
  .kxc__estados button[aria-pressed="true"] {
    background: color-mix(in srgb, var(--acc) 13%, transparent);
    border-color: var(--acc);
  }
  .kxc__estados button[aria-pressed="true"] em { color: rgba(232, 229, 222, 0.8); }
  .kxc__estados button:hover { border-color: var(--acc); }
  .kxc__estados button:focus-visible { outline: 1px solid var(--acc); outline-offset: -3px; }

  /* ── 03 Motion ───────────────────────────────────────────────────────── */
  .kxc__p--motion { grid-area: motion; }
  .kxc__motion { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .kxc__motion div { display: grid; gap: 1px; }
  .kxc__motion b {
    font-size: 8px; letter-spacing: 0.16em; color: var(--apoyo); font-weight: 500;
  }
