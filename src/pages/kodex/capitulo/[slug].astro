---
/**
 * KODEX-∞ · MOTOR DE CAPÍTULOS
 *
 * Una ruta para los planos. **Agregar un capítulo es agregar una entrada al
 * registro**, no escribir una página: la misma división que sostiene la
 * biblioteca de volúmenes, aplicada a los dieciocho pósters.
 *
 * El plano manda la composición y el registro manda el contenido. Los paneles
 * se transcriben al pie de la letra — los cuatro umbrales del panel 06 son los
 * cuatro umbrales que corren en el shader, los rótulos son los del póster, la
 * paleta es exacta.
 */
import Base from '../../../layouts/Base.astro';
import KodexChrome from '../../../components/KodexChrome.astro';
import KodexTransition from '../../../components/kodex/transition/KodexTransition.astro';
import KodexDebug from '../../../components/kodex/debug/KodexDebug.astro';
import '../../../styles/kodex.css';
import {
  CAPITULOS, ESTADOS_SENAL, MOTION_SENAL, TEXTURAS, LOGICA_SENAL,
  SELLOS, ANCLAS, type CapituloMotor,
} from '../../../lib/kodex/capitulos';

export async function getStaticPaths() {
  return CAPITULOS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: CapituloMotor };
const CAPAS = ['LAYER 07', 'LAYER 06', 'LAYER 05', 'LAYER 04', 'LAYER 03', 'LAYER 02', 'LAYER 01'];
---

<Base
  kodexFonts={true}
  title={`${c.titulo} — KODEX−∞`}
  description={`${c.subtitulo_en} / ${c.subtitulo_es} · capítulo ${c.tanda} del archivo KODEX−∞.`}
  robots="index, follow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div
    class="kx kx--cap"
    data-kx
    data-kdx-tool="intensificar"
    data-kdx-recipe={`CAP_${c.build}`}
    style={`--acc:${c.acento};--apoyo:${c.apoyo};--kdx-scene-accent:${c.acento}`}
  >
    <KodexTransition />
    <KodexDebug />
    <KodexChrome segs={7} />

    <div class="kxb" data-kdx-capitulo-bloom>
      {/* ── CABECERA ─────────────────────────────────────────────────── */}
      <header class="kxb__cab">
        <div class="kxb__titulo">
          <h1>KODEX−∞ <span>/ {c.titulo}</span></h1>
          <p>{c.subtitulo_en} / {c.subtitulo_es}</p>
        </div>
        <p class="kxb__barra" aria-hidden="true"></p>
        <dl class="kxb__meta">
          <div><dt>SYS VER.</dt><dd>{c.sysVer}</dd></div>
          <div><dt>BUILD</dt><dd>{c.build}</dd></div>
          <div><dt>DATE</dt><dd>{c.fecha}</dd></div>
          <div><dt>SEED HASH</dt><dd>{c.seedHash}</dd></div>
        </dl>
        <p class="kxb__lema">PATTERN. PROTECT. PERPETUATE.<br />BUILT FOR ARCHIVES THAT REMEMBER.</p>
        <p class="kxb__sello">{c.selloTexto}</p>
      </header>

      {/* ── 01 · SIGNAL STATES ───────────────────────────────────────── */}
      <section class="kxb__p kxb__p--estados">
        <h2 class="kxb__rot">01. SIGNAL STATES <b>/ ESTADOS DE SEÑAL</b></h2>
        <ul>
          {ESTADOS_SENAL.map((e) => (
            <li style={`--c:${e.color}`}>
              <button type="button" data-kdx-bloom-estado={e.id} aria-pressed={e.id === 'IDLE' ? 'true' : 'false'}>
                <b>{e.id}</b>
                <canvas data-kdx-mini={e.id} data-th={e.threshold} width="120" height="120"></canvas>
                {e.lineas.map((l) => <em>{l}</em>)}
                <span>THRESHOLD {e.threshold.toFixed(2)}</span>
              </button>
            </li>
          ))}
        </ul>
      </section>

      {/* ── 02 · MOTION NOTES ────────────────────────────────────────── */}
      <section class="kxb__p kxb__p--motion">
        <h2 class="kxb__rot">02. MOTION NOTES <b>/ NOTAS DE MOVIMIENTO</b></h2>
        <ul>
          {MOTION_SENAL.map((m) => (
            <li style={`--c:${m.color}`}>
              <b>{m.n}</b>
              <canvas data-kdx-onda={m.n} width="130" height="34"></canvas>
              {m.lineas.map((l) => <em>{l}</em>)}
            </li>
          ))}
        </ul>
      </section>

      {/* ── 03 · TEXTURE CROPS ───────────────────────────────────────── */}
      <section class="kxb__p kxb__p--texturas">
        <h2 class="kxb__rot">03. TEXTURE CROPS <b>/ MATERIALES DE SEÑAL</b></h2>
        <ul>
          {TEXTURAS.map((t, i) => (
            <li style={`--c:${t.color}`}>
              <canvas data-kdx-textura={i} width="130" height="96"></canvas>
              <span>{t.n}</span>
            </li>
          ))}
        </ul>
      </section>

      {/* ── 04 · WAVEFORM / SPECTRAL ─────────────────────────────────── */}
      <section class="kxb__p kxb__p--onda">
        <h2 class="kxb__rot">04. WAVEFORM / SPECTRAL ANALYSIS</h2>
        <p class="kxb__sub">WAVEFORM</p>
        <canvas data-kdx-wave width="300" height="42"></canvas>
        <p class="kxb__sub">SPECTRAL</p>
        <canvas data-kdx-spec width="300" height="42"></canvas>
        <dl class="kxb__pares">
          <div><dt>SIGNAL FREQ</dt><dd>13.37 Hz</dd></div>
          <div><dt>COHERENCE</dt><dd data-kdx-coherencia>0.72</dd></div>
          <div><dt>ENERGY</dt><dd data-kdx-energia>87.2%</dd></div>
        </dl>
      </section>

      {/* ── 05 · TRANSMISSION FIELD · el hero ────────────────────────── */}
      <section class="kxb__p kxb__p--campo">
        <h2 class="kxb__rot">05. TRANSMISSION FIELD <b data-kdx-bloom-rot>IDLE</b></h2>
        <div
          class="kxb__campo"
          data-kdx-bloom
          data-color-a="#9000FF"
          data-color-b="#FF00FF"
          data-color-core="#FFFFFF"
        >
          <canvas></canvas>
          {/* Respaldo declarado: si WebGL2 falta o el shader no compila, el
              panel dice qué pasó en vez de quedarse negro. */}
          <p class="kxb__caido">TRANSMISSION FIELD · SIN WEBGL2</p>
        </div>
        <div class="kxb__campoPie">
          <span>ORIGIN · LIVING PATTERNS / ARCHIVE STREAM</span>
          <span>ENERGY <b data-kdx-energia2>87.2%</b></span>
        </div>
      </section>

      {/* ── LAYER STACK + COHERENCE ──────────────────────────────────── */}
      <section class="kxb__p kxb__p--capas">
        <h2 class="kxb__rot">LAYER STACK</h2>
        <ul class="kxb__capas">
          {CAPAS.map((l, i) => <li data-activa={i === 3 ? 'si' : undefined}>{l}</li>)}
        </ul>
        <p class="kxb__sub">COHERENCE</p>
        <p class="kxb__grande" data-kdx-coherencia2>0.72</p>
      </section>

      {/* ── 05b · AUTH SEALS ─────────────────────────────────────────── */}
      <section class="kxb__p kxb__p--sellos">
        <h2 class="kxb__rot">AUTHENTICATION <b>/ AUTENTICACIÓN</b></h2>
        <ul>
          {SELLOS.map((col, i) => (
            <li style={`--c:${col}`}><canvas data-kdx-sello={i} width="120" height="120"></canvas></li>
          ))}
        </ul>
        <p class="kxb__sub">AUTH SEALS · MISMO ÁRBOL, CUATRO SEÑALES</p>
      </section>

      {/* ── GLYPH LIBRARY + IDENTITY ANCHORS ─────────────────────────── */}
      <section class="kxb__p kxb__p--glifos">
        <h2 class="kxb__rot">GLYPH LIBRARY</h2>
        <ul class="kxb__glifos">
          {Array.from({ length: 22 }).map((_, i) => (
            <li><canvas data-kdx-glifo={i} width="52" height="52"></canvas></li>
          ))}
        </ul>
        <h2 class="kxb__rot">IDENTITY ANCHORS</h2>
        <ul class="kxb__anclas">
          {ANCLAS.map((a) => (
            <li>
              {a.tipo === 'marca'
                ? <b class="kxb__ancla">KODEX−∞</b>
                : a.tipo === 'barcode'
                ? <p class="kxb__barra kxb__barra--ancla" aria-hidden="true"></p>
                : <canvas data-kdx-ancla={a.tipo} width="90" height="60"></canvas>}
              <span>{a.n}</span>
            </li>
          ))}
        </ul>
      </section>

      {/* ── 06 · SIGNAL LOGIC ────────────────────────────────────────── */}
      <section class="kxb__p kxb__p--logica">
        <h2 class="kxb__rot">06. SIGNAL LOGIC <b>/ PSEUDO CODE</b></h2>
        <pre><code>{LOGICA_SENAL.join('\n')}</code></pre>
        <p class="kxb__sub">MODES</p>
        <ul class="kxb__modos">
          {ESTADOS_SENAL.map((e) => (
            <li style={`--c:${e.color}`}>// {e.id}: THRESHOLD = {e.threshold.toFixed(2)}</li>
          ))}
        </ul>
        <p class="kxb__nota">ESTE CÓDIGO ES EL QUE CORRE EN EL PANEL 05.</p>
      </section>

      {/* ── 07 · PALETTE ─────────────────────────────────────────────── */}
      <section class="kxb__p kxb__p--paleta">
        <h2 class="kxb__rot">07. PALETTE <b>/ NEON GRADIENT</b></h2>
        <ul class="kxb__muestras">
          {c.paleta.map((h) => <li style={`--c:${h}`}><i></i><span>{h}</span></li>)}
        </ul>
        <p class="kxb__sub">NEON GRADIENT (SIGNAL FLOW)</p>
        <p class="kxb__grad" aria-hidden="true"></p>
      </section>

      {/* ── 08 · MOBILE TILE ─────────────────────────────────────────── */}
      <section class="kxb__p kxb__p--movil">
        <h2 class="kxb__rot">08. MOBILE TILE (9:16)</h2>
        <div class="kxb__tile">
          <div class="kxb__tileCab"><b>KODEX−∞</b><span>SIGNAL BLOOM</span></div>
          <canvas data-kdx-tile width="180" height="256"></canvas>
          <p>TRANSMISSION FIELD</p>
        </div>
      </section>

      {/* ── 10 · DATA TAGS ───────────────────────────────────────────── */}
      <section class="kxb__p kxb__p--tags">
        <h2 class="kxb__rot">10. DATA TAGS <b>/ ETIQUETAS DE DATOS</b></h2>
        <dl class="kxb__pares kxb__pares--dos">
          <div><dt>SIGNAL ID</dt><dd>{c.seedHash}</dd></div>
          <div><dt>ARCHIVE</dt><dd>{c.archivo}</dd></div>
          <div><dt>CLASS</dt><dd>{c.clase}</dd></div>
          <div><dt>CATEGORY</dt><dd>{c.categoria}</dd></div>
          <div><dt>STATUS</dt><dd data-kdx-status>ACTIVE</dd></div>
          <div><dt>CLEARANCE</dt><dd>LEVEL {c.clearance}</dd></div>
        </dl>
        <p class="kxb__clear">{c.clearance}<em>CLEARANCE LEVEL</em></p>
      </section>

      {/* ── PIE ──────────────────────────────────────────────────────── */}
      <footer class="kxb__pie">
        <b>KODEX−∞</b>
        <p class="kxb__barra" aria-hidden="true"></p>
        <span>VISUAL SYSTEM v2.0</span>
        <span class="kxb__lemaPie">BUILT FOR ARCHIVES THAT REMEMBER.</span>
        <a href="/kodex/folio/iii/">ÍNDICE ›</a>
      </footer>
    </div>
  </div>
</Base>

<script>
  import '../../../components/kodex/capitulo/bloom-client.ts';
  import '../../../components/kodex/capitulo/bloom-paneles.ts';
</script>

<style>
  .kxb {
    position: relative;
    /* Altura definida: es una lámina y tiene el tamaño que tiene. Con
       `min-height` el contenido la estira y el pie se va del pliegue. */
    height: 100dvh;
    overflow: hidden;
    display: grid;
    gap: 1px;
    padding: clamp(7px, 0.9vw, 13px) clamp(7px, 0.9vw, 13px) 28px;
    box-sizing: border-box;
    grid-template-columns: minmax(180px, 15.5%) minmax(0, 1.25fr) minmax(0, 0.72fr) minmax(150px, 13%);
    grid-template-rows: auto minmax(0, 1fr) minmax(0, 0.72fr) minmax(0, 0.8fr) minmax(0, 0.62fr) auto;
    grid-template-areas:
      "cab       cab    cab      cab"
      "estados   campo  sellos   sellos"
      "motion    campo  glifos   glifos"
      "texturas  campo  logica   paleta"
      "onda      tags   logica   movil"
      "pie       pie    pie      pie";
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    color: #e8e5df;
    background: #05050a;
    isolation: isolate;
  }

  :global(.kx--cap .kx-deckbar), :global(.kx--cap .kx-astro) { display: none; }

  .kxb__p {
    position: relative; z-index: 1;
    border: 1px solid color-mix(in srgb, var(--acc) 18%, transparent);
    background: rgba(5, 5, 10, 0.8);
    padding: 6px 8px 8px;
    display: grid; gap: 5px; align-content: start;
    min-height: 0; overflow: auto; scrollbar-width: none;
  }
  .kxb__p::-webkit-scrollbar { display: none; }

  .kxb__rot {
    margin: 0; font-size: 7.5px; font-weight: 500; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--acc);
    display: flex; justify-content: space-between; gap: 6px;
    border-bottom: 1px solid color-mix(in srgb, var(--acc) 16%, transparent);
    padding-bottom: 3px;
  }
  .kxb__rot b { font-weight: 400; color: rgba(232, 229, 222, 0.36); }
  .kxb__sub {
    margin: 0; font-size: 6.5px; letter-spacing: 0.16em; text-transform: uppercase;
    color: rgba(232, 229, 222, 0.38);
  }

  /* ── Cabecera ────────────────────────────────────────────────────────── */
  .kxb__cab {
    grid-area: cab; position: relative; z-index: 1;
    display: flex; align-items: center; gap: clamp(8px, 1.4vw, 22px);
    border: 1px solid color-mix(in srgb, var(--acc) 26%, transparent);
    background: rgba(5, 5, 10, 0.88); padding: 5px 10px; flex-wrap: wrap;
  }
  .kxb__titulo { flex: 1 1 240px; min-width: 0; }
  .kxb__titulo h1 {
    margin: 0; font-family: "Archivo Black", "Anton", ui-sans-serif, sans-serif;
    font-size: clamp(14px, 2vw, 26px); line-height: 1.04;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .kxb__titulo h1 span { color: var(--acc); }
  .kxb__titulo p {
    margin: 2px 0 0; font-size: 8px; letter-spacing: 0.22em;
    text-transform: uppercase; color: rgba(232, 229, 222, 0.45);
  }
  .kxb__meta { display: flex; gap: clamp(7px, 1.2vw, 18px); margin: 0; flex-wrap: wrap; }
  .kxb__meta dt { font-size: 6px; letter-spacing: 0.16em; color: rgba(232, 229, 222, 0.32); }
  .kxb__meta dd { margin: 0; font-size: 8.5px; color: var(--acc); font-variant-numeric: tabular-nums; }
  .kxb__lema { margin: 0; font-size: 6px; letter-spacing: 0.14em; line-height: 1.7; color: rgba(232, 229, 222, 0.34); }
  .kxb__sello {
    margin: 0; font-size: 6.5px; letter-spacing: 0.12em; padding: 3px 6px;
    border: 1px solid; max-width: 175px; line-height: 1.5;
    color: #FF8A5B; border-color: rgba(255, 138, 91, 0.5);
    background-image: repeating-linear-gradient(45deg, rgba(255,138,91,0.12) 0 4px, transparent 4px 8px);
  }
  .kxb__barra {
    margin: 0; height: 20px; flex: 0 0 clamp(60px, 7vw, 120px); opacity: 0.5; color: #e8e5df;
    background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 5px, currentColor 5px 6px, transparent 6px 10px);
  }
  .kxb__barra--ancla { height: 26px; flex: none; width: 100%; }

  /* ── 01 Estados ──────────────────────────────────────────────────────── */
  .kxb__p--estados { grid-area: estados; }
  /* Los cuatro estados a la vista. En una sola columna el panel scrollea y se
     ven dos: el ciclo IDLE→BUILD→BLOOM→DISPERSE hay que poder LEERLO entero. */
  .kxb__p--estados ul {
    display: grid; grid-template-columns: 1fr 1fr; gap: 3px;
    margin: 0; padding: 0; list-style: none;
  }
  .kxb__p--estados button {
    width: 100%; display: grid; gap: 2px; padding: 4px 6px; cursor: pointer;
    background: transparent; color: inherit; text-align: left; font-family: inherit;
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
    transition: background 180ms ease, border-color 180ms ease;
  }
  .kxb__p--estados button b {
    font-family: "Archivo Black", "Anton", sans-serif; font-size: 11px; color: var(--c);
  }
  .kxb__p--estados canvas {
    width: 100%; height: auto; aspect-ratio: 1;
    border: 1px solid rgba(232, 229, 222, 0.07);
  }
  .kxb__p--estados em {
    font-style: normal; font-size: 6.2px; letter-spacing: 0.08em; color: rgba(232, 229, 222, 0.44);
  }
  .kxb__p--estados span { font-size: 6px; letter-spacing: 0.1em; color: var(--c); opacity: 0.7; }
  .kxb__p--estados button[aria-pressed="true"] {
    background: color-mix(in srgb, var(--c) 14%, transparent); border-color: var(--c);
  }
  .kxb__p--estados button:focus-visible { outline: 1px solid var(--c); outline-offset: -3px; }

  /* ── 02 Motion ───────────────────────────────────────────────────────── */
  .kxb__p--motion { grid-area: motion; }
  .kxb__p--motion ul { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; margin: 0; padding: 0; list-style: none; }
  .kxb__p--motion li { display: grid; gap: 1px; }
  .kxb__p--motion b { font-size: 7.5px; letter-spacing: 0.14em; color: var(--c); }
  .kxb__p--motion canvas { width: 100%; height: auto; aspect-ratio: 130 / 34; }
  .kxb__p--motion em { font-style: normal; font-size: 6px; color: rgba(232, 229, 222, 0.4); }

  /* ── 03 Texturas ─────────────────────────────────────────────────────── */
  .kxb__p--texturas { grid-area: texturas; }
  .kxb__p--texturas ul { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .kxb__p--texturas li { display: grid; gap: 2px; }
  .kxb__p--texturas canvas {
    width: 100%; height: auto; aspect-ratio: 130 / 96;
    border: 1px solid color-mix(in srgb, var(--c) 26%, transparent);
  }
  .kxb__p--texturas span { font-size: 6px; letter-spacing: 0.1em; color: var(--c); text-align: center; }

  /* ── 04 Onda ─────────────────────────────────────────────────────────── */
  .kxb__p--onda { grid-area: onda; }
  .kxb__p--onda canvas { width: 100%; height: auto; display: block; }
  .kxb__pares { display: grid; gap: 0; margin: 0; }
  .kxb__pares--dos { grid-template-columns: 1fr 1fr; gap: 0 12px; }
  .kxb__pares div {
    display: flex; justify-content: space-between; gap: 8px; padding: 2px 0;
    border-bottom: 1px solid rgba(232, 229, 222, 0.06);
  }
  .kxb__pares dt { font-size: 6.5px; letter-spacing: 0.12em; color: rgba(232, 229, 222, 0.38); }
  .kxb__pares dd { margin: 0; font-size: 7.5px; color: #e8e5df; font-variant-numeric: tabular-nums; }

  /* ── 05 Campo · el hero ──────────────────────────────────────────────── */
  .kxb__p--campo {
    grid-area: campo; overflow: hidden;
    grid-template-rows: auto minmax(0, 1fr) auto;
    /* `align-content: start` del panel genérico colapsa la fila `1fr` a cero y
       el hero dibuja en un lienzo de 0px. Ya pasó con el mapa orbital. */
    align-content: stretch;
  }
  .kxb__campo { position: relative; min-height: 0; background: #000; }
  .kxb__campo canvas { display: block; width: 100%; height: 100%; }
  .kxb__caido {
    position: absolute; inset: 0; margin: 0; display: none; place-items: center;
    font-size: 8px; letter-spacing: 0.2em; color: rgba(232, 229, 222, 0.5);
  }
  .kxb__campo[data-kdx-bloom-error] canvas { display: none; }
  .kxb__campo[data-kdx-bloom-error] .kxb__caido { display: grid; }
  .kxb__campoPie {
    display: flex; justify-content: space-between; gap: 10px;
    font-size: 6.5px; letter-spacing: 0.14em; color: rgba(232, 229, 222, 0.4);
  }
  .kxb__campoPie b { color: var(--acc); }

  /* La pila de capas y la coherencia viven dentro del panel 04, que es donde
     el plano las pone: son lectura de la misma señal. */
  .kxb__p--capas { display: none; }

  /* ── Sellos ──────────────────────────────────────────────────────────── */
  .kxb__p--sellos { grid-area: sellos; }
  .kxb__p--sellos ul { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin: 0; padding: 0; list-style: none; }
  .kxb__p--sellos canvas {
    width: 100%; height: auto; aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--c) 34%, transparent); border-radius: 50%;
    /* Los sellos ROTAN, como pide el plano — pero por CSS y no redibujando.
       Girar una imagen ya dibujada no cuesta nada; redibujar cuatro árboles
       fractales por cuadro costaría más que el campo entero. */
    animation: kxbGiro 26s linear infinite;
  }
  /* Cada uno a su ritmo y en sentidos alternos: cuatro sellos girando iguales
     se leen como una sola pieza rotando, no como cuatro autenticaciones. */
  .kxb__p--sellos li:nth-child(2) canvas { animation-duration: 34s; animation-direction: reverse; }
  .kxb__p--sellos li:nth-child(3) canvas { animation-duration: 44s; }
  .kxb__p--sellos li:nth-child(4) canvas { animation-duration: 30s; animation-direction: reverse; }

  @keyframes kxbGiro { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .kxb__p--sellos canvas { animation: none; }
  }

  /* ── Glifos + anclas ─────────────────────────────────────────────────── */
  .kxb__p--glifos {
    grid-area: glifos;
    /* Pistas declaradas: rótulo · biblioteca · rótulo · anclas. Con filas
       automáticas la biblioteca de 22 glifos se comía el alto y las anclas
       quedaban aplastadas contra el pie del panel — cuatro cajas vacías. El
       alto de las anclas hay que RESERVARLO, no esperarlo. */
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    align-content: stretch;
  }
  .kxb__glifos {
    display: grid; grid-template-columns: repeat(11, 1fr); gap: 2px;
    margin: 0; padding: 0; list-style: none; align-content: start;
