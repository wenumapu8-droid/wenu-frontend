---
/**
 * KODEX-∞ · MOTOR DE CAPÍTULOS
 *
 * Una ruta para los planos. **Agregar un capítulo es agregar una entrada al
 * registro**, no escribir una página.
 *
 * Esta ruta no dibuja: elige. El chrome, la transición, la sonda y el marco son
 * comunes a todos los capítulos; lo que cambia es el PLANO, y cada plano vive
 * en su componente porque cada póster tiene su propia anatomía. Meterlos a
 * todos en un condicional gigante sería tener un motor con forma de switch.
 */
import Base from '../../../layouts/Base.astro';
import KodexChrome from '../../../components/KodexChrome.astro';
import KodexTransition from '../../../components/kodex/transition/KodexTransition.astro';
import KodexDebug from '../../../components/kodex/debug/KodexDebug.astro';
import PlanoBloom from '../../../components/kodex/capitulo/PlanoBloom.astro';
import PlanoCraneo from '../../../components/kodex/capitulo/PlanoCraneo.astro';
import PlanoArbol from '../../../components/kodex/capitulo/PlanoArbol.astro';
import PlanoOjo from '../../../components/kodex/capitulo/PlanoOjo.astro';
import '../../../styles/kodex.css';
import { CAPITULOS, type CapituloMotor } from '../../../lib/kodex/capitulos';

export async function getStaticPaths() {
  return CAPITULOS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: CapituloMotor };
---

<Base
  kodexFonts={true}
  title={`${c.titulo} — KODEX−∞`}
  description={`${c.subtitulo_en} / ${c.subtitulo_es} · capítulo ${c.tanda} del archivo KODEX−∞.`}
  robots="index, follow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div
    class="kx kx--cap"
    data-kx
    data-kdx-tool="intensificar"
    data-kdx-recipe={`CAP_${c.build}`}
    style={`--acc:${c.acento};--apoyo:${c.apoyo};--kdx-scene-accent:${c.acento}`}
  >
    <KodexTransition />
    <KodexDebug />
    <KodexChrome segs={7} />

    {c.plano === 'ojo'
      ? <PlanoOjo c={c} />
      : c.plano === 'arbol'
      ? <PlanoArbol c={c} />
      : c.plano === 'craneo'
      ? <PlanoCraneo c={c} />
      : <PlanoBloom c={c} />}
  </div>
</Base>
