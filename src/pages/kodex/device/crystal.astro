---
import Base from '../../../layouts/Base.astro';
import '../../../styles/kodex.css';

const truthStates = ['RECEIVED', 'INTERPRETED', 'CORRELATED', 'VERIFIED'];
const signalModes = ['VOICE', 'GLYPH', 'COLOR', 'BODY', 'MOTION', 'NUMBER', 'DREAM', 'SKY', 'SYNC'];
---

<Base
  title="KODEX−∞ // CRYSTAL RECEIVER"
  description="KODEX−∞ signal receiver: capture, classify, correlate and remember without collapsing uncertainty."
  robots="noindex, nofollow"
  kodexFonts={true}
  noNav={true}
  noFooter={true}
  noOverlays={true}
  noQuote={true}
  noThemes={true}
  noKai={true}
  noCart={true}
  noImmersive={true}
>
  <main class="crystal" data-crystal-device data-state="DORMANT">
    <div class="crystal__noise" aria-hidden="true"></div>

    <header class="crystal__header">
      <div>
        <p class="crystal__eyebrow">KODEX−∞ // DEVICE 01</p>
        <h1>CRYSTAL RECEIVER</h1>
      </div>
      <div class="crystal__status" aria-live="polite" aria-atomic="true">
        <span>STATE</span>
        <strong data-state-label>DORMANT</strong>
      </div>
    </header>

    <section class="crystal__grid">
      <aside class="crystal__rail crystal__rail--left" aria-label="Receiver telemetry">
        <div><span>SOURCE</span><strong data-source>UNKNOWN</strong></div>
        <div><span>DENSITY</span><strong data-density>D0</strong></div>
        <div><span>COHERENCE</span><strong data-coherence>0.00</strong></div>
        <div><span>RECURRENCE</span><strong data-recurrence>00</strong></div>
        <div><span>SPIN</span><strong data-spin>+0.00</strong></div>
        <div><span>MEMORY</span><strong data-memory>00</strong></div>
      </aside>

      <section class="crystal__core" aria-labelledby="receiver-title">
        <div class="crystal__field" data-field>
          <span class="crystal__orbit crystal__orbit--a" aria-hidden="true"></span>
          <span class="crystal__orbit crystal__orbit--b" aria-hidden="true"></span>
          <span class="crystal__orbit crystal__orbit--c" aria-hidden="true"></span>
          <span class="crystal__axis crystal__axis--x" aria-hidden="true"></span>
          <span class="crystal__axis crystal__axis--y" aria-hidden="true"></span>
          <span class="crystal__diamond crystal__diamond--matter" aria-hidden="true"><b>M</b></span>
          <span class="crystal__diamond crystal__diamond--signal" aria-hidden="true"><b>S</b></span>
          <span class="crystal__diamond crystal__diamond--observer" aria-hidden="true"><b>O</b></span>
          <button
            class="crystal__heart"
            type="button"
            data-activate
            aria-label="Activate Crystal Receiver or open signal capture"
            aria-describedby="receiver-instruction"
          >
            <span aria-hidden="true">◈</span>
          </button>
        </div>

        <h2 id="receiver-title">MATTER × SIGNAL × OBSERVER</h2>
        <p id="receiver-instruction" class="crystal__instruction" data-instruction>
          ACTIVATE RECEIVER. RECORD FIRST. INTERPRET LATER.
        </p>
      </section>

      <aside class="crystal__rail crystal__rail--right" aria-label="Epistemic state">
        <p class="crystal__rail-title">TRUTH LAYER</p>
        {truthStates.map((truthState, index) => (
          <div class="crystal__truth" data-truth={truthState} data-active={index === 0 ? 'true' : 'false'}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{truthState}</strong>
          </div>
        ))}
      </aside>
    </section>

    <section class="crystal__capture" data-capture hidden aria-labelledby="capture-title">
      <div class="crystal__capture-head">
        <div>
          <p class="crystal__eyebrow">SIGNAL CAPTURE</p>
          <h2 id="capture-title">WHAT APPEARED?</h2>
        </div>
        <button type="button" data-close-capture>CLOSE</button>
      </div>

      <div class="crystal__modes" role="group" aria-label="Signal mode">
        {signalModes.map((mode, index) => (
          <button type="button" data-mode={mode} data-selected={index === 0 ? 'true' : 'false'}>{mode}</button>
        ))}
      </div>

      <label class="crystal__label">
        RAW SIGNAL // RECEIVED
        <textarea data-raw rows="5" placeholder="Describe only what appeared: word, image, geometry, sensation, direction, sound, number…"></textarea>
      </label>

      <div class="crystal__fields">
        <label>SYMBOL / FORM<input data-symbol placeholder="spiral / eye / lattice / unknown" /></label>
        <label>COLOR<input data-color placeholder="blue / black / white / unknown" /></label>
        <label>BODY LOCATION<input data-body placeholder="chest / head / hands / none" /></label>
        <label>NUMBER<input data-number placeholder="3 / 11:11 / none" /></label>
      </div>

      <div class="crystal__sliders">
        <label>INTENSITY <output data-intensity-output>50</output><input data-intensity type="range" min="0" max="100" value="50" /></label>
        <label>CLARITY <output data-clarity-output>50</output><input data-clarity type="range" min="0" max="100" value="50" /></label>
      </div>

      <label class="crystal__label crystal__interpretation" data-interpretation-field hidden>
        INTERPRETATION // INTERPRETED
        <textarea data-interpretation rows="3" placeholder="What do you think it may mean? Keep this separate from the raw signal."></textarea>
      </label>

      <div class="crystal__actions">
        <button type="button" class="crystal__primary" data-record>COMMIT TO MEMORY</button>
        <button type="button" data-mark-interpretation aria-pressed="false">ADD INTERPRETATION LAYER</button>
      </div>
    </section>

    <section class="crystal__memory" aria-labelledby="memory-title">
      <div class="crystal__memory-head">
        <div>
          <p class="crystal__eyebrow">LIVING MEMORY</p>
          <h2 id="memory-title">SIGNAL CONSTELLATION</h2>
        </div>
        <button type="button" data-clear-memory>RESET LOCAL PROOF</button>
      </div>
      <div class="crystal__memory-list" data-memory-list>
        <p class="crystal__empty">NO SIGNALS RECORDED.</p>
      </div>
    </section>

    <footer class="crystal__footer">
      <span>CLAIM ≠ EVIDENCE ≠ EXPLANATION ≠ UNKNOWN</span>
      <span data-clock>00:00:00</span>
    </footer>
  </main>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-crystal-device]');
      if (!root) return;

      const $ = (selector) => root.querySelector(selector);
      const $$ = (selector) => [...root.querySelectorAll(selector)];
      const storageKey = 'kodex.crystal.receiver.v0';

      let state = 'DORMANT';
      let selectedMode = 'VOICE';
      let interpretationLayer = false;
      let records = [];

      try {
        records = JSON.parse(localStorage.getItem(storageKey) || '[]');
        if (!Array.isArray(records)) records = [];
      } catch {
        records = [];
      }

      const stateLabel = $('[data-state-label]');
      const capture = $('[data-capture]');
      const instruction = $('[data-instruction]');
      const raw = $('[data-raw]');
      const symbol = $('[data-symbol]');
      const color = $('[data-color]');
      const body = $('[data-body]');
      const number = $('[data-number]');
      const intensity = $('[data-intensity]');
      const clarity = $('[data-clarity]');
      const interpretation = $('[data-interpretation]');
      const interpretationField = $('[data-interpretation-field]');
      const interpretationToggle = $('[data-mark-interpretation]');
      const memoryList = $('[data-memory-list]');

      function setState(next) {
        state = next;
        root.dataset.state = next;
        stateLabel.textContent = next;

        if (next === 'DORMANT') instruction.textContent = 'ACTIVATE RECEIVER. RECORD FIRST. INTERPRET LATER.';
        if (next === 'AWARE') instruction.textContent = 'RECEIVER OPEN. OBSERVE WITHOUT EXPLAINING.';
        if (next === 'RECORDING') instruction.textContent = 'CAPTURE THE SIGNAL BEFORE INTERPRETATION.';
        if (next === 'COHERENT') instruction.textContent = 'PATTERN RECURRENCE DETECTED.';
        if (next === 'CRYSTAL') instruction.textContent = 'CRYSTAL STATE // MULTIPLE LAYERS HELD WITHOUT COLLAPSE.';
      }

      function normalise(value) {
        return (value || '').trim().toLowerCase();
      }

      function recurrenceFor(candidate, allRecords) {
        const keys = ['symbol', 'color', 'number'];
        return allRecords.reduce((score, record) => {
          return score + keys.reduce((sub, key) => {
            const a = normalise(candidate[key]);
            const b = normalise(record[key]);
            return sub + (a && b && a === b ? 1 : 0);
          }, 0);
        }, 0);
      }

      function metrics() {
        const count = records.length;
        const recurrences = records.reduce((sum, record, index) => {
          return sum + recurrenceFor(record, records.slice(0, index));
        }, 0);
        const avgClarity = count ? records.reduce((sum, record) => sum + Number(record.clarity || 0), 0) / count : 0;
        const coherence = Math.min(1, (avgClarity / 100) * 0.45 + Math.min(recurrences / 6, 1) * 0.55);
        const density = count === 0 ? 0 : Math.min(8, 1 + Math.floor(count / 2) + Math.floor(recurrences / 2));
        const spin = Math.max(-1, Math.min(1, ((recurrences * 0.17) + (count * 0.03)) % 2 - 1));
        return { count, recurrences, coherence, density, spin };
      }

      function stableState(m = metrics()) {
        if (m.count === 0) return 'DORMANT';
        if (m.count >= 5 && m.recurrences >= 4 && m.coherence >= 0.72) return 'CRYSTAL';
        if (m.count >= 3 && m.recurrences >= 2 && m.coherence >= 0.55) return 'COHERENT';
        return 'AWARE';
      }

      function updateTelemetry() {
        const m = metrics();
        $('[data-density]').textContent = `D${m.density}`;
        $('[data-coherence]').textContent = m.coherence.toFixed(2);
        $('[data-recurrence]').textContent = String(m.recurrences).padStart(2, '0');
        $('[data-spin]').textContent = `${m.spin >= 0 ? '+' : ''}${m.spin.toFixed(2)}`;
        $('[data-memory]').textContent = String(m.count).padStart(2, '0');
        root.style.setProperty('--crystal-coherence', String(m.coherence));
        root.style.setProperty('--crystal-spin', `${m.spin * 18}deg`);
        setState(stableState(m));
      }

      function escapeHtml(value) {
        return String(value ?? '')
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;')
          .replaceAll("'", '&#039;');
      }

      function renderMemory() {
        if (!records.length) {
          memoryList.innerHTML = '<p class="crystal__empty">NO SIGNALS RECORDED.</p>';
          updateTelemetry();
          return;
        }

        memoryList.innerHTML = records.slice().reverse().map((record, reverseIndex) => {
          const index = records.length - reverseIndex;
          const rec = recurrenceFor(record, records.filter((_, i) => i !== index - 1));
          const tags = [record.symbol, record.color, record.number]
            .filter(Boolean)
            .map((tag) => `<span>${escapeHtml(tag)}</span>`)
            .join('');
          const interpretationMarkup = record.interpretation
            ? `<p class="crystal__record-interpretation"><span>INTERPRETED</span>${escapeHtml(record.interpretation)}</p>`
            : '';

          return `<article class="crystal__record">
            <div class="crystal__record-index">${String(index).padStart(3, '0')}</div>
            <div>
              <p><strong>${escapeHtml(record.mode)}</strong> // ${new Date(record.timestamp).toLocaleString()}</p>
              <h3><span class="crystal__received-label">RECEIVED</span>${escapeHtml(record.raw || 'UNNAMED SIGNAL')}</h3>
              ${interpretationMarkup}
              <div class="crystal__tags">${tags}</div>
            </div>
            <div class="crystal__record-meta">
              <span>REC ${String(rec).padStart(2, '0')}</span>
              <span>${record.interpretation ? 'RECEIVED + INTERPRETED' : 'RECEIVED'}</span>
            </div>
          </article>`;
        }).join('');

        updateTelemetry();
      }

      function resetInterpretationLayer() {
        interpretationLayer = false;
        interpretation.value = '';
        interpretationField.hidden = true;
        interpretationToggle.dataset.active = 'false';
        interpretationToggle.setAttribute('aria-pressed', 'false');
        interpretationToggle.textContent = 'ADD INTERPRETATION LAYER';
        $$('[data-truth]').forEach((item) => {
          item.dataset.active = String(item.dataset.truth === 'RECEIVED');
        });
      }

      $('[data-activate]').addEventListener('click', () => {
        if (state === 'DORMANT') {
          setState('AWARE');
          return;
        }

        capture.hidden = false;
        setState('RECORDING');
        raw.focus();
      });

      $('[data-close-capture]').addEventListener('click', () => {
        capture.hidden = true;
        resetInterpretationLayer();
        updateTelemetry();
      });

      $$('[data-mode]').forEach((button) => {
        button.addEventListener('click', () => {
          selectedMode = button.dataset.mode;
          $$('[data-mode]').forEach((item) => {
            item.dataset.selected = String(item === button);
          });
        });
      });

      interpretationToggle.addEventListener('click', () => {
        interpretationLayer = !interpretationLayer;
        interpretationField.hidden = !interpretationLayer;
        interpretationToggle.dataset.active = String(interpretationLayer);
        interpretationToggle.setAttribute('aria-pressed', String(interpretationLayer));
        interpretationToggle.textContent = interpretationLayer ? 'INTERPRETATION LAYER: ON' : 'ADD INTERPRETATION LAYER';

        $$('[data-truth]').forEach((item) => {
          item.dataset.active = String(item.dataset.truth === (interpretationLayer ? 'INTERPRETED' : 'RECEIVED'));
        });

        if (interpretationLayer) interpretation.focus();
      });

      intensity.addEventListener('input', () => $('[data-intensity-output]').textContent = intensity.value);
      clarity.addEventListener('input', () => $('[data-clarity-output]').textContent = clarity.value);

      $('[data-record]').addEventListener('click', () => {
        const rawValue = raw.value.trim();
        if (!rawValue) {
          raw.focus();
          raw.setAttribute('aria-invalid', 'true');
          return;
        }
        raw.removeAttribute('aria-invalid');

        const interpretationValue = interpretationLayer ? interpretation.value.trim() : '';
        const record = {
          id: crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random()}`,
          timestamp: new Date().toISOString(),
          mode: selectedMode,
          raw: rawValue,
          symbol: symbol.value.trim(),
          color: color.value.trim(),
          body: body.value.trim(),
          number: number.value.trim(),
          intensity: Number(intensity.value),
          clarity: Number(clarity.value),
          epistemic: 'RECEIVED',
          interpretation: interpretationValue,
          interpretationEpistemic: interpretationValue ? 'INTERPRETED' : null,
          source: 'UNKNOWN'
        };

        records.push(record);
        localStorage.setItem(storageKey, JSON.stringify(records));

        [raw, symbol, color, body, number].forEach((input) => input.value = '');
        intensity.value = '50';
        clarity.value = '50';
        $('[data-intensity-output]').textContent = '50';
        $('[data-clarity-output]').textContent = '50';
        capture.hidden = true;
        resetInterpretationLayer();
        renderMemory();
      });

      $('[data-clear-memory]').addEventListener('click', () => {
        records = [];
        localStorage.removeItem(storageKey);
        capture.hidden = true;
        resetInterpretationLayer();
        renderMemory();
      });

      setInterval(() => {
        $('[data-clock]').textContent = new Date().toLocaleTimeString('en-GB', { hour12: false });
      }, 1000);

      renderMemory();
    })();
  </script>

  <style is:global>
    :root { background: #050505; }
    body { margin: 0; background: #050505; color: #f3f1e8; overflow-x: hidden; }
    .crystal { --crystal-coherence: 0; --crystal-spin: 0deg; min-height: 100vh; padding: 18px; box-sizing: border-box; background: radial-gradient(circle at 50% 42%, rgba(255,255,255,.045), transparent 30%), #050505; font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); position: relative; isolation: isolate; }
    .crystal__noise { position: fixed; inset: 0; pointer-events: none; opacity: .08; background-image: repeating-linear-gradient(0deg, transparent 0 3px, rgba(255,255,255,.06) 3px 4px); mix-blend-mode: screen; z-index: -1; }
    .crystal__header, .crystal__footer, .crystal__memory-head, .crystal__capture-head { display: flex; justify-content: space-between; gap: 18px; align-items: flex-end; }
    .crystal__header { border-top: 1px solid rgba(255,255,255,.7); border-bottom: 1px solid rgba(255,255,255,.2); padding: 10px 0 14px; }
    .crystal__eyebrow, .crystal__rail span, .crystal__footer, .crystal__record-meta, .crystal__label, .crystal__fields label, .crystal__sliders label { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; }
    .crystal h1, .crystal h2, .crystal h3, .crystal p { margin: 0; }
    .crystal h1 { font-size: clamp(28px, 5vw, 72px); letter-spacing: -.05em; font-weight: 600; }
    .crystal h2 { font-size: clamp(15px, 2vw, 24px); letter-spacing: .08em; }
    .crystal__status { text-align: right; display: grid; gap: 4px; }
    .crystal__status span { font-size: 9px; letter-spacing: .18em; opacity: .55; }
    .crystal__status strong { font-size: 14px; }
    .crystal__grid { min-height: 68vh; display: grid; grid-template-columns: minmax(150px, 230px) 1fr minmax(150px, 230px); border-bottom: 1px solid rgba(255,255,255,.2); }
    .crystal__rail { padding: 18px 0; display: flex; flex-direction: column; justify-content: center; gap: 14px; }
    .crystal__rail--left { border-right: 1px solid rgba(255,255,255,.16); padding-right: 18px; }
    .crystal__rail--right { border-left: 1px solid rgba(255,255,255,.16); padding-left: 18px; }
    .crystal__rail > div { display: grid; grid-template-columns: 1fr auto; gap: 10px; border-bottom: 1px solid rgba(255,255,255,.09); padding-bottom: 8px; }
    .crystal__rail span { opacity: .48; }
    .crystal__rail strong { font-size: 11px; letter-spacing: .08em; }
    .crystal__rail-title { font-size: 9px; letter-spacing: .2em; opacity: .45; margin-bottom: 6px !important; }
    .crystal__truth[data-active="true"] { opacity: 1; }
    .crystal__truth { opacity: .25; transition: opacity .3s ease; }
    .crystal__core { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; padding: 28px; text-align: center; }
    .crystal__field { width: min(48vw, 520px); aspect-ratio: 1; position: relative; display: grid; place-items: center; transform: rotate(var(--crystal-spin)); transition: transform 1.2s cubic-bezier(.2,.8,.2,1); }
    .crystal__orbit { position: absolute; inset: 9%; border: 1px solid rgba(255,255,255,.22); border-radius: 50%; transform: rotate(0deg) scale(calc(.88 + var(--crystal-coherence) * .12)); transition: transform .7s ease, border-color .7s ease; }
    .crystal__orbit--b { inset: 20%; border-radius: 44% 56% 50% 50%; transform: rotate(33deg); }
    .crystal__orbit--c { inset: 31%; border-radius: 50% 42% 58% 46%; transform: rotate(-22deg); }
    .crystal__axis { position: absolute; background: rgba(255,255,255,.16); }
    .crystal__axis--x { width: 86%; height: 1px; }
    .crystal__axis--y { height: 86%; width: 1px; }
    .crystal__diamond { position: absolute; width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.36); transform: rotate(45deg); font-size: 10px; }
    .crystal__diamond b { display: block; transform: rotate(-45deg); font-weight: 500; }
    .crystal__diamond--matter { left: 4%; bottom: 18%; }
    .crystal__diamond--signal { right: 4%; bottom: 18%; }
    .crystal__diamond--observer { top: 3%; }
    .crystal__heart { width: clamp(90px, 10vw, 140px); aspect-ratio: 1; border: 1px solid rgba(255,255,255,.75); background: rgba(0,0,0,.72); color: #fff; transform: rotate(45deg); cursor: pointer; transition: box-shadow .6s ease, background .6s ease, transform .6s ease; }
    .crystal__heart span { display: block; transform: rotate(-45deg); font-size: clamp(30px, 4vw, 54px); }
    .crystal button:focus-visible, .crystal textarea:focus-visible, .crystal input:focus-visible { outline: 1px solid #f3f1e8; outline-offset: 3px; }
    .crystal[data-state="AWARE"] .crystal__heart, .crystal[data-state="RECORDING"] .crystal__heart { box-shadow: 0 0 50px rgba(255,255,255,.12); }
    .crystal[data-state="COHERENT"] .crystal__heart { box-shadow: 0 0 80px rgba(255,255,255,.24); background: rgba(255,255,255,.05); }
    .crystal[data-state="CRYSTAL"] .crystal__heart { box-shadow: 0 0 120px rgba(255,255,255,.4), inset 0 0 45px rgba(255,255,255,.12); background: rgba(255,255,255,.09); }
    .crystal[data-state="CRYSTAL"] .crystal__orbit { border-color: rgba(255,255,255,.72); }
    .crystal__instruction { margin-top: 10px !important; max-width: 680px; opacity: .55; font-size: 11px; letter-spacing: .14em; }
    .crystal__capture { margin: 18px 0; padding: 18px; border: 1px solid rgba(255,255,255,.32); background: rgba(8,8,8,.96); }
    .crystal__capture[hidden], .crystal__interpretation[hidden] { display: none; }
    .crystal button { font: inherit; color: inherit; }
    .crystal__capture-head button, .crystal__memory-head button, .crystal__modes button, .crystal__actions button { border: 1px solid rgba(255,255,255,.24); background: transparent; padding: 9px 11px; font-size: 9px; letter-spacing: .12em; cursor: pointer; }
    .crystal__modes { display: flex; flex-wrap: wrap; gap: 6px; margin: 18px 0; }
    .crystal__modes button[data-selected="true"], .crystal__actions button[data-active="true"], .crystal__primary { background: #f3f1e8 !important; color: #050505 !important; }
    .crystal__label { display: grid; gap: 8px; }
    .crystal__interpretation { margin-top: 18px; }
    .crystal textarea, .crystal input { width: 100%; box-sizing: border-box; border: 1px solid rgba(255,255,255,.18); background: #090909; color: #f3f1e8; padding: 11px; font: inherit; border-radius: 0; }
    .crystal textarea[aria-invalid="true"] { border-color: #fff; box-shadow: 0 0 0 1px #fff; }
    .crystal__fields { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 10px; }
    .crystal__fields label, .crystal__sliders label { display: grid; gap: 6px; }
    .crystal__sliders { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 18px 0; }
    .crystal__sliders label { grid-template-columns: auto 1fr auto; align-items: center; }
    .crystal__actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 18px; }
    .crystal__memory { margin: 34px 0 20px; }
    .crystal__memory-head { border-bottom: 1px solid rgba(255,255,255,.24); padding-bottom: 10px; }
    .crystal__memory-list { display: grid; }
    .crystal__empty { padding: 26px 0; opacity: .35; font-size: 11px; letter-spacing: .14em; }
    .crystal__record { display: grid; grid-template-columns: 70px 1fr auto; gap: 18px; padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,.11); align-items: start; }
    .crystal__record-index { font-size: 24px; opacity: .25; }
    .crystal__record p { font-size: 9px; letter-spacing: .12em; opacity: .45; }
    .crystal__record h3 { margin-top: 6px; font-size: 14px; font-weight: 500; display: grid; gap: 5px; }
    .crystal__received-label, .crystal__record-interpretation span { font-size: 8px; letter-spacing: .14em; opacity: .45; }
    .crystal__record-interpretation { margin-top: 9px !important; display: grid; gap: 4px; opacity: .72 !important; font-size: 11px !important; letter-spacing: .02em !important; }
    .crystal__tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
    .crystal__tags span { border: 1px solid rgba(255,255,255,.18); padding: 4px 6px; font-size: 9px; text-transform: uppercase; }
    .crystal__record-meta { display: grid; text-align: right; gap: 6px; opacity: .42; }
    .crystal__footer { padding: 10px 0 0; opacity: .55; }

    @media (max-width: 820px) {
      .crystal { padding: 12px; }
