---
/**
 * KODEX−∞ · STRATA — el índice de estratos (costura 4 del circuito)
 *
 * La pantalla 02 del diseño del creador es el hub del archivo: seis estratos
 * con nombre, y la elección de cuál descender. No existía en el sitio — era la
 * brecha #1 del estudio del circuito.
 *
 * NADA INVENTADO: los seis nombres y sus subtítulos están transcritos de la
 * pantalla (el sitio va en inglés por decisión del creador; los subtítulos se
 * traducen y el original queda al lado). La taxonomía ya existe en el
 * manifiesto (`estratos` declarados); acá sólo se le da puerta.
 *
 * HONESTIDAD DEL ESTADO: 24 de 1.427 volúmenes tienen estrato asignado. El hub
 * lo dice — "the stratum is still being assigned" — en vez de fingir un archivo
 * lleno. La asignación masiva es curaduría del creador.
 */
import Base from '../../../layouts/Base.astro';
import { leerManifiesto, resolver, decir } from '../../../lib/kodex/volumenes';

const vols = resolver(await leerManifiesto());

/* Los seis, textuales de pantalla-02 (traducción marcada con el original). */
const estratos = [
  { id: 'macro-geometrias', n: '01', nombre: 'MACRO-GEOMETRIES', sub: 'the origin of forms', es: 'el origen de las formas' },
  { id: 'portales', n: '02', nombre: 'PORTALS', sub: 'thresholds of transformation', es: 'umbrales de transformación' },
  { id: 'geometrias-respirantes', n: '03', nombre: 'BREATHING GEOMETRIES', sub: 'patterns that exhale and pulse', es: 'patrones que expiran y pulsan' },
  { id: 'sol-negro', n: '04', nombre: 'BLACK SUN', sub: 'the union of the ancestral and the digital', es: 'la unión de lo ancestral y lo digital' },
  { id: 'yayentru', n: '05', nombre: 'YAYENTRU', sub: 'geometry of energy and connection', es: 'geometría de energía y conexión' },
  { id: 'laboratorio', n: '06', nombre: 'LABORATORY', sub: 'code, AI and generative art', es: 'código, IA y arte generativo' },
].map((e) => ({
  ...e,
  volumenes: vols.filter((v) => v.estrato === e.id),
}));
const curados = estratos.reduce((s, e) => s + e.volumenes.length, 0);
---

<Base
  title="Strata — KODEX−∞"
  description="The eight strata of the KODEX−∞ archive: choose which layer to descend."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div class="kxs">
    <header class="kxs-cab">
      <a class="kxs-marca" href="/kodex/">KODEX<span>−∞</span></a>
      <nav class="kxs-nav" aria-label="archive lanes">
        <a href="/kodex/archive/">ARCHIVE</a>
        <a href="/kodex/lamina/">PLATES</a>
        <a href="/kodex/editions/">EDITIONS</a>
      </nav>
    </header>

    <main class="kxs-cuerpo">
      <p class="kxs-ojo">◉ LIVING ARCHIVE</p>
      <h1 class="kxs-titulo">STRATA OF THE SYSTEM</h1>
      <p class="kxs-lema">THIS ARCHIVE EXPANDS. EACH ACCESS, A NEW LAYER.</p>

      <ol class="kxs-lista" role="list">
        {estratos.map((e) => (
          <li class="kxs-estrato">
            <span class="kxs-num">{e.n}</span>
            <div class="kxs-cuerpo-e">
              <strong>{e.nombre}</strong>
              <span class="kxs-sub">{e.sub} · <i lang="es">{e.es}</i></span>
              {e.volumenes.length > 0 ? (
                <div class="kxs-vols">
                  {e.volumenes.slice(0, 4).map((v) => (
                    <a href={`/kodex/vol/${v.id}/`}>{decir(v.titulo_es, v.titulo_en, 'en')}</a>
                  ))}
                  {e.volumenes.length > 4 && <span class="kxs-mas">+{e.volumenes.length - 4}</span>}
                </div>
              ) : (
                <span class="kxs-vacio">STRATUM STILL BEING ASSIGNED — THE ARCHIVE CURATES SLOWLY</span>
              )}
            </div>
            <span class="kxs-cta">{e.volumenes.length > 0 ? `${e.volumenes.length} CURATED` : 'LATENT'}</span>
          </li>
        ))}
      </ol>

      <p class="kxs-nota">
        {curados} of 1,427 volumes carry a stratum today. Assignment is curation —
        it belongs to the creator, and this index will fill as the archive is read.
      </p>
    </main>

    <footer class="kxs-pie">
      <span>KDX://STRATA</span>
      <a href="/kodex/archive/">← THE ARCHIVE</a>
    </footer>
  </div>
</Base>

<style>
  .kxs{ min-height:100vh; min-height:100dvh; display:flex; flex-direction:column;
    background:#0a0a0a; color:#f0ede8; font-family:'IBM Plex Mono',ui-monospace,monospace; }
  .kxs-cab{ display:flex; justify-content:space-between; align-items:center; gap:14px;
    padding:clamp(14px,2.4vh,22px) clamp(18px,3.4vw,44px); border-bottom:1px solid rgba(240,237,232,.1); }
  .kxs-marca{ color:#f0ede8; text-decoration:none; letter-spacing:.18em; font-size:14px; }
  .kxs-marca span{ color:#ff2733; }
  .kxs-nav{ display:flex; gap:18px; flex-wrap:wrap; }
  .kxs-nav a{ color:rgba(240,237,232,.55); text-decoration:none; font-size:10.5px; letter-spacing:.2em;
    min-height:44px; display:inline-flex; align-items:center; }
  .kxs-nav a:hover{ color:#f0ede8; }
  .kxs-cuerpo{ flex:1; width:min(92vw,820px); margin:0 auto; padding:clamp(26px,5vh,56px) 0; }
  .kxs-ojo{ margin:0 0 10px; font-size:11px; letter-spacing:.26em; color:#ff2733; }
  .kxs-titulo{ margin:0 0 8px; font-family:'Barlow Condensed','Inter Tight',system-ui,sans-serif;
    font-weight:800; font-size:clamp(36px,6.4vw,64px); letter-spacing:.02em; }
  .kxs-lema{ margin:0 0 clamp(22px,4vh,36px); font-size:11.5px; letter-spacing:.18em; color:rgba(240,237,232,.5); }
  .kxs-lista{ list-style:none; margin:0; padding:0; display:grid; gap:10px; }
  .kxs-estrato{ display:grid; grid-template-columns:auto 1fr auto; gap:16px; align-items:start;
    padding:16px 18px; border:1px solid rgba(240,237,232,.14); }
  .kxs-num{ font-size:13px; color:#ff2733; letter-spacing:.1em; padding-top:2px; }
  .kxs-cuerpo-e{ display:flex; flex-direction:column; gap:5px; min-width:0; }
  .kxs-cuerpo-e strong{ font-size:16px; letter-spacing:.16em; }
  .kxs-sub{ font-size:11px; letter-spacing:.06em; color:rgba(240,237,232,.55); }
  .kxs-sub i{ font-style:italic; color:rgba(240,237,232,.38); }
  .kxs-vols{ display:flex; flex-wrap:wrap; gap:6px 14px; margin-top:6px; }
  /* 44 px de alto mínimo: medido, los enlaces quedaban en 31 y no se podían
     tocar con el dedo. */
  .kxs-vols a{ color:#e8b4bc; text-decoration:none; font-size:11px; letter-spacing:.08em;
    border-bottom:1px solid rgba(232,180,188,.3); padding:12px 0; min-height:44px;
    display:inline-flex; align-items:center; }
  .kxs-vols a:hover{ color:#fff; border-color:#fff; }
  .kxs-mas{ font-size:11px; color:rgba(240,237,232,.4); padding:6px 0; }
  .kxs-vacio{ font-size:10px; letter-spacing:.14em; color:rgba(240,237,232,.35); margin-top:4px; }
  .kxs-cta{ font-size:9.5px; letter-spacing:.2em; color:rgba(240,237,232,.4); padding-top:4px; white-space:nowrap; }
  .kxs-nota{ margin:clamp(20px,3.4vh,30px) 0 0; font-size:11px; line-height:1.7; letter-spacing:.04em;
    color:rgba(240,237,232,.45); max-width:60ch; }
  .kxs-pie{ display:flex; justify-content:space-between; gap:10px;
    padding:12px clamp(18px,3.4vw,44px); border-top:1px solid rgba(240,237,232,.1);
    font-size:9.5px; letter-spacing:.16em; color:rgba(240,237,232,.4); }
  .kxs-pie a{ color:rgba(240,237,232,.55); text-decoration:none; }
  @media (max-width:560px){ .kxs-estrato{ grid-template-columns:auto 1fr; } .kxs-cta{ display:none; } }
</style>
