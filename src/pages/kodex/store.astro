---
// KODEX −∞ · STORE — the archive made matter. Digital-product language
// (Fox Rockett / aescripts) in KODEX skin. Everything is WIRED with explicit
// states: FREE downloads work now; prints / stickers / tees (POD), NFT and
// donations show COMING SOON until Ocin connects the accounts (Printful/Gelato,
// Foundation/Rarible, checkout). Isolated via KodexShell — zero commerce chrome
// from the main store, zero Kai/UFO.
import KodexShell from '../../layouts/KodexShell.astro';
import { families, discoWorks, opName } from '../../lib/kodex.js';

const MAIL = 'marimari@wenumapuonline.com';
const products = [
  ...families.map((f) => ({ n: f.n, url: `/img/kodex/${f.dir}/${f.rep}.jpg`, ops: f.ops, acc: f.th.c })),
  ...discoWorks.map((f) => ({ n: f.n, url: `/img/kodex/${f.dir}/${f.rep}.jpg`, ops: f.ops, acc: f.th.c })),
];
// channel wiring — flip `soon:false` + add `href` as each account comes online
const channels = [
  { k: 'FREE DOWNLOAD', s: 'AVAILABLE', soon: false, d: 'Every plate, free. Liberation of the archive — take it, print it, remix it.' },
  { k: 'PRINTS · POSTERS', s: 'COMING SOON', soon: true, d: 'Museum-grade prints & posters, printed and shipped on demand — no stock.' },
  { k: 'STICKERS · TEES', s: 'COMING SOON', soon: true, d: 'Wearable sigils and cut stickers via print-on-demand.' },
  { k: 'NFT · COLLECTIBLE', s: 'COMING SOON', soon: true, d: 'Signed on-chain editions. The generative act, made scarce.' },
  { k: 'SUPPORT · DONATE', s: 'COMING SOON', soon: true, d: 'Fuel the laboratory. Keep the archive free and originating.' },
  { k: 'PINTEREST', s: 'FOLLOW', soon: false, href: 'https://www.pinterest.com/', d: 'Follow the signal — new plates and readings as they surface.' },
];
const mailReq = (subj) => `mailto:${MAIL}?subject=${encodeURIComponent('KODEX −∞ · ' + subj)}`;
// downloadable repos — curated sets of plates as high-res files (free · liberation)
const packs = [
  { name: 'ACHROMA',     sub: 'The true forms · black & white',  n: 12, size: '4.1 MB', file: '/img/kodex/packs/kodex-achroma.zip',     acc: '#cfc7b6' },
  { name: 'DISCO SOLAR', sub: 'Signal in colour · neon fractal', n: 11, size: '6.1 MB', file: '/img/kodex/packs/kodex-disco-solar.zip', acc: '#e0559b' },
  { name: 'TRIBE SPACE', sub: 'Mask · body · sign',              n: 10, size: '5.2 MB', file: '/img/kodex/packs/kodex-tribe.zip',       acc: '#c98a3c' },
  { name: 'THE ARCHIVE', sub: 'The whole codex · 52 plates',     n: 52, size: '12 MB',  file: '/img/kodex/packs/kodex-archive.zip',     acc: '#00f0ff' },
];
---

<KodexShell title="KODEX −∞ · Store">
  <main class="ks" data-ks>
    <header class="ks-top">
      <a class="ks-home" href="/kodex/">◈ KODEX</a>
      <span class="ks-tag">STORE · EDITIONS</span>
      <a class="ks-back" href="/kodex/works/">← ARCHIVE</a>
    </header>

    <section class="ks-intro">
      <p class="ks-over" data-glitch>THE ARCHIVE, MADE MATTER</p>
      <h1 class="ks-title">Editions</h1>
      <p class="ks-lede">Free to download — always. Prints, wearables and on-chain editions are
        wiring up now. The work belongs to no one, and to all.</p>
    </section>

    <!-- channel status board — everything wired, each with an honest state -->
    <section class="ks-channels" aria-label="channels">
      {channels.map((c) => (
        <div class={`ks-chan${c.soon ? ' is-soon' : ''}`}>
          <span class="ks-chan__k">{c.k}</span>
          <span class="ks-chan__s">{c.soon ? '◷ ' : '◈ '}{c.s}</span>
          <span class="ks-chan__d">{c.d}</span>
          {c.href
            ? <a class="ks-chan__cta" href={c.href} target="_blank" rel="noopener">OPEN →</a>
            : c.soon
              ? <a class="ks-chan__cta ks-chan__cta--soon" href={mailReq('Notify me · ' + c.k)}>NOTIFY ME</a>
              : <a class="ks-chan__cta" href="#downloads">BROWSE ↓</a>}
        </div>
      ))}
    </section>

    <!-- PACKS · repos of graphic elements — real downloadable sets (free) -->
    <section class="ks-grid-wrap" id="packs">
      <div class="ks-sect">
        <span class="ks-sect__n">◈ PACKS · GRAPHIC ELEMENT REPOS · FREE</span>
        <p class="ks-sect__d">Curated sets of KODEX plates as high-resolution files — for print, remix, projection, motion, wearables. Free, always (liberation). <b>Support the laboratory</b> if it moves you.</p>
      </div>
      <div class="ks-packgrid">
        {packs.map((p) => (
          <article class="ks-pack" style={`--acc:${p.acc}`}>
            <div class="ks-pack__h"><span class="ks-pack__n">◈ {p.name}</span><span class="ks-pack__sz">{p.n} · {p.size}</span></div>
            <p class="ks-pack__s">{p.sub}</p>
            <div class="ks-pack__acts">
              <a class="ks-buy" href={p.file} download>⤓ DOWNLOAD PACK · FREE</a>
              <a class="ks-buy ks-buy--soon" href={mailReq('Support the laboratory · ' + p.name + ' pack')}>♡ SUPPORT</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- FREE downloads — real, works today -->
    <section class="ks-grid-wrap" id="downloads">
      <div class="ks-sect">
        <span class="ks-sect__n">◈ FREE DOWNLOADS · {products.length} PLATES</span>
        <p class="ks-sect__d">Each plate as a high-resolution file. Prints, stickers, tees and NFT
          editions of any plate are <b>coming soon</b> — request early access on any card.</p>
      </div>
      <div class="ks-grid">
        {products.map((p) => (
          <article class="ks-card" style={`--acc:${p.acc}`}>
            <span class="ks-card__frame"><img src={p.url} loading="lazy" alt={`KODEX−∞ — plate ${p.n}`} /></span>
            <div class="ks-card__body">
              <span class="ks-card__n">PLATE {p.n}</span>
              <span class="ks-card__ops">{p.ops.map((c) => opName(c)).join(' · ')}</span>
              <div class="ks-card__formats">
                <span class="ks-fmt is-on">DIGITAL</span>
                <span class="ks-fmt">PRINT</span><span class="ks-fmt">STICKER</span>
                <span class="ks-fmt">TEE</span><span class="ks-fmt">NFT</span>
              </div>
              <div class="ks-card__acts">
                <a class="ks-buy" href={p.url} download={`KODEX-plate-${p.n}.jpg`}>⤓ DOWNLOAD · FREE</a>
                <a class="ks-buy ks-buy--soon" href={mailReq('Early access · plate ' + p.n)}>◷ PRINT / NFT · SOON</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ks-note">
      <p>Licensing (personal / commercial), print fulfilment and on-chain minting are being wired.
        Want a plate as a print, a run of stickers, a tee, or a signed NFT before they go live?
        <a href={mailReq('Edition request')}>Write to the laboratory →</a></p>
    </section>

    <footer class="ks-foot"><p>KODEX −∞ · a possibility given form · belongs to no one, and to all.</p></footer>
  </main>

  <style>
    .ks{ --acc:#c9a84c; position:relative; min-height:100vh; background:#000; color:#f0ede8;
      font-family:'JetBrains Mono',ui-monospace,monospace; overflow-x:hidden; }
    .ks :where(a){ color:inherit; text-decoration:none; }

    .ks-top{ position:sticky; top:0; z-index:5; display:flex; align-items:center; justify-content:space-between;
      padding:16px clamp(14px,4vw,40px); font-size:11px; letter-spacing:.16em;
      background:linear-gradient(#000 60%,transparent); }
    .ks-home{ font-family:'Instrument Serif',serif; font-size:18px; }
    .ks-tag{ color:#8f8f8f; }
    .ks-back{ color:#9a948a; transition:color .3s; } .ks-back:hover{ color:#f0ede8; }

    .ks-intro{ text-align:center; padding:clamp(40px,10vh,110px) 20px clamp(20px,4vh,44px); }
    .ks-over{ font-size:11px; letter-spacing:.3em; color:#00f0ff; margin:0; text-shadow:0 0 10px rgba(0,240,255,.4); }
    .ks-title{ font-family:'Instrument Serif',serif; font-weight:400; font-size:clamp(3rem,9vw,6rem); margin:12px 0 0; }
    .ks-lede{ max-width:52ch; margin:18px auto 0; font-family:'Cormorant Garamond',serif;
      font-size:clamp(1.05rem,2.2vw,1.4rem); line-height:1.5; color:#c8c2b6; }

    .ks-channels{ display:grid; grid-template-columns:repeat(auto-fit,minmax(clamp(220px,30vw,320px),1fr));
      gap:1px; max-width:1200px; margin:clamp(20px,4vh,44px) auto 0; padding:0 clamp(14px,4vw,40px);
      background:#141414; border:1px solid #141414; }
    .ks-chan{ background:#050506; padding:18px; display:flex; flex-direction:column; gap:8px; }
    .ks-chan__k{ font-size:11px; letter-spacing:.16em; color:#f0ede8; }
    .ks-chan__s{ font-size:9.5px; letter-spacing:.14em; color:#a6ff00; }
    .ks-chan.is-soon .ks-chan__s{ color:#6a6a6a; }
    .ks-chan__d{ font-size:10.5px; line-height:1.6; color:#8f8f8f; flex:1; }
    .ks-chan__cta{ align-self:flex-start; font-size:9.5px; letter-spacing:.18em; color:#00f0ff;
      border:1px solid #1c2b2e; padding:7px 12px; transition:.25s; }
    .ks-chan__cta:hover{ border-color:#00f0ff; box-shadow:0 0 16px rgba(0,240,255,.2); }
    .ks-chan__cta--soon{ color:#9a948a; border-color:#241d10; }
    .ks-chan__cta--soon:hover{ border-color:#c9a84c; color:#c9a84c; box-shadow:none; }

    .ks-grid-wrap{ max-width:1300px; margin:0 auto; padding:clamp(40px,8vh,90px) clamp(14px,4vw,44px) 0; scroll-margin-top:80px; }
    #packs{ max-width:1000px; }
    .ks-packgrid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(clamp(200px,42vw,300px),1fr)); gap:clamp(12px,2vw,20px); }
    .ks-pack{ border:1px solid #141414; background:rgba(4,4,6,.6); padding:16px; display:flex; flex-direction:column; gap:9px; transition:border-color .4s, box-shadow .4s, transform .4s; }
    .ks-pack:hover{ border-color:var(--acc); transform:translateY(-3px); box-shadow:0 12px 34px rgba(0,0,0,.5), 0 0 30px color-mix(in srgb,var(--acc) 16%, transparent); }
    .ks-pack__h{ display:flex; align-items:baseline; justify-content:space-between; gap:10px; }
    .ks-pack__n{ font-size:12px; letter-spacing:.14em; color:var(--acc); }
    .ks-pack__sz{ font-size:8.5px; letter-spacing:.1em; color:#6a6a6a; white-space:nowrap; }
    .ks-pack__s{ font-size:10.5px; line-height:1.5; color:#8f8f8f; margin:0; flex:1; }
    .ks-pack__acts{ display:flex; gap:6px; }
    .ks-pack__acts .ks-buy{ flex:1; }
    .ks-sect{ text-align:center; max-width:58ch; margin:0 auto clamp(24px,4vh,44px); }
    .ks-sect__n{ font-size:11px; letter-spacing:.24em; color:#c9a84c; }
    .ks-sect__d{ font-size:12.5px; line-height:1.7; color:#8f8f8f; margin:12px 0 0; }
    .ks-sect__d b{ color:#c8c2b6; font-weight:400; }

    .ks-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(clamp(180px,26vw,260px),1fr));
      gap:clamp(14px,2vw,26px); }
    .ks-card{ display:flex; flex-direction:column; border:1px solid #141414; background:rgba(4,4,6,.6);
      transition:border-color .4s, transform .4s, box-shadow .4s; }
    .ks-card:hover{ border-color:var(--acc); transform:translateY(-3px);
      box-shadow:0 14px 40px rgba(0,0,0,.6), 0 0 30px color-mix(in srgb, var(--acc) 16%, transparent); }
    .ks-card__frame{ aspect-ratio:1/1; display:grid; place-items:center; overflow:hidden; background:#050505; }
    .ks-card__frame img{ max-width:94%; max-height:94%; width:auto; height:auto; object-fit:contain; opacity:.92; transition:opacity .4s, transform .5s; }
    .ks-card:hover .ks-card__frame img{ opacity:1; transform:scale(1.03); }
    .ks-card__body{ padding:12px 13px 14px; display:flex; flex-direction:column; gap:7px; }
    .ks-card__n{ font-family:'Instrument Serif',serif; font-size:1.15rem; color:#f0ede8; }
    .ks-card__ops{ font-size:9px; letter-spacing:.08em; color:#6a6a6a; min-height:1.2em; }
    .ks-card__formats{ display:flex; flex-wrap:wrap; gap:5px; margin:2px 0 4px; }
    .ks-fmt{ font-size:8px; letter-spacing:.12em; color:#5a5a5a; border:1px solid #1c1c1c; padding:3px 6px; }
    .ks-fmt.is-on{ color:#0a0a0a; background:var(--acc); border-color:var(--acc); }
    .ks-card__acts{ display:flex; flex-direction:column; gap:6px; margin-top:2px; }
    .ks-buy{ text-align:center; font-size:9.5px; letter-spacing:.14em; padding:9px 8px; border:1px solid var(--acc); color:var(--acc); transition:.25s; }
    .ks-buy:hover{ background:var(--acc); color:#0a0a0a; }
    .ks-buy--soon{ border-color:#241d10; color:#8f8f8f; }
    .ks-buy--soon:hover{ background:none; border-color:#c9a84c; color:#c9a84c; }

    .ks-note{ max-width:60ch; margin:clamp(40px,7vh,80px) auto 0; padding:0 clamp(18px,5vw,40px); text-align:center; }
    .ks-note p{ font-family:'Cormorant Garamond',serif; font-size:clamp(1.05rem,2.2vw,1.35rem); line-height:1.6; color:#c8c2b6; margin:0; }
    .ks-note a{ color:#00f0ff; text-shadow:0 0 8px rgba(0,240,255,.35); }

    .ks-foot{ text-align:center; padding:clamp(60px,12vh,130px) 20px clamp(70px,14vh,150px); font-size:9.5px; letter-spacing:.14em; color:#3a3a3a; }

    @media (max-width:640px){ .ks-channels{ grid-template-columns:1fr; } }
  </style>

  <script>
    const GLY = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789∞ΩΔ·';
    const el = document.querySelector('[data-glitch]');
    if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const t = el.textContent;
      const scr = () => { const t0 = performance.now(); clearInterval(el.__g); el.__g = setInterval(() => { const p = Math.min(1, (performance.now() - t0) / 800); let o = ''; for (let i = 0; i < t.length; i++) o += t[i] === ' ' ? ' ' : (i / t.length < p ? t[i] : GLY[Math.random() * GLY.length | 0]); el.textContent = o; if (p >= 1) clearInterval(el.__g); }, 40); };
      setTimeout(scr, 250); setInterval(() => { if (Math.random() < 0.5) scr(); }, 7000);
    }
  </script>
</KodexShell>
