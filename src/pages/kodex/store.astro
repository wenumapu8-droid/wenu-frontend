---
// KODEX −∞ · STORE — the archive made matter. Digital-product language
// (Fox Rockett / aescripts) in KODEX skin. Everything is WIRED with explicit
// states: FREE downloads work now; prints / stickers / tees (POD), NFT and
// donations show COMING SOON until Ocin connects the accounts (Printful/Gelato,
// Foundation/Rarible, checkout). Isolated via KodexShell — zero commerce chrome
// from the main store, zero Kai/UFO.
import KodexShell from '../../layouts/KodexShell.astro';
import { families, discoWorks, opName } from '../../lib/kodex.js';
import { getKodexProducts } from '../../lib/woo.ts';

// KODEX commerce lane: WC products in category slug 'kodex'.
// Filter is applied — these never leak into /shop of the jewelry store.
const kodexProducts = await getKodexProducts().catch(() => []);
const wcBySlug = Object.fromEntries(kodexProducts.map(p => [p.slug, p]));
const wcState = (slug: string) => {
  const p = wcBySlug[slug];
  if (!p) return { has: false, live: false, price: null, download: null };
  const live = p.status === 'publish';
  const download = p.downloads?.[0]?.file || null;
  const price = parseFloat(p.price || '') > 0 ? p.price : null;
  return { has: true, live, price, download, id: p.id, name: p.name };
};

const MAIL = 'marimari@wenumapuonline.com';
// WC checkout URL — direct add-to-cart + go to checkout in one hop.
const WC_STORE = 'https://www.wenumapuonline.com';
const buyUrl = (id: number) => `${WC_STORE}/?add-to-cart=${id}`;
const products = [
  ...families.map((f) => ({ n: f.n, url: `/img/kodex/${f.dir}/${f.rep}.jpg`, ops: f.ops, acc: f.th.c })),
  ...discoWorks.map((f) => ({ n: f.n, url: `/img/kodex/${f.dir}/${f.rep}.jpg`, ops: f.ops, acc: f.th.c })),
];
const printDrops = [
  {
    sku: 'WM-KDX-PRT-32302-12',
    wcId: 3441,
    name: 'CARDINAL BLOOM 32302',
    size: '12 x 12 in',
    price: '$33',
    cost: '$8.89',
    status: 'LIVE · BUY DIRECT',
    img: '/img/kodex/printful/kodex-ocin-32302-cardinal-bloom-mockup.jpg',
    proof: '/img/kodex/printful/kodex-ocin-32302-cardinal-bloom-12x12-300dpi-bleed.jpg',
    acc: '#c9a84c',
  },
  {
    sku: 'WM-KDX-PRT-30110-12',
    wcId: 3443,
    name: 'MANDALA AXIS 30110',
    size: '12 x 12 in',
    price: '$33',
    cost: '$8.89',
    status: 'LIVE · BUY DIRECT',
    img: '/img/kodex/printful/kodex-ocin-30110-mandala-axis-mockup.jpg',
    proof: '/img/kodex/printful/kodex-ocin-30110-mandala-axis-12x12-300dpi-bleed.jpg',
    acc: '#f0ede8',
  },
  {
    sku: 'WM-KDX-PRT-30211-10',
    wcId: 3445,
    name: 'SQUARE FIELD 30211',
    size: '10 x 10 in',
    price: '$29',
    cost: '$7.89',
    status: 'LIVE · BUY DIRECT',
    img: '/img/kodex/printful/kodex-ocin-30211-square-field-mockup.jpg',
    proof: '/img/kodex/printful/kodex-ocin-30211-square-field-10x10-300dpi-bleed.jpg',
    acc: '#00f0ff',
  },
];
// channel wiring — flip `soon:false` + add `href` as each account comes online
const channels = [
  { k: 'FREE DOWNLOAD', s: 'AVAILABLE', soon: false, d: 'Every plate, free. Liberation of the archive — take it, print it, remix it.' },
  { k: 'PRINTS · POSTERS', s: 'DRAFTED', soon: false, href: '#print-drops', d: 'Three print proofs are imported, costed and drafted in Woo as hidden KODEX products.' },
  { k: 'STICKERS · TEES', s: 'COMING SOON', soon: true, d: 'Wearable sigils and cut stickers via print-on-demand.' },
  { k: 'NFT · COLLECTIBLE', s: 'LIVE', soon: false, href: 'https://manifold.xyz/@kodex/id/4038234352', d: 'Cardinal Wenelfe Bloom 32302 — open edition on Ethereum via Manifold. Contract 0xF35A…EDD1.' },
  { k: 'SUPPORT · DONATE', s: 'COMING SOON', soon: true, d: 'Fuel the laboratory. Keep the archive free and originating.' },
  { k: 'PINTEREST', s: 'FOLLOW', soon: false, href: 'https://www.pinterest.com/wenu_mapu/', d: 'Follow the signal — new plates and readings as they surface.' },
];
const mailReq = (subj) => `mailto:${MAIL}?subject=${encodeURIComponent('KODEX −∞ · ' + subj)}`;
// downloadable repos — curated sets of plates as high-res files (free · liberation)
const packs = [
  { slug: 'kodex-pack-achroma',     name: 'ACHROMA',     sub: 'The true forms · black & white',  n: 12, size: '4.1 MB', file: '/img/kodex/packs/kodex-achroma.zip',     explore: '/kodex/movement/achroma/', acc: '#cfc7b6' },
  { slug: 'kodex-pack-disco-solar', name: 'DISCO SOLAR', sub: 'Signal in colour · neon fractal', n: 11, size: '6.1 MB', file: '/img/kodex/packs/kodex-disco-solar.zip', explore: '/kodex/movement/disco/',   acc: '#e0559b' },
  { slug: 'kodex-pack-tribe-space', name: 'TRIBE SPACE', sub: 'Mask · body · sign',              n: 10, size: '5.2 MB', file: '/img/kodex/packs/kodex-tribe.zip',       explore: '/kodex/movement/tribe/',   acc: '#c98a3c' },
  { slug: 'kodex-pack-archive',     name: 'THE ARCHIVE', sub: 'The whole codex · 52 plates',     n: 52, size: '12 MB',  file: '/img/kodex/packs/kodex-archive.zip',     explore: '/kodex/works/',           acc: '#00f0ff' },
].map(p => ({ ...p, wc: wcState(p.slug) }));
---

<KodexShell title="KODEX −∞ · Store">
  <main class="ks" data-ks>
    <header class="ks-top">
      <a class="ks-home" href="/kodex/">◈ KODEX</a>
      <span class="ks-tag">STORE · EDITIONS</span>
      <a class="ks-back" href="/kodex/works/">← ARCHIVE</a>
    </header>

    <section class="ks-intro">
      <div class="ks-sun" aria-hidden="true">
        <span class="ks-sun__core"></span>
        <span class="ks-sun__ring"></span>
        <span class="ks-sun__glyphs">KODEX KODEX KODEX KODEX KODEX KODEX</span>
      </div>
      <div class="ks-hero">
        <div class="ks-hero__copy">
          <p class="ks-over" data-glitch>KODEX OS · COMMERCE PIPELINE</p>
          <h1 class="ks-title">Editions</h1>
          <p class="ks-lede">A living archive moving through free access, physical print, and signed collectible states. Nothing here is stock. Every surface starts from Ocin's real source work.</p>
          <div class="ks-hero__acts">
            <a class="ks-prime" href="#print-drops">VIEW PRINT DROPS</a>
            <a class="ks-prime ks-prime--ghost" href="#downloads">FREE ARCHIVE</a>
          </div>
        </div>
        <div class="ks-hero__stage" aria-hidden="true">
          <img src="/img/kodex/printful/kodex-ocin-32302-cardinal-bloom-mockup.jpg" alt="" />
          <span class="ks-hero__scan"></span>
          <span class="ks-hero__read ks-hero__read--a">PRINTFUL_FILES: OK</span>
          <span class="ks-hero__read ks-hero__read--b">WOO_DRAFTS: 3441 / 3443 / 3445</span>
          <span class="ks-hero__read ks-hero__read--c">MINT_STATUS: HUMAN_SIGNATURE_REQUIRED</span>
        </div>
        <aside class="ks-hud" aria-label="KODEX commerce telemetry">
          <span><b>ARCHIVE</b>{products.length} PLATES</span>
          <span><b>PRINTS</b>{printDrops.length} DRAFTS</span>
          <span><b>NFT</b>3 ASSETS</span>
          <span><b>PINS</b>15 QUEUED</span>
          <span><b>SIGN</b>HUMAN REQUIRED</span>
        </aside>
      </div>
      <nav class="ks-command" aria-label="KODEX store modules">
        <a href="#print-drops">ESTADO</a>
        <a href="#print-drops">PRINTS</a>
        <a href="#nft-draft">NFT</a>
        <a href="#packs">PACKS</a>
        <a href="#downloads">ARCHIVE</a>
        <a href={mailReq('Edition request')}>SIGNAL</a>
      </nav>
      <div class="ks-state" aria-label="commerce cycle">
        <span>ESTADO · COMMERCE CYCLE</span>
        <b>E00 FREE ACCESS</b>
        <b>T01 PRINT TRANSMISSION</b>
        <b>M11 MANIFOLD SIGNATURE</b>
        <p>Cycle active: source work → print proof → hidden draft → human signature → public edition.</p>
      </div>
    </section>

    <!-- channel status board — everything wired, each with an honest state -->
    <section class="ks-channels" aria-label="channels">
      {channels.map((c) => (
        <div class={`ks-chan${c.soon ? ' is-soon' : ''}`}>
          <span class="ks-chan__k">{c.k}</span>
          <span class="ks-chan__s">{c.soon ? '◷ ' : '◈ '}{c.s}</span>
          <span class="ks-chan__d">{c.d}</span>
          {c.href
            ? <a class="ks-chan__cta" href={c.href} target="_blank" rel="noopener">OPEN →</a>
            : c.soon
              ? <a class="ks-chan__cta ks-chan__cta--soon" href={mailReq('Notify me · ' + c.k)}>NOTIFY ME</a>
              : <a class="ks-chan__cta" href="#downloads">BROWSE ↓</a>}
        </div>
      ))}
    </section>

    <section class="ks-grid-wrap" id="print-drops">
      <div class="ks-sect">
        <span class="ks-sect__n">◈ PRINT DROPS · LIVE · BUY DIRECT</span>
        <p class="ks-sect__d">First physical KODEX proofs: enhanced matte posters printed and fulfilled by Printful. Direct-link purchase — outside the main jewelry catalog by design.</p>
      </div>
      <div class="ks-printgrid">
        {printDrops.map((p) => (
          <article class="ks-print" style={`--acc:${p.acc}`}>
            <a class="ks-print__img" href={p.proof} target="_blank" rel="noopener">
              <img src={p.img} loading="lazy" alt={`${p.name} print mockup`} />
              <span>OPEN PRINT FILE</span>
            </a>
            <div class="ks-print__body">
              <span class="ks-print__sku">{p.sku}</span>
              <h2>{p.name}</h2>
              <p>{p.size} enhanced matte poster · {p.price}.</p>
              <dl class="kdx-dossier" aria-label="ident card">
                <div><dt>YEAR</dt><dd>2026</dd></div>
                <div><dt>TECHNIQUE</dt><dd>enhanced matte · 300 DPI archival ink</dd></div>
                <div><dt>EDITION</dt><dd>open · print-on-demand</dd></div>
                <div><dt>SOURCE</dt><dd>Ocin · Wenu Mapu · <code>book/0cin</code> ({p.sku.split('-')[3]})</dd></div>
                <div><dt>PROVENANCE</dt><dd>Conceived and art-directed by Ocin / Wenu Mapu</dd></div>
                <div><dt>CERTIFICATE</dt><dd>SKU {p.sku} · authentication mark on packaging</dd></div>
              </dl>
              <div class="ks-pack__acts">
                <a class="ks-buy" href={buyUrl(p.wcId)}>⤓ BUY POSTER · {p.price}</a>
              </div>
              <span class="ks-print__state">{p.status}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ks-nft" id="nft-draft">
      <div>
        <span class="ks-sect__n">◈ NFT · COLLECTIBLE · LIVE ON ETHEREUM</span>
        <h2>KODEX −∞ / Cardinal Wenelfe Bloom 32302</h2>
        <p>First-plate on-chain edition. ERC-1155 contract <code>0xF35A…EDD1</code> via Manifold Studio. Media stored permanently on Arweave. Open edition — mint direct with any Ethereum wallet.</p>
        <p style="margin-top:14px;"><a class="ks-buy" href="https://manifold.xyz/@kodex/id/4038234352" target="_blank" rel="noopener">◈ MINT ON MANIFOLD →</a></p>
      </div>
      <div class="ks-nft__rail" aria-label="NFT collection preview">
        <a href="https://manifold.xyz/@kodex/id/4038234352" target="_blank" rel="noopener"><img src="/img/kodex/printful/kodex-ocin-32302-cardinal-bloom-web-preview.webp" loading="lazy" alt="Cardinal Wenelfe Bloom · minted edition" /></a>
        <img src="/img/kodex/printful/kodex-ocin-30110-mandala-axis-web-preview.webp" loading="lazy" alt="Mandala Axis (next edition — coming)" />
        <img src="/img/kodex/printful/kodex-ocin-30211-square-field-web-preview.webp" loading="lazy" alt="Square Field (next edition — coming)" />
      </div>
    </section>

    <!-- PACKS · repos of graphic elements — real downloadable sets (free) -->
    <section class="ks-grid-wrap" id="packs">
      <div class="ks-sect">
        <span class="ks-sect__n">◈ PACKS · GRAPHIC ELEMENT REPOS · FREE</span>
        <p class="ks-sect__d">Curated sets of KODEX plates as high-resolution files — for print, remix, projection, motion, wearables. Free, always (liberation). <b>Support the laboratory</b> if it moves you.</p>
      </div>
      <div class="ks-packgrid">
        {packs.map((p) => (
          <article class="ks-pack" style={`--acc:${p.acc}`}>
            <div class="ks-pack__h">
              <span class="ks-pack__n">◈ {p.name}</span>
              <span class="ks-pack__sz">
                {p.n} · {p.size}
              </span>
            </div>
            <p class="ks-pack__s">{p.sub}</p>
            <div class="ks-pack__acts">
              <a class="ks-buy" href={p.file} download>⤓ DOWNLOAD PACK · FREE</a>
              <a class="ks-buy ks-buy--soon" href={p.explore}>⧉ ENTER THE COLLECTION</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- FREE downloads — real, works today -->
    <section class="ks-grid-wrap" id="downloads">
      <div class="ks-sect">
        <span class="ks-sect__n">◈ FREE DOWNLOADS · {products.length} PLATES</span>
        <p class="ks-sect__d">Each plate as a high-resolution file. Prints, stickers, tees and NFT
          editions of any plate are <b>coming soon</b> — request early access on any card.</p>
      </div>
      <div class="ks-grid">
        {products.map((p) => (
          <article class="ks-card" style={`--acc:${p.acc}`}>
            <span class="ks-card__frame"><img src={p.url} loading="lazy" alt={`KODEX−∞ — plate ${p.n}`} /></span>
            <div class="ks-card__body">
              <span class="ks-card__n">PLATE {p.n}</span>
              <span class="ks-card__ops">{p.ops.map((c) => opName(c)).join(' · ')}</span>
              <div class="ks-card__formats">
                <span class="ks-fmt is-on">DIGITAL</span>
                <span class="ks-fmt">PRINT</span><span class="ks-fmt">STICKER</span>
                <span class="ks-fmt">TEE</span><span class="ks-fmt">NFT</span>
              </div>
              <div class="ks-card__acts">
                <a class="ks-buy" href={p.url} download={`KODEX-plate-${p.n}.jpg`}>⤓ DOWNLOAD · FREE</a>
                <a class="ks-buy ks-buy--soon" href={mailReq('Early access · plate ' + p.n)}>◷ PRINT / NFT · SOON</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ks-note">
      <p>Licensing (personal / commercial), print fulfilment and on-chain minting are being wired.
        Want a plate as a print, a run of stickers, a tee, or a signed NFT before they go live?
        <a href={mailReq('Edition request')}>Write to the laboratory →</a></p>
    </section>

    <footer class="ks-foot"><p>KODEX −∞ · a possibility given form · belongs to no one, and to all.</p></footer>
  </main>

  <style>
    .ks{ --acc:#c9a84c; position:relative; min-height:100vh; background:#000; color:#f0ede8;
      font-family:'JetBrains Mono',ui-monospace,monospace; overflow-x:hidden; }
    .ks :where(a){ color:inherit; text-decoration:none; }
    .ks::before{ content:''; position:fixed; inset:-18vw; z-index:0; pointer-events:none;
      background:
        radial-gradient(circle at 58% 28%, #000 0 7.8vw, rgba(255,211,91,.94) 8.1vw 8.6vw, rgba(201,168,76,.46) 8.9vw 14.2vw, transparent 23vw),
        radial-gradient(ellipse at 58% 28%, rgba(255,194,74,.2), transparent 39vw),
        radial-gradient(ellipse at 50% 0%, rgba(104,64,38,.28), transparent 54vw),
        linear-gradient(115deg, transparent 0 46%, rgba(255,255,255,.045) 46.2% 46.35%, transparent 46.6%),
        linear-gradient(245deg, transparent 0 53%, rgba(0,240,255,.06) 53.1% 53.22%, transparent 53.5%);
      opacity:.72; mix-blend-mode:screen; }
    .ks::after{ content:''; position:fixed; inset:0; z-index:0; pointer-events:none; opacity:.35;
      background:
        repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 4px),
        radial-gradient(120% 80% at 50% 35%, transparent 54%, rgba(0,0,0,.74) 100%); }
    .ks > *{ position:relative; z-index:1; }

    .ks-top{ position:sticky; top:0; z-index:5; display:flex; align-items:center; justify-content:space-between;
      padding:16px clamp(14px,4vw,40px); font-size:11px; letter-spacing:.16em;
      background:linear-gradient(#000 60%,transparent); border-top:1px solid rgba(201,168,76,.34); box-shadow:0 0 38px rgba(201,168,76,.18); }
    .ks-home{ font-family:'Instrument Serif',serif; font-size:18px; }
    .ks-tag{ color:#8f8f8f; }
    /* Aire para el disparador del menu de KodexShell, que es `position:fixed` en
       `right:clamp(14px,4vw,40px)` y mide 34x26: ocupa siempre el mismo lugar
       del angulo superior derecho, en toda pagina que use el layout. Sin
       reservarlo, esto le queda debajo. Se expresa en funcion del boton y no
       con un numero suelto, para que siga valiendo si el boton se mueve. */
    .ks-back{ color:#9a948a; transition:color .3s; margin-right:calc(34px + 18px); } .ks-back:hover{ color:#f0ede8; }

    .ks-intro{ position:relative; text-align:center; min-height:min(940px,100vh);
      padding:clamp(42px,8vh,96px) 20px clamp(20px,4vh,44px); overflow:hidden;
      background:
        linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.18) 42%,rgba(0,0,0,.9) 88%),
        radial-gradient(80% 62% at 50% 32%,transparent 0 42%,rgba(0,0,0,.74) 86%),
        url('/img/kodex/ui/kodex-black-sun-os.png') center top / min(1420px,112vw) auto no-repeat; }
    .ks-intro::after{ content:''; position:absolute; inset:0; pointer-events:none;
      background:linear-gradient(90deg,rgba(0,0,0,.76),transparent 28%,transparent 72%,rgba(0,0,0,.82)),
        repeating-linear-gradient(0deg,rgba(255,255,255,.028) 0 1px,transparent 1px 4px);
      opacity:.8; }
    .ks-intro > *{ position:relative; z-index:1; }
    .ks-sun{ position:absolute; left:50%; top:42%; width:min(94vw,1120px); aspect-ratio:16/9; transform:translate(-50%,-50%);
      pointer-events:none; opacity:.16; mix-blend-mode:screen; }
    .ks-sun__core{ position:absolute; left:50%; top:48%; width:min(34vw,350px); aspect-ratio:1/1; transform:translate(-50%,-50%); border-radius:50%;
      background:#000; box-shadow:0 0 0 8px rgba(255,214,85,.88),0 0 34px 16px rgba(255,190,56,.72),0 0 92px 48px rgba(201,113,45,.28); }
    .ks-sun__ring{ position:absolute; inset:8% 4%; border:1px solid rgba(255,255,255,.08); border-radius:50%;
      box-shadow:inset 0 0 80px rgba(255,255,255,.045),0 0 70px rgba(201,168,76,.12); }
    .ks-sun__glyphs{ position:absolute; left:4%; right:4%; top:18%; font-family:'Instrument Serif',serif; font-size:clamp(4rem,10vw,9rem);
      letter-spacing:.04em; color:rgba(240,237,232,.1); filter:blur(2px); transform:perspective(500px) rotateX(26deg); }
    .ks-hero{ position:relative; width:min(1240px,100%); margin:0 auto; display:grid; grid-template-columns:minmax(0,1fr) minmax(280px,520px) minmax(150px,190px);
      align-items:center; gap:clamp(24px,5vw,70px); text-align:left; }
    .ks-hero::before{ content:''; position:absolute; left:50%; top:42%; width:min(78vw,760px); aspect-ratio:1/1; transform:translate(-50%,-50%);
      border:1px solid rgba(201,168,76,.11); border-radius:50%; pointer-events:none;
      box-shadow:0 0 0 1px rgba(255,255,255,.025), inset 0 0 80px rgba(201,168,76,.035); }
    .ks-hero__copy{ justify-self:center; max-width:560px; padding:18px 0; text-shadow:0 2px 18px rgba(0,0,0,.85); }
    .ks-over{ font-size:11px; letter-spacing:.3em; color:#00f0ff; margin:0; text-shadow:0 0 10px rgba(0,240,255,.4); }
    .ks-title{ font-family:'Instrument Serif',serif; font-weight:400; font-size:clamp(3.6rem,10vw,8rem); line-height:.86; margin:14px 0 0; }
    .ks-lede{ max-width:52ch; margin:18px 0 0; font-family:'Cormorant Garamond',serif;
      font-size:clamp(1.05rem,2.2vw,1.4rem); line-height:1.5; color:#c8c2b6; }
    .ks-hero__acts{ display:flex; flex-wrap:wrap; gap:10px; margin-top:24px; }
    .ks-prime{ display:inline-flex; min-height:42px; align-items:center; justify-content:center; padding:0 16px;
      border:1px solid #00f0ff; color:#00f0ff; font-size:10px; letter-spacing:.18em; transition:.25s; }
    .ks-prime:hover{ background:#00f0ff; color:#020304; box-shadow:0 0 22px rgba(0,240,255,.25); }
    .ks-prime--ghost{ border-color:#2a2520; color:#c9a84c; }
    .ks-prime--ghost:hover{ background:#c9a84c; color:#050506; box-shadow:0 0 22px rgba(201,168,76,.18); }
    .ks-hero__stage{ position:relative; aspect-ratio:4/5; border:1px solid #3c2a15; background:#050506; overflow:hidden;
      box-shadow:0 24px 80px rgba(0,0,0,.74), 0 0 70px rgba(201,168,76,.24), inset 0 0 0 1px rgba(255,255,255,.03); }
    .ks-hero__stage::after{ content:''; position:absolute; inset:10px; z-index:2; pointer-events:none; border:1px solid rgba(201,168,76,.12);
      box-shadow:inset 0 0 28px rgba(0,0,0,.6); }
    .ks-hero__stage::before{ content:''; position:absolute; inset:0; z-index:1; pointer-events:none;
      background:linear-gradient(180deg,rgba(0,0,0,.05),rgba(0,0,0,.78)), repeating-linear-gradient(0deg,rgba(255,255,255,.035) 0 1px,transparent 1px 4px); }
    .ks-hero__stage img{ width:100%; height:100%; object-fit:cover; filter:contrast(1.08) saturate(.9); opacity:.9; }
    .ks-hero__scan{ position:absolute; left:0; right:0; top:0; z-index:2; height:2px; background:linear-gradient(90deg,transparent,#00f0ff,transparent);
      animation:ks-scan 4.8s ease-in-out infinite; opacity:.75; }
    @keyframes ks-scan{ 0%,18%{ transform:translateY(-8px); opacity:0; } 45%{ opacity:.8; } 70%,100%{ transform:translateY(620px); opacity:0; } }
    .ks-hero__read{ position:absolute; z-index:3; left:16px; right:16px; font-size:9px; letter-spacing:.13em; color:#c8c2b6;
