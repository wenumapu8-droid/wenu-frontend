---
// KODEX −∞ · ARCHIVE — 118 real volumes from the manifest.
import KodexShell from '../../layouts/KodexShell.astro';
import '../../styles/kodex-tacto.css';
import '../../styles/kodex-instrumento.css';
import { leerManifiesto, resolver, assetUrl } from '../../lib/kodex/volumenes';
import { existsSync, readdirSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const manifest = await leerManifiesto();
const volumes = resolver(manifest);

const coverFor = (v) => {
  if (v.slug === 'book-ocin-arte-digital-ritual') return '/kodex-content/books/ocin-cover-800.webp';
  const src = v.hero?.src;
  if (!src || src.endsWith('.json')) return '';
  return assetUrl(src, 'thumb');
};
const actionKey = (v) => (v.hero?.src?.match(/^art\/([^/]+)\//)?.[1] ?? v.slug).replace(/[^a-z0-9-]/gi, '-').toLowerCase();

/* El boton DESCARGAR se ofrecia siempre, y para 250 de los 1.427 volumenes el
   fondo de pantalla no existe: son 250 enlaces a 404 publicados. La causa es
   que conviven dos esquemas de nombre —los generados se llaman
   `0050aebb-49347-desktop.webp` y estos piden
   `2f660098-20260725-1554105625864270327315830-desktop.webp`—, mas los casos
   en que la clave sale vacia y el enlace queda en `--desktop.webp`.
   No se inventa el archivo: se comprueba en tiempo de build contra el disco y,
   si no esta, no se ofrece la descarga. Un boton que no baja nada es peor que
   no tener boton. */
const wallpapersDir = fileURLToPath(new URL('../../../public/kodex-content/free/wallpapers', import.meta.url));
const wallpapers = existsSync(wallpapersDir) ? new Set(readdirSync(wallpapersDir)) : new Set();
const downloadFile = (v) => `${actionKey(v)}-desktop.webp`;
/* El href sale por R2 — free/ ya no viaja en el deploy (213 MB muertos); la
   comprobación contra disco QUEDA: el repo sigue siendo la fuente de verdad
   de qué wallpapers existen. La subida a R2 está verificada (200 image/webp). */
const downloadHref = (v) => (wallpapers.has(downloadFile(v)) ? `https://pub-2b4562c758ed440ab047fe9523a2d99c.r2.dev/kodex-content/free/wallpapers/${downloadFile(v)}` : null);
const collectHref = (v) => `/kodex/store/?signal=${encodeURIComponent(v.slug)}#editions`;
const verifyHref = (v) => `/kodex/verify/?code=KDX-${v.numero}-${encodeURIComponent(v.slug)}`;

const marcoLabel = (marco = 'estructura') => ({
  documentado: 'DOCUMENTED',
  ficcion: 'FICTION',
  esoterico: 'ESOTERIC',
  estructura: 'STRUCTURE',
  ciencia: 'SCIENCE',
})[marco] ?? marco.toUpperCase();

const tomoLabel = (v) => v.tomo || 'ARCHIVO';
const tipos = [...new Set(volumes.map((v) => v.tipo))].sort();
const marcos = [...new Set(volumes.map((v) => v.marco ?? 'estructura'))].sort();
const tomos = [...new Set(volumes.map(tomoLabel))].sort();
const estratos = [...new Set(volumes.map((v) => v.estrato || 'sin-estrato'))].sort();
const featured = volumes.find((v) => v.slug === 'book-ocin-arte-digital-ritual') ?? volumes.find((v) => v.tipo === 'libro') ?? volumes[0];
const worldArtwork = coverFor(featured);
const displayVolumes = [...volumes].sort((a, b) => {
  const ac = coverFor(a) ? 1 : 0;
  const bc = coverFor(b) ? 1 : 0;
  return bc - ac || Number(a.numero) - Number(b.numero);
});
---

<KodexShell title="KODEX −∞ · The Archive">
  {/* El archivo nunca había firmado la capa de instrumento -- no estaba entre
      las superficies que la llevan -- así que su telemetría competía a plena
      opacidad con la obra. Ahora sí. Ver src/styles/kodex-instrumento.css. */}
  <div data-kdx-shell="1.0.0" data-kdx-plate="kdx:archivo/total" style="display:contents">
  <main class="ar ar--volumes" data-ar>
    <canvas id="kodex-world" data-world data-world-art={worldArtwork}></canvas>

    <header class="ar-top">
      <a class="ar-home" href="/kodex/">KODEX-∞</a>
      <span class="ar-count">{volumes.length} REAL VOLUMES</span>
      <a class="ar-about" href="/kodex/folio/iii/">SCENE 03 →</a>
    </header>

    <section class="ar-intro">
      <p class="ar-over" data-glitch>KODEX OS · TOTAL ARCHIVE</p>
      <h1 class="ar-title">{volumes.length} Volumes</h1>
      <p class="ar-lede">
        The seven scenes are the corridor. This is the depth: specimens, lore, documented sources,
        treatments, books, habitats and living dossiers from the KODEX manifest.
      </p>

      <a class="ar-feature" href={`/kodex/vol/${featured.slug}/`} style={`--acc:${featured.color}`}>
        <span class="ar-feature__cover" style={coverFor(featured) ? `--feature-cover:url('${coverFor(featured)}')` : undefined}>
          {coverFor(featured)
            ? <img src={coverFor(featured)} alt={`${featured.titulo_es} cover`} loading="eager" fetchpriority="high" />
            : <span>{featured.glifos}</span>}
        </span>
        <span class="ar-feature__body">
          <b>DEEP CHAMBER</b>
          <strong>{featured.titulo_es}</strong>
          <em>{featured.curaduria_es ?? featured.titulo_en ?? 'Open the complete dossier.'}</em>
        </span>
      </a>

      <div class="ar-console" aria-label="archive status">
        <span><b>{volumes.length}</b> VOLUMES</span>
        <span><b>{volumes.filter((v) => v.tipo === 'lore').length}</b> LORE</span>
        <span><b>{volumes.filter((v) => v.tipo === 'specimen').length}</b> SPECIMENS</span>
        <span><b>{volumes.filter((v) => v.hero).length}</b> COVERS</span>
      </div>

      <div class="ar-filterbar" aria-label="archive filters">
        <label>
          <span>REGISTRY</span>
          <select data-filter-select="marco">
            <option value="all">ALL</option>
            {marcos.map((m) => <option value={m}>{marcoLabel(m)}</option>)}
          </select>
        </label>
        <label>
          <span>CATEGORY</span>
          <select data-filter-select="tipo">
            <option value="all">ALL</option>
            {tipos.map((t) => <option value={t}>{t.toUpperCase()}</option>)}
          </select>
        </label>
        <label>
          <span>TOME</span>
          <select data-filter-select="tomo">
            <option value="all">ALL</option>
            {tomos.map((t) => <option value={t}>{t.toUpperCase()}</option>)}
          </select>
        </label>
        <label>
          <span>STRATUM</span>
          <select data-filter-select="estrato">
            <option value="all">ALL</option>
            {estratos.map((e) => <option value={e}>{e.toUpperCase()}</option>)}
          </select>
        </label>
        <button type="button" data-reset-filters>RESET</button>
      </div>

      <nav class="ar-command" aria-label="archive commands">
        <a href="/kodex/libro/">OCIN BOOK</a>
        <a href="/kodex/folio/iii/">ARCHIVE SCENE</a>
        <a href="/kodex/folio/iv/">MACHINE</a>
        <a href="/kodex/store/">COLLECT</a>
        <a href="/kodex/">THRESHOLD</a>
      </nav>
    </section>

    <section class="ar-depth-head">
      <p><span data-visible-count>{volumes.length}</span> / {volumes.length} SURFACED</p>
      <h2>Manifest Index</h2>
    </section>

    <div class="ar-grid" id="manifest-grid" data-volume-grid>
      {displayVolumes.map((v) => {
        const cover = coverFor(v);
        return (
          <article
            class={`ar-cell ar-cell--${v.marco ?? 'estructura'} ar-cell--${v.tipo}`}
            style={`--acc:${v.color}`}
            data-marco={v.marco ?? 'estructura'}
            data-tipo={v.tipo}
            data-tomo={tomoLabel(v)}
            data-estrato={v.estrato || 'sin-estrato'}
          >
            <a class="ar-cell__main" href={`/kodex/vol/${v.slug}/`} aria-label={`Open ${v.titulo_es}`}>
              <span class="ar-cell__frame">
                {/* Diferida a proposito: son 1.334 portadas. Con `eager` el
                    navegador las pedia TODAS al abrir y el evento `load` no
                    llegaba ni a los 30 s -- medido. El indice existia y estaba
                    bien construido; lo que lo volvia inusable era este atributo. */}
                {cover ? <img src={cover} loading="lazy" decoding="async" alt={`${v.titulo_es} cover`} /> : <span class="ar-cell__glyphs">{v.glifos}</span>}
              </span>
            </a>
            <span class="ar-cell__idx">KDX/{v.numero}</span>
            <span class="ar-cell__tag">{marcoLabel(v.marco)} · {v.tipo.toUpperCase()}</span>
            <span class="ar-cell__n">{v.titulo_es}</span>
            <span class="ar-cell__fx">{tomoLabel(v)} · {v.estratoTitulo}</span>
            {v.resonancias && v.resonancias.length > 0 && (
              <span class="ar-cell__reson" data-reson title={v.resonancias.join(" ")}>
                {v.resonancias.slice(0, 3).join(" · ")}{v.resonancias.length > 3 ? ` +${v.resonancias.length - 3}` : ""}
              </span>
            )}
            <span class="ar-cell__actions">
              {downloadHref(v) && <a href={downloadHref(v)} download>DESCARGAR</a>}
              <a href={collectHref(v)}>COLECCIONAR</a>
              <a href={verifyHref(v)}>VERIFY</a>
            </span>
          </article>
        );
      })}
    </div>

    <footer class="ar-foot"><p>KODEX −∞ · every leaf is an archive.</p></footer>
  </main>

  <style>
    .ar{position:relative;min-height:100vh;background:#050505;color:#f0ede8;font-family:'IBM Plex Mono',ui-monospace,monospace;overflow-x:hidden;}
    .ar::before{content:'';position:fixed;inset:0;z-index:1;pointer-events:none;background:linear-gradient(rgba(230,230,230,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(230,230,230,.035) 1px,transparent 1px),radial-gradient(circle at 50% 18%,rgba(166,255,0,.16),transparent 34%);background-size:48px 48px,48px 48px,auto;opacity:.72;}
    .ar::after{content:'';position:fixed;inset:0;z-index:1;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(255,255,255,.035) 0 1px,transparent 1px 4px),radial-gradient(110% 82% at 50% 35%,transparent 48%,rgba(0,0,0,.82) 100%);opacity:.42;}
    #kodex-world{position:fixed;inset:0;width:100%;height:100%;display:block;z-index:0;opacity:.32;}
    .ar :where(a){color:inherit;text-decoration:none;}
    .ar > :not(#kodex-world){position:relative;z-index:2;}
    /* ── EL ARCHIVO EMPIEZA POR LA OBRA, NO POR LA EXPLICACIÓN ────────────────
     En 390px había que pasar por el número, un párrafo de cuatro renglones,
     una ficha destacada, cuatro contadores y dos desplegables ANTES de ver la
     primera obra: cinco pantallas de preámbulo. El canon lo prohíbe dos veces
     -- "artwork/organism visible en primer estado" y "nada se explica antes de
     poder sentirse".

     Nada se borra. El número y la explicación se comprimen: el título baja a
     tamaño de rótulo y la explicación pasa a un desplegable cerrado. Sigue
     estando y sigue siendo legible para lector de pantalla; deja de ser un
     peaje. En escritorio, donde hay espacio, queda como estaba. */
  @media (max-width:560px){
    /* LA OBRA PRIMERO, LITERALMENTE. No alcanza con comprimir el preámbulo:
       había que invertir el orden. La ficha destacada es una OBRA y sube al
       primer lugar; el número, la explicación y los contadores quedan debajo,
       que es donde el canon los quiere -- "art / organism → signal → motion →
       title → interaction → depth → system", nunca al revés.
       El orden del DOM no cambia: lo lee igual un lector de pantalla. */
    .ar-intro{gap:10px;padding-bottom:6px;}
    /* Se intentó primero con `order` sobre una caja flexible. No sirvió y
       medirlo lo dijo enseguida: los `order` quedaban aplicados -- la ficha en
       -1 -- y la ficha seguía en y=333, debajo del título en 176. La página no
       es una caja flexible: es una rejilla con ÁREAS NOMBRADAS, y las áreas
       ignoran `order`. El arreglo va donde de verdad se decide el orden, en la
       plantilla de áreas de más abajo. */
    .ar-title{font-size:clamp(1.5rem,7vw,2.1rem);line-height:1;margin:0;}
    .ar-lede{
      display:block;max-height:2.9em;overflow:hidden;
      font-size:.82rem;line-height:1.45;
      -webkit-mask-image:linear-gradient(#000 60%,transparent);
      mask-image:linear-gradient(#000 60%,transparent);
    }
    /* Los contadores son telemetría: la capa de instrumento ya los baja, acá
       además dejan de ocupar cuatro celdas y pasan a una línea. */
    .ar-console{display:flex;flex-wrap:wrap;gap:4px 14px;border:0;padding:0;}
    .ar-console > *{border:0!important;padding:0!important;font-size:10px;}
    /* La ficha destacada es una obra, así que se queda -- pero deja de medir
       una pantalla entera. */
    .ar-feature__body p{display:none;}
  }

  .ar-top{position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px clamp(14px,4vw,40px);font-size:11px;letter-spacing:.18em;background:rgba(5,5,5,.86);border-top:1px solid rgba(166,255,0,.34);border-bottom:1px solid rgba(230,230,230,.08);backdrop-filter:blur(12px);}
  /* En 390px la marca se partía en dos renglones y el segundo caía encima del
     contador: "KODEX-" arriba, "∞" abajo, y "531 REAL VOLUMES" atravesado.
     La marca no se parte nunca y el contador cede -- es telemetría, y la
     telemetría cede ante la marca, no al revés. */
  .ar-home{white-space:nowrap;flex:0 0 auto;}
  .ar-count{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center;}
  .ar-about{white-space:nowrap;flex:0 0 auto;}
  @media (max-width:560px){
    /* El contador es dato de sistema y en teléfono no compite con la entrada.
       Sigue en el DOM para quien lo lea con lector de pantalla. */
    .ar-count{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);}
    .ar-top{gap:10px;}
  }
    .ar-home{font-family:'Oxanium','Barlow Condensed',system-ui,sans-serif;font-size:20px;font-weight:800;}
    .ar-count{color:#A6FF00;}
    .ar-about{font-size:10px;color:#c9c9c9;border:1px solid rgba(166,255,0,.34);padding:8px 14px;}
    .ar-intro{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,420px);grid-template-areas:'over feature' 'title feature' 'lede feature' 'console feature' 'filters filters' 'commands commands';gap:18px clamp(24px,5vw,70px);min-height:min(860px,92vh);padding:clamp(60px,9vh,100px) clamp(18px,5vw,72px) clamp(30px,5vh,58px);box-sizing:border-box;align-content:center;}
    .ar-over{grid-area:over;margin:0;color:#A6FF00;font-size:11px;letter-spacing:.34em;}
    .ar-title{grid-area:title;margin:0;max-width:7.2ch;font-family:'Barlow Condensed','Inter Tight',system-ui,sans-serif;font-size:clamp(5rem,10vw,11rem);line-height:.78;text-transform:uppercase;letter-spacing:0;}
    .ar-lede{grid-area:lede;width:min(54ch,calc(100vw - 36px));max-width:100%;margin:0;font-family:'Inter Tight',system-ui,sans-serif;font-size:clamp(1rem,1.5vw,1.3rem);line-height:1.45;color:rgba(240,237,232,.72);}
    .ar-feature{grid-area:feature;align-self:center;display:grid;gap:14px;width:100%;box-sizing:border-box;padding:14px;border:1px solid color-mix(in srgb,var(--acc) 62%,transparent);background:rgba(8,8,8,.72);box-shadow:18px 18px 0 color-mix(in srgb,var(--acc) 10%,transparent);}
    /* `grid-template-rows` explícito, no por contenido: la caja mide 390 px de
       alto por `aspect-ratio`, pero la fila se dimensionaba por su contenido
       —la portada de 599x900 daba 583 px— y entonces el `height:100%` de la
       imagen resolvía contra 583 y no contra 390. La portada se pasaba 193 px,
       `overflow:hidden` la cortaba, y el título de abajo quedaba montado sobre
       el recorte. Medido en el navegador: contenedor 390x390, imagen 388x583. */
    .ar-feature__cover{aspect-ratio:1;display:grid;grid-template-rows:minmax(0,1fr);grid-template-columns:minmax(0,1fr);place-items:center;overflow:hidden;background:var(--feature-cover) center / cover no-repeat,#050505;border:1px solid rgba(230,230,230,.08);}
    .ar-feature__cover img{width:100%;height:100%;object-fit:cover;filter:contrast(1.04) saturate(.9);opacity:.98;}
    .ar-feature__cover span{font-size:3rem;letter-spacing:.25em;color:var(--acc);}
    .ar-feature__body{display:grid;gap:8px;}
    .ar-feature__body b{color:var(--acc);font-size:10px;letter-spacing:.28em;}
    .ar-feature__body strong{font-family:'Barlow Condensed','Inter Tight',system-ui,sans-serif;font-size:clamp(2rem,3.4vw,3.4rem);line-height:.88;text-transform:uppercase;}
    .ar-feature__body em{font-family:'Inter Tight',system-ui,sans-serif;font-size:.95rem;line-height:1.35;color:rgba(240,237,232,.58);font-style:normal;}
    .ar-console{grid-area:console;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;max-width:860px;background:rgba(166,255,0,.24);border:1px solid rgba(166,255,0,.24);}
    .ar-console span{background:rgba(5,5,6,.88);padding:12px 10px;font-size:9px;letter-spacing:.14em;color:#777;}
    .ar-console b{color:#A6FF00;font-weight:800;}
    .ar-filterbar{grid-area:filters;display:grid;grid-template-columns:repeat(4,minmax(0,1fr)) auto;gap:8px;margin-top:18px;}
    .ar-filterbar label{display:grid;gap:6px;}
    .ar-filterbar span{font-size:8px;letter-spacing:.22em;color:rgba(240,237,232,.42);}
    .ar-filterbar select,.ar-filterbar button{min-height:42px;background:#050506;border:1px solid rgba(166,255,0,.28);color:#e8e5df;padding:0 10px;font:10px/1 'IBM Plex Mono',monospace;letter-spacing:.12em;text-transform:uppercase;}
    .ar-filterbar button{align-self:end;color:#080808;background:#A6FF00;border-color:#A6FF00;cursor:pointer;font-weight:800;}
    .ar-command{grid-area:commands;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border:1px solid rgba(230,230,230,.1);background:rgba(0,0,0,.72);}
    .ar-command a{min-height:42px;display:grid;place-items:center;border-right:1px solid rgba(230,230,230,.1);font-size:9px;letter-spacing:.16em;color:rgba(240,237,232,.68);}
    .ar-command a:last-child{border-right:0;}
    .ar-command a:hover{background:#A6FF00;color:#050505;}
    .ar-depth-head{display:flex;align-items:end;justify-content:space-between;gap:20px;padding:0 clamp(18px,5vw,72px) 18px;}
    .ar-depth-head p{margin:0;color:#A6FF00;font-size:10px;letter-spacing:.24em;}
    .ar-depth-head h2{margin:0;font-family:'Barlow Condensed','Inter Tight',system-ui,sans-serif;font-size:clamp(2.2rem,5vw,5rem);line-height:.82;text-transform:uppercase;}
    .ar-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,clamp(170px,18vw,260px)),1fr));gap:clamp(12px,1.8vw,24px);padding:0 clamp(14px,4vw,54px) 90px;box-sizing:border-box;overflow-x:hidden;}
    .ar-cell{position:relative;display:grid;grid-template-rows:auto auto auto 1fr auto;gap:8px;min-height:330px;min-width:0;padding:12px;border:1px solid rgba(230,230,230,.12);background:rgba(4,4,6,.76);transition:border-color .3s,transform .3s,box-shadow .3s;}
    .ar-cell[hidden]{display:none;}
    .ar-cell:hover{border-color:var(--acc);transform:translateY(-3px);box-shadow:0 18px 50px rgba(0,0,0,.68),0 0 30px color-mix(in srgb,var(--acc) 14%,transparent);}
    .ar-cell__main{display:block;min-width:0;max-width:100%;}
    .ar-cell--ficcion{box-shadow:inset 0 0 0 1px rgba(255,106,0,.12);}
    .ar-cell--documentado{box-shadow:inset 0 0 0 1px rgba(0,239,255,.1);}
    .ar-cell__frame{position:relative;aspect-ratio:1;display:grid;place-items:center;min-width:0;max-width:100%;overflow:hidden;background:radial-gradient(circle at 50% 50%,color-mix(in srgb,var(--acc) 16%,transparent),transparent 58%),#050505;}
    .ar-cell__frame::after{content:'';position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(255,255,255,.035) 0 1px,transparent 1px 4px),radial-gradient(circle at 50% 50%,transparent 42%,rgba(0,0,0,.62));}
    .ar-cell__frame img{width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.14);opacity:.94;transition:transform .45s,filter .45s;}
    .ar-cell:hover .ar-cell__frame img{transform:scale(1.04);filter:grayscale(.65) contrast(1.2);}
    .ar-cell__glyphs{font-size:clamp(1.8rem,4vw,3.8rem);letter-spacing:.22em;color:var(--acc);opacity:.8;}
    .ar-cell__idx{position:absolute;top:20px;left:20px;z-index:3;background:rgba(0,0,0,.72);border:1px solid rgba(255,255,255,.08);padding:5px 7px;font-size:8px;letter-spacing:.13em;color:#e8e5df;}
    .ar-cell__tag{font-size:8px;letter-spacing:.2em;color:var(--acc);}
    .ar-cell__n{font-family:'Barlow Condensed','Inter Tight',system-ui,sans-serif;font-size:clamp(1.5rem,2.1vw,2.2rem);line-height:.9;color:#f0ede8;text-transform:uppercase;}
    .ar-cell__fx{align-self:end;font-size:8.5px;letter-spacing:.13em;color:rgba(240,237,232,.45);}
    .ar-cell__reson{align-self:end;font-size:7.5px;letter-spacing:.08em;color:var(--acc);opacity:.7;text-transform:lowercase;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%;}
    .ar-cell__actions{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin-top:2px;background:rgba(230,230,230,.12);}
    .ar-cell__actions a{min-height:28px;display:grid;place-items:center;background:#050506;color:rgba(240,237,232,.64);font-size:7px;letter-spacing:.13em;}
    .ar-cell__actions a:nth-child(2){color:var(--acc);}
    .ar-cell__actions a:last-child{grid-column:1/-1;}
    .ar-cell__actions a:hover{background:var(--acc);color:#050505;}
    .ar-foot{text-align:center;padding:40px 20px;font-size:9.5px;letter-spacing:.14em;color:#555;}
    @media (max-width:900px){
      /* LA OBRA PRIMERO. El orden anterior -- rótulo, número, párrafo y recién
         entonces la ficha -- obligaba a atravesar la explicación antes de ver
         nada. El canon lo prohíbe dos veces: "artwork/organism visible en
         primer estado" y "nada se explica antes de poder sentirse".
         La ficha destacada es una OBRA y sube al primer lugar. El orden del
         DOM no cambia: un lector de pantalla lo escucha igual que antes. */
      .ar-intro{grid-template-columns:1fr;grid-template-areas:'feature' 'over' 'title' 'lede' 'console' 'filters' 'commands';min-height:auto;padding-top:72px;}
      .ar-title{max-width:6.2ch;font-size:clamp(3rem,12vw,4.6rem);}
      .ar-feature{grid-template-columns:96px 1fr;align-items:stretch;width:min(100%,calc(100vw - 36px));}
      .ar-feature__cover{aspect-ratio:auto;min-height:124px;}
      .ar-feature__body strong{font-size:1.8rem;}
      .ar-feature__body em{display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;}
      .ar-console{grid-template-columns:repeat(2,minmax(0,1fr));}
      .ar-filterbar{grid-template-columns:1fr 1fr;}
      .ar-console,.ar-filterbar,.ar-command{width:100%;max-width:100%;box-sizing:border-box;}
      .ar-grid{grid-template-columns:1fr;padding-inline:clamp(16px,5vw,30px);}
      .ar-filterbar button{grid-column:1/-1;}
      .ar-command{grid-template-columns:1fr;}
      .ar-command a{border-right:0;border-bottom:1px solid rgba(230,230,230,.1);}
      .ar-depth-head{align-items:start;flex-direction:column;}
    }
    @media (max-width:560px){
      .ar-filterbar{grid-template-columns:1fr;}
    }
  </style>

  <script>
    import { KodexWorld } from '../../kodex/engine/kodexWorld.js';
    const canvas = document.getElementById('kodex-world');
    if (canvas) {
      const reduceWorld = matchMedia('(max-width: 767px), (prefers-reduced-motion: reduce)').matches;
      if (reduceWorld) {
        canvas.dataset.reduced = 'true';
      } else {
        const world = new KodexWorld(canvas, { seed: 118 });
        world.setTint([0.66, 1.0, 0.0]);
        const worldArtwork = canvas.dataset.worldArt;
        (async () => {
          if (worldArtwork) await world.loadArtwork(worldArtwork);
          world.start();
        })().catch(() => world.start());
        document.addEventListener('visibilitychange', () => { if (document.hidden) world.stop(); else world.start(); });
      }
    }

    const selects = [...document.querySelectorAll('[data-filter-select]')];
    const cells = [...document.querySelectorAll('.ar-cell')];
    const count = document.querySelector('[data-visible-count]');
    const applyFilters = () => {
      const filters = Object.fromEntries(selects.map((s) => [s.dataset.filterSelect, s.value]));
      let visible = 0;
      cells.forEach((cell) => {
        const show = Object.entries(filters).every(([key, value]) => value === 'all' || cell.dataset[key] === value);
        cell.hidden = !show;
        if (show) visible += 1;
      });
      if (count) count.textContent = String(visible);
    };
    selects.forEach((select) => select.addEventListener('change', applyFilters));
    document.querySelector('[data-reset-filters]')?.addEventListener('click', () => {
      selects.forEach((select) => { select.value = 'all'; });
      applyFilters();
    });
  </script>
  </div>
</KodexShell>
