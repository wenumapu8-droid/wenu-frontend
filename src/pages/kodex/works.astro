---
// KODEX −∞ · THE ARCHIVE — gallery index of the 18 living work-pages.
// A constellation of works over the luminous field; each opens its own page.
import KodexShell from '../../layouts/KodexShell.astro';
import { families, discoWorks, opName } from '../../lib/kodex.js';

const EFFECTS = ['MIRROR', 'GLITCH', 'CHROMA', 'DITHER', 'PIXEL SORT', 'SCANLINES'];
const works = [
  ...families.map((f) => ({ n: f.n, url: `/img/kodex/${f.dir}/${f.rep}.jpg`, ops: f.ops, acc: f.th.c, lane: f.dir === 'works' ? 'achroma' : f.dir })),
  ...discoWorks.map((f) => ({ n: f.n, url: `/img/kodex/${f.dir}/${f.rep}.jpg`, ops: f.ops, acc: f.th.c, lane: 'disco' })),
].map((w, i) => ({ ...w, fx: EFFECTS[i % EFFECTS.length], index: String(i + 1).padStart(2, '0') }));
---

<KodexShell title="KODEX −∞ · The Archive">
  <main class="ar" data-ar>
    <canvas id="kodex-world" data-world></canvas>

    <header class="ar-top">
      <a class="ar-home" href="/kodex/">◈ KODEX</a>
      <span class="ar-count">{works.length} WORKS</span>
      <a class="ar-about" href="/kodex/work/001/">ENTER →</a>
    </header>

    <section class="ar-intro">
      <div class="ar-sun" aria-hidden="true">
        <span class="ar-sun__core"></span>
        <span class="ar-sun__ring"></span>
        <span class="ar-sun__glyphs">ARCHIVE ARCHIVE ARCHIVE ARCHIVE</span>
      </div>
      <p class="ar-over" data-glitch>KODEX OS · VISUAL DATABASE</p>
      <h1 class="ar-title">Archive Grid</h1>
      <p class="ar-lede">A live index of real plates, movements, effects and collectible states. Filter the signal, enter a specimen, or move toward store and mint layers.</p>
      <div class="ar-console" aria-label="archive status">
        <span><b>{works.length}</b> WORKS</span>
        <span><b>3</b> PRINT DRAFTS</span>
        <span><b>3</b> NFT FILES</span>
        <span><b>174</b> JEWELRY PRODUCTS ISOLATED</span>
      </div>
      <aside class="ar-hud" aria-label="archive telemetry">
        <span><b>FPS</b>VISUAL</span>
        <span><b>STATE</b>INDEX</span>
        <span><b>CHAIN</b>LOCAL</span>
        <span><b>SEED</b>OCIN</span>
      </aside>
      <nav class="ar-mv" aria-label="movements">
        <span class="ar-mv__l">THE JOURNEY ·</span>
        <a href="/kodex/movement/achroma/">I · ACHROMA</a>
        <a href="/kodex/movement/tribe/">II · TRIBE SPACE</a>
        <a href="/kodex/movement/disco/">III · DISCO SOLAR</a>
      </nav>
      <div class="ar-filters" aria-label="archive filters">
        <button type="button" data-filter="all" aria-pressed="true">ALL</button>
        <button type="button" data-filter="achroma">ACHROMA</button>
        <button type="button" data-filter="disco">DISCO</button>
        <button type="button" data-filter="print">PRINT READY</button>
      </div>
      <nav class="ar-command" aria-label="archive commands">
        <a href="/kodex/world/">SOL NEGRO</a>
        <a href="/kodex/store/#print-drops">PRINT</a>
        <a href="/kodex/store/#nft-draft">NFT</a>
        <a href="/kodex/store/">STORE</a>
        <a href="/kodex/">BOOK</a>
      </nav>
      <div class="ar-state" aria-label="archive cycle">
        <span>ESTADO · EL CICLO DE RETORNO</span>
        <b>E00 EXCAVATION</b>
        <b>T01 TRANSMUTATION</b>
        <b>M11 DEVOLUTION</b>
        <p>Automatic cycle: source plate → movement → effect → edition lane → return to the mother system.</p>
      </div>
    </section>

    <div class="ar-grid">
      {works.map((w) => (
        <a class="ar-cell" href={`/kodex/work/${w.n}/`} style={`--acc:${w.acc}`} data-lane={w.lane} data-print={['001','D01','D02'].includes(w.n) ? 'yes' : 'no'}>
          <span class="ar-cell__frame"><img src={w.url} loading="lazy" alt={`KODEX−∞ — plate ${w.n}`} /></span>
          <span class="ar-cell__idx">KDX/{w.index}</span>
          <span class="ar-cell__n">{w.n}</span>
          <span class="ar-cell__fx">◈ {w.fx} · {w.lane.toUpperCase()}</span>
          <span class="ar-cell__ops">{w.ops.join(' · ')}</span>
        </a>
      ))}
    </div>

    <footer class="ar-foot"><p>KODEX −∞ · a possibility given form · belongs to no one, and to all.</p></footer>
  </main>

  <style>
    .ar{ position:relative; min-height:100vh; background:#000; color:#f0ede8; font-family:'JetBrains Mono',ui-monospace,monospace; overflow-x:hidden; }
    .ar::before{ content:''; position:fixed; inset:-16vw; z-index:1; pointer-events:none;
      background:
        radial-gradient(circle at 50% 22%, #000 0 8.2vw, rgba(250,212,105,.85) 8.5vw 8.95vw, rgba(201,168,76,.32) 9.2vw 14vw, transparent 24vw),
        radial-gradient(ellipse at 50% 22%, rgba(201,168,76,.18), transparent 36vw),
        linear-gradient(90deg, transparent 0 49.8%, rgba(255,255,255,.08) 50%, transparent 50.2%),
        linear-gradient(0deg, transparent 0 38%, rgba(0,240,255,.04) 38.1%, transparent 38.35%);
      opacity:.55; mix-blend-mode:screen; }
    .ar::after{ content:''; position:fixed; inset:0; z-index:1; pointer-events:none; opacity:.28;
      background:repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 4px),
        radial-gradient(110% 82% at 50% 35%, transparent 52%, rgba(0,0,0,.78) 100%); }
    #kodex-world{ position:fixed; inset:0; width:100%; height:100%; display:block; z-index:0; opacity:.5; }
    .ar :where(a){ color:inherit; text-decoration:none; }
    .ar > :not(#kodex-world){ position:relative; z-index:2; }

    .ar-top{ position:sticky; top:0; z-index:5; display:flex; align-items:center; justify-content:space-between;
      padding:16px clamp(14px,4vw,40px); font-size:11px; letter-spacing:.16em; background:linear-gradient(#000 55%,transparent);
      border-top:1px solid rgba(201,168,76,.34); box-shadow:0 0 38px rgba(201,168,76,.18); }
    .ar-home{ font-family:'Instrument Serif',serif; font-size:18px; }
    .ar-count{ color:#8f8f8f; }
    .ar-about{ font-size:10px; letter-spacing:.2em; color:#c9a84c; border:1px solid #1c1c1c; padding:8px 14px; transition:.25s; }
    .ar-about:hover{ border-color:#c9a84c; }

    .ar-intro{ position:relative; text-align:center; min-height:min(900px,96vh);
      padding:clamp(42px,8vh,96px) 20px clamp(24px,5vh,50px); overflow:hidden;
      background:
        linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.18) 42%,rgba(0,0,0,.9) 88%),
        radial-gradient(80% 62% at 50% 32%,transparent 0 42%,rgba(0,0,0,.74) 86%),
        url('/img/kodex/ui/kodex-black-sun-os.png') center top / min(1420px,112vw) auto no-repeat; }
    .ar-intro::after{ content:''; position:absolute; inset:0; pointer-events:none;
      background:linear-gradient(90deg,rgba(0,0,0,.76),transparent 28%,transparent 72%,rgba(0,0,0,.82)),
        repeating-linear-gradient(0deg,rgba(255,255,255,.028) 0 1px,transparent 1px 4px);
      opacity:.8; }
    .ar-intro > *{ position:relative; z-index:1; }
    .ar-intro::before{ content:''; position:absolute; left:50%; top:42%; width:min(82vw,760px); aspect-ratio:1/1; transform:translate(-50%,-50%);
      border:1px solid rgba(201,168,76,.12); border-radius:50%; pointer-events:none; box-shadow:inset 0 0 76px rgba(201,168,76,.035); }
    .ar-sun{ position:absolute; left:50%; top:42%; width:min(94vw,1120px); aspect-ratio:16/9; transform:translate(-50%,-50%);
      pointer-events:none; opacity:.14; mix-blend-mode:screen; z-index:0; }
    .ar-sun__core{ position:absolute; left:50%; top:48%; width:min(34vw,350px); aspect-ratio:1/1; transform:translate(-50%,-50%); border-radius:50%;
      background:#000; box-shadow:0 0 0 8px rgba(255,214,85,.86),0 0 34px 16px rgba(255,190,56,.7),0 0 92px 48px rgba(201,113,45,.26); }
    .ar-sun__ring{ position:absolute; inset:8% 4%; border:1px solid rgba(255,255,255,.08); border-radius:50%;
      box-shadow:inset 0 0 80px rgba(255,255,255,.045),0 0 70px rgba(201,168,76,.12); }
    .ar-sun__glyphs{ position:absolute; left:2%; right:2%; top:18%; font-family:'Instrument Serif',serif; font-size:clamp(4rem,10vw,9rem);
      letter-spacing:.04em; color:rgba(240,237,232,.1); filter:blur(2px); transform:perspective(500px) rotateX(26deg); }
    .ar-over{ font-size:11px; letter-spacing:.3em; color:#9a948a; margin:0; }
    .ar-title{ font-family:'Instrument Serif',serif; font-weight:400; font-size:clamp(3rem,9vw,6rem); margin:12px 0 0; text-shadow:0 2px 26px rgba(0,0,0,.9); }
    .ar-lede{ max-width:46ch; margin:18px auto 0; font-family:'Cormorant Garamond',serif; font-size:clamp(1.05rem,2.2vw,1.4rem); line-height:1.5; color:#c8c2b6; }
    .ar-console{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1px; max-width:900px; margin:24px auto 0; background:#161616; border:1px solid #161616; }
    .ar-console span{ background:rgba(5,5,6,.88); padding:12px 10px; font-size:9px; letter-spacing:.14em; color:#777; }
    .ar-console b{ color:#00f0ff; font-weight:400; }
    .ar-hud{ position:absolute; right:clamp(16px,4vw,54px); top:clamp(70px,13vh,130px); display:flex; flex-direction:column; gap:7px; min-width:150px; text-align:left; }
    .ar-hud span{ display:flex; justify-content:space-between; gap:16px; padding:8px 0; border-top:1px solid rgba(255,255,255,.11);
      font-size:8.5px; letter-spacing:.13em; color:#8f8f8f; }
    .ar-hud b{ color:#c9a84c; font-weight:400; }
    .ar-mv{ display:flex; flex-wrap:wrap; justify-content:center; gap:8px 14px; margin:24px auto 0; font-size:10px; letter-spacing:.16em; }
    .ar-mv__l{ color:#585858; }
    .ar-mv a{ color:#9a948a; border:1px solid #1c1c1c; padding:7px 12px; transition:.25s; }
    .ar-mv a:hover{ color:#f0ede8; border-color:#c9a84c; box-shadow:0 0 16px rgba(201,168,76,.18); }
    .ar-filters{ display:flex; flex-wrap:wrap; justify-content:center; gap:8px; margin:18px auto 0; }
    .ar-filters button{ background:#050506; border:1px solid #1c1c1c; color:#6a6a6a; padding:8px 12px; cursor:pointer;
      font:10px/1 'JetBrains Mono',monospace; letter-spacing:.16em; transition:.25s; }
    .ar-filters button:hover,.ar-filters button[aria-pressed="true"]{ color:#050506; background:#00f0ff; border-color:#00f0ff; box-shadow:0 0 18px rgba(0,240,255,.22); }
    .ar-command{ width:min(840px,100%); margin:24px auto 0; display:grid; grid-template-columns:repeat(5,minmax(0,1fr));
      border:1px solid #171717; background:rgba(0,0,0,.72); box-shadow:0 18px 60px rgba(0,0,0,.68),0 0 46px rgba(201,168,76,.16); backdrop-filter:blur(10px); }
    .ar-command a{ min-height:40px; display:grid; place-items:center; border-right:1px solid #171717; font-size:8.5px; letter-spacing:.16em; color:#8f8f8f; transition:.25s; }
    .ar-command a:last-child{ border-right:0; }
    .ar-command a:hover{ background:#c9a84c; color:#050506; }
    .ar-state{ width:min(840px,100%); margin:0 auto; border:1px solid #171717; border-top:0; background:rgba(0,0,0,.78);
      padding:18px 20px 20px; text-align:left; box-shadow:0 20px 70px rgba(0,0,0,.62); }
    .ar-state span{ display:block; font-family:'Cormorant Garamond',serif; font-size:15px; letter-spacing:.12em; color:#c8c2b6; margin-bottom:8px; }
    .ar-state b{ display:inline-block; margin:0 14px 8px 0; font-size:12px; letter-spacing:.1em; color:#f0ede8; font-weight:400; }
    .ar-state p{ margin:4px 0 0; max-width:68ch; font-family:'Cormorant Garamond',serif; font-size:14px; line-height:1.5; color:#8f8f8f; }

    .ar-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(clamp(140px,20vw,220px),1fr));
      gap:clamp(12px,2vw,26px); max-width:1300px; margin:0 auto; padding:clamp(20px,4vh,50px) clamp(14px,4vw,44px) 80px; }
    .ar-cell{ position:relative; display:flex; flex-direction:column; gap:8px; padding:12px; border:1px solid #141414; background:rgba(4,4,6,.72);
      transition:border-color .4s, transform .4s, box-shadow .4s; }
    .ar-cell[hidden]{ display:none; }
    .ar-cell:hover{ border-color:var(--acc,#c9a84c); transform:translateY(-3px); box-shadow:0 14px 40px rgba(0,0,0,.6), 0 0 30px color-mix(in srgb, var(--acc) 16%, transparent); }
    .ar-cell::before{ content:''; position:absolute; inset:12px; z-index:2; pointer-events:none; border:1px solid rgba(255,255,255,.05); opacity:0; transition:opacity .35s; }
    .ar-cell:hover::before{ opacity:1; }
    .ar-cell__frame{ position:relative; aspect-ratio:1/1; display:grid; place-items:center; overflow:hidden; background:#050505; }
    .ar-cell__frame::after{ content:''; position:absolute; inset:0; pointer-events:none; background:radial-gradient(circle at 50% 50%,transparent 42%,rgba(0,0,0,.62)),repeating-linear-gradient(0deg,rgba(255,255,255,.025) 0 1px,transparent 1px 4px); opacity:.68; }
    .ar-cell__frame img{ max-width:96%; max-height:96%; width:auto; height:auto; object-fit:contain; object-position:center; opacity:.9; transition:opacity .4s, transform .5s; }
    .ar-cell:hover .ar-cell__frame img{ opacity:1; transform:scale(1.03); }
    .ar-cell__idx{ position:absolute; top:20px; left:20px; z-index:3; background:rgba(0,0,0,.62); border:1px solid rgba(255,255,255,.08);
      padding:5px 7px; font-size:8px; letter-spacing:.13em; color:#c8c2b6; }
    .ar-cell__n{ font-family:'Instrument Serif',serif; font-size:1.1rem; color:#f0ede8; }
    .ar-cell__fx{ font-size:9px; letter-spacing:.14em; color:var(--acc,#c9a84c); }
    .ar-cell__ops{ font-size:8.5px; letter-spacing:.1em; color:#585858; }

    .ar-foot{ text-align:center; padding:40px 20px; font-size:9.5px; letter-spacing:.14em; color:#3a3a3a; }
    @media (max-width:980px){ .ar-hud{ position:static; max-width:520px; margin:20px auto 0; } .ar-sun{ top:28%; width:120vw; } }
    @media (max-width:760px){ .ar-console{ grid-template-columns:repeat(2,minmax(0,1fr)); } .ar-command{ grid-template-columns:1fr; } .ar-command a{ border-right:0; border-bottom:1px solid #171717; } }
  </style>

  <script>
    import { KodexWorld } from '../../kodex/engine/kodexWorld.js';
    const canvas = document.getElementById('kodex-world');
    const world = new KodexWorld(canvas, { seed: Math.random() });
    world.setTint([0.90, 0.90, 0.93]); // archive overview — achromatic (B/W first)
    // La obra se carga, PERO su fallo no puede matar la escena.
    //
    // Antes: un IIFE async sin `catch`. `bw-06.jpg` no existe en este repo, así
    // que la promesa se rechazaba, `world.start()` NUNCA corría y el mundo
    // quedaba muerto — con un "Uncaught (in promise) #<Event>" en consola como
    // única pista. El `#<Event>` es el `onerror` del `img`: la firma de una
    // imagen que no está.
    //
    // Ahora arranca igual. Un archivo faltante degrada la escena; no la
    // cancela. Y el motivo queda en el DOM en vez de sólo en la consola.
    (async () => {
      try {
        await world.loadArtwork('/img/kodex/works/bw-01.jpg');
      } catch (err) {
        document.documentElement.dataset.kdxObraError = String(err).slice(0, 120);
      } finally {
        world.start();
      }
    })();
    document.addEventListener('visibilitychange', () => { if (document.hidden) world.stop(); else world.start(); });
    // glitch the eyebrow
    const GLY = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789∞ΩΔ·';
    const el = document.querySelector('[data-glitch]');
    if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) { const t = el.textContent; const scr = () => { const t0 = performance.now(); clearInterval(el.__g); el.__g = setInterval(() => { const p = Math.min(1, (performance.now() - t0) / 800); let o = ''; for (let i = 0; i < t.length; i++) o += t[i] === ' ' ? ' ' : (i / t.length < p ? t[i] : GLY[Math.random() * GLY.length | 0]); el.textContent = o; if (p >= 1) clearInterval(el.__g); }, 40); }; setTimeout(scr, 250); setInterval(() => { if (Math.random() < 0.5) scr(); }, 7000); }
    document.querySelectorAll('[data-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        document.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        document.querySelectorAll('.ar-cell').forEach((cell) => {
          const show = filter === 'all' || cell.dataset.lane === filter || (filter === 'print' && cell.dataset.print === 'yes');
          cell.hidden = !show;
        });
      });
    });
  </script>
</KodexShell>
