---
import Base from '../../../layouts/Base.astro';
import KodexRecuerda from '../../../components/kodex/KodexRecuerda.astro';
import KodexTransition from '../../../components/kodex/transition/KodexTransition.astro';
import EscenaDescent from '../../../components/kodex/descent/EscenaDescent.astro';
import '../../../styles/kodex.css';
---

<Base
  title="02 · DESCENT — KODEX−∞"
  description="KODEX−∞ DESCENT · Strata Engine"
  robots="noindex, nofollow"
  kodexFonts={true}
  noNav={true}
  noFooter={true}
  noOverlays={true}
  noQuote={true}
  noThemes={true}
  noKai={true}
  noCart={true}
  noImmersive={true}
>
  <KodexRecuerda />

  <main
    class="kx-native-descent-route kx-os-scene kx-os-scene--descent"
    data-kx
    data-kdx-native-folio="ii"
    data-stage-idx="2"
    data-stage-name="DESCENT"
    data-prev-url="/kodex/folio/i/"
    data-next-url="/kodex/folio/iii/"
    style="--kdx-scene-accent:#FF6A00;"
  >
    <KodexTransition router={true} />
    <EscenaDescent />
  </main>
</Base>

<style>
  :global(html), :global(body) {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow: hidden;
    background: #020202;
  }

  .kx-native-descent-route {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
    background: #020202;
  }
</style>
