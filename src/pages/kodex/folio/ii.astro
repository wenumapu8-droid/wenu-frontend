---
import KodexLayout from '../../../layouts/KodexLayout.astro';
import KodexTransition from '../../../components/kodex/transition/KodexTransition.astro';
import EscenaDescent from '../../../components/kodex/descent/EscenaDescent.astro';
import '../../../styles/kodex.css';

const folioId = 'ii';
---

<KodexLayout
  title="KODEX ∞ — DESCENT"
  description="Depth is navigated as strata: choose, descend, cross."
>
  <main
    id="main-content"
    class="kdx-native-folio kdx-native-folio--descent"
    data-kdx-native-folio={folioId}
    data-kdx-scene="descent"
    data-kdx-phase="open"
  >
    <EscenaDescent />
  </main>
  <KodexTransition />
</KodexLayout>
