  const _mod = await import('../../../lib/kodex/runtime/journeyGraph/frozen-canonical-graph.json');
  journeyGraph = (_mod as any).default ?? (_mod as any);
} catch {
  // Sin graph, STRUCTURAL LINKS mostrará SEVERED. Es un hueco declarado.
}

