---
// KODEX−∞ · fullscreen scene system.
// One route = one 100dvh scene. Depth lives in local states and overlays.
import Base from '../../../layouts/Base.astro';
/* TITLE ENGINE: el titulo de la escena deja de ser etiqueta y pasa a ser
   estado — mecanismo de spacetypegenerator traducido a operadores KODEX. */
import TituloCinetico from '../../../components/kodex/os/TituloCinetico.astro';
import KodexChrome from '../../../components/KodexChrome.astro';
import Descenso from '../../../components/kodex/os/Descenso.astro'; // la boca hacia dentro: el pasillo lateral sigue intacto, esto es la segunda salida
import CommissionForm from '../../../components/kodex/CommissionForm.astro'; // el boton COMMISSION A SYSTEM existia sin su overlay: click muerto (hallazgo de auditoria)
import KodexOverlays from '../../../components/KodexOverlays.astro';
import CosmologyMap from '../../../components/kodex/CosmologyMap.astro';
import KodexObserveScene from '../../../components/kodex/observe/KodexObserveScene.astro';
import KodexArtifact from '../../../components/kodex/artifact/KodexArtifact.astro';
import LaminaOrganismo from '../../../components/kodex/escena/LaminaOrganismo.astro';
import KodexRail from '../../../components/kodex/density/KodexRail.astro';
import KodexDataStrip from '../../../components/kodex/density/KodexDataStrip.astro';
import KodexField from '../../../components/kodex/field/KodexField.astro';
import KodexAscii from '../../../components/kodex/ascii/KodexAscii.astro';
import KodexCrtLayer from '../../../components/kodex/crt/KodexCrtLayer.astro';
import KodexEje from '../../../components/kodex/eje/KodexEje.astro';
import KodexMuseo from '../../../components/kodex/museo/KodexMuseo.astro';
import KodexTira from '../../../components/kodex/museo/KodexTira.astro';
import { leerManifiesto, resolver } from '../../../lib/kodex/volumenes';
import KodexSystemFooter from '../../../components/kodex/density/KodexSystemFooter.astro';
import KodexRegistration from '../../../components/kodex/density/KodexRegistration.astro';
import KodexTransition from '../../../components/kodex/transition/KodexTransition.astro';
import KodexDebug from '../../../components/kodex/debug/KodexDebug.astro';
import '../../../styles/kodex-micrographics.css';
import '../../../styles/kodex.css';
/* KDX_PLATE_CONTRACT — la anatomía declarada de la plancha. La hoja no
   hace nada sin el atributo de compuerta: ver src/styles/kodex-plate.css */
import '../../../styles/kodex-plate.css';
import '../../../styles/kodex-instrumento.css';
import { plateId, perfilMovil, plateVars, KDX_PLATE_CONTRACT_VERSION } from '../../../lib/kodex/plancha/plate-contract';
import { fieldParams, motionVars, recipeFor, gridFor } from '../../../lib/kodex/grammar';
import { specimens, families, discoWorks, folios, organs } from '../../../lib/kodexBook.js';
/* Cada folio registra su paso: sin esto el recorrido llega vacío a RETURN
   y el espécimen sale curado en vez de personal. */
import KodexRecuerda from '../../../components/kodex/KodexRecuerda.astro';
import EspecimenRetorno from '../../../components/kodex/os/EspecimenRetorno.astro';

export function getStaticPaths() {
  return [
    { params: { folio: 'i' } }, { params: { folio: 'ii' } }, { params: { folio: 'iii' } },
    { params: { folio: 'iv' } }, { params: { folio: 'v' } }, { params: { folio: 'vi' } },
  ];
}

const { folio } = Astro.params;
const idx = folios.findIndex((f) => f.slug === folio);
const F = folios[idx];
const prev = idx > 0 ? folios[idx - 1] : null;
const next = idx < folios.length - 1 ? folios[idx + 1] : null;
const prevUrl = folio === 'iv'
  ? '/kodex/interlude/archive-machine/'
  : folio === 'vi'
    ? '/kodex/interlude/cosmology-return/'
    : prev
      ? `/kodex/folio/${prev.slug}/`
      : '/kodex/';
const nextUrl = folio === 'iii'
  ? '/kodex/interlude/archive-machine/'
  : folio === 'v'
    ? '/kodex/interlude/cosmology-return/'
    : next
      ? `/kodex/folio/${next.slug}/`
      : '/kodex/';
/* El CTA de cruce es POR ESCENA y con el vocabulario del creador — transcrito
   de las pantallas de diseño del Drive (pend-26), no inventado. El rótulo
   promete la escena de DESTINO: al final de cada folio, el botón dice qué se
   va a cruzar. Antes decía el genérico `NEXT · STAGE`. */
/* Un operador por escena (PR #112 / Title Engine). El titulo lo ejecuta. */
const OPERADOR: Record<string, 'APERTURE'|'SCAN'|'VORTEX'|'STRATA'|'ASSEMBLY'|'ORBIT'|'RECALL'> = {
  i: 'SCAN', ii: 'VORTEX', iii: 'STRATA', iv: 'ASSEMBLY', v: 'ORBIT', vi: 'RECALL',
};
const CTA_ESCENA: Record<string, string> = {
  i: 'BEGIN PROLOGUE →',
  ii: 'DESCEND →',
  iii: 'OPEN ARCHIVE →',
  iv: 'ACTIVATE →',
  v: 'EXPLORE COSMOS →',
  vi: 'RETURN →',
};
const nextLabel =
  folio === 'iii' ? CTA_ESCENA['iv']   // el interludio es pasaje: se promete MACHINE
  : folio === 'v' ? CTA_ESCENA['vi']   // ídem: se promete RETURN
  : next ? CTA_ESCENA[next.slug] ?? `NEXT · ${next.stage}`
  : 'RETURN TO THRESHOLD';

/* ── UNA OBRA DISTINTA POR ESCENA ──────────────────────────────────────────
   Las siete se parecían porque CINCO usaban la misma serie monocroma `bw-*`.
   Medido: bw-01, bw-02, bw-07 y bw-11 tienen brillo 20-27 y saturación 1,6-3,7
   — la misma paleta, la misma densidad, el mismo gesto. El creador lo viene
   diciendo desde el principio: «no tenemos siete portales iguales con skins
   distintos».

   La asignación sale de la propuesta de imac-kimi, verificada acá una por una
   mirando las obras, no sólo sus números:

     THRESHOLD  arch-04     mandala cristalino sobre negro, el centro es abertura
     PROLOGUE   arch-21     estallido radial que lee como iris — «el archivo observa»
     DESCENT    bw-06       el sistema YA la llama DESCENT en kodexBook.js:6
     ARCHIVE    arch-01     se mantiene, ya estaba bien
     MACHINE    conjuncion  laberinto y maquinaria reflejada, no se parece a nada
     COSMOLOGY  disco-05    red radial en magenta — el acento ya declarado de la escena
     RETURN     mandala     la que hoy estaba mal puesta en el umbral

   Quedan tres familias distintas donde había una: archive, works y disco. */
const sceneByFolio = {
  i: {
    number: '01', slug: 'prologue', accent: 'var(--kdx-violet,#8B5CF6)', motif: 'archive-eye',
    kicker: 'PROLOGUE · OBSERVATION PROTOCOL',
    title: 'THE ARCHIVE IS WATCHING.',
    copy: ['YOU ARE NOT ALONE.', 'A SIGNAL.', 'A SYSTEM.', 'A CHOICE.'],
    cta: 'BEGIN OBSERVATION',
    meta: ['NODE · KDX_01', 'STATUS · OBSERVING', 'ACCESS · RECORDED', 'PROTOCOL · EYE/CRT/WAVE'],
    image: '/img/kodex/archive/arch-21.jpg',
  },
  ii: {
    number: '02', slug: 'descent', accent: 'var(--kdx-orange,#FF6A00)', motif: 'descent-tunnel',
    kicker: 'DESCENT · STRATA ENGINE',
    title: 'THE TREE DESCENDS TO HOLD WHAT RISES.',
    cta: 'DESCEND',
    meta: ['NODE · KDX_02', 'MODE · STEPWISE', 'STRATA · 11', 'SKIP · INDEX'],
    image: '/img/kodex/works/bw-06.jpg',
  },
  iii: {
    number: '03', slug: 'archive', accent: 'var(--kdx-acid,#A7FF00)', motif: 'specimen-dossier',
    kicker: 'ARCHIVE · CLASSIFIED SPECIMEN',
    title: 'EVERY SIGNAL HAS A GENEALOGY.',
    cta: 'OPEN SPECIMEN',
    meta: ['NODE · KDX_03', 'CLASS · ARCHIVE WORK', 'WORKS · 18', 'STATUS · PRESERVED'],
    image: '/img/kodex/archive/arch-01.jpg',
  },
  iv: {
    number: '04', slug: 'machine', accent: 'var(--kdx-cyan,#00D8FF)', motif: 'signal-core',
    kicker: 'MACHINE · KDX_CORE v2.0',
    title: 'THE SYSTEM MAKES FROM MEMORY.',
    cta: 'GENERATE SIGNAL',
    meta: ['ENGINE · READY', 'SOURCE · ACHROMA_006', 'METHOD · MIRROR/DITHER/FLOW', 'INTEGRITY · 98.7%'],
    image: '/img/kodex/works/conjuncion.jpg',
  },
  v: {
    number: '05', slug: 'cosmology', accent: 'var(--kdx-magenta,#FF00C8)', motif: 'orbital-map',
    kicker: 'COSMOLOGY · LIVING CARTOGRAPHY',
    title: 'NOTHING HERE STANDS ALONE.',
    cta: 'REVEAL CONNECTION',
    meta: ['NODE · KDX_05', 'STATE · LINKED', 'DOMAIN · SIGNAL/MATTER/MEMORY', 'RELATION · +∞'],
    image: '/img/kodex/disco/disco-05.jpg',
  },
  vi: {
    /* CROMA PROPIA. RETURN venía declarada con `--kdx-acid` #A7FF00, que es
       EXACTAMENTE el mismo token que ARCHIVE (folio iii): dos escenas con una
       sola paleta, justo lo que el contrato prohíbe. Medido sobre la lámina
       `u03-return.png`: 94.9% del cuadro es neutro claro (papel) y la tinta
       saturada cae en hue 255-285° (lavanda, bucket dominante #9078A8) con un
       segundo acento cálido en hue 15-30° (dorado). Verde ácido: cero muestras.
       Medido sobre la escena servida hoy: hue 165-180° (cian, 5.050 muestras)
       + hue 75° (ácido, 2.307). Es decir, RETURN renderizaba con la croma de
       MACHINE y la de ARCHIVE, y con nada suyo. */
    number: '06', slug: 'return', accent: 'var(--kdx-return-ink,#7C5FA0)', motif: 'return-seal',
    kicker: 'RETURN · PATTERN RESTORED',
    title: 'THE SIGNAL RETURNS. THE PATTERN REMAINS.',
    cta: 'COLLECT A FRAGMENT',
    meta: ['NODE · KDX_06', 'STATE · RETURNED', 'PATTERN · ACTIVE', 'NEXT · CARRY FORWARD'],
    image: '/img/kodex/works/mandala-0cin-negativo.png',
  },
}[folio];

const archiveItems = [...families.slice(0, 13), ...discoWorks.slice(0, 5)].map((w, i) => ({
  code: `KDX_A_${String(i + 1).padStart(3, '0')}`,
  title: w.t || w.name || `Specimen ${w.n}`,
  year: '2026',
  method: w.fx || w.ops?.join(' / ') || 'mirror / signal fold',
  type: w.dir === 'disco' ? 'generative output' : 'archive work',
  source: `/img/kodex/${w.dir}/${w.rep}.jpg`,
  status: i < 3 ? 'edition available' : 'preserved',
  relation: w.insp || 'signal / matter / memory',
}));

const selectedArchive = archiveItems[0];
const selectedStratum = specimens[0];
// Glifo por escena. En los boards el kana ancla la lectura del panel; se
// elige uno que diga algo de la lamina, no un adorno al azar.
const glyphByFolio = {
  i: '観測',      // observacion
  ii: '降下',     // descenso
  iii: '記録',    // registro
  iv: '機械',     // maquina
  v: '宇宙',      // cosmos
  vi: '回帰',     // retorno
};
const sceneGlyph = glyphByFolio[folio] ?? 'ポータル';

// La tira lateral se arma con los metadatos que la escena ya declara: se parte
// cada entrada 'CLAVE · VALOR' del rail existente. Asi no hay dos fuentes de
// verdad que puedan desincronizarse.
/* El contrato de plancha. `perfilMovil` devuelve null para toda escena que
   todavía no fue calibrada, y sin perfil la compuerta no se abre: esas cinco
   escenas se sirven byte por byte como antes. */
const platePerfil = perfilMovil(sceneByFolio.slug);
const plateIdent = plateId(sceneByFolio.slug);
const plateStyle = platePerfil ? plateVars(platePerfil) : '';

const stripRows = sceneByFolio.meta.map((row) => {
  const [k, ...rest] = row.split('·');
  return { k: k.trim(), v: rest.join('·').trim() || '—' };
});

const figureByFolio = { i: 'rings', ii: 'triangles', iii: 'squares', iv: 'rings', v: 'rings', vi: 'triangles' };

/**
 * El campo vivo de cada lámina.
 *
 * Todas corren la MISMA red -- el vórtice de la referencia -- porque es el
 * lenguaje de la experiencia, no un efecto de una escena: "así debe sentirse
 * esta red viva para cada pantallazo".
 *
 * Cómo se comporta cada una ya no se elige a ojo: sale de la receta de la
 * gramática visual, que es quien decide "cómo se comporta". DESCENT resulta la
 * más rápida porque su receta declara mutación de secuencia; COSMOLOGY la más
 * lenta y la más tejida porque es la receta más densa del set (0.96).
 *
 * Lo único que se sigue eligiendo a mano es el color, y a propósito: las
 * recetas dicen `palette_mode: original_kodex_palette` y nada más. La paleta
 * es de KODEX, no de las referencias.
 */
/**
 * Color y piso de luminancia por lámina.
 *
 * El piso decide desde qué brillo el campo deja de ser negro, y NO es igual
 * para todos: cada shader llena el cuadro de manera distinta. Los que son casi
 * todo negro con estructura brillante necesitan un piso bajo; los que llenan
 * el cuadro entero -- la retorcedura de COSMOLOGY es el caso extremo, sale
 * como un disco pleno -- necesitan uno alto o se comen la lámina. Medido: con
 * el piso por defecto, COSMOLOGY caía a 65% de fondo oscuro contra el ~85% que
 * pide la receta.
 */
const tintByFolio = {
  i:   { tint: '#8B5CF6', spark: '#7FE9FF', floor: 0.05 },
  ii:  { tint: '#FF6A00', spark: '#8FD4FF', floor: 0.05 },
  iii: { tint: '#A7FF00', spark: '#7FE9FF', floor: 0.06 },
  iv:  { tint: '#00D8FF', spark: '#FFC46B', floor: 0.05 },
  v:   { tint: '#FF00C8', spark: '#7FE9FF', floor: 0.16 },
  vi:  { tint: '#7C5FA0', spark: '#BE8C50', floor: 0.06 },  // lavanda + dorado: la croma de u03-return
};
const sceneRecipe = recipeFor(folio);
const sceneGrid = gridFor(folio);
const sceneMotion = motionVars(folio);
/**
 * El TRATAMIENTO de cada lámina, que es lo que la distingue.
 *
 * La regla del proyecto: una gramática, siete productos. Si tapo el chrome y
 * pongo dos escenas lado a lado tienen que distinguirse al instante por
 * organismo, tratamiento y color, y reconocerse como el mismo sistema. Si las
 * siete parecen la misma lámina recoloreada, está mal.
 *
 * El CRT MASTER KIT trae un preset por escena -- observe, descent, archive,
 * machine, cosmology, return -- y el de `observe` viene con tinte violeta
 * [0.72, 0.48, 1.0], que es el acento de PROLOGUE. Fue escrito contra esta
 * misma tabla.
 *
 * Se va conectando escena por escena. Las que todavía no tienen su preset
 * siguen con el campo de red, que es de donde vienen.
 */
const crtByFolio = {
  i:   'observe',
  ii:  'descent',
  iii: 'archive',
  iv:  'machine',
  /* RETURN NO lleva CRT.
     El preset `return` corría sobre un canvas WebGL, y un canvas es una placa
     opaca: sobre la única lámina de papel del corredor dejaba un recuadro
     negro con destellos cian incrustado en la hoja — el HUD oscuro de las
     otras seis metido justo donde el ADN pide luz. `kodex.css` ya tenía
     escrita la traducción correcta y estaba MUERTA por falta de markup que la
     alcanzara: `.kx-os-scene--return .kx-os-stage__art img` (línea 1345)
     hace `grayscale(1) invert(1); mix-blend-mode:multiply`, que es
     precisamente lo que convierte `mandala-0cin-negativo.png` (blanco sobre
     negro) en tinta sobre papel. Se recupera esa ruta en vez de generar una
     nueva. */
};
const sceneCrt = crtByFolio[folio] ?? null;

/* PASS A · EL ORGANISMO DE CADA LAMINA ENTRA AL CORREDOR.
   Hasta aca el "arte" de la escena era una FOTO tratada con un shader CRT.
   El organismo real -- procedural, con estados -- ya existia dentro de su
   lamina y la web lo estaba escondiendo. Se conecta, no se reinterpreta. */
const organismoPorFolio = {
  i:   'prologue',
  ii:  'descent',
  iv:  'machine',
  v:   'cosmology',
};
const organismoEscena = organismoPorFolio[folio] ?? null;

/**
 * El ORGANISMO de cada lámina: qué corre detrás, si es que corre algo.
 *
 * El tratamiento (CRT) da la piel y el color; el organismo da la forma y el
 * movimiento. Juntos son la receta que distingue una escena de otra.
 *
 *  · DESCENT baja por un corredor, así que corre el corredor partido.
 *  · MACHINE es una red de nodos, que es el vórtice.
 *  · COSMOLOGY es un mapa orbital y ya trae el suyo dibujado, así que la
 *    órbita va de fondo.
 *  · ARCHIVE y RETURN NO llevan organismo detrás, y es una decisión: el
 *    archivo es un catálogo quieto -- la tabla dice "rígido" -- y el retorno
 *    resuelve limpio. Poner un campo vivo detrás de ellas sería repetir el
 *    recurso justo donde la escena pide lo contrario.
 */
/*
 * Las tres corren el vortice, y no es pereza.
 *
 * DESCENT y COSMOLOGY llevaban split-corridor y archive-orbit, que es lo que
 * la tabla de distincion pide. Compilan -- la sonda lo confirma, no hay error
 * -- pero salen tan oscuros que las dos laminas quedaban con el fondo PLANO.
 * Montado, estado en orden, nada en pantalla: el mismo fallo mudo de siempre,
 * detectado solo comparando capturas.
 *
 * La distincion se sostiene igual por tinte, chispa, detalle, velocidad,
 * semilla y el preset de CRT propio de cada una. Los presets del lab quedan
 * registrados y necesitan calibracion de ganancia por shader -- trabajo real,
 * no un parametro al azar. Dos escenas muertas es peor que un organismo
 * compartido.
 */
const organismoByFolio = {
  ii: 'network-vortex',
  iv: 'network-vortex',
  // COSMOLOGY vuelve a la orbita.
  //
  // Se probo con wrinkled-reality, que es lo que su fila de la tabla pide como
  // distorsion, y el resultado fue peor: 75% de fondo oscuro contra el ~85%
  // que exige la receta, y no bajaba ni hundiendo el piso a 0.84 ni cortando
  // la intensidad a la mitad. Medido apagando el campo: sin el, la lamina da
  // 84.4%. El campo era la causa.
  //
  // El error no era el shader sino el rol. En el modelo de tres tandas
  // -- ORGANISMO → ESPACIO → TRATAMIENTO -- wrinkled-reality es ESPACIO: se
  // compone SOBRE un organismo en multipass, no lo reemplaza. Este runtime es
  // de una sola pasada, asi que lo estaba usando como si fuera un organismo y
  // por eso llenaba el cuadro. Queda registrado en SHADERS, listo para cuando
  // exista la cadena multipass, que es el trabajo que sigue.
  v:  'network-vortex',
};
const sceneOrganismo = organismoByFolio[folio] ?? null;

const sceneField = {
  field: sceneOrganismo ?? 'network-vortex',
  // La intensidad acompaña a la densidad de la receta: una lámina que la
  // gramática marca densa tiene derecho a un campo más presente.
  // La intensidad sale de la densidad de la receta, salvo que la lámina la
  // corrija: hay shaders que llenan el cuadro y no se dejan domar sólo con el
  // piso. COSMOLOGY es ese caso.
  intensity: Math.round((0.34 + sceneRecipe.density * 0.26) * 100) / 100,
  ...tintByFolio[folio],
  ...fieldParams(folio),
};

/**
 * El motor ASCII, sólo donde la escena lo pide.
 *
 * El kit trae cuatro escenas generativas con los mismos CTA que las láminas
 * ("BEGIN OBSERVATION" en observe, "GENERATE SIGNAL" en signal): se escribió
 * contra esta misma especificación. Pero sólo dos láminas lo justifican --
 * PROLOGUE, donde el archivo observa, y MACHINE, que genera. En las demás
 * sería un tercer sistema encendido sin nada que decir.
 *
 * Va DEBAJO de la obra, como lecho de glifos dentro de la placa, no en su
 * lugar: el ojo procedural de PROLOGUE ya se retiró una vez por protagonista
 * ("horrible, no era lo esperado" -- KODEX-POLISH.md). La pieza es la obra.
 */
const asciiByFolio = {
  i: { scene: 'observe', glyphs: 'kodex' },
  // La escena de señal del kit venía en verde agua; MACHINE es cian.
  iv: {
    scene: 'signal',
    glyphs: 'petscii',
    palette: ['#03080c', '#062231', '#0a4f6b', '#0f93bd', '#5fe4ff', '#e9fbff'],
  },
};
const sceneAscii = asciiByFolio[folio] ?? null;

/**
 * La HERRAMIENTA de scroll de cada lámina.
 *
 * Regla dura de la misión: cero scroll de página. La rueda no baja el
 * documento — opera la escena. Y qué opera lo decide lo que la escena hace,
 * no una preferencia: en DESCENT se desciende porque la lámina se llama
 * descenso; en ARCHIVE se recorre porque es un catálogo.
 */
const herramientaByFolio = {
  i:   'intensificar',   // PROLOGUE: subir la observación, revelar capas
  ii:  'descender',      // DESCENT: bajar por el corredor
  iii: 'recorrer',       // ARCHIVE: pasar por los specimens
  iv:  'intensificar',   // MACHINE: subir la generación
  v:   'orbitar',        // COSMOLOGY: girar el mapa
  vi:  'reensamblar',    // RETURN: rehacer el patrón
};
const sceneHerramienta = herramientaByFolio[folio] ?? null;

// ARCHIVE es el indice de la biblioteca. Se lee el manifiesto solo en esa
// lamina: las demas no lo necesitan y leerlo en todas seria trabajo de build
// repetido seis veces para nada.
/**
 * A qué estrato del sistema pertenece cada lámina.
 *
 * Los seis estratos son la estructura REAL del archivo -- están en el
 * storyboard y en el segundo cerebro. Las siete escenas son el marco que se
 * recorre; los estratos son lo que hay debajo. Este mapa los une, y la
 * asignación sale de lo que cada uno dice ser:
 *
 *   PROLOGUE   01 macro-geometrías   el origen de las formas
 *   DESCENT    04 sol negro          la puerta entre lo visible y lo invisible
 *   ARCHIVE    —                     es el índice de TODOS
 *   MACHINE    06 laboratorio        código, IA y arte generativo
 *   COSMOLOGY  05 yayentru           geometría de energía y conexión
 *   RETURN     03 respirantes        patrones que respiran y pulsan
 *
 * (02 portales es de THRESHOLD, que vive en la otra plantilla.)
 */
const estratoByFolio = {
  i:  'macro-geometrias',
  ii: 'sol-negro',
  iv: 'laboratorio',
  v:  'yayentru',
  vi: 'geometrias-respirantes',
};

const todosLosVolumenes = resolver(await leerManifiesto());
// ARCHIVE recibe todos: es el indice. Las demas, los de su estrato.
const volumenes = folio === 'iii' ? todosLosVolumenes : [];
const volumenesDelEstrato = folio === 'iii'
  ? []
  : todosLosVolumenes.filter((v) => v.estrato === estratoByFolio[folio]);

/**
 * Dónde cae cada lámina en el eje −∞ · 0 · +∞.
 *
 * No es decorativo: es el recorrido de la fórmula maestra. PROLOGUE todavía
 * está en la profundidad; DESCENT excava; ARCHIVE es lo que se encontró abajo;
 * MACHINE transmuta, y por eso está en el 0 -- el punto donde nada está fijado;
 * COSMOLOGY manifiesta hacia +∞; RETURN cierra la vuelta y deja al sistema
 * otra vez cerca del archivo, pero con algo en la mano. Espiral, no recta.
 */
const ejeByFolio = { i: 0.12, ii: 0.28, iii: 0.4, iv: 0.5, v: 0.82, vi: 0.06 };
const scenePosicion = ejeByFolio[folio] ?? 0;

const cosmoNodes = ['KODEX', 'Wenu Mapu', 'Soma', 'Disco Solar', 'Cosmic Serpent', 'Body', 'Matter', 'Memory', 'Territory', 'Signal', 'Machine'];
---

<Base
  title={`${sceneByFolio.number} · ${sceneByFolio.slug.toUpperCase()} — KODEX−∞`}
  description={`KODEX−∞ scene ${sceneByFolio.number}: ${sceneByFolio.title}`}
  robots="noindex, nofollow"
  ogImage={sceneByFolio.image}
  kodexFonts={true}
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
  osShell={true}
>
  <KodexRecuerda />
  <div
    class={`kx kx--deck kx-os-scene kx-os-scene--${sceneByFolio.slug}`}
    data-kx
    data-stage-idx={idx + 1}
    data-stage-name={sceneByFolio.slug.toUpperCase()}
    data-stage-col={F.col}
    data-prev-url={prevUrl}
    data-next-url={nextUrl}
    data-next-label={nextLabel}
    data-kdx-tool={sceneHerramienta}
    data-kdx-recipe={sceneRecipe.id}
    data-kdx-grid={sceneGrid.id}
    data-kdx-shell={KDX_PLATE_CONTRACT_VERSION}
    data-kdx-plate-contract={platePerfil ? KDX_PLATE_CONTRACT_VERSION : undefined}
    data-kdx-plate={plateIdent}
    data-kdx-plate-metadata={platePerfil?.metadataMode}
    style={`--acc:${sceneByFolio.accent};--kdx-scene-accent:${sceneByFolio.accent};${folio === 'vi' ? '--kdx-return-ink:#7C5FA0;--kdx-return-gold:#BE8C50;--kdx-paper:#F2EFE7;' : ''}${sceneMotion}${plateStyle ? ';' + plateStyle : ''}`}
  >
    <KodexTransition router={true} />
    <KodexDebug />

    <KodexChrome segs={7} />

    <div class="kx-deck" data-deck>
      <section class="kx-slide kx-slide--os kx-active" id={sceneByFolio.slug} style="overflow:hidden;overflow-x:hidden;overflow-y:hidden;">
        {/* PROLOGUE usaba KodexObserveScene, la escena del ojo procedural. Ocin
            la descarto sin ambiguedad: "horrible, no era lo esperado" -- rework
            total del anchor (KODEX-POLISH.md, 2026-07-29). Ahora entra por el
            mismo layout que las demas laminas, con su obra tratada como
            ARTIFACT. La densidad la aportan el rail y la metadata, no un
            organismo generado. */}
        {(
        <div class={`kx-slide__in kx-os-stage${folio === 'vi' ? ' kx-os-stage--return' : ''}`} data-kdx-scene-kind={sceneByFolio.slug}>
          <KodexRegistration accent={sceneByFolio.accent} />

          {/* El campo de red sólo donde la escena todavía no tiene su propio
              tratamiento. Correr los dos deja dos sistemas peleando por el
              mismo fondo. */}
          {sceneOrganismo && <KodexField
            field={sceneField.field}
            intensity={sceneField.intensity}
            feedback={sceneField.feedback}
            tint={sceneField.tint}
            floor={sceneField.floor}
            spark={sceneField.spark}
            detail={sceneField.detail}
            speed={sceneField.speed}
            seed={idx + 1}
            class="kx-os-stage__livefield"
          />}

          <div class="kx-os-stage__field" aria-hidden="true">
            <span class="kx-os-stage__grid"></span>
            <span class="kx-os-stage__halo"></span>
            <span class="kx-os-stage__scan"></span>
          </div>

          {/* La metadata era una columna de texto suelto. En los boards de
              referencia ese costado es un panel: marco con esquinas cortadas,
              pares clave/valor alineados, un medidor y una figura concentrica.
              Mismos datos, leidos como instrumento. */}
          <KodexEje posicion={scenePosicion} accent={sceneByFolio.accent} class="kx-os-stage__eje" />

          {/* Lo que hay DEBAJO de esta escena. La lamina es la superficie;
              los volumenes son la profundidad que se abre al entrar. */}
          <KodexTira
            volumenes={volumenesDelEstrato}
            estrato={estratoByFolio[folio] ?? ""}
            accent={sceneByFolio.accent}
            class="kx-os-stage__tira"
          />

          <KodexDataStrip
            title={`${sceneByFolio.number} · ${sceneByFolio.slug}`}
            rows={stripRows}
            accent={sceneByFolio.accent}
            meter={(idx + 1) / 7}
            meterLabel="DEPTH"
            figure={figureByFolio[folio] ?? 'rings'}
            class="kx-os-stage__strip"
          />

          <main class="kx-os-stage__copy">
            <p class="kx-os-stage__kicker">{sceneByFolio.kicker}</p>
            <TituloCinetico texto={sceneByFolio.title} operador={OPERADOR[folio] ?? 'APERTURE'} etiqueta={`0${idx + 1} / ${sceneByFolio.slug.toUpperCase()}`} />

            {folio === 'i' && (
              <>
                <div class="kx-protocol-lines">
                  {sceneByFolio.copy.map((line) => <p>{line}</p>)}
                </div>
                <div class="kx-os-stage__actions">
                  <a class="kx-os-primary" href={nextUrl}>{sceneByFolio.cta}</a>
                  <button class="kx-os-ghost" type="button" data-kdx-drawer-open="protocol">READ THE PROTOCOL</button>
                  {/* El dossier va DENTRO de la fila de acciones y no en una
                      propia: eran cinco rectángulos apilados en el pie y ahora
                      las dos secundarias comparten una sola línea de texto. */}
                  {platePerfil && (
                    <button class="kx-os-ghost" type="button" data-kdx-plate-dossier data-kdx-drawer-open="dossier">SPECIMEN DATA</button>
                  )}
                </div>
              </>
            )}

            {folio === 'ii' && (
              <div class="kx-descent-panel" data-kdx-descent>
                <p class="kx-os-stage__sub" data-stratum-count>STRATUM · 01 / 11</p>
                <p class="kx-descent-panel__depth" data-stratum-depth>DEPTH · -137 M</p>
                <h2 data-stratum-title>{selectedStratum.name}</h2>
                <p data-stratum-read>{selectedStratum.read}</p>
                <button class="kx-os-primary" type="button" data-stratum-next>{sceneByFolio.cta}</button>
              </div>
            )}

            {folio === 'iii' && (
              <div class="kx-specimen-readout" data-kdx-archive>
                <p class="kx-os-stage__sub">SPECIMEN · {selectedArchive.code}</p>
                <h2>{selectedArchive.title}</h2>
                <dl>
                  <div><dt>CLASS</dt><dd>{selectedArchive.type.toUpperCase()}</dd></div>
                  <div><dt>YEAR</dt><dd>{selectedArchive.year}</dd></div>
                  <div><dt>METHOD</dt><dd>{selectedArchive.method}</dd></div>
                  <div><dt>STATUS</dt><dd>{selectedArchive.status.toUpperCase()}</dd></div>
                </dl>
                <button class="kx-os-primary" type="button" data-kdx-drawer-open="specimen">{sceneByFolio.cta}</button>
              </div>
            )}

            {folio === 'iv' && (
              <div class="kx-machine-readout" data-kdx-machine>
                <p class="kx-os-stage__sub">KDX_CORE v2.0</p>
                <dl>
                  <div><dt>ENGINE</dt><dd data-machine-state>READY</dd></div>
                  <div><dt>SOURCE</dt><dd data-machine-source>ACHROMA_006</dd></div>
                  <div><dt>METHOD</dt><dd data-machine-method>MIRROR / DITHER / FLOW</dd></div>
                  <div><dt>SEED</dt><dd data-machine-seed>A90C-73F1</dd></div>
                  <div><dt>INTEGRITY</dt><dd>98.7%</dd></div>
                </dl>
                <button class="kx-os-primary" type="button" data-machine-generate>{sceneByFolio.cta}</button>
                <button class="kx-os-ghost" type="button" data-kdx-drawer-open="machine">VIEW OUTPUT</button>
              </div>
            )}

            {folio === 'v' && (
              <div class="kx-cosmo-readout" data-kdx-cosmos>
                <p class="kx-os-stage__sub" data-cosmo-node>NODE · WENU MAPU</p>
                <h2 data-cosmo-state>STATE · MANIFESTED</h2>
                <p data-cosmo-relation>DOMAIN · BODY / MATTER / RITUAL<br />RELATION · +∞</p>
                <button class="kx-os-primary" type="button" data-cosmo-next>{sceneByFolio.cta}</button>
              </div>
            )}

            {folio === 'vi' && (
              <div class="kx-return-actions">
                {/* El espécimen del visitante ANTES de las salidas. RETURN
                    sintetiza el camino recorrido; las tres acciones son lo que
                    se hace con eso, no lo que la escena es. */}
                {/* El espécimen REEMPLAZA a "YOU CROSSED THE ARCHIVE / NOW
                    CARRY SOMETHING FORWARD". Esa frase decía en genérico lo que
                    el espécimen dice en particular -- con las escenas que ESTE
                    visitante cruzó, su ciclo y su señal. Sumar las dos era
                    decir lo mismo dos veces y, peor, empujaba la obra fuera de
                    su proporción: medido, la figura de RETURN quedó en una
                    banda de 90px. "Una obra jamás debería quedar achatada." */}
                <EspecimenRetorno />
                <a class="kx-os-primary" href="/kodex/store/">{sceneByFolio.cta}</a>
                <button class="kx-os-ghost" type="button" data-kdx-commission-open>COMMISSION A SYSTEM</button>
                <button class="kx-os-ghost" type="button" data-kdx-drawer-open="return">EXPLORE THE ECOSYSTEM</button>
              </div>
            )}
            {/* EL DOSSIER, PARA LAS SEIS ESCENAS.
                Sólo aparece en teléfono y en horizontal corto, que es donde el
                contrato retira el eje, la tira de volúmenes, la banda de datos
                y el rail. Estuvo un rato existiendo únicamente en PROLOGUE, y
                ese fue un error de verdad: al extender el contrato a las seis
                escenas se ocultó su densidad en móvil SIN darle destino, así
                que en cinco de las siete pantallas esa información quedaba
                inalcanzable. "Nada se pierde, se cambia de lugar" sólo es
                cierto si el lugar existe. Lo detectó el inventario de bloques,
                no una captura: hay que mirar la lista completa, no la pantalla
                que uno estaba arreglando. */}
            {/* Las escenas con panel propio -- DESCENT, ARCHIVE, MACHINE,
                COSMOLOGY, RETURN -- reciben su dossier acá, porque su acción
                primaria vive dentro del panel y no en una fila de acciones.
                PROLOGUE ya lo tiene arriba, en la misma línea que el protocolo. */}
            {platePerfil && folio !== 'i' && (
              <div class="kx-os-stage__actions kx-os-stage__actions--dossier">
                <button class="kx-os-ghost" type="button" data-kdx-plate-dossier data-kdx-drawer-open="dossier">SPECIMEN DATA</button>
              </div>
            )}
          </main>

          <figure class="kx-os-stage__art" data-kdx-art>
            <span class="kx-corner kx-corner--tl"></span><span class="kx-corner kx-corner--tr"></span>
            <span class="kx-corner kx-corner--bl"></span><span class="kx-corner kx-corner--br"></span>

            {/* El rail va DENTRO de la figura, no como hijo del escenario: el
                grid del stage tiene columnas fijas y meterle una fila nueva
                empujaba la obra fuera de la pantalla. La numeracion pertenece
                a la pieza, no al escenario. */}
            <KodexRail
              index={sceneByFolio.number}
              label={sceneByFolio.slug}
              accent={sceneByFolio.accent}
              tail={sceneByFolio.motif.toUpperCase()}
              glyph={sceneGlyph}
              compact={true}
              class="kx-os-stage__rail-top"
            />
            {/* El OJO procedural de PROLOGUE se retiro: "horrible, no era lo
                esperado" (KODEX-POLISH.md, correccion de Ocin 2026-07-29). En
                su lugar queda la obra tratada, igual que en las demas laminas. */}
            {sceneAscii && (
              <KodexAscii
                scene={sceneAscii.scene}
                glyphs={sceneAscii.glyphs}
                palette={sceneAscii.palette}
                bed={true}
                class="kx-os-stage__ascii"
              />
            )}
            {folio === 'iv' && <canvas class="kx-machine-canvas" data-machine-canvas width="720" height="720"></canvas>}
            {folio === 'iii' && (
              <img
                class="kx-archive-hero-specimen"
                src={selectedArchive.source}
                alt={`${selectedArchive.title} selected specimen`}
                decoding="async"
              />
            )}
            {folio === 'iii' && volumenes.length > 0 && (
              <KodexMuseo volumenes={volumenes} class="kx-os-stage__museo" />
            )}
            {sceneCrt && folio !== 'iii' && !organismoEscena && (
              <img
                class="kx-os-stage__crt-source"
                src={sceneByFolio.image}
                alt=""
                aria-hidden="true"
                decoding="async"
              />
            )}
            {folio === 'vi'
              ? (
                /* EL SELLO DE RETORNO, EN TINTA.
                   La obra entra como <img> y no como canvas a propósito: es la
                   única forma de que la lámina clara pueda ATRAVESARLA. El
                   `mix-blend-mode:multiply` que kodex.css ya declara para esta
                   escena necesita un elemento pintado sobre el fondo, no un
                   búfer opaco. Así el mandala negativo se invierte a trazo
                   oscuro y el papel queda debajo, que es la lámina u03. */
                <img
                  class="kx-return-mandala"
                  src={sceneByFolio.image}
                  alt="Return seal — todas las trayectorias convergen en un punto de luz"
                  decoding="async"
                />
              )
              : organismoEscena
              ? (
                /* ARTE > UI. El organismo de la lamina ocupa la region de arte
                   de la escena, en vez de la obra raster ajena que estaba. */
                <LaminaOrganismo escena={organismoEscena} class="kx-os-stage__organismo" />
              )
              : folio === 'v'
              ? <div class="kx-os-stage__cosmo"><CosmologyMap /></div>
              : sceneCrt
              ? null
              : (
                /* La obra como ARTIFACT, no como <img> plana: pixelada, con
                   dither Bayer, scanlines y glow del color de la escena. Cada
                   folio trae su pieza y su acento; el tratamiento es el mismo
                   para que las siete laminas se lean como un solo sistema. */
                <KodexArtifact
                  artwork={sceneByFolio.image}
                  accent={sceneByFolio.accent}
                  label="ARTIFACT"
                  id={`KDX-${sceneByFolio.number}`}
                  status={sceneByFolio.slug === 'archive' ? 'PRESERVED' : 'ARCHIVED'}
                  coords={`${sceneByFolio.number} · ${sceneByFolio.slug.toUpperCase()} · ${sceneByFolio.motif}`}
                  pixelSize={3}
                  dither={0.86}
                  scanlines={0.32}
                  glow={0.5}
                  chroma={0.55}
                  flicker={0.42}
                  class="kx-os-stage__artifact"
                />
              )}
            {/* TRATAMIENTO CRT — la piel de PROLOGUE.
                La tabla de distincion pide "CRT scanline + chroma" con barrido
                de scan, y el preset `observe` del kit trae su propio violeta
                [0.72 0.48 1.0], que es el acento de esta lamina. Fue escrito
                contra esta misma tabla.

                La FUENTE es la obra como <img>, no el canvas del artefacto.
                Ese canvas es WebGL sin preserveDrawingBuffer: fuera de su
                propio dibujo el buffer no se puede leer, asi que usarlo de
                textura daba negro. Activarlo cuesta rendimiento en todas las
                laminas para que sirva en una sola; la obra directa no cuesta
                nada y es la misma pieza.

                En esta lamina el CRT NO va encima del artefacto: ES el
                tratamiento. Organismo por tratamiento, uno por escena. */}
            {sceneCrt && !organismoEscena && (
              <KodexCrtLayer
                sourceSelector=".kx-os-stage__crt-source"
                preset={sceneCrt}
                quality="balanced"
                class="kx-os-stage__crt"
              />
            )}

            {/* El pie de la placa sólo cuando la placa no trae obra. El
                artefacto se rotula solo -- ARTIFACT / KDX-0n / ARCHIVED -- y
                mantener los dos dejaba dos leyendas encimadas diciendo lo
                mismo en la misma esquina. */}
            {folio === 'v' && (

            <figcaption>{sceneByFolio.number} · {sceneByFolio.slug.toUpperCase()} · {sceneByFolio.motif}</figcaption>
            )}
          </figure>

          <div class="kx-os-barcode" aria-hidden="true"><span>KDX-{sceneByFolio.number}-{sceneByFolio.slug.toUpperCase()}</span></div>
        </div>
        )}
      </section>
    </div>

    <aside class="kx-os-drawer" data-kdx-drawer hidden aria-hidden="true" role="dialog" aria-modal="true">
      <div class="kx-os-drawer__panel">
        <button class="kx-os-drawer__close" type="button" data-kdx-drawer-close>CLOSE</button>

        <section data-kdx-drawer-section="protocol">
          <p class="kx-os-stage__kicker">PROTOCOL · OBSERVATION</p>
          <h2>The archive observes relation, not identity.</h2>
          <p>KODEX records sequence, choice, state and attention. Audio is opt-in. Motion respects reduced mode. The visitor remains a signal, never a target.</p>
        </section>

        {/* DOSSIER — el destino de lo que el contrato retira del teléfono:
            el eje, la tira de volúmenes, la banda de datos y la procedencia
            de la obra. Mismos datos, otro lugar. Nada se borró. */}
        <section data-kdx-drawer-section="dossier">
          <p class="kx-os-stage__kicker">{sceneByFolio.number} · {sceneByFolio.slug.toUpperCase()} · DOSSIER</p>
          <h2>{sceneByFolio.title}</h2>
          <dl>
            {stripRows.map((r) => <div><dt>{r.k}</dt><dd>{r.v}</dd></div>)}
            <div><dt>MOTIF</dt><dd>{sceneByFolio.motif.toUpperCase()}</dd></div>
            <div><dt>DEPTH</dt><dd>{idx + 1} / 7</dd></div>
            <div><dt>PLATE</dt><dd>{plateIdent}</dd></div>
            <div><dt>PROVENANCE</dt><dd>Ocin / Wenu Mapu</dd></div>
          </dl>
          {volumenesDelEstrato.length > 0 && (
            <>
              <p class="kx-os-stage__kicker">BELOW THIS SCENE</p>
              <nav class="kx-return-routes">
                {volumenesDelEstrato.map((v) => <a href={`/kodex/volumen/${v.slug}/`}>{v.titulo ?? v.slug}</a>)}
              </nav>
            </>
          )}
        </section>

        <section data-kdx-drawer-section="specimen">
          <p class="kx-os-stage__kicker">SPECIMEN DOSSIER</p>
          <img src={selectedArchive.source} alt={`${selectedArchive.title} complete specimen`} />
          <dl>
            <div><dt>TITLE</dt><dd>{selectedArchive.title}</dd></div>
            <div><dt>YEAR</dt><dd>{selectedArchive.year}</dd></div>
            <div><dt>TECHNIQUE</dt><dd>{selectedArchive.method}</dd></div>
            <div><dt>TYPE</dt><dd>{selectedArchive.type}</dd></div>
            <div><dt>GENEALOGY</dt><dd>{selectedArchive.relation}</dd></div>
            <div><dt>PROVENANCE</dt><dd>Ocin / Wenu Mapu</dd></div>
            <div><dt>CODE</dt><dd>{selectedArchive.code}</dd></div>
            <div><dt>EDITION</dt><dd>{selectedArchive.status}</dd></div>
          </dl>
          <a class="kx-os-primary" href="/kodex/store/">COLLECT A FRAGMENT</a>
        </section>

        <section data-kdx-drawer-section="machine">
          <p class="kx-os-stage__kicker">MACHINE OUTPUT</p>
          <div class="kx-machine-output" data-machine-output>
            <p>KDX-GEN-0000 · SEED A90C-73F1 · SOURCE ACHROMA_006 · METHOD MIRROR/DITHER/FLOW · STATUS READY</p>
          </div>
          <a class="kx-os-primary" href="mailto:marimari@wenumapuonline.com?subject=KODEX%20Signal%20Request">REQUEST THIS PIECE</a>
        </section>

        <section data-kdx-drawer-section="return">
          <p class="kx-os-stage__kicker">RETURN ROUTES</p>
          <nav class="kx-return-routes">
            <a href="/kodex/store/">License a Signal</a>
            <a href="/">Explore Wenu Mapu</a>
            <a href="mailto:marimari@wenumapuonline.com?subject=Soma%20route">Explore Soma</a>
            <a href="mailto:marimari@wenumapuonline.com?subject=Cosmic%20Serpent%20route">Explore Cosmic Serpent</a>
            <a href="/kodex/" data-kdx-restart>Restart Journey</a>
          </nav>
        </section>
      </div>
    </aside>

    <script type="application/json" id="kdx-strata-data" set:html={JSON.stringify(specimens)}></script>
    <script type="application/json" id="kdx-cosmos-data" set:html={JSON.stringify(cosmoNodes)}></script>
    <KodexOverlays gallery={false} />
  </div>

  <script>
  /* LAS TRES PIEZAS DEL CORREDOR, MONTADAS Y NO REESCRITAS.
     Las tres existen ya y las escribió el agente que lleva el descenso; acá
     sólo se enchufan a las escenas del folio, que hasta ahora se las perdían:
     el corredor tenía el túnel, el orden de llegada y el sonido corriendo en
     las láminas y en ningún folio.

     `montarTravesia`  el feedback pass de verdad. Escucha el mismo contrato
                       que ya emitía el runtime -- data-kdx-travesia en
                       [data-deck] -- así que reemplaza mi CSS de transform y
                       blur sin tocar quien lo dispara.
     `montarFases`     silencio → entrada → revelación → movimiento →
                       descubrimiento. Las cosas llegan en orden en vez de
                       todas juntas, que es el diagnóstico del manifiesto:
                       "algunos instrumentos están tocando todos al mismo
                       tiempo".
     `montarSonido`    el motor del prototipo. Nunca arranca solo: respeta la
                       elección que el visitante tomó en la puerta. */
  import { montarTravesia } from '../../../lib/kodex/travesia';
  import { montarFases } from '../../../lib/kodex/estado';
  import { montarSonido } from '../../../lib/kodex/sonido-montar';

  const montarCorredor = () => {
    try { montarTravesia(); } catch (_) {}
    try { montarFases(); } catch (_) {}
    try { montarSonido(); } catch (_) {}
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', montarCorredor, { once: true });
  else montarCorredor();
  document.addEventListener('astro:page-load', montarCorredor);

    import { initKx } from '../../../scripts/kodex-engine.js';
    initKx();

    const drawer = document.querySelector('[data-kdx-drawer]');
    const drawerSections = [...document.querySelectorAll('[data-kdx-drawer-section]')];
    const openDrawer = (name) => {
      drawerSections.forEach((s) => { s.hidden = s.getAttribute('data-kdx-drawer-section') !== name; });
      drawer.hidden = false;
      drawer.setAttribute('data-open', '');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };
    const closeDrawer = () => {
      drawer?.removeAttribute('data-open');
      drawer?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => { if (drawer) drawer.hidden = true; }, 220);
    };
    document.querySelectorAll('[data-kdx-drawer-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.getAttribute('data-kdx-drawer-open');
        openDrawer(name);
        try { window.kdx && window.kdx('artwork_open', { section: name }); } catch (_) {}
      });
    });
    document.querySelector('[data-kdx-drawer-close]')?.addEventListener('click', closeDrawer);
    drawer?.addEventListener('click', (e) => { if (e.target === drawer) closeDrawer(); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer && !drawer.hidden) closeDrawer(); });

    const folioActual = document.querySelector('[data-kdx-folio]')?.getAttribute('data-kdx-folio')
      || (location.pathname.match(/\/folio\/([^/]+)\//) || [])[1] || '';
    const strata = JSON.parse(document.getElementById('kdx-strata-data')?.textContent || '[]');
    let stratumIndex = 0;
    const paintStratum = () => {
      const s = strata[stratumIndex]; if (!s) return;
      const pad = String(stratumIndex + 1).padStart(2, '0');
      document.querySelector('[data-stratum-count]')?.replaceChildren(`STRATUM · ${pad} / ${String(strata.length).padStart(2, '0')}`);
      document.querySelector('[data-stratum-depth]')?.replaceChildren(`DEPTH · -${137 + stratumIndex * 89} M`);
      document.querySelector('[data-stratum-title]')?.replaceChildren(s.name);
      document.querySelector('[data-stratum-read]')?.replaceChildren(s.read);
      /* EL MOTOR DE ESTRATOS SÓLO PINTA LA OBRA EN DESCENT.
         Acá estaba la razón de que las siete escenas se parecieran, y no eran
         las tablas de asignación: `paintStratum()` se llamaba sin condición al
         final del script, en LOS SEIS folios. Los estratos se emiten en todos
         -- son los 11 especímenes -- así que `strata[0]` es bw-01 y todas las
         escenas terminaban mostrando la misma obra, pisando lo que declaraban
         `sceneByFolio` y la tabla de fundición.

         Comprobado en navegador: PROLOGUE, DESCENT, MACHINE y RETURN servían
         `bw-01.jpg` mientras su HTML decía otra cosa. Dos tablas cambiadas no
         movieron un pixel hasta encontrar esto.

         El recorrido de estratos es de DESCENT. En las demás escenas la obra la
         decide su propia declaración y nadie la toca. */
      if (folioActual === 'ii') {
        const art = document.querySelector('[data-kdx-art] img');
        if (art) art.src = `/img/kodex/works/${s.file}.jpg`;
      }
    };
    document.querySelector('[data-stratum-next]')?.addEventListener('click', () => {
      stratumIndex = (stratumIndex + 1) % strata.length;
      paintStratum();
      try { window.kdx && window.kdx('next_scene', { kind: 'stratum', index: stratumIndex }); } catch (_) {}
    });
    paintStratum();

    const canvas = document.querySelector('[data-machine-canvas]');
    const ctx = canvas?.getContext?.('2d');
    let gen = 0;
    const drawMachine = (seed = 'A90C-73F1') => {
      if (!ctx || !canvas) return;
      const w = canvas.width, h = canvas.height, cx = w / 2, cy = h / 2;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#080808'; ctx.fillRect(0, 0, w, h);
      ctx.strokeStyle = 'rgba(0,239,255,.55)'; ctx.lineWidth = 1;
      for (let r = 72; r < 310; r += 38) {
        ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.stroke();
      }
      ctx.strokeStyle = 'rgba(230,230,230,.72)';
      for (let i = 0; i < 32; i++) {
        const a = i / 32 * Math.PI * 2 + gen * .08;
        const r1 = 68 + (i % 5) * 12;
        const r2 = 292 - (i % 7) * 10;
        ctx.beginPath();
        ctx.moveTo(cx + Math.cos(a) * r1, cy + Math.sin(a) * r1);
        ctx.lineTo(cx + Math.cos(a + Math.sin(i + gen) * .28) * r2, cy + Math.sin(a + Math.cos(i + gen) * .22) * r2);
        ctx.stroke();
      }
      ctx.fillStyle = '#00D8FF'; ctx.fillRect(cx - 5, cy - 5, 10, 10);
      ctx.fillStyle = '#E6E6E6'; ctx.font = '18px monospace'; ctx.fillText(seed, 28, h - 34);
    };
    const nextSeed = () => Array.from({ length: 2 }, () => Math.floor(Math.random() * 65535).toString(16).toUpperCase().padStart(4, '0')).join('-');
    document.querySelector('[data-machine-generate]')?.addEventListener('click', () => {
      gen += 1;
      const seed = nextSeed();
      const id = `KDX-GEN-${String(1000 + gen).padStart(4, '0')}`;
      const state = document.querySelector('[data-machine-state]');
      const seedEl = document.querySelector('[data-machine-seed]');
      const output = document.querySelector('[data-machine-output]');
      state?.replaceChildren('GENERATING');
      try { window.kdx && window.kdx('generator_start', { id }); } catch (_) {}
      setTimeout(() => {
        state?.replaceChildren('COMPLETE');
        seedEl?.replaceChildren(seed);
        drawMachine(seed);
        output?.replaceChildren(`${id} · SEED ${seed} · SOURCE ACHROMA_006 · METHOD MIRROR/DITHER/FLOW · STATUS COMPLETE`);
        try { window.kdx && window.kdx('generator_complete', { id, seed }); } catch (_) {}
      }, 620);
    });
    drawMachine();

    const nodes = JSON.parse(document.getElementById('kdx-cosmos-data')?.textContent || '[]');
    let nodeIndex = 1;
    document.querySelector('[data-cosmo-next]')?.addEventListener('click', () => {
      nodeIndex = (nodeIndex + 1) % nodes.length;
      const node = nodes[nodeIndex];
      document.querySelector('[data-cosmo-node]')?.replaceChildren(`NODE · ${node.toUpperCase()}`);
      document.querySelector('[data-cosmo-state]')?.replaceChildren(node === 'KODEX' ? 'STATE · SOURCE' : 'STATE · LINKED');
      document.querySelector('[data-cosmo-relation]')?.replaceChildren(`DOMAIN · BODY / MATTER / MEMORY`, document.createElement('br'), `RELATION · ${node === 'Machine' ? 'PROCESSING' : '+∞'}`);
      try { window.kdx && window.kdx('outbound_cosmo', { node }); } catch (_) {}
    });
  </script>
  <!-- LA MÁQUINA DEL KODEX. El creador, 2026-08-20: "hasta ahora uno va hacia
       el lado y necesitamos que vaya hacia dentro, y que las 7 escenas se
       ramifiquen hasta encontrar al medio el corazón". El botón NEXT lateral
       de esta misma escena sigue donde estaba: nada se borró, se agregó una
       dirección que no existía. -->
  <Descenso escena={folio} etiqueta={sceneByFolio.slug.toUpperCase()} />
  <CommissionForm />
</Base>

<style>
/* ═══════════════════════════════════════════════════════════════════════════
   VII · RETURN — LA LÁMINA CLARA, DEVUELTA A PAPEL
   ═══════════════════════════════════════════════════════════════════════════

   Este bloque existe porque `kodex.css` es propiedad de otro nodo y no se
   toca. Todo lo de acá está acotado a `.kx-os-scene--return`: en las otras
   cinco escenas del corredor no matchea ni una regla.

   El defecto que cierra: RETURN se servía con la croma prestada de otras dos
   escenas. Medido sobre la captura de 1440×900 antes del cambio:
     · hue 165-180° (cian, croma de MACHINE) ....... 5.050 muestras
     · hue 75°      (ácido, croma de ARCHIVE) ...... 2.307 muestras
     · hue 255-285° (lavanda, croma PROPIA) ........ 0 muestras
     · papel (neutro claro >200) ................... 37,3% del cuadro
   Medido sobre su lámina de autoridad `u03-return.png`:
     · papel ....................................... 94,9% del cuadro
     · tinta dominante ............................. hue 270°, #9078A8
     · segundo acento .............................. hue 15-30°, cálido

   La especificidad va a (0,2,0) a propósito -- `.kx.kx-os-scene--return` --
   porque las reglas que corrige en `kodex.css` son (0,1,0) y el orden de
   bundling entre la hoja importada y el estilo de página no está garantizado.
   Ganar por especificidad es determinista; ganar por orden es una apuesta. */

/* El halo de fondo estaba escrito con `rgba(166,255,0,.26)` — verde ácido
   literal, hardcodeado. Es el único acento cromático a escala de pantalla de
   toda la escena, así que mientras siguiera ahí no importaba qué declarara la
   tabla de folios: la lámina leía ácida igual. */
.kx.kx-os-scene--return::before{
  background:
    radial-gradient(circle at 70% 42%,
      color-mix(in srgb, var(--kdx-return-ink,#7C5FA0) 22%, transparent), transparent 34vw),
    radial-gradient(circle at 70% 42%,
      color-mix(in srgb, var(--kdx-return-gold,#BE8C50) 26%, transparent), transparent 18vw),
    radial-gradient(circle at 70% 42%,
      transparent 0 9vw,
      color-mix(in srgb, var(--kdx-return-ink,#7C5FA0) 34%, transparent) 9.2vw 9.45vw,
      transparent 28vw);
}

/* LA HOJA. `.kx-os-stage--return .kx-os-stage__art{background:#f3f3f3}` ya
   estaba escrita en kodex.css:1338 y nunca se aplicó: el markup ponía
   `kx-os-scene--return` en la raíz pero nadie ponía `kx-os-stage--return` en
   el escenario. Ahora la clase existe (ver el template) y la regla despierta;
   acá sólo se le quita el chrome que la delataba como caja de HUD -- el borde
   de tinta clara, la sombra proyectada negra y el resplandor de acento -- que
   sobre papel se leen como un recuadro pegado encima de la hoja. */
.kx.kx-os-scene--return .kx-os-stage__art{
  background:#F2EFE7;                 /* crema de la lámina, no gris de sistema */
  border-color:color-mix(in srgb, var(--kdx-return-ink,#7C5FA0) 20%, transparent);
  box-shadow:none;
}

/* El barrido de scanlines venía en `mix-blend-mode:screen`, que sobre negro
   dibuja una trama de CRT y sobre papel sólo lava el blanco. Es chrome técnico
   en la única escena cuyo ADN dice explícitamente que no lo lleva. */
.kx.kx-os-scene--return .kx-os-stage__art::after{
  opacity:.1;
  mix-blend-mode:multiply;
  background:repeating-linear-gradient(0deg,
    color-mix(in srgb, var(--kdx-return-ink,#7C5FA0) 12%, transparent) 0 1px,
    transparent 1px 5px);
}

/* Las escuadras de encuadre pasan de gris-HUD a tinta lavanda tenue: siguen
   registrando la obra, dejan de parecer visor. */
.kx.kx-os-scene--return .kx-corner{
  border-color:color-mix(in srgb, var(--kdx-return-ink,#7C5FA0) 38%, transparent);
  opacity:.5;
}

/* EL SELLO DE RETORNO.
   `invert(1)` sobre el mandala negativo lo devuelve a trazo oscuro; `multiply`
   deja pasar el papel por debajo en vez de tapiarlo, que es la diferencia
   entre una lámina impresa y una pantalla incrustada. El `sepia+hue-rotate`
   tiñe el trazo hacia el lavanda medido en la lámina en lugar de dejarlo en
   gris neutro. Se declara acá y no se delega a kodex.css:1345 porque esa
   regla es (0,2,0) sobre `img` genérico y necesito además la tinta. */
.kx.kx-os-scene--return .kx-os-stage__art .kx-return-mandala{
  width:100%; height:100%;
  object-fit:contain;
  padding:clamp(10px,2.2vw,26px);
  box-sizing:border-box;
  mix-blend-mode:multiply;
  filter:
    grayscale(1) invert(1) contrast(1.16)
    sepia(.55) hue-rotate(215deg) saturate(2.6)
    opacity(.92);
}

/* ───────────────────────────────────────────────────────────────────────────
   EL CHROME QUE SEGUÍA SIENDO NOCTURNO
   ───────────────────────────────────────────────────────────────────────────
   Estas tres piezas las dibujan componentes hijos, así que el scoping de Astro
   no las alcanza y hay que nombrarlas con `:global()`. El ancestro
   `.kx-os-scene--return` las mantiene encerradas en esta única escena: en las
   otras cinco del corredor el selector no matchea.

   No es maquillaje. `kodex.css` ya había invertido el COLOR DE TEXTO de este
   chrome para RETURN (líneas 3632-3641) pero no sus FONDOS, así que quedó
   tinta oscura sobre banda negra. Medido en 1440×900: la franja `.kx-status`
   pinta `linear-gradient(#000 60%, transparent)` mientras su texto computa
   `rgba(18,18,18,.78)` — contraste ~1.1:1, ilegible; y `.kdx-strip` pinta
   `rgb(17,17,19)` con texto `rgb(8,8,8)` encima. El arreglo devuelve los
   fondos al papel y con eso el texto que ya era oscuro vuelve a leerse. */

/* La banda superior. Es el scrim que sostiene el wordmark y la telemetría:
   sobre seis escenas negras desaparece, sobre la única de papel es una barra
   negra atravesando la hoja. */
.kx.kx-os-scene--return :global(.kx-status){
  background-image:linear-gradient(
    color-mix(in srgb, var(--kdx-paper,#F2EFE7) 92%, transparent) 55%,
    transparent);
}

/* El panel de instrumento. Se conserva entero -- mismos datos, mismo lugar --
   pero impreso: hoja, filete de tinta lavanda y nada de resplandor. */
.kx.kx-os-scene--return :global(.kdx-strip){
  background-color:color-mix(in srgb, var(--kdx-paper,#F2EFE7) 88%, transparent);
  background-image:linear-gradient(
    color-mix(in srgb, var(--kdx-return-ink,#7C5FA0) 6%, transparent),
    transparent);
  border-color:color-mix(in srgb, var(--kdx-return-ink,#7C5FA0) 26%, transparent);
  box-shadow:none;
}

/* El rail de la obra traía un velo del acento al 4%. Con el acento corregido
   ya no es ácido, pero sobre papel cualquier velo lee como sucio: se retira. */
.kx.kx-os-scene--return :global(.kdx-rail){
  background:transparent;
  border-color:color-mix(in srgb, var(--kdx-return-ink,#7C5FA0) 22%, transparent);
}

/* Los dos elementos que el scrim negro venía TAPANDO.
   Al devolver la banda a papel quedan expuestos, y los dos estaban escritos
   para fondo oscuro: el wordmark en `rgb(237,237,237)` — contraste 1.03:1
   sobre #F2EFE7, literalmente invisible — y el botón de cruce en
   `rgb(183,255,0)` sobre `rgba(0,0,0,.45)`, que es OTRA vez el verde ácido de
   ARCHIVE, esta vez hardcodeado (no pasa por `--kdx-acid`, así que el cambio
   de la tabla de folios no lo alcanza). Son parte del mismo defecto: chrome
   nocturno servido sobre la única lámina de papel. */
.kx.kx-os-scene--return :global(.kx-word){
  color:#141414;                      /* 15,8:1 sobre el papel */
}
/* La barra de cruce entera, no sólo la píldora del medio: dejar una clara
   entre dos oscuras es peor que las tres oscuras. PREVIOUS e INDEX ya traían
   tinta oscura (`rgb(8,8,8)`, invertida por kodex.css) sobre una píldora
   `rgba(0,0,0,.45)`; se les cambia el fondo, no el texto. */
.kx.kx-os-scene--return :global(.kx-deckbar button),
.kx.kx-os-scene--return :global(.kx-deckbar a),
.kx.kx-os-scene--return :global(.kx-deckbar__index){
  color:#2A2140;
  background:color-mix(in srgb, var(--kdx-paper,#F2EFE7) 74%, transparent);
  border-color:color-mix(in srgb, var(--kdx-return-ink,#7C5FA0) 30%, transparent);
}
.kx.kx-os-scene--return :global(.kx-deckbar--turn){
  color:#2A2140;                      /* 12,9:1 sobre el papel */
  background:color-mix(in srgb, var(--kdx-paper,#F2EFE7) 82%, transparent);
  border-color:color-mix(in srgb, var(--kdx-return-ink,#7C5FA0) 55%, transparent);
}

/* EL PANEL DE DATOS, IMPRESO.
   Al devolverle el fondo a papel quedaban invisibles justo los VALORES: los
   `dd` computan `rgb(237,237,237)` — 1,02:1 sobre #F2EFE7 — y el título y el
   valor del medidor vienen en `rgb(183,255,0)`, verde ácido hardcodeado (otra
   vez fuera de `--kdx-acid`, así que la tabla de folios no los alcanza).
   Cambiar el fondo sin la tinta habría borrado NODE/STATE/PATTERN/NEXT: el
   contrato permite mover la telemetría, no perderla. */
.kx.kx-os-scene--return :global(.kdx-strip dd){ color:#1E1A2E; }   /* 14,7:1 */
.kx.kx-os-scene--return :global(.kdx-strip dt),
.kx.kx-os-scene--return :global(.kdx-strip .kdx-strip__meter-head),
.kx.kx-os-scene--return :global(.kdx-strip .kdx-strip__meter-head span){ color:#5A5468; }  /* 6,3:1 */
.kx.kx-os-scene--return :global(.kdx-strip .kdx-strip__title),
.kx.kx-os-scene--return :global(.kdx-strip .kdx-strip__meter-val){ color:#6B4F96; }        /* 5,7:1, croma propia */

/* Sin movimiento sigue siendo una lámina: el sello se queda quieto, no
   desaparece. (El filtro no anima, así que sólo se fija el blend.) */
@media (prefers-reduced-motion: reduce){
  .kx.kx-os-scene--return .kx-os-stage__art .kx-return-mandala{ filter:
    grayscale(1) invert(1) contrast(1.16)
    sepia(.55) hue-rotate(215deg) saturate(2.6)
    opacity(.92); }
}
</style>
