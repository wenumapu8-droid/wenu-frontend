---
// KODEX−∞ · THE FOLIOS — slide decks, NOT scrolling pages (owner: "como
// diapositivas... con botones"). Each part of KODEX is a separate full-screen
// plate; the NEXT button dives INTO the codex (depth transition, no scroll).
// The deck control bar (KodexChrome) is the UX: ‹ BACK · 03/13 · NEXT › · ◉ INDEX.
// From the cover's index ring you can jump to any folio at will.
// Folio VI ends in the +∞ WHITE: the codex inverts when the journey completes.
import Base from '../../../layouts/Base.astro';
import KodexChrome from '../../../components/KodexChrome.astro';
import KodexOverlays from '../../../components/KodexOverlays.astro';
import KodexCell from '../../../components/KodexCell.astro';
import '../../../styles/kodex.css';
import {
  hero, specimens, families, discoWorks, archThemes, chapters, folios, organs, sigilSvg,
} from '../../../lib/kodexBook.js';

export function getStaticPaths() {
  return [
    { params: { folio: 'i' } },   { params: { folio: 'ii' } },  { params: { folio: 'iii' } },
    { params: { folio: 'iv' } },  { params: { folio: 'v' } },   { params: { folio: 'vi' } },
  ];
}

const { folio } = Astro.params;
const idx = folios.findIndex((f) => f.slug === folio);
const F = folios[idx];
const prev = idx > 0 ? folios[idx - 1] : null;
const next = idx < folios.length - 1 ? folios[idx + 1] : null;
const prevUrl = prev ? `/kodex/folio/${prev.slug}/` : '/kodex/';
const nextUrl = next ? `/kodex/folio/${next.slug}/` : '/kodex/';
const nextLabel = next ? `FOLIO ${next.n} · ${next.name.toUpperCase()} ›` : '↺ COVER · −∞';

const CHAP = { i: chapters.prologue, ii: chapters.descent, iii: chapters.archive,
  iv: chapters.machine, v: chapters.cosmology, vi: chapters.geometry }[folio];

// remixed strips — works woven between the plates of each presentation
const stripFor = {
  i: families.slice(0, 3),
  iv: [families[3], families[5], families[9], discoWorks[2]],
  v: discoWorks.slice(0, 3),
}[folio] || [];

const og = { i:'bw-06', ii:'bw-01', iii:'bw-04', iv:'bw-07', v:'bw-05', vi:'bw-11' }[folio];
---

<Base
  title={`Folio ${F.n} · ${F.name} — KODEX−∞`}
  description={`KODEX−∞, folio ${F.n} — ${F.lede}`}
  robots="noindex, nofollow"
  ogImage={`/img/kodex/works/${og}.jpg`}
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div
    class={`kx kx--deck kx-folio kx-folio--${folio}`} data-kx
    data-stage-idx={idx + 2} data-stage-name={F.stage} data-stage-col={F.col}
    data-prev-url={prevUrl} data-next-url={nextUrl} data-next-label={nextLabel}
    style={`--acc:${F.acc}`}
  >
    <KodexChrome segs={7} />

    <div class="kx-deck" data-deck>

      <!-- PLATE 1 — folio opening: eyebrow + sigil + typed terminal -->
      <section class="kx-slide">
        <div class="kx-slide__in">
          <p class="kx-folio-eyebrow">FOLIO <b>{F.n} / VI</b> · {F.lede.toUpperCase()}</p>
          <div class="kx-chapter kx-chapter--head" data-reveal>
            <div class="kx-chapter__sigil" set:html={sigilSvg(CHAP.seed)}></div>
            <p class="kx-chapter__n">CHAPTER {CHAP.n}</p>
            <h1 class="kx-chapter__t">{CHAP.title}</h1>
            <pre class="kx-chapter__term" data-term={CHAP.term}></pre>
          </div>
          <p class="kx-descend-cue" style="text-align:center" aria-hidden="true">NEXT › GOES DEEPER</p>
        </div>
      </section>

      {folio === 'i' && (
        <>
          <section class="kx-slide kx-slide--art" style="--art:url(/img/kodex/works/bw-02.jpg)">
            <div class="kx-slide__in">
              <section class="kx-prologue" id="prologue">
                <div class="kx-prologue__body" data-reveal>
                  <p>You hold a codex that was never finished — and never will be. It descends before it rises.</p>
                  <p>What follows is not meant to be understood at once. It is meant to be crossed. Each layer opens another, older and less personal, until what you find stops being yours and becomes everyone's.</p>
                  <p>The work is black and white first — the sacred binary, shadow and light. Then grey, the space between states. Then colour, where the signal manifests. Between them: the numbers, the code, the geometry that hold it together.</p>
                  <p class="kx-prologue__sign">Descend · integrate · return. −∞ → 0 → +∞.</p>
                </div>
              </section>
            </div>
          </section>
          <section class="kx-slide">
            <div class="kx-slide__in">
              <section class="kx-umbral">
                <div class="kx-frame kx-frame--hero" data-spec>
                  <span class="kx-bracket kx-bracket--tl"></span><span class="kx-bracket kx-bracket--tr"></span>
                  <span class="kx-bracket kx-bracket--bl"></span><span class="kx-bracket kx-bracket--br"></span>
                  <span class="kx-scan"></span>
                  <img src={hero.src} alt={`KODEX−∞ — ${hero.name}, complete work`} loading="eager" />
                  <span class="kx-frame__tag">SPECIMEN 00 · {hero.name}</span>
                </div>
                <p class="kx-cta-note" data-reveal>First glimpse of the archive. The full descent begins on the next folio.</p>
              </section>
            </div>
          </section>
        </>
      )}

      {folio === 'ii' && specimens.map((s, i) => (
        <section class="kx-slide">
          <div class="kx-slide__in">
            <section class="kx-specimen" id={`estrato-${s.i}`} data-seg={i}>
              <div class="kx-meta" data-reveal>
                <span class="kx-meta__idx">STRATUM {s.i}</span>
                <span class="kx-meta__portal">{s.portal}</span>
                <h2 class="kx-meta__name">{s.name}</h2>
                <p class="kx-meta__read">{s.read}</p>
                <ul class="kx-meta__tags">{s.tags.map((t) => <li>{t}</li>)}</ul>
                <span class="kx-meta__hash">RES · 2048px · SACRED BINARY</span>
              </div>
              <div class="kx-frame" data-spec data-reveal>
                <span class="kx-bracket kx-bracket--tl"></span><span class="kx-bracket kx-bracket--tr"></span>
                <span class="kx-bracket kx-bracket--bl"></span><span class="kx-bracket kx-bracket--br"></span>
                <span class="kx-scan"></span>
                <img src={`/img/kodex/works/${s.file}.jpg`} alt={`KODEX−∞ — ${s.name}, complete work`} loading="lazy" />
                <span class="kx-frame__tag">SPECIMEN {String(i + 1).padStart(2, '0')} · {s.name}</span>
              </div>
            </section>
          </div>
        </section>
      ))}

      {folio === 'iii' && (
        <>
          {archThemes.map((t, ti) => (
            <section class="kx-slide">
              <div class="kx-slide__in">
                <section
                  class={`kx-full kx-theme kx-theme--${t.key}`}
                  id={ti === 0 ? 'archivo-completo' : `arch-${t.key}`}
                  style={`--acc:${t.acc}`}
                >
                  <div class="kx-movement" data-reveal>
                    <span class="kx-movement__n">{t.roman.toUpperCase()} · {t.tag}</span>
                    <h2 class="kx-movement__t">{t.name}</h2>
                    <p class="kx-movement__d">{t.desc} <span class="kx-theme__ct">{t.fams.length} works</span></p>
                  </div>
                  <div class="kx-grid">
                    {t.fams.map((fam) => <KodexCell fam={fam} />)}
                  </div>
                </section>
              </div>
            </section>
          ))}
          <section class="kx-slide">
            <div class="kx-slide__in">
              <section class="kx-umbral">
                <div class="kx-cta-row" data-reveal>
                  <button class="kx-cta kx-cta--walk" type="button" data-gallery-open><span>◲ WALK THE GALLERY</span></button>
                </div>
                <p class="kx-cta-note" data-reveal>Every work is one form with many readings. Tap any plate to read it through the machine.</p>
              </section>
            </div>
          </section>
        </>
      )}

      {folio === 'iv' && (
        <>
          <section class="kx-slide">
            <div class="kx-slide__in">
              <section class="kx-machine" id="estrato-maquina">
                <div class="kx-code" data-reveal>
                  <div class="kx-code__bar">
                    <span data-shader-name>MACHINE // spiral.glsl</span>
                    <span class="kx-code__stat"><b data-shader-status>COMPILING…</b> · <span data-fps>00</span> FPS</span>
                  </div>
                  <div class="kx-channels" data-channels></div>
                  <pre class="kx-code__body"><code data-shader-src></code></pre>
                  <p class="kx-code__cap">Generative geometry born from the philosophy — not borrowed. B/W by default; the SIGNAL reveals the gold. Move the cursor.</p>
                </div>
                <div class="kx-frame kx-frame--live" data-spec data-reveal>
                  <span class="kx-bracket kx-bracket--tl"></span><span class="kx-bracket kx-bracket--tr"></span>
                  <span class="kx-bracket kx-bracket--bl"></span><span class="kx-bracket kx-bracket--br"></span>
                  <canvas data-shader-canvas></canvas>
                  <span class="kx-frame__tag">SPECIMEN ∞ · GENERATIVE SIGNAL</span>
                </div>
              </section>
            </div>
          </section>
          <section class="kx-slide">
            <div class="kx-slide__in">
              <section class="kx-atelier" id="atelier">
                <div class="kx-movement" data-reveal>
                  <span class="kx-movement__n">THE MACHINE'S OWN HAND</span>
                  <h2 class="kx-movement__t">Atelier</h2>
                  <p class="kx-movement__d">The machine studied your tools — mirror, pixel, glitch, dither, chroma — and now makes work with them. Each piece is new, alive, never made twice.</p>
                </div>
                <div class="kx-atelier__stage" data-reveal>
                  <figure class="kx-frame kx-frame--live kx-atelier__frame">
                    <span class="kx-bracket kx-bracket--tl"></span><span class="kx-bracket kx-bracket--tr"></span>
                    <span class="kx-bracket kx-bracket--bl"></span><span class="kx-bracket kx-bracket--br"></span>
                    <canvas data-atelier-canvas></canvas>
                    <span class="kx-frame__tag" data-atelier-sig>KODEX·MACHINE</span>
                  </figure>
                  <div class="kx-atelier__panel">
                    <p class="kx-atelier__label">METHOD · your tools, the machine's hand</p>
                    <p class="kx-atelier__recipe" data-atelier-recipe>—</p>
                    <p class="kx-atelier__src" data-atelier-src>source · —</p>
                    <button class="kx-atelier__btn" type="button" data-atelier-next>◇ LET IT MAKE ANOTHER</button>
                    <p class="kx-atelier__note">Authored by the machine · a possibility given form · it belongs to no one, and to all.</p>
                  </div>
                </div>
              </section>
            </div>
          </section>
        </>
      )}

      {folio === 'v' && (
        <>
          <section class="kx-slide kx-slide--art" style="--art:url(/img/kodex/disco/disco-01.jpg)">
            <div class="kx-slide__in">
              <section class="kx-cosmo" id="cosmologia">
                <div class="kx-movement" data-reveal>
                  <span class="kx-movement__n">COSMOLOGY</span>
                  <h2 class="kx-movement__t">Ritual Archeofuturism</h2>
                  <p class="kx-movement__d">The body is not adorned. It is activated. Deep memory, to design the sacred forms of the future.</p>
                </div>
                <div class="kx-triad">
                  <div class="kx-triad__c" data-reveal>
                    <span class="kx-triad__sym">−∞</span>
                    <h3>DESCENT</h3>
                    <p>Shadow · memory · roots · the mineral world. The dissolution of form. The way inward and down.</p>
                  </div>
                  <div class="kx-triad__c kx-triad__c--zero" data-reveal>
                    <span class="kx-triad__sym">0</span>
                    <h3>PORTAL</h3>
                    <p>The centre · the body · the fertile void. The instant something changes state. Not absence — possibility.</p>
                  </div>
                  <div class="kx-triad__c" data-reveal>
                    <span class="kx-triad__sym">+∞</span>
                    <h3>MANIFESTATION</h3>
                    <p>Creation · cosmos · embodied identity. What returns to the world as jewel, image, experience or act.</p>
                  </div>
                </div>
                <div class="kx-formula" data-reveal>
                  <p class="kx-formula__eq">K<sub>n+1</sub> = ( R ∘ M ∘ T ∘ E )( K<sub>n</sub> )</p>
                  <p class="kx-formula__flow">EXCAVATE → TRANSMUTE → MANIFEST → RETURN</p>
                  <p class="kx-formula__sig">↺ [ −∞ → 0 → +∞ → −∞ ]</p>
                </div>
              </section>
            </div>
          </section>
          <section class="kx-slide kx-slide--art" style="--art:url(/img/kodex/archive/arch-15.jpg)">
            <div class="kx-slide__in">
              <section class="kx-cosmo">
                <div class="kx-movement" data-reveal>
                  <span class="kx-movement__n">THE FIVE PRINCIPLES</span>
                  <h2 class="kx-movement__t">Doctrine</h2>
                </div>
                <ol class="kx-principles" data-reveal>
                  <li><b>The body is territory</b> — each piercing a coordinate; each jewel a constellation.</li>
                  <li><b>Matter holds memory</b> — stone, metal, fossil: the deep time of the Earth.</li>
                  <li><b>The symbol is an interface</b> — condensed form of experience, memory and meaning.</li>
                  <li><b>Technology can be ritual again</b> — sensitive, ceremonial, bound to life.</li>
                  <li><b>Total work of art</b> — jewel, skin, image, sound, code: doors to one universe.</li>
                </ol>
              </section>
            </div>
          </section>
          <section class="kx-slide">
            <div class="kx-slide__in">
              <section class="kx-geo" id="flow">
                <div class="kx-movement" data-reveal>
                  <span class="kx-movement__n">FLOW FIELD</span>
                  <h2 class="kx-movement__t">Inhale · Exhale</h2>
                  <p class="kx-movement__d">A vortex with a central pull. The SIGNAL flips its sign — the field breathes. Matter that responds. −∞ → 0 → +∞.</p>
                </div>
                <div class="kx-geo__stage" data-reveal>
                  <canvas data-flow-canvas></canvas>
                  <span class="kx-geo__o" aria-hidden="true"></span>
                </div>
                <p class="kx-geo__thm" data-reveal>E 00 → T 01 → M 11 → R 10 → 00 &nbsp;·&nbsp; <span>Gray code — one bit per step</span></p>
              </section>
            </div>
          </section>
        </>
      )}

      {folio === 'vi' && (
        <>
          <section class="kx-slide">
            <div class="kx-slide__in">
              <section class="kx-geo" id="geometry">
                <div class="kx-movement" data-reveal>
                  <span class="kx-movement__n">GEOMETRY OF RETURN</span>
                  <h2 class="kx-movement__t">Double Projective<br />Spiral −∞</h2>
                  <p class="kx-movement__d">Not borrowed sacred geometry. It grows from the philosophy: descend → centre → manifest → return. Cycle + memory = helix.</p>
                </div>
                <div class="kx-geo__stage" data-reveal>
                  <canvas data-geo-canvas></canvas>
                  <span class="kx-geo__o" aria-hidden="true"></span>
                </div>
                <p class="kx-geo__thm" data-reveal>K<sub>n+1</sub> ≠ K<sub>n</sub> &nbsp;·&nbsp; I<sub>n+1</sub> = I<sub>n</sub> &nbsp;—&nbsp; <span>the form changes, the core remains.</span></p>
              </section>
            </div>
          </section>
          <section class="kx-slide kx-slide--art" style="--art:url(/img/kodex/archive/arch-27.jpg)">
            <div class="kx-slide__in">
              <section class="kx-organs" id="organismos">
                <div class="kx-movement" data-reveal>
                  <span class="kx-movement__n">ORGANISMS</span>
                  <h2 class="kx-movement__t">Organs of one<br />intelligence</h2>
                  <p class="kx-movement__d">Wenu Mapu is a manifestation. KODEX−∞ is the system that tells where it is born, how it transforms, where it evolves.</p>
                </div>
                <ul class="kx-organs__list">
                  {organs.map((o) => (
                    <li class="kx-organ" data-spec data-reveal>
                      <span class="kx-organ__state">{o.state}</span>
                      <h3 class="kx-organ__name">{o.name}</h3>
                      <p class="kx-organ__dom">{o.dom}</p>
                      <span class="kx-organ__go">open →</span>
                    </li>
                  ))}
                </ul>
              </section>
            </div>
          </section>
          <section class="kx-slide kx-slide--art" style="--art:url(/img/kodex/works/bw-11.jpg)">
            <div class="kx-slide__in">
              <footer class="kx-foot">
                <p data-reveal>Not a portfolio.</p>
                <p data-reveal>Not a shop.</p>
                <p data-reveal>Not a dead archive.</p>
                <p class="kx-foot__punch" data-reveal>−∞ is not the end. It is the depth where form dissolves to remember what it was made of.</p>
                <p class="kx-cipher" data-cipher="THE IDEA WAS ALREADY HERE. YOU DID NOT MAKE IT — YOU GAVE IT FORM. SO IT BELONGS TO NO ONE, AND TO ALL. HOLD THE SIGNAL. BUILD YOUR OWN. THE CODEX IS NEVER FINISHED." aria-hidden="true"></p>
                <p class="kx-foot__key" data-reveal>Some of this is written in a language only the SIGNAL can read.  <span>[ press S ]</span></p>
              </footer>
            </div>
          </section>
          <section class="kx-slide" data-plusinf>
            <div class="kx-slide__in">
              <section class="kx-plusinf">
                <span class="kx-plusinf__sym">+∞</span>
                <h2 class="kx-plusinf__t">KODEX<span style="opacity:.5">+∞</span></h2>
                <p class="kx-plusinf__d" data-reveal>You crossed the whole descent. The codex turns white: shadow gave back the light it was holding. Inhale. Exhale. Begin again whenever you need the depth.</p>
                <div class="kx-plusinf__row" data-reveal>
                  <a href="/kodex/">↺ READ AGAIN · −∞</a>
                  <a href="/kodex/editions/">HOLD A FRAGMENT · EDITIONS</a>
                </div>
              </section>
            </div>
          </section>
        </>
      )}

      {stripFor.length > 0 && (
        <section class="kx-slide">
          <div class="kx-slide__in">
            <div class="kx-movement" data-reveal>
              <span class="kx-movement__n">INTERLEAF</span>
              <h2 class="kx-movement__t">Between pages</h2>
            </div>
            <div class="kx-strip">
              {stripFor.map((fam) => <KodexCell fam={fam} />)}
            </div>
          </div>
        </section>
      )}

    </div>

    <KodexOverlays gallery={folio === 'iii'} />
  </div>

  <script>
    import { initKx } from '../../../scripts/kodex-engine.js';
    initKx();
  </script>
</Base>
