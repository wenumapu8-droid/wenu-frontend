    <script type="application/json" id="kdx-strata-data" set:html={JSON.stringify(specimens)}></script>
    <script type="application/json" id="kdx-cosmos-data" set:html={JSON.stringify(cosmoNodes)}></script>
    {/* 2026-08-28: graph canónico expuesto como JSON inline para que el
        cliente pueda leer edges.length para STRUCTURAL LINKS de MACHINE.
        Fuente: runtime/journeyGraph/frozen-canonical-graph.json. */}
    <script type="application/json" id="kdx-graph-data" set:html={JSON.stringify(journeyGraph)}></script>
    <KodexOverlays gallery={false} />
  </div>

  <script>
  /* LAS TRES PIEZAS DEL CORREDOR, MONTADAS Y NO REESCRITAS.
     Las tres existen ya y las escribió el agente que lleva el descenso; acá
     sólo se enchufan a las escenas del folio, que hasta ahora se las perdían:
     el corredor tenía el túnel, el orden de llegada y el sonido corriendo en
     las láminas y en ningún folio.

     `montarTravesia`  el feedback pass de verdad. Escucha el mismo contrato
                       que ya emitía el runtime -- data-kdx-travesia en
                       [data-deck] -- así que reemplaza mi CSS de transform y
                       blur sin tocar quien lo dispara.
     `montarFases`     silencio → entrada → revelación → movimiento →
                       descubrimiento. Las cosas llegan en orden en vez de
                       todas juntas, que es el diagnóstico del manifiesto:
                       "algunos instrumentos están tocando todos al mismo
                       tiempo".
     `montarSonido`    el motor del prototipo. Nunca arranca solo: respeta la
                       elección que el visitante tomó en la puerta. */
  import { montarTravesia } from '../../../lib/kodex/travesia';
  import { montarEstadoEscena, montarFases } from '../../../lib/kodex/estado';
  import { montarSonido } from '../../../lib/kodex/sonido-montar';
  /* `montarEspejoEstado` no agrega comportamiento: hace VISIBLE el que ya
     existe. La máquina de estados ya la comparten el campo, el portal, la
     transición y el CRT, pero nadie la escribía en el DOM, así que la ley
     INPUT → ESTADO → CONSECUENCIA VISIBLE tenía el eslabón del medio invisible
     y el gate reportaba "causalidad no evaluada" en las siete escenas. */
  import { montarEspejoEstado } from '../../../lib/kodex/espejo-estado';
  import { montarVoz } from '../../../lib/kodex/voz';

  const montarCorredor = () => {
    try { montarTravesia(); } catch (_) {}
    try { montarFases(); } catch (_) {}
    try { montarSonido(); } catch (_) {}
    /* La máquina de estados hasta hoy sólo arrancaba dentro de KodexCrtLayer,
       kodex-gate-client y kodex-portal-client — ninguno de los tres se monta
       en el layout general de la escena de folio, así que `data-kdx-estado`
       se quedaba en `idle` de por vida. Sin motor, ni el espejo cambia ni el
       carril se mueve, y el gate reporta ESTADO SIN CONSECUENCIA. Arrancar
       la máquina acá cierra ese hueco para las seis escenas. */
    try { montarEstadoEscena(); } catch (_) {}
    try { montarEspejoEstado(); } catch (_) {}

    /* LA VOZ · 2026-08-28. Misma logica que en el umbral: junto al espejo,
       porque el espejo hace visible el estado y la voz lo hace audible.
       Lee el titulo TAL COMO ESTA EN PANTALLA -- nunca dice algo que el
       visitante no pueda leer, lo que la hace verificable contra el DOM y
       accesible. */
    try {
      const raizVoz = document.querySelector('[data-kdx-contrato]');
      if (raizVoz) {
        const callar = montarVoz(raizVoz);
        window.addEventListener('pagehide', callar, { once: true });
      }
    } catch (_) {}
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', montarCorredor, { once: true });
  else montarCorredor();
  document.addEventListener('astro:page-load', montarCorredor);

    import { initKx } from '../../../scripts/kodex-engine.js';
    initKx();

    const drawer = document.querySelector('[data-kdx-drawer]');
    const drawerSections = [...document.querySelectorAll('[data-kdx-drawer-section]')];
    const openDrawer = (name) => {
      drawerSections.forEach((s) => { s.hidden = s.getAttribute('data-kdx-drawer-section') !== name; });
      drawer.hidden = false;
      drawer.setAttribute('data-open', '');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };
    const closeDrawer = () => {
      drawer?.removeAttribute('data-open');
      drawer?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => { if (drawer) drawer.hidden = true; }, 220);
    };
    document.querySelectorAll('[data-kdx-drawer-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.getAttribute('data-kdx-drawer-open');
        openDrawer(name);
        try { window.kdx && window.kdx('artwork_open', { section: name }); } catch (_) {}
      });
    });
    document.querySelector('[data-kdx-drawer-close]')?.addEventListener('click', closeDrawer);
    drawer?.addEventListener('click', (e) => { if (e.target === drawer) closeDrawer(); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer && !drawer.hidden) closeDrawer(); });

    const folioActual = document.querySelector('[data-kdx-folio]')?.getAttribute('data-kdx-folio')
      || (location.pathname.match(/\/folio\/([^/]+)\//) || [])[1] || '';
    const strata = JSON.parse(document.getElementById('kdx-strata-data')?.textContent || '[]');
    let stratumIndex = 0;
    const paintStratum = () => {
      const s = strata[stratumIndex]; if (!s) return;
      const pad = String(stratumIndex + 1).padStart(2, '0');
      document.querySelector('[data-stratum-count]')?.replaceChildren(`STRATUM · ${pad} / ${String(strata.length).padStart(2, '0')}`);
      document.querySelector('[data-stratum-depth]')?.replaceChildren(`DEPTH · -${137 + stratumIndex * 89} M`);
      document.querySelector('[data-stratum-title]')?.replaceChildren(s.name);
      document.querySelector('[data-stratum-read]')?.replaceChildren(s.read);
      /* EL MOTOR DE ESTRATOS SÓLO PINTA LA OBRA EN DESCENT.
         Acá estaba la razón de que las siete escenas se parecieran, y no eran
         las tablas de asignación: `paintStratum()` se llamaba sin condición al
         final del script, en LOS SEIS folios. Los estratos se emiten en todos
         -- son los 11 especímenes -- así que `strata[0]` es bw-01 y todas las
         escenas terminaban mostrando la misma obra, pisando lo que declaraban
         `sceneByFolio` y la tabla de fundición.

         Comprobado en navegador: PROLOGUE, DESCENT, MACHINE y RETURN servían
         `bw-01.jpg` mientras su HTML decía otra cosa. Dos tablas cambiadas no
         movieron un pixel hasta encontrar esto.

         El recorrido de estratos es de DESCENT. En las demás escenas la obra la
         decide su propia declaración y nadie la toca. */
      if (folioActual === 'ii') {
        const art = document.querySelector('[data-kdx-art] img');
        if (art) art.src = `/img/kodex/works/${s.file}.jpg`;
      }
    };
    document.querySelector('[data-stratum-next]')?.addEventListener('click', () => {
      stratumIndex = (stratumIndex + 1) % strata.length;
      paintStratum();
      try { window.kdx && window.kdx('next_scene', { kind: 'stratum', index: stratumIndex }); } catch (_) {}
    });
    paintStratum();

    const canvas = document.querySelector('[data-machine-canvas]');
    const ctx = canvas?.getContext?.('2d');
    let gen = 0;
    const drawMachine = (seed = 'A90C-73F1') => {
      if (!ctx || !canvas) return;
      const w = canvas.width, h = canvas.height, cx = w / 2, cy = h / 2;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#080808'; ctx.fillRect(0, 0, w, h);
      ctx.strokeStyle = 'rgba(0,239,255,.55)'; ctx.lineWidth = 1;
      for (let r = 72; r < 310; r += 38) {
        ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.stroke();
      }
      ctx.strokeStyle = 'rgba(230,230,230,.72)';
      for (let i = 0; i < 32; i++) {
        const a = i / 32 * Math.PI * 2 + gen * .08;
        const r1 = 68 + (i % 5) * 12;
        const r2 = 292 - (i % 7) * 10;
        ctx.beginPath();
        ctx.moveTo(cx + Math.cos(a) * r1, cy + Math.sin(a) * r1);
        ctx.lineTo(cx + Math.cos(a + Math.sin(i + gen) * .28) * r2, cy + Math.sin(a + Math.cos(i + gen) * .22) * r2);
        ctx.stroke();
      }
      ctx.fillStyle = '#00D8FF'; ctx.fillRect(cx - 5, cy - 5, 10, 10);
      ctx.fillStyle = '#E6E6E6'; ctx.font = '18px monospace'; ctx.fillText(seed, 28, h - 34);
    };
    const nextSeed = () => Array.from({ length: 2 }, () => Math.floor(Math.random() * 65535).toString(16).toUpperCase().padStart(4, '0')).join('-');
    document.querySelector('[data-machine-generate]')?.addEventListener('click', () => {
      gen += 1;
      const seed = nextSeed();
      const id = `KDX-GEN-${String(1000 + gen).padStart(4, '0')}`;
      const state = document.querySelector('[data-machine-state]');
      const seedEl = document.querySelector('[data-machine-seed]');
      const output = document.querySelector('[data-machine-output]');
      state?.replaceChildren('GENERATING');
      try { window.kdx && window.kdx('generator_start', { id }); } catch (_) {}
      setTimeout(() => {
        state?.replaceChildren('COMPLETE');
        seedEl?.replaceChildren(seed);
        drawMachine(seed);
        output?.replaceChildren(`${id} · SEED ${seed} · SOURCE ACHROMA_006 · METHOD MIRROR/DITHER/FLOW · STATUS COMPLETE`);
        try { window.kdx && window.kdx('generator_complete', { id, seed }); } catch (_) {}
      }, 620);
    });
    drawMachine();

    /* ── 2026-08-28 · WIRING DE NODOS DE ORGANISMOS ─────────────────────
       Cada nodo TEXTUAL de los organismos (ARCHIVE, COSMOLOGY) declara una
       consecuencia visible cuando el visitante lo toca. Sin listener el
       nodo es póster (00-EL-TEST-DEL-PNG.md). Spec §2.1-§2.3.

       El listener es defensivo: si el nodo no existe en esta escena (folio
       distinto), no falla; solo no hace nada. */

    // ARCHIVE · cablear los 6 nodos (RECORD, RELATE, WEAVE, RECALL, PRESERVE, TRANSCEND)
    (function cablearArchive() {
      const cluster = document.querySelector('[data-kdx-organismo-nodos="archive"]');
      if (!cluster) return;
      const nodos = cluster.querySelectorAll<HTMLElement>('.kdx-micro-node');
      const stampTs = () => {
        const n = new Date();
        return `${String(n.getHours()).padStart(2,'0')}:${String(n.getMinutes()).padStart(2,'0')}:${String(n.getSeconds()).padStart(2,'0')}`;
      };
      const appendLog = (msg: string) => {
        const log = document.querySelector('.kdx-syslog__list');
        if (!log) return;
        const li = document.createElement('li');
        li.setAttribute('data-kdx-logline', '');
        li.innerHTML = `<span class="kdx-syslog__t">[${stampTs()}]</span> ${msg}`;
        log.prepend(li);
        while (log.children.length > 6) log.lastChild?.remove();
      };
      const acciones: Record<string, () => void> = {
        'RECORD': () => appendLog('SPECIMEN CAPTURED'),
        'RELATE': () => {
          appendLog('RELATION TRACED');
          // resalta el organismo un instante (usa .kx-os-stage__pulso que ya existe)
          const stage = document.querySelector<HTMLElement>('.kx-os-stage');
          if (stage) {
            stage.dataset.kdxEstadoPrevio = stage.dataset.kdxEstado || '';
            stage.dataset.kdxEstado = 'aware';
            setTimeout(() => { if (stage.dataset.kdxEstadoPrevio !== undefined) stage.dataset.kdxEstado = stage.dataset.kdxEstadoPrevio; }, 1200);
          }
        },
        'WEAVE': () => appendLog('THREADS SYNTHESIZED'),
        'RECALL': () => {
          appendLog('MEMORY ACTIVATED');
          // forzar cambio del especimen visible (data-kdx-recall dispatched)
          document.dispatchEvent(new CustomEvent('kodex:recall'));
        },
        'PRESERVE': () => {
          appendLog('INTEGRITY GUARDED');
          try { sessionStorage.setItem('kdx-preserved', '1'); } catch (_) {}
        },
        'TRANSCEND': () => {
          appendLog('CONSCIOUSNESS ELEVATED');
          // avanzar la máquina de estado si es posible
          try {
            const w = window as any;
            if (w.__kdxState !== 'active' && document.querySelector('[data-kdx-contrato]')) {
              // el espejo-estado ya escucha; disparamos click en CTA como proxy
              document.querySelector<HTMLElement>('[data-kdx-primary], .kx-os-primary')?.click();
            }
          } catch (_) {}
        },
      };
      nodos.forEach((nodo) => {
        const label = nodo.querySelector('strong')?.textContent?.trim().toUpperCase() || '';
        if (!acciones[label]) return;
        nodo.style.cursor = 'pointer';
        nodo.setAttribute('tabindex', '0');
        nodo.setAttribute('role', 'button');
        nodo.setAttribute('aria-label', `Action: ${label}`);
        const disparar = () => acciones[label]();
        nodo.addEventListener('click', disparar);
        nodo.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); disparar(); }
        });
      });
    })();

    // MACHINE · rellenar los 4 readouts del board con data-fuente REAL
    (function rellenarMachine() {
      const boardDl = document.querySelector('.kx-machine-readout__board');
      if (!boardDl) return;
      const seed0 = document.querySelector('[data-machine-seed]')?.textContent?.trim() || 'A90C-73F1';
      const w = window as any;
      w.__kdxLastMachineSeed = seed0;

      const rellenar = (seed: string) => {
        const canvasEl = document.querySelector('[data-machine-canvas]');
        const ctx2d = (canvasEl as HTMLCanvasElement | null)?.getContext?.('2d');
        const core = document.querySelector('[data-kdx-machine-core]');
        if (core) core.textContent = ctx2d ? 'ONLINE' : 'OFFLINE';

        const last = w.__kdxLastMachineSeed;
        const align = document.querySelector('[data-kdx-machine-align]');
        if (align) align.textContent = (!last || last === seed) ? 'LOCKED' : 'TUNING';
        w.__kdxLastMachineSeed = seed;

        const linksEl = document.querySelector('[data-kdx-machine-links]');
        if (linksEl) {
          try {
            const g = JSON.parse(document.getElementById('kdx-graph-data')?.textContent || '{}');
            const n = Array.isArray(g?.edges) ? g.edges.length : 0;
            linksEl.textContent = n > 0 ? `ACTIVE (${n})` : 'SEVERED';
          } catch (_) {
            linksEl.textContent = 'SEVERED';
          }
        }
      };
      rellenar(seed0);
      // Hook al listener existente de data-machine-generate (dispara después)
      document.querySelector('[data-machine-generate]')?.addEventListener('click', () => {
        // El listener original cambia el seed después de un setTimeout de 620ms.
        // Esperamos que se aplique antes de re-medir.
        setTimeout(() => {
          const newSeed = document.querySelector('[data-machine-seed]')?.textContent?.trim() || seed0;
          rellenar(newSeed);
        }, 700);
      });
    })();

    // COSMOLOGY · cablear hover/tap de los 3 nodos orbitales
    (function cablearCosmos() {
      const orbitas = document.querySelectorAll<HTMLElement>('[data-kdx-organismo-nodos="cosmology"] .kx-cosmo-orbit');
      if (!orbitas.length) return;
      const tocados = new Set<string>();
      orbitas.forEach((orb) => {
        const nodo = orb.dataset.cosmoNodo || '';
        const activar = () => {
          tocados.add(nodo);
          const panelNode = document.querySelector('[data-cosmo-node]');
          if (panelNode) panelNode.textContent = `NODE · ${nodo.toUpperCase()}`;
          // Si tocó los 3, avanzar el estado
          if (tocados.size >= 3) {
            const stage = document.querySelector<HTMLElement>('.kx-os-stage');
            if (stage) stage.dataset.kdxEstado = 'active';
          }
        };
        orb.addEventListener('click', activar);
        orb.addEventListener('focus', activar);
      });
    })();

    const nodes = JSON.parse(document.getElementById('kdx-cosmos-data')?.textContent || '[]');
    let nodeIndex = 1;
    document.querySelector('[data-cosmo-next]')?.addEventListener('click', () => {
      nodeIndex = (nodeIndex + 1) % nodes.length;
      const node = nodes[nodeIndex];
      document.querySelector('[data-cosmo-node]')?.replaceChildren(`NODE · ${node.toUpperCase()}`);
      document.querySelector('[data-cosmo-state]')?.replaceChildren(node === 'KODEX' ? 'STATE · SOURCE' : 'STATE · LINKED');
      document.querySelector('[data-cosmo-relation]')?.replaceChildren(`DOMAIN · BODY / MATTER / MEMORY`, document.createElement('br'), `RELATION · ${node === 'Machine' ? 'PROCESSING' : '+∞'}`);
      try { window.kdx && window.kdx('outbound_cosmo', { node }); } catch (_) {}
    });
  </script>
  <!-- LA MÁQUINA DEL KODEX. El creador, 2026-08-20: "hasta ahora uno va hacia
       el lado y necesitamos que vaya hacia dentro, y que las 7 escenas se
       ramifiquen hasta encontrar al medio el corazón". El botón NEXT lateral
       de esta misma escena sigue donde estaba: nada se borró, se agregó una
       dirección que no existía. -->
  <Descenso escena={folio} etiqueta={sceneByFolio.slug.toUpperCase()} />
