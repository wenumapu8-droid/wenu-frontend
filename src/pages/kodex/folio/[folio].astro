  ii:  [['00:00:00','KDX-CORE INITIALIZED'],['00:00:02','STRATA ENGINE ONLINE'],['00:00:05','DESCENT VECTOR ARMED']],
  iii: [['00:00:00','KDX-CORE INITIALIZED'],['00:00:03','ARCHIVE INDEX MOUNTED'],['00:00:06','GENEALOGY LINKS RESOLVED']],
  iv:  [['00:00:00','KDX-CORE INITIALIZED'],['00:00:02','THRESHOLD 04 ONLINE'],['00:00:04','ALIGNMENT GRID LOCKED'],['00:00:06','PATTERNS EMERGING'],['00:00:08','ENGINE AWAKENED']],
  v:   [['00:00:00','KDX-CORE INITIALIZED'],['00:00:03','FIELD CARTOGRAPHY OPEN'],['00:00:07','RELATION COUNT UNBOUNDED']],
  vi:  [['00:00:00','KDX-CORE INITIALIZED'],['00:00:04','ROUTE SIGNATURE SEALED'],['00:00:09','PATTERN CARRIED FORWARD']],
};

/* TELAR A10 · CHECKSUM DERIVADO. FNV-1a 32-bit sobre el contenido gobernado:
 * cambia si cambia el copy. Un checksum fijo es adorno; uno inventado, mentira. */
function checksumDe(txt) {
  let h = 0x811c9dc5;
  for (let i = 0; i < txt.length; i++) {
    h ^= txt.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  const hex = h.toString(16).toUpperCase().padStart(8, '0');
  return `${hex.slice(0,4)}-${hex.slice(4,8)}`;
}
const sceneChecksum = origen
  ? `${checksumDe(origen.id + sceneByFolio.title)}-${checksumDe(sceneByFolio.cta + sceneByFolio.slug)}`
  : null;

/* TELAR A02 · etiqueta base del punto, transcrita de los boards.
 * DESCENT es la unica que dice DEEPENING. */
const senalByFolio = { i:'LATENT', ii:'DEEPENING', iii:'LATENT', iv:'LATENT', v:'LATENT', vi:'LATENT' };

/* TELAR A03 · datos del riel por escena. Solo lo que la escena SABE.
