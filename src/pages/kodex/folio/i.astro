---
import Base from '../../../layouts/Base.astro';
import KodexRecuerda from '../../../components/kodex/KodexRecuerda.astro';
import KodexTransition from '../../../components/kodex/transition/KodexTransition.astro';
import KodexIndexOverlay from '../../../components/KodexIndexOverlay.astro';
import EscenaPrologue from '../../../components/kodex/prologue/EscenaPrologue.astro';
import '../../../styles/kodex.css';
---

<Base
  title="01 · PROLOGUE — KODEX−∞"
  description="KODEX−∞ PROLOGUE · Observation Eye"
  robots="noindex, nofollow"
  kodexFonts={true}
  noNav={true}
  noFooter={true}
  noOverlays={true}
  noQuote={true}
  noThemes={true}
  noKai={true}
  noCart={true}
  noImmersive={true}
>
  <KodexRecuerda />

  <main
    class="kx-native-prologue kx-os-scene kx-os-scene--prologue"
    data-kx
    data-stage-idx="1"
    data-stage-name="PROLOGUE"
    data-prev-url="/kodex/"
    data-next-url="/kodex/folio/ii/"
    style="--kdx-scene-accent:#B27CFF;"
  >
    <KodexTransition router={true} />

    <header class="kx-native-prologue__shell" aria-label="KODEX navigation">
      <a class="kx-native-prologue__brand" href="/kodex/" aria-label="KODEX minus infinity">KODEX−∞</a>
      <nav class="kx-native-prologue__nav" aria-label="Scene controls">
        <a href="/kodex/" aria-label="Return to Threshold">← THRESHOLD</a>
        <button type="button" data-kdx-index-open aria-label="Open KODEX index">INDEX</button>
      </nav>
    </header>

    <EscenaPrologue />
    <KodexIndexOverlay />
  </main>
</Base>

<style>
  :global(html), :global(body) {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow: hidden;
    background: #05040a;
  }

  .kx-native-prologue {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
    background: #05040a;
  }

  .kx-native-prologue__shell {
    position: fixed;
    z-index: 40;
    top: max(12px, env(safe-area-inset-top));
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px clamp(16px, 3vw, 42px);
    pointer-events: none;
  }

  .kx-native-prologue__brand,
  .kx-native-prologue__nav a,
  .kx-native-prologue__nav button {
    pointer-events: auto;
  }

  .kx-native-prologue__brand {
    color: rgba(246, 242, 255, .94);
    text-decoration: none;
    font: 700 clamp(18px, 2.3vw, 30px)/1 "Instrument Sans", system-ui, sans-serif;
    letter-spacing: -.035em;
    text-shadow: 0 0 24px rgba(178,124,255,.18);
  }

  .kx-native-prologue__nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .kx-native-prologue__nav a,
  .kx-native-prologue__nav button {
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid rgba(178,124,255,.24);
    background: rgba(5,4,10,.46);
    color: rgba(230,220,255,.72);
    font: 500 9px/1 ui-monospace, monospace;
    letter-spacing: .16em;
    text-decoration: none;
    cursor: pointer;
    backdrop-filter: blur(10px);
  }

  .kx-native-prologue__nav a:hover,
  .kx-native-prologue__nav button:hover,
  .kx-native-prologue__nav a:focus-visible,
  .kx-native-prologue__nav button:focus-visible {
    color: #fff;
    border-color: rgba(178,124,255,.72);
    outline: none;
    box-shadow: 0 0 24px rgba(178,124,255,.12);
  }

  @media (max-width: 640px) {
    .kx-native-prologue__nav a {
      display: none;
    }
    .kx-native-prologue__shell {
      padding-inline: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kx-native-prologue__brand,
    .kx-native-prologue__nav a,
    .kx-native-prologue__nav button {
      text-shadow: none;
      backdrop-filter: none;
    }
  }
</style>
