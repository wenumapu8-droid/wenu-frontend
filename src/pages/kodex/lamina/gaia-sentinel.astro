  const glifosMandala = [
    ...Array.from({ length: 8 }, (_, i) => ({ a: (i / 8) * Math.PI * 2 - Math.PI / 2, r: 138, s: 13 })),
    ...Array.from({ length: 12 }, (_, i) => ({ a: (i / 12) * Math.PI * 2, r: 186, s: 10 })),
  ];

  /* ── 4 · EL TITÁN ────────────────────────────────────────────────
     Silueta simétrica de bloques de piedra y musgo. Las medidas salen
     del recorte: corona y93..164, rostro y164..214, hombros y271
     (x179..586), sigilo del pecho en (381,329) r≈44, manos hacia
     y≈700. */
  const HEAD = { x: 384, y: 186 };
  const PECHO = { x: 383, y: 330 };

  const coronaPicos = Array.from({ length: 21 }, (_, i) => {
    const t = i / 20 - 0.5;
    const x = 384 + t * 210;
    const alto = 74 * (1 - Math.abs(t) * 1.2) + 26 + rnd() * 14;
    return { x, base: 196 + Math.abs(t) * 58, alto, w: 10 + (1 - Math.abs(t) * 2) * 10, incl: t * 0.5 };
  });

  /* bloques del cuerpo: rocas apiladas, espejadas sobre el eje */
  const bloques: Array<{ x: number; y: number; w: number; h: number; o: number; giro: number }> = [];
  for (let y = 250; y < 700; y += 17) {
    const t = (y - 250) / 450;
    const medio = 150 - t * 46 + Math.sin(t * 7) * 14;
    for (let k = 0; k < 7; k++) {
      const dx = (k / 6) * medio;
      bloques.push({
        x: dx, y, w: 15 + rnd() * 22, h: 10 + rnd() * 8,
        o: 0.16 + rnd() * 0.3, giro: (rnd() - 0.5) * 0.3,
      });
    }
  }
  /* cristales de hombro y torso */
  const cristales = Array.from({ length: 54 }, () => {
    const lado = rnd() < 0.5 ? -1 : 1;
    const t = rnd();
    const x = 384 + lado * (72 + t * 148);
    const y = 262 + rnd() * 150 + t * 56;
    return { x, y, h: 22 + rnd() * 46, w: 7 + rnd() * 10, incl: lado * (0.03 + rnd() * 0.14) };
  });
  /* lianas: los hilos que cuelgan del titán en la referencia */
  const lianas = Array.from({ length: 120 }, () => {
    const lado = rnd() < 0.5 ? -1 : 1;
    const x = 384 + lado * (30 + rnd() * 230);
    const y0 = 250 + rnd() * 300;
    return { x, y0, largo: 40 + rnd() * 200, curva: (rnd() - 0.5) * 26, o: 0.14 + rnd() * 0.34 };
  });
  /* brazos: dos arcos que bajan a las manos */
  const brazos = [-1, 1].map((s) => ({
    x0: 384 + s * 168, y0: 286,
    x1: 384 + s * 258, y1: 470,
    x2: 384 + s * 236, y2: 700,
  }));

  /* ── 5 · VALLE: acantilados y cascadas ───────────────────────────*/
  const cascadas = [
    { x: 34, y0: 250, y1: 700, w: 15 }, { x: 66, y0: 300, y1: 660, w: 9 },
    { x: 96, y0: 360, y1: 620, w: 7 },  { x: 690, y0: 240, y1: 720, w: 17 },
    { x: 724, y0: 280, y1: 690, w: 11 }, { x: 748, y0: 330, y1: 640, w: 8 },
    { x: 640, y0: 430, y1: 620, w: 6 },  { x: 132, y0: 430, y1: 600, w: 6 },
  ];
  const acantilados = [
    { x: 0, y: 300, w: 150, h: 620 }, { x: 618, y: 280, w: 150, h: 640 },
    { x: 96, y: 210, w: 120, h: 300 }, { x: 560, y: 200, w: 140, h: 320 },
  ];
  /* follaje: matas de puntos que cubren cantos y suelo */
  const follaje = Array.from({ length: 5200 }, () => {
    const canto = rnd();
    let x: number;
    if (canto < 0.42) x = rnd() * 190;
    else if (canto < 0.84) x = W - rnd() * 190;
    else x = rnd() * W;
    const y = canto < 0.84 ? 200 + rnd() * 900 : 780 + rnd() * 380;
    return { x, y, s: 1 + rnd() * 2.6, o: 0.12 + rnd() * 0.4, c: rnd() < 0.6 ? VERDE : ORO };
  });

  /* DOSEL · copas oscuras de los cantos y del borde alto. Son masas,
     no puntos: el follaje suelto no baja la media donde la referencia
     tiene bosque cerrado. */
  /* CALIBRADO CONTRA EL DELTA. La primera versión —190 copas de hasta
     88 px más una banda en el borde alto— hundió la fila superior de
     −33 a −107 y arte-alto saltó de 32,7 % a 41,5 %. El borde alto de
     la referencia es CIELO, no bosque: la banda se quitó entera y las
     copas de los cantos bajaron a un tercio de masa. */
  const dosel: Array<{ x: number; y: number; r: number; o: number; c: string }> = [];
  for (let k = 0; k < 96; k++) {
    const lado = k % 2 ? 1 : -1;
    const t = (k / 96);
    const x = lado < 0 ? Math.pow(rnd(), 2.4) * 150 : W - Math.pow(rnd(), 2.4) * 150;
    const y = 320 + t * (H - 320) + (rnd() - 0.5) * 90;
    dosel.push({ x, y, r: 22 + rnd() * 40, o: 0.13 + rnd() * 0.2, c: rnd() < 0.35 ? "58,72,44" : "34,46,32" });
  }
  /* motas claras encima del dosel: hoja iluminada */
  const hojas = Array.from({ length: 4200 }, () => {
    const lado = rnd() < 0.5 ? -1 : 1;
    const x = lado < 0 ? Math.pow(rnd(), 1.6) * 215 : W - Math.pow(rnd(), 1.6) * 215;
    return { x, y: rnd() * H, s: 0.9 + rnd() * 2.2, o: 0.12 + rnd() * 0.34,
             c: rnd() < 0.5 ? "122,158,80" : rnd() < 0.7 ? "168,178,120" : "78,110,64" };
  });

  /* ── 6 · PLAZA ───────────────────────────────────────────────────
     Anillos concéntricos en perspectiva, escalinatas, seis obeliscos
     y el prisma verde del centro. */
  const PLAZA = { x: 385, y: 1042 };
  const obeliscos = [
    { x: 139, w: 46, y0: 861, y1: 1044 },
    { x: 221, w: 30, y0: 895, y1: 1014 },
    { x: 350, w: 23, y0: 902, y1: 1008 },
    { x: 471, w: 23, y0: 896, y1: 1004 },
    { x: 607, w: 30, y0: 882, y1: 1018 },
    { x: 693, w: 46, y0: 855, y1: 1048 },
  ];
  const PRISMA = { x: 385, base: 1018, alto: 268, w: 44 };
  /* figurillas: la referencia puebla la plaza de siluetas de 12..20 px */
  const figuras = Array.from({ length: 24 }, () => ({
    x: 120 + rnd() * 528,
    y: 940 + rnd() * 190,
    h: 13 + rnd() * 9,
  }));
  /* flores de los cantos bajos: violeta y azul encendidos */
  const flores = Array.from({ length: 54 }, () => {
    const izq = rnd() < 0.5;
    return {
      x: izq ? rnd() * 150 : W - rnd() * 150,
      y: 980 + rnd() * 182,
      r: 7 + rnd() * 15,
      c: rnd() < 0.55 ? LILA : AZUL,
      o: 0.22 + rnd() * 0.3,
    };
  });

  /* ── 7 · GRANO ───────────────────────────────────────────────────
     Poco y fino: el grano paga doble en el diff. Está para romper las
     bandas del ambiente, no para llenar. */
  const grano = Array.from({ length: 7000 }, () => ({
    x: rnd() * W, y: rnd() * H,
    s: 0.6 + rnd() * 1.1,
    o: 0.04 + rnd() * 0.14,
    c: rnd() < 0.4 ? ORO : rnd() < 0.7 ? VERDE : PIEDRA,
  }));

  /* ── capa estática ───────────────────────────────────────────────*/
  const fondo = document.createElement("canvas");
  fondo.width = W; fondo.height = H;
  const f = fondo.getContext("2d")!;

  function pintarFondo() {
    f.clearRect(0, 0, W, H);
    pintarAmbiente(f);

    /* nubes: masa suave sobre la banda alta */
    for (const n of nubes) {
      const gr = f.createRadialGradient(n.x, n.y, 0, n.x, n.y, n.r);
      gr.addColorStop(0, tinta(CIELO, n.o));
      gr.addColorStop(0.55, tinta(CIELO, n.o * 0.4));
      gr.addColorStop(1, "rgba(0,0,0,0)");
      f.fillStyle = gr;
      f.beginPath(); f.arc(n.x, n.y, n.r, 0, Math.PI * 2); f.fill();
    }

    /* acantilados: masas oscuras con perfil quebrado */
    for (const a of acantilados) {
      f.fillStyle = tinta("52,62,50", 0.17);
      f.beginPath();
      f.moveTo(a.x, a.y + a.h);
      let px = a.x;
      while (px < a.x + a.w) {
        const paso = 14 + rnd() * 26;
        f.lineTo(px, a.y + (rnd() - 0.5) * 70);
        px += paso;
      }
      f.lineTo(a.x + a.w, a.y + a.h);
      f.closePath(); f.fill();
    }

    /* cascadas: cintas de luz vertical, lo más brillante del valle */
    for (const c of cascadas) {
      const gr = f.createLinearGradient(c.x - c.w, 0, c.x + c.w, 0);
      gr.addColorStop(0, "rgba(0,0,0,0)");
      gr.addColorStop(0.5, tinta("226,232,236", 0.3));
      gr.addColorStop(1, "rgba(0,0,0,0)");
      f.fillStyle = gr;
      f.fillRect(c.x - c.w, c.y0, c.w * 2, c.y1 - c.y0);
      f.strokeStyle = tinta("240,246,250", 0.34);
      f.lineWidth = 0.8;
      for (let k = 0; k < 5; k++) {
        const xx = c.x + (k - 2) * c.w * 0.35;
        f.beginPath(); f.moveTo(xx, c.y0); f.lineTo(xx + (rnd() - 0.5) * 6, c.y1); f.stroke();
      }
      /* bruma del pie de la caída: corta y local. Con radio 5w y 0,3
         de opacidad agrisaba medio cuadro y el delta lo cobraba a lo
         ancho de tres columnas de celdas. */
      const br = f.createRadialGradient(c.x, c.y1, 2, c.x, c.y1, c.w * 2.6);
      br.addColorStop(0, tinta("220,228,232", 0.18));
      br.addColorStop(1, "rgba(0,0,0,0)");
      f.fillStyle = br;
      f.beginPath(); f.arc(c.x, c.y1, c.w * 2.6, 0, Math.PI * 2); f.fill();
    }

    /* dosel: masas de copa a los dos cantos y al borde alto */
    for (const d of dosel) {
      const gr = f.createRadialGradient(d.x, d.y, 0, d.x, d.y, d.r);
      gr.addColorStop(0, tinta(d.c, d.o));
      gr.addColorStop(0.62, tinta(d.c, d.o * 0.65));
      gr.addColorStop(1, "rgba(0,0,0,0)");
      f.fillStyle = gr;
      f.beginPath(); f.arc(d.x, d.y, d.r, 0, Math.PI * 2); f.fill();
    }
    for (const h of hojas) {
      f.fillStyle = tinta(h.c, h.o);
      f.fillRect(h.x, h.y, h.s, h.s);
    }

    /* follaje de los cantos */
    for (const p of follaje) {
      f.fillStyle = tinta(p.c, p.o);
      f.fillRect(p.x, p.y, p.s, p.s);
    }

    /* ── el titán ──────────────────────────────────────────────────
       Comparando el recorte contra la referencia, la versión anterior
       era un TRAPECIO de ladrillos: leía como muro, no como figura. La
       referencia tiene cintura, dos brazos separados del torso —con el
       fondo visible entre brazo y costado— y dos piernas que se funden
       con el terreno. Todo espejado sobre el eje x384. */

    /* silueta del torso, para clip: hombros en y268, cintura en y560 */
    const torso = new Path2D();
    torso.moveTo(384, 148);
    torso.bezierCurveTo(452, 168, 496, 216, 508, 276);
    torso.bezierCurveTo(492, 372, 470, 452, 458, 556);
    torso.bezierCurveTo(452, 660, 462, 760, 470, 862);
    torso.lineTo(298, 862);
    torso.bezierCurveTo(306, 760, 316, 660, 310, 556);
    torso.bezierCurveTo(298, 452, 276, 372, 260, 276);
    torso.bezierCurveTo(272, 216, 316, 168, 384, 148);
    torso.closePath();

    /* brazos: masa gruesa que sale del hombro, abre y vuelve. Se pintan
       ANTES del torso para que el costado los recorte. */
    for (const s2 of [-1, 1]) {
      const via = () => {
        f.beginPath();
        f.moveTo(384 + s2 * 124, 280);
        f.bezierCurveTo(384 + s2 * 206, 340, 384 + s2 * 222, 520, 384 + s2 * 196, 700);
      };
      f.lineCap = "round";
      f.strokeStyle = tinta("38,44,34", 0.62);
      f.lineWidth = 84; via(); f.stroke();
      f.strokeStyle = tinta("116,116,96", 0.4);
      f.lineWidth = 62; via(); f.stroke();
      /* canto iluminado del brazo, hacia fuera */
      f.save();
      f.translate(s2 * 20, 0);
      f.strokeStyle = tinta("192,188,160", 0.3);
      f.lineWidth = 22; via(); f.stroke();
      f.restore();
      /* la referencia no tiene una silueta lisa: rompe el canto con
         cordón de liana y bloque suelto */
      for (let k = 0; k < 34; k++) {
        const u = k / 33;
        const bx = 384 + s2 * (124 + (206 - 124) * u * 1.5 - u * u * 90);
        const by = 280 + u * 420;
        f.fillStyle = rnd() < 0.5 ? tinta("22,28,20", 0.5) : tinta("176,172,146", 0.2);
        f.fillRect(bx - 20 + rnd() * 40, by, 6 + rnd() * 22, 5 + rnd() * 12);
      }
      /* mano: garra de tres dedos, como en la referencia */
      const mx = 384 + s2 * 196, my = 700;
      f.strokeStyle = tinta("34,40,30", 0.7);
      f.lineWidth = 15;
      for (let k = 0; k < 3; k++) {
        f.beginPath();
        f.moveTo(mx, my);
        f.quadraticCurveTo(mx + s2 * (10 - k * 12), my + 58, mx - s2 * (14 + k * 20), my + 96);
        f.stroke();
      }
      f.strokeStyle = tinta("150,148,124", 0.28);
      f.lineWidth = 6;
      for (let k = 0; k < 3; k++) {
        f.beginPath();
        f.moveTo(mx, my);
        f.quadraticCurveTo(mx + s2 * (10 - k * 12), my + 58, mx - s2 * (14 + k * 20), my + 96);
        f.stroke();
      }
      f.lineCap = "butt";
    }

    /* piernas: dos columnas que se pierden en el terreno */
    for (const s2 of [-1, 1]) {
      f.fillStyle = tinta("40,46,36", 0.7);
      f.beginPath();
      f.moveTo(384 + s2 * 26, 800);
      f.lineTo(384 + s2 * 118, 812);
      f.lineTo(384 + s2 * 104, 968);
      f.lineTo(384 + s2 * 34, 962);
      f.closePath(); f.fill();
      f.fillStyle = tinta("128,128,108", 0.14);
      f.fillRect(384 + s2 * 44, 812, s2 * 40, 148);
    }

    /* masa del torso */
    f.fillStyle = tinta("40,46,36", 0.72);
    f.fill(torso);

    /* piedra y fibra DENTRO de la silueta */
    f.save();
    f.clip(torso);
    for (const b of bloques) {
      for (const s2 of [-1, 1]) {
        f.save();
        f.translate(384 + s2 * b.x * 0.72, b.y);
        f.rotate(b.giro * s2);
        f.fillStyle = tinta(PIEDRA, b.o * 0.5);
        f.beginPath();
        f.moveTo(-b.w / 2, -b.h / 2 + (b.o - 0.2) * 6);
        f.lineTo(b.w / 2, -b.h / 2);
        f.lineTo(b.w / 2 - 2, b.h / 2);
        f.lineTo(-b.w / 2 + 1, b.h / 2 - (b.o - 0.2) * 5);
        f.closePath(); f.fill();
        f.strokeStyle = tinta("206,200,174", b.o * 0.36);
        f.lineWidth = 0.6; f.stroke();
        f.restore();
      }
    }
    /* fibra vertical: la piel del titán es cordón de liana y musgo, no
       muro liso. Es lo que le da el ruido de alta frecuencia que la
       referencia tiene en toda la figura. */
    for (let k = 0; k < 520; k++) {
      const t = rnd();
      const x = 384 + (rnd() - 0.5) * 2 * (150 - t * 46);
      const y0 = 160 + rnd() * 640;
      const largo = 40 + rnd() * 190;
      f.strokeStyle = rnd() < 0.52
        ? tinta("22,28,20", 0.4 + rnd() * 0.4)
        : tinta("142,144,114", 0.13 + rnd() * 0.3);
      f.lineWidth = 0.6 + rnd() * 1.5;
      f.beginPath();
      f.moveTo(x, y0);
      f.quadraticCurveTo(x + (rnd() - 0.5) * 16, y0 + largo * 0.5, x + (rnd() - 0.5) * 22, y0 + largo);
      f.stroke();
    }
    f.restore();

    /* hombreras: dos placas de piedra sobre los hombros */
    for (const s2 of [-1, 1]) {
      f.fillStyle = tinta("54,60,48", 0.72);
      f.beginPath();
      f.moveTo(384 + s2 * 96, 250);
      f.lineTo(384 + s2 * 212, 286);
      f.lineTo(384 + s2 * 196, 352);
      f.lineTo(384 + s2 * 92, 330);
      f.closePath(); f.fill();
      f.strokeStyle = tinta("192,188,160", 0.26);
      f.lineWidth = 1.2; f.stroke();
    }

    /* corona de cristal */
    for (const p of coronaPicos) {
      f.save();
      f.translate(p.x, p.base);
      f.rotate(p.incl);
      const gr = f.createLinearGradient(0, 0, 0, -p.alto);
      gr.addColorStop(0, tinta("40,72,48", 0.55));
      gr.addColorStop(0.6, tinta("78,130,86", 0.34));
      gr.addColorStop(1, tinta("158,206,168", 0.5));
      f.fillStyle = gr;
      f.beginPath();
      f.moveTo(-p.w, 0); f.lineTo(0, -p.alto); f.lineTo(p.w, 0);
      f.closePath(); f.fill();
      f.strokeStyle = tinta("190,250,200", 0.4);
      f.lineWidth = 0.9;
      f.stroke();
      f.restore();
    }

    /* cristales del torso y de los hombros */
    for (const c of cristales) {
      f.save();
      f.translate(c.x, c.y);
      f.rotate(c.incl);
      const gr = f.createLinearGradient(0, 0, 0, -c.h);
      gr.addColorStop(0, tinta("32,72,48", 0.5));
      gr.addColorStop(0.55, tinta("88,168,112", 0.44));
      gr.addColorStop(1, tinta("186,238,198", 0.62));
      f.fillStyle = gr;
      f.beginPath();
      f.moveTo(-c.w / 2, 0); f.lineTo(-c.w / 2, -c.h * 0.6);
      f.lineTo(0, -c.h); f.lineTo(c.w / 2, -c.h * 0.6); f.lineTo(c.w / 2, 0);
      f.closePath(); f.fill();
      f.strokeStyle = tinta("190,255,205", 0.35);
      f.lineWidth = 0.7; f.stroke();
      f.restore();
    }

    /* lianas colgantes */
    for (const l of lianas) {
      f.strokeStyle = tinta(ORO, l.o * 0.8);
      f.lineWidth = 0.7;
      f.beginPath();
      f.moveTo(l.x, l.y0);
      f.quadraticCurveTo(l.x + l.curva, l.y0 + l.largo * 0.6, l.x + l.curva * 0.4, l.y0 + l.largo);
      f.stroke();
    }

    /* rostro: cuenca de piedra bajo la corona (medido y164..221) */
    f.fillStyle = tinta("34,42,36", 0.5);
    f.beginPath(); f.ellipse(HEAD.x, 192, 42, 30, 0, 0, Math.PI * 2); f.fill();
    f.strokeStyle = tinta(PIEDRA, 0.4);
    f.lineWidth = 1.2;
    f.beginPath(); f.ellipse(HEAD.x, 192, 42, 30, 0, 0, Math.PI * 2); f.stroke();
    for (const s2 of [-1, 1]) {
      f.strokeStyle = tinta(PIEDRA, 0.4);
      f.lineWidth = 1;
      f.beginPath();
      f.moveTo(HEAD.x + s2 * 12, 200);
      f.lineTo(HEAD.x + s2 * 18, 226);
      f.stroke();
    }

    /* ── plaza ── */
    /* escalinatas y anillos concéntricos en perspectiva */
    for (let k = 8; k >= 1; k--) {
      const rx = 40 + k * 26, ry = (40 + k * 26) * 0.29;
      f.strokeStyle = tinta(ORO, 0.09 + (k % 2) * 0.09);
      f.lineWidth = k % 3 === 0 ? 1.4 : 0.8;
      f.beginPath(); f.ellipse(PLAZA.x, PLAZA.y, rx, ry, 0, 0, Math.PI * 2); f.stroke();
    }
    f.fillStyle = tinta("150,146,124", 0.17);
    f.beginPath(); f.ellipse(PLAZA.x, PLAZA.y, 250, 74, 0, 0, Math.PI * 2); f.fill();
    f.fillStyle = tinta("162,158,134", 0.11);
    f.beginPath(); f.ellipse(PLAZA.x, PLAZA.y + 6, 176, 52, 0, 0, Math.PI * 2); f.fill();
    for (let k = 0; k < 32; k++) {
      const a = (k / 32) * Math.PI * 2;
      f.strokeStyle = tinta(ORO, 0.1);
      f.lineWidth = 0.6;
      f.beginPath();
      f.moveTo(PLAZA.x + Math.cos(a) * 44, PLAZA.y + Math.sin(a) * 13);
      f.lineTo(PLAZA.x + Math.cos(a) * 246, PLAZA.y + Math.sin(a) * 72);
      f.stroke();
    }
    /* el vado: la referencia abre un agua iluminada entre el titán y
       la plaza, y sin ella el eje caía 32 puntos por debajo. */
    const vado = f.createRadialGradient(PLAZA.x, 830, 10, PLAZA.x, 830, 210);
    vado.addColorStop(0, tinta("158,172,148", 0.34));
    vado.addColorStop(0.5, tinta("120,138,118", 0.16));
    vado.addColorStop(1, "rgba(0,0,0,0)");
    f.fillStyle = vado;
    f.beginPath(); f.ellipse(PLAZA.x, 830, 210, 120, 0, 0, Math.PI * 2); f.fill();

    /* escalones del frente */
    for (let k = 0; k < 7; k++) {
      const y = 1078 + k * 12;
      const w = 128 - k * 4;
      f.strokeStyle = tinta(PIEDRA, 0.4);
      f.lineWidth = 1.6;
      f.beginPath(); f.moveTo(PLAZA.x - w, y); f.lineTo(PLAZA.x + w, y); f.stroke();
    }

    /* obeliscos */
    for (let i = 0; i < obeliscos.length; i++) {
      const o = obeliscos[i];
      const alto = o.y1 - o.y0;
      const gr = f.createLinearGradient(o.x - o.w / 2, 0, o.x + o.w / 2, 0);
      gr.addColorStop(0, tinta("62,66,56", 0.85));
      gr.addColorStop(0.42, tinta("136,134,118", 0.7));
      gr.addColorStop(1, tinta("46,50,42", 0.9));
      f.fillStyle = gr;
      f.beginPath();
      f.moveTo(o.x - o.w / 2, o.y1);
      f.lineTo(o.x - o.w / 2 + 2, o.y0 + 10);
      f.lineTo(o.x, o.y0);
      f.lineTo(o.x + o.w / 2 - 2, o.y0 + 10);
      f.lineTo(o.x + o.w / 2, o.y1);
      f.closePath(); f.fill();
      f.strokeStyle = tinta("196,190,164", 0.3);
      f.lineWidth = 0.8; f.stroke();
      /* glifos: marcas con semilla, nunca texto inventado */
      const n = Math.max(2, Math.round(alto / 46));
      for (let k = 0; k < n; k++) {
        const gl = glifosObeliscoJS[(i * 3 + k) % glifosObeliscoJS.length];
        const y = o.y0 + 26 + k * (alto - 40) / n;
        const rr = Math.min(9, o.w * 0.3);
        f.strokeStyle = tinta(VERDE_VIVO, 0.8);
        f.lineWidth = 1;
        if (gl.anillo) { f.beginPath(); f.arc(o.x, y, rr, 0, Math.PI * 2); f.stroke(); }
        for (let b = 0; b < gl.brazos; b++) {
          const a = gl.giro + (b / gl.brazos) * Math.PI * 2;
          f.beginPath();
          f.moveTo(o.x, y);
          f.lineTo(o.x + Math.cos(a) * rr, y + Math.sin(a) * rr);
          f.stroke();
        }
      }
    }

    /* figurillas */
    for (const fg of figuras) {
      f.fillStyle = tinta("30,34,28", 0.75);
      f.beginPath();
      f.ellipse(fg.x, fg.y - fg.h * 0.8, fg.h * 0.16, fg.h * 0.18, 0, 0, Math.PI * 2);
      f.fill();
      f.fillRect(fg.x - fg.h * 0.16, fg.y - fg.h * 0.62, fg.h * 0.32, fg.h * 0.62);
      f.fillStyle = tinta("200,190,160", 0.2);
      f.fillRect(fg.x - fg.h * 0.1, fg.y - fg.h * 0.6, fg.h * 0.1, fg.h * 0.5);
    }

    /* flores encendidas de los cantos bajos */
    for (const fl of flores) {
      const gr = f.createRadialGradient(fl.x, fl.y, 0, fl.x, fl.y, fl.r);
      gr.addColorStop(0, tinta(fl.c, fl.o));
      gr.addColorStop(0.4, tinta(fl.c, fl.o * 0.45));
      gr.addColorStop(1, "rgba(0,0,0,0)");
      f.fillStyle = gr;
      f.beginPath(); f.arc(fl.x, fl.y, fl.r, 0, Math.PI * 2); f.fill();
      /* pétalos como manchas, no como radios: con líneas rectas las
         flores salían copos de nieve y la referencia tiene corolas. */
      for (let k = 0; k < 5; k++) {
        const a = (k / 5) * Math.PI * 2 + fl.r;
        f.fillStyle = tinta(fl.c, fl.o * 0.85);
        f.beginPath();
        f.ellipse(fl.x + Math.cos(a) * fl.r * 0.4, fl.y + Math.sin(a) * fl.r * 0.4,
                  fl.r * 0.34, fl.r * 0.2, a, 0, Math.PI * 2);
        f.fill();
      }
    }

    /* aves */
    for (const av of aves) {
      f.strokeStyle = tinta("40,44,44", av.o);
      f.lineWidth = 1.1;
      f.beginPath();
      f.moveTo(av.x - av.s, av.y);
      f.quadraticCurveTo(av.x - av.s * 0.4, av.y - av.s * 0.6, av.x, av.y - av.s * 0.1);
      f.quadraticCurveTo(av.x + av.s * 0.4, av.y - av.s * 0.6, av.x + av.s, av.y);
      f.stroke();
    }

    /* grano */
    for (const p of grano) {
      f.fillStyle = tinta(p.c, p.o);
      f.fillRect(p.x, p.y, p.s, p.s);
    }

    /* VIÑETA ELÍPTICA · los focos están donde el mapa de luminancia
       tiene sus máximos (eje central y banda alta) y la caída a negro
       va a los cantos. Sin esto los bordes quedan más claros que la
       referencia y el diff los cobra entero. */
    const vin = f.createRadialGradient(CX, 430, 150, CX, 470, 760);
    vin.addColorStop(0, "rgba(5,7,10,0)");
    vin.addColorStop(0.62, "rgba(5,7,10,0)");
    vin.addColorStop(0.88, "rgba(5,7,10,0.14)");
    vin.addColorStop(1, "rgba(5,7,10,0.42)");
    f.fillStyle = vin;
    f.fillRect(0, 0, W, H);
    /* cierre a los cuatro cantos: la referencia muere en negro contra
       el marco, y los últimos 3 px pesan en cada región del borde */
    const lat = f.createLinearGradient(0, 0, W, 0);
    lat.addColorStop(0, "rgba(5,7,10,0.95)");
    lat.addColorStop(0.02, "rgba(5,7,10,0)");
    lat.addColorStop(0.98, "rgba(5,7,10,0)");
    lat.addColorStop(1, "rgba(5,7,10,0.95)");
    f.fillStyle = lat; f.fillRect(0, 0, W, H);
    const ver = f.createLinearGradient(0, 0, 0, H);
    ver.addColorStop(0, "rgba(5,7,10,0.9)");
    ver.addColorStop(0.014, "rgba(5,7,10,0)");
    ver.addColorStop(0.992, "rgba(5,7,10,0)");
    ver.addColorStop(1, "rgba(5,7,10,0.55)");
    f.fillStyle = ver; f.fillRect(0, 0, W, H);
  }

  /* ── piezas vivas ────────────────────────────────────────────────*/
  function pintarMandala(fase: number) {
    const pulso = 0.84 + 0.16 * Math.sin(fase * Math.PI * 2);
    g.save();
    g.globalCompositeOperation = "lighter";
    for (let i = 0; i < anillos.length; i++) {
      const r = anillos[i];
      g.strokeStyle = tinta(ORO, (0.062 + (i % 2) * 0.055) * pulso);
      g.lineWidth = i % 3 === 0 ? 1.3 : 0.8;
      g.beginPath(); g.arc(MAN.x, MAN.y, r, 0, Math.PI * 2); g.stroke();
    }
    for (let k = 0; k < 24; k++) {
      const a = (k / 24) * Math.PI * 2;
      g.strokeStyle = tinta(ORO, 0.034 * pulso);
      g.lineWidth = 0.6;
      g.beginPath();
      g.moveTo(MAN.x + Math.cos(a) * 58, MAN.y + Math.sin(a) * 58);
      g.lineTo(MAN.x + Math.cos(a) * 204, MAN.y + Math.sin(a) * 204);
      g.stroke();
    }
    for (const gl of glifosMandala) {
      const x = MAN.x + Math.cos(gl.a) * gl.r, y = MAN.y + Math.sin(gl.a) * gl.r;
      g.strokeStyle = tinta(ORO, 0.13 * pulso);
      g.lineWidth = 0.8;
      g.beginPath(); g.arc(x, y, gl.s, 0, Math.PI * 2); g.stroke();
      for (let b = 0; b < 3; b++) {
        const a2 = gl.a + b * 2.1;
        g.beginPath();
        g.moveTo(x, y);
        g.lineTo(x + Math.cos(a2) * gl.s, y + Math.sin(a2) * gl.s);
        g.stroke();
      }
    }
    /* triángulos entrelazados del centro */
    for (const rot of [0, Math.PI]) {
      g.strokeStyle = tinta(ORO, 0.13 * pulso);
      g.lineWidth = 1;
      g.beginPath();
      for (let k = 0; k < 3; k++) {
        const a = rot + (k / 3) * Math.PI * 2 - Math.PI / 2;
        const x = MAN.x + Math.cos(a) * 138, y = MAN.y + Math.sin(a) * 138;
        k ? g.lineTo(x, y) : g.moveTo(x, y);
      }
      g.closePath(); g.stroke();
    }
    g.restore();
  }

  function pintarLuces(fase: number) {
    const pulso = 0.82 + 0.18 * Math.sin(fase * Math.PI * 2);
    g.save();
    g.globalCompositeOperation = "lighter";

    /* ojos del titán */
    for (const s of [-1, 1]) {
      const x = HEAD.x + s * 18, y = HEAD.y - 4;
      const gr = g.createRadialGradient(x, y, 0, x, y, 16);
      gr.addColorStop(0, tinta("210,255,200", 0.95 * pulso));
      gr.addColorStop(0.3, tinta(VERDE_VIVO, 0.4 * pulso));
      gr.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = gr;
      g.beginPath(); g.arc(x, y, 16, 0, Math.PI * 2); g.fill();
    }

    /* sigilo del pecho: el foco más fuerte del arte */
    const pe = g.createRadialGradient(PECHO.x, PECHO.y, 2, PECHO.x, PECHO.y, 96);
    pe.addColorStop(0, tinta("225,255,215", 0.85 * pulso));
    pe.addColorStop(0.16, tinta(VERDE_VIVO, 0.4 * pulso));
    pe.addColorStop(0.45, tinta("70,170,90", 0.08 * pulso));
    pe.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = pe;
    g.beginPath(); g.arc(PECHO.x, PECHO.y, 96, 0, Math.PI * 2); g.fill();
    g.strokeStyle = tinta("200,255,200", 0.75 * pulso);
    g.lineWidth = 1.6;
    g.beginPath(); g.arc(PECHO.x, PECHO.y, 44, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta(ORO, 0.6 * pulso);
    g.lineWidth = 1;
    g.beginPath(); g.arc(PECHO.x, PECHO.y, 34, 0, Math.PI * 2); g.stroke();
    for (let k = 0; k < 8; k++) {
      const a = (k / 8) * Math.PI * 2;
      g.strokeStyle = tinta("220,255,215", 0.55 * pulso);
      g.lineWidth = k % 2 ? 0.8 : 1.4;
      g.beginPath();
      g.moveTo(PECHO.x, PECHO.y);
      g.lineTo(PECHO.x + Math.cos(a) * 44, PECHO.y + Math.sin(a) * 44);
      g.stroke();
    }

    /* prisma de la plaza y su haz */
    const haz = g.createLinearGradient(PRISMA.x - 26, 0, PRISMA.x + 26, 0);
    haz.addColorStop(0, "rgba(0,0,0,0)");
    haz.addColorStop(0.5, tinta(VERDE_VIVO, 0.12 * pulso));
    haz.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = haz;
    g.fillRect(PRISMA.x - 26, 700, 52, PRISMA.base - 700);
    const cuerpo = g.createLinearGradient(0, PRISMA.base, 0, PRISMA.base - PRISMA.alto);
    cuerpo.addColorStop(0, tinta("240,255,235", 0.75 * pulso));
    cuerpo.addColorStop(0.3, tinta(VERDE_VIVO, 0.45 * pulso));
    cuerpo.addColorStop(1, tinta("120,220,140", 0.26 * pulso));
    g.fillStyle = cuerpo;
    g.beginPath();
    g.moveTo(PRISMA.x - PRISMA.w / 2, PRISMA.base);
    g.lineTo(PRISMA.x - PRISMA.w / 2 + 5, PRISMA.base - PRISMA.alto + 26);
    g.lineTo(PRISMA.x, PRISMA.base - PRISMA.alto);
    g.lineTo(PRISMA.x + PRISMA.w / 2 - 5, PRISMA.base - PRISMA.alto + 26);
    g.lineTo(PRISMA.x + PRISMA.w / 2, PRISMA.base);
    g.closePath(); g.fill();
    const halo = g.createRadialGradient(PRISMA.x, PRISMA.base - 20, 4, PRISMA.x, PRISMA.base - 20, 108);
    halo.addColorStop(0, tinta("235,255,230", 0.2 * pulso));
    halo.addColorStop(0.2, tinta(VERDE_VIVO, 0.06 * pulso));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo;
    g.beginPath(); g.arc(PRISMA.x, PRISMA.base - 20, 108, 0, Math.PI * 2); g.fill();

    /* racimo: la referencia no tiene un prisma solo sino tres o
       cuatro esquirlas de distinto alto contra el eje */
    for (const [dx, alto, ancho] of [[-24, 168, 18], [22, 196, 20], [-11, 118, 13], [13, 132, 14]] as const) {
      const gr = g.createLinearGradient(0, PRISMA.base, 0, PRISMA.base - alto);
      gr.addColorStop(0, tinta("210,246,206", 0.5 * pulso));
      gr.addColorStop(1, tinta("120,214,140", 0.22 * pulso));
      g.fillStyle = gr;
      g.beginPath();
      g.moveTo(PRISMA.x + dx - ancho / 2, PRISMA.base);
      g.lineTo(PRISMA.x + dx, PRISMA.base - alto);
      g.lineTo(PRISMA.x + dx + ancho / 2, PRISMA.base);
      g.closePath(); g.fill();
    }
    /* estrella de la base */
    for (let k = 0; k < 4; k++) {
      const a = (k / 4) * Math.PI * 2 + Math.PI / 4;
      g.strokeStyle = tinta("236,255,232", 0.5 * pulso);
      g.lineWidth = k % 2 ? 1.2 : 2;
      g.beginPath();
      g.moveTo(PRISMA.x, PRISMA.base - 6);
      g.lineTo(PRISMA.x + Math.cos(a) * (k % 2 ? 34 : 62), PRISMA.base - 6 + Math.sin(a) * (k % 2 ? 34 : 62) * 0.5);
      g.stroke();
    }

    /* anillo encendido de la plaza */
    g.strokeStyle = tinta(VERDE_VIVO, 0.19 * pulso);
    g.lineWidth = 1.6;
    g.beginPath(); g.ellipse(PLAZA.x, PLAZA.y, 118, 34, 0, 0, Math.PI * 2); g.stroke();
    g.restore();
  }

  /* ── instrumentos del riel derecho ──────────────────────────────*/
  const medidor = document.getElementById("gs-medidor") as HTMLCanvasElement | null;
  const orbitas = document.getElementById("gs-orbitas") as HTMLCanvasElement | null;
  const pulso = document.getElementById("gs-pulso") as HTMLCanvasElement | null;
  const globo = document.getElementById("gs-globo") as HTMLCanvasElement | null;

  const rMapa = rng(0x27e1);
  const continentes = Array.from({ length: 15 }, () => ({
    a: rMapa() * Math.PI * 2,
    r: rMapa() * 0.82,
    rx: 0.1 + rMapa() * 0.24,
    ry: 0.08 + rMapa() * 0.2,
    giro: rMapa() * Math.PI,
  }));
  const rPulso = rng(0x27e5);
  const seriePulso = Array.from({ length: 74 }, (_, i) =>
    (i % 9 === 0 ? 0.5 + rPulso() * 0.5 : rPulso() * 0.4)
  );

  function pintarMedidor(fase: number) {
    if (!medidor) return;
    const c = medidor.getContext("2d")!;
    const S = 152, cx = S / 2, cy = S / 2, R = 58;
    const p = 0.86 + 0.14 * Math.sin(fase * Math.PI * 2);
    c.clearRect(0, 0, S, S);
    /* vidrio del disco */
    const disco = c.createRadialGradient(cx, cy - 8, 6, cx, cy, R + 14);
    disco.addColorStop(0, "rgba(18,30,20,0.9)");
    disco.addColorStop(1, "rgba(4,10,6,0.9)");
    c.fillStyle = disco;
    c.beginPath(); c.arc(cx, cy, R + 14, 0, Math.PI * 2); c.fill();
    /* arco de 92,7 %: 24 segmentos, el hueco arriba a la izquierda */
    const N = 24, lleno = Math.round(N * 0.927);
    for (let k = 0; k < N; k++) {
      const a0 = -Math.PI / 2 + (k / N) * Math.PI * 2 + 0.03;
      const a1 = -Math.PI / 2 + ((k + 1) / N) * Math.PI * 2 - 0.03;
      c.strokeStyle = k < lleno ? tinta("110,215,120", 0.85 * p) : "rgba(40,60,44,0.55)";
      c.lineWidth = 15;
      c.beginPath(); c.arc(cx, cy, R, a0, a1); c.stroke();
    }
    c.strokeStyle = tinta(ORO, 0.4);
    c.lineWidth = 1;
    c.beginPath(); c.arc(cx, cy, R + 12, 0, Math.PI * 2); c.stroke();
    c.beginPath(); c.arc(cx, cy, R - 11, 0, Math.PI * 2); c.stroke();
    for (let k = 0; k < 4; k++) {
      const a = (k / 4) * Math.PI * 2;
      c.strokeStyle = tinta(ORO, 0.3);
      c.beginPath();
      c.moveTo(cx + Math.cos(a) * (R - 10), cy + Math.sin(a) * (R - 10));
      c.lineTo(cx + Math.cos(a) * (R + 12), cy + Math.sin(a) * (R + 12));
      c.stroke();
    }
    /* la rama del centro */
    c.strokeStyle = tinta("222,214,150", 0.9);
    c.lineWidth = 1.6;
    c.beginPath(); c.moveTo(cx, cy + 28); c.lineTo(cx, cy - 30); c.stroke();
    for (let k = 0; k < 3; k++) {
      const y = cy + 16 - k * 15;
      for (const s of [-1, 1]) {
        c.beginPath();
        c.moveTo(cx, y);
        c.quadraticCurveTo(cx + s * (20 - k * 3), y - 4, cx + s * (24 - k * 4), y - 16);
        c.quadraticCurveTo(cx + s * (10 - k), y - 8, cx, y);
        c.strokeStyle = tinta("222,214,150", 0.85);
        c.lineWidth = 1.2;
        c.stroke();
        c.fillStyle = tinta("150,210,120", 0.14 * p);
        c.fill();
      }
    }
    c.beginPath();
    c.moveTo(cx, cy - 30);
    c.quadraticCurveTo(cx - 7, cy - 40, cx, cy - 52);
    c.quadraticCurveTo(cx + 7, cy - 40, cx, cy - 30);
    c.strokeStyle = tinta("222,214,150", 0.9);
    c.stroke();
  }

  function pintarOrbitas(fase: number) {
    if (!orbitas) return;
    const c = orbitas.getContext("2d")!;
    const S = 186, cx = S / 2, cy = S / 2;
    c.clearRect(0, 0, S, S);
    const tierra = c.createRadialGradient(cx - 6, cy - 10, 3, cx, cy, 46);
    tierra.addColorStop(0, "rgba(90,140,110,0.5)");
    tierra.addColorStop(0.7, "rgba(30,60,55,0.35)");
    tierra.addColorStop(1, "rgba(0,0,0,0)");
    c.fillStyle = tierra;
    c.beginPath(); c.arc(cx, cy, 46, 0, Math.PI * 2); c.fill();
    for (const [r, o] of [[26, 0.5], [42, 0.4], [58, 0.32], [74, 0.24], [88, 0.18]] as const) {
      c.strokeStyle = tinta(ORO, o);
      c.lineWidth = r === 42 ? 1.2 : 0.8;
      c.beginPath(); c.ellipse(cx, cy, r, r, 0, 0, Math.PI * 2); c.stroke();
    }
    c.strokeStyle = tinta(ORO, 0.22);
    c.setLineDash([2, 4]);
    c.beginPath(); c.ellipse(cx, cy, 66, 66, 0, 0, Math.PI * 2); c.stroke();
    c.setLineDash([]);
    c.strokeStyle = tinta(ORO, 0.3);
    c.beginPath(); c.moveTo(cx, 6); c.lineTo(cx, S - 6); c.moveTo(6, cy); c.lineTo(S - 6, cy); c.stroke();
    for (let k = 0; k < 4; k++) {
      const a = (k / 4) * Math.PI * 2 + fase * Math.PI * 2 * 0.2;
      const r = [42, 58, 74, 88][k];
      c.fillStyle = tinta(k === 3 ? "120,235,140" : ORO, 0.9);
      c.beginPath(); c.arc(cx + Math.cos(a) * r, cy + Math.sin(a) * r, 2.6, 0, Math.PI * 2); c.fill();
    }
    c.fillStyle = tinta("120,235,140", 0.8);
    c.beginPath(); c.arc(cx, cy + 74, 4, 0, Math.PI * 2); c.fill();
    c.strokeStyle = tinta(ORO, 0.7);
    c.lineWidth = 1.4;
    c.beginPath(); c.arc(cx, cy, 11, 0, Math.PI * 2); c.stroke();
    c.fillStyle = tinta("120,200,120", 0.6);
    c.beginPath(); c.arc(cx, cy, 9, 0, Math.PI * 2); c.fill();
  }

  function pintarPulso(fase: number) {
    if (!pulso) return;
    const c = pulso.getContext("2d")!;
    const Wp = 112, Hp = 34, eje = Hp / 2;
    c.clearRect(0, 0, Wp, Hp);
    c.strokeStyle = tinta("110,215,120", 0.85);
    c.lineWidth = 1;
    c.beginPath();
    for (let k = 0; k < seriePulso.length; k++) {
      const x = (k / (seriePulso.length - 1)) * Wp;
      const v = seriePulso[k] * (0.8 + 0.2 * Math.sin(fase * Math.PI * 2 + k * 0.4));
      const y = eje - (k % 2 ? v : -v) * eje * 0.92;
      k ? c.lineTo(x, y) : c.moveTo(x, y);
    }
    c.stroke();
  }

  function pintarGlobo(fase: number) {
    if (!globo) return;
    const c = globo.getContext("2d")!;
    const S = 186, cx = S / 2, cy = S / 2, R = 74;
    c.clearRect(0, 0, S, S);
    const at = c.createRadialGradient(cx, cy, R * 0.7, cx, cy, R + 12);
    at.addColorStop(0, "rgba(40,90,80,0.3)");
    at.addColorStop(1, "rgba(0,0,0,0)");
    c.fillStyle = at;
    c.beginPath(); c.arc(cx, cy, R + 12, 0, Math.PI * 2); c.fill();
    c.fillStyle = "rgba(14,32,30,0.85)";
    c.beginPath(); c.arc(cx, cy, R, 0, Math.PI * 2); c.fill();
    /* masas de tierra: elipses con semilla, no un mapa real */
    c.save();
    c.beginPath(); c.arc(cx, cy, R, 0, Math.PI * 2); c.clip();
    for (const k of continentes) {
      c.save();
      c.translate(cx + Math.cos(k.a) * k.r * R, cy + Math.sin(k.a) * k.r * R * 0.9);
      c.rotate(k.giro);
      c.fillStyle = tinta("120,180,90", 0.42);
      c.beginPath(); c.ellipse(0, 0, k.rx * R, k.ry * R, 0, 0, Math.PI * 2); c.fill();
      c.strokeStyle = tinta("190,215,130", 0.35);
      c.lineWidth = 0.8; c.stroke();
      c.restore();
    }
    /* rejilla de paralelos y meridianos */
    for (let k = 1; k < 6; k++) {
      c.strokeStyle = tinta(ORO, 0.16);
      c.lineWidth = 0.6;
      c.beginPath(); c.ellipse(cx, cy, R, (R * k) / 6, 0, 0, Math.PI * 2); c.stroke();
      c.beginPath(); c.ellipse(cx, cy, (R * k) / 6, R, 0, 0, Math.PI * 2); c.stroke();
    }
    c.restore();
    c.strokeStyle = tinta(ORO, 0.5);
    c.lineWidth = 1;
    c.beginPath(); c.arc(cx, cy, R, 0, Math.PI * 2); c.stroke();
    c.setLineDash([2, 5]);
    c.strokeStyle = tinta(ORO, 0.3);
    c.beginPath(); c.arc(cx, cy, R + 12, 0, Math.PI * 2); c.stroke();
    c.setLineDash([]);
    c.strokeStyle = tinta("120,215,140", 0.4);
    c.beginPath(); c.moveTo(cx, 4); c.lineTo(cx, S - 4); c.moveTo(4, cy); c.lineTo(S - 4, cy); c.stroke();
    const nucleo = 0.7 + 0.3 * Math.sin(fase * Math.PI * 2);
    c.fillStyle = tinta("160,255,170", 0.9 * nucleo);
    c.beginPath(); c.arc(cx, cy, 3.2, 0, Math.PI * 2); c.fill();
  }

  /* ── el cuadro ───────────────────────────────────────────────────*/
  const pintar = (fase: number) => {
    g.clearRect(0, 0, W, H);
    g.drawImage(fondo, 0, 0);
    pintarMandala(fase);
    pintarLuces(fase);
    pintarMedidor(fase);
    pintarOrbitas(fase);
    pintarPulso(fase);
    pintarGlobo(fase);
  };

  montarLienzo({ raiz, cuadro: pintar, inicial: pintarFondo, periodo: 26000, periodoReducido: 64000 });
  montarEscala();
</script>
