/**
 * KODEX−∞ · LÁMINA DE ARCHIVO · GAIA SENTINEL · PAGE 27
 *
 * Reproducción en código de reference/pendientes/a27-gaia-sentinel-canon.png
 * (1229×1536). Décima de la serie de archivo: mismo cromo que
 * mycelial-oracle (a23) y silence-engine (a28) —los componentes de
 * src/components/kodex/archivo/ en cajas absolutas medidas— con el
 * organismo central pintado en canvas procedural.
 *
 * CANON: hay dos archivos para esta página, `-canon` y
 * `-visual-variant`. Sólo se reproduce el CANON; la variante no entra
 * en esta lámina ni como referencia parcial.
 *
 * TODO el texto visible está TRANSCRITO de la referencia. Nada se
 * inventa. Lo que no se lee no se escribe: los sigilos de los paneles
 * y los glifos de los obeliscos son geometría con semilla, no letra.
 *
 * MEDIDO sobre la referencia (scripts/lamina/gs/probe.mjs, perfil de
 * tinta por fila/columna):
 * · marco: verticales x11 y x1217 (exterior), x15/16 y x1211/1212
 *   (interior); horizontales y11/y1525 y y16/y1520.
 * · cabecera: reglas del cartucho en y63 y y68. «KODEX−∞» versales
 *   y30..52 (versal 22) x59..231; «UNIVERSAL ARCHIVE» y30..45
 *   (versal 15) x469..747; «PAGE» x1034..1112 y «27» versales y27..52
 *   (versal 25) x1122..1175.
 * · título: «GAIA SENTINEL» versales y82..151 (versal 69) x260..982 —
 *   722 px de ancho, es la medida que manda sobre el cuerpo.
 *   Subtítulo «CENTINELA DE GAIA» versales y171..196 (versal 25)
 *   x376..854, con flechas ornamentales x329..366 y x863..900.
 * · riel izquierdo: cajas x26..225 (199 px). Paneles y99..423,
 *   y437..712, y728..1042, y1055..1352.
 * · riel derecho: cajas x1005..1198 (193 px). Paneles y101..495,
 *   y511..792, y807..1034, y1049..1352.
 * · arte: x230..998, y206..1368 (768×1162).
 * · pie: banda y1382..1490; versos y1401..1416, y1430..1445 y
 *   y1459..1479; barra inferior y1494..1527 con la línea en y1506..1518.
 *
 * LA LUZ ES EL 80 % DEL TRABAJO. Medido: la caja del arte tiene 92,9 %
 * de sus píxeles con tinta y luminancia media 89,8 — 829.307 px de los
 * 1.020.838 de toda la lámina. No es una caverna negra como a23: es un
 * valle a plena luz. Por eso el canvas arranca de un CAMPO DE AMBIENTE
 * MEDIDO (12×19 celdas de color medio, 64 px por celda) interpolado
 * bilinealmente: 228 muestras sobre 892.416 px, una resolución a la que
 * no hay dibujo, sólo luz. Sobre ese campo van las estructuras, que sí
 * son código: mandala, titán, obeliscos, cristal, cascadas, plaza.
 *
 * Paleta medida (pico de los píxeles altos de cada banda):
 * título crema rgb(228,215,183); subtítulo verde rgb(161,192,107);
 * marca y cromo oro rgb(186,163,110); rótulos de panel verde
 * rgb(152,163,118); valores oro rgb(187,166,118); cuerpo de bitácora
 * rgb(114,113,82); aforismo oro rgb(155,148,103).
 *
 * ICONOGRAFÍA: los nueve sigilos de SACRED SIGILS y el sello del pie
 * son formas geométricas genéricas (hexágonos, balanza, espiral,
 * gota, cornamenta, ojo). Se reproduce la FORMA, sin atribuirle
 * significado a ninguna tradición.
 */
import CabeceraArchivo from "../../../components/kodex/archivo/CabeceraArchivo.astro";
import TituloBilingue from "../../../components/kodex/archivo/TituloBilingue.astro";
import TarjetaMetrica from "../../../components/kodex/archivo/TarjetaMetrica.astro";
import AforismoPie from "../../../components/kodex/archivo/AforismoPie.astro";
import SelloClasificacion from "../../../components/kodex/archivo/SelloClasificacion.astro";
import { rng } from "../../../components/kodex/lamina/kit/rng";

/* ── geometría determinista del cromo (nunca Math.random) ───────────── */

/* Sigilo de GUARDIAN CLASS: hexágono con un cubo de aristas y cuatro
   nodos anillados. Geometría de construcción, no emblema de nadie. */
const rHex = rng(0x27a1);
const hexPts = Array.from({ length: 6 }, (_, i) => {
  const a = (i / 6) * Math.PI * 2 - Math.PI / 2;
  return [38 + 36 * Math.cos(a), 38 + 36 * Math.sin(a)];
});
const hexIn = Array.from({ length: 6 }, (_, i) => {
  const a = (i / 6) * Math.PI * 2 - Math.PI / 2;
  return [38 + 20 * Math.cos(a), 38 + 20 * Math.sin(a)];
});

/* Árbol del WORLD TREE SIGIL y del emblema de la bitácora: se ramifica
   con semilla y se espeja, como en la referencia. */
interface Trazo { d: string; o: number; w: number }
function ramificar(
  x: number, y: number, ang: number, largo: number, prof: number,
  r: () => number, out: Trazo[], hojas: Array<{ x: number; y: number; r: number }>,
) {
  if (prof <= 0 || largo < 1.6) return;
  const x2 = x + Math.cos(ang) * largo;
  const y2 = y + Math.sin(ang) * largo;
  const cx = x + Math.cos(ang - 0.22) * largo * 0.55;
  const cy = y + Math.sin(ang - 0.22) * largo * 0.55;
  out.push({
    d: `M${x.toFixed(1)} ${y.toFixed(1)} Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`,
    o: +(0.3 + prof * 0.11).toFixed(2),
    w: +(0.25 + prof * 0.34).toFixed(2),
  });
  if (prof <= 2 && r() < 0.7) hojas.push({ x: x2, y: y2, r: +(0.9 + r() * 1.5).toFixed(2) });
  const n = r() < 0.45 ? 3 : 2;
  for (let k = 0; k < n; k++) {
    const d = (k - (n - 1) / 2) * (0.42 + r() * 0.4);
    ramificar(x2, y2, ang + d + (r() - 0.5) * 0.18, largo * (0.66 + r() * 0.16), prof - 1, r, out, hojas);
  }
}

function arbol(semilla: number, cx: number, cy: number, esc: number) {
  const r = rng(semilla);
  const ramas: Trazo[] = [];
  const hojas: Array<{ x: number; y: number; r: number }> = [];
  const raices: Trazo[] = [];
  const puntas: Array<{ x: number; y: number; r: number }> = [];
  /* copa */
  for (let k = 0; k < 5; k++) {
    const a = -Math.PI / 2 + (k / 4 - 0.5) * Math.PI * 1.15;
    ramificar(cx, cy, a, 15 * esc + r() * 5 * esc, 5, r, ramas, hojas);
  }
  /* raíces */
  for (let k = 0; k < 5; k++) {
    const a = Math.PI / 2 + (k / 4 - 0.5) * Math.PI * 1.2;
    ramificar(cx, cy + 6 * esc, a, 13 * esc + r() * 4 * esc, 4, r, raices, puntas);
  }
  return { ramas, hojas, raices, puntas };
}
const arbolGrande = arbol(0x27b0, 90, 74, 1.5);
const arbolBitacora = arbol(0x27b4, 40, 34, 0.72);

/* Los nueve SACRED SIGILS: marco poligonal + una figura geométrica
   cada uno. La forma se reproduce; el significado no se inventa. */
const SIGILOS = [
  { et: "GAIA HEART" }, { et: "TERRAN BOND" }, { et: "GROWTH CYCLE" },
  { et: "WATER VEIL" }, { et: "STONE OATH" }, { et: "LIFE WEAVE" },
  { et: "BALANCE AXIS" }, { et: "WILD SPIRIT" }, { et: "ETERNAL WATCH" },
];
const marcoSigilo = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * Math.PI * 2 - Math.PI / 8;
  return `${(25 + 23 * Math.cos(a)).toFixed(1)},${(25 + 23 * Math.sin(a)).toFixed(1)}`;
}).join(" ");
/* espiral de GROWTH CYCLE */
const espiral = Array.from({ length: 68 }, (_, i) => {
  const t = (i / 67) * Math.PI * 4.4;
  const rr = 2 + t * 2.5;
  return `${(25 + rr * Math.cos(t)).toFixed(1)} ${(25 + rr * Math.sin(t)).toFixed(1)}`;
}).join(" L");
/* rosetón de LIFE WEAVE */
const roseton = [0, 1, 2, 3, 4, 5].map((i) => {
  const a = (i / 6) * Math.PI * 2;
  return { cx: +(25 + 7 * Math.cos(a)).toFixed(1), cy: +(25 + 7 * Math.sin(a)).toFixed(1) };
});
/* cornamenta de WILD SPIRIT */
const rAsta = rng(0x27c8);
const astas: Trazo[] = [];
const puntasAsta: Array<{ x: number; y: number; r: number }> = [];
for (const s of [-1, 1]) {
  ramificar(25 + s * 5, 28, -Math.PI / 2 + s * 0.65, 9, 4, rAsta, astas, puntasAsta);
}

/* Filas de las métricas del riel derecho (transcritas). */
const FILAS_BIO = [
  { et: "FLORA VITALITY", v: "94.1%" },
  { et: "FAUNA HARMONY", v: "91.3%" },
  { et: "WATER PURITY", v: "90.8%" },
  { et: "AIR CLARITY", v: "93.7%" },
  { et: "SOIL REGENERATION", v: "91.2%" },
];
const FILAS_MAPA = [
  { et: "GREEN ZONES", v: "82.7%", c: "#5fbf7a" },
  { et: "RESTORATION", v: "11.6%", c: "#d8b64a" },
  { et: "AT RISK", v: "4.3%", c: "#c9584a" },
  { et: "CORRUPTION", v: "1.4%", c: "#a8446a" },
];

