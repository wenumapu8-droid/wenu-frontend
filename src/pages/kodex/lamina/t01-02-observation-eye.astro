---
/**
 * KODEX-∞ · LÁMINA t01-02-observation-eye
 * Andamiaje generado. Bloques gruesos; cada uno mide sus paneles adentro.
 * Medir: node scripts/lamina/iterate.mjs t01-02-observation-eye
 */
import "../../../styles/kodex-lamina.css";
// La camara espacial/temporal. Construida tras el veredicto del creador
// (2026-08-25) "PROLOGUE MOBILE = REJECT: mobile no puede ser desktop
// reducido al 23%", y montada en CERO paginas hasta hoy.
import EscenaLamina from "../../../components/kodex/escena/EscenaLamina.astro";
import Cabecera from "../../../components/kodex/lamina/t01-02/Cabecera.astro";
import Izquierda from "../../../components/kodex/lamina/t01-02/Izquierda.astro";
import Centro from "../../../components/kodex/lamina/t01-02/Centro.astro";
import Derecha from "../../../components/kodex/lamina/t01-02/Derecha.astro";
import Pie from "../../../components/kodex/lamina/t01-02/Pie.astro";
const W = 1672, H = 941;

/* Recorrido movil: un panel por parada, en orden de lectura. Las cajas NO
   se estiman: son las mismas que ya usa el layout de escritorio, abajo.
   El ojo (Centro) va primero porque debe dominar el primer frame; lo denso
   -- rieles con logs y waveforms -- espera detras del gesto. */
const paradas = [
  { id: "eye",  label: "OBSERVATION EYE", x: 468, y: 88,  w: 712,  h: 778, cover: true },
  { id: "izq",  label: "OPTICS",          x: 4,   y: 88,  w: 464,  h: 778 },
  { id: "der",  label: "SIGNAL",          x: 1180,y: 88,  w: 488,  h: 778 },
  { id: "head", label: "HEADER",          x: 0,   y: 0,   w: 1672, h: 88 },
  { id: "pie",  label: "SYSTEM",          x: 0,   y: 866, w: 1672, h: 75 },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · t01-02-observation-eye</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      html, body { margin: 0; padding: 0; background: #000; overflow: hidden; }
      .kdx-lam-fit { --s: 1; --tx: 0px; --ty: 0px; position: absolute; inset: 0; overflow: hidden; }
      .kdx-lam-fit > .kdx-lam { position: absolute; left: 0; top: 0; transform-origin: 0 0;
        transform: translate(var(--tx), var(--ty)) scale(var(--s)); }
    </style>
  </head>
  <body>
    {/* El andamio inline hacia Math.min(1, vw/1672, vh/941): eso ES el
        desktop encogido que el creador rechazo. EscenaLamina conserva ese
        ajuste en escritorio y en movil lo cambia por camara temporal --
        una parada por gesto, a escala legible. La plancha no se redibuja:
        cambia la camara. */}
    <EscenaLamina lamina="t01-02-observation-eye" paradas={paradas}>
      <Cabecera box="left:0px;top:0px;width:1672px;height:88px" />
      <Izquierda box="left:4px;top:88px;width:464px;height:778px" />
      <Centro box="left:468px;top:88px;width:712px;height:778px" />
      <Derecha box="left:1180px;top:88px;width:488px;height:778px" />
      <Pie box="left:0px;top:866px;width:1672px;height:75px" />
    </EscenaLamina>
    <script>
      const sinks = [];
      window.__kdxRegisterFreeze = (fn) => sinks.push(fn);
      window.__kdxFreeze = (t = 0) => { for (const fn of sinks) fn(t); document.documentElement.dataset.kdxFrozen = "1"; };
      const fit = document.querySelector(".kdx-lam-fit");
      if (fit) {
        const ajustar = () => {
          const vw = innerWidth, vh = innerHeight;
          const s = Math.min(1, vw / 1672, vh / 941);
          fit.style.setProperty("--s", String(s));
          fit.style.setProperty("--tx", ((vw - 1672 * s) / 2).toFixed(2) + "px");
          fit.style.setProperty("--ty", ((vh - 941 * s) / 2).toFixed(2) + "px");
        };
        ajustar(); addEventListener("resize", ajustar, { passive: true });
      }
    
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";
      montarMovil();
    
      import { montarVida } from "../../../lib/kodex/vida/montar";
      montarVida({ id: "t01-02-observation-eye" });
    
      import { montarNavegacion } from "../../../components/kodex/lamina/kit/navegacion";
      montarNavegacion();
    
      import { montarTriptico } from "../../../components/kodex/lamina/kit/triptico";
      montarTriptico();
    
      import { montarSonido } from "../../../lib/kodex/sonido-montar";
      montarSonido();
    
      import { montarFases } from "../../../lib/kodex/estado";
      montarFases();
    </script>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>

    <!-- Tarjeta de cruce (costura 3): "cruzar al siguiente estrato" con
         progreso, del diseño del creador. Oculta al congelar (banco intacto). -->
    <a class="lam-siguiente" href="/kodex/lamina/t01-03-descent-tunnel/">NEXT PLATE · T01 03 DESCENT TUNNEL → <i>10/25</i></a>
    <style>
      .lam-siguiente{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:9;
        font:11px ui-monospace,monospace;letter-spacing:.18em;color:rgba(240,237,232,.66);
        text-decoration:none;padding:11px 16px;background:rgba(0,0,0,.5);
        border:1px solid rgba(240,237,232,.16);white-space:nowrap;max-width:92vw;overflow:hidden;text-overflow:ellipsis;}
      .lam-siguiente i{font-style:normal;color:rgba(240,237,232,.38);margin-left:10px}
      .lam-siguiente:hover{color:#fff;border-color:rgba(240,237,232,.45)}
      html[data-kdx-frozen] .lam-siguiente{display:none}
    </style>
  </body>
</html>
