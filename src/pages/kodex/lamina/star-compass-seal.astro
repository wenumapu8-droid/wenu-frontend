---
/**
 * KODEX-∞ · STAR COMPASS SEAL
 *
 * Reproducción en código de `reference/pendientes/star-compass-seal.png`
 * (1122×1402), segunda lámina del lote de Drive. La plancha se nombra sola en
 * su propio pie: "STAR COMPASS SEAL".
 *
 * MEDIDO de la referencia:
 *   · estrella: centro de masa del blanco fuerte en (547,686), 18.248 px
 *     blancos, brazo máximo 680;
 *   · rojo profundo #974e63 muestreado;
 *   · 28 glifos y 25 marcas en coordenadas exactas (receta del extractor) —
 *     son los copos textiles laterales, los rombos rojos cardinales y las
 *     marcas menores, y van DONDE ESTÁN, no distribuidos.
 *
 * La estrella es procedural: cuatro hojas mayores + cuatro diagonales, cada
 * una astillada por grietas negras con semilla fija — la referencia es una
 * estrella ROTA, no un polígono limpio. Los arcos tenues, el rayado fino y el
 * brillo lento van en canvas con `montarLienzo`.
 */
import "../../../styles/kodex-lamina.css";
import receta from "../../../../scripts/lamina/campo/pend-14.json";

const glifos: Array<[number, number, number]> = [];
for (let i = 0; i < receta.glifos.length; i += 3) {
  glifos.push([receta.glifos[i], receta.glifos[i + 1], receta.glifos[i + 2]]);
}
const marcas: Array<[number, number, number, number]> = [];
for (let i = 0; i < receta.marcas.length; i += 4) {
  marcas.push([receta.marcas[i], receta.marcas[i + 1], receta.marcas[i + 2], receta.marcas[i + 3]]);
}
/* Copo textil (estilo de la plancha): cruz + diagonales + puntas escalonadas.
   Un solo path reutilizado a la escala medida de cada glifo. */
const copo = "M0 -22 v44 M-22 0 h44 M-14 -14 L14 14 M14 -14 L-14 14 M0 -22 l-5 6 h10 Z M0 22 l-5 -6 h10 Z M-22 0 l6 -5 v10 Z M22 0 l-6 -5 v10 Z M-8 -16 h4 v4 h-4 Z M8 -16 h-4 v4 h4 Z M-8 16 h4 v-4 h-4 Z M8 16 h-4 v-4 h4 Z M-16 -8 v4 h4 v-4 Z M16 -8 v4 h-4 v-4 Z M-16 8 v-4 h4 v4 Z M16 8 v-4 h-4 v4 Z";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · STAR COMPASS SEAL</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="star-compass-seal">
      <canvas id="scs-fondo" width="1122" height="1402" style="position:absolute;inset:0;"></canvas>

      <svg viewBox="0 0 1122 1402" style="position:absolute;inset:0;" aria-hidden="true">
        <!-- ── título ────────────────────────────────────────────────── -->
        <text x="561" y="128" class="s-titulo" text-anchor="middle" textLength="560">KODEX-∞</text>

        <!-- ── glifos medidos: copos textiles donde la referencia los tiene ── -->
        {glifos.filter(([, , r]) => r >= 16).map(([x, y, r]) => (
          <g class="s-copo" transform={`translate(${x},${y}) scale(${Math.min(1.5, r / 18)})`}>
            <path d={copo} />
          </g>
        ))}
        {glifos.filter(([, , r]) => r < 16).map(([x, y, r]) => (
          <path class="s-copo" d={`M${x - r} ${y} h${r * 2} M${x} ${y - r} v${r * 2}`} opacity=".55" />
        ))}

        <!-- ── marcas medidas: rombos y trazos menores, rojo medido ──── -->
        {marcas.map(([x, y, w, h]) => (
          <path
            class="s-rombo"
            d={`M${x} ${y - Math.max(4, h / 2)} L${x + Math.max(4, w / 2)} ${y} L${x} ${y + Math.max(4, h / 2)} L${x - Math.max(4, w / 2)} ${y} Z`}
          />
        ))}

        <!-- ── el sello: diamante alámbrico rosa bajo la hoja sur ────── -->
        <g transform="translate(561,1108)">
          <path class="s-sello" d="M0 -92 L64 0 L0 92 L-64 0 Z" />
          <path class="s-sello" d="M0 -58 L40 0 L0 58 L-40 0 Z" />
          <path class="s-sello" d="M0 -30 L21 0 L0 30 L-21 0 Z" opacity=".8" />
          {Array.from({ length: 12 }, (_, k) => {
            const a = (k / 12) * Math.PI * 2;
            return <line x1="0" y1="0" x2={Math.cos(a) * 88} y2={Math.sin(a) * 60} class="s-sello-r" />;
          })}
          <line x1="-160" y1="0" x2="-70" y2="0" class="s-sello-eje" />
          <line x1="70" y1="0" x2="160" y2="0" class="s-sello-eje" />
          <path class="s-rombo" d="M0 -104 L7 -94 L0 -84 L-7 -94 Z" />
        </g>

        <!-- ── el rótulo del pie (transcrito) ────────────────────────── -->
        <text x="561" y="1268" class="s-rotulo" text-anchor="middle" textLength="470">STAR COMPASS SEAL</text>
        <path class="s-rombo" d="M232 1258 l8 -6 8 6 -8 6 Z M874 1258 l8 -6 8 6 -8 6 Z" />
        <text x="561" y="1306" class="s-micro" text-anchor="middle">◆◇▪▫◆ ▪▫◆▫▪ ◇◆◇ ▪◆▫ ◆▫▪◇◆ ▫▪◆</text>
      </svg>
    </div>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px; height: 1402px;
        background: #050505;
        transform-origin: 0 0;
        font-family: var(--lam-mono);
      }
      .s-titulo { fill: #efefec; font-family: Georgia, "Times New Roman", serif; font-size: 58px; letter-spacing: .5em; }
      .s-rotulo { fill: #e9e7e2; font-family: Georgia, "Times New Roman", serif; font-size: 34px; letter-spacing: .34em; }
      .s-micro  { fill: #8d8a84; font-size: 12px; letter-spacing: .3em; }
      .s-copo   { stroke: #e4e2dd; stroke-width: 2.4; fill: #e4e2dd; opacity: .9; }
      .s-copo path { fill: #e4e2dd; fill-opacity: .35; }
      .s-rombo  { stroke: #974e63; stroke-width: 1.2; fill: rgba(151,78,99,.25); }
      .s-sello  { stroke: #e29ab4; stroke-width: 1.6; fill: rgba(196,106,139,.12); opacity: .95; }
      .s-sello-r{ stroke: #b06a84; stroke-width: .6; opacity: .5; }
      .s-sello-eje{ stroke: #974e63; stroke-width: .9; opacity: .7; }
    </style>

    <script>
      import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
      import { montarEscala } from "../../../components/kodex/lamina/kit/escala";
      import { rng } from "../../../components/kodex/lamina/kit/rng";

      const canvas = document.getElementById("scs-fondo") as HTMLCanvasElement;
      const raiz = document.querySelector("[data-lam]") as HTMLElement;
      const g = canvas.getContext("2d")!;

      /* Centro medido de la estrella y radios de los arcos. */
      const CX = 547, CY = 686;
      const rnd = rng(0x5c5);

      /* ── la estrella rota, decidida UNA vez ─────────────────────────
         Cuatro hojas mayores (N la más larga, S media, E-O anchas) y cuatro
         diagonales cortas. Cada hoja es un rombo alargado partido por grietas
         negras fijas: la referencia es una estrella ASTILLADA. */
      type Hoja = { ang: number; largo: number; ancho: number };
      const hojas: Hoja[] = [
        { ang: -Math.PI / 2, largo: 540, ancho: 88 },
        { ang: Math.PI / 2, largo: 372, ancho: 80 },
        { ang: 0, largo: 300, ancho: 70 },
        { ang: Math.PI, largo: 296, ancho: 70 },
        { ang: -Math.PI / 4, largo: 216, ancho: 42 },
        { ang: (-3 * Math.PI) / 4, largo: 206, ancho: 42 },
        { ang: Math.PI / 4, largo: 190, ancho: 38 },
        { ang: (3 * Math.PI) / 4, largo: 198, ancho: 38 },
      ];
      /* astillas satelite: esquirlas blancas alrededor del nucleo, fijas */
      const astillas = Array.from({ length: 14 }, () => {
        const a = rnd() * Math.PI * 2, d = 60 + rnd() * 110;
        return { x: Math.cos(a) * d, y: Math.sin(a) * d, a: rnd() * Math.PI * 2, l: 10 + rnd() * 30, w: 2 + rnd() * 6 };
      });
      /* grietas: cortes rectos que cruzan la estrella, fijos por semilla */
      const grietas = Array.from({ length: 5 }, () => ({
        a: rnd() * Math.PI,
        d: (rnd() - 0.5) * 90,
        w: 1.2 + rnd() * 1.8,
      }));
      /* rayado fino de la plancha */
      const rayas = Array.from({ length: 1400 }, () => ({
        x: rnd() * 1122, y: rnd() * 1402,
        l: 6 + rnd() * 60, a: rnd() * Math.PI, o: 0.14 + rnd() * 0.34,
      }));

      const pintar = (fase: number) => {
        g.clearRect(0, 0, 1122, 1402);

        /* arcos tenues del compás */
        for (const [r, o] of [[430, 0.16], [368, 0.1], [488, 0.07]] as const) {
          g.strokeStyle = tinta("220,218,212", o);
          g.lineWidth = 1;
          g.beginPath(); g.arc(561, 660, r, 0, Math.PI * 2); g.stroke();
        }
        /* círculo rojo fino con muescas cardinales */
        g.strokeStyle = tinta("151,78,99", 0.5);
        g.lineWidth = 1;
        g.beginPath(); g.arc(561, 660, 402, 0, Math.PI * 2); g.stroke();
        for (let k = 0; k < 24; k++) {
          const a = (k / 24) * Math.PI * 2;
          const r0 = 396, r1 = k % 6 === 0 ? 382 : 390;
          g.beginPath();
          g.moveTo(561 + Math.cos(a) * r0, 660 + Math.sin(a) * r0);
          g.lineTo(561 + Math.cos(a) * r1, 660 + Math.sin(a) * r1);
          g.stroke();
        }

        /* rayado */
        for (const s of rayas) {
          g.strokeStyle = tinta("214,212,206", s.o);
          g.lineWidth = 0.6;
          g.beginPath();
          g.moveTo(s.x, s.y);
          g.lineTo(s.x + Math.cos(s.a) * s.l, s.y + Math.sin(s.a) * s.l);
          g.stroke();
        }

        /* la estrella: brillo lento (SLOW FIELD), congelada es idéntica */
        const brillo = 0.9 + 0.1 * Math.cos(fase * Math.PI * 2);
        g.save();
        g.translate(CX, CY);
        for (const h of hojas) {
          g.save();
          g.rotate(h.ang);
          g.fillStyle = tinta("240,240,237", 0.96 * brillo);
          g.beginPath();
          g.moveTo(0, -h.ancho / 2);
          g.lineTo(h.largo, 0);
          g.lineTo(0, h.ancho / 2);
          g.lineTo(-h.ancho * 0.24, 0);
          g.closePath();
          g.fill();
          g.restore();
        }
        for (const t of astillas) {
          g.save();
          g.translate(t.x, t.y); g.rotate(t.a);
          g.fillStyle = tinta("240,240,237", 0.92 * brillo);
          g.beginPath(); g.moveTo(-t.l / 2, 0); g.lineTo(t.l / 2, -t.w / 2); g.lineTo(t.l / 2, t.w / 2); g.closePath(); g.fill();
          g.restore();
        }
        /* grietas negras que la parten */
        g.globalCompositeOperation = "destination-out";
        for (const c of grietas) {
          g.save();
          g.rotate(c.a);
          g.fillRect(-620, c.d, 1240, c.w);
          g.restore();
        }
        g.globalCompositeOperation = "source-over";
        g.restore();
      };

      montarLienzo({ raiz, cuadro: pintar, periodo: 26000, periodoReducido: 64000 });

      montarEscala();
    </script>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>
  </body>
</html>
