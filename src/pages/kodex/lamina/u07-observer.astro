---
/**
 * KODEX-∞ · UNIVERSE PAGE 07 · OBSERVER
 *
 * Reproducción en código de `reference/canon/u07-observer.png` (1122×1402).
 *
 * Misma serie que `u02-threshold`: comparte marco exterior, rieles, retícula de
 * la cabecera y estructura de pie, así que este archivo es deliberadamente el
 * mismo esqueleto. Lo que cambia son los textos, los paneles y el héroe.
 *
 * El héroe —la MIRROR CHAMBER— va procedural en canvas 2D, como manda el
 * contrato. Ni un bitmap, ni un SVG calcado del PNG.
 *
 * CONTENIDO. El canon prohíbe inferir emoción, calidad de atención o estado
 * psicológico. Todos los rótulos de esta página son transcripción literal de la
 * referencia; no se agregó ninguno. En particular no hay nada que diga que el
 * sistema lee el estado mental de nadie: la única frase que menciona un estado
 * —"THE OBSERVER'S STATE."— está en el póster y describe cómo se modula el
 * reflejo, no una lectura del observador.
 */
import "../../../styles/kodex-lamina.css";
import Cabecera from "../../../components/kodex/lamina/u07/Cabecera.astro";
import Camara from "../../../components/kodex/lamina/u07/Camara.astro";
import Paneles from "../../../components/kodex/lamina/u07/Paneles.astro";
import Pie from "../../../components/kodex/lamina/u07/Pie.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · OBSERVER · PAGE 07</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="u07-observer">
      <Cabecera />
      <Camara />
      <Paneles />
      <Pie />
    </div>

    <style is:global>
      /* La lámina se dibuja a tamaño de referencia y se escala desde 0,0.
         `place-items:center` sobre una caja mayor que el contenedor desborda de
         un lado — la u02 lo pagó en una vuelta entera. */
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px;
        height: 1402px;
        /* Negro puro, medido: las seis muestras de fondo de la referencia
           (5,5 · 560,80 · 20,700 · 1100,700 · 560,1395 · 300,1250) dan
           rgb(0,0,0) o rgb(1,1,1). Cualquier tinte de fondo le pone piso al
           puntaje de los cuatro bloques a la vez. */
        background: #000;
        color: #cfc6e8;
        overflow: hidden;
        transform-origin: 0 0;
        font-family: "JetBrains Mono", ui-monospace, monospace;
      }
      .lam [data-bloque] { position: absolute; }
    </style>

    <script>
      /* `100vw / 1122` en CSS da una LONGITUD y `scale()` quiere un NÚMERO:
         puesto en CSS no hace nada y falla en silencio. Por eso vive acá. */
      const lam = document.querySelector(".lam");
      const ajustar = () => {
        const k = Math.min(innerWidth / 1122, innerHeight / 1402);
        /* EL SOBRANTE VERTICAL SE REPARTE, NO SE ACUMULA DEBAJO.
           Medido en el tríptico, página II FIELD, a 390x844: la plancha caía
           en 390x487 clavada al borde superior y dejaba 357 px (42 % de la
           pantalla) de negro muerto abajo. El precio no era el hueco sino el
           choque: el rótulo "II · FIELD" de la página se imprime en y 58-72 y
           ahí arriba ya estaba el propio cabezal de la obra, así que quedaban
           entre 3 y 6 textos de la plancha DEBAJO del rótulo. Dos textos en el
           mismo lugar es exactamente lo que condena el propio tríptico
           ("nunca competir con otro titular igual de grande"), y la página II
           se define como "la obra sola, entera, SIN NADA ENCIMA".

           Repartiendo el sobrante, la obra arranca en y 178 y el rótulo cae
           sobre negro limpio: el cartel queda enmarcado en vez de encajado.

           ESCRITORIO INTACTO, y se puede comprobar sin abrir el navegador: a
           1440x900 manda la altura (k = 900/1402) y 1402*k == innerHeight
           EXACTO, o sea sobra == 0 y el transform vuelve a ser `scale(k)`
           puro. El desplazamiento sólo existe cuando manda el ancho, que es
           el caso del teléfono.

           Va DENTRO del transform y no como `top`/`margin`: con
           `transform-origin: 0 0` un desplazamiento por fuera corre la obra en
           vez de centrarla —ya se pagó ese error una vez en la hoja del
           tríptico—. Acá se compone con la escala en el mismo cálculo. */
        const sobra = Math.max(0, (innerHeight - 1402 * k) / 2);
        lam.style.transform = `translateY(${sobra}px) scale(${k})`;
        document.body.style.height = `${1402 * k + sobra * 2}px`;
      };
      ajustar();
      addEventListener("resize", ajustar, { passive: true });
    
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";
      montarMovil();
    
      import { montarVida } from "../../../lib/kodex/vida/montar";
      montarVida({ id: "u07-observer" });
    
      import { montarNavegacion } from "../../../components/kodex/lamina/kit/navegacion";
      montarNavegacion();
    
      import { montarTriptico } from "../../../components/kodex/lamina/kit/triptico";
      montarTriptico();
    
      import { montarSonido } from "../../../lib/kodex/sonido-montar";
      montarSonido();
    
      import { montarFases } from "../../../lib/kodex/estado";
      montarFases();
    </script>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>

    <!-- Tarjeta de cruce (costura 3): "cruzar al siguiente estrato" con
         progreso, del diseño del creador. Oculta al congelar (banco intacto). -->
    <a class="lam-siguiente" href="/kodex/lamina/u08-anomaly/">NEXT PLATE · U08 ANOMALY → <i>22/25</i></a>
    <style>
      .lam-siguiente{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:9;
        font:11px ui-monospace,monospace;letter-spacing:.18em;color:rgba(240,237,232,.66);
        text-decoration:none;padding:11px 16px;background:rgba(0,0,0,.5);
        border:1px solid rgba(240,237,232,.16);white-space:nowrap;max-width:92vw;overflow:hidden;text-overflow:ellipsis;}
      .lam-siguiente i{font-style:normal;color:rgba(240,237,232,.38);margin-left:10px}
      .lam-siguiente:hover{color:#fff;border-color:rgba(240,237,232,.45)}
      html[data-kdx-frozen] .lam-siguiente{display:none}
    </style>
  </body>
</html>
