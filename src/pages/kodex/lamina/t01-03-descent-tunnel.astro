---
/**
 * KODEX-∞ · LÁMINA t01-03 · DESCENT TUNNEL
 *
 * Reproducción en código de reference/canon/t01-03-descent-tunnel.png.
 *
 * Por qué esta lámina primero: es la única de las 17 cuyo héroe es 100 %
 * procedural. Las otras traen un rostro, un cráneo, un árbol o planetas
 * renderizados — imágenes generadas que ningún shader va a reproducir idénticas.
 * Acá no hay nada fotográfico: rejillas concéntricas, radios y niebla. Si la
 * fotocopia en código es posible, se prueba acá; y si no se puede acá, no se
 * puede en ninguna.
 *
 * Se dibuja a 1672×941 fijos porque es un objetivo de reproducción, no una
 * página pública. La versión que se sirve se recompone aparte.
 *
 * Medir:  node scripts/lamina/compare.mjs t01-03-descent-tunnel
 */
import "../../../styles/kodex-lamina.css";

import Header      from "../../../components/kodex/lamina/t01-03/Header.astro";
import SceneDesc   from "../../../components/kodex/lamina/t01-03/SceneDescription.astro";
import StateProg   from "../../../components/kodex/lamina/t01-03/StateProgression.astro";
import MotionNotes from "../../../components/kodex/lamina/t01-03/MotionNotes.astro";
import PolarCode   from "../../../components/kodex/lamina/t01-03/PolarDistortion.astro";
import Hero        from "../../../components/kodex/lamina/t01-03/Hero.astro";
import Progress    from "../../../components/kodex/lamina/t01-03/DescentProgress.astro";
import CoreReadout from "../../../components/kodex/lamina/t01-03/CoreReadout.astro";
import FrameStudy  from "../../../components/kodex/lamina/t01-03/FrameStudies.astro";
import ShaderTreat from "../../../components/kodex/lamina/t01-03/ShaderTreatment.astro";
import DataTags    from "../../../components/kodex/lamina/t01-03/DataTags.astro";
import MobileMock  from "../../../components/kodex/lamina/t01-03/MobileMockup.astro";
import Footer      from "../../../components/kodex/lamina/t01-03/Footer.astro";

const W = 1672;
const H = 941;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · lámina t01-03 · DESCENT TUNNEL</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="KODEX−∞ · DESCENT TUNNEL — lámina de desarrollo visual reproducida íntegramente en código: sin imágenes, todo CSS, SVG y canvas." />
    <style is:global define:vars={{ lamW: `${W}px`, lamH: `${H}px` }}>
      html, body { margin: 0; padding: 0; background: #000; }
      /* El banco captura a viewport exacto: sin scrollbars, que corren todo
         algunos píxeles y ensucian el puntaje de la columna derecha entera. */
      body { overflow: hidden; }

      /*
        ESCALADO PARA VER, SIN ROMPER LA MEDICIÓN.

        La lámina se dibuja a 1672×941 fijos porque es un objetivo de
        reproducción: si el layout se recompone, deja de ser comparable contra
        la referencia. Pero así solo se puede ver en una pantalla de ese ancho
        exacto, o sea en ninguna.

        La solución es escalar la lámina entera como una unidad, no recomponerla.
        `scale` sobre el bloque completo mantiene cada píxel en su sitio
        relativo, así que el diseño sigue siendo el mismo dibujo, solo más chico.

        Y lo importante: el factor se calcula contra el viewport, de modo que a
        1672×941 exactos da 1 y no se aplica NADA. El banco de fotocopia captura
        justo a ese tamaño, así que mide lo mismo que antes — esto no puede
        ensuciar el puntaje.
      */
      .kdx-lam-fit {
        /* En 1 y sin desplazamiento no se aplica nada: es el estado exacto en
           el que captura el banco de fotocopia. */
        --s: 1;
        --tx: 0px;
        --ty: 0px;
        position: absolute;
        inset: 0;
        overflow: hidden;
      }
      /* Centrado calculado, NO con grid.
         `place-items: center` sobre una caja MÁS GRANDE que su contenedor no
         centra: desborda hacia un lado. Como el transform no cambia la caja de
         maquetación (sigue midiendo 1672×941 aunque se vea al 23 %), el
         navegador la empuja y el resultado queda corrido y cortado.
         Con origen en la esquina y traslación calculada, el encuadre es exacto
         en cualquier tamaño. */
      .kdx-lam-fit > .kdx-lam {
        position: absolute;
        left: 0;
        top: 0;
        transform-origin: 0 0;
        transform: translate(var(--tx), var(--ty)) scale(var(--s));
      }
    </style>
  </head>
  <body>
    <div class="kdx-lam-fit">
    <div
      class="kdx-lam kdx-lam--descent"
      style={`width:${W}px;height:${H}px`}
      data-lamina="t01-03-descent-tunnel"
    >
      {/*
        Cajas MEDIDAS de la referencia, no estimadas.

        Las primeras las saqué a ojo y estaban mal: los agentes reportaron que
        sus paneles no entraban y comprimieron tipografía para que cupiera —
        MotionNotes al 0,86, el código de PolarDistortion de 9 px a 7. Eso le
        ponía un techo a la fidelidad de toda la lámina y la causa era el
        andamiaje, no su trabajo.

        Medidas buscando tramos verticales continuos POR BANDA, que es la clave:
        la lámina NO tiene tres columnas parejas. La banda principal se parte en
        317 y 1093; la inferior en 415/429 y 1039/1173. Asumir una sola retícula
        para toda la altura fue el error.
      */}
      <Header      box="left:0;top:0;width:1672px;height:88px" />

      <SceneDesc   box="left:13px;top:96px;width:297px;height:207px" />
      <StateProg   box="left:13px;top:310px;width:297px;height:268px" />
      <MotionNotes box="left:13px;top:586px;width:297px;height:107px" />
      <PolarCode   box="left:13px;top:717px;width:402px;height:152px" />

      <Hero        box="left:317px;top:96px;width:776px;height:522px" />
      <Progress    box="left:317px;top:624px;width:776px;height:60px" />
      <CoreReadout box="left:429px;top:717px;width:610px;height:152px" />

      <FrameStudy  box="left:1110px;top:96px;width:547px;height:230px" />
      <ShaderTreat box="left:1110px;top:334px;width:547px;height:110px" />
      <DataTags    box="left:1110px;top:452px;width:547px;height:232px" />
      <MobileMock  box="left:1110px;top:692px;width:547px;height:177px" />

      <Footer      box="left:0;top:880px;width:1672px;height:61px" />
    </div>
    </div>

    <script>
      /**
       * Congelador para el banco de pruebas.
       *
       * `animations: "disabled"` de Playwright para CSS y Web Animations, pero
       * no toca un canvas que corre su propio requestAnimationFrame. Sin esto
       * dos capturas de la misma página dan puntajes distintos y el loop
       * persigue ruido en vez de converger.
       *
       * Cada organismo se registra acá y recibe el tiempo fijo que debe pintar.
       */
      const sinks = [];
      window.__kdxRegisterFreeze = (fn) => sinks.push(fn);
      window.__kdxFreeze = (t = 0) => {
        for (const fn of sinks) fn(t);
        document.documentElement.dataset.kdxFrozen = "1";
      };

      /**
       * Ajuste a pantalla.
       *
       * Va en JS y no en CSS porque en CSS no se puede: `100vw / 1672` da una
       * LONGITUD, y scale() necesita un NÚMERO. Se puede escribir, no tira
       * error, y simplemente no se aplica — que fue justo lo que pasó en el
       * primer intento y solo se vio capturando a 390 px.
       *
       * Nunca amplía: si la pantalla es más grande que la lámina, queda en 1.
       * Eso deja intacto el banco de fotocopia, que captura a 1672×941 exactos.
       */
      const fit = document.querySelector(".kdx-lam-fit");
      if (fit) {
        const ajustar = () => {
          const vw = window.innerWidth;
          const vh = window.innerHeight;
          const s = Math.min(1, vw / 1672, vh / 941);
          fit.style.setProperty("--s", String(s));
          fit.style.setProperty("--tx", ((vw - 1672 * s) / 2).toFixed(2) + "px");
          fit.style.setProperty("--ty", ((vh - 941 * s) / 2).toFixed(2) + "px");
        };
        ajustar();
        addEventListener("resize", ajustar, { passive: true });
        addEventListener("orientationchange", ajustar);
      }
    </script>
  </body>
</html>
