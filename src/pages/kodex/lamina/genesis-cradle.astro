    <title>KODEX−∞ · GENESIS CRADLE · PAGE 30</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam arch-marco" data-lam="genesis-cradle" style="width:1229px;height:1536px;">
      {/* ── el organismo: canvas procedural, x260..969 y232..1240 ──── */}
      <canvas class="arch-caja gc-heroe" id="gc-heroe" width="709" height="1008" aria-hidden="true"></canvas>

      {/* ── marco de página (medido x11,5/14,5 · y12,5 · y1512,5/1518,5) */}
      <svg class="arch-caja gc-marco" viewBox="0 0 1229 1536" width="1229" height="1536" fill="none" aria-hidden="true">
        <rect x="11.5" y="12.5" width="1205" height="1506" stroke="currentColor" stroke-opacity="0.26" />
        <path d="M14.5 20 V1512.5 H1213.5 V20" stroke="currentColor" stroke-opacity="0.1" />
        {/* banda del pie: regla interior con quiebre y rombo a cada flanco */}
        <path d="M85 1512.5 H520" stroke="currentColor" stroke-opacity="0.12" />
        <path d="M1143 1512.5 H709" stroke="currentColor" stroke-opacity="0.12" />
        <path d="M85 1512.5 L64 1500" stroke="currentColor" stroke-opacity="0.3" />
        <path d="M1143 1512.5 L1164 1500" stroke="currentColor" stroke-opacity="0.3" />
        <rect x="47" y="1483" width="20" height="20" rx="5" transform="rotate(-12 57 1493)" stroke="currentColor" stroke-opacity="0.34" />
        <rect x="1161" y="1483" width="20" height="20" rx="5" transform="rotate(12 1171 1493)" stroke="currentColor" stroke-opacity="0.34" />
        {/* triángulos de esquina con su sigilo */}
        {[[14.5, 1518.5, 1], [1213.5, 1518.5, -1]].map(([x, y, s]) => (
          <g transform={`translate(${x} ${y}) scale(${s} 1)`} stroke="currentColor">
            <path d="M0 -30 L32 0" stroke-opacity="0.4" />
