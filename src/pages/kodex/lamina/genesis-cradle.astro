      {/* P2 · GESTATION HARMONICS — x29..260 y768..1077 */}
      <section class="arch-caja gc-panel gc-panel--2">
        <svg class="gc-panel__marco" width="231" height="309" viewBox="0 0 231 309" fill="none" aria-hidden="true">
          <path d={marcoMellado(231, 309)} stroke="currentColor" stroke-opacity="0.42" />
          <path d={marcoMellado(219, 297)} transform="translate(6 6)" stroke="currentColor" stroke-opacity="0.14" />
          {[[10, 10], [221, 10], [10, 299], [221, 299]].map(([x, y]) => (
            <circle cx={x} cy={y} r="1.8" stroke="currentColor" stroke-opacity="0.5" />
          ))}
        </svg>
        <h2 class="gc-panel__en">GESTATION HARMONICS</h2>
        <p class="gc-panel__es">ARMÓNICAS DE GESTACIÓN</p>
        {armonicas.map((a, i) => (
          <div class="gc-arm" style={`top:${topeArmonica[i] - 768}px`}>
            <svg class="gc-arm__sigilo" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
              <path d={Array.from({ length: 8 }, (_, k) => {
                const ang = (k / 8) * Math.PI * 2 + Math.PI / 8;
                return `${k ? "L" : "M"}${(14 + 13 * Math.cos(ang)).toFixed(1)} ${(14 + 13 * Math.sin(ang)).toFixed(1)}`;
              }).join(" ") + " Z"} stroke="currentColor" stroke-opacity="0.55" />
