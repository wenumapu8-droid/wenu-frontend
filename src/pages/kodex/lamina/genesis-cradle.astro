/**
 * KODEX−∞ · LÁMINA DE ARCHIVO · GENESIS CRADLE · PAGE 30
 *
 * Reproducción en código de reference/pendientes/a30-genesis-cradle.png
 * (1229×1536). Penúltima de la serie de archivo: mismo cromo que
 * mycelial-oracle (a23) y silence-engine (a28) —los componentes de
 * src/components/kodex/archivo/ en cajas absolutas medidas— con el
 * organismo central pintado en canvas procedural.
 *
 * TODO el texto visible está TRANSCRITO de la referencia, incluidas sus
 * erratas («OCEANIC LINIAGE» va así en el original). Nada se inventa:
 * lo que no se lee no se escribe, y en su lugar va marca geométrica con
 * semilla.
 *
 * MEDIDO sobre la referencia (scripts/lamina/gc/lineas.mjs, que busca
 * corridas de píxeles más claros que sus vecinas laterales — el marco de
 * esta lámina es de 1 px y lum 40..60, y el umbral fijo del probe viejo
 * no lo veía):
 *
 * · marco de página: verticales x11,5 y x1216,5 (exterior) y x14,5 /
 *   x1213,5 (interior); horizontales y12,5 (superior), y1512,5 y
 *   y1518,5 (la banda del pie).
 * · el marco de panel es un rectángulo de esquinas MELLADAS de 9 px:
 *   las verticales corren de y+9 a y+alto−9 y las horizontales de x+9 a
 *   x+ancho−9, unidas por un cuarto de vuelta. Verificado en los seis
 *   paneles: P1 x29..260 y234..753 da verticales y243..744 y
 *   horizontales x38..251 — exactamente lo medido.
 * · riel izquierdo x29..260: P1 y234..753, P2 y768..1077, P3 y1093..1466.
 * · riel derecho x969..1201: RA y234..640, RB y655..1210;
 *   RC x794..1201 y1226..1466.
 * · cabecera: «KODEX − ∞» y27..50 (versal 23 → cuerpo 36,8) centrado en
 *   x589 —no en x614: la referencia corre el bloque de marca 25 px a la
 *   izquierda—, lema y63..71, adorno y80..96 (x429..749).
 * · título «GENESIS CRADLE» y118..185 (versal 67), centrado en x610;
 *   subtítulo «CUNA DEL GÉNESIS» y211..229 centrado en x608.
 * · aforismo: cuatro versos EN en y1255/1277/1298/1320 y cuatro ES en
 *   y1377/1399/1421/1446, todos centrados en x584.
 * · organismo: caja x260..969, y232..1240.
 *
 * MAPA DE LUMINANCIA del organismo (scripts/lamina/mo/mapa.mjs 18×26).
 * Es lo que dicta el ambiente, que acá es la mitad del parecido: la
 * referencia NO tiene fondo negro plano. Máximos medidos: 215 en el eje
 * a y713 y 213 a y674 (el huevo), 187 a y325 (la boca del túnel), y dos
 * columnas de velo fuera de eje —x320 con 100..125 de y558 a y830 y
 * x870 con 111..161 de y480 a y907—. Mínimos de 3..20 en los cantos y
 * bajo y1180. De ahí que la viñeta sea ELÍPTICA y con focos, no un
 * radial circular: el circular apaga los dos velos laterales, que son
 * un tercio de la tinta del organismo.
 *
 * Paleta medida (pico y media de los píxeles altos de cada banda):
 * título crema rgb(237,221,198); rótulo de panel rgb(176,170,158);
 * secundario rgb(133,123,111); oro del cromo rgb(65,62,55) sobre negro
 * —o sea el mismo oro al 25 % de tinta—; valor «1,008» rgb(239,224,193).
 */
import CabeceraArchivo from "../../../components/kodex/archivo/CabeceraArchivo.astro";
import TituloBilingue from "../../../components/kodex/archivo/TituloBilingue.astro";
import TarjetaMetrica from "../../../components/kodex/archivo/TarjetaMetrica.astro";
import RielMetricas from "../../../components/kodex/archivo/RielMetricas.astro";
import AforismoPie from "../../../components/kodex/archivo/AforismoPie.astro";
import SelloClasificacion from "../../../components/kodex/archivo/SelloClasificacion.astro";
import { rng } from "../../../components/kodex/lamina/kit/rng";

/* ── el marco mellado, que es TODO el cromo de esta lámina ──────────
   Nueve píxeles de mella, medidos. Se usa seis veces; escrito a mano
   seis veces sería seis sitios donde equivocarse. */
const marcoMellado = (w: number, h: number, n = 9) =>
  `M${n} 0 H${w - n} Q${w} 0 ${w} ${n} V${h - n} Q${w} ${h} ${w - n} ${h}` +
  ` H${n} Q0 ${h} 0 ${h - n} V${n} Q0 0 ${n} 0 Z`;

/* ── contenido transcrito ───────────────────────────────────────────*/
const fases = [
  { n: "01", en: "SEEDING", es: "Implantación del\narquetipo del Alma" },
  { n: "02", en: "ATTUNEMENT", es: "Alineación con las\narmónicas del útero\ncósmico" },
  { n: "03", en: "GESTATION", es: "Desarrollo del cuerpo\nluz y memorias\nlatentes" },
  { n: "04", en: "INTEGRATION", es: "Tejido del propósito\ny selección del\nlinaje" },
  { n: "05", en: "READINESS", es: "Preparación para\nel nacimiento y la\nencarnación" },
];
/* tops medidos de cada rótulo de fase: 312, 400, 482, 572, 661 */
const topeFase = [312, 400, 482, 572, 661];
/* centros de disco medidos: 336, 425, 514, 602, 705 — el paso no es
   regular y el último abre a 103 px */
const topeDisco = [-14, -13, -6, -8, 6];

const armonicas = [
  { en: "FUNDAMENTAL TONE", hz: "432.000 Hz" },
  { en: "HEART HARMONIC", hz: "528.000 Hz" },
  { en: "DNA RESONANCE", hz: "639.000 Hz" },
  { en: "SOUL INTEGRATION", hz: "741.000 Hz" },
  { en: "LIGHT BODY SYNC", hz: "963.000 Hz" },
];
/* filas medidas: 844, 891, 939, 986, 1034 (paso 47,5) */
const topeArmonica = [841, 888, 936, 983, 1031];

const linajes = [
  { en: "EARTH LINEAGE", v: "408", llenos: 3, medio: true },
  { en: "STELLAR LINEAGE", v: "312", llenos: 3, medio: false },
  { en: "OCEANIC LINIAGE", v: "160", llenos: 3, medio: false },
  { en: "CRYSTALLINE LINEAGE", v: "80", llenos: 1, medio: true },
  { en: "DRACONIC LINEAGE", v: "48", llenos: 1, medio: false },
];

const transmision = [
  { en: "THE SOURCE", es: "LA FUENTE" },
  { en: "SOUL MATRIX", es: "MATRIZ DEL ALMA" },
  { en: "LIGHT CODING", es: "CODIFICACIÓN LUMINOSA" },
  { en: "BODY TEMPLATE", es: "PLANTILLA DEL CUERPO" },
  { en: "INCARNATION GATE", es: "PUERTA DE ENCARNACIÓN" },
  { en: "BIRTH INTO FORM", es: "NACIMIENTO EN LA FORMA" },
];

const estado = [
  { en: "STABILITY", es: "ESTABILIDAD", v: "98.7%", p: 0.987 },
  { en: "HARMONIC COHERENCE", es: "COHERENCIA ARMÓNICA", v: "96.3%", p: 0.963 },
  { en: "LIGHT NUTRITION", es: "NUTRICIÓN LUMÍNICA", v: "97.5%", p: 0.975 },
  { en: "PROTECTION FIELD", es: "CAMPO DE PROTECCIÓN", v: "100%", p: 1 },
];

/* ── geometría determinista (nunca Math.random) ─────────────────────*/

/* Rosa de la esquina superior izquierda: el disco que abraza el «30».
   Medido: anillo exterior x45..150 en la fila y78 → centro (97,78) r52. */
const rRosa = rng(0x30a1);
const radiosRosa = Array.from({ length: 16 }, (_, i) => {
  const a = (i / 16) * Math.PI * 2;
  return { x1: 52 + 22 * Math.cos(a), y1: 52 + 22 * Math.sin(a), x2: 52 + 50 * Math.cos(a), y2: 52 + 50 * Math.sin(a) };
});
const motasRosa = Array.from({ length: 26 }, () => {
  const a = rRosa() * Math.PI * 2, rr = 24 + rRosa() * 26;
  return { x: 52 + rr * Math.cos(a), y: 52 + rr * Math.sin(a), o: 0.3 + rRosa() * 0.5 };
});

/* Sigilos octogonales de GESTATION HARMONICS: en la referencia son
   cinco rosetas distintas dentro del mismo octógono. Geometría con
   semilla, no letra. */
const rSig = rng(0x0730);
const sigilos = Array.from({ length: 5 }, (_, i) => ({
  puntas: 4 + (i % 3),
  giro: rSig() * 0.8,
  puntos: Array.from({ length: 10 + i * 2 }, () => {
    const a = rSig() * Math.PI * 2, rr = rSig() * 8;
    return { x: 14 + rr * Math.cos(a), y: 14 + rr * Math.sin(a) };
  }),
}));

/* Ondas de las armónicas: series con memoria, una por fila. La primera
   es un batido de senos (la referencia dibuja ahí una interferencia
   limpia); las otras cuatro son señal con envolvente. */
const ondas = armonicas.map((_, i) => {
  const r = rng(0x9100 + i * 53);
  return Array.from({ length: 76 }, (_, k) => {
    const u = k / 75;
    if (i === 0) return Math.sin(u * Math.PI * 6) * 0.55 + Math.sin(u * Math.PI * 13) * 0.3;
    const env = Math.exp(-Math.pow((u - (0.4 + i * 0.06)) * 3.4, 2)) * 0.7 + 0.22;
    return (r() * 2 - 1) * env * (i === 2 ? 0.45 : 1);
  });
});

/* Constelación del contador de semillas: nodos sobre un disco con
   aristas cortas. Es el fondo del «1,008». */
const rCons = rng(0x1008);
const nodosCons = Array.from({ length: 46 }, () => {
  const a = rCons() * Math.PI * 2, rr = Math.sqrt(rCons()) * 70;
  return { x: 72 + rr * Math.cos(a), y: 72 + rr * Math.sin(a), r: 0.6 + rCons() * 1.5 };
});
const aristasCons: Array<{ a: number; b: number }> = [];
for (let i = 0; i < nodosCons.length; i++)
  for (let k = i + 1; k < nodosCons.length; k++) {
    const d = Math.hypot(nodosCons[i].x - nodosCons[k].x, nodosCons[i].y - nodosCons[k].y);
    if (d < 30) aristasCons.push({ a: i, b: k });
  }

/* Flor de la vida de CRADLE STATUS: siete círculos y su corona, más los
   círculos grandes que la envuelven. Medida: caja x1029..1187,
   y1264..1431, centro (1108,1348) r≈75. */
const florVida = (() => {
  const c: Array<{ x: number; y: number; r: number }> = [{ x: 0, y: 0, r: 26 }];
  for (let anillo = 1; anillo <= 2; anillo++)
    for (let k = 0; k < 6 * anillo; k++) {
      const a = (k / (6 * anillo)) * Math.PI * 2 + (anillo === 2 ? Math.PI / 6 : 0);
      const rr = 26 * anillo * (anillo === 2 ? 1.732 / 2 * 1.155 : 1);
      c.push({ x: rr * Math.cos(a), y: rr * Math.sin(a), r: 26 });
    }
  return c;
})();

/* Glifos del adorno que abre el aforismo (y1230..1238, x400..747) y del
   emblema que lo cierra (y1349..1361). En la referencia son sigilos
   ilegibles: se reproducen como marca geométrica con semilla. */
const rGlifo = rng(0x30cd);
const glifosAforismo = Array.from({ length: 4 }, () => ({
  brazos: 2 + Math.floor(rGlifo() * 3),
  giro: rGlifo() * 0.7 - 0.35,
  gancho: rGlifo() < 0.5,
}));
