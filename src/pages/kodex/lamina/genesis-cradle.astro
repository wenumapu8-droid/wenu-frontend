            <circle cx="12" cy="-13" r="3" stroke-opacity="0.45" />
          </g>
        ))}
        {[[14.5, 20, 1], [1213.5, 20, -1]].map(([x, y, s]) => (
          <g transform={`translate(${x} ${y}) scale(${s} 1)`} stroke="currentColor">
            <path d="M0 26 L28 0" stroke-opacity="0.35" />
            <path d="M8 14 L18 5" stroke-opacity="0.4" />
          </g>
        ))}
        {/* emblema alado del pie, medido centrado en x614 y1500 */}
        <g transform="translate(614 1500)" stroke="currentColor" stroke-opacity="0.62" fill="none">
          {[-1, 1].map((l) => (
            <g transform={`scale(${l} 1)`} stroke-opacity="0.7">
              <path d="M12 -6 Q34 -10 58 -8 Q40 -3 14 -2" />
              <path d="M12 0 Q38 -2 66 2 Q44 5 14 4" />
              <path d="M12 6 Q34 8 56 13 Q36 13 14 10" />
            </g>
          ))}
          <path d="M0 -17 L8 0 L0 17 L-8 0 Z" stroke-opacity="0.85" fill="currentColor" fill-opacity="0.1" />
          <circle cx="0" cy="0" r="3.4" stroke-opacity="0.9" fill="currentColor" fill-opacity="0.5" />
        </g>
      </svg>

      {/* ── cabecera: marca centrada en x589 + bloque de página ─────── */}
      <div class="arch-caja arch-caja--cabecera">
        <CabeceraArchivo marca="KODEX − ∞" lema="UNIVERSAL ARCHIVE" rotuloPagina="PÁGINA" pagina="30" centrada>
          <svg slot="adorno" width="340" height="22" viewBox="0 0 340 22" fill="none" aria-hidden="true">
            <line x1="0" y1="4" x2="130" y2="4" stroke="currentColor" stroke-opacity="0.4" />
            <line x1="340" y1="4" x2="210" y2="4" stroke="currentColor" stroke-opacity="0.4" />
            <path d="M130 4 L146 4 M210 4 L194 4" stroke="currentColor" stroke-opacity="0.5" />
            <circle cx="152" cy="4" r="2.4" stroke="currentColor" stroke-opacity="0.6" />
            <circle cx="188" cy="4" r="2.4" stroke="currentColor" stroke-opacity="0.6" />
            <g transform="translate(170 8)" stroke="currentColor" stroke-opacity="0.8">
              <path d="M0 -8 L0 12" />
              <path d="M-7 -2 Q0 -8 7 -2 Q0 4 -7 -2 Z" fill="currentColor" fill-opacity="0.35" />
              <path d="M-4 6 L4 6" />
            </g>
          </svg>
        </CabeceraArchivo>
      </div>

      {/* ── rosa de la esquina, alrededor del «30» (centro 97,78 r52) ─ */}
      <svg class="arch-caja gc-rosa" width="104" height="104" viewBox="0 0 104 104" fill="none" aria-hidden="true">
        {[50, 40, 28].map((r, i) => (
          <circle cx="52" cy="52" r={r} stroke="currentColor" stroke-opacity={i === 0 ? "0.5" : i === 1 ? "0.26" : "0.18"} />
        ))}
        <circle cx="52" cy="52" r="46" stroke="currentColor" stroke-opacity="0.14" stroke-dasharray="1 5" />
        {radiosRosa.map((l, i) => (
          <line x1={l.x1.toFixed(1)} y1={l.y1.toFixed(1)} x2={l.x2.toFixed(1)} y2={l.y2.toFixed(1)}
            stroke="currentColor" stroke-opacity={i % 4 === 0 ? "0.34" : "0.14"} />
        ))}
        {motasRosa.map((m) => (
          <circle cx={m.x.toFixed(1)} cy={m.y.toFixed(1)} r="0.9" fill="currentColor" fill-opacity={m.o.toFixed(2)} />
        ))}
        {[0, 1, 2, 3].map((i) => {
          const a = (i / 4) * Math.PI * 2 - Math.PI / 2;
          return <circle cx={(52 + 50 * Math.cos(a)).toFixed(1)} cy={(52 + 50 * Math.sin(a)).toFixed(1)} r="2" fill="currentColor" fill-opacity="0.7" />;
        })}
      </svg>

      {/* ── cartucho de arco de la esquina derecha (x1100..1172) ────── */}
      <svg class="arch-caja gc-arco" width="74" height="108" viewBox="0 0 74 108" fill="none" aria-hidden="true">
        <path d="M2 106 V38 Q2 2 37 2 Q72 2 72 38 V106" stroke="currentColor" stroke-opacity="0.5" />
        <path d="M8 106 V40 Q8 9 37 9 Q66 9 66 40 V106" stroke="currentColor" stroke-opacity="0.22" />
        <line x1="8" y1="66" x2="66" y2="66" stroke="currentColor" stroke-opacity="0.28" />
        {/* rosa superior */}
        <g transform="translate(37 38)">
          <circle r="17" stroke="currentColor" stroke-opacity="0.4" />
          <circle r="10" stroke="currentColor" stroke-opacity="0.3" />
          {Array.from({ length: 8 }, (_, i) => {
            const a = (i / 8) * Math.PI * 2;
            return (
              <>
                <line x1={(10 * Math.cos(a)).toFixed(1)} y1={(10 * Math.sin(a)).toFixed(1)}
                  x2={(17 * Math.cos(a)).toFixed(1)} y2={(17 * Math.sin(a)).toFixed(1)}
