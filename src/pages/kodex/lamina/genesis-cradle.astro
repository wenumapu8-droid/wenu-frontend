              <line x1="6" y1="4" x2="86" y2="4" stroke="currentColor" stroke-opacity="0.4" />
              {[4, 30, 58, 86].slice(0, 2 + (i % 3)).map((x) => (
                <rect x={x - 3} y="1" width="6" height="6" transform={`rotate(45 ${x} 4)`} stroke="currentColor" stroke-opacity="0.65" />
              ))}
