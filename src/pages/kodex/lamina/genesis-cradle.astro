<script>
  import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
  import { rng } from "../../../components/kodex/lamina/kit/rng";
  import { montarEscala } from "../../../components/kodex/lamina/kit/escala";

  const raiz = document.querySelector("[data-lam]") as HTMLElement;
  const heroe = document.getElementById("gc-heroe") as HTMLCanvasElement;
  const g = heroe.getContext("2d")!;
  const W = 709, H = 1008, CX = 354;

  /* ─────────────────────────────────────────────────────────────────
     EL ORGANISMO — caja x260..969, y232..1240 de la referencia.

     Una cámara-útero: dos velos de luz bajan de los ángulos superiores
     y cierran una bóveda; en el eje, un pozo de ondas arriba y otro
     abajo; al centro, el huevo con el embrión, envuelto en anillos de
     geometría; del pozo bajo baja un sistema de raíces que abre en
     abanico; sobre la llanura, las semillas —ovoides translúcidos con
     su propio embrión— y figuras diminutas.

     El ambiente lo dicta el mapa de luminancia por celdas (18×26) de la
     referencia, transcrito en la cabecera del .astro. Lo que importa:
     los MÁXIMOS FUERA DE EJE (x320 con 100..125 y x870 con 111..161)
     son los velos. Con una viñeta circular esos dos se apagan y la caja
     mide como si le faltara un tercio del dibujo — por eso el ambiente
     es elíptico y con focos puestos donde la referencia los tiene.
     ───────────────────────────────────────────────────────────────── */

  const rnd = rng(0x30c0);

  /* posiciones medidas, en coordenadas locales (abs − 260, abs − 232) */
  const HUEVO = { x: 354, y: 436, r: 117 };
  const POZO_ALTO = { x: 354, y: 90 };
  const POZO_BAJO = { x: 354, y: 728 };
  const NODO = { x: 354, y: 243 };

  const BLANCO = "226,236,255";
  const TEAL = "126,222,224";
  const LILA = "168,146,226";
  const ORO = "236,206,138";
  const CREMA = "248,238,206";

  /* ── 1 · LOS VELOS ────────────────────────────────────────────────
     Cintas que bajan de los ángulos superiores. Cada una es un haz de
     curvas paralelas con jitter: en la referencia son pliegues de tela
     de luz, no una línea. Se generan a la izquierda y se espejan. */
  const CRESTA: Array<[number, number]> = [
    [286, 10], [258, 54], [206, 110], [168, 148], [140, 178], [114, 208],
    [98, 252], [84, 302], [72, 360], [62, 412], [58, 462], [62, 520],
    [74, 580], [92, 642], [112, 700], [136, 756],
  ];
  /** Punto de la cresta a la altura y, interpolado. */
  const cresta = (y: number) => {
    if (y <= CRESTA[0][1]) return CRESTA[0][0];
    for (let i = 1; i < CRESTA.length; i++) {
      if (y <= CRESTA[i][1]) {
        const [xa, ya] = CRESTA[i - 1], [xb, yb] = CRESTA[i];
        return xa + ((y - ya) / (yb - ya)) * (xb - xa);
      }
    }
    return CRESTA[CRESTA.length - 1][0];
  };

  type Cinta = { pts: Array<[number, number]>; o: number; w: number; c: string };
  const velos: Cinta[] = [];
  const rV = rng(0x7e10);
  const rV2 = rng(0x3c17);
  for (let k = 0; k < 40; k++) {
    const u = k / 39;
    /* cada pliegue corre paralelo a la cresta, desplazado a un lado */
    const desp = (u - 0.5) * 150;
    const y0 = -20 + u * 60;
    const y1 = 470 + u * 330;
    const pts: Array<[number, number]> = [];
    for (let t = 0; t <= 16; t++) {
      const y = y0 + ((y1 - y0) * t) / 16;
      /* el pliegue se abre a medida que baja: cerca del nacimiento van
         juntos y en la llanura están desplegados */
      const abre = 0.35 + (t / 16) * 1.15;
      pts.push([cresta(y) + desp * abre + (rV() - 0.5) * 14, y]);
    }
    const col = k % 5 === 0 ? TEAL : k % 3 === 0 ? LILA : BLANCO;
    velos.push({ pts, o: 0.09 + rV() * 0.26, w: 0.6 + rV() * 2.6, c: col });
  }

  /* ── 2 · LA BÓVEDA ────────────────────────────────────────────────
     Los arcos que cruzan la parte alta de la cámara: en la referencia
     son elipses achatadas que nacen y mueren en los velos. */
  const boveda = Array.from({ length: 14 }, (_, k) => ({
    rx: 150 + k * 32,
    ry: 96 + k * 26,
    cy: 200 + k * 7,
    o: 0.4 - k * 0.02,
    c: k % 3 === 0 ? TEAL : k % 5 === 0 ? LILA : BLANCO,
    w: k % 4 === 0 ? 1.5 : 0.8,
  }));

  /* ── 3 · LOS ANILLOS DE GEOMETRÍA ─────────────────────────────────
     Círculos concéntricos sobre el huevo con nodos en sus cruces y
     radios finos. Medido: el mayor llega a r≈300 y el menor a r≈150. */
  const anillos = [150, 186, 222, 258, 300, 346];
  const nodosAnillo: Array<{ x: number; y: number; r: number; o: number }> = [];
  for (const R of anillos) {
    const n = Math.round(R / 22);
    for (let k = 0; k < n; k++) {
      const a = (k / n) * Math.PI * 2 + (R * 0.013);
      nodosAnillo.push({
        x: HUEVO.x + Math.cos(a) * R,
        y: HUEVO.y + Math.sin(a) * R * 0.94,
        r: 0.7 + rnd() * 1.5,
        o: 0.4 + rnd() * 0.5,
      });
    }
  }

  /* ── 4 · LAS RAÍCES ───────────────────────────────────────────────
     El abanico que baja del pozo. Ramificación con semilla: en la
     referencia llena toda la banda y1000..1230 (abs) y es lo que
     sostiene la luminancia 50..120 de esa franja. */
  type Rama = { x1: number; y1: number; x2: number; y2: number; w: number; o: number; c: string };
  const raices: Rama[] = [];
  const brotes: Array<{ x: number; y: number; r: number; o: number }> = [];
  function ramificar(x: number, y: number, ang: number, largo: number, prof: number) {
    if (prof <= 0 || largo < 5) return;
    const x2 = x + Math.cos(ang) * largo;
    const y2 = y + Math.sin(ang) * largo;
    raices.push({
      x1: x, y1: y, x2, y2,
      w: 0.35 + prof * 0.32,
      o: 0.06 + prof * 0.05,
      c: prof > 3 ? CREMA : rnd() < 0.35 ? ORO : BLANCO,
    });
    if (rnd() < 0.22) brotes.push({ x: x2, y: y2, r: 0.5 + rnd() * 1.1, o: 0.3 + rnd() * 0.45 });
    const n = rnd() < 0.45 ? 3 : 2;
    for (let k = 0; k < n; k++) {
      const d = (k - (n - 1) / 2) * (0.34 + rnd() * 0.4);
      ramificar(x2, y2, ang + d + (rnd() - 0.5) * 0.16, largo * (0.66 + rnd() * 0.2), prof - 1);
    }
  }
  for (let k = 0; k < 46; k++) {
    const a = Math.PI / 2 + (k / 45 - 0.5) * Math.PI * 1.3;
    /* los brazos de los extremos son los largos: son los que llevan la
       red hasta las columnas locales 75..176, donde faltaban 21..38 */
    const orilla = Math.abs(k / 45 - 0.5) * 2;
    ramificar(POZO_BAJO.x, POZO_BAJO.y + 8, a, 48 + orilla * 62 + rnd() * 26, 6);
  }
  /* hebras largas que cruzan la llanura hacia los cantos */
  const hebras = Array.from({ length: 44 }, () => {
    const a = Math.PI / 2 + (rnd() - 0.5) * Math.PI * 1.2;
    const largo = 150 + rnd() * 230;
    const curva = (rnd() - 0.5) * 0.8;
    const pts: Array<[number, number]> = [];
    for (let t = 0; t <= 10; t++) {
      const u = t / 10;
      const ang = a + curva * u * u;
      pts.push([POZO_BAJO.x + Math.cos(ang) * largo * u, POZO_BAJO.y + Math.sin(ang) * largo * u * 0.82]);
    }
    return { pts, o: 0.08 + rnd() * 0.2, c: rnd() < 0.35 ? ORO : BLANCO };
  });

  /* ── 5 · LAS SEMILLAS ─────────────────────────────────────────────
     Ovoides translúcidos, cada uno con su embrión. Posiciones medidas
     en la mitad izquierda y espejadas: la referencia es simétrica. */
  const semillasIzq = [
    { x: 181, y: 628, r: 30, c: CREMA },
    { x: 216, y: 673, r: 26, c: ORO },
    { x: 51, y: 728, r: 34, c: CREMA },
    { x: 126, y: 768, r: 37, c: LILA },
    { x: 246, y: 763, r: 20, c: TEAL },
  ];
  const semillas = semillasIzq.flatMap((s) => [s, { ...s, x: 2 * CX - s.x }]);
  /* figuras diminutas de la llanura (abs y≈935) */
  const figuras = [256, 288, 413, 451].map((x, i) => ({ x, y: 700 + (i % 2) * 6 }));

  /* ── 6 · ESTRELLAS Y POLVO ────────────────────────────────────────
     Pocas y grandes, no grano fino: el grano nunca cae donde el de la
     referencia y paga doble en el diff. La cobertura se compra con la
     luz lisa del ambiente, no con puntos. */
  const estrellas = Array.from({ length: 620 }, () => {
    const x = rnd() * W, y = rnd() * H;
    /* densidad según el mapa: se aprietan dentro de la cámara */
    const dx = (x - CX) / 300, dy = (y - 420) / 420;
    const dentro = Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy));
    return { x, y, r: 0.4 + rnd() * 1.2, o: (0.16 + rnd() * 0.6) * (0.28 + dentro), c: rnd() < 0.2 ? ORO : BLANCO };
  });
  const chispas = Array.from({ length: 130 }, () => ({
    x: rnd() * W, y: rnd() * H,
    r: 0.6 + rnd() * 1.8,
    o: 0.2 + rnd() * 0.55,
    v: rnd(),
    c: rnd() < 0.3 ? TEAL : rnd() < 0.6 ? ORO : BLANCO,
  }));

  /* ── capa estática ────────────────────────────────────────────────*/
  const fondo = document.createElement("canvas");
  fondo.width = W; fondo.height = H;
  const f = fondo.getContext("2d")!;

  /** Foco elíptico: la unidad del ambiente. */
  function foco(
    c: CanvasRenderingContext2D,
    x: number, y: number, rx: number, ry: number, col: string, a: number, dentro = 0.0
  ) {
    const gr = c.createRadialGradient(x, y, Math.max(1, rx * dentro), x, y, rx);
    gr.addColorStop(0, tinta(col, a));
    gr.addColorStop(0.42, tinta(col, a * 0.42));
    gr.addColorStop(0.75, tinta(col, a * 0.12));
    gr.addColorStop(1, "rgba(0,0,0,0)");
    c.save();
    c.translate(x, y);
    c.scale(1, ry / rx);
    c.translate(-x, -y);
    c.fillStyle = gr;
    c.beginPath();
    c.arc(x, y, rx, 0, Math.PI * 2);
    c.fill();
    c.restore();
  }

  /** El embrión: cabeza, dorso curvo y extremidades recogidas. La
      referencia lo tiene modelado en luz, no calado. */
  function pintarEmbrion(c: CanvasRenderingContext2D, x: number, y: number, s: number, col: string) {
    /* UNA SOLA SILUETA. Dibujado por partes —cabeza, tronco y pierna en
       tres rellenos— leía como tres óvalos apilados: el banco no lo
       castigaba pero era lo primero que se veía mal. La referencia tiene
       un cuerpo continuo en diagonal, cabeza arriba a la derecha y grupa
       abajo a la izquierda, con la cabeza valiendo un tercio del alto.
       Va como un contorno cerrado y el volumen se modela encima. */
    c.save();
    c.translate(x, y);
    c.rotate(-0.14);
    c.scale(s, s);
    c.lineJoin = "round";
    c.lineCap = "round";

    const silueta = () => {
      c.beginPath();
      c.moveTo(6, -50);
      c.bezierCurveTo(34, -50, 44, -26, 38, -6);
      c.bezierCurveTo(34, 14, 24, 30, 8, 40);
      c.bezierCurveTo(-8, 50, -30, 52, -38, 40);
      c.bezierCurveTo(-46, 28, -34, 18, -22, 16);
      c.bezierCurveTo(-12, 14, -10, 6, -14, -2);
      c.bezierCurveTo(-20, -12, -18, -34, -6, -44);
      c.bezierCurveTo(-2, -48, 2, -50, 6, -50);
      c.closePath();
    };

    /* cuerpo: la luz entra por el sol interior, que está abajo a la
       izquierda, así que el volumen va de ahí al dorso */
    const cuerpo = c.createLinearGradient(-34, 26, 34, -34);
    cuerpo.addColorStop(0, tinta(col, 0.88));
    cuerpo.addColorStop(0.45, tinta(col, 0.66));
    cuerpo.addColorStop(1, tinta(col, 0.38));
    c.fillStyle = cuerpo;
    silueta();
    c.fill();
    c.strokeStyle = tinta(col, 0.75);
    c.lineWidth = 1.6;
    c.stroke();

    /* dentro de la silueta: cabeza encendida, quiebre de la nuca y el
       pliegue de la pierna */
    c.save();
    silueta();
    c.clip();
    const cab = c.createRadialGradient(8, -38, 3, 12, -28, 34);
    cab.addColorStop(0, tinta(col, 0.99));
    cab.addColorStop(0.55, tinta(col, 0.6));
    cab.addColorStop(1, "rgba(0,0,0,0)");
    c.fillStyle = cab;
    c.beginPath();
    c.ellipse(12, -30, 30, 28, -0.12, 0, Math.PI * 2);
    c.fill();
    c.strokeStyle = tinta(col, 0.45);
    c.lineWidth = 1.3;
    /* nuca */
    c.beginPath();
    c.moveTo(38, -12);
    c.quadraticCurveTo(24, -4, 12, -8);
    c.stroke();
    /* pliegue de la cadera */
    c.beginPath();
    c.moveTo(-4, 18);
    c.quadraticCurveTo(-18, 26, -26, 44);
    c.stroke();
    /* brazo doblado sobre el pecho */
    c.strokeStyle = tinta(col, 0.5);
    c.lineWidth = 6;
    c.beginPath();
    c.moveTo(2, -4);
    c.quadraticCurveTo(-12, 4, -12, 16);
    c.stroke();
    c.restore();

    /* perfil del rostro: frente, nariz y mentón mirando abajo-izquierda */
    c.strokeStyle = tinta(col, 0.6);
    c.lineWidth = 1.4;
    c.beginPath();
    c.moveTo(-11, -38);
    c.quadraticCurveTo(-18, -24, -10, -16);
    c.stroke();
    /* oreja */
    c.beginPath();
    c.arc(24, -26, 6, Math.PI * 0.6, Math.PI * 1.7);
    c.stroke();

    /* cordón, que en la referencia sale de la grupa hacia la red */
    c.strokeStyle = tinta(col, 0.34);
    c.lineWidth = 2;
    c.beginPath();
    c.moveTo(-6, 34);
    c.quadraticCurveTo(-30, 46, -44, 66);
    c.stroke();
    c.restore();
  }

  function pintarSemilla(c: CanvasRenderingContext2D, s: typeof semillas[number]) {
    const rx = s.r * 0.82, ry = s.r;
    /* halo */
    foco(c, s.x, s.y, s.r * 1.9, s.r * 1.9, s.c, 0.04);
    /* cáscara */
    const gr = c.createRadialGradient(s.x - rx * 0.3, s.y - ry * 0.4, rx * 0.1, s.x, s.y, rx * 1.15);
    gr.addColorStop(0, tinta(s.c, 0.22));
    gr.addColorStop(0.7, tinta(s.c, 0.07));
    gr.addColorStop(1, tinta(s.c, 0.16));
    c.fillStyle = gr;
    c.beginPath();
    c.ellipse(s.x, s.y, rx, ry, 0, 0, Math.PI * 2);
    c.fill();
    c.strokeStyle = tinta(s.c, 0.55);
    c.lineWidth = 1;
    c.stroke();
    /* reflejo alto */
    c.strokeStyle = tinta(BLANCO, 0.45);
    c.lineWidth = 1.4;
    c.beginPath();
    c.ellipse(s.x, s.y, rx * 0.72, ry * 0.76, 0.5, Math.PI * 1.05, Math.PI * 1.62);
    c.stroke();
    /* embrión dentro */
    /* la silueta nueva es más alta que la vieja: dentro de la semilla
       hay que bajarle la escala o el ovoide queda relleno */
    pintarEmbrion(c, s.x, s.y + s.r * 0.04, s.r / 88, s.c);
    /* base encendida */
    foco(c, s.x, s.y + ry * 0.92, rx * 1.15, ry * 0.36, s.c, 0.18);
  }

  function pintarFondo() {
    /* 1 · el negro de la cámara */
    f.fillStyle = "#02030a";
    f.fillRect(0, 0, W, H);

    /* 2 · EL AMBIENTE — viñeta ELÍPTICA con focos donde el mapa de
       luminancia de la referencia tiene sus máximos. Sin esto la caja
       mide como si le faltara la mitad del dibujo. */
    /* cámara entera */
    foco(f, CX, 500, 380, 460, "40,54,104", 0.44);
    /* boca del túnel: la referencia mide 91..156 de local x206 a x502 en
       la fila 75, y 187 en su máximo. Es una BANDA ancha, no un punto. */
    foco(f, CX, 104, 158, 96, "116,146,206", 0.7);
    foco(f, CX, 88, 108, 56, "184,208,248", 0.55);
    foco(f, CX, 30, 62, 60, "150,180,235", 0.6);
    /* la columna del eje entre la boca y el huevo: la referencia mide
       55..110 de local y150 a y320 y yo daba 25..40 */
    foco(f, CX, 200, 96, 110, "116,146,206", 0.52);
    foco(f, CX, 290, 104, 96, "126,152,212", 0.58);
    /* el huevo: máximo absoluto del campo (215) */
    foco(f, HUEVO.x, HUEVO.y, 250, 240, "116,126,190", 0.44);
    /* velos: una cadena de focos SOBRE la cresta medida, y su espejo */
    for (let y = 40; y <= 720; y += 32) {
      const x = cresta(y);
      /* arriba el velo es una cortina ancha y abajo un filamento: medido
         en la referencia, a la altura local 63 llega de abs 690 a 841 y a
         la 400 se cierra en 60 px. Y el velo DERECHO va más brillante:
         115 contra los 66 de su espejo en la fila abs 380. */
      /* Perfil del velo por altura, tramo a tramo contra el delta. El
         tramo bajo se probó a 88/0,6 —la referencia todavía mide 122 a
         esa altura— y costó medio punto de arte-medio: el déficit de
         ahí no es del velo sino de la llanura, que va detrás. */
      const ancho = y < 130 ? 128 : y < 240 ? 116 : y < 300 ? 96 : y < 400 ? 82 : y < 470 ? 78 : 68;
      const cerca = y < 130 ? 0.56 : y < 240 ? 0.62 : y < 300 ? 0.5 : y < 430 ? 0.42 : 0.54;
      const mas = y < 300 ? 1.4 : 1;
      foco(f, x, y, ancho, 82, "100,136,198", cerca);
      foco(f, W - x, y, ancho * (mas > 1 ? 1.22 : 1), 82, "100,136,198", Math.min(0.84, cerca * mas));
    }
    /* el chorro entre el huevo y el pozo: −57..−89 medidos en el eje de
       la fila 811 a la 912. Es lo que más faltaba de toda la caja. */
    foco(f, CX, 600, 150, 180, "140,160,214", 0.6);
    foco(f, CX, 660, 96, 110, "150,168,220", 0.5);
    /* la llanura: banda ancha y LISA de local y560 a y700, que en la
       referencia va de 100 a 140 en casi todo el ancho */
    foco(f, CX, 590, 340, 108, "96,120,180", 0.6);
    foco(f, CX, 650, 340, 112, "92,116,172", 0.54);
    foco(f, CX, 706, 300, 116, "88,110,166", 0.34);
    for (const px of [202, 506]) {
      foco(f, px, 580, 116, 92, "94,118,176", 0.5);
      foco(f, px, 660, 118, 98, "92,116,172", 0.44);
      foco(f, px, 760, 112, 84, "78,98,152", 0.38);
    }
    /* pozo bajo (máximos 176/174 a y985 abs → 753 local) */
    foco(f, CX, 730, 262, 96, "124,144,198", 0.52);
    foco(f, CX, 752, 130, 72, "180,200,240", 0.22);
    /* el abanico bajo: 78..134 a la altura local 781 */
    foco(f, CX, 796, 300, 118, "76,96,152", 0.62);
    foco(f, CX, 842, 268, 96, "68,86,140", 0.44);
    /* cierre a negro en los cantos: la referencia mide 4..53 en la
       columna local 29 y otro tanto en la 679 */
    const canto = f.createRadialGradient(CX, 470, 210, CX, 470, 470);
    canto.addColorStop(0, "rgba(0,0,0,0)");
    canto.addColorStop(0.55, "rgba(3,4,10,0.3)");
    canto.addColorStop(1, "rgba(3,4,10,0.95)");
    f.save();
    f.translate(CX, 470); f.scale(1, 1.42); f.translate(-CX, -470);
    f.fillStyle = canto;
    f.fillRect(-300, -400, W + 600, H + 800);
    f.restore();

    /* 3 · estrellas, bajo todo lo demás */
    for (const e of estrellas) {
      f.fillStyle = tinta(e.c, e.o);
      f.beginPath(); f.arc(e.x, e.y, e.r, 0, Math.PI * 2); f.fill();
    }

    /* 4 · LOS VELOS, y su espejo */
    for (const lado of [1, -1] as const) {
      f.save();
      if (lado < 0) { f.translate(W, 0); f.scale(-1, 1); }
      /* ondas transversales: los quiebres de la tela */
      for (let k = 0; k < 54; k++) {
        const y = 20 + k * 13 + (rV2() - 0.5) * 10;
        const x = cresta(y);
        const w = 40 + rV2() * 70;
        f.strokeStyle = tinta(k % 4 === 0 ? TEAL : k % 3 === 0 ? LILA : BLANCO, 0.05 + rV2() * 0.12);
        f.lineWidth = 1 + rV2() * 3;
        f.beginPath();
        f.moveTo(x - w * 0.6, y - 5);
        f.quadraticCurveTo(x, y + 7, x + w * 0.6, y - 2);
        f.stroke();
      }
      for (const v of velos) {
        /* halo del pliegue. Probado a ×14 de ancho para que el velo
           leyera como cortina: costó +3 en arte-medio y +2,2 en
           arte-alto. La referencia tiene el volumen en el AMBIENTE, no
           en el trazo; el pliegue va fino. */
        f.strokeStyle = tinta(v.c, v.o * 0.28);
        f.lineWidth = v.w * 5;
        f.beginPath();
        f.moveTo(v.pts[0][0], v.pts[0][1]);
        for (const [x, y] of v.pts.slice(1)) f.lineTo(x, y);
        f.stroke();
        /* filamento */
        f.strokeStyle = tinta(v.c, v.o * 1.5);
        f.lineWidth = v.w * 0.7;
        f.stroke();
      }
      f.restore();
    }

    /* jirones del techo en los ángulos altos: la referencia promedia
       3..16 ahí —es filamento fino sobre negro, no un foco— */
    for (let k = 0; k < 44; k++) {
      const lado = k % 2 ? 1 : -1;
      const x0 = CX + lado * (150 + rV2() * 210);
      const y0 = -10 + rV2() * 90;
      f.strokeStyle = tinta(k % 3 === 0 ? LILA : BLANCO, 0.05 + rV2() * 0.16);
      f.lineWidth = 0.6 + rV2() * 1.4;
      f.beginPath();
      f.moveTo(x0, y0);
      f.quadraticCurveTo(x0 + lado * 60, y0 + 30 + rV2() * 30, x0 + lado * (90 + rV2() * 80), y0 + 20 + rV2() * 70);
      f.stroke();
    }

    /* 5 · la bóveda */
    for (const b of boveda) {
      /* halo del arco: la bóveda de la referencia tiene grosor */
      f.strokeStyle = tinta(b.c, b.o * 0.3);
      f.lineWidth = b.w * 4;
      f.beginPath();
      f.ellipse(CX, b.cy, b.rx, b.ry, 0, Math.PI * 1.04, Math.PI * 1.96);
      f.stroke();
      f.strokeStyle = tinta(b.c, b.o);
      f.lineWidth = b.w;
      f.stroke();
    }

    /* 6 · anillos de geometría sobre el huevo */
    for (const R of anillos) {
      f.strokeStyle = tinta(ORO, R > 300 ? 0.16 : 0.28);
      f.lineWidth = 0.7;
      f.beginPath();
      f.ellipse(HUEVO.x, HUEVO.y, R, R * 0.94, 0, 0, Math.PI * 2);
      f.stroke();
    }
    /* radios y cuerdas: la red que sostiene los anillos */
    for (let k = 0; k < 24; k++) {
      const a = (k / 24) * Math.PI * 2;
      f.strokeStyle = tinta(ORO, 0.09 + (k % 3) * 0.05);
      f.lineWidth = 0.5;
      f.beginPath();
      f.moveTo(HUEVO.x + Math.cos(a) * 150, HUEVO.y + Math.sin(a) * 141);
      f.lineTo(HUEVO.x + Math.cos(a) * 346, HUEVO.y + Math.sin(a) * 325);
      f.stroke();
    }
    for (let k = 0; k < 18; k++) {
      const a = (k / 18) * Math.PI * 2;
      const b = a + Math.PI / 3;
      f.strokeStyle = tinta(CREMA, 0.1);
      f.lineWidth = 0.5;
      f.beginPath();
      f.moveTo(HUEVO.x + Math.cos(a) * 258, HUEVO.y + Math.sin(a) * 242);
      f.lineTo(HUEVO.x + Math.cos(b) * 258, HUEVO.y + Math.sin(b) * 242);
      f.stroke();
    }
    for (const n of nodosAnillo) {
      f.fillStyle = tinta(ORO, n.o);
      f.beginPath(); f.arc(n.x, n.y, n.r, 0, Math.PI * 2); f.fill();
    }
    /* las dos marcas cardinales del eje horizontal del huevo (medidas
       a x≈595 y x≈1055 abs, y≈870) */
    for (const s of [-1, 1]) {
      const x = HUEVO.x + s * 258;
      f.strokeStyle = tinta(CREMA, 0.3);
      f.lineWidth = 0.6;
      f.beginPath(); f.arc(x, HUEVO.y, 14, 0, Math.PI * 2); f.stroke();
      f.beginPath(); f.arc(x, HUEVO.y, 22, 0, Math.PI * 2); f.stroke();
      f.fillStyle = tinta(CREMA, 0.9);
      f.beginPath(); f.arc(x, HUEVO.y, 2.6, 0, Math.PI * 2); f.fill();
      f.strokeStyle = tinta(CREMA, 0.18);
      f.beginPath(); f.moveTo(x - 90, HUEVO.y); f.lineTo(x + 90, HUEVO.y); f.stroke();
    }

    /* 7 · RAÍCES */
    for (const h of hebras) {
      f.strokeStyle = tinta(h.c, h.o);
      f.lineWidth = 0.7;
      f.beginPath();
      f.moveTo(h.pts[0][0], h.pts[0][1]);
      for (const [x, y] of h.pts.slice(1)) f.lineTo(x, y);
      f.stroke();
    }
    for (const r of raices) {
      f.strokeStyle = tinta(r.c, r.o);
      f.lineWidth = r.w;
      f.beginPath(); f.moveTo(r.x1, r.y1); f.lineTo(r.x2, r.y2); f.stroke();
    }
    for (const b of brotes) {
      f.fillStyle = tinta(CREMA, b.o);
      f.beginPath(); f.arc(b.x, b.y, b.r, 0, Math.PI * 2); f.fill();
    }

    /* 8 · SEMILLAS y figuras */
    for (const s of semillas) pintarSemilla(f, s);
    for (const p of figuras) {
      foco(f, p.x, p.y, 16, 22, CREMA, 0.5);
      f.fillStyle = tinta(CREMA, 0.8);
      f.beginPath(); f.ellipse(p.x, p.y - 5, 2.6, 3.4, 0, 0, Math.PI * 2); f.fill();
      f.beginPath();
      f.moveTo(p.x - 3, p.y + 8);
      f.quadraticCurveTo(p.x, p.y - 3, p.x + 3, p.y + 8);
      f.closePath(); f.fill();
    }

    /* 9 · cierre contra el papel: la referencia funde el organismo con
       el negro de la lámina, no lo recorta */
    const cierre = f.createLinearGradient(0, 0, 0, H);
    cierre.addColorStop(0, "rgba(2,3,9,0.92)");
    cierre.addColorStop(0.04, "rgba(3,4,10,0)");
    cierre.addColorStop(0.86, "rgba(3,4,10,0)");
    cierre.addColorStop(1, "rgba(3,4,10,0.98)");
    f.fillStyle = cierre;
    f.fillRect(0, 0, W, H);
    const lados = f.createLinearGradient(0, 0, W, 0);
    lados.addColorStop(0, "rgba(3,4,10,0.9)");
    lados.addColorStop(0.055, "rgba(3,4,10,0)");
    lados.addColorStop(0.945, "rgba(3,4,10,0)");
    lados.addColorStop(1, "rgba(3,4,10,0.9)");
    f.fillStyle = lados;
    f.fillRect(0, 0, W, H);
    for (const cx of [0, W]) {
      const ang = f.createRadialGradient(cx, 40, 40, cx, 40, 260);
      ang.addColorStop(0, "rgba(3,4,10,0.95)");
      ang.addColorStop(0.6, "rgba(3,4,10,0.5)");
      ang.addColorStop(1, "rgba(3,4,10,0)");
      f.fillStyle = ang;
      f.fillRect(cx - 300, -300, 600, 600);
    }
  }

  /* ── piezas vivas ─────────────────────────────────────────────────*/
  function pozo(c: CanvasRenderingContext2D, x: number, y: number, esc: number, fase: number, pulso: number) {
    c.save();
    c.globalCompositeOperation = "lighter";
    for (let k = 0; k < 7; k++) {
      const u = (k / 7 + fase * 0.5) % 1;
      const rx = (30 + u * 150) * esc;
      c.strokeStyle = tinta(BLANCO, (0.3 - u * 0.26) * pulso);
      c.lineWidth = 1.1;
      c.beginPath();
      c.ellipse(x, y, rx, rx * 0.26, 0, 0, Math.PI * 2);
      c.stroke();
    }
    const nucleo = c.createRadialGradient(x, y, 0, x, y, 66 * esc);
    nucleo.addColorStop(0, tinta("255,252,240", 0.98 * pulso));
    nucleo.addColorStop(0.14, tinta(BLANCO, 0.5 * pulso));
    nucleo.addColorStop(0.5, tinta(BLANCO, 0.16 * pulso));
    nucleo.addColorStop(1, "rgba(0,0,0,0)");
    c.fillStyle = nucleo;
    c.beginPath();
    c.ellipse(x, y, 66 * esc, 34 * esc, 0, 0, Math.PI * 2);
    c.fill();
    c.restore();
  }

  function pintarEje(pulso: number) {
    g.save();
    g.globalCompositeOperation = "lighter";
    const haz = g.createLinearGradient(CX - 12, 0, CX + 12, 0);
    haz.addColorStop(0, "rgba(0,0,0,0)");
    haz.addColorStop(0.5, tinta("214,232,255", 0.34 * pulso));
    haz.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = haz;
    g.fillRect(CX - 12, 30, 24, 210);
    g.fillRect(CX - 8, 552, 16, 190);
    /* el nodo de geometría del eje (y≈475 abs → 243 local) */
    const n = g.createRadialGradient(NODO.x, NODO.y, 0, NODO.x, NODO.y, 36);
    n.addColorStop(0, tinta("255,246,214", 0.95 * pulso));
    n.addColorStop(0.16, tinta(ORO, 0.4 * pulso));
    n.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = n;
    g.beginPath(); g.arc(NODO.x, NODO.y, 36, 0, Math.PI * 2); g.fill();
    g.restore();
    /* rosetón del nodo */
    g.strokeStyle = tinta(CREMA, 0.4);
    g.lineWidth = 0.7;
    for (let k = 0; k < 6; k++) {
      const a = (k / 6) * Math.PI;
      g.beginPath();
      g.ellipse(NODO.x, NODO.y, 26, 11, a, 0, Math.PI * 2);
      g.stroke();
    }
    g.strokeStyle = tinta(CREMA, 0.28);
    g.beginPath(); g.arc(NODO.x, NODO.y, 30, 0, Math.PI * 2); g.stroke();
  }

  function pintarHuevo(pulso: number) {
    const { x, y, r } = HUEVO;
    /* halo */
    g.save();
    g.globalCompositeOperation = "lighter";
    const halo = g.createRadialGradient(x, y, r * 0.3, x, y, r * 2.1);
    halo.addColorStop(0, tinta("150,170,225", 0.3 * pulso));
    halo.addColorStop(0.45, tinta("110,130,190", 0.12));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo;
    g.beginPath(); g.arc(x, y, r * 2.1, 0, Math.PI * 2); g.fill();
    g.restore();

    /* la burbuja */
    const burbuja = g.createRadialGradient(x - r * 0.32, y - r * 0.42, r * 0.08, x, y, r * 1.06);
    burbuja.addColorStop(0, tinta("206,216,255", 0.5));
    burbuja.addColorStop(0.55, tinta("104,120,190", 0.34));
    burbuja.addColorStop(0.88, tinta("150,168,235", 0.32));
    burbuja.addColorStop(1, tinta("214,228,255", 0.46));
    g.fillStyle = burbuja;
    g.beginPath(); g.arc(x, y, r, 0, Math.PI * 2); g.fill();
    g.strokeStyle = tinta("214,228,255", 0.55);
    g.lineWidth = 1.4;
    g.stroke();
    /* reflejo alto y bajo */
    g.strokeStyle = tinta("235,244,255", 0.55);
    g.lineWidth = 2.4;
    g.beginPath(); g.arc(x, y, r * 0.93, Math.PI * 1.12, Math.PI * 1.6); g.stroke();
    g.strokeStyle = tinta("225,236,255", 0.34);
    g.lineWidth = 3;
    g.beginPath(); g.arc(x, y, r * 0.95, Math.PI * 0.22, Math.PI * 0.66); g.stroke();
    /* punto de luz del polo, que en la referencia parte el aro */
    g.save();
    g.globalCompositeOperation = "lighter";
    const polo = g.createRadialGradient(x, y - r, 0, x, y - r, 78);
    polo.addColorStop(0, tinta("255,253,244", 0.98 * pulso));
    polo.addColorStop(0.16, tinta("222,236,255", 0.5));
    polo.addColorStop(0.45, tinta("180,206,250", 0.2));
    polo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = polo;
    g.beginPath(); g.arc(x, y - r, 78, 0, Math.PI * 2); g.fill();
    g.restore();

    /* red de filamentos de oro dentro de la burbuja */
    g.save();
    g.beginPath(); g.arc(x, y, r * 0.98, 0, Math.PI * 2); g.clip();
    const rFil = rng(0x30f1);
    for (let k = 0; k < 170; k++) {
      const a0 = rFil() * Math.PI * 2, r0 = Math.sqrt(rFil()) * r * 0.9;
      const a1 = a0 + (rFil() - 0.5) * 1.6, r1 = Math.sqrt(rFil()) * r * 0.9;
      g.strokeStyle = tinta(ORO, 0.16 + rFil() * 0.4);
      g.lineWidth = 0.55;
      g.beginPath();
      g.moveTo(x + Math.cos(a0) * r0, y + Math.sin(a0) * r0);
      g.quadraticCurveTo(x, y + 6, x + Math.cos(a1) * r1, y + Math.sin(a1) * r1);
      g.stroke();
    }
    /* el sol interior, tras el embrión */
    g.save();
    g.globalCompositeOperation = "lighter";
    const sx = x - 26, sy = y + 16;
    const sol = g.createRadialGradient(sx, sy, 0, sx, sy, 62);
    sol.addColorStop(0, tinta("255,240,196", 0.95 * pulso));
    sol.addColorStop(0.08, tinta("250,206,120", 0.5 * pulso));
    sol.addColorStop(0.34, tinta("212,150,70", 0.14));
    sol.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = sol;
    g.beginPath(); g.arc(sx, sy, 62, 0, Math.PI * 2); g.fill();
    for (let k = 0; k < 22; k++) {
      const a = (k / 22) * Math.PI * 2;
      g.strokeStyle = tinta("255,232,170", (k % 4 === 0 ? 0.3 : 0.14) * pulso);
      g.lineWidth = k % 4 === 0 ? 1.1 : 0.6;
      g.beginPath();
      g.moveTo(sx + Math.cos(a) * 6, sy + Math.sin(a) * 6);
      g.lineTo(sx + Math.cos(a) * (k % 4 === 0 ? 62 : 34), sy + Math.sin(a) * (k % 4 === 0 ? 62 : 34));
      g.stroke();
    }
    g.restore();
    /* el embrión */
    pintarEmbrion(g, x + 16, y - 4, 1.42, "252,238,214");
    /* la red pasa POR DELANTE: en la referencia el feto está dentro del
       tejido, no delante de él */
    const rFrente = rng(0x30f7);
    for (let k = 0; k < 46; k++) {
      const a0 = rFrente() * Math.PI * 2, r0 = Math.sqrt(rFrente()) * r * 0.92;
      const a1 = a0 + (rFrente() - 0.5) * 1.8, r1 = Math.sqrt(rFrente()) * r * 0.92;
      g.strokeStyle = tinta(ORO, 0.14 + rFrente() * 0.32);
      g.lineWidth = 0.5;
      g.beginPath();
      g.moveTo(x + Math.cos(a0) * r0, y + Math.sin(a0) * r0);
      g.quadraticCurveTo(x + 8, y - 10, x + Math.cos(a1) * r1, y + Math.sin(a1) * r1);
      g.stroke();
    }
    g.restore();
  }

  /* ── mandala de CRADLE GEOMETRY ───────────────────────────────────*/
  const cuna = document.getElementById("gc-cuna") as HTMLCanvasElement | null;
  const gc = cuna?.getContext("2d") ?? null;
  const NODOS_CUNA = [
    { y: -110, r: 14 }, { y: -80, r: 9 }, { y: -52, r: 10 },
    { y: 54, r: 9 }, { y: 84, r: 9 }, { y: 114, r: 15 },
  ];
  function pintarCuna(fase: number) {
    if (!gc) return;
    const S = { w: 216, h: 304 }, cx = 108, cy = 152;
    const pulso = 0.84 + 0.16 * Math.sin(fase * Math.PI * 2);
    gc.clearRect(0, 0, S.w, S.h);
    gc.strokeStyle = tinta("200,171,114", 0.34);
    gc.lineWidth = 0.7;
    /* vesica vertical + círculos de construcción */
    gc.beginPath(); gc.ellipse(cx, cy, 100, 128, 0, 0, Math.PI * 2); gc.stroke();
    gc.beginPath(); gc.ellipse(cx, cy, 76, 76, 0, 0, Math.PI * 2); gc.stroke();
    gc.beginPath(); gc.ellipse(cx, cy - 40, 62, 62, 0, 0, Math.PI * 2); gc.stroke();
    gc.beginPath(); gc.ellipse(cx, cy + 40, 62, 62, 0, 0, Math.PI * 2); gc.stroke();
    gc.strokeStyle = tinta("200,171,114", 0.2);
    for (let k = 0; k < 6; k++) {
      const a = (k / 6) * Math.PI;
      gc.beginPath(); gc.ellipse(cx, cy, 32, 88, a, 0, Math.PI * 2); gc.stroke();
    }
    gc.strokeStyle = tinta("200,171,114", 0.3);
    gc.beginPath(); gc.moveTo(cx - 100, cy); gc.lineTo(cx + 100, cy); gc.stroke();
    gc.beginPath(); gc.moveTo(cx, cy - 128); gc.lineTo(cx, cy + 128); gc.stroke();
    /* nodos del eje */
    gc.save();
    gc.globalCompositeOperation = "lighter";
    for (const n of NODOS_CUNA) {
      const gr = gc.createRadialGradient(cx, cy + n.y, 0, cx, cy + n.y, n.r * 2.4);
      gr.addColorStop(0, tinta("255,244,214", 0.9 * pulso));
      gr.addColorStop(0.2, tinta("236,206,138", 0.4));
      gr.addColorStop(1, "rgba(0,0,0,0)");
      gc.fillStyle = gr;
      gc.beginPath(); gc.arc(cx, cy + n.y, n.r * 2.4, 0, Math.PI * 2); gc.fill();
    }
    /* cardinales */
    for (const s of [-1, 1]) {
      const gr = gc.createRadialGradient(cx + s * 76, cy, 0, cx + s * 76, cy, 34);
      gr.addColorStop(0, tinta("255,244,214", 0.9 * pulso));
      gr.addColorStop(0.2, tinta("236,206,138", 0.36));
      gr.addColorStop(1, "rgba(0,0,0,0)");
      gc.fillStyle = gr;
      gc.beginPath(); gc.arc(cx + s * 76, cy, 34, 0, Math.PI * 2); gc.fill();
    }
    /* corazón */
    const nuc = gc.createRadialGradient(cx, cy, 0, cx, cy, 62);
    nuc.addColorStop(0, tinta("255,250,232", 0.99 * pulso));
    nuc.addColorStop(0.12, tinta("250,224,160", 0.8 * pulso));
    nuc.addColorStop(0.4, tinta("214,168,86", 0.26));
    nuc.addColorStop(1, "rgba(0,0,0,0)");
    gc.fillStyle = nuc;
    gc.beginPath(); gc.arc(cx, cy, 62, 0, Math.PI * 2); gc.fill();
    for (let k = 0; k < 4; k++) {
      const a = (k / 4) * Math.PI * 2;
      gc.strokeStyle = tinta("255,240,200", 0.35 * pulso);
      gc.lineWidth = 1;
      gc.beginPath();
      gc.moveTo(cx + Math.cos(a) * 6, cy + Math.sin(a) * 6);
      gc.lineTo(cx + Math.cos(a) * 44, cy + Math.sin(a) * 44);
      gc.stroke();
    }
    gc.restore();
    /* anillos alrededor de los nodos mayores */
    gc.strokeStyle = tinta("222,196,140", 0.5);
    gc.lineWidth = 0.8;
    for (const n of [NODOS_CUNA[0], NODOS_CUNA[5]]) {
      gc.beginPath(); gc.arc(cx, cy + n.y, n.r + 8, 0, Math.PI * 2); gc.stroke();
    }
  }

  /* ── nodos de SOURCE-TO-BODY TRANSMISSION ─────────────────────────*/
  const nodosCv = document.getElementById("gc-nodos") as HTMLCanvasElement | null;
  const gn = nodosCv?.getContext("2d") ?? null;
  const rNodo = rng(0x30bd);
  const motasNodo = Array.from({ length: 6 }, () =>
    Array.from({ length: 22 }, () => {
      const a = rNodo() * Math.PI * 2, rr = 30 + rNodo() * 14;
      return { x: Math.cos(a) * rr, y: Math.sin(a) * rr, o: 0.3 + rNodo() * 0.5 };
    })
  );
  function pintarNodos(fase: number) {
    if (!gn) return;
    gn.clearRect(0, 0, 120, 450);
    const cx = 60;
    /* el cordón que los enhebra */
    const cord = gn.createLinearGradient(0, 0, 0, 450);
    cord.addColorStop(0, tinta("236,206,138", 0.1));
    cord.addColorStop(0.5, tinta("255,236,180", 0.5));
    cord.addColorStop(1, tinta("236,206,138", 0.1));
    gn.strokeStyle = cord;
    gn.lineWidth = 1.6;
    gn.beginPath(); gn.moveTo(cx, 12); gn.lineTo(cx, 438); gn.stroke();
    for (let i = 0; i < 6; i++) {
      const cy = 35 + i * 72.5;
      const pulso = 0.78 + 0.22 * Math.sin(fase * Math.PI * 2 + i * 0.7);
      /* aro exterior punteado */
      gn.strokeStyle = tinta("200,171,114", 0.32);
      gn.lineWidth = 0.7;
      gn.setLineDash([1, 4]);
      gn.beginPath(); gn.arc(cx, cy, 45, 0, Math.PI * 2); gn.stroke();
      gn.setLineDash([]);
      gn.strokeStyle = tinta("200,171,114", 0.5);
      gn.beginPath(); gn.arc(cx, cy, 29, 0, Math.PI * 2); gn.stroke();
      for (const m of motasNodo[i]) {
        gn.fillStyle = tinta("236,206,138", m.o);
        gn.beginPath(); gn.arc(cx + m.x, cy + m.y, 0.8, 0, Math.PI * 2); gn.fill();
      }
      /* cruz de construcción */
      gn.strokeStyle = tinta("200,171,114", 0.22);
      gn.beginPath(); gn.moveTo(cx - 50, cy); gn.lineTo(cx + 50, cy); gn.stroke();
      gn.beginPath(); gn.moveTo(cx, cy - 50); gn.lineTo(cx, cy + 50); gn.stroke();

      gn.save();
      gn.globalCompositeOperation = "lighter";
      if (i === 0) {
        /* LA FUENTE: estallido */
        const s = gn.createRadialGradient(cx, cy, 0, cx, cy, 26);
        s.addColorStop(0, tinta("255,250,232", 0.98 * pulso));
        s.addColorStop(0.16, tinta("250,222,160", 0.5));
        s.addColorStop(1, "rgba(0,0,0,0)");
        gn.fillStyle = s;
        gn.beginPath(); gn.arc(cx, cy, 26, 0, Math.PI * 2); gn.fill();
        for (let k = 0; k < 20; k++) {
          const a = (k / 20) * Math.PI * 2;
          gn.strokeStyle = tinta("255,240,200", (k % 5 === 0 ? 0.5 : 0.22) * pulso);
          gn.lineWidth = 0.7;
          gn.beginPath();
          gn.moveTo(cx + Math.cos(a) * 5, cy + Math.sin(a) * 5);
          gn.lineTo(cx + Math.cos(a) * (k % 5 === 0 ? 26 : 15), cy + Math.sin(a) * (k % 5 === 0 ? 26 : 15));
          gn.stroke();
        }
      } else if (i === 1) {
        /* MATRIZ DEL ALMA: roseta de pétalos */
        gn.strokeStyle = tinta("236,206,138", 0.75);
        gn.lineWidth = 0.9;
        for (let k = 0; k < 8; k++) {
          const a = (k / 8) * Math.PI * 2;
          gn.beginPath();
          gn.ellipse(cx + Math.cos(a) * 10, cy + Math.sin(a) * 10, 11, 6, a, 0, Math.PI * 2);
          gn.stroke();
        }
        gn.beginPath(); gn.arc(cx, cy, 6, 0, Math.PI * 2); gn.stroke();
      } else if (i === 2) {
        /* CODIFICACIÓN LUMINOSA: cubo isométrico */
        gn.strokeStyle = tinta("196,224,255", 0.8);
        gn.lineWidth = 0.9;
        const p = (a: number, r: number) => [cx + Math.cos(a) * r, cy + Math.sin(a) * r] as const;
        const hex = Array.from({ length: 6 }, (_, k) => p((k / 6) * Math.PI * 2 - Math.PI / 6, 20));
        gn.beginPath();
        hex.forEach(([x, y], k) => (k ? gn.lineTo(x, y) : gn.moveTo(x, y)));
        gn.closePath(); gn.stroke();
        gn.beginPath();
        for (const k of [0, 2, 4]) { gn.moveTo(cx, cy); gn.lineTo(hex[k][0], hex[k][1]); }
        gn.stroke();
        const cu = gn.createRadialGradient(cx, cy, 0, cx, cy, 20);
        cu.addColorStop(0, tinta("190,230,255", 0.5 * pulso));
        cu.addColorStop(1, "rgba(0,0,0,0)");
        gn.fillStyle = cu;
        gn.beginPath(); gn.arc(cx, cy, 20, 0, Math.PI * 2); gn.fill();
      } else if (i === 3) {
        /* PLANTILLA DEL CUERPO: el embrión de línea */
        gn.restore();
        gn.strokeStyle = tinta("236,206,138", 0.8);
        gn.lineWidth = 1;
        gn.beginPath();
        gn.ellipse(cx - 2, cy - 9, 11, 10, -0.2, 0, Math.PI * 2);
        gn.stroke();
        gn.beginPath();
        gn.moveTo(cx - 1, cy - 1);
        gn.bezierCurveTo(cx + 14, cy + 1, cx + 14, cy + 16, cx + 2, cy + 20);
        gn.bezierCurveTo(cx - 12, cy + 22, cx - 15, cy + 8, cx - 9, cy + 2);
        gn.stroke();
        gn.beginPath();
        gn.moveTo(cx - 6, cy + 12);
        gn.quadraticCurveTo(cx - 15, cy + 20, cx - 6, cy + 22);
        gn.stroke();
        gn.save();
        gn.globalCompositeOperation = "lighter";
        const e = gn.createRadialGradient(cx, cy + 4, 0, cx, cy + 4, 24);
        e.addColorStop(0, tinta("255,236,180", 0.34 * pulso));
        e.addColorStop(1, "rgba(0,0,0,0)");
        gn.fillStyle = e;
        gn.beginPath(); gn.arc(cx, cy + 4, 24, 0, Math.PI * 2); gn.fill();
      } else if (i === 4) {
        /* PUERTA DE ENCARNACIÓN: espirales que convergen */
        gn.strokeStyle = tinta("236,206,138", 0.5);
        gn.lineWidth = 0.8;
        for (let s = 0; s < 3; s++) {
          gn.beginPath();
          for (let t = 0; t <= 40; t++) {
            const u = t / 40;
            const a = u * Math.PI * 2.4 + (s / 3) * Math.PI * 2;
            const r = 4 + u * 26;
            const x = cx + Math.cos(a) * r, y = cy + Math.sin(a) * r * 0.8;
            t ? gn.lineTo(x, y) : gn.moveTo(x, y);
          }
          gn.stroke();
        }
        const gd = gn.createRadialGradient(cx, cy, 0, cx, cy, 22);
        gd.addColorStop(0, tinta("255,244,214", 0.9 * pulso));
        gd.addColorStop(0.2, tinta("236,206,138", 0.34));
        gd.addColorStop(1, "rgba(0,0,0,0)");
        gn.fillStyle = gd;
        gn.beginPath(); gn.arc(cx, cy, 22, 0, Math.PI * 2); gn.fill();
      } else {
        /* NACIMIENTO EN LA FORMA: la figura de brazos abiertos */
        gn.restore();
        gn.strokeStyle = tinta("236,206,138", 0.85);
        gn.lineWidth = 1.1;
        gn.beginPath(); gn.arc(cx, cy - 15, 4.5, 0, Math.PI * 2); gn.stroke();
        gn.beginPath();
        gn.moveTo(cx, cy - 10); gn.lineTo(cx, cy + 16);
        gn.moveTo(cx - 20, cy + 2); gn.quadraticCurveTo(cx, cy - 6, cx + 20, cy + 2);
        gn.moveTo(cx, cy + 16); gn.lineTo(cx - 7, cy + 28);
        gn.moveTo(cx, cy + 16); gn.lineTo(cx + 7, cy + 28);
        gn.stroke();
        gn.save();
        gn.globalCompositeOperation = "lighter";
        const b = gn.createRadialGradient(cx, cy + 18, 0, cx, cy + 18, 30);
        b.addColorStop(0, tinta("255,244,214", 0.6 * pulso));
        b.addColorStop(1, "rgba(0,0,0,0)");
        gn.fillStyle = b;
        gn.beginPath(); gn.arc(cx, cy + 18, 30, 0, Math.PI * 2); gn.fill();
      }
      gn.restore();
      /* la cuenta encendida del cordón, entre nodo y nodo */
      if (i < 5) {
        gn.save();
        gn.globalCompositeOperation = "lighter";
        const cy2 = cy + 36;
        const cuenta = gn.createRadialGradient(cx, cy2, 0, cx, cy2, 10);
        cuenta.addColorStop(0, tinta("255,248,224", 0.7 * pulso));
        cuenta.addColorStop(1, "rgba(0,0,0,0)");
        gn.fillStyle = cuenta;
        gn.beginPath(); gn.arc(cx, cy2, 10, 0, Math.PI * 2); gn.fill();
        gn.restore();
      }
    }
  }

  /* ── discos de las fases de incubación ────────────────────────────*/
  const discos = Array.from(document.querySelectorAll<HTMLCanvasElement>(".gc-fase__disco"));
  const rDisco = rng(0x0f30);
  const polvoDisco = Array.from({ length: 5 }, () =>
    Array.from({ length: 46 }, () => {
      const a = rDisco() * Math.PI * 2, rr = Math.sqrt(rDisco()) * 34;
      return { x: 38 + rr * Math.cos(a), y: 38 + rr * Math.sin(a), r: 0.4 + rDisco() * 1, o: 0.2 + rDisco() * 0.6 };
    })
  );
  const paletaDisco = ["236,214,160", "186,166,236", "170,200,246", "196,178,244", "246,228,178"];

  function pintarDisco(c: CanvasRenderingContext2D, i: number, fase: number) {
    const S = 76, cx = 38, cy = 38, R = 36;
    const col = paletaDisco[i];
    const pulso = 0.8 + 0.2 * Math.sin(fase * Math.PI * 2 + i * 0.9);
    c.clearRect(0, 0, S, S);
    c.save();
    c.beginPath(); c.arc(cx, cy, R, 0, Math.PI * 2); c.clip();
    /* el fondo del disco: nebulosa, no negro */
    const nb = c.createRadialGradient(cx, cy - 2, 2, cx, cy, R);
    nb.addColorStop(0, tinta(col, 0.85));
    nb.addColorStop(0.3, tinta(col, 0.42));
    nb.addColorStop(0.62, tinta(col, 0.2));
    nb.addColorStop(1, tinta("40,52,96", 0.32));
    c.fillStyle = nb;
    c.fillRect(0, 0, S, S);
    /* jirones de nebulosa: la referencia tiene estructura dentro del
       disco, no un degradado liso */
    for (let k = 0; k < 9; k++) {
      const a = (k / 9) * Math.PI * 2 + i;
      c.strokeStyle = tinta("196,214,255", 0.14 + (k % 3) * 0.07);
      c.lineWidth = 2.4;
      c.beginPath();
      c.arc(cx + Math.cos(a) * 12, cy + Math.sin(a) * 12, 12 + (k % 4) * 6, a, a + 2.4);
      c.stroke();
    }
    for (const p of polvoDisco[i]) {
      c.fillStyle = tinta("236,244,255", Math.min(1, p.o * 1.4));
      c.beginPath(); c.arc(p.x, p.y, p.r, 0, Math.PI * 2); c.fill();
    }
    c.save();
    c.globalCompositeOperation = "lighter";
    if (i === 0) {
      /* SEEDING: la chispa que baja al eje */
      const s = c.createRadialGradient(cx, cy - 2, 0, cx, cy - 2, 22);
      s.addColorStop(0, tinta("255,250,230", 0.95 * pulso));
      s.addColorStop(0.14, tinta(col, 0.4));
      s.addColorStop(1, "rgba(0,0,0,0)");
      c.fillStyle = s;
      c.beginPath(); c.arc(cx, cy - 2, 22, 0, Math.PI * 2); c.fill();
      c.strokeStyle = tinta("255,248,225", 0.7 * pulso);
      c.lineWidth = 1;
      c.beginPath(); c.moveTo(cx, 6); c.lineTo(cx, 68); c.stroke();
      c.fillStyle = tinta("150,226,236", 0.9);
      c.beginPath(); c.arc(cx, 56, 2.6, 0, Math.PI * 2); c.fill();
    } else if (i === 1) {
      /* ATTUNEMENT: el estallido de armónicas */
      const s = c.createRadialGradient(cx, cy - 4, 0, cx, cy - 4, 24);
      s.addColorStop(0, tinta("246,238,255", 0.9 * pulso));
      s.addColorStop(0.12, tinta(col, 0.42));
      s.addColorStop(1, "rgba(0,0,0,0)");
      c.fillStyle = s;
      c.beginPath(); c.arc(cx, cy - 4, 24, 0, Math.PI * 2); c.fill();
      c.strokeStyle = tinta(col, 0.45);
      c.lineWidth = 0.7;
      for (let k = 0; k < 5; k++) {
        const a = (k / 5) * Math.PI;
        c.beginPath(); c.ellipse(cx, cy - 4, 22, 8, a, 0, Math.PI * 2); c.stroke();
      }
    } else if (i === 2) {
      /* GESTATION: el embrión en su vórtice */
      c.strokeStyle = tinta("176,214,250", 0.5);
      c.lineWidth = 1.6;
      c.beginPath(); c.arc(cx + 2, cy, 24, Math.PI * 0.6, Math.PI * 2.1); c.stroke();
      const s = c.createRadialGradient(cx, cy + 2, 0, cx, cy + 2, 22);
      s.addColorStop(0, tinta("255,244,214", 0.6 * pulso));
      s.addColorStop(1, "rgba(0,0,0,0)");
      c.fillStyle = s;
      c.beginPath(); c.arc(cx, cy + 2, 22, 0, Math.PI * 2); c.fill();
      c.restore();
      pintarEmbrion(c, cx + 1, cy + 2, 0.42, "250,240,220");
      c.save();
      c.globalCompositeOperation = "lighter";
    } else if (i === 3) {
      /* INTEGRATION: la figura de luz sobre el eje */
      const s = c.createRadialGradient(cx, cy - 4, 0, cx, cy - 4, 26);
      s.addColorStop(0, tinta("246,240,255", 0.85 * pulso));
      s.addColorStop(0.14, tinta(col, 0.36));
      s.addColorStop(1, "rgba(0,0,0,0)");
      c.fillStyle = s;
      c.beginPath(); c.arc(cx, cy - 4, 26, 0, Math.PI * 2); c.fill();
      c.strokeStyle = tinta("250,244,255", 0.75);
      c.lineWidth = 1;
      c.beginPath();
      c.moveTo(cx, cy - 16); c.lineTo(cx, cy + 14);
      c.moveTo(cx - 9, cy - 6); c.quadraticCurveTo(cx, cy - 12, cx + 9, cy - 6);
      c.stroke();
      c.fillStyle = tinta("150,226,246", 0.9);
      c.beginPath(); c.arc(cx, cy + 22, 2.4, 0, Math.PI * 2); c.fill();
    } else {
      /* READINESS: la vesica que se abre */
      c.strokeStyle = tinta("250,234,190", 0.6);
      c.lineWidth = 1.2;
      c.beginPath(); c.ellipse(cx, cy - 2, 16, 26, 0, 0, Math.PI * 2); c.stroke();
      const s = c.createRadialGradient(cx, cy + 12, 0, cx, cy + 12, 28);
      s.addColorStop(0, tinta("255,246,214", 0.9 * pulso));
      s.addColorStop(0.16, tinta(col, 0.4));
      s.addColorStop(1, "rgba(0,0,0,0)");
      c.fillStyle = s;
      c.beginPath(); c.arc(cx, cy + 12, 28, 0, Math.PI * 2); c.fill();
      c.strokeStyle = tinta("255,246,220", 0.6);
      c.lineWidth = 0.9;
      c.beginPath(); c.moveTo(cx, cy - 20); c.lineTo(cx, cy + 16); c.stroke();
    }
    c.restore();
    c.restore();
    /* aro y cruz de construcción, fuera del recorte */
    c.strokeStyle = tinta("200,171,114", 0.4);
    c.lineWidth = 0.8;
    c.beginPath(); c.arc(cx, cy, R, 0, Math.PI * 2); c.stroke();
    c.strokeStyle = tinta("200,171,114", 0.22);
    c.lineWidth = 0.6;
    c.beginPath(); c.moveTo(0, cy); c.lineTo(S, cy); c.stroke();
    c.beginPath(); c.moveTo(cx, 0); c.lineTo(cx, S); c.stroke();
    for (let k = 0; k < 8; k++) {
      const a = (k / 8) * Math.PI * 2 + Math.PI / 8;
      c.fillStyle = tinta("200,171,114", 0.55);
      c.beginPath(); c.arc(cx + Math.cos(a) * R, cy + Math.sin(a) * R, 0.9, 0, Math.PI * 2); c.fill();
    }
  }

  /* ── el cuadro ────────────────────────────────────────────────────*/
  const pintar = (fase: number) => {
    const pulso = 0.86 + 0.14 * Math.sin(fase * Math.PI * 2);
    g.clearRect(0, 0, W, H);
    g.drawImage(fondo, 0, 0);
    pintarEje(pulso);
    pozo(g, POZO_ALTO.x, POZO_ALTO.y, 1, fase, pulso);
    pozo(g, POZO_BAJO.x, POZO_BAJO.y, 1.28, (fase + 0.4) % 1, pulso);
    pintarHuevo(pulso);
    g.save();
    g.globalCompositeOperation = "lighter";
    for (const c of chispas) {
      const p = (fase + c.v) % 1;
      g.fillStyle = tinta(c.c, c.o * (0.35 + 0.65 * Math.sin(p * Math.PI)));
      g.beginPath(); g.arc(c.x, c.y, c.r, 0, Math.PI * 2); g.fill();
    }
    g.restore();
    pintarCuna(fase);
    pintarNodos(fase);
    discos.forEach((cv, i) => {
      const ctx = cv.getContext("2d");
      if (ctx) pintarDisco(ctx, i, fase);
    });
  };

  montarLienzo({ raiz, cuadro: pintar, inicial: pintarFondo, periodo: 26000, periodoReducido: 64000 });
  montarEscala();
</script>
