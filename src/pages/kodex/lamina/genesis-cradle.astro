        <TituloBilingue titulo="GENESIS CRADLE" subtitulo="CUNA DEL GÉNESIS" />
      </div>

      {/* ══ RIEL IZQUIERDO ═══════════════════════════════════════════ */}

      {/* P1 · INCUBATION PHASE — x29..260 y234..753 */}
      <section class="arch-caja gc-panel gc-panel--1">
        <svg class="gc-panel__marco" width="231" height="519" viewBox="0 0 231 519" fill="none" aria-hidden="true">
          <path d={marcoMellado(231, 519)} stroke="currentColor" stroke-opacity="0.42" />
