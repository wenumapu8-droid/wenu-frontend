---
/**
 * KODEX-∞ · UNIVERSE PAGE 04 · ALPHABET
 *
 * Reproducción en código de `reference/canon/u04-alphabet.png` (1122×1402).
 *
 * Cuarta página de la serie UNIVERSE y la primera que dibuja el CAMPO en vez de
 * una escena: no hay portal ni figura, hay una topología. El héroe es el grafo
 * de los 25 nodos A–Y con M encendido al centro, y esa disposición es CANON —
 * las coordenadas salieron de ajustar el anillo de cada nodo sobre el original,
 * no de componerlas de nuevo. Lo que el póster tiene (que no haya E, que haya
 * dos I) se copia tal cual; el porqué está documentado en `u04/Grafo.astro`.
 *
 * El bloque comparte con `u02-threshold` la cabecera, los rieles laterales y la
 * banda de pie, que es lo que hace serie a la serie. Lo que cambia son los
 * textos, el héroe y los ocho paneles.
 *
 * El héroe va procedural, como manda el contrato: canvas 2D, semilla fija,
 * bucle por fase y `window.__kdxFreeze`. Ni un bitmap.
 */
import "../../../styles/kodex-lamina.css";
import Cabecera from "../../../components/kodex/lamina/u04/Cabecera.astro";
import Grafo from "../../../components/kodex/lamina/u04/Grafo.astro";
import Paneles from "../../../components/kodex/lamina/u04/Paneles.astro";
import Pie from "../../../components/kodex/lamina/u04/Pie.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · ALPHABET · PAGE 04</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="u04-alphabet">
      <Cabecera />
      <Grafo />
      <Paneles />
      <Pie />
    </div>

    <style is:global>
      /* La lámina se dibuja a tamaño de referencia y se escala desde 0,0.
         `place-items:center` sobre una caja mayor que el contenedor desborda de
         un lado — costó una vuelta descubrirlo en la u02. */
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px;
        height: 1402px;
        /* Negro puro, medido: la referencia da rgb(0,0,0) en las muestras de
           fondo y su píxel más oscuro también es 0. Cualquier #05xxxx le pone
           piso al puntaje de los cuatro bloques a la vez. */
        background: #000;
        color: #cfc6e8;
        overflow: hidden;
        transform-origin: 0 0;
        font-family: "JetBrains Mono", ui-monospace, monospace;
      }
      .lam [data-bloque] { position: absolute; }
    </style>

    <script>
      /* `100vw / 1122` en CSS da una LONGITUD y `scale()` quiere un NÚMERO:
         puesto en CSS no hace nada y falla en silencio. Por eso vive acá. */
      const lam = document.querySelector(".lam");
      const ajustar = () => {
        const k = Math.min(innerWidth / 1122, innerHeight / 1402);
        lam.style.transform = `scale(${k})`;
        document.body.style.height = `${1402 * k}px`;
      };
      ajustar();
      addEventListener("resize", ajustar, { passive: true });
    
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";
      montarMovil();
    </script>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>

    <!-- Tarjeta de cruce (costura 3): "cruzar al siguiente estrato" con
         progreso, del diseño del creador. Oculta al congelar (banco intacto). -->
    <a class="lam-siguiente" href="/kodex/lamina/u05-genesis/">NEXT PLATE · U05 GENESIS → <i>19/25</i></a>
    <style>
      .lam-siguiente{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:9;
        font:11px ui-monospace,monospace;letter-spacing:.18em;color:rgba(240,237,232,.66);
        text-decoration:none;padding:11px 16px;background:rgba(0,0,0,.5);
        border:1px solid rgba(240,237,232,.16);white-space:nowrap;max-width:92vw;overflow:hidden;text-overflow:ellipsis;}
      .lam-siguiente i{font-style:normal;color:rgba(240,237,232,.38);margin-left:10px}
      .lam-siguiente:hover{color:#fff;border-color:rgba(240,237,232,.45)}
      html[data-kdx-frozen] .lam-siguiente{display:none}
    </style>
  </body>
</html>
