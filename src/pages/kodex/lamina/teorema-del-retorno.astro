---
/**
 * KODEX-∞ · GEOMETRÍA KODEX −∞ · TEOREMA DEL RETORNO TRANSFORMATIVO
 *
 * Reproducción en código de `reference/pendientes/pend-18.png` (1055×1491),
 * sexta lámina del lote de Drive. La plancha se nombra sola y está EN ESPAÑOL
 * — las láminas conservan su idioma propio; el sitio es inglés por decisión
 * del creador, pero una plancha es una obra y se transcribe como es.
 *
 * QUÉ ES: la infografía del teorema. Fórmula K(n+1) = R∘M∘T∘E (K(n)), la doble
 * espiral áurea en forma de 8 entre −∞ y +∞ con el portal en el origen, y el
 * panel inferior CICLO + MEMORIA = HÉLICE con las cuatro leyes numeradas.
 *
 * SOBRE LA FÓRMULA, porque el canon lo exige: "nunca matemáticas como
 * ornamentación pseudo-técnica". Acá la fórmula ES el contenido de la plancha
 * — es el teorema simbólico propio del sistema (capa simbólica/filosófica del
 * canon, no un enunciado científico), y se transcribe textual de la referencia.
 *
 * TODO el texto transcrito con zoom: título, subtítulo, fórmulas, los rótulos
 * de los tres niveles (+∞ MANIFESTACIÓN / 0 PORTAL / −∞ DESCENSO con sus
 * subtítulos), la secuencia −∞ → 0 → +∞ → −∞, la sentencia "La forma cambia.
 * El núcleo permanece." y las cuatro leyes (I..IV).
 */
import "../../../styles/kodex-lamina.css";

const leyes = [
  { n: "I.", t: ["Sin profundidad", "no hay manifestación"] },
  { n: "II.", t: ["El centro", "transforma"] },
  { n: "III.", t: ["El retorno conserva", "memoria"] },
  { n: "IV.", t: ["Repetición sin memoria", "es estancamiento"] },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · Teorema del Retorno Transformativo</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="teorema-del-retorno" style="width:1055px;height:1491px;">
      <canvas id="tr-campo" width="1055" height="1491" style="position:absolute;inset:0;"></canvas>

      <svg viewBox="0 0 1055 1491" style="position:absolute;inset:0;" aria-hidden="true">
        <!-- ── marco ornamental ──────────────────────────────────────── -->
        <rect x="18" y="18" width="1019" height="1455" class="t-marco" />
        <path class="t-esq" d="M18 60 v-42 h42 M995 18 h42 v42 M18 1431 v42 h42 M1037 1431 v42 h-42" />
        <path class="t-orn" d="M510 30 h35 m-17 -8 v16" />

        <!-- ── cabecera (transcrita) ─────────────────────────────────── -->
        <text x="527" y="102" class="t-titulo" text-anchor="middle">GEOMETRÍA KODEX −∞</text>
        <text x="527" y="140" class="t-sub" text-anchor="middle">Teorema del Retorno Transformativo</text>
        <text x="527" y="204" class="t-formula" text-anchor="middle">
          <tspan font-style="italic">K</tspan><tspan baseline-shift="sub" font-size="20">n+1</tspan>
          <tspan> = </tspan>
          <tspan font-style="italic">ℛ</tspan><tspan> ∘ </tspan>
          <tspan font-style="italic">ℳ</tspan><tspan> ∘ </tspan>
          <tspan font-style="italic">𝒯</tspan><tspan> ∘ </tspan>
          <tspan font-style="italic">ℰ</tspan>
          <tspan> (</tspan><tspan font-style="italic">K</tspan><tspan baseline-shift="sub" font-size="20">n</tspan><tspan>)</tspan>
        </text>
        <text x="527" y="256" class="t-secuencia" text-anchor="middle">DESCENDER · TRANSFORMAR · MANIFESTAR · RECORDAR</text>

        <!-- ── rótulos de los tres niveles (transcritos) ─────────────── -->
        <text x="700" y="392" class="t-nivel">+∞ · Manifestación</text>
        <text x="700" y="416" class="t-nivelsub">forma · materia · código · experiencia</text>
        <path class="t-linea" d="M668 386 h-60" />

        <text x="700" y="596" class="t-nivel">0 · Portal / Centro</text>
        <text x="700" y="620" class="t-nivelsub" font-style="italic">O = (0,0)</text>
        <path class="t-linea" d="M668 590 h-110" />

        <text x="700" y="788" class="t-nivel">−∞ · Descenso</text>
        <text x="700" y="812" class="t-nivelsub">memoria · sombra · origen · excavación</text>
        <path class="t-linea" d="M668 782 h-70" />

        <!-- ejes de la figura -->
        <path class="t-eje" d="M180 600 H 830" />
        <path class="t-eje" d="M480 320 V 890" />

        <!-- RETORNO: la flecha curva de la izquierda -->
        <path class="t-retorno" d="M240 560 Q 200 430 292 356" marker-end="url(#tr-flecha)" />
        <defs>
          <marker id="tr-flecha" markerWidth="10" markerHeight="10" refX="6" refY="3" orient="auto">
            <path d="M0 0 L7 3 L0 6" fill="none" stroke="#c9a24b" stroke-width="1.4" />
          </marker>
        </defs>
        <text x="212" y="500" class="t-retlabel" transform="rotate(-72 212 500)">RETORNO</text>

        <!-- la secuencia del pie de figura (transcrita) -->
        <text x="527" y="905" class="t-secgrande" text-anchor="middle">−∞  →  0  →  +∞  →  −∞</text>

        <!-- ── panel inferior ────────────────────────────────────────── -->
        <path class="t-divisor" d="M40 934 H 1015" />
        <text x="640" y="1000" class="t-panel" text-anchor="middle">CICLO + MEMORIA = HÉLICE</text>
        <text x="640" y="1064" class="t-formula2" text-anchor="middle">
          <tspan font-style="italic">K</tspan><tspan baseline-shift="sub" font-size="17">n+1</tspan>
          <tspan>  ≠  </tspan>
          <tspan font-style="italic">K</tspan><tspan baseline-shift="sub" font-size="17">n</tspan>
        </text>
        <text x="640" y="1122" class="t-formula2" text-anchor="middle">
          <tspan font-style="italic">I</tspan><tspan baseline-shift="sub" font-size="17">n+1</tspan>
          <tspan>  =  </tspan>
          <tspan font-style="italic">I</tspan><tspan baseline-shift="sub" font-size="17">n</tspan>
        </text>
        <text x="640" y="1200" class="t-sentencia" text-anchor="middle">La forma cambia. El núcleo permanece.</text>

        <!-- glifos del riel izquierdo -->
        {[988, 1046, 1104, 1162].map((y, i) => (
          <g class="t-glifo" transform={`translate(104,${y})`}>
            <circle r="14" />
            {i === 0 && <path d="M-6 0 h12 M0 -6 v12" />}
            {i === 1 && <path d="M0 -7 L6 0 L0 7 L-6 0 Z" />}
            {i === 2 && <path d="M-5 3 q5 -12 10 0" />}
            {i === 3 && <circle r="6" />}
          </g>
        ))}

        <!-- ── las cuatro leyes (transcritas) ────────────────────────── -->
        {leyes.map((l, i) => (
          <g transform={`translate(${160 + i * 262},1330)`}>
            <rect x="-108" y="-62" width="216" height="128" class="t-carta" />
            <circle cx="0" cy="-38" r="15" class="t-glifo" />
            <path class="t-glifo" d={i === 0 ? "M-5 -41 L0 -32 L5 -41" : i === 1 ? "M0 -44 v12 M-5 -38 h10" : i === 2 ? "M-6 -38 q6 -10 12 0" : "M-5 -38 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0"} />
            <text x="0" y="-2" class="t-leynum" text-anchor="middle">{l.n}</text>
            <text x="0" y="24" class="t-leytexto" text-anchor="middle">{l.t[0]}</text>
            <text x="0" y="44" class="t-leytexto" text-anchor="middle">{l.t[1]}</text>
          </g>
        ))}
      </svg>
    </div>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam { position: relative; background: #17140f; transform-origin: 0 0; }
      .t-marco   { stroke: #4a3d28; fill: none; stroke-width: 1.2; }
      .t-esq     { stroke: #8a6f3c; fill: none; stroke-width: 1.6; }
      .t-orn     { stroke: #8a6f3c; fill: none; stroke-width: 1.2; }
      .t-titulo  { fill: #e9dcbf; font-family: Georgia, serif; font-size: 52px; letter-spacing: .12em; }
      .t-sub     { fill: #c9b587; font-family: Georgia, serif; font-size: 24px; letter-spacing: .06em; }
      .t-formula { fill: #e9dcbf; font-family: Georgia, serif; font-size: 40px; }
      .t-formula2{ fill: #e2d3ab; font-family: Georgia, serif; font-size: 34px; }
      .t-secuencia{ fill: #a8905c; font-family: var(--lam-mono); font-size: 15px; letter-spacing: .3em; }
      .t-nivel   { fill: #e2d3ab; font-family: Georgia, serif; font-size: 26px; letter-spacing: .08em; }
      .t-nivelsub{ fill: #96805a; font-family: Georgia, serif; font-size: 16px; letter-spacing: .05em; }
      .t-linea   { stroke: #6a5836; stroke-width: 1; }
      .t-eje     { stroke: #4a3d28; stroke-width: 1; opacity: .8; }
      .t-retorno { stroke: #c9a24b; stroke-width: 1.4; fill: none; }
      .t-retlabel{ fill: #c9a24b; font-family: var(--lam-mono); font-size: 15px; letter-spacing: .34em; }
      .t-secgrande{ fill: #cdb887; font-family: Georgia, serif; font-size: 27px; letter-spacing: .12em; }
      .t-divisor { stroke: #4a3d28; stroke-width: 1.2; }
      .t-panel   { fill: #e9dcbf; font-family: Georgia, serif; font-size: 34px; letter-spacing: .16em; }
      .t-sentencia{ fill: #c9b587; font-family: Georgia, serif; font-size: 22px; font-style: italic; letter-spacing: .04em; }
      .t-carta   { stroke: #5c4b2e; fill: rgba(20,16,10,.6); stroke-width: 1.1; }
      .t-glifo   { stroke: #a8905c; fill: none; stroke-width: 1.2; }
      .t-leynum  { fill: #e2d3ab; font-family: Georgia, serif; font-size: 25px; }
      .t-leytexto{ fill: #a8977a; font-family: Georgia, serif; font-size: 15.5px; }
    </style>

    <script>
      import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
      import { rng } from "../../../components/kodex/lamina/kit/rng";

      const canvas = document.getElementById("tr-campo") as HTMLCanvasElement;
      const raiz = document.querySelector("[data-lam]") as HTMLElement;
      const g = canvas.getContext("2d")!;
      const rnd = rng(0x8e70);

      /* La doble espiral: dos espirales logarítmicas espejadas formando el 8
         vertical. Centro del 8 (el portal) en (480,600); la superior converge
         a (480,455) y la inferior a (480,745). */
      const PX = 480, PY = 600;
      /* La superior se dibuja; la inferior es EXACTAMENTE la superior rotada
         180 grados por el portal — así es como el 8 de la referencia es
         simétrico, no dos espirales que abren para el mismo lado. */
      const sup: Array<[number, number]> = [];
      for (let t = 0; t <= 4.2 * Math.PI; t += 0.045) {
        const r = 205 * Math.exp(-0.185 * t);
        const a = t + Math.PI / 2;
        sup.push([PX + r * Math.cos(a) * 1.15, 455 - r * Math.sin(a)]);
      }
      const inf: Array<[number, number]> = sup.map(([x, y]) => [2 * PX - x, 2 * PY - y]);
      const espirales = [sup, inf];

      /* polvo dorado a lo largo de las espirales, fijo */
      const polvo: Array<{ x: number; y: number; r: number; o: number }> = [];
      for (const esp of espirales)
        for (const [x, y] of esp)
          if (rnd() < 0.9)
            polvo.push({
              x: x + (rnd() - 0.5) * 40, y: y + (rnd() - 0.5) * 40,
              r: 0.5 + rnd() * 1.8, o: 0.18 + rnd() * 0.6,
            });

      /* textura de la carta: motas calidas por toda la plancha, fijas */
      const textura = Array.from({ length: 2600 }, () => ({
        x: rnd() * 1055, y: rnd() * 1491, r: 0.4 + rnd() * 1.1, o: 0.05 + rnd() * 0.16,
      }));

      /* la hélice del panel inferior: resorte descendente */
      const HX = 235, HY0 = 975, VUELTAS = 6;

      const pintar = (fase: number) => {
        g.clearRect(0, 0, 1055, 1491);
        const brillo = 0.86 + 0.14 * Math.cos(fase * Math.PI * 2);

        /* textura de carta: motas oscuras del fondo */
        /* (fijas por semilla — se generan una vez arriba con el polvo) */

        for (const t of textura) {
          g.fillStyle = tinta("200,170,110", t.o);
          g.beginPath(); g.arc(t.x, t.y, t.r, 0, Math.PI * 2); g.fill();
        }
        /* círculos tenues de la figura */
        g.strokeStyle = tinta("201,162,75", 0.12);
        g.lineWidth = 0.8;
        for (const [cy, r] of [[455, 130], [745, 130], [600, 210]] as const) {
          g.beginPath(); g.arc(PX, cy, r, 0, Math.PI * 2); g.stroke();
        }

        /* las espirales, con resplandor */
        for (const esp of espirales) {
          g.save();
          g.shadowColor = "rgba(222,178,94,0.8)";
          g.shadowBlur = 10 * brillo;
          for (const [lw, op, dxy] of [[3.2, 0.85, 0], [1.2, 0.5, 5], [1.2, 0.5, -5]] as const) {
            g.strokeStyle = tinta("222,178,94", op * brillo);
            g.lineWidth = lw;
            g.beginPath();
            esp.forEach(([x, y], i) => (i ? g.lineTo(x + dxy, y + dxy) : g.moveTo(x + dxy, y + dxy)));
            g.stroke();
          }
          g.restore();
        }
        /* el portal: nudo luminoso en el origen */
        const halo = g.createRadialGradient(PX, PY, 0, PX, PY, 44);
        halo.addColorStop(0, tinta("240,214,150", 0.9 * brillo));
        halo.addColorStop(1, "rgba(0,0,0,0)");
        g.fillStyle = halo;
        g.fillRect(PX - 46, PY - 46, 92, 92);

        /* el polvo */
        for (const p of polvo) {
          g.fillStyle = tinta("222,185,106", p.o * brillo);
          g.beginPath(); g.arc(p.x, p.y, p.r, 0, Math.PI * 2); g.fill();
        }

        /* la hélice: seis vueltas descendentes con eje */
        g.strokeStyle = tinta("222,178,94", 0.75 * brillo);
        g.lineWidth = 1.6;
        for (let k = 0; k < VUELTAS; k++) {
          const y = HY0 + 22 + k * 40;
          g.beginPath();
          g.ellipse(HX, y, 62 - k * 2.5, 15, 0, 0, Math.PI, false);
          g.stroke();
          g.strokeStyle = tinta("222,178,94", (0.45 - k * 0.03) * brillo);
          g.beginPath();
          g.ellipse(HX, y, 62 - k * 2.5, 15, 0, Math.PI, Math.PI * 2, false);
          g.stroke();
          g.strokeStyle = tinta("222,178,94", 0.75 * brillo);
        }
        g.strokeStyle = tinta("201,162,75", 0.4);
        g.lineWidth = 1;
        g.beginPath(); g.moveTo(HX, HY0); g.lineTo(HX, HY0 + 30 + VUELTAS * 40); g.stroke();
      };

      montarLienzo({ raiz, cuadro: pintar, periodo: 30000, periodoReducido: 70000 });
    </script>
  </body>
</html>
