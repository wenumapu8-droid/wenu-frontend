---
/**
 * KODEX-∞ · UNIVERSE PAGE 05 · GENESIS
 *
 * Reproducción en código de `reference/canon/u05-genesis.png` (1122×1402).
 *
 * La lámina del LINAJE: seis etapas —ARTIFACT SOURCE a ORGANISM— con su
 * espécimen y su anotación, la banda THE TRANSFORMATION debajo y los paneles
 * de nota, métricas, axiomas y adelanto. Tres canvas: el trazo de tiza del
 * espécimen 01 (estático), el organismo del 06 y el torrente de la banda
 * (ambos vivos, con bucle por fase y sumidero de __kdxFreeze).
 *
 * FONDO NEGRO PURO, medido: diez muestras dan rgb(0,0,0)..rgb(1,1,1). No es
 * el blanco hueso de u03 ni el casi-negro #050308 que costó caro en u02.
 */
import "../../../styles/kodex-lamina.css";
import Cabecera from "../../../components/kodex/lamina/u05/Cabecera.astro";
import Etapas from "../../../components/kodex/lamina/u05/Etapas.astro";
import Organismo from "../../../components/kodex/lamina/u05/Organismo.astro";
import Transformacion from "../../../components/kodex/lamina/u05/Transformacion.astro";
import Paneles from "../../../components/kodex/lamina/u05/Paneles.astro";
import Pie from "../../../components/kodex/lamina/u05/Pie.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · GENESIS · PAGE 05</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="u05-genesis">
      <Cabecera />
      <Etapas />
      <Organismo />
      <Transformacion />
      <Paneles />
      <Pie />
    </div>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px;
        height: 1402px;
        background: #000;
        color: #d8d4d0;
        overflow: hidden;
        transform-origin: 0 0;
        font-family: "JetBrains Mono", ui-monospace, monospace;
      }
      .lam [data-bloque] { position: absolute; }
    </style>

    <script>
      /* `100vw / 1122` en CSS da una LONGITUD y `scale()` quiere un NÚMERO. */
      const lam = document.querySelector(".lam");
      const ajustar = () => {
        const k = Math.min(innerWidth / 1122, innerHeight / 1402);
        lam.style.transform = `scale(${k})`;
        document.body.style.height = `${1402 * k}px`;
      };
      ajustar();
      addEventListener("resize", ajustar, { passive: true });
    
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";
      montarMovil();
    </script>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>

    <!-- Tarjeta de cruce (costura 3): "cruzar al siguiente estrato" con
         progreso, del diseño del creador. Oculta al congelar (banco intacto). -->
    <a class="lam-siguiente" href="/kodex/lamina/u06-memory/">NEXT PLATE · U06 MEMORY → <i>20/25</i></a>
    <style>
      .lam-siguiente{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:9;
        font:11px ui-monospace,monospace;letter-spacing:.18em;color:rgba(240,237,232,.66);
        text-decoration:none;padding:11px 16px;background:rgba(0,0,0,.5);
        border:1px solid rgba(240,237,232,.16);white-space:nowrap;max-width:92vw;overflow:hidden;text-overflow:ellipsis;}
      .lam-siguiente i{font-style:normal;color:rgba(240,237,232,.38);margin-left:10px}
      .lam-siguiente:hover{color:#fff;border-color:rgba(240,237,232,.45)}
      html[data-kdx-frozen] .lam-siguiente{display:none}
    </style>
  </body>
</html>
