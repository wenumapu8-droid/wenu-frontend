---
/**
 * KODEX-∞ · UNIVERSE PAGE 05 · GENESIS
 *
 * Reproducción en código de `reference/canon/u05-genesis.png` (1122×1402).
 *
 * La lámina del LINAJE: seis etapas —ARTIFACT SOURCE a ORGANISM— con su
 * espécimen y su anotación, la banda THE TRANSFORMATION debajo y los paneles
 * de nota, métricas, axiomas y adelanto. Tres canvas: el trazo de tiza del
 * espécimen 01 (estático), el organismo del 06 y el torrente de la banda
 * (ambos vivos, con bucle por fase y sumidero de __kdxFreeze).
 *
 * FONDO NEGRO PURO, medido: diez muestras dan rgb(0,0,0)..rgb(1,1,1). No es
 * el blanco hueso de u03 ni el casi-negro #050308 que costó caro en u02.
 */
import "../../../styles/kodex-lamina.css";
import Cabecera from "../../../components/kodex/lamina/u05/Cabecera.astro";
import Etapas from "../../../components/kodex/lamina/u05/Etapas.astro";
import Organismo from "../../../components/kodex/lamina/u05/Organismo.astro";
import Transformacion from "../../../components/kodex/lamina/u05/Transformacion.astro";
import Paneles from "../../../components/kodex/lamina/u05/Paneles.astro";
import Pie from "../../../components/kodex/lamina/u05/Pie.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · GENESIS · PAGE 05</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="u05-genesis">
      <Cabecera />
      <Etapas />
      <Organismo />
      <Transformacion />
      <Paneles />
      <Pie />
    </div>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px;
        height: 1402px;
        background: #000;
        color: #d8d4d0;
        overflow: hidden;
        transform-origin: 0 0;
        font-family: "JetBrains Mono", ui-monospace, monospace;
      }
      .lam [data-bloque] { position: absolute; }
    </style>

    <script>
      /* `100vw / 1122` en CSS da una LONGITUD y `scale()` quiere un NÚMERO. */
      const lam = document.querySelector(".lam");
      const ajustar = () => {
        const k = Math.min(innerWidth / 1122, innerHeight / 1402);
        lam.style.transform = `scale(${k})`;
        document.body.style.height = `${1402 * k}px`;
      };
      ajustar();
      addEventListener("resize", ajustar, { passive: true });
    </script>
  </body>
</html>
