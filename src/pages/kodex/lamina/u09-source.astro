---
/**
 * KODEX-∞ · UNIVERSE PAGE 09 · SOURCE
 *
 * Reproducción en código de `reference/canon/u09-source.png` (1122×1402).
 *
 * Es el TRUTH LEDGER del proyecto: la única lámina de la serie cuyo héroe no es
 * un organismo sino una TABLA. Las cinco clases de verdad —VERIFIED, CANONICAL,
 * INFERRED, SPECULATIVE, NEEDS CONFIRMATION— y el flujo
 * ORIGIN → INGEST → TRANSLATION → VALIDATION → ARCHIVE son política del
 * proyecto, no decoración: se copian palabra por palabra de la referencia.
 *
 * REPARTO DE BLOQUES. Comparte serie con `u02-threshold`, así que comparte
 * cabecera, rieles y pie; cambian los textos, el héroe y los paneles.
 *
 *   Diagramas  canvas 2D con TODA la luz procedural (estallidos, discos,
 *              espirales, corazón). Va primero porque es el fondo luminoso
 *              sobre el que se apoya el resto.
 *   Cabecera   marco, rieles, regla superior, título y bajada — SVG.
 *   Paneles    columna izquierda: TRUTH PROTOCOL · LEGEND · PROVENANCE SEAL.
 *   Tabla      el héroe: retícula de 6 columnas × 5 clases con sus sellos.
 *   Flujo      banda ORIGIN → … → ARCHIVE + traza de procedencia + época.
 *   Pie        juramento de la cámara, firma y remate.
 *
 * UNA SOLA REJILLA. Todos los bloques van con `inset:0` sobre el lienzo entero
 * y sus SVG comparten `viewBox="0 0 1122 1402"`. Las coordenadas que se leen en
 * el código son las del póster sin corrimiento: se pueden buscar tal cual en el
 * PNG de referencia con la sonda.
 *
 * DÓNDE ESTÁ EL PÓSTER DENTRO DEL LIENZO. Medido, y no es obvio: el marco
 * exterior cae en x 10,5..1017,5 e y 10,5..1381,5. O sea que a la derecha
 * quedan ~100 px de negro puro que NO son error de encuadre — están en la
 * referencia. Centrar el dibujo en 561 lo corre entero.
 */
import "../../../styles/kodex-lamina.css";
import Diagramas from "../../../components/kodex/lamina/u09/Diagramas.astro";
import Cabecera from "../../../components/kodex/lamina/u09/Cabecera.astro";
import Paneles from "../../../components/kodex/lamina/u09/Paneles.astro";
import Tabla from "../../../components/kodex/lamina/u09/Tabla.astro";
import Flujo from "../../../components/kodex/lamina/u09/Flujo.astro";
import Pie from "../../../components/kodex/lamina/u09/Pie.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · SOURCE · PAGE 09</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="u09-source">
      <Diagramas />
      <Cabecera />
      <Paneles />
      <Tabla />
      <Flujo />
      <Pie />
    </div>

    <style is:global>
      /* La lámina se dibuja a tamaño de referencia y se escala desde 0,0.
         `place-items:center` sobre una caja mayor que el contenedor desborda de
         un lado — le costó una vuelta a la lámina 02 descubrirlo. */
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px;
        height: 1402px;
        /* Negro puro, medido: las seis muestras de fondo de la referencia dan
           rgb(0,0,0) y su píxel más oscuro también es 0. Cualquier violeta de
           base —el tentador #050308— suma ~4 puntos de luminancia en TODO el
           lienzo y le pone piso al puntaje de los seis bloques a la vez. */
        background: #000;
        color: #cfcfd2;
        overflow: hidden;
        transform-origin: 0 0;
        font-family: "JetBrains Mono", ui-monospace, monospace;
      }
      /* NO PONER UN blur() ACÁ, y conviene saber por qué antes de "mejorar" el
         puntaje. La referencia es un ráster blando: cada trazo tiene 1-2 px de
         caída. Un `filter: blur(1px)` sobre .lam baja el global de 4,21 % a
         3,33 % de una — casi un punto, más de lo que dio cualquier corrección
         real de esta lámina. Y es trampa: comparado a ×5 contra el recorte, el
         texto de la referencia sigue teniendo astas separadas y el borroso las
         pierde. El banco premia el emborronado por la misma razón por la que
         premia el negro (ver el comentario largo de scripts/lamina/compare.mjs):
         la tinta blanda difiere menos contra tinta blanda. Se probó, se midió y
         se descartó. El puntaje honesto de esta lámina es el crujiente. */
      .lam [data-bloque] { position: absolute; }
    </style>

    <script>
      /* `100vw / 1122` en CSS da una LONGITUD y `scale()` quiere un NÚMERO:
         puesto en CSS no hace nada y falla en silencio. Por eso vive acá. */
      const lam = document.querySelector(".lam");
      const ajustar = () => {
        const k = Math.min(innerWidth / 1122, innerHeight / 1402);
        lam.style.transform = `scale(${k})`;
        document.body.style.height = `${1402 * k}px`;
      };
      ajustar();
      addEventListener("resize", ajustar, { passive: true });
    
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";
      montarMovil();
    
      import { montarVida } from "../../../lib/kodex/vida/montar";
      montarVida({ id: "u09-source" });
    
      import { montarNavegacion } from "../../../components/kodex/lamina/kit/navegacion";
      montarNavegacion();
    
      import { montarTriptico } from "../../../components/kodex/lamina/kit/triptico";
      montarTriptico();
    
      import { montarSonido } from "../../../lib/kodex/sonido-montar";
      montarSonido();
    
      import { montarFases } from "../../../lib/kodex/estado";
      montarFases();
    </script>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>

    <!-- Tarjeta de cruce (costura 3): "cruzar al siguiente estrato" con
         progreso, del diseño del creador. Oculta al congelar (banco intacto). -->
    <a class="lam-siguiente" href="/kodex/lamina/u10-commons/">NEXT PLATE · U10 COMMONS → <i>24/25</i></a>
    <style>
      .lam-siguiente{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:9;
        font:11px ui-monospace,monospace;letter-spacing:.18em;color:rgba(240,237,232,.66);
        text-decoration:none;padding:11px 16px;background:rgba(0,0,0,.5);
        border:1px solid rgba(240,237,232,.16);white-space:nowrap;max-width:92vw;overflow:hidden;text-overflow:ellipsis;}
      .lam-siguiente i{font-style:normal;color:rgba(240,237,232,.38);margin-left:10px}
      .lam-siguiente:hover{color:#fff;border-color:rgba(240,237,232,.45)}
      html[data-kdx-frozen] .lam-siguiente{display:none}
    </style>
  </body>
</html>
