---
/**
 * Banco del KIT. No es una lámina: es la hoja de contacto de las primitivas.
 * Sirve para ver de un vistazo qué hay antes de dibujar algo nuevo a mano — que
 * es cómo la lámina 1 terminó con trece juegos distintos de medidores.
 */
import "../../../styles/kodex-lamina.css";
import Waveform from "../../../components/kodex/lamina/kit/Waveform.astro";
import RadialScanner from "../../../components/kodex/lamina/kit/RadialScanner.astro";
import BarMeter from "../../../components/kodex/lamina/kit/BarMeter.astro";
import RingGauge from "../../../components/kodex/lamina/kit/RingGauge.astro";
import StepGraph from "../../../components/kodex/lamina/kit/StepGraph.astro";
import Micrografia from "../../../components/kodex/lamina/kit/Micrografia.astro";

const A = "#ff5a1f";
const F = "#5aa9c0";
---
<html lang="es"><head><meta charset="utf-8" /><title>KODEX−∞ · kit de lámina</title>
<meta name="robots" content="noindex, nofollow" /></head>
<body class="kdx-lam">
  <h1>KIT DE LÁMINA</h1>
  <div class="g">
    <figure><figcaption>Waveform · peine</figcaption><Waveform w={200} h={40} semilla={2} color={A} /></figure>
    <figure><figcaption>Waveform · línea</figcaption><Waveform w={200} h={40} variante="linea" semilla={9} color={A} /></figure>
    <figure><figcaption>Waveform · barras</figcaption><Waveform w={200} h={40} variante="barras" semilla={4} color={A} /></figure>
    <figure><figcaption>RadialScanner</figcaption><RadialScanner w={120} h={120} semilla={7} anillos={14} radios={36} frio={F} ticks={24} color={A} /></figure>
    <figure><figcaption>RadialScanner · túnel</figcaption><RadialScanner w={200} h={110} semilla={3} anillos={18} radios={40} excentricidad={0.55} nucleo={7} color={A} frio={F} /></figure>
    <figure><figcaption>BarMeter 73%</figcaption><BarMeter w={200} h={14} valor={73} color={A} /></figure>
    <figure><figcaption>BarMeter 92% · marco</figcaption><BarMeter w={200} h={12} valor={92} marco={true} semilla={8} color={A} /></figure>
    <figure><figcaption>RingGauge · composición</figcaption><RingGauge d={64} segmentos={[{valor:38,color:A},{valor:27,color:"#c9481a"},{valor:16,color:"#8a3312"},{valor:11,color:F}]} resto={A} /></figure>
    <figure><figcaption>StepGraph</figcaption><StepGraph w={179} h={92} semilla={5} color={A} relleno="rgba(255,90,31,.2)" etiquetasX={["00","20","40","60","80","100"]} etiquetasY={["10K","4K","800"]} /></figure>
    <figure><figcaption>Micrografía</figcaption><Micrografia w={200} h={60} semilla={11} color={A} /></figure>
  </div>
  <style is:global>
    body { margin:0; padding:24px; background:#000; color:#d8d4cc; font:11px ui-monospace,monospace; }
    h1 { font-size:14px; letter-spacing:.24em; color:#ff5a1f; margin:0 0 20px; }
    .g { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:22px; }
    figure { margin:0; padding:10px; border:1px solid #2a1a12; }
    figcaption { color:#7d7770; font-size:9px; letter-spacing:.14em; text-transform:uppercase; margin-bottom:8px; }
  </style>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>
</body></html>
