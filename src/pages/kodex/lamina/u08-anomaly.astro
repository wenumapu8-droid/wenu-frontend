---
/**
 * KODEX-∞ · UNIVERSE PAGE 08 · ANOMALY
 *
 * Reproducción en código de `reference/canon/u08-anomaly.png` (1122×1402).
 *
 * La lámina de la MUTACIÓN: una estructura vertical de red filamentosa que se
 * rompe y se reordena en una entidad geométrica — interferencia (telaraña de
 * rayos blancos), ruptura (malla desgarrada con corazón naranja) y
 * reordenamiento (mandala de anillos con núcleo blanco), rematada por el
 * círculo del ∞ y el rótulo STABILIZED ENTITY // NEW CODE ACTIVE //.
 *
 * FONDO NEGRO PURO, medido: diez muestras dan rgb(0,0,0)..rgb(2,1,1).
 * Un solo héroe en canvas (dos capas), vivo, con bucle por fase y sumidero
 * de __kdxFreeze.
 */
import "../../../styles/kodex-lamina.css";
import Cabecera from "../../../components/kodex/lamina/u08/Cabecera.astro";
import Entidad from "../../../components/kodex/lamina/u08/Entidad.astro";
import Paneles from "../../../components/kodex/lamina/u08/Paneles.astro";
import Pie from "../../../components/kodex/lamina/u08/Pie.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · ANOMALY · PAGE 08</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="u08-anomaly">
      <Cabecera />
      <Entidad />
      <Paneles />
      <Pie />
    </div>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px;
        height: 1402px;
        background: #000;
        color: #d8d4d0;
        overflow: hidden;
        transform-origin: 0 0;
        font-family: "JetBrains Mono", ui-monospace, monospace;
      }
      .lam [data-bloque] { position: absolute; }
    </style>

    <script>
      /* `100vw / 1122` en CSS da una LONGITUD y `scale()` quiere un NÚMERO. */
      const lam = document.querySelector(".lam");
      const ajustar = () => {
        const k = Math.min(innerWidth / 1122, innerHeight / 1402);
        lam.style.transform = `scale(${k})`;
        document.body.style.height = `${1402 * k}px`;
      };
      ajustar();
      addEventListener("resize", ajustar, { passive: true });
    </script>
  </body>
</html>
