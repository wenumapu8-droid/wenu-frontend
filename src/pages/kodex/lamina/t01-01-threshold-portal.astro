---
/**
 * KODEX-∞ · LÁMINA t01-01 · THRESHOLD PORTAL
 *
 * Tercera lámina. Cajas MEDIDAS por bandas (umbral de tinta 7): tres columnas
 * — 9-471, 481-1219, 1228-1657 — y una banda inferior con su propio corte en
 * 769 y 1152, distinto del de arriba. Igual que en DESCENT TUNNEL, la retícula
 * NO es la misma a toda la altura.
 *
 * Medir:  node scripts/lamina/iterate.mjs t01-01-threshold-portal
 */
import "../../../styles/kodex-lamina.css";
import Header from "../../../components/kodex/lamina/t01-01/Header.astro";
import SceneIntent from "../../../components/kodex/lamina/t01-01/SceneIntent.astro";
import StateMachine from "../../../components/kodex/lamina/t01-01/StateMachine.astro";
import MotionVerbs from "../../../components/kodex/lamina/t01-01/MotionVerbs.astro";
import SignalTelemetry from "../../../components/kodex/lamina/t01-01/SignalTelemetry.astro";
import RitualGlyphs from "../../../components/kodex/lamina/t01-01/RitualGlyphs.astro";
import PortalCore from "../../../components/kodex/lamina/t01-01/PortalCore.astro";
import UIElements from "../../../components/kodex/lamina/t01-01/UIElements.astro";
import ShaderNotes from "../../../components/kodex/lamina/t01-01/ShaderNotes.astro";
import MobilePreview from "../../../components/kodex/lamina/t01-01/MobilePreview.astro";
import DataTags from "../../../components/kodex/lamina/t01-01/DataTags.astro";
import ColorPalette from "../../../components/kodex/lamina/t01-01/ColorPalette.astro";
import IconClusters from "../../../components/kodex/lamina/t01-01/IconClusters.astro";
import Footer from "../../../components/kodex/lamina/t01-01/Footer.astro";
import EscenaLamina from "../../../components/kodex/escena/EscenaLamina.astro";

const W = 1672;
const H = 941;

/* PARADAS DE LA CAMARA MOVIL · 2026-08-31
 * Las coordenadas NO se estiman: son las mismas cajas medidas que ya usa
 * el layout de escritorio, abajo en este archivo. El organismo va primero
 * porque debe dominar el primer frame; lo denso espera detras del gesto.
 * cover:true solo en organismos radialmente simetricos -- en los demas
 * recortaria justo lo que hay que ver. */
const paradas = [
  { id: "header", label: "HEADER", x: 0, y: 0, w: 1672, h: 82 },
  { id: "sceneintent", label: "SCENE INTENT", x: 9, y: 87, w: 462, h: 151 },
  { id: "statemachine", label: "STATE MACHINE", x: 9, y: 264, w: 462, h: 179 },
  { id: "motionverbs", label: "MOTION VERBS", x: 9, y: 467, w: 462, h: 100 },
  { id: "signaltelemetry", label: "SIGNAL TELEMETRY", x: 9, y: 590, w: 462, h: 121 },
  { id: "ritualglyphs", label: "RITUAL GLYPHS", x: 9, y: 734, w: 462, h: 45 },
  { id: "portalcore", label: "PORTAL CORE", x: 481, y: 87, w: 738, h: 597 },
  { id: "uielements", label: "U I ELEMENTS", x: 1228, y: 88, w: 429, h: 289 },
  { id: "shadernotes", label: "SHADER NOTES", x: 1228, y: 405, w: 429, h: 168 },
  { id: "mobilepreview", label: "MOBILE PREVIEW", x: 1228, y: 600, w: 429, h: 174 },
  { id: "datatags", label: "DATA TAGS", x: 9, y: 792, w: 751, h: 70 },
  { id: "colorpalette", label: "COLOR PALETTE", x: 769, y: 792, w: 383, h: 70 },
  { id: "iconclusters", label: "ICON CLUSTERS", x: 1152, y: 792, w: 506, h: 70 },
  { id: "footer", label: "FOOTER", x: 0, y: 880, w: 1672, h: 61 },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · lámina t01-01 · THRESHOLD PORTAL</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      html, body { margin: 0; padding: 0; background: #000; overflow: hidden; }
      .kdx-lam-fit { --s: 1; --tx: 0px; --ty: 0px; position: absolute; inset: 0; overflow: hidden; }
      .kdx-lam-fit > .kdx-lam { position: absolute; left: 0; top: 0; transform-origin: 0 0;
        transform: translate(var(--tx), var(--ty)) scale(var(--s)); }
    </style>
  </head>
  <body>
    <div class="kdx-lam-fit">
      <div class="kdx-lam kdx-lam--threshold" style={`width:${W}px;height:${H}px`} data-lamina="t01-01-threshold-portal">
        {/* El andamio inline hacia Math.min(1, vw/1672, vh/941) ES el
            desktop encogido que el creador rechazo el 25-08. EscenaLamina
            conserva ese ajuste en escritorio y en movil lo cambia por camara
            temporal: una parada por gesto, a escala legible. La plancha no se
            redibuja, cambia la camara. */}
        <EscenaLamina lamina="t01-01-threshold-portal" paradas={paradas}>
        <Header box="left:0px;top:0px;width:1672px;height:82px" />
          <SceneIntent box="left:9px;top:87px;width:462px;height:151px" />
          <StateMachine box="left:9px;top:264px;width:462px;height:179px" />
          <MotionVerbs box="left:9px;top:467px;width:462px;height:100px" />
          <SignalTelemetry box="left:9px;top:590px;width:462px;height:121px" />
          <RitualGlyphs box="left:9px;top:734px;width:462px;height:45px" />
          <PortalCore box="left:481px;top:87px;width:738px;height:597px" />
          <UIElements box="left:1228px;top:88px;width:429px;height:289px" />
          <ShaderNotes box="left:1228px;top:405px;width:429px;height:168px" />
          <MobilePreview box="left:1228px;top:600px;width:429px;height:174px" />
          <DataTags box="left:9px;top:792px;width:751px;height:70px" />
          <ColorPalette box="left:769px;top:792px;width:383px;height:70px" />
          <IconClusters box="left:1152px;top:792px;width:506px;height:70px" />
          <Footer box="left:0px;top:880px;width:1672px;height:61px" />
        </EscenaLamina>
      </div>
    </div>
    <script>
      const sinks = [];
      window.__kdxRegisterFreeze = (fn) => sinks.push(fn);
      window.__kdxFreeze = (t = 0) => { for (const fn of sinks) fn(t); document.documentElement.dataset.kdxFrozen = "1"; };
      const fit = document.querySelector(".kdx-lam-fit");
      if (fit) {
        const ajustar = () => {
          const vw = window.innerWidth, vh = window.innerHeight;
          const s = Math.min(1, vw / 1672, vh / 941);
          fit.style.setProperty("--s", String(s));
          fit.style.setProperty("--tx", ((vw - 1672 * s) / 2).toFixed(2) + "px");
          fit.style.setProperty("--ty", ((vh - 941 * s) / 2).toFixed(2) + "px");
        };
        ajustar();
        addEventListener("resize", ajustar, { passive: true });
      }
    
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";
      montarMovil();
    
      import { montarVida } from "../../../lib/kodex/vida/montar";
      montarVida({ id: "t01-01-threshold-portal" });
    
      import { montarNavegacion } from "../../../components/kodex/lamina/kit/navegacion";
      montarNavegacion();
    
      import { montarTriptico } from "../../../components/kodex/lamina/kit/triptico";
      montarTriptico();
    
      import { montarSonido } from "../../../lib/kodex/sonido-montar";
      montarSonido();
    
      import { montarFases } from "../../../lib/kodex/estado";
      montarFases();
    </script>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>

    <!-- Tarjeta de cruce (costura 3): "cruzar al siguiente estrato" con
         progreso, del diseño del creador. Oculta al congelar (banco intacto). -->
    <a class="lam-siguiente" href="/kodex/lamina/t01-02-observation-eye/">NEXT PLATE · T01 02 OBSERVATION EYE → <i>09/25</i></a>
    <style>
      .lam-siguiente{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:9;
        font:11px ui-monospace,monospace;letter-spacing:.18em;color:rgba(240,237,232,.66);
        text-decoration:none;padding:11px 16px;background:rgba(0,0,0,.5);
        border:1px solid rgba(240,237,232,.16);white-space:nowrap;max-width:92vw;overflow:hidden;text-overflow:ellipsis;}
      .lam-siguiente i{font-style:normal;color:rgba(240,237,232,.38);margin-left:10px}
      .lam-siguiente:hover{color:#fff;border-color:rgba(240,237,232,.45)}
      html[data-kdx-frozen] .lam-siguiente{display:none}
    </style>
  </body>
</html>
