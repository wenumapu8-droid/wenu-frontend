---
/**
 * KODEX-∞ · UNIVERSE PAGE 02 · THRESHOLD
 *
 * Reproducción en código de `reference/canon/u02-threshold.png`
 * (1122×1402, md5 480a56407940381fa25df2eb44c925b4).
 *
 * Primera lámina de la serie UNIVERSE, que apareció en el Drive el 2026-08-10
 * y que el repo no conocía. Es la página 02 de diez —ver
 * `KODEX-INVENTARIO-DRIVE.md`— y se eligió para empezar porque sirve a las dos
 * lecturas del códice a la vez: es **escena 01** del recorrido y **página 02**
 * del documento. Empezar acá no obliga a decidir cuál manda.
 *
 * El héroe va procedural, como manda el contrato: portal arqueado con campo de
 * filamentos, en canvas 2D. Ni un bitmap.
 */
import "../../../styles/kodex-lamina.css";
import Cabecera from "../../../components/kodex/lamina/u02/Cabecera.astro";
import Portal from "../../../components/kodex/lamina/u02/Portal.astro";
import Paneles from "../../../components/kodex/lamina/u02/Paneles.astro";
import Pie from "../../../components/kodex/lamina/u02/Pie.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · THRESHOLD · PAGE 02</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="u02-threshold">
      <Cabecera />
      <Portal />
      <Paneles />
      <Pie />
    </div>

    <style is:global>
      /* La lámina se dibuja a tamaño de referencia y se escala desde 0,0.
         `place-items:center` sobre una caja mayor que el contenedor desborda de
         un lado — costó una vuelta descubrirlo. */
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px;
        height: 1402px;
        /* Negro puro, medido: la referencia da rgb(0,0,0) en las seis muestras
           de fondo y su píxel más oscuro también es 0. El encargo original a
           los agentes decía `#050308` —lo elegí a ojo— y un agente lo detectó
           midiendo: quedaba ~4 puntos de luminancia por encima y le ponía piso
           al puntaje de los cuatro bloques a la vez. El error era mío, no de
           los bloques. */
        background: #000;
        color: #cfc6e8;
        overflow: hidden;
        transform-origin: 0 0;
        font-family: "JetBrains Mono", ui-monospace, monospace;
      }
      .lam [data-bloque] { position: absolute; }
    </style>

    <script>
      /* `100vw / 1122` en CSS da una LONGITUD y `scale()` quiere un NÚMERO:
         puesto en CSS no hace nada y falla en silencio. Por eso vive acá. */
      const lam = document.querySelector(".lam");
      const ajustar = () => {
        const k = Math.min(innerWidth / 1122, innerHeight / 1402);
        lam.style.transform = `scale(${k})`;
        document.body.style.height = `${1402 * k}px`;
      };
      ajustar();
      addEventListener("resize", ajustar, { passive: true });
    </script>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>
  </body>
</html>
