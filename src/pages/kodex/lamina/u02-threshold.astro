---
/**
 * KODEX-∞ · UNIVERSE PAGE 02 · THRESHOLD
 *
 * Reproducción en código de `reference/canon/u02-threshold.png`
 * (1122×1402, md5 480a56407940381fa25df2eb44c925b4).
 *
 * Primera lámina de la serie UNIVERSE, que apareció en el Drive el 2026-08-10
 * y que el repo no conocía. Es la página 02 de diez —ver
 * `KODEX-INVENTARIO-DRIVE.md`— y se eligió para empezar porque sirve a las dos
 * lecturas del códice a la vez: es **escena 01** del recorrido y **página 02**
 * del documento. Empezar acá no obliga a decidir cuál manda.
 *
 * El héroe va procedural, como manda el contrato: portal arqueado con campo de
 * filamentos, en canvas 2D. Ni un bitmap.
 */
import "../../../styles/kodex-lamina.css";
import Cabecera from "../../../components/kodex/lamina/u02/Cabecera.astro";
import Portal from "../../../components/kodex/lamina/u02/Portal.astro";
import Paneles from "../../../components/kodex/lamina/u02/Paneles.astro";
import Pie from "../../../components/kodex/lamina/u02/Pie.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · THRESHOLD · PAGE 02</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="u02-threshold">
      <Cabecera />
      <Portal />
      <Paneles />
      <Pie />
    </div>

    <style is:global>
      /* La lámina se dibuja a tamaño de referencia y se escala desde 0,0.
         `place-items:center` sobre una caja mayor que el contenedor desborda de
         un lado — costó una vuelta descubrirlo. */
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px;
        height: 1402px;
        /* Negro puro, medido: la referencia da rgb(0,0,0) en las seis muestras
           de fondo y su píxel más oscuro también es 0. El encargo original a
           los agentes decía `#050308` —lo elegí a ojo— y un agente lo detectó
           midiendo: quedaba ~4 puntos de luminancia por encima y le ponía piso
           al puntaje de los cuatro bloques a la vez. El error era mío, no de
           los bloques. */
        background: #000;
        color: #cfc6e8;
        overflow: hidden;
        transform-origin: 0 0;
        font-family: "JetBrains Mono", ui-monospace, monospace;
      }
      .lam [data-bloque] { position: absolute; }
    </style>

    <script>
      /* `100vw / 1122` en CSS da una LONGITUD y `scale()` quiere un NÚMERO:
         puesto en CSS no hace nada y falla en silencio. Por eso vive acá. */
      const lam = document.querySelector(".lam");
      const ajustar = () => {
        const k = Math.min(innerWidth / 1122, innerHeight / 1402);
        lam.style.transform = `scale(${k})`;
        document.body.style.height = `${1402 * k}px`;
      };
      ajustar();
      addEventListener("resize", ajustar, { passive: true });
    
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";
      montarMovil();
    
      import { montarVida } from "../../../lib/kodex/vida/montar";
      montarVida({ id: "u02-threshold" });
    
      import { montarNavegacion } from "../../../components/kodex/lamina/kit/navegacion";
      montarNavegacion();
    
      /* ── ADAPTACIÓN AL LECTOR DEL KIT (sólo móvil) ────────────────────
         El tríptico y la capa que oculta el cromo de la plancha leen la misma
         lista de etiquetas —`p,h1,h2,h3,span,dd,dt,li,strong,b,em,small`— y
         esta lámina escribe TODO su cromo en `<div>` posicionados
         (`u2p__t, u2p__l, …`). Consecuencia medida a 390 px, con el tríptico ya
         montado:

           · 16 textos de la plancha quedaban VISIBLES detrás de las páginas
             SIGNAL y EVIDENCE, a 3,4–3,8 px efectivos: exactamente la
             tipografía ilegible que el canon prohíbe.
           · y ninguno de ellos llegaba al tríptico. Su auditoría declaraba
             30 bloques repartidos cuando la plancha tiene bastantes más:
             "nada se pierde" era falso justo acá.

         La causa no es el kit ni los bloques: es que esta lámina habla en
         `div` y el kit escucha en `span`. Se traduce en vez de reescribir
         ninguno de los dos —SEARCH → REUSE → ADAPT—: el texto de cada `div`
         HOJA se envuelve en un `<span>` con el mismo contenido y la misma caja.
         Con eso el lector del kit lo transcribe a las páginas I y III, y la
         regla compartida lo oculta del fondo borroso.

         SÓLO EN MÓVIL, y por construcción: sobre 560 px esta rama no se
         ejecuta y el DOM de escritorio queda intacto, byte por byte. */
      if (matchMedia("(max-width:560px)").matches) {
        document.querySelectorAll(".lam div").forEach((d) => {
          if (d.childElementCount) return;
          const t = d.textContent;
          if (!t || !t.trim()) return;
          const s = document.createElement("span");
          s.textContent = t;
          d.textContent = "";
          d.appendChild(s);
        });
      }
    
      import { montarTriptico } from "../../../components/kodex/lamina/kit/triptico";
      montarTriptico();
    
      import { montarSonido } from "../../../lib/kodex/sonido-montar";
      montarSonido();
    
      import { montarFases } from "../../../lib/kodex/estado";
      montarFases();
    </script>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>

    <!-- Tarjeta de cruce (costura 3): "cruzar al siguiente estrato" con
         progreso, del diseño del creador. Oculta al congelar (banco intacto). -->
    <a class="lam-siguiente" href="/kodex/lamina/u03-return/">NEXT PLATE · U03 RETURN → <i>17/25</i></a>
    <style>
      .lam-siguiente{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:9;
        font:11px ui-monospace,monospace;letter-spacing:.18em;color:rgba(240,237,232,.66);
        text-decoration:none;padding:11px 16px;background:rgba(0,0,0,.5);
        border:1px solid rgba(240,237,232,.16);white-space:nowrap;max-width:92vw;overflow:hidden;text-overflow:ellipsis;}
      .lam-siguiente i{font-style:normal;color:rgba(240,237,232,.38);margin-left:10px}
      .lam-siguiente:hover{color:#fff;border-color:rgba(240,237,232,.45)}
      html[data-kdx-frozen] .lam-siguiente{display:none}
    </style>
  </body>
</html>
