---
/**
 * KODEX-∞ · LÁMINAS
 *
 * Índice de las láminas reproducidas en código. Existe para que dejen de ser
 * páginas sueltas que sólo encuentra quien sabe la URL.
 *
 * Cada tarjeta muestra el puntaje real medido contra su referencia. No es
 * decoración: es el estado de la reproducción, y baja cuando el trabajo mejora.
 */
import "../../../styles/kodex-lamina.css";
import manifiesto from "../../../../reference/MANIFEST.json";

// Los puntajes salen del banco, no de números escritos a mano: si falta el
// archivo, la tarjeta lo dice en vez de mentir con un valor viejo.
const construidas = [
  {
    slug: "t01-03-descent-tunnel",
    titulo: "DESCENT TUNNEL",
    sub: "TANDA 01 · organismo 03 · descenso",
    nota: "Único héroe 100 % procedural de las 17. Costó 3,4 M de tokens y tres vueltas: con ella se construyó la fábrica.",
  },
  {
    slug: "t01-01-threshold-portal",
    titulo: "THRESHOLD PORTAL",
    sub: "TANDA 01 · organismo 01 · umbral de acceso",
    nota: "Tercera con el método v2. La mejor de las tres, en una sola vuelta.",
  },
  {
    slug: "t01-08-signal-bloom",
    titulo: "SIGNAL BLOOM",
    sub: "TANDA 01 · organismo 08 · transmisión",
    nota: "Primera con el método nuevo: cajas medidas, arte trazada, kit calibrado. Llegó al mismo puntaje en UNA vuelta con 4 agentes.",
  },
];

for (const c of construidas) {
  try {
    const s = await import(`../../../../scripts/lamina/out/${c.slug}/score.json`);
    (c as { puntaje?: number | null }).puntaje = (s.default ?? s).global?.pct ?? null;
  } catch {
    (c as { puntaje?: number | null }).puntaje = null;
  }
}

const refs = (manifiesto as { referencias: Array<{ archivo: string; tipo: string; titulo: string }> }).referencias;
const pendientes = refs
  .filter((r) => r.tipo !== "indice" && !construidas.some((c) => r.archivo.startsWith(c.slug)))
  .map((r) => ({ archivo: r.archivo.replace(/\.png$/, ""), titulo: r.titulo, tipo: r.tipo }));
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · láminas</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam lam-idx">
    <header>
      <p class="kdx-eyebrow">KODEX−∞ · sistema visual</p>
      <h1>LÁMINAS</h1>
      <p class="lam-idx__lede">
        Reproducciones en código de las láminas de desarrollo visual.
        Sin imágenes: todo CSS, SVG y canvas. El porcentaje es la diferencia
        medida contra la referencia, píxel a píxel.
      </p>
    </header>

    <h2>Construidas</h2>
    <ul class="lam-idx__grid">
      {construidas.map((c) => (
        <li>
          <a href={`/kodex/lamina/${c.slug}/`}>
            <span class="lam-idx__t">{c.titulo}</span>
            <span class="lam-idx__s">{c.sub}</span>
            <span class="lam-idx__n">{c.nota}</span>
            <span class="lam-idx__score">
              {c.puntaje === null
                ? "sin medir"
                : `${c.puntaje.toFixed(2)}% de diferencia · ${(100 - c.puntaje).toFixed(2)}% de coincidencia`}
            </span>
          </a>
        </li>
      ))}
    </ul>

    <h2>Pendientes <em>· {pendientes.length}</em></h2>
    <ul class="lam-idx__lista">
      {pendientes.map((p) => (
        <li><span class="kdx-dim">{p.tipo}</span> {p.titulo}</li>
      ))}
    </ul>

    <p class="lam-idx__pie">
      Los pósters de TANDA 02 declaran «OF 12» y sólo existen 8.
      Faltan cuatro láminas que no están en el set.
    </p>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam-idx {
        --lam-accent: #ff5a1f;
        min-height: 100vh;
        padding: clamp(24px, 5vw, 64px);
        font-size: 12px;
        line-height: 1.6;
      }
      .lam-idx h1 {
        font-family: var(--lam-display);
        font-size: clamp(34px, 8vw, 68px);
        letter-spacing: -0.03em;
        line-height: 0.9;
        margin: 6px 0 14px;
      }
      .lam-idx h2 {
        font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
        color: var(--lam-accent); margin: 40px 0 14px;
        border-bottom: 1px solid var(--lam-rule); padding-bottom: 8px;
      }
      .lam-idx h2 em { font-style: normal; color: var(--lam-dim); }
      .lam-idx__lede { color: var(--lam-dim); max-width: 62ch; margin: 0; }
      .lam-idx__grid {
        list-style: none; padding: 0; margin: 0;
        display: grid; gap: 14px;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      }
      .lam-idx__grid a {
        display: grid; gap: 5px; padding: 16px;
        border: 1px solid var(--lam-rule);
        color: inherit; text-decoration: none;
      }
      .lam-idx__grid a:hover,
      .lam-idx__grid a:focus-visible {
        border-color: var(--lam-accent);
        outline: none;
        background: color-mix(in srgb, var(--lam-accent) 6%, transparent);
      }
      .lam-idx__t { font-family: var(--lam-display); font-size: 22px; letter-spacing: -0.01em; }
      .lam-idx__s { color: var(--lam-accent); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; }
      .lam-idx__n { color: var(--lam-dim); }
      .lam-idx__score {
        margin-top: 6px; padding-top: 8px;
        border-top: 1px dotted var(--lam-faint);
        font-variant-numeric: tabular-nums;
      }
      .lam-idx__lista { list-style: none; padding: 0; margin: 0; columns: 2; column-gap: 32px; }
      .lam-idx__lista li { color: var(--lam-ink); break-inside: avoid; padding: 2px 0; }
      .lam-idx__pie { margin-top: 40px; color: var(--lam-dim); border-left: 2px solid var(--lam-accent); padding-left: 14px; max-width: 62ch; }
      @media (max-width: 560px) { .lam-idx__lista { columns: 1; } }
    </style>
  </body>
</html>
