/**
 * KODEX−∞ · LÁMINA DE ARCHIVO · MYCELIAL ORACLE · PAGE 23
 *
 * Reproducción en código de reference/pendientes/a23-mycelial-oracle.png
 * (1229×1536). Quinta de la serie de archivo: mismo cromo que
 * silence-engine (a28) y void-orchard (a21) —los seis componentes de
 * src/components/kodex/archivo/ en cajas absolutas medidas— con el
 * organismo central pintado en canvas procedural.
 *
 * TODO el texto visible está TRANSCRITO de la referencia. Nada se
 * inventa: la regla dura de la serie es que rótulos, valores y
 * aforismos son del creador. Lo que en la referencia no se lee, no se
 * escribe: se deja marca no-textual (los glifos alquímicos del pie y
 * los sigilos de los paneles son geometría, no letra).
 *
 * MEDIDO sobre la referencia (perfil de tinta por fila/columna,
 * scripts/lamina/mo/probe.mjs):
 * · marco: verticales en x13/14, x21, y x1205, x1212..1214; regla
 *   superior en y17; caja de la barra inferior y1464..1525.
 * · riel izquierdo: caja x33..224 (191 px). Paneles y237..584,
 *   y592..906, y927..1259, y1276..1455. Reglas internas bajo el
 *   rótulo en y264, y632, y955, y1330.
 * · riel derecho: caja x982..1183 (201 px). Tarjetas y270..557,
 *   y576..873, y891..1173, y1191..1459 — todas con el mismo reparto
 *   interno desde su borde superior (regla a +30, mandala +39..+172,
 *   onda +177..+212, valor +216..+236, etiquetas +250 y +266).
 * · título: «MYCELIAL» versales y88..154 (versal 66 → cuerpo 105,6 con
 *   la razón 0,625 de Cormorant), «ORACLE» y170..239, subtítulo
 *   y266..287 (versal 21 → 33,6), regla ornamental y305, lema
 *   y321..329.
 * · organismo: caja x226..977, y335..1275. Es el 74 % de la tinta de
 *   la lámina (488.934 px de 660.704) con luminancia media 53 — de ahí
 *   que el ambiente radial del canvas sea la palanca grande y no un
 *   adorno: la referencia NO tiene fondo negro plano.
 *
 * Paleta medida (pico y media de los píxeles altos de cada banda):
 * título crema rgb(240,238,220); subtítulo violeta rgb(196,150,215);
 * lema verde-agua rgb(143,162,157); oro del cromo rgb(201,180,124);
 * métricas: verde rgb(123,191,160), turquesa rgb(79,200,180),
 * verde-limón rgb(169,193,135), violeta rgb(184,174,198).
 */
import CabeceraArchivo from "../../../components/kodex/archivo/CabeceraArchivo.astro";
import TituloBilingue from "../../../components/kodex/archivo/TituloBilingue.astro";
import TarjetaMetrica from "../../../components/kodex/archivo/TarjetaMetrica.astro";
import RielMetricas from "../../../components/kodex/archivo/RielMetricas.astro";
import AforismoPie from "../../../components/kodex/archivo/AforismoPie.astro";
import SelloClasificacion from "../../../components/kodex/archivo/SelloClasificacion.astro";
import { rng } from "../../../components/kodex/lamina/kit/rng";

/* ── geometría determinista del cromo (nunca Math.random) ───────────── */

/* Sigilo de la esquina superior izquierda y su gemelo de la derecha:
   rosa de vientos de la referencia — anillos concéntricos con radios y
   motas sobre ellos. */
const rSigilo = rng(0x23a1);
const motasSigilo = [22, 30, 38].flatMap((radio) =>
  Array.from({ length: 8 }, (_, i) => {
    const ang = (i / 8) * Math.PI * 2 + rSigilo() * 0.5;
    return { x: 44 + radio * Math.cos(ang), y: 44 + radio * Math.sin(ang), r: radio };
  })
);
const radiosSigilo = Array.from({ length: 16 }, (_, i) => {
  const a = (i / 16) * Math.PI * 2;
  return { x1: 44 + 10 * Math.cos(a), y1: 44 + 10 * Math.sin(a), x2: 44 + 42 * Math.cos(a), y2: 44 + 42 * Math.sin(a) };
});

/* Ramificador determinista de los sigilos del riel. En la referencia
   los emblemas NO son cuatro líneas: son marañas de micelio que llenan
   su círculo. Con rayas rectas el panel medía 66 % de la tinta de la
   referencia; hace falta la ramificación entera. */
interface Trazo { d: string; o: number; w: number }
function ramificarSVG(
  x: number, y: number, ang: number, largo: number, prof: number,
  r: () => number, out: Trazo[], nodos: Array<{ x: number; y: number; r: number }>
) {
  if (prof <= 0 || largo < 2.5) return;
  const x2 = x + Math.cos(ang) * largo;
  const y2 = y + Math.sin(ang) * largo;
  const cx = x + Math.cos(ang - 0.26) * largo * 0.55;
  const cy = y + Math.sin(ang - 0.26) * largo * 0.55;
  out.push({
    d: `M${x.toFixed(1)} ${y.toFixed(1)} Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`,
    o: +(0.16 + prof * 0.12).toFixed(2),
    w: +(0.22 + prof * 0.2).toFixed(2),
  });
  if (r() < 0.34) nodos.push({ x: x2, y: y2, r: +(0.3 + prof * 0.16).toFixed(2) });
  const n = r() < 0.42 ? 3 : 2;
  for (let k = 0; k < n; k++) {
    const d = (k - (n - 1) / 2) * (0.4 + r() * 0.42);
    ramificarSVG(x2, y2, ang + d + (r() - 0.5) * 0.2, largo * (0.6 + r() * 0.22), prof - 1, r, out, nodos);
  }
}

/* Sigilo «CHAMBER OVERVIEW»: hongo con su micelio dentro de un círculo
   de construcción. */
const rRaiz = rng(0x0f17);
const raices: Trazo[] = [];
const nodosRaiz: Array<{ x: number; y: number; r: number }> = [];
for (let k = 0; k < 11; k++) {
  const a = Math.PI * (0.03 + (k / 10) * 0.94);
  ramificarSVG(90, 120, a, 30 + rRaiz() * 14, 5, rRaiz, raices, nodosRaiz);
}
/* motas del disco */
const motasRaiz = Array.from({ length: 40 }, () => {
  const a = rRaiz() * Math.PI * 2, rr = rRaiz() * 84;
  return { x: 90 + rr * Math.cos(a), y: 93 + rr * Math.sin(a), o: 0.25 + rRaiz() * 0.6 };
});

/* Sigilo «ORACLE APPEARANCE»: la red que dibuja un rostro. Se genera
   media cara y se espeja, como en la referencia. */
const rCara = rng(0x0ac3);
const caraMedia: Trazo[] = [];
const nodosCaraArb: Array<{ x: number; y: number; r: number }> = [];
for (let k = 0; k < 8; k++) {
  const a = -Math.PI / 2 + (k / 7) * Math.PI * 0.92;
  ramificarSVG(79, 66, a, 16 + rCara() * 9, 5, rCara, caraMedia, nodosCaraArb);
}
for (let k = 0; k < 4; k++) {
  const a = Math.PI / 2 - (k / 3) * Math.PI * 0.5;
  ramificarSVG(79, 100, a, 13 + rCara() * 8, 4, rCara, caraMedia, nodosCaraArb);
}

/* Sigilo del panel «ACCESS PROTOCOL»: mandala de anillos punteados con
   la figura sentada al centro. */
const rMandala = rng(0x51c0);
const puntosMandala = [34, 46, 58, 68].flatMap((radio, k) =>
  Array.from({ length: 12 + k * 4 }, (_, i) => {
    const a = (i / (12 + k * 4)) * Math.PI * 2 + rMandala() * 0.2;
    return { x: 70 + radio * Math.cos(a), y: 70 + radio * Math.sin(a), o: 0.35 + rMandala() * 0.5 };
  })
);

/* Fases lunares del pie: ocho discos con su terminador. Geometría, no
   texto: en la referencia son marcas, no palabras. */
const lunas = Array.from({ length: 8 }, (_, i) => ({
  cx: 116 + (i < 4 ? i : i + 1) * 29,
  fase: i / 8,
}));

/* Banda de glifos del pie (y1436..1451 medido): en la referencia son
   sigilos fúngicos ilegibles. Se reproducen como marcas geométricas
   con semilla — NUNCA como texto inventado. */
const rGlifos = rng(0x23bd);
const glifos = Array.from({ length: 32 }, (_, i) => ({
  x: i * 21.6,
  brazos: 3 + Math.floor(rGlifos() * 4),
  gorro: rGlifos() < 0.4,
  giro: rGlifos() * 0.6 - 0.3,
}));
