</style>

<script>
  import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
  import { rng } from "../../../components/kodex/lamina/kit/rng";
  import { montarEscala } from "../../../components/kodex/lamina/kit/escala";
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";

  const raiz = document.querySelector("[data-lam]") as HTMLElement;
  const heroe = document.getElementById("mo-heroe") as HTMLCanvasElement;
  const g = heroe.getContext("2d")!;
  const W = 751, H = 960, CX = W / 2;

  /* ─────────────────────────────────────────────────────────────────
     EL ORGANISMO — caja x226..977, y335..1275 de la referencia.

     La referencia es una caverna bioluminiscente: una RED de micelio
     finísima que ocupa todo el campo y que al centro se cierra en un
     rostro dormido; abajo, un ojo enorme; a los flancos, hongos
     translúcidos con el pie largo; al suelo, racimos de cristal; a los
     cantos, roca cubierta de musgo que brilla.

     Medido en la caja: 71,2 % de sus píxeles tienen tinta y la
     luminancia media es 53. O sea que el fondo NO es negro plano — es
     ambiente iluminado con caída a negro en los bordes. Ese ambiente
     es la mitad del parecido, y el mapa de luminancia por celdas
     (scripts/lamina/mo/mapa.mjs) es lo que dice dónde va cada nivel:
     máximos en el eje (130 en el rostro, 124 en el ojo) y en los
     racimos de cristal fuera de eje (91 abajo a la izquierda, 82 abajo
     a la derecha); mínimos de 12..25 en los cantos.
     ───────────────────────────────────────────────────────────────── */

  const rnd = rng(0x23c0);

  /* posiciones medidas, en coordenadas locales (abs − 226, abs − 335) */
  const ROSTRO = { x: 380, y: 215 };
  const ESTRELLA = { x: 382, y: 122 };
  const OJO = { x: 386, y: 692 };

  const VERDE = "150,205,130";
  const ORO = "198,182,104";
  const TEAL = "104,206,196";
  const LILA = "170,140,215";

  /* ── 1 · LA RED ────────────────────────────────────────────────────
     Nodos sobre una rejilla con jitter y aristas a los vecinos
     cercanos: es lo que da el tejido de la referencia. Una
     ramificación sola deja el campo vacío entre ramas; la malla lo
     llena sin taparlo. */
  type Nodo = { x: number; y: number; r: number; c: string; o: number };
  const malla: Nodo[] = [];
  const PASO = 26;
  for (let gy = -PASO; gy < H + PASO; gy += PASO) {
    for (let gx = -PASO; gx < W + PASO; gx += PASO) {
      const x = gx + (rnd() - 0.5) * PASO * 0.85;
      const y = gy + (rnd() - 0.5) * PASO * 0.85;
      /* densidad: la red se aprieta contra el eje y se abre a los cantos */
      const eje = 1 - Math.min(1, Math.abs(x - CX) / (W * 0.55));
      malla.push({
        x, y,
        r: 0.5 + rnd() * (0.7 + eje * 0.7),
        c: rnd() < 0.42 ? ORO : rnd() < 0.7 ? VERDE : TEAL,
        o: 0.3 + rnd() * 0.55 * (0.5 + eje),
      });
    }
  }
  const aristas: Array<{ a: Nodo; b: Nodo; o: number; c: string }> = [];
  for (let i = 0; i < malla.length; i++) {
    for (let k = i + 1; k < malla.length; k++) {
      const d = Math.hypot(malla[i].x - malla[k].x, malla[i].y - malla[k].y);
      if (d < PASO * 1.3) {
        const eje = 1 - Math.min(1, Math.abs((malla[i].x + malla[k].x) / 2 - CX) / (W * 0.55));
        aristas.push({ a: malla[i], b: malla[k], o: (0.16 + rnd() * 0.34) * (0.5 + eje), c: rnd() < 0.4 ? ORO : VERDE });
      }
    }
  }

  /* ── 2 · LOS ABANICOS ──────────────────────────────────────────────
     Sobre la malla, las ramificaciones que salen del rostro y del ojo:
     son las que dan la simetría radial de la referencia. */
  type Rama = { x1: number; y1: number; x2: number; y2: number; w: number; o: number; c: string };
  const ramas: Rama[] = [];
  const puntas: Nodo[] = [];
  function ramificar(x: number, y: number, ang: number, largo: number, prof: number, color: string) {
    if (prof <= 0 || largo < 4) return;
    const x2 = x + Math.cos(ang) * largo;
    const y2 = y + Math.sin(ang) * largo;
    ramas.push({ x1: x, y1: y, x2, y2, w: 0.3 + prof * 0.18, o: 0.16 + prof * 0.08, c: color });
    if (rnd() < 0.8) puntas.push({ x: x2, y: y2, r: 0.6 + rnd() * 1.3, c: color, o: 0.4 + rnd() * 0.5 });
    const n = rnd() < 0.4 ? 3 : 2;
    for (let k = 0; k < n; k++) {
      const d = (k - (n - 1) / 2) * (0.38 + rnd() * 0.36);
      ramificar(x2, y2, ang + d + (rnd() - 0.5) * 0.16, largo * (0.66 + rnd() * 0.18), prof - 1, color);
    }
  }
  /* corona del rostro */
  for (let k = 0; k < 26; k++) {
    const a = -Math.PI / 2 + (k / 25 - 0.5) * Math.PI * 1.8;
    ramificar(ROSTRO.x, ROSTRO.y - 20, a, 40 + rnd() * 22, 5, k % 3 === 0 ? ORO : VERDE);
  }
  /* abanico del ojo, hacia arriba y a los flancos */
  for (let k = 0; k < 30; k++) {
    const a = -Math.PI / 2 + (k / 29 - 0.5) * Math.PI * 1.94;
    ramificar(OJO.x, OJO.y - 24, a, 54 + rnd() * 30, 5, k % 4 === 0 ? TEAL : ORO);
  }
  /* raíces al suelo */
  for (let k = 0; k < 18; k++) {
    const a = Math.PI / 2 + (k / 17 - 0.5) * Math.PI * 1.6;
    ramificar(OJO.x, OJO.y + 34, a, 40 + rnd() * 26, 4, VERDE);
  }
  /* hebras largas del ojo: curvas que cruzan toda la banda baja */
  type Hebra = { d: Array<[number, number]>; o: number; c: string };
  const hebras: Hebra[] = [];
  for (let k = 0; k < 56; k++) {
    const a = -Math.PI / 2 + ((k / 55) - 0.5) * Math.PI * 1.98;
    const largo = 190 + rnd() * 190;
    const curva = (rnd() - 0.5) * 0.7;
    const pts: Array<[number, number]> = [];
    for (let t = 0; t <= 10; t++) {
      const u = t / 10;
      const ang = a + curva * u * u;
      pts.push([
        OJO.x + Math.cos(ang) * largo * u,
        OJO.y - 18 + Math.sin(ang) * largo * u * 0.9,
      ]);
    }
    hebras.push({ d: pts, o: 0.1 + rnd() * 0.22, c: rnd() < 0.4 ? VERDE : ORO });
  }

  /* tallo: el eje que baja del rostro al ojo */
  for (let k = 0; k < 7; k++) {
    ramificar(ROSTRO.x, ROSTRO.y + 80 + k * 56, Math.PI / 2, 34, 4, ORO);
  }

  /* ── 3 · HONGOS ────────────────────────────────────────────────────
     Sombrero, pie curvo y láminas. Posiciones y anchos medidos sobre
     la referencia; el pie del hongo mayor baja hasta y≈486 local, que
     es lo que ilumina la banda izquierda. */
  const hongos = [
    { x: 129, y: 91, w: 207, cx: 96, cy: 300, ex: 68, ey: 486, c: TEAL, l: LILA },
    { x: 647, y: 206, w: 211, cx: 682, cy: 400, ex: 700, ey: 566, c: TEAL, l: ORO },
    { x: 206, y: 313, w: 111, cx: 196, cy: 400, ex: 188, ey: 478, c: ORO, l: TEAL },
    { x: 529, y: 369, w: 118, cx: 540, cy: 440, ex: 548, ey: 512, c: ORO, l: TEAL },
    { x: 255, y: 406, w: 63, cx: 250, cy: 450, ex: 246, ey: 500, c: LILA, l: TEAL },
    { x: 296, y: 465, w: 33, cx: 294, cy: 495, ex: 292, ey: 526, c: TEAL, l: TEAL },
    { x: 499, y: 439, w: 41, cx: 502, cy: 476, ex: 504, ey: 510, c: TEAL, l: ORO },
    { x: 610, y: 439, w: 37, cx: 613, cy: 476, ex: 616, ey: 508, c: ORO, l: TEAL },
    { x: 563, y: 465, w: 45, cx: 566, cy: 500, ex: 568, ey: 528, c: TEAL, l: LILA },
    { x: 52, y: 452, w: 62, cx: 46, cy: 500, ex: 40, ey: 548, c: LILA, l: TEAL },
    { x: 706, y: 478, w: 58, cx: 712, cy: 528, ex: 718, ey: 580, c: TEAL, l: ORO },
    { x: 176, y: 470, w: 40, cx: 174, cy: 502, ex: 172, ey: 536, c: TEAL, l: LILA },
    { x: 430, y: 486, w: 34, cx: 432, cy: 512, ex: 434, ey: 540, c: ORO, l: TEAL },
  ];

  /* ── 4 · CRISTALES ────────────────────────────────────────────────
     Racimos en los sitios donde el mapa de luminancia de la referencia
     tiene sus máximos fuera del eje: 91/94/91 en (x≈125, y≈790..890) y
     82/80 en (x≈725, y≈740..790). Prismas chicos y apretados — con
     prismas grandes la mancha queda plana y el banco lo castiga. */
  const racimos = [
    { x: 66, y: 700, rx: 66, ry: 200, n: 40, alto: 42 },
    { x: 126, y: 700, rx: 46, ry: 190, n: 30, alto: 40 },
    { x: 700, y: 720, rx: 54, ry: 180, n: 28, alto: 38 },
    { x: 130, y: 862, rx: 82, ry: 56, n: 38, alto: 40 },
    { x: 654, y: 856, rx: 80, ry: 58, n: 36, alto: 40 },
    { x: 720, y: 792, rx: 40, ry: 90, n: 20, alto: 38 },
    { x: 380, y: 884, rx: 150, ry: 34, n: 18, alto: 24 },
    { x: 250, y: 620, rx: 60, ry: 60, n: 10, alto: 24 },
    { x: 512, y: 630, rx: 60, ry: 60, n: 10, alto: 24 },
  ];

  const cristales = racimos.flatMap((r) =>
    Array.from({ length: r.n }, () => ({
      x: r.x + (rnd() - 0.5) * 2 * r.rx,
      y: r.y + (rnd() - 0.5) * 2 * r.ry,
      h: r.alto * (0.35 + rnd() * 0.9),
      w: 3 + rnd() * 6,
      c: rnd() < 0.5 ? LILA : TEAL,
      o: 0.42 + rnd() * 0.5,
    }))
  );

  /* ── 5 · HILOS Y GRANO ────────────────────────────────────────────*/
  const hilos = Array.from({ length: 120 }, () => ({
    x: rnd() * W,
    y0: rnd() * 30,
    largo: 50 + rnd() * 300,
    o: 0.12 + rnd() * 0.34,
    c: rnd() < 0.3 ? LILA : TEAL,
  }));

  const grano = Array.from({ length: 18000 }, () => {
    const x = rnd() * W, y = rnd() * H;
    const borde = Math.min(x, W - x) / (W * 0.5);
    /* la roca del canto no es negra: es musgo bioluminiscente */
    return {
      x, y,
      s: 0.7 + rnd() * 1.4,
      o: (borde < 0.3 ? 0.1 : 0.05) + rnd() * (borde < 0.3 ? 0.3 : 0.24),
      c: rnd() < 0.26 ? ORO : rnd() < 0.55 ? TEAL : VERDE,
    };
  });

  /* musgo: mata de puntos finos sobre el suelo y los muros bajos */
  const musgo = Array.from({ length: 2400 }, () => {
    const x = rnd() * W;
    const y = 700 + Math.sqrt(rnd()) * 250;
    const borde = Math.min(x, W - x) / (W * 0.5);
    return {
      x, y,
      s: 0.7 + rnd() * 1.5,
      o: (0.1 + rnd() * 0.34) * (borde < 0.35 ? 1.25 : 1),
      c: rnd() < 0.3 ? LILA : rnd() < 0.62 ? TEAL : VERDE,
    };
  });

  const chispas = Array.from({ length: 260 }, () => ({
    x: rnd() * W, y: rnd() * H,
    r: 0.6 + rnd() * 1.7,
    o: 0.25 + rnd() * 0.6,
    v: rnd(),
    c: rnd() < 0.3 ? LILA : rnd() < 0.6 ? TEAL : VERDE,
  }));

  /* ── capa estática ────────────────────────────────────────────────*/
  const fondo = document.createElement("canvas");
  fondo.width = W; fondo.height = H;
  const f = fondo.getContext("2d")!;

  function pintarHongo(c: CanvasRenderingContext2D, h: typeof hongos[number]) {
    const rx = h.w / 2, ry = h.w * 0.28;
    const via = () => {
      c.beginPath();
      c.moveTo(h.x, h.y + ry * 0.4);
      c.quadraticCurveTo(h.cx, h.cy, h.ex, h.ey);
    };
    const ancho = Math.max(5, h.w * 0.15);
    /* halo */
    c.strokeStyle = tinta(h.c, 0.09);
    c.lineWidth = ancho * 2.4;
    via(); c.stroke();
    /* columna translúcida */
    c.strokeStyle = tinta(h.c, 0.22);
    c.lineWidth = ancho;
    via(); c.stroke();
    /* fibras del pie: la referencia lo tiene estriado a lo largo */
    for (let k = -2; k <= 2; k++) {
      c.save();
      c.translate(k * ancho * 0.3, 0);
      c.strokeStyle = tinta(h.l, k === 0 ? 0.5 : 0.24);
      c.lineWidth = k === 0 ? 1.2 : 0.8;
      via(); c.stroke();
      c.restore();
    }
    /* halo del sombrero */
    const halo = c.createRadialGradient(h.x, h.y, rx * 0.2, h.x, h.y, rx * 1.5);
    halo.addColorStop(0, tinta(h.c, 0.16));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    c.fillStyle = halo;
    c.beginPath(); c.ellipse(h.x, h.y, rx * 1.5, ry * 2, 0, 0, Math.PI * 2); c.fill();
    /* cúpula */
    const cap = c.createLinearGradient(h.x, h.y - ry, h.x, h.y + ry);
    const k = 1;
    cap.addColorStop(0, tinta(h.l, 0.3 * k));
    cap.addColorStop(0.45, tinta(h.l, 0.24 * k));
    cap.addColorStop(0.75, tinta(h.c, 0.27 * k));
    cap.addColorStop(1, tinta(h.c, 0.2 * k));
    c.fillStyle = cap;
    c.beginPath(); c.ellipse(h.x, h.y, rx, ry, 0, Math.PI, Math.PI * 2); c.fill();
    c.beginPath(); c.ellipse(h.x, h.y, rx, ry * 0.42, 0, 0, Math.PI); c.fill();
    c.strokeStyle = tinta(h.l, 0.75);
    c.lineWidth = 1.1;
    c.beginPath(); c.ellipse(h.x, h.y, rx, ry, 0, Math.PI, Math.PI * 2); c.stroke();
    /* láminas radiales que bajan al pie */
    const n = Math.max(9, Math.round(h.w / 9));
    for (let k = 0; k <= n; k++) {
      const ang = Math.PI + (k / n) * Math.PI;
      c.strokeStyle = tinta(h.l, 0.2);
      c.lineWidth = 0.7;
      c.beginPath();
      c.moveTo(h.x + Math.cos(ang) * rx * 0.97, h.y + Math.sin(ang) * ry * 0.97);
      c.quadraticCurveTo(h.x, h.y + ry * 0.2, h.x, h.y + ry * 0.5);
      c.stroke();
    }
    /* motas del sombrero */
    for (let k = 0; k < Math.round(h.w / 3.2); k++) {
      const a = Math.PI + rnd() * Math.PI;
      const rr = rnd();
      c.fillStyle = tinta(h.l, 0.4 + rnd() * 0.55);
      c.beginPath();
      c.arc(h.x + Math.cos(a) * rx * rr, h.y + Math.sin(a) * ry * rr * 0.9, 0.5 + rnd() * 1.1, 0, Math.PI * 2);
      c.fill();
    }
  }

  /** El rostro: la referencia lo dibuja con la propia red, no con
      relleno. Se pinta como máscara tenue + rasgos de línea. */
  function pintarRostro(c: CanvasRenderingContext2D) {
    const { x, y } = ROSTRO;
    const mask = c.createRadialGradient(x, y, 10, x, y, 132);
    mask.addColorStop(0, tinta("150,196,128", 0.34));
    mask.addColorStop(0.5, tinta("110,164,110", 0.22));
    mask.addColorStop(1, "rgba(0,0,0,0)");
    c.fillStyle = mask;
    c.beginPath(); c.ellipse(x, y, 118, 138, 0, 0, Math.PI * 2); c.fill();

    /* halo de la corona: luz difusa sobre la frente */
    const coronaLuz = c.createRadialGradient(x, y - 86, 10, x, y - 76, 130);
    coronaLuz.addColorStop(0, tinta("150,200,150", 0.4));
    coronaLuz.addColorStop(0.5, tinta("110,164,120", 0.18));
    coronaLuz.addColorStop(1, "rgba(0,0,0,0)");
    c.fillStyle = coronaLuz;
    c.beginPath(); c.ellipse(x, y - 78, 138, 108, 0, 0, Math.PI * 2); c.fill();

    /* corona: el halo de filamentos que rodea la cabeza en la
       referencia — es lo que sube la banda del rostro a 97..129 */
    for (let k = 0; k < 90; k++) {
      const a = -Math.PI / 2 + ((k / 89) - 0.5) * Math.PI * 1.9;
      const r0 = 84 + (k % 5) * 8;
      const r1 = r0 + 44 + (k % 7) * 14;
      c.strokeStyle = tinta("164,212,146", 0.13 + (k % 4) * 0.08);
      c.lineWidth = 0.7;
      c.beginPath();
      c.moveTo(x + Math.cos(a) * r0 * 0.86, y + Math.sin(a) * r0);
      c.quadraticCurveTo(x + Math.cos(a + 0.2) * r1 * 0.9, y + Math.sin(a + 0.2) * r1,
                         x + Math.cos(a + 0.42) * r1 * 0.94, y + Math.sin(a + 0.42) * r1 * 1.04);
      c.stroke();
    }

    /* óvalo del rostro */
    c.strokeStyle = tinta("186,224,166", 0.46);
    c.lineWidth = 1.6;
    c.beginPath(); c.ellipse(x, y + 10, 78, 102, 0, 0, Math.PI * 2); c.stroke();
    /* volumen del rostro: la referencia lo tiene modelado, no calado */
    const vol = c.createRadialGradient(x, y - 10, 8, x, y + 4, 92);
    vol.addColorStop(0, tinta("176,210,150", 0.18));
    vol.addColorStop(0.7, tinta("128,168,116", 0.06));
    vol.addColorStop(1, "rgba(0,0,0,0)");
    c.fillStyle = vol;
    c.beginPath(); c.ellipse(x, y + 10, 78, 102, 0, 0, Math.PI * 2); c.fill();
    /* pómulos y sienes: arcos que la red sugiere */
    for (const lado of [-1, 1]) {
      c.strokeStyle = tinta("176,214,160", 0.2);
      c.beginPath();
      c.moveTo(x + lado * 76, y - 26);
      c.quadraticCurveTo(x + lado * 60, y + 48, x, y + 106);
      c.stroke();
    }
    /* cejas */
    c.strokeStyle = tinta("206,232,190", 0.5);
    c.lineWidth = 2;
    for (const lado of [-1, 1]) {
      c.beginPath();
      c.moveTo(x + lado * 13, y - 36);
      c.quadraticCurveTo(x + lado * 38, y - 48, x + lado * 62, y - 32);
      c.stroke();
    }
    /* ojos cerrados: párpado + pestaña */
    for (const lado of [-1, 1]) {
      const ex = x + lado * 37;
      /* cuenca sombreada */
      const cuenca = c.createRadialGradient(ex, y - 10, 2, ex, y - 8, 30);
      cuenca.addColorStop(0, tinta("40,58,40", 0.5));
      cuenca.addColorStop(1, "rgba(0,0,0,0)");
      c.fillStyle = cuenca;
      c.beginPath(); c.ellipse(ex, y - 10, 28, 18, 0, 0, Math.PI * 2); c.fill();
      c.strokeStyle = tinta("232,248,216", 0.85);
      c.lineWidth = 2.4;
      c.beginPath();
      c.moveTo(ex - 24, y - 12);
      c.quadraticCurveTo(ex, y + 2, ex + 24, y - 12);
      c.stroke();
      c.strokeStyle = tinta("232,248,216", 0.34);
      c.lineWidth = 1;
      c.beginPath();
      c.moveTo(ex - 24, y - 15);
      c.quadraticCurveTo(ex, y - 28, ex + 24, y - 15);
      c.stroke();
    }
    /* nariz */
    c.strokeStyle = tinta("206,232,190", 0.38);
    c.lineWidth = 1.4;
    c.beginPath(); c.moveTo(x - 4, y + 2); c.lineTo(x - 10, y + 40); c.quadraticCurveTo(x, y + 50, x + 10, y + 40); c.lineTo(x + 4, y + 2); c.stroke();
    /* labios */
    c.strokeStyle = tinta("222,240,206", 0.55);
    c.lineWidth = 1.8;
    c.beginPath();
    c.moveTo(x - 30, y + 68);
    c.quadraticCurveTo(x - 14, y + 58, x, y + 65);
    c.quadraticCurveTo(x + 14, y + 58, x + 30, y + 68);
    c.stroke();
    c.beginPath();
    c.moveTo(x - 30, y + 68);
    c.quadraticCurveTo(x, y + 86, x + 30, y + 68);
    c.stroke();
    /* mentón */
    c.strokeStyle = tinta("176,214,160", 0.26);
    c.lineWidth = 1;
    c.beginPath(); c.moveTo(x - 34, y + 96); c.quadraticCurveTo(x, y + 114, x + 34, y + 96); c.stroke();
  }

  function pintarFondo() {
    /* 1 · roca */
    const base = f.createLinearGradient(0, 0, 0, H);
    base.addColorStop(0, "#020507");
    base.addColorStop(0.5, "#030a0a");
    base.addColorStop(1, "#020607");
    f.fillStyle = base;
    f.fillRect(0, 0, W, H);

    /* 2 · EL AMBIENTE — viñeta invertida: luz al centro, negro al canto.
       Sin esto la caja mide como si le faltara la mitad del dibujo. */
    const amb = f.createRadialGradient(CX, H * 0.48, 30, CX, H * 0.52, W * 0.80);
    amb.addColorStop(0, tinta("52,96,84", 0.42));
    amb.addColorStop(0.38, tinta("36,74,70", 0.2));
    amb.addColorStop(0.7, tinta("18,42,44", 0.06));
    amb.addColorStop(1, "rgba(0,0,0,0)");
    f.fillStyle = amb;
    f.fillRect(0, 0, W, H);

    /* bóveda */
    const boveda = f.createLinearGradient(0, 0, 0, 190);
    boveda.addColorStop(0, tinta("40,80,76", 0.2));
    boveda.addColorStop(1, "rgba(0,0,0,0)");
    f.fillStyle = boveda;
    f.fillRect(0, 0, W, 190);

    /* suelo */
    const suelo = f.createLinearGradient(0, 660, 0, 950);
    suelo.addColorStop(0, "rgba(0,0,0,0)");
    suelo.addColorStop(0.55, tinta("36,68,64", 0.22));
    suelo.addColorStop(0.86, tinta("40,76,70", 0.38));
    suelo.addColorStop(1, tinta("30,58,56", 0.24));
    f.fillStyle = suelo;
    f.fillRect(0, 660, W, 300);

    /* vano izquierdo entre el hongo mayor y el rostro (medido 78/57
       contra 50/36 míos) */
    const vanoIzq = f.createRadialGradient(226, 110, 16, 226, 110, 160);
    vanoIzq.addColorStop(0, tinta("54,102,94", 0.4));
    vanoIzq.addColorStop(1, "rgba(0,0,0,0)");
    f.fillStyle = vanoIzq;
    f.fillRect(60, 0, 340, 280);

    /* tallo bajo el rostro (medido 85 contra 57 míos) */
    const tallo = f.createRadialGradient(376, 400, 12, 376, 400, 120);
    tallo.addColorStop(0, tinta("96,132,74", 0.34));
    tallo.addColorStop(1, "rgba(0,0,0,0)");
    f.fillStyle = tallo;
    f.fillRect(240, 280, 280, 240);

    /* techo del flanco derecho (medido 52 contra 21 míos en x≈575,y≈78) */
    const techoDer = f.createRadialGradient(556, 84, 20, 556, 84, 210);
    techoDer.addColorStop(0, tinta("52,98,92", 0.26));
    techoDer.addColorStop(1, "rgba(0,0,0,0)");
    f.fillStyle = techoDer;
    f.fillRect(380, 0, 371, 240);

    /* focos laterales medidos: sin ellos la columna x≈125 quedaba a la
       mitad de la luz de la referencia de y496 a y861 */
    const focoIzq = f.createRadialGradient(118, 690, 20, 118, 690, 230);
    focoIzq.addColorStop(0, tinta("58,104,92", 0.4));
    focoIzq.addColorStop(1, "rgba(0,0,0,0)");
    f.fillStyle = focoIzq;
    f.fillRect(0, 440, 340, 500);
    const focoMed = f.createRadialGradient(225, 600, 10, 225, 600, 120);
    focoMed.addColorStop(0, tinta("74,124,96", 0.42));
    focoMed.addColorStop(1, "rgba(0,0,0,0)");
    f.fillStyle = focoMed;
    f.fillRect(80, 460, 300, 300);

    /* foco del ojo */
    const amb2 = f.createRadialGradient(OJO.x, OJO.y, 16, OJO.x, OJO.y, 300);
    amb2.addColorStop(0, tinta("110,140,58", 0.46));
    amb2.addColorStop(1, "rgba(0,0,0,0)");
    f.fillStyle = amb2;
    f.fillRect(0, 0, W, H);

    /* 3 · roca de los cantos */
    for (const lado of [0, 1]) {
      f.beginPath();
      f.moveTo(lado ? W : 0, 0);
      for (let y = 0; y <= H; y += 18) {
        const d = 44 + 32 * Math.sin(y * 0.011 + lado * 2.1) + 18 * Math.sin(y * 0.031 + lado);
        f.lineTo(lado ? W - d : d, y);
      }
      f.lineTo(lado ? W : 0, H);
      f.closePath();
      f.fillStyle = "rgba(3,7,9,0.24)";
      f.fill();
    }

    /* 4 · hilos colgantes */
    for (const h of hilos) {
      f.strokeStyle = tinta(h.c, h.o * 0.55);
      f.lineWidth = 0.7;
      f.beginPath(); f.moveTo(h.x, h.y0); f.lineTo(h.x, h.y0 + h.largo); f.stroke();
      for (let k = 0; k < 5; k++) {
        f.fillStyle = tinta(h.c, h.o);
        f.beginPath(); f.arc(h.x, h.y0 + (h.largo * (k + 1)) / 6, 0.85, 0, Math.PI * 2); f.fill();
      }
    }

    /* 5 · LA RED: primero la malla, después los abanicos */
    for (const e of aristas) {
      f.strokeStyle = tinta(e.c, e.o);
      f.lineWidth = 0.55;
      f.beginPath(); f.moveTo(e.a.x, e.a.y); f.lineTo(e.b.x, e.b.y); f.stroke();
    }
    for (const h of hebras) {
      f.strokeStyle = tinta(h.c, h.o);
      f.lineWidth = 0.7;
      f.beginPath();
      f.moveTo(h.d[0][0], h.d[0][1]);
      for (const [x, y] of h.d.slice(1)) f.lineTo(x, y);
      f.stroke();
      for (let t = 2; t < h.d.length; t += 3) {
        f.fillStyle = tinta(h.c, h.o * 2.2);
        f.beginPath(); f.arc(h.d[t][0], h.d[t][1], 1, 0, Math.PI * 2); f.fill();
      }
    }
    for (const r of ramas) {
      f.strokeStyle = tinta(r.c, r.o);
      f.lineWidth = r.w;
      f.beginPath(); f.moveTo(r.x1, r.y1); f.lineTo(r.x2, r.y2); f.stroke();
    }
    for (const n of malla.concat(puntas)) {
      f.fillStyle = tinta(n.c, n.o);
      f.beginPath(); f.arc(n.x, n.y, n.r, 0, Math.PI * 2); f.fill();
    }

    /* 6 · grano */
    for (const t of grano) {
      f.fillStyle = tinta(t.c, t.o);
      f.fillRect(t.x, t.y, t.s, t.s);
    }

    /* 7 · hongos */
    for (const h of hongos) pintarHongo(f, h);

    /* 8 · el rostro, encima: es el máximo de luz del campo (129 medido
       en el eje) y debajo de los hongos se perdía */
    pintarRostro(f);

    /* 9 · cristales */
    for (const c of cristales) {
      const gr = f.createLinearGradient(c.x, c.y - c.h, c.x, c.y);
      gr.addColorStop(0, tinta(c.c, c.o));
      gr.addColorStop(1, tinta(c.c, c.o * 0.2));
      f.fillStyle = gr;
      f.beginPath();
      f.moveTo(c.x, c.y - c.h);
      f.lineTo(c.x + c.w / 2, c.y - c.h * 0.78);
      f.lineTo(c.x + c.w / 2, c.y);
      f.lineTo(c.x - c.w / 2, c.y);
      f.lineTo(c.x - c.w / 2, c.y - c.h * 0.78);
      f.closePath();
      f.fill();
      f.strokeStyle = tinta(c.c, Math.min(1, c.o * 1.5));
      f.lineWidth = 0.7;
      f.stroke();
      /* arista de faceta: sin ella el prisma se lee como una barra */
      f.strokeStyle = tinta(c.c, Math.min(1, c.o * 0.9));
      f.beginPath();
      f.moveTo(c.x, c.y - c.h);
      f.lineTo(c.x, c.y);
      f.stroke();
    }

    /* 10 · suelo: musgo y red horizontal */
    for (const m of musgo) {
      f.fillStyle = tinta(m.c, m.o);
      f.fillRect(m.x, m.y, m.s, m.s);
    }
    for (let k = 0; k < 32; k++) {
      const y = 700 + k * 8 + Math.sin(k) * 6;
      f.strokeStyle = tinta(ORO, 0.1 + (k % 4) * 0.045);
      f.lineWidth = 0.6;
      f.beginPath();
      f.moveTo(0, y);
      for (let x = 0; x <= W; x += 22) f.lineTo(x, y + Math.sin(x * 0.03 + k) * 5);
      f.stroke();
    }

    /* 11 · cierre contra el papel */
    const cierre = f.createLinearGradient(0, 0, 0, H);
    cierre.addColorStop(0, "rgba(4,6,10,0.9)");
    cierre.addColorStop(0.026, "rgba(4,6,10,0)");
    cierre.addColorStop(0.976, "rgba(4,6,10,0)");
    cierre.addColorStop(1, "rgba(4,6,10,0.92)");
    f.fillStyle = cierre;
    f.fillRect(0, 0, W, H);
  }

  /* ── piezas vivas ─────────────────────────────────────────────────*/
  function pintarOjo(fase: number) {
    const pulso = 0.86 + 0.14 * Math.sin(fase * Math.PI * 2);
    g.save();
    g.globalCompositeOperation = "lighter";
    const es = g.createRadialGradient(OJO.x, OJO.y, 8, OJO.x, OJO.y, 150);
    es.addColorStop(0, tinta("218,226,120", 0.5 * pulso));
    es.addColorStop(0.36, tinta("164,192,80", 0.26 * pulso));
    es.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = es;
    g.beginPath(); g.ellipse(OJO.x, OJO.y, 150, 96, 0, 0, Math.PI * 2); g.fill();
    g.restore();

    /* esclerótica: disco claro que sostiene el iris (medido ~137 de radio) */
    const escl = g.createRadialGradient(OJO.x, OJO.y, 40, OJO.x, OJO.y, 132);
    escl.addColorStop(0, tinta("196,214,120", 0.34));
    escl.addColorStop(0.62, tinta("150,180,90", 0.12));
    escl.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = escl;
    g.beginPath(); g.ellipse(OJO.x, OJO.y, 134, 88, 0, 0, Math.PI * 2); g.fill();

    /* iris: fibras radiales densas hasta r=80 */
    for (let k = 0; k < 168; k++) {
      const a = (k / 168) * Math.PI * 2;
      g.strokeStyle = tinta("220,228,128", 0.14 + (k % 4) * 0.13);
      g.lineWidth = 0.9;
      g.beginPath();
      g.moveTo(OJO.x + Math.cos(a) * 26, OJO.y + Math.sin(a) * 26);
      g.lineTo(OJO.x + Math.cos(a) * (72 + (k % 3) * 6), OJO.y + Math.sin(a) * (72 + (k % 3) * 6));
      g.stroke();
    }
    g.strokeStyle = tinta("212,222,116", 0.85);
    g.lineWidth = 2;
    g.beginPath(); g.arc(OJO.x, OJO.y, 80, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("212,222,116", 0.3);
    g.lineWidth = 1;
    g.beginPath(); g.arc(OJO.x, OJO.y, 62, 0, Math.PI * 2); g.stroke();
    /* pupila */
    g.fillStyle = "#04100c";
    g.beginPath(); g.arc(OJO.x, OJO.y, 25, 0, Math.PI * 2); g.fill();
    g.strokeStyle = tinta("140,190,120", 0.5);
    g.lineWidth = 1;
    g.beginPath(); g.arc(OJO.x, OJO.y, 25, 0, Math.PI * 2); g.stroke();
    g.fillStyle = tinta("86,214,206", 0.9 * pulso);
    g.beginPath(); g.arc(OJO.x, OJO.y, 13, 0, Math.PI * 2); g.fill();
    g.fillStyle = tinta("240,255,250", 0.95);
    g.beginPath(); g.arc(OJO.x - 4, OJO.y - 4, 3.4, 0, Math.PI * 2); g.fill();

    /* párpado en almendra */
    g.strokeStyle = tinta("214,224,150", 0.45);
    g.lineWidth = 1.6;
    g.beginPath();
    g.moveTo(OJO.x - 140, OJO.y);
    g.quadraticCurveTo(OJO.x, OJO.y - 116, OJO.x + 140, OJO.y);
    g.quadraticCurveTo(OJO.x, OJO.y + 116, OJO.x - 140, OJO.y);
    g.stroke();
    /* arcos que lo abrazan */
    for (const [r, o] of [[176, 0.3], [212, 0.18]] as const) {
      g.strokeStyle = tinta(ORO, o);
      g.lineWidth = 1.1;
      g.beginPath(); g.arc(OJO.x, OJO.y + 16, r, Math.PI * 0.05, Math.PI * 0.95); g.stroke();
    }
  }

  function pintarEstrella(fase: number) {
    const pulso = 0.82 + 0.18 * Math.cos(fase * Math.PI * 2);
    g.save();
    g.globalCompositeOperation = "lighter";
    const halo = g.createRadialGradient(ESTRELLA.x, ESTRELLA.y, 0, ESTRELLA.x, ESTRELLA.y, 74);
    halo.addColorStop(0, tinta("240,250,255", 0.95 * pulso));
    halo.addColorStop(0.08, tinta("200,234,246", 0.4 * pulso));
    halo.addColorStop(0.32, tinta("140,198,214", 0.14 * pulso));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo;
    g.beginPath(); g.arc(ESTRELLA.x, ESTRELLA.y, 74, 0, Math.PI * 2); g.fill();
    /* estallido: rayos largos, como en la referencia */
    for (let k = 0; k < 28; k++) {
      const a = (k / 28) * Math.PI * 2;
      const largo = k % 7 === 0 ? 62 : k % 2 ? 26 : 40;
      g.strokeStyle = tinta("236,248,255", (k % 7 === 0 ? 0.34 : 0.16) * pulso);
      g.lineWidth = k % 7 === 0 ? 1.2 : 0.7;
      g.beginPath();
      g.moveTo(ESTRELLA.x + Math.cos(a) * 5, ESTRELLA.y + Math.sin(a) * 5);
      g.lineTo(ESTRELLA.x + Math.cos(a) * largo, ESTRELLA.y + Math.sin(a) * largo);
      g.stroke();
    }
    g.strokeStyle = tinta("244,252,255", 0.6 * pulso);
    g.lineWidth = 0.9;
    for (const [dx, dy] of [[1, 0], [0, 1]] as const) {
      g.beginPath();
      g.moveTo(ESTRELLA.x - dx * 46, ESTRELLA.y - dy * 46);
      g.lineTo(ESTRELLA.x + dx * 46, ESTRELLA.y + dy * 46);
      g.stroke();
    }
    g.restore();
  }

  function pintarEje(fase: number) {
    const pulso = 0.86 + 0.14 * Math.sin(fase * Math.PI * 2 + 1);
    g.save();
    g.globalCompositeOperation = "lighter";
    const eje = g.createLinearGradient(CX - 9, 0, CX + 9, 0);
    eje.addColorStop(0, "rgba(0,0,0,0)");
    eje.addColorStop(0.5, tinta("140,225,215", 0.3 * pulso));
    eje.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = eje;
    g.fillRect(CX - 9, 30, 18, 78);
    g.fillRect(CX - 9, 330, 18, 300);
    g.restore();
  }

  /* ── mandalas de las tarjetas ─────────────────────────────────────*/
  const minis = Array.from(document.querySelectorAll<HTMLCanvasElement>(".mo-mini"));
  const paletaMini = [
    { anillo: "168,138,214", onda: "120,190,220" },
    { anillo: "108,206,196", onda: "108,206,196" },
    { anillo: "169,193,135", onda: "169,193,135" },
    { anillo: "168,138,214", onda: "168,138,214" },
  ];
  const ondas = paletaMini.map((_, i) => {
    const r = rng(0x9000 + i * 37);
    return Array.from({ length: 88 }, (_, k) => {
      const base = i === 3 ? 0.22 + 0.34 * Math.abs(Math.sin((k / 88) * Math.PI * 3)) : 0.18;
      return base + r() * (i === 2 ? 0.7 : 0.55);
    });
  });
  const rMini = rng(0x77aa);
  const semillasMini = Array.from({ length: 4 }, () => Array.from({ length: 120 }, () => rMini()));

  function pintarMini(c: CanvasRenderingContext2D, i: number, fase: number) {
    const S = 176, cx = S / 2, cy = 66, R = 62;
    const p = paletaMini[i];
    const s = semillasMini[i];
    const pulso = 0.82 + 0.18 * Math.sin(fase * Math.PI * 2 + i);
    c.clearRect(0, 0, S, S);
    /* disco: en la referencia es un vidrio oscuro con aro encendido y
       un campo de chispas dentro, no un fondo vacío */
    const disco = c.createRadialGradient(cx, cy - 10, 4, cx, cy, R);
    disco.addColorStop(0, tinta(p.anillo, 0.16 * pulso));
    disco.addColorStop(0.7, tinta(p.anillo, 0.05));
    disco.addColorStop(1, "rgba(0,0,0,0)");
    c.fillStyle = disco;
    c.beginPath(); c.arc(cx, cy, R, 0, Math.PI * 2); c.fill();
    c.strokeStyle = tinta(p.anillo, 0.6);
    c.lineWidth = 1.6;
    c.beginPath(); c.arc(cx, cy, R, 0, Math.PI * 2); c.stroke();
    c.strokeStyle = tinta(p.anillo, 0.18);
    c.lineWidth = 1;
    c.beginPath(); c.arc(cx, cy, R - 11, 0, Math.PI * 2); c.stroke();
    for (let k = 0; k < 8; k++) {
      const a = (k / 8) * Math.PI * 2;
      c.fillStyle = tinta(p.anillo, 0.7);
      c.beginPath(); c.arc(cx + Math.cos(a) * R, cy + Math.sin(a) * R, 1.6, 0, Math.PI * 2); c.fill();
    }
    /* chispas internas y radios finos */
    for (let k = 0; k < 70; k++) {
      const a = s[(k * 3) % 120] * Math.PI * 2;
      const rr = Math.sqrt(s[(k * 5 + 1) % 120]) * (R - 6);
      c.fillStyle = tinta(p.anillo, 0.25 + s[(k * 7 + 2) % 120] * 0.6);
      c.beginPath();
      c.arc(cx + Math.cos(a) * rr, cy + Math.sin(a) * rr, 0.5 + s[(k * 11) % 120] * 1.1, 0, Math.PI * 2);
      c.fill();
    }
    for (let k = 0; k < 24; k++) {
      const a = (k / 24) * Math.PI * 2;
      c.strokeStyle = tinta(p.anillo, 0.08 + (k % 3) * 0.05);
      c.lineWidth = 0.6;
      c.beginPath();
      c.moveTo(cx + Math.cos(a) * 10, cy + Math.sin(a) * 10);
      c.lineTo(cx + Math.cos(a) * (R - 6), cy + Math.sin(a) * (R - 6));
      c.stroke();
    }

    if (i === 0) {
      for (const [n, rr, esc] of [[8, 40, 1], [8, 24, 0.72], [6, 12, 0.5]] as const) {
        for (let k = 0; k < n; k++) {
          const a = (k / n) * Math.PI * 2 - Math.PI / 2 + (n === 8 && rr === 24 ? Math.PI / 8 : 0);
          c.save();
          c.translate(cx + Math.cos(a) * rr, cy + Math.sin(a) * rr);
          c.rotate(a + Math.PI / 2);
          c.scale(esc, esc);
          const gr = c.createLinearGradient(0, -13, 0, 13);
          gr.addColorStop(0, tinta("212,198,250", 0.8 * pulso));
          gr.addColorStop(1, tinta("112,88,182", 0.32));
          c.fillStyle = gr;
          c.beginPath();
          c.moveTo(0, -13); c.lineTo(5.5, -2); c.lineTo(3, 12); c.lineTo(-3, 12); c.lineTo(-5.5, -2);
          c.closePath(); c.fill();
          c.strokeStyle = tinta("226,216,255", 0.75); c.lineWidth = 0.6; c.stroke();
          c.restore();
        }
      }
      c.fillStyle = tinta("240,235,255", 0.95);
      c.beginPath(); c.arc(cx, cy, 2.4, 0, Math.PI * 2); c.fill();
    } else if (i === 1 || i === 2) {
      const brazos = i === 1 ? 9 : 15;
      const rama = (x0: number, y0: number, ang: number, l: number, prof: number, idx: number) => {
        if (prof <= 0 || l < 3) return;
        const x1 = x0 + Math.cos(ang) * l, y1 = y0 + Math.sin(ang) * l;
        c.strokeStyle = tinta(p.anillo, 0.22 + prof * 0.15);
        c.lineWidth = 0.4 + prof * 0.32;
        c.beginPath(); c.moveTo(x0, y0); c.lineTo(x1, y1); c.stroke();
        const d = 0.34 + s[(idx * 7) % 120] * 0.4;
        rama(x1, y1, ang - d, l * 0.68, prof - 1, idx + 1);
        rama(x1, y1, ang + d, l * 0.68, prof - 1, idx + 2);
      };
      for (let k = 0; k < brazos; k++) {
        rama(cx, cy, (k / brazos) * Math.PI * 2 + s[k] * 0.3, i === 1 ? 22 : 18, 4, k);
      }
      const nucleo = c.createRadialGradient(cx, cy, 0, cx, cy, 13);
      nucleo.addColorStop(0, tinta(p.anillo, 0.95 * pulso));
      nucleo.addColorStop(1, "rgba(0,0,0,0)");
      c.fillStyle = nucleo;
      c.beginPath(); c.arc(cx, cy, 13, 0, Math.PI * 2); c.fill();
    } else {
      for (const [rr, n, op] of [[44, 18, 0.28], [32, 14, 0.42], [22, 10, 0.58]] as const) {
        for (let k = 0; k < n; k++) {
          const a = (k / n) * Math.PI * 2;
          c.strokeStyle = tinta(p.anillo, op);
          c.lineWidth = 0.9;
          c.beginPath();
          c.ellipse(cx + Math.cos(a) * rr, cy + Math.sin(a) * rr, 8, 5, a, 0, Math.PI * 2);
          c.stroke();
        }
      }
      c.strokeStyle = tinta(p.anillo, 0.26);
      for (let k = 0; k < 12; k++) {
        const a = (k / 12) * Math.PI * 2;
        c.beginPath();
        c.moveTo(cx + Math.cos(a) * 12, cy + Math.sin(a) * 12);
        c.lineTo(cx + Math.cos(a + 2.1) * 52, cy + Math.sin(a + 2.1) * 52);
        c.stroke();
      }
      c.fillStyle = tinta("245,240,255", 0.95);
      c.beginPath(); c.arc(cx, cy, 2.6, 0, Math.PI * 2); c.fill();
    }

    /* onda: eje a 156 (medido: banda y447..482 con el eje al medio) y
       espejada, no apoyada en la base — la referencia es un
       oscilograma, no un histograma. La de ROOT COGNITION sí crece
       desde abajo: es la única de barras. */
    const o = ondas[i];
    const eje = 156, alto = 17, x0 = 6, ancho = S - 12;
    c.strokeStyle = tinta(p.onda, 0.22);
    c.lineWidth = 0.8;
    c.beginPath(); c.moveTo(x0, i === 2 ? eje + alto : eje); c.lineTo(x0 + ancho, i === 2 ? eje + alto : eje); c.stroke();
    for (let k = 0; k < o.length; k++) {
      const x = x0 + (k / o.length) * ancho;
      const h = o[k] * alto * (0.85 + 0.15 * Math.sin(fase * Math.PI * 2 + k * 0.3));
      c.strokeStyle = tinta(p.onda, 0.4 + o[k] * 0.55);
      c.lineWidth = i === 2 ? 3.2 : 1.3;
      c.beginPath();
      if (i === 2) { c.moveTo(x, eje + alto); c.lineTo(x, eje + alto - h * 1.9); }
      else { c.moveTo(x, eje - h); c.lineTo(x, eje + h); }
      c.stroke();
    }
  }

  /* ── el cuadro ────────────────────────────────────────────────────*/
  const pintar = (fase: number) => {
    g.clearRect(0, 0, W, H);
    g.drawImage(fondo, 0, 0);
    pintarEje(fase);
    pintarEstrella(fase);
    pintarOjo(fase);
    g.save();
    g.globalCompositeOperation = "lighter";
    for (const c of chispas) {
      const p = (fase + c.v) % 1;
      g.fillStyle = tinta(c.c, c.o * (0.4 + 0.6 * Math.sin(p * Math.PI)));
      g.beginPath(); g.arc(c.x, c.y, c.r, 0, Math.PI * 2); g.fill();
    }
    g.restore();
    minis.forEach((cv, i) => {
      const ctx = cv.getContext("2d");
      if (ctx) pintarMini(ctx, i, fase);
    });
  };

  montarLienzo({ raiz, cuadro: pintar, inicial: pintarFondo, periodo: 24000, periodoReducido: 60000 });
  montarEscala();
      montarMovil();

      import { montarVida } from "../../../lib/kodex/vida/montar";
      montarVida({ id: "mycelial-oracle" });
    </script>
