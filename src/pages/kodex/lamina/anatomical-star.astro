        <line x1="283" y1="1231" x2="292" y2="1231" class="a-linea-rosa" />
        <!-- columna de puntos (derecha) -->
        <g class="a-icono" transform="translate(737,1240)">
          <circle cx="0" cy="0" r="52" />
          {[-32, -16, 0, 16, 32].map((dy) => (
            <circle cx="0" cy={dy} r={dy === 0 ? 5 : 3.6} class="a-blanco" />
          ))}
        </g>
        <circle cx="825" cy="1231" r="7" class="a-rosa-aro" />
        <line x1="832" y1="1231" x2="841" y2="1231" class="a-linea-rosa" />
        <!-- texto del rito, transcrito -->
        <text x="561" y="1192" class="a-h">
          <tspan x="561" text-anchor="middle">RITUAL REMEMBRANCE</tspan>
        </text>
        {["BREATHE.", "FEEL.", "ALIGN.", "REMEMBER.", "TRANSMUTE.", "RADIATE."].map((w, i) => (
          <text x="561" y={1218 + i * 17} class="a-t" text-anchor="middle">{w}</text>
        ))}

        <!-- ── pie transcrito ──────────────────────────────────────────── -->
        <text x="80" y="1364" class="a-cap">KEEPER: <tspan class="a-t-rosa">YOU</tspan></text>
        <text x="561" y="1364" class="a-cap" text-anchor="middle">TYPE: LIVING CODEX</text>
        <text x="1042" y="1364" class="a-cap" text-anchor="end">STATUS: CONCEPT PLATE</text>
        <circle cx="561" cy="1345" r="2" class="a-rosa-pto" />
      </svg>
    </div>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px; height: 1402px;
        background: #020202;
        transform-origin: 0 0;
        font-family: var(--lam-display);
      }
      .a-titulo { fill: #efeeec; font-family: Georgia, "Times New Roman", serif; font-size: 96px; }
      .a-subtitulo { fill: #e8e6e3; font-family: Georgia, "Times New Roman", serif; font-size: 42px; letter-spacing: .3em; }
      .a-lema { fill: #c0798d; font-size: 14px; letter-spacing: .26em; }
      .a-cap { fill: #cfccc8; font-size: 14px; letter-spacing: .26em; }
      .a-h { fill: #dedcd8; font-size: 15px; letter-spacing: .22em; }
      .a-h-rosa { fill: #c0798d; font-size: 13px; letter-spacing: .18em; }
      .a-t { fill: #c9c6c2; font-size: 13px; letter-spacing: .16em; }
      .a-t-dim { fill: #8a8783; font-size: 12px; letter-spacing: .16em; }
      .a-t-rosa { fill: #c0798d; font-size: 13px; letter-spacing: .16em; }
      .a-t-esp { fill: #d3d1cd; font-size: 15px; letter-spacing: .3em; }
      .a-inf { fill: #d98ba0; font-size: 26px; }
      .a-inf-g { fill: #c76e86; font-size: 40px; }
      .a-marco { fill: none; stroke: #8f8c88; stroke-width: 1.1; }
      .a-tela { stroke: #9a9793; stroke-width: .8; opacity: .55; fill: none; }
      .a-linea { stroke: #6f6c68; stroke-width: 1; }
      .a-linea-rosa { stroke: #b06a80; stroke-width: 1.6; }
      .a-punteada { stroke: #cfccc8; stroke-width: 1; stroke-dasharray: 1.5 5; fill: none; }
      .a-caja { fill: none; stroke: #706d69; stroke-width: 1; }
      .a-icono { stroke: #c9c6c2; stroke-width: 1; fill: none; }
      .a-icono .a-blanco { fill: #efeeec; stroke: none; }
      .a-blanco { fill: #efeeec; stroke: none; }
      .a-rosa-pto { fill: #d98ba0; stroke: none; }
      .a-rosa-aro { fill: none; stroke: #b06a80; stroke-width: 1.4; }
      .a-rosa-marca { stroke: #c0798d; stroke-width: 1.3; fill: none; }
    </style>

    <script>
      import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
      import { montarEscala } from "../../../components/kodex/lamina/kit/escala";
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";
      import { rng } from "../../../components/kodex/lamina/kit/rng";
      import receta from "../../../../scripts/lamina/campo/pend-17.json";

      const fondo = document.getElementById("as-fondo") as HTMLCanvasElement;
      const vivo = document.getElementById("as-vivo") as HTMLCanvasElement;
      const raiz = document.querySelector("[data-lam]") as HTMLElement;
      const gf = fondo.getContext("2d")!;
      const gv = vivo.getContext("2d")!;

      /* Ejes medidos. */
      const EJE = 560;
      const rnd = rng(0xa57a);

      /* Los siete portales del eje, en las Y medidas, con radio según la masa
         de rosa medida (138,4,380,211,236,284,62). */
      const portales = [
        { y: 389, r: 10 },
        { y: 434, r: 4.5 },
        { y: 484, r: 14 },
        { y: 534, r: 11 },
        { y: 622, r: 12 },
        { y: 701, r: 13 },
        { y: 762, r: 12 },
      ];

      /* ── el cuerpo, decidido UNA vez ──────────────────────────────────
         Contorno simétrico por bezier con las medidas de la silueta:
         cabeza 340..445, hombros ~480..520, manos hasta x≈371/746 con
         palmas en y≈745, caderas y≈790, pies y≈1085. */
      type Traza = Array<[number, number] | [number, number, number, number, number, number]>;
      const mitadCuerpo: Traza = [
        [561, 340],
        [561 - 20, 340, 561 - 37, 358, 561 - 37, 392], // cráneo
        [561 - 37, 420, 561 - 28, 438, 561 - 14, 446], // mandíbula
        [561 - 13, 458, 561 - 15, 468, 561 - 22, 476], // cuello
        [561 - 48, 482, 561 - 76, 488, 561 - 92, 500], // hombro
        [561 - 108, 512, 561 - 126, 550, 561 - 143, 600], // brazo ext sup
        [561 - 158, 646, 561 - 174, 700, 561 - 186, 740], // antebrazo ext
        [561 - 190, 752, 561 - 187, 760, 561 - 179, 758], // mano ext
        [561 - 168, 752, 561 - 162, 742, 561 - 158, 730], // mano int
        [561 - 144, 682, 561 - 126, 628, 561 - 112, 586], // antebrazo int
        [561 - 100, 552, 561 - 90, 530, 561 - 82, 518], // axila
        [561 - 72, 548, 561 - 64, 608, 561 - 62, 660], // costado
        [561 - 62, 706, 561 - 65, 744, 561 - 70, 782], // cadera
        [561 - 68, 830, 561 - 60, 890, 561 - 54, 940], // muslo
        [561 - 50, 985, 561 - 44, 1030, 561 - 40, 1062], // pierna
        [561 - 40, 1074, 561 - 44, 1084, 561 - 52, 1087], // pie ext
        [561 - 36, 1089, 561 - 20, 1087, 561 - 17, 1080], // pie int
        [561 - 15, 1030, 561 - 13, 960, 561 - 14, 910], // pierna interior
        [561 - 15, 868, 561 - 10, 834, 561 - 2, 816], // entrepierna
        [561 - 2, 816, 561 - 1, 815, 561, 815],
      ];

      const trazar = (g: CanvasRenderingContext2D, t: Traza, esp: number) => {
        g.save();
        g.translate(EJE + esp * 1, 0);
        g.scale(esp, 1);
        g.beginPath();
        g.moveTo((t[0] as number[])[0] - 561, (t[0] as number[])[1]);
        for (let i = 1; i < t.length; i++) {
          const p = t[i] as number[];
          if (p.length === 2) g.lineTo(p[0] - 561, p[1]);
          else g.bezierCurveTo(p[0] - 561, p[1], p[2] - 561, p[3], p[4] - 561, p[5]);
        }
        g.stroke();
        g.restore();
      };

      /* Marcas medidas de la receta: vetas de luz del campo, donde están. */
      const marcas: Array<[number, number, number, number]> = [];
      for (let i = 0; i < receta.marcas.length; i += 4) {
        marcas.push([receta.marcas[i], receta.marcas[i + 1], receta.marcas[i + 2], receta.marcas[i + 3]]);
      }

      /* Filamentos del biocampo: nacen en los portales y se abren en abanico.
         Semilla fija — la misma nube en cada carga. */
      const filamentos = Array.from({ length: 330 }, () => {
        const p = portales[Math.floor(rnd() * portales.length)];
        const a = rnd() * Math.PI * 2;
        const alcance = 40 + rnd() * 190;
        return {
          x0: EJE, y0: p.y,
          x1: EJE + Math.cos(a) * alcance * 0.5, y1: p.y + Math.sin(a) * alcance * 0.5,
          x2: EJE + Math.cos(a) * alcance, y2: p.y + Math.sin(a) * alcance * 0.8,
          o: 0.05 + rnd() * 0.14,
        };
      });
      /* Polvo de estrellas del fondo, fijo. */
      const polvo = Array.from({ length: 340 }, () => ({
        x: 60 + rnd() * 1002, y: 220 + rnd() * 1090, r: rnd() < 0.9 ? 0.7 : 1.4, o: 0.15 + rnd() * 0.5,
      }));

      const pintarFondo = () => {
        gf.clearRect(0, 0, 1122, 1402);

        /* polvo */
        for (const p of polvo) {
          gf.fillStyle = tinta("225,223,220", p.o);
          gf.beginPath(); gf.arc(p.x, p.y, p.r, 0, Math.PI * 2); gf.fill();
        }

        /* anillos punteados medidos, centrados en (561,760) */
        gf.setLineDash([2, 7]);
        for (const r of receta.anillos_r) {
          gf.strokeStyle = tinta("210,208,205", r > 200 ? 0.22 : 0.14);
          gf.lineWidth = 1;
          gf.beginPath(); gf.arc(561, 760, r, 0, Math.PI * 2); gf.stroke();
        }
        gf.setLineDash([]);

        /* campo toroidal alrededor de cabeza y hombros: dos familias de
           lazos anidados que pasan junto al eje (corte de un toro), como
           en la referencia — los lóbulos llegan casi a los paneles */
        const CYT = 460;
        for (const s of [-1, 1]) {
          for (let k = 0; k < 8; k++) {
            const r = 34 + k * 26;
            gf.strokeStyle = tinta("216,214,211", 0.5 - k * 0.04);
            gf.lineWidth = 0.9;
            gf.beginPath();
            gf.ellipse(561 + s * (r + 8), CYT, r + k * 4, r * 0.88, s * 0.12, 0, Math.PI * 2);
            gf.stroke();
          }
          /* réplica punteada intercalada, gira apenas distinto */
          gf.setLineDash([1, 5]);
          for (let k = 0; k < 6; k++) {
            const r = 48 + k * 32;
            gf.strokeStyle = tinta("208,206,203", 0.36 - k * 0.04);
            gf.lineWidth = 0.8;
            gf.beginPath();
            gf.ellipse(561 + s * (r + 6), CYT + 6, r + k * 6, r * 0.8, s * -0.1, 0, Math.PI * 2);
            gf.stroke();
          }
          gf.setLineDash([]);
        }
        /* rayos finos que abren desde el cráneo */
        for (let k = 0; k < 22; k++) {
          const a = -Math.PI / 2 + (k / 21 - 0.5) * 2.4;
          gf.strokeStyle = tinta("214,212,209", 0.18);
          gf.lineWidth = 0.6;
          gf.beginPath();
          gf.moveTo(561 + Math.cos(a) * 52, 400 + Math.sin(a) * 52);
          gf.lineTo(561 + Math.cos(a) * (120 + (k % 3) * 34), 400 + Math.sin(a) * (120 + (k % 3) * 34));
          gf.stroke();
        }

        /* hexagrama punteado alrededor de la figura */
        gf.setLineDash([1.5, 6]);
        gf.strokeStyle = tinta("215,213,210", 0.4);
        gf.lineWidth = 1;
        const hex: Array<[number, number][]> = [
          [[561, 390], [327, 795], [795, 795]],
          [[561, 930], [327, 525], [795, 525]],
        ];
        for (const tri of hex) {
          gf.beginPath();
          gf.moveTo(tri[0][0], tri[0][1]);
          gf.lineTo(tri[1][0], tri[1][1]);
          gf.lineTo(tri[2][0], tri[2][1]);
          gf.closePath();
          gf.stroke();
          for (const [vx, vy] of tri) {
            gf.setLineDash([]);
            gf.fillStyle = tinta("236,234,232", 0.9);
            gf.beginPath(); gf.arc(vx, vy, 2.4, 0, Math.PI * 2); gf.fill();
            gf.setLineDash([1.5, 6]);
          }
        }
        gf.setLineDash([]);

        /* filamentos del biocampo */
        for (const f of filamentos) {
          gf.strokeStyle = tinta("222,220,217", f.o);
          gf.lineWidth = 0.7;
          gf.beginPath();
          gf.moveTo(f.x0, f.y0);
          gf.quadraticCurveTo(f.x1, f.y1, f.x2, f.y2);
          gf.stroke();
        }

        /* ── la figura ─────────────────────────────────────────────── */
        gf.strokeStyle = tinta("233,231,229", 0.85);
        gf.lineWidth = 1.5;
        trazar(gf, mitadCuerpo, -1);
        trazar(gf, mitadCuerpo, 1);
        /* eco suave del contorno */
        gf.strokeStyle = tinta("233,231,229", 0.22);
        gf.lineWidth = 4;
        trazar(gf, mitadCuerpo, -1);
        trazar(gf, mitadCuerpo, 1);

        /* columna */
        gf.strokeStyle = tinta("230,228,226", 0.75);
        gf.lineWidth = 1.2;
        gf.beginPath(); gf.moveTo(EJE, 452); gf.lineTo(EJE, 800); gf.stroke();
        for (let y = 458; y < 795; y += 12) {
          gf.beginPath(); gf.moveTo(EJE - 4, y); gf.lineTo(EJE + 4, y); gf.stroke();
        }

        /* lazos del campo alrededor del torso (detrás de las costillas) */
        for (let i = 0; i < 8; i++) {
          const cy = 540 + i * 20;
          const rx = 30 + i * 5 - (i > 5 ? (i - 5) * 8 : 0);
          gf.strokeStyle = tinta("228,226,224", 0.3 - i * 0.02);
          gf.lineWidth = 0.8;
          gf.beginPath();
          gf.ellipse(EJE, cy, rx, 13 + i * 1.5, 0, 0, Math.PI * 2);
          gf.stroke();
        }
        /* clavículas */
        gf.strokeStyle = tinta("228,226,224", 0.6);
        gf.beginPath(); gf.moveTo(EJE, 490); gf.quadraticCurveTo(EJE - 50, 480, EJE - 95, 498); gf.stroke();
        gf.beginPath(); gf.moveTo(EJE, 490); gf.quadraticCurveTo(EJE + 50, 480, EJE + 95, 498); gf.stroke();
        /* costillas: arcos individuales desde el esternón */
        gf.lineWidth = 0.9;
        for (let i = 0; i < 8; i++) {
          const y0 = 512 + i * 19;
          const ancho = 30 + i * 4 - (i > 5 ? (i - 5) * 9 : 0);
          for (const s of [-1, 1]) {
            gf.strokeStyle = tinta("230,228,226", 0.5);
            gf.beginPath();
            gf.moveTo(EJE + s * 5, y0);
            gf.bezierCurveTo(EJE + s * (ancho * 0.8), y0 - 8, EJE + s * (ancho + 16), y0 + 4, EJE + s * (ancho * 0.55), y0 + 20);
            gf.stroke();
          }
        }
        /* esternón */
        gf.strokeStyle = tinta("230,228,226", 0.55);
        gf.beginPath(); gf.moveTo(EJE, 505); gf.lineTo(EJE, 612); gf.stroke();
        /* huesos del brazo: húmero y antebrazo, línea doble */
        gf.lineWidth = 0.8;
        for (const s of [-1, 1]) {
          for (const d of [-2.5, 2.5]) {
            gf.strokeStyle = tinta("228,226,224", 0.45);
            gf.beginPath();
            gf.moveTo(EJE + s * (96 + d * 0.4), 512);
            gf.quadraticCurveTo(EJE + s * (112 + d), 565, EJE + s * (126 + d), 622);
            gf.stroke();
            gf.beginPath();
            gf.moveTo(EJE + s * (126 + d), 628);
            gf.quadraticCurveTo(EJE + s * (146 + d), 680, EJE + s * (164 + d * 0.5), 734);
            gf.stroke();
          }
          /* articulaciones */
          for (const [jx, jy] of [[96, 512], [126, 625], [165, 737]] as const) {
            gf.beginPath(); gf.arc(EJE + s * jx, jy, 3.5, 0, Math.PI * 2); gf.stroke();
          }
        }
        /* huesos de la pierna: fémur y tibia */
        for (const s of [-1, 1]) {
          for (const d of [-2.5, 2.5]) {
            gf.strokeStyle = tinta("228,226,224", 0.45);
            gf.beginPath();
            gf.moveTo(EJE + s * (40 + d), 802);
            gf.quadraticCurveTo(EJE + s * (46 + d), 875, EJE + s * (42 + d), 946);
            gf.stroke();
            gf.beginPath();
            gf.moveTo(EJE + s * (42 + d), 956);
            gf.quadraticCurveTo(EJE + s * (36 + d), 1010, EJE + s * (30 + d), 1068);
            gf.stroke();
          }
          for (const [jx, jy] of [[41, 950], [29, 1072]] as const) {
            gf.beginPath(); gf.arc(EJE + s * jx, jy, 3.2, 0, Math.PI * 2); gf.stroke();
          }
        }
        /* pelvis: alas ilíacas y sacro */
        gf.lineWidth = 1;
        for (const s of [-1, 1]) {
          gf.strokeStyle = tinta("228,226,224", 0.55);
          gf.beginPath();
          gf.ellipse(EJE + s * 34, 778, 30, 24, s * 0.35, 0, Math.PI * 2);
          gf.stroke();
          gf.beginPath();
          gf.ellipse(EJE + s * 30, 772, 16, 12, s * 0.35, 0, Math.PI * 2);
          gf.stroke();
        }
        gf.beginPath(); gf.moveTo(EJE - 9, 762); gf.lineTo(EJE + 9, 762); gf.lineTo(EJE, 796); gf.closePath(); gf.stroke();
        /* cráneo: bóveda interior y mandíbula */
        gf.strokeStyle = tinta("228,226,224", 0.4);
        gf.beginPath(); gf.ellipse(EJE, 392, 30, 44, 0, Math.PI * 0.9, Math.PI * 2.1); gf.stroke();
        gf.beginPath(); gf.ellipse(EJE - 14, 398, 9, 6, 0, 0, Math.PI * 2); gf.stroke();
        gf.beginPath(); gf.ellipse(EJE + 14, 398, 9, 6, 0, 0, Math.PI * 2); gf.stroke();
        gf.beginPath(); gf.moveTo(EJE - 20, 424); gf.quadraticCurveTo(EJE, 438, EJE + 20, 424); gf.stroke();
        /* dedos: abanico corto en cada mano */
        gf.strokeStyle = tinta("230,228,226", 0.6);
        gf.lineWidth = 1;
        for (const s of [-1, 1]) {
          for (let d = 0; d < 5; d++) {
            const a = Math.PI / 2 + s * (0.32 - d * 0.16);
            const mx = EJE + s * 174, my = 748;
            gf.beginPath();
            gf.moveTo(mx, my);
            gf.lineTo(mx + Math.cos(a) * 26 * s, my + Math.sin(a) * 26);
            gf.stroke();
          }
        }

        /* puntitos blancos del eje entre portales */
        for (const y of [352, 412, 460, 510, 580, 660, 732, 800, 843, 900, 950, 1000]) {
          gf.fillStyle = tinta("240,238,236", 0.85);
          gf.beginPath(); gf.arc(EJE, y, 2, 0, Math.PI * 2); gf.fill();
        }
        /* eje punteado sobre la cabeza y bajo la pelvis */
        gf.setLineDash([1.5, 6]);
        gf.strokeStyle = tinta("230,228,226", 0.5);
        gf.beginPath(); gf.moveTo(EJE, 286); gf.lineTo(EJE, 338); gf.stroke();
        gf.beginPath(); gf.moveTo(EJE, 810); gf.lineTo(EJE, 1080); gf.stroke();
        gf.setLineDash([]);

        /* marcas medidas: vetas de luz, exactamente donde la receta las tiene.
           No son nubes: son densificaciones locales del hilado — se pintan
           como manojos de hebras finas dentro de la caja medida. */
        for (const [x, y, w, h] of marcas) {
          const a = w >= h ? 0 : Math.PI / 2; // hebra a lo largo del lado mayor
          const largo = Math.max(w, h);
          const grosorCaja = Math.min(w, h);
          const n = Math.max(2, Math.round(largo / 13));
          for (let k = 0; k < n; k++) {
            const d = (k / Math.max(1, n - 1) - 0.5) * grosorCaja;
            const jl = 0.5 + rnd() * 0.5;
            const jc = (rnd() - 0.5) * largo * 0.3;
            gf.strokeStyle = tinta("236,232,232", 0.12 + rnd() * 0.1);
            gf.lineWidth = 0.7;
            gf.beginPath();
            gf.moveTo(x + jc - Math.cos(a) * (largo / 2) * jl + Math.sin(a) * d, y - Math.sin(a) * (largo / 2) * jl + Math.cos(a) * d);
            gf.lineTo(x + jc + Math.cos(a) * (largo / 2) * jl + Math.sin(a) * d, y + Math.sin(a) * (largo / 2) * jl + Math.cos(a) * d);
            gf.stroke();
          }
          gf.fillStyle = tinta("244,242,240", 0.6);
          gf.beginPath(); gf.arc(x, y, 1.1, 0, Math.PI * 2); gf.fill();
        }
      };

      /* ── los portales viven: brillo lento fase-continuo ─────────────── */
      const pintarVivo = (fase: number) => {
        gv.clearRect(0, 0, 1122, 1402);
        portales.forEach((p, i) => {
          const brillo = 0.82 + 0.18 * Math.cos((fase + i / 7) * Math.PI * 2);
          const R = p.r;
          /* halo rosado */
          const gr = gv.createRadialGradient(EJE, p.y, 0, EJE, p.y, R * 3.4);
          gr.addColorStop(0, tinta("244,210,217", 0.75 * brillo));
          gr.addColorStop(0.35, tinta("200,110,132", 0.32 * brillo));
          gr.addColorStop(1, tinta("160,70,95", 0));
          gv.fillStyle = gr;
          gv.beginPath(); gv.arc(EJE, p.y, R * 3.4, 0, Math.PI * 2); gv.fill();
          /* anillos concéntricos */
          gv.strokeStyle = tinta("214,140,160", 0.55 * brillo);
          gv.lineWidth = 1;
          gv.beginPath(); gv.arc(EJE, p.y, R * 1.5, 0, Math.PI * 2); gv.stroke();
          gv.strokeStyle = tinta("214,140,160", 0.3 * brillo);
          gv.beginPath(); gv.arc(EJE, p.y, R * 2.3, 0, Math.PI * 2); gv.stroke();
          /* rayos cortos */
          gv.strokeStyle = tinta("236,190,202", 0.4 * brillo);
          for (let k = 0; k < 8; k++) {
            const a = (k / 8) * Math.PI * 2 + i;
            gv.beginPath();
            gv.moveTo(EJE + Math.cos(a) * R * 1.8, p.y + Math.sin(a) * R * 1.8);
            gv.lineTo(EJE + Math.cos(a) * R * 2.9, p.y + Math.sin(a) * R * 2.9);
            gv.stroke();
          }
          /* núcleo blanco */
          gv.fillStyle = tinta("252,248,249", 0.95);
          gv.beginPath(); gv.arc(EJE, p.y, Math.max(2.2, R * 0.42), 0, Math.PI * 2); gv.fill();
        });
      };

      montarLienzo({
        raiz,
        inicial: pintarFondo,
        cuadro: pintarVivo,
        periodo: 22000,
        periodoReducido: 60000,
      });

      montarEscala();
      montarMovil();
    
      import { montarVida } from "../../../lib/kodex/vida/montar";
      montarVida({ id: "anatomical-star" });
    
      import { montarNavegacion } from "../../../components/kodex/lamina/kit/navegacion";
      montarNavegacion();
    
      import { montarTriptico } from "../../../components/kodex/lamina/kit/triptico";
      montarTriptico();
    </script>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>


    <!-- Tarjeta de cruce (costura 3): "cruzar al siguiente estrato" con
         progreso, del diseño del creador. Oculta al congelar (banco intacto). -->
    <a class="lam-siguiente" href="/kodex/lamina/heart-chamber/">NEXT PLATE · HEART CHAMBER → <i>01/25</i></a>
    <style>
      .lam-siguiente{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:9;
        font:11px ui-monospace,monospace;letter-spacing:.18em;color:rgba(240,237,232,.66);
        text-decoration:none;padding:11px 16px;background:rgba(0,0,0,.5);
        border:1px solid rgba(240,237,232,.16);white-space:nowrap;max-width:92vw;overflow:hidden;text-overflow:ellipsis;}
      .lam-siguiente i{font-style:normal;color:rgba(240,237,232,.38);margin-left:10px}
      .lam-siguiente:hover{color:#fff;border-color:rgba(240,237,232,.45)}
      html[data-kdx-frozen] .lam-siguiente{display:none}
    </style>
  </body>
</html>
