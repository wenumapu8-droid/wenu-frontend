              {i < 5
                ? Array.from({ length: 12 - i * 2 }, (_, k) => {
                    const a = (k / (12 - i * 2)) * Math.PI * 2;
                    return <circle cx={Math.cos(a) * 12} cy={Math.sin(a) * 12} r="4.6" opacity=".55" />;
                  })
                : null}
              {i === 1 ? <circle cx="0" cy="0" r="3.4" /> : null}
              {i === 3 || i === 4 || i === 5 ? <path d="M0 -13 L11.2 6.5 L-11.2 6.5 Z" opacity=".8" /> : null}
              {i === 3 || i === 6 ? <path d="M0 13 L11.2 -6.5 L-11.2 -6.5 Z" opacity=".8" /> : null}
            </g>
            <text x="147" y={p.fila + 4} class="a-t-rosa">{p.n}</text>
            <text x="176" y={p.fila + 4} class="a-t">{p.nombre}</text>
            <text x="176" y={p.fila + 22} class="a-t-dim">{p.sub}</text>
          </g>
        ))}
        <line x1="70" y1="952" x2="290" y2="952" class="a-linea" />

        <!-- ── panel izquierdo: BIOFIELD TOPOLOGY ──────────────────────── -->
        <text x="157" y="986" class="a-h" text-anchor="middle">BIOFIELD TOPOLOGY</text>
        <g class="a-icono" transform="translate(157,1072)">
          {Array.from({ length: 7 }, (_, k) => (
            <ellipse cx="0" cy="0" rx={80 - k * 11} ry={58 - k * 4} opacity={0.55 - k * 0.05} />
          ))}
          {Array.from({ length: 6 }, (_, k) => (
            <ellipse cx="0" cy="0" rx={16 + k * 11} ry="55" opacity=".35" transform={`rotate(${-24 + k * 10})`} />
          ))}
          <line x1="0" y1="-70" x2="0" y2="70" class="a-punteada" />
          <circle cx="0" cy="-30" r="4" class="a-blanco" />
          <circle cx="0" cy="0" r="4" class="a-blanco" />
          <circle cx="0" cy="30" r="4" class="a-blanco" />
        </g>
        <text x="157" y="1167" class="a-t" text-anchor="middle">THE TORUS IS THE BRIDGE</text>
        <text x="157" y="1189" class="a-t" text-anchor="middle">BETWEEN THE FINITE</text>
        <text x="157" y="1211" class="a-t" text-anchor="middle">AND THE INFINITE.</text>

        <!-- ── panel derecho: THE STAR WITHIN ──────────────────────────── -->
        <text x="952" y="251" class="a-h" text-anchor="middle">THE STAR WITHIN</text>
        <text x="952" y="274" class="a-h-rosa" text-anchor="middle">MICRO AS MACRO</text>
        <line x1="941" y1="290" x2="963" y2="290" class="a-linea-rosa" />
        <text x="952" y="320" class="a-t" text-anchor="middle">AS ABOVE</text>
        <text x="952" y="340" class="a-t" text-anchor="middle">SO WITHIN</text>
        <circle cx="952" cy="360" r="2.6" class="a-rosa-pto" />
        <text x="952" y="385" class="a-t" text-anchor="middle">AS WITHIN</text>
        <text x="952" y="405" class="a-t" text-anchor="middle">SO WITHOUT</text>
        <circle cx="952" cy="426" r="2.6" class="a-rosa-pto" />
