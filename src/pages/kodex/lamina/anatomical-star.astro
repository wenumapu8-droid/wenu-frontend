        <!-- ── panel izquierdo: ANATOMY ────────────────────────────────── -->
        <text x="161" y="250" class="a-h" text-anchor="middle">ANATOMY</text>
        <text x="161" y="273" class="a-h-rosa" text-anchor="middle">AS COSMIC INTERFACE</text>
        <line x1="150" y1="289" x2="172" y2="289" class="a-linea-rosa" />
        {anatomia.map(([izq, der], i) => (
          <g>
            <text x="80" y={315 + i * 19} class="a-t">{izq}</text>
            <text x="160" y={315 + i * 19} class="a-t-dim">//</text>
            <text x="180" y={315 + i * 19} class="a-t">{der}</text>
          </g>
        ))}
        <!-- glifo medido en (158,470): círculo sobre cruz -->
        <g class="a-icono" transform="translate(158,462)">
          <circle cx="0" cy="-6" r="8" />
          <line x1="0" y1="2" x2="0" y2="18" />
          <line x1="-6" y1="10" x2="6" y2="10" />
        </g>

        <!-- ── panel izquierdo: THE SEVEN PORTALS ──────────────────────── -->
        <text x="82" y="542" class="a-h">THE SEVEN PORTALS</text>
        {portales.map((p, i) => (
          <g>
            <g class="a-icono" transform={`translate(104,${p.fila})`}>
              <circle cx="0" cy="0" r="17" />
