---
/**
 * KODEX-∞ · ANATOMICAL STAR
 *
 * Reproducción en código de `reference/pendientes/anatomical-star.png`
 * (alias de pend-17.png, 1122×1402). La plancha se nombra sola bajo el
 * título: "ANATOMICAL STAR".
 *
 * MEDIDO de la referencia:
 *   · fondo rgb(2,2,2); blanco de línea promedio rgb(189,186,186);
 *     rosa de núcleo de portal rgb(244,210,217); rosa de texto ~rgb(111,68,79)
 *     de promedio antialiasado — se usa #c0798d;
 *   · figura: cabeza y=340..445 (medio ancho ~37), hombros y≈480..520
 *     (medio ancho ~105), manos hasta x=371..746 con palmas en y≈720..780,
 *     caderas y≈790, pies y≈1085; eje en x=560;
 *   · SIETE portales del eje en y = 389, 434, 484, 534, 622, 701, 762
 *     (masa de rosa medida: 138, 4, 380, 211, 236, 284, 62);
 *   · anillos punteados centrados en (561,760) a r = 18..366 (receta);
 *   · glifos y marcas de la receta pend-17.json en coordenadas exactas:
 *     las marcas son los regueros brillantes del campo (halo, costillar,
 *     piernas) y van DONDE ESTÁN, pintadas como vetas de luz en el canvas.
 *
 * Todo el copy está transcrito con zoom de los recortes; lo ilegible
 * (el glifo rosado bajo el lema, la cruz rosada bajo HUMAN·STAR·KODEX)
 * va como marca mínima no-textual.
 */
import "../../../styles/kodex-lamina.css";
import receta from "../../../../scripts/lamina/campo/pend-17.json";

const marcas: Array<[number, number, number, number]> = [];
for (let i = 0; i < receta.marcas.length; i += 4) {
  marcas.push([receta.marcas[i], receta.marcas[i + 1], receta.marcas[i + 2], receta.marcas[i + 3]]);
}

/* Los siete portales, transcritos de la columna izquierda. */
const portales = [
  { n: "01", nombre: "CROWN", sub: "∞ / 7", fila: 582 },
  { n: "02", nombre: "THIRD EYE", sub: "∞ / 6", fila: 631 },
  { n: "03", nombre: "THROAT", sub: "∞ / 5", fila: 685 },
  { n: "04", nombre: "HEART", sub: "∞ / 4", fila: 738 },
  { n: "05", nombre: "SOLAR", sub: "∞ / 3", fila: 791 },
  { n: "06", nombre: "SACRAL", sub: "∞ / 2", fila: 842 },
  { n: "07", nombre: "ROOT", sub: "∞ / 1", fila: 895 },
];

/* Anatomía como interfaz cósmica — tabla transcrita. */
const anatomia = [
  ["SKELETON", "STRUCTURE"],
  ["NERVES", "SIGNAL"],
  ["VESSELS", "FLOW"],
  ["GLANDS", "ALCHEMY"],
  ["ORGANS", "FUNCTIONS"],
  ["FASCIA", "MEMORY"],
  ["ENERGY", "INTENT"],
];

/* Geometría del ser — cuatro estaciones de la columna derecha. */
const geometria = [
  { y: 595, l1: "THE POINT", l2: "UNITY" },
  { y: 695, l1: "THE CIRCLE", l2: "POTENTIAL" },
  { y: 792, l1: "THE VESICA", l2: "CREATION" },
  { y: 910, l1: "THE STAR", l2: "MANIFESTATION" },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · ANATOMICAL STAR</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="anatomical-star">
      <canvas id="as-fondo" width="1122" height="1402" style="position:absolute;inset:0;"></canvas>
      <canvas id="as-vivo" width="1122" height="1402" style="position:absolute;inset:0;"></canvas>

      <svg viewBox="0 0 1122 1402" style="position:absolute;inset:0;" aria-hidden="true">
        <!-- ── marco doble con adornos de tela en las esquinas ─────────── -->
        <rect x="22" y="28" width="1078" height="1346" class="a-marco" />
        <rect x="48" y="54" width="1026" height="1294" class="a-marco" opacity=".7" />
        <circle cx="561" cy="28" r="6" class="a-marco" fill="#020202" />
        <circle cx="561" cy="1374" r="6" class="a-marco" fill="#020202" />
        {[[22, 28, 1, 1], [1100, 28, -1, 1], [22, 1374, 1, -1], [1100, 1374, -1, -1]].map(([x, y, sx, sy]) => (
          <g transform={`translate(${x},${y}) scale(${sx},${sy})`} class="a-tela">
