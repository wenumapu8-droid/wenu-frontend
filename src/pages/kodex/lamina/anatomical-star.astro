          <circle cx="0" cy="0" r="30" />
          <circle cx="0" cy="0" r="3" class="a-blanco" />
          <line x1="0" y1="3" x2="0" y2="30" class="a-punteada" />
        </g>
        <circle cx="919" cy="645" r="2.6" class="a-rosa-pto" />
        <!-- el círculo -->
        <g class="a-icono" transform="translate(919,695)">
          <circle cx="0" cy="0" r="32" />
          <circle cx="0" cy="-13" r="15" opacity=".8" />
          <circle cx="0" cy="13" r="15" opacity=".8" />
          <line x1="0" y1="-32" x2="0" y2="32" class="a-punteada" />
        </g>
        <circle cx="919" cy="746" r="2.6" class="a-rosa-pto" />
        <!-- la vesica -->
        <g class="a-icono" transform="translate(919,792)">
          <circle cx="0" cy="-12" r="20" />
          <circle cx="0" cy="12" r="20" />
          <circle cx="0" cy="0" r="33" opacity=".55" />
          <line x1="0" y1="-33" x2="0" y2="33" class="a-punteada" />
        </g>
        <circle cx="919" cy="846" r="2.6" class="a-rosa-pto" />
        <!-- la estrella: cubo de metatrón -->
        <g class="a-icono" transform="translate(919,910)">
          {Array.from({ length: 6 }, (_, k) => {
            const a = (k / 6) * Math.PI * 2 - Math.PI / 2;
            return <circle cx={Math.cos(a) * 30} cy={Math.sin(a) * 30} r="9" opacity=".8" />;
          })}
          <circle cx="0" cy="0" r="9" opacity=".8" />
          {Array.from({ length: 6 }, (_, k) => {
            const a = (k / 6) * Math.PI * 2 - Math.PI / 2;
            const b = ((k + 2) / 6) * Math.PI * 2 - Math.PI / 2;
            return (
              <g opacity=".5">
                <line x1={Math.cos(a) * 30} y1={Math.sin(a) * 30} x2={Math.cos(b) * 30} y2={Math.sin(b) * 30} />
                <line x1="0" y1="0" x2={Math.cos(a) * 30} y2={Math.sin(a) * 30} />
              </g>
            );
          })}
          <circle cx="0" cy="0" r="2.6" class="a-rosa-pto" />
        </g>
        {geometria.map((g2) => (
          <g>
            <text x="975" y={g2.y - 2} class="a-t">{g2.l1}</text>
            <text x="975" y={g2.y + 18} class="a-t">{g2.l2}</text>
          </g>
        ))}

        <!-- ── panel derecho: KODEX-∞ AXIOM ────────────────────────────── -->
        <line x1="860" y1="1015" x2="1044" y2="1015" class="a-linea" />
        <text x="952" y="1055" class="a-h" text-anchor="middle">KODEX-∞ AXIOM</text>
        <text x="952" y="1090" class="a-t" text-anchor="middle">YOU ARE NOT IN THE UNIVERSE.</text>
        <text x="952" y="1112" class="a-t" text-anchor="middle">THE UNIVERSE IS IN YOU.</text>
        <line x1="941" y1="1134" x2="963" y2="1134" class="a-linea-rosa" />
        <text x="952" y="1172" class="a-inf-g" text-anchor="middle">∞</text>

        <!-- ── faja inferior ───────────────────────────────────────────── -->
        <g class="a-t-esp">
          <text x="466" y="1118" text-anchor="middle">HUMAN</text>
          <circle cx="513" cy="1113" r="2.4" class="a-rosa-pto" />
          <text x="556" y="1118" text-anchor="middle">STAR</text>
          <circle cx="598" cy="1113" r="2.4" class="a-rosa-pto" />
          <text x="648" y="1118" text-anchor="middle">KODEX</text>
        </g>
        <!-- cruz rosada medida bajo la faja (559,1130): marca, no texto -->
        <path class="a-rosa-marca" d="M554 1124 l10 12 M564 1124 l-10 12" />

        <!-- cajas del rito -->
        <rect x="302" y="1160" width="158" height="162" class="a-caja" />
        <rect x="460" y="1160" width="204" height="162" class="a-caja" />
        <rect x="664" y="1160" width="158" height="162" class="a-caja" />
        <!-- vesica-ojo (marca medida 382,1234,22,78) -->
        <g class="a-icono" transform="translate(381,1240)">
          <circle cx="0" cy="0" r="52" />
          <path d="M0 -40 C 12 -24, 12 -8, 0 8 C -12 -8, -12 -24, 0 -40 Z" opacity=".85" />
          <path d="M0 -16 C 9 -4, 9 12, 0 24 C -9 12, -9 -4, 0 -16 Z" opacity=".65" />
          <path d="M0 8 C 7 18, 7 28, 0 38 C -7 28, -7 18, 0 8 Z" opacity=".5" />
        </g>
