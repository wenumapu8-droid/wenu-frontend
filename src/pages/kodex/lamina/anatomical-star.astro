          </g>
        ))}

        <!-- ── cabecera transcrita ─────────────────────────────────────── -->
        <text x="70" y="70" class="a-cap">UNIVERSAL ARCHIVE</text>
        <text x="1052" y="70" class="a-cap" text-anchor="end">PLATE ∞.07</text>
        <line x1="80" y1="100" x2="466" y2="100" class="a-linea" />
        <line x1="656" y1="100" x2="1042" y2="100" class="a-linea" />
        <text x="561" y="110" class="a-inf" text-anchor="middle">∞</text>

        <!-- ── título ──────────────────────────────────────────────────── -->
        <text x="561" y="168" class="a-titulo" text-anchor="middle" textLength="580">KODEX-∞</text>
        <line x1="300" y1="192" x2="548" y2="192" class="a-linea" />
        <line x1="574" y1="192" x2="822" y2="192" class="a-linea" />
        <circle cx="561" cy="192" r="3" class="a-rosa-pto" />
        <text x="561" y="238" class="a-subtitulo" text-anchor="middle" textLength="466">ANATOMICAL STAR</text>
        <text x="561" y="256" class="a-lema" text-anchor="middle">THE BODY IS A MAP. THE STAR IS WITHIN.</text>
        <!-- glifo rosado medido en (560,275): marca mínima, no texto -->
