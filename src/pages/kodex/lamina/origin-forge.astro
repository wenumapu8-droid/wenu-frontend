  }
  .of-paso { display: grid; grid-template-columns: 116px 1fr; align-items: center; color: var(--arch-ink); }
  .of-paso__icono { position: relative; display: flex; justify-content: center; }
  .of-paso__texto p, .of-paso__texto h3 { margin: 0; }
  .of-paso__n { font-size: 21px; letter-spacing: 0.18em; color: #d8bd85; }
  .of-paso__titulo {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.35;
    color: #e6e2d4;
    margin-top: 3px !important;
  }
  .of-paso__desc { font-size: 13px; line-height: 1.35; color: #b3b1a5; margin-top: 5px !important; padding-right: 4px; }
  .of-ciclo { text-align: center; color: var(--arch-ink); }
  .of-ciclo__texto { margin: 6px 0 4px; font-size: 11px; font-weight: 600; letter-spacing: 0.18em; line-height: 2; color: #ddd5c2; white-space: nowrap; }
  .of-ciclo__inf { font-family: Georgia, serif; font-size: 26px; fill: #e8dfc8; }

  /* ── el organismo ─────────────────────────────────────────────── */
  .of-caja--forja { top: 298px; left: 264px; width: 704px; height: 1092px; }

  /* ── riel derecho x969..1195 ──────────────────────────────────── */
  .of-panel { left: 969px; }
  .of-panel--1 { top: 301px; height: 343px; }
  .of-panel--2 { top: 656px; height: 194px; }
  .of-panel--3 { top: 860px; height: 254px; }
  .of-panel--4 { top: 1123px; height: 272px; }
  .of-panel > :global(.arch-riel) {
    height: 100%;
    border-color: rgba(169, 141, 84, 0.45);
    padding: 10px 8px 8px;
    justify-content: flex-start;
  }
  .of-panel :global(.arch-riel > * + *) { margin-top: 4px; padding-top: 6px; }
  .of-panel--1 :global(.arch-riel > * + *)::before { background: rgba(169, 141, 84, 0.3); }
  .of-panel--2 :global(.arch-riel > * + *)::before,
  .of-panel--3 :global(.arch-riel > * + *)::before,
  .of-panel--4 :global(.arch-riel > * + *)::before { background: transparent; }
  /* la referencia pone el VALOR antes del diagrama: se reordena */
  .of-panel :global(.arch-tarjeta__en) { order: 1; font-size: 13.5px; letter-spacing: 0.26em; color: #e6ddc8; }
  .of-panel :global(.arch-tarjeta__es) { order: 2; display: none; }
  .of-panel :global(.arch-tarjeta__valor) { order: 3; font-size: 33px; color: #eedcb4; margin-top: 4px; }
  .of-panel :global(.arch-tarjeta__etiqueta) { order: 4; font-size: 10.5px; letter-spacing: 0.3em; color: #b9a06a; margin-top: 4px; }
  .of-panel :global(.arch-tarjeta__diagrama) { order: 5; margin-top: 8px; }
  .of-gauge-num { font-family: "Cormorant Garamond", Georgia, serif; font-size: 11.5px; fill: #cfc5ab; letter-spacing: 0.1em; }
  .of-status { margin: 2px 0 0; text-align: center; font-size: 12.5px; font-weight: 600; letter-spacing: 0.24em; color: #cfc5ab; }
  .of-status em { font-style: normal; color: #8f72d8; }
  .of-riel-titulo--notas { font-size: 14.5px; letter-spacing: 0.2em; }
  .of-notas { list-style: none; margin: 3px 0 0; padding: 0 2px; color: var(--arch-ink); }
  .of-notas li { display: grid; grid-template-columns: 15px 1fr; gap: 5px; align-items: start; margin-top: 7px; }
  .of-notas li svg { margin-top: 1px; }
  .of-notas p { margin: 0; font-size: 10px; font-weight: 600; letter-spacing: 0.14em; line-height: 1.45; color: #cdc6b4; }
  .of-honra { margin: 9px 0 0; text-align: center; font-size: 10.5px; font-weight: 600; letter-spacing: 0.18em; line-height: 1.75; color: #9a7fd0; }
  .of-rosa { align-self: center; margin-top: 4px; width: 54px; height: 54px; }

  /* ── pie ──────────────────────────────────────────────────────── */
  .of-caja--pie { left: 40px; right: 40px; bottom: 16px; }
  /* la referencia pone el aforismo ARRIBA de la regla con emblema */
  .of-caja--pie :global(.arch-pie) { display: flex; flex-direction: column; }
  .of-caja--pie :global(.arch-pie__aforismo) { order: 1; }
  .of-caja--pie :global(.arch-pie__regla) { order: 2; margin-top: 6px; color: #b9a06a; }
  .of-caja--pie :global(.arch-pie__verso) { font-size: 13px; letter-spacing: 0.3em; line-height: 1.9; }
  .of-caja--pie :global(.arch-pie__acento) { color: #a689d0; }
  .of-caja--pie :global(.arch-pie__rotulo) { bottom: 2px; }
  .of-caja--pie :global(.arch-pie__rotulo p:first-child) { font-size: 17px; letter-spacing: 0.3em; color: #e6ddc8; }
  .of-caja--pie :global(.arch-pie__rotulo p:last-child) { font-size: 9.5px; letter-spacing: 0.24em; color: #b9a06a; }
  .of-glifos { position: absolute; bottom: 12px; }
  .of-glifos--izq { left: 300px; }
  .of-glifos--der { right: 300px; }
  .arch-marco > :global(.arch-sello) { position: absolute; right: 130px; bottom: 34px; }
  .arch-marco > :global(.arch-sello .arch-sello__codigo) { font-size: 11px; letter-spacing: 0.24em; }
  .arch-marco > :global(.arch-sello .arch-sello__clasif) { font-size: 10px; letter-spacing: 0.2em; }
  .of-sello-inf { position: absolute; right: 30px; bottom: 18px; }
  .of-sello-inf__inf { font-family: Georgia, serif; font-size: 30px; fill: #d8bd85; }
</style>

<script>
  import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
  import { rng } from "../../../components/kodex/lamina/kit/rng";
  import { montarEscala } from "../../../components/kodex/lamina/kit/escala";

  const raiz = document.querySelector("[data-lam]") as HTMLElement;

  /* ══ ICONOS DEL PROCESO (estáticos, semilla fija) ═══════════════ */
  const icono = (id: string, pintarIcono: (g: CanvasRenderingContext2D, r: () => number) => void, semilla: number) => {
    const c = document.getElementById(id) as HTMLCanvasElement;
    const g = c.getContext("2d")!;
    g.fillStyle = "#060403";
    g.fillRect(0, 0, 104, 104);
    /* aro exterior común a los cinco */
    g.strokeStyle = tinta("169,141,84", 0.55);
    g.lineWidth = 1;
    g.beginPath(); g.arc(52, 52, 49, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("169,141,84", 0.3);
    g.beginPath(); g.arc(52, 52, 44, 0, Math.PI * 2); g.stroke();
    g.save();
    g.beginPath(); g.arc(52, 52, 43, 0, Math.PI * 2); g.clip();
    pintarIcono(g, rng(semilla));
    g.restore();
  };

  /* 01 · voluta de caos violeta */
  icono("of-p1", (g, r) => {
    const halo = g.createRadialGradient(52, 54, 4, 52, 54, 42);
    halo.addColorStop(0, tinta("150,120,220", 0.5));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo; g.fillRect(0, 0, 104, 104);
    for (let k = 0; k < 46; k++) {
      const a = r() * Math.PI * 2, l = 10 + r() * 30;
      const cu = (r() - 0.5) * 30;
      g.strokeStyle = tinta(r() < 0.72 ? "170,140,235" : "235,225,250", 0.15 + r() * 0.5);
      g.lineWidth = 0.7 + r() * 0.8;
      g.beginPath();
      g.moveTo(52 + Math.cos(a) * 4, 54 + Math.sin(a) * 4);
      g.quadraticCurveTo(52 + Math.cos(a) * l * 0.6 + cu, 54 + Math.sin(a) * l * 0.6, 52 + Math.cos(a) * l, 54 + Math.sin(a) * l);
      g.stroke();
    }
    g.fillStyle = tinta("245,240,255", 0.9);
    g.beginPath(); g.arc(52, 54, 2.4, 0, Math.PI * 2); g.fill();
  }, 0x2211);

  /* 02 · crisol vertiendo oro */
  icono("of-p2", (g, r) => {
    const halo = g.createRadialGradient(52, 50, 4, 52, 50, 44);
    halo.addColorStop(0, tinta("240,176,80", 0.55));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo; g.fillRect(0, 0, 104, 104);
    g.strokeStyle = tinta("255,225,160", 0.95); g.lineWidth = 3.4;
    g.beginPath(); g.ellipse(52, 38, 22, 11, 0, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("240,176,80", 0.5); g.lineWidth = 6;
    g.beginPath(); g.ellipse(52, 38, 22, 11, 0, 0, Math.PI * 2); g.stroke();
    const chorro = g.createLinearGradient(0, 46, 0, 82);
    chorro.addColorStop(0, tinta("255,240,200", 0.95));
    chorro.addColorStop(1, tinta("240,176,80", 0.75));
    g.fillStyle = chorro;
    g.beginPath();
    g.moveTo(48, 44); g.quadraticCurveTo(50, 62, 49, 80);
    g.lineTo(55, 80); g.quadraticCurveTo(54, 62, 56, 44);
    g.closePath(); g.fill();
    g.fillStyle = tinta("255,232,175", 0.9);
    g.beginPath(); g.ellipse(52, 82, 15, 5, 0, 0, Math.PI * 2); g.fill();
    for (let k = 0; k < 14; k++) {
      g.fillStyle = tinta("255,220,150", 0.4 + r() * 0.5);
      g.beginPath(); g.arc(30 + r() * 44, 30 + r() * 55, 0.8 + r(), 0, Math.PI * 2); g.fill();
    }
  }, 0x2212);

  /* 03 · retícula geométrica (molde) */
  icono("of-p3", (g, r) => {
    const halo = g.createRadialGradient(52, 52, 2, 52, 52, 40);
    halo.addColorStop(0, tinta("240,205,140", 0.3));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo; g.fillRect(0, 0, 104, 104);
    const v: Array<[number, number]> = [];
    for (let k = 0; k < 6; k++) {
      const a = (k / 6) * Math.PI * 2 - Math.PI / 2;
      v.push([52 + Math.cos(a) * 34, 52 + Math.sin(a) * 34]);
    }
    g.strokeStyle = tinta("235,215,175", 0.75); g.lineWidth = 0.8;
    for (let i = 0; i < 6; i++) for (let j = i + 1; j < 6; j++) {
      g.beginPath(); g.moveTo(v[i][0], v[i][1]); g.lineTo(v[j][0], v[j][1]); g.stroke();
    }
    g.strokeStyle = tinta("235,215,175", 0.55);
    g.beginPath(); g.arc(52, 52, 34, 0, Math.PI * 2); g.stroke();
    g.beginPath(); g.arc(52, 52, 17, 0, Math.PI * 2); g.stroke();
    for (const [x, y] of v) { g.beginPath(); g.arc(x, y, 2, 0, Math.PI * 2); g.stroke(); }
    g.fillStyle = tinta("255,245,220", 0.9);
    g.beginPath(); g.arc(52, 52, 1.8, 0, Math.PI * 2); g.fill();
    void r;
  }, 0x2213);

  /* 04 · telaraña estelar del temple */
  icono("of-p4", (g, r) => {
    const halo = g.createRadialGradient(52, 52, 2, 52, 52, 42);
    halo.addColorStop(0, tinta("255,230,170", 0.65));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo; g.fillRect(0, 0, 104, 104);
    g.strokeStyle = tinta("240,205,140", 0.55); g.lineWidth = 0.7;
    for (const rr of [12, 21, 30, 38]) { g.beginPath(); g.arc(52, 52, rr, 0, Math.PI * 2); g.stroke(); }
    for (let k = 0; k < 12; k++) {
      const a = (k / 12) * Math.PI * 2;
      g.beginPath(); g.moveTo(52, 52);
      g.lineTo(52 + Math.cos(a) * 40, 52 + Math.sin(a) * 40); g.stroke();
    }
    g.fillStyle = tinta("255,248,230", 0.95);
    g.beginPath();
    g.moveTo(52, 34); g.quadraticCurveTo(55, 49, 70, 52); g.quadraticCurveTo(55, 55, 52, 70);
    g.quadraticCurveTo(49, 55, 34, 52); g.quadraticCurveTo(49, 49, 52, 34);
    g.fill();
    void r;
  }, 0x2214);

  /* 05 · faro de emisión sobre el anillo */
  icono("of-p5", (g, r) => {
    const halo = g.createRadialGradient(52, 60, 4, 52, 60, 44);
    halo.addColorStop(0, tinta("240,176,80", 0.5));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo; g.fillRect(0, 0, 104, 104);
    g.strokeStyle = tinta("240,205,140", 0.6);
    g.beginPath(); g.ellipse(52, 76, 26, 8, 0, 0, Math.PI * 2); g.stroke();
    g.fillStyle = tinta("20,14,8", 0.95);
    for (const dx of [-18, -8, 8, 18]) g.fillRect(52 + dx - 3, 62, 6, 13);
    g.strokeStyle = tinta("240,176,80", 0.5);
    for (const dx of [-18, -8, 8, 18]) g.strokeRect(52 + dx - 3, 62, 6, 13);
    const haz = g.createLinearGradient(0, 18, 0, 74);
    haz.addColorStop(0, tinta("255,245,215", 0.9));
    haz.addColorStop(1, tinta("240,176,80", 0.55));
    g.fillStyle = haz;
    g.beginPath(); g.moveTo(49, 74); g.lineTo(50.5, 18); g.lineTo(53.5, 18); g.lineTo(55, 74); g.closePath(); g.fill();
    g.strokeStyle = tinta("255,240,200", 0.8); g.lineWidth = 1;
    g.beginPath(); g.moveTo(40, 34); g.lineTo(64, 34); g.stroke();
    for (let k = 0; k < 10; k++) {
      g.fillStyle = tinta("255,220,150", 0.4 + r() * 0.5);
      g.beginPath(); g.arc(32 + r() * 40, 24 + r() * 50, 0.8 + r(), 0, Math.PI * 2); g.fill();
    }
  }, 0x2215);

  /* ══ EL ORGANISMO: LA FORJA ═════════════════════════════════════ */
  const canvas = document.getElementById("of-forja") as HTMLCanvasElement;
  const g = canvas.getContext("2d")!;
  const rnd = rng(0x0f22);
  const W = 704, H = 1092, CX = 351;

  /* chispas fijas con fase propia (derivan hacia arriba y titilan) */
  const chispas = Array.from({ length: 230 }, () => ({
    x: CX + (rnd() - 0.5) * (rnd() < 0.7 ? 320 : 620),
    y: 40 + rnd() * 1000,
    r: 0.5 + rnd() * 1.3,
    o: 0.15 + rnd() * 0.6,
    v: rnd(),
  }));

  /* grano ambiente cálido (textura del fondo, fijo) */
  const grano: Array<{ x: number; y: number; s: number; o: number; c: string }> = [];
  for (let k = 0; k < 9500; k++) {
    const x = rnd() * W, y = rnd() * H;
    const centro = Math.abs(x - CX) < 220;
    grano.push({
      x, y, s: 0.7 + rnd() * 1.3,
      o: (centro ? 0.16 : 0.08) + rnd() * (centro ? 0.3 : 0.16),
      c: rnd() < 0.16 ? "150,120,200" : rnd() < 0.6 ? "190,140,75" : "130,95,62",
    });
  }

  /* cadenas verticales: x, largo, con eslabones */
  const cadenas = [72, 130, 210, 285, 420, 494, 566, 636].map((x) => ({
    x, y1: 6, y2: 120 + rnd() * 380, esl: 8 + Math.floor(rnd() * 6),
  }));

  /* llamaradas del poliedro (estrías radiales fijas, flicker por fase) */
  const llamas = Array.from({ length: 110 }, () => ({
    a: -Math.PI / 2 + (rnd() - 0.5) * 3.4,
    l: 46 + rnd() * 120,
    o: 0.18 + rnd() * 0.5,
    w: 1 + rnd() * 2.8,
    v: rnd(),
  }));

  const pintar = (fase: number) => {
    const luz = 0.88 + 0.12 * Math.cos(fase * Math.PI * 2);
    g.clearRect(0, 0, W, H);

    /* fondo cálido oscuro + ambientes */
    const fondo = g.createLinearGradient(0, 0, 0, H);
    fondo.addColorStop(0, "#0b0705");
    fondo.addColorStop(0.5, "#0a0605");
    fondo.addColorStop(1, "#080503");
    g.fillStyle = fondo; g.fillRect(0, 0, W, H);
    const amb = g.createRadialGradient(CX, 600, 60, CX, 600, 560);
    amb.addColorStop(0, tinta("150,98,45", 0.42 * luz));
    amb.addColorStop(0.6, tinta("100,64,30", 0.2));
    amb.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = amb; g.fillRect(0, 0, W, H);
    for (const [vx, vy] of [[48, 880], [656, 900], [90, 340], [620, 320]] as const) {
      const vio = g.createRadialGradient(vx, vy, 4, vx, vy, 130);
      vio.addColorStop(0, tinta("110,80,180", 0.13));
      vio.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = vio; g.fillRect(vx - 130, vy - 130, 260, 260);
    }
    for (const t of grano) {
      g.fillStyle = tinta(t.c, t.o * (0.75 + 0.25 * luz));
      g.fillRect(t.x, t.y, t.s, t.s);
    }

    /* bóveda: arco doble del vano */
    for (const [inset, o] of [[30, 0.28], [44, 0.16]] as const) {
      g.strokeStyle = tinta("200,165,105", o);
      g.lineWidth = 1.2;
      g.beginPath();
      g.moveTo(inset, H - 24);
      g.lineTo(inset, 170);
      g.quadraticCurveTo(inset, 10, CX, 6);
      g.quadraticCurveTo(W - inset, 10, W - inset, 170);
      g.lineTo(W - inset, H - 24);
      g.stroke();
    }

    /* cadenas con eslabones */
    for (const c of cadenas) {
      g.strokeStyle = tinta("200,160,90", 0.2);
      g.lineWidth = 1;
      g.beginPath(); g.moveTo(c.x, c.y1); g.lineTo(c.x, c.y2); g.stroke();
      g.fillStyle = tinta("220,180,110", 0.3);
      for (let e = 0; e < c.esl; e++) {
        const y = c.y1 + ((c.y2 - c.y1) * (e + 0.5)) / c.esl;
        g.fillRect(c.x - 1.4, y - 2.4, 2.8, 4.8);
      }
    }

    /* anillos de runas concéntricos, tras el eje */
    const RY = 512;
    for (const [rr, col, o] of [[92, "200,165,105", 0.36], [126, "150,120,200", 0.3], [162, "200,165,105", 0.28], [200, "150,120,200", 0.22], [236, "200,165,105", 0.2], [270, "150,120,200", 0.14]] as const) {
      g.strokeStyle = tinta(col, o * luz);
      g.lineWidth = 1;
      g.beginPath(); g.arc(CX, RY, rr, 0, Math.PI * 2); g.stroke();
    }
    for (let k = 0; k < 56; k++) {
      const a = (k / 56) * Math.PI * 2;
      g.strokeStyle = tinta("200,165,105", 0.2 * luz);
      g.beginPath();
      g.moveTo(CX + Math.cos(a) * 200, RY + Math.sin(a) * 200);
      g.lineTo(CX + Math.cos(a) * (k % 4 ? 205 : 212), RY + Math.sin(a) * (k % 4 ? 205 : 212));
      g.stroke();
    }
    for (let k = 0; k < 30; k++) {
      const a = (k / 30) * Math.PI * 2 + 0.1;
      g.fillStyle = tinta("170,140,220", 0.25 * luz);
      g.fillRect(CX + Math.cos(a) * 162 - 1.5, RY + Math.sin(a) * 162 - 3, 3, 6);
    }

    /* pilares laterales: bloques apilados con jarros de fuego */
    const pilar = (x: number, y: number, e: number) => {
      g.fillStyle = tinta("16,11,7", 0.95);
      g.strokeStyle = tinta("200,150,80", 0.35 * luz);
      g.lineWidth = 1;
      for (let b = 0; b < 3; b++) {
        const bw = (34 - b * 5) * e, bh = 24 * e, by = y - b * bh;
        g.fillRect(x - bw / 2, by - bh, bw, bh);
        g.strokeRect(x - bw / 2, by - bh, bw, bh);
        g.fillStyle = tinta("240,176,80", 0.3 * luz);
        g.fillRect(x - 2 * e, by - bh / 2 - 2, 4 * e, 4);
        g.fillStyle = tinta("16,11,7", 0.95);
      }
      const fy = y - 72 * e;
      const gl = g.createRadialGradient(x, fy, 2, x, fy, 34 * e);
      gl.addColorStop(0, tinta("255,225,160", 0.75 * luz));
      gl.addColorStop(0.5, tinta("240,150,60", 0.3 * luz));
      gl.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = gl;
      g.fillRect(x - 34 * e, fy - 34 * e, 68 * e, 68 * e);
      g.fillStyle = tinta("255,235,185", 0.85 * luz);
      g.beginPath();
      g.moveTo(x, fy - 22 * e);
      g.quadraticCurveTo(x + 7 * e, fy - 6 * e, x, fy + 4 * e);
      g.quadraticCurveTo(x - 7 * e, fy - 6 * e, x, fy - 22 * e);
      g.fill();
    };
    pilar(66, 640, 0.85);
    pilar(636, 650, 0.9);
    pilar(150, 780, 0.95);
    pilar(552, 790, 1);
    pilar(96, 940, 1);
    pilar(608, 950, 1);

    /* linternas-rombo colgantes (octaedros de aristas doradas) */
    const rombo = (x: number, y: number, rx: number, ry: number, brillo: number) => {
      g.strokeStyle = tinta("200,160,90", 0.25);
      g.beginPath(); g.moveTo(x, 0); g.lineTo(x, y - ry); g.stroke();
      g.fillStyle = tinta("14,10,6", 0.96);
      g.beginPath();
      g.moveTo(x, y - ry); g.lineTo(x + rx, y); g.lineTo(x, y + ry); g.lineTo(x - rx, y);
      g.closePath(); g.fill();
      g.strokeStyle = tinta("230,190,120", brillo * luz);
      g.lineWidth = 1.3;
      g.stroke();
      g.beginPath(); g.moveTo(x - rx, y); g.lineTo(x + rx, y); g.moveTo(x, y - ry); g.lineTo(x, y + ry); g.stroke();
      const gl = g.createRadialGradient(x, y + ry, 1, x, y + ry, 22);
      gl.addColorStop(0, tinta("255,220,150", 0.5 * brillo * luz));
      gl.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = gl;
      g.fillRect(x - 22, y + ry - 22, 44, 44);
    };
    rombo(174, 300, 34, 46, 0.8);
    rombo(530, 316, 38, 52, 0.85);
    rombo(96, 470, 26, 36, 0.6);
    rombo(614, 486, 28, 38, 0.6);

    /* ── POLIEDRO INCANDESCENTE (cx, y152, R≈96) ── */
    const PY = 152, R = 96;
    const glow = g.createRadialGradient(CX, PY, 20, CX, PY, 260);
    glow.addColorStop(0, tinta("255,220,150", 0.7 * luz));
    glow.addColorStop(0.5, tinta("240,155,62", 0.32 * luz));
    glow.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = glow;
    g.fillRect(CX - 260, PY - 260, 520, 520);
    g.save();
    g.globalCompositeOperation = "lighter";
    for (const f of llamas) {
      const fl = 0.6 + 0.4 * Math.sin((fase + f.v) * Math.PI * 2 * 3);
      g.strokeStyle = tinta("255,200,110", f.o * fl * luz);
      g.lineWidth = f.w;
      g.beginPath();
      g.moveTo(CX + Math.cos(f.a) * R * 0.5, PY + Math.sin(f.a) * R * 0.5);
      g.quadraticCurveTo(
        CX + Math.cos(f.a) * (R * 0.5 + f.l * 0.6) + (f.v - 0.5) * 26,
        PY + Math.sin(f.a) * (R * 0.5 + f.l * 0.6) - f.l * 0.25,
        CX + Math.cos(f.a) * (R * 0.5 + f.l), PY + Math.sin(f.a) * (R * 0.5 + f.l) - f.l * 0.5
      );
      g.stroke();
    }
    g.restore();
    /* facetas: corona hexagonal exterior + anillo interior */
    const hex: Array<[number, number]> = [], mid: Array<[number, number]> = [];
    for (let k = 0; k < 6; k++) {
      const a = (k / 6) * Math.PI * 2 - Math.PI / 2;
      hex.push([CX + Math.cos(a) * R, PY + Math.sin(a) * R * 0.92]);
      const am = a + Math.PI / 6;
      mid.push([CX + Math.cos(am) * R * 0.58, PY + Math.sin(am) * R * 0.55]);
    }
    g.fillStyle = tinta("18,13,8", 0.9);
    g.beginPath();
    hex.forEach(([x, y], i) => (i ? g.lineTo(x, y) : g.moveTo(x, y)));
    g.closePath(); g.fill();
    g.strokeStyle = tinta("245,205,130", 0.9 * luz);
    g.lineWidth = 1.6;
    g.stroke();
    for (let i = 0; i < 6; i++) {
      const j = (i + 1) % 6;
      g.strokeStyle = tinta("235,190,115", 0.65 * luz);
      g.lineWidth = 1.1;
      g.beginPath();
      g.moveTo(hex[i][0], hex[i][1]); g.lineTo(mid[i][0], mid[i][1]);
      g.lineTo(hex[j][0], hex[j][1]);
      g.stroke();
      g.beginPath();
      g.moveTo(mid[i][0], mid[i][1]); g.lineTo(mid[(i + 1) % 6][0], mid[(i + 1) % 6][1]);
      g.stroke();
    }
    /* marcas rúnicas en facetas (fijas) */
    g.fillStyle = tinta("240,200,130", 0.5 * luz);
    for (const [mx, my] of mid) g.fillRect(mx - 2, my - 4, 4, 8);
    /* cadena de suspensión */
    g.strokeStyle = tinta("220,180,110", 0.4);
    g.lineWidth = 1.4;
    g.beginPath(); g.moveTo(CX, 0); g.lineTo(CX, PY - R * 0.92); g.stroke();

    /* ── TORRENTE de luz fundida (y248..y382) ── */
    g.save();
    g.globalCompositeOperation = "lighter";
    const tor = g.createLinearGradient(0, PY + R, 0, 400);
    tor.addColorStop(0, tinta("255,235,180", 0.75 * luz));
    tor.addColorStop(1, tinta("245,170,70", 0.45 * luz));
    g.fillStyle = tor;
    g.beginPath();
    g.moveTo(CX - 56, PY + R * 0.7);
    g.quadraticCurveTo(CX - 30, 320, CX - 16, 384);
    g.lineTo(CX + 16, 384);
    g.quadraticCurveTo(CX + 30, 320, CX + 56, PY + R * 0.7);
    g.closePath(); g.fill();
    for (let k = 0; k < 9; k++) {
      const off = (k - 4) * 10;
      const fl = 0.5 + 0.5 * Math.sin((fase * 4 + k * 0.13) * Math.PI * 2);
      g.strokeStyle = tinta("255,240,200", (0.1 + (k % 3) * 0.1) * fl * luz);
      g.lineWidth = 2.4 - (k % 3) * 0.6;
      g.beginPath();
      g.moveTo(CX + off * 3.2, PY + R * 0.72);
      g.quadraticCurveTo(CX + off * 1.8, 320, CX + off * 0.5, 382);
      g.stroke();
    }
    g.restore();

    /* ── OCTAEDRO INVERTIDO (cx, y452) ── */
    const OY = 452, ORX = 62, ORY = 86;
    g.fillStyle = tinta("14,10,6", 0.97);
    g.beginPath();
    g.moveTo(CX - ORX, OY - ORY * 0.35);
    g.lineTo(CX, OY - ORY);
    g.lineTo(CX + ORX, OY - ORY * 0.35);
    g.lineTo(CX, OY + ORY);
    g.closePath(); g.fill();
    g.strokeStyle = tinta("250,215,140", 0.95 * luz);
    g.lineWidth = 1.8;
    g.stroke();
    g.strokeStyle = tinta("235,190,115", 0.6 * luz);
    g.lineWidth = 1;
    g.beginPath();
    g.moveTo(CX - ORX, OY - ORY * 0.35); g.lineTo(CX + ORX, OY - ORY * 0.35);
    g.moveTo(CX, OY - ORY); g.lineTo(CX, OY + ORY);
    g.stroke();
    g.fillStyle = tinta("240,200,130", 0.55 * luz);
    g.fillRect(CX - 2.4, OY - 18, 4.8, 12);

    /* ── COLUMNA de fuego fina (y540..y948) ── */
    g.save();
    g.globalCompositeOperation = "lighter";
    const colg = g.createLinearGradient(0, OY + ORY, 0, 950);
    colg.addColorStop(0, tinta("255,240,200", 0.85 * luz));
    colg.addColorStop(0.7, tinta("250,190,90", 0.7 * luz));
    colg.addColorStop(1, tinta("255,235,180", 0.9 * luz));
    g.fillStyle = colg;
    g.fillRect(CX - 7, OY + ORY, 14, 950 - OY - ORY);
    const brillo = g.createLinearGradient(CX - 36, 0, CX + 36, 0);
    brillo.addColorStop(0, "rgba(0,0,0,0)");
    brillo.addColorStop(0.5, tinta("250,180,80", 0.42 * luz));
    brillo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = brillo;
    g.fillRect(CX - 36, OY + ORY, 72, 950 - OY - ORY);
    for (let k = 0; k < 4; k++) {
      const yk = OY + ORY + 60 + k * 90 + Math.sin((fase + k * 0.31) * Math.PI * 2) * 18;
      g.fillStyle = tinta("255,245,215", 0.5 * luz);
      g.beginPath(); g.ellipse(CX, yk, 4, 10, 0, 0, Math.PI * 2); g.fill();
    }
    g.restore();

    /* ── CRISOL: dais escalonado con anillo de runas ── */
    const DY = 948;
    const gradas: Array<[number, number, number, number]> = [
      [268, 74, 100, 0.2],
      [216, 60, 56, 0.28],
      [160, 46, 18, 0.4],
    ];
    for (const [rx, ry, dy, o] of gradas) {
      g.fillStyle = tinta("16,11,7", 0.96);
      g.beginPath(); g.ellipse(CX, DY + dy, rx, ry, 0, 0, Math.PI * 2); g.fill();
      g.strokeStyle = tinta("210,165,95", o * luz);
      g.lineWidth = 1.2;
      g.beginPath(); g.ellipse(CX, DY + dy, rx, ry, 0, 0, Math.PI * 2); g.stroke();
      g.strokeStyle = tinta("245,185,90", o * 1.5 * luz);
      g.beginPath(); g.ellipse(CX, DY + dy - 4, rx * 0.97, ry * 0.9, 0, Math.PI * 1.1, Math.PI * 1.9); g.stroke();
    }
    /* superficie del crisol: disco con anillo rúnico brillante */
    g.fillStyle = tinta("24,16,9", 0.97);
    g.beginPath(); g.ellipse(CX, DY, 128, 38, 0, 0, Math.PI * 2); g.fill();
    g.save();
    g.globalCompositeOperation = "lighter";
    g.strokeStyle = tinta("255,220,150", 0.85 * luz);
    g.lineWidth = 3;
    g.beginPath(); g.ellipse(CX, DY, 96, 28, 0, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("250,190,90", 0.45 * luz);
    g.lineWidth = 7;
    g.beginPath(); g.ellipse(CX, DY, 96, 28, 0, 0, Math.PI * 2); g.stroke();
    for (let k = 0; k < 26; k++) {
      const a = (k / 26) * Math.PI * 2;
      g.fillStyle = tinta("255,230,170", 0.6 * luz);
      g.fillRect(CX + Math.cos(a) * 72 - 1.5, DY + Math.sin(a) * 21 - 3, 3, 6);
    }
    const impacto = g.createRadialGradient(CX, DY, 2, CX, DY, 90);
    impacto.addColorStop(0, tinta("255,245,220", 0.95 * luz));
    impacto.addColorStop(0.4, tinta("250,190,90", 0.5 * luz));
    impacto.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = impacto;
    g.beginPath(); g.ellipse(CX, DY, 90, 30, 0, 0, Math.PI * 2); g.fill();
    g.restore();

    /* ── RÍOS de metal fundido en canales radiales ── */
    const rio = (x1: number, y1: number, cx1: number, cy1: number, cx2: number, cy2: number, x2: number, y2: number) => {
      const trazar = () => {
        g.beginPath();
        g.moveTo(x1, y1);
        g.bezierCurveTo(cx1, cy1, cx2, cy2, x2, y2);
      };
      g.lineCap = "round";
      g.strokeStyle = tinta("30,18,8", 0.9);
      g.lineWidth = 26; trazar(); g.stroke();
      g.save();
      g.globalCompositeOperation = "lighter";
      g.strokeStyle = tinta("250,180,80", 0.65 * luz);
      g.lineWidth = 15; trazar(); g.stroke();
      g.strokeStyle = tinta("255,235,185", 0.8 * luz);
      g.lineWidth = 6; trazar(); g.stroke();
      g.restore();
      g.lineCap = "butt";
    };
    /* FOSA ANULAR de metal fundido alrededor del crisol (muy visible
       en la referencia: un anillo de fuego rodea el dais) */
    g.strokeStyle = tinta("30,18,8", 0.9);
    g.lineWidth = 30;
    g.beginPath(); g.ellipse(CX, DY + 58, 296, 88, 0, 0, Math.PI * 2); g.stroke();
    g.save();
    g.globalCompositeOperation = "lighter";
    g.strokeStyle = tinta("250,180,80", 0.55 * luz);
    g.lineWidth = 17;
    g.beginPath(); g.ellipse(CX, DY + 58, 296, 88, 0, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("255,235,185", 0.65 * luz);
    g.lineWidth = 6;
    g.beginPath(); g.ellipse(CX, DY + 58, 296, 88, 0, 0, Math.PI * 2); g.stroke();
    g.restore();

    rio(CX - 100, DY + 30, 240, 1010, 150, 1020, 76, 1072);
    rio(CX + 100, DY + 32, 470, 1015, 560, 1025, 630, 1076);
    rio(CX - 40, DY + 40, 300, 1030, 260, 1050, 226, 1088);
    rio(CX + 40, DY + 42, 400, 1035, 450, 1055, 486, 1090);
    rio(CX, DY + 44, CX, 1050, CX, 1070, CX, 1092);

    /* chispas: deriva lenta hacia arriba + titileo */
    g.save();
    g.globalCompositeOperation = "lighter";
    for (const s of chispas) {
      const y = ((s.y - fase * 60 * (0.4 + s.v)) % (H + 40) + H + 40) % (H + 40) - 20;
      const tw = 0.5 + 0.5 * Math.sin((fase * 6 + s.v) * Math.PI * 2);
      g.fillStyle = tinta(s.v < 0.15 ? "180,150,235" : "255,215,140", s.o * tw * luz);
      g.beginPath(); g.arc(s.x, y, s.r, 0, Math.PI * 2); g.fill();
    }
    g.restore();

    /* ── VIÑETA: centro iluminado, bordes a negro (lección del piloto) */
    const vin = g.createRadialGradient(CX, 580, 300, CX, 580, 640);
    vin.addColorStop(0, "rgba(0,0,0,0)");
    vin.addColorStop(0.7, "rgba(2,1,1,0.45)");
    vin.addColorStop(1, "rgba(2,1,1,0.9)");
    g.fillStyle = vin;
    g.fillRect(0, 0, W, H);
  };

  montarLienzo({ raiz, cuadro: pintar, periodo: 20000, periodoReducido: 56000 });
  montarEscala();
</script>
