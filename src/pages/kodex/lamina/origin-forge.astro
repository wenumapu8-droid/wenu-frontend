  /* 05 · faro de emisión sobre el anillo */
  icono("of-p5", (g, r) => {
    const halo = g.createRadialGradient(52, 60, 4, 52, 60, 44);
    halo.addColorStop(0, tinta("240,176,80", 0.5));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo; g.fillRect(0, 0, 104, 104);
    g.strokeStyle = tinta("240,205,140", 0.6);
    g.beginPath(); g.ellipse(52, 76, 26, 8, 0, 0, Math.PI * 2); g.stroke();
    g.fillStyle = tinta("20,14,8", 0.95);
    for (const dx of [-18, -8, 8, 18]) g.fillRect(52 + dx - 3, 62, 6, 13);
    g.strokeStyle = tinta("240,176,80", 0.5);
    for (const dx of [-18, -8, 8, 18]) g.strokeRect(52 + dx - 3, 62, 6, 13);
    const haz = g.createLinearGradient(0, 18, 0, 74);
    haz.addColorStop(0, tinta("255,245,215", 0.9));
    haz.addColorStop(1, tinta("240,176,80", 0.55));
    g.fillStyle = haz;
    g.beginPath(); g.moveTo(49, 74); g.lineTo(50.5, 18); g.lineTo(53.5, 18); g.lineTo(55, 74); g.closePath(); g.fill();
    g.strokeStyle = tinta("255,240,200", 0.8); g.lineWidth = 1;
    g.beginPath(); g.moveTo(40, 34); g.lineTo(64, 34); g.stroke();
    for (let k = 0; k < 10; k++) {
      g.fillStyle = tinta("255,220,150", 0.4 + r() * 0.5);
      g.beginPath(); g.arc(32 + r() * 40, 24 + r() * 50, 0.8 + r(), 0, Math.PI * 2); g.fill();
    }
  }, 0x2215);

  /* ══ EL ORGANISMO: LA FORJA ═════════════════════════════════════ */
  const canvas = document.getElementById("of-forja") as HTMLCanvasElement;
  const g = canvas.getContext("2d")!;
  const rnd = rng(0x0f22);
  const W = 704, H = 1092, CX = 351;

  /* chispas fijas con fase propia (derivan hacia arriba y titilan) */
  const chispas = Array.from({ length: 230 }, () => ({
    x: CX + (rnd() - 0.5) * (rnd() < 0.7 ? 320 : 620),
    y: 40 + rnd() * 1000,
    r: 0.5 + rnd() * 1.3,
    o: 0.15 + rnd() * 0.6,
    v: rnd(),
  }));

  /* grano ambiente cálido (textura del fondo, fijo) */
  const grano: Array<{ x: number; y: number; s: number; o: number; c: string }> = [];
  for (let k = 0; k < 9500; k++) {
    const x = rnd() * W, y = rnd() * H;
    const centro = Math.abs(x - CX) < 220;
    grano.push({
      x, y, s: 0.7 + rnd() * 1.3,
      o: (centro ? 0.16 : 0.08) + rnd() * (centro ? 0.3 : 0.16),
      c: rnd() < 0.16 ? "150,120,200" : rnd() < 0.6 ? "190,140,75" : "130,95,62",
    });
  }

  /* cadenas verticales: x, largo, con eslabones */
  const cadenas = [58, 96, 130, 176, 210, 246, 285, 320, 388, 420, 458, 494, 528, 566, 604, 646].map((x) => ({
    x, y1: 4, y2: 160 + rnd() * 620, esl: 12 + Math.floor(rnd() * 14),
  }));

  /* llamaradas del poliedro (estrías radiales fijas, flicker por fase) */
  const llamas = Array.from({ length: 110 }, () => ({
    a: -Math.PI / 2 + (rnd() - 0.5) * 3.4,
    l: 46 + rnd() * 120,
    o: 0.18 + rnd() * 0.5,
    w: 1 + rnd() * 2.8,
    v: rnd(),
  }));

  const pintar = (fase: number) => {
    const luz = 0.88 + 0.12 * Math.cos(fase * Math.PI * 2);
    g.clearRect(0, 0, W, H);

    /* fondo cálido oscuro + ambientes */
    const fondo = g.createLinearGradient(0, 0, 0, H);
    fondo.addColorStop(0, "#0b0705");
    fondo.addColorStop(0.5, "#0a0605");
    fondo.addColorStop(1, "#080503");
    g.fillStyle = fondo; g.fillRect(0, 0, W, H);
    const amb = g.createRadialGradient(CX, 600, 60, CX, 600, 560);
    amb.addColorStop(0, tinta("150,98,45", 0.42 * luz));
    amb.addColorStop(0.6, tinta("100,64,30", 0.2));
    amb.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = amb; g.fillRect(0, 0, W, H);
    for (const [vx, vy] of [[48, 880], [656, 900], [90, 340], [620, 320]] as const) {
      const vio = g.createRadialGradient(vx, vy, 4, vx, vy, 130);
      vio.addColorStop(0, tinta("110,80,180", 0.13));
      vio.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = vio; g.fillRect(vx - 130, vy - 130, 260, 260);
    }
    for (const t of grano) {
      g.fillStyle = tinta(t.c, t.o * (0.75 + 0.25 * luz));
      g.fillRect(t.x, t.y, t.s, t.s);
    }

    /* bóveda: arco doble del vano */
    for (const [inset, o] of [[30, 0.28], [44, 0.16]] as const) {
      g.strokeStyle = tinta("200,165,105", o);
      g.lineWidth = 1.2;
      g.beginPath();
      g.moveTo(inset, H - 24);
      g.lineTo(inset, 170);
      g.quadraticCurveTo(inset, 10, CX, 6);
      g.quadraticCurveTo(W - inset, 10, W - inset, 170);
      g.lineTo(W - inset, H - 24);
      g.stroke();
    }

    /* cadenas con eslabones */
    for (const c of cadenas) {
      g.strokeStyle = tinta("200,160,90", 0.2);
      g.lineWidth = 1;
      g.beginPath(); g.moveTo(c.x, c.y1); g.lineTo(c.x, c.y2); g.stroke();
      g.fillStyle = tinta("220,180,110", 0.3);
      for (let e = 0; e < c.esl; e++) {
        const y = c.y1 + ((c.y2 - c.y1) * (e + 0.5)) / c.esl;
        g.fillRect(c.x - 1.4, y - 2.4, 2.8, 4.8);
      }
    }

    /* ── CÍRCULO MÁGICO MAYOR, tras el eje ──
       Medido sobre la referencia: centro en (351, 570) del lienzo y anillos
       hasta 305 px, todos de oro. Estaba a 512, cortito y medio violeta, y
       con alfas de 0,14–0,36 que lo dejaban casi invisible: en la referencia
       es una de las estructuras más legibles de la lámina. */
    const RY = 570;
    g.save();
    g.globalCompositeOperation = "lighter";
    const halo = g.createRadialGradient(CX, RY, 20, CX, RY, 320);
    halo.addColorStop(0, tinta("196,140,66", 0.09 * luz));
    halo.addColorStop(0.55, tinta("142,96,46", 0.035 * luz));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo;
    g.beginPath(); g.arc(CX, RY, 320, 0, Math.PI * 2); g.fill();
    for (const [rr, col, o, lw] of [
      [100, "236,196,124", 0.62, 1.3], [140, "214,172,104", 0.5, 1],
      [186, "240,200,128", 0.55, 1.6], [230, "206,166,102", 0.42, 1],
      [272, "232,190,120", 0.46, 1.3], [305, "186,150,96", 0.3, 1],
    ] as const) {
      g.strokeStyle = tinta(col, o * luz);
      g.lineWidth = lw;
      g.beginPath(); g.arc(CX, RY, rr, 0, Math.PI * 2); g.stroke();
    }
    /* dientes rúnicos entre los anillos 186 y 230 */
    for (let k = 0; k < 56; k++) {
      const a = (k / 56) * Math.PI * 2;
      g.strokeStyle = tinta("236,192,120", 0.34 * luz);
      g.lineWidth = 1.2;
      g.beginPath();
      g.moveTo(CX + Math.cos(a) * 186, RY + Math.sin(a) * 186);
      g.lineTo(CX + Math.cos(a) * (k % 4 ? 198 : 214), RY + Math.sin(a) * (k % 4 ? 198 : 214));
      g.stroke();
    }
    /* sellos cuadrados sobre el anillo de 140 y motas violetas en el de 272 */
    for (let k = 0; k < 30; k++) {
      const a = (k / 30) * Math.PI * 2 + 0.1;
      g.fillStyle = tinta("244,202,132", 0.4 * luz);
      g.fillRect(CX + Math.cos(a) * 140 - 2, RY + Math.sin(a) * 140 - 3.5, 4, 7);
      g.fillStyle = tinta("176,146,226", 0.26 * luz);
      g.fillRect(CX + Math.cos(a) * 272 - 1.5, RY + Math.sin(a) * 272 - 1.5, 3, 3);
    }
    /* radios largos: la referencia los tiene cruzando todo el disco */
    for (let k = 0; k < 12; k++) {
      const a = (k / 12) * Math.PI * 2 + 0.26;
      g.strokeStyle = tinta("214,172,104", 0.22 * luz);
      g.lineWidth = 1;
      g.beginPath();
      g.moveTo(CX + Math.cos(a) * 100, RY + Math.sin(a) * 100);
      g.lineTo(CX + Math.cos(a) * 305, RY + Math.sin(a) * 305);
      g.stroke();
    }
    g.restore();

    /* pilastras laterales de la cámara: columnas ornamentadas con
       paneles y puntos rúnicos (bordes de la referencia) */
    for (const px of [8, W - 40]) {
      g.fillStyle = tinta("13,9,6", 0.9);
      g.fillRect(px, 60, 32, H - 90);
      g.strokeStyle = tinta("200,160,90", 0.3 * luz);
      g.lineWidth = 1;
      g.strokeRect(px + 3, 70, 26, H - 110);
      for (let yy = 120; yy < H - 80; yy += 96) {
        g.strokeRect(px + 7, yy, 18, 62);
        g.fillStyle = tinta("240,195,115", 0.35 * luz);
        g.fillRect(px + 14, yy + 26, 4, 8);
        g.fillStyle = tinta("13,9,6", 0.9);
      }
    }

    /* llama vertical genérica (pilares y coronas): silueta dentada */
    const llamaVert = (x: number, yBase: number, alto: number, ancho: number, sem: number, op: number) => {
      g.save();
      g.globalCompositeOperation = "lighter";
      const gl = g.createRadialGradient(x, yBase - alto * 0.4, 2, x, yBase - alto * 0.4, alto * 0.75);
      gl.addColorStop(0, tinta("255,220,150", 0.55 * op * luz));
      gl.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = gl;
      g.fillRect(x - alto * 0.75, yBase - alto * 1.2, alto * 1.5, alto * 1.6);
      for (const [wf, hf, col, o] of [[1, 1, "252,180,80", 0.6], [0.55, 0.82, "255,235,185", 0.85]] as const) {
        g.fillStyle = tinta(col, o * op * luz);
        g.beginPath();
        g.moveTo(x - ancho * wf, yBase);
        for (let s = 0; s <= 6; s++) {
          const u = s / 6;
          const lado = s % 2 ? 1 : -1;
          const flick = Math.sin((fase * 3 + sem * 0.7 + s * 0.9) * Math.PI * 2);
          g.quadraticCurveTo(
            x + lado * ancho * wf * (1 - u) * (1.4 + 0.5 * flick),
            yBase - alto * hf * (u - 0.08),
            x + (s === 6 ? 0 : lado * ancho * wf * (1 - u) * 0.5),
            yBase - alto * hf * u
          );
        }
        for (let s = 6; s >= 0; s--) {
          const u = s / 6;
          g.lineTo(x - ancho * wf * (1 - u) * 0.4, yBase - alto * hf * u + 2);
        }
        g.closePath();
        g.fill();
      }
      g.restore();
    };

    /* pilares de CUBOS con runas doradas, coronados de fuego y con
       caídas de metal por la cara frontal */
    const pilar = (x: number, y: number, e: number, sem: number) => {
      for (let b = 0; b < 3; b++) {
        const bw = (58 - b * 8) * e, bh = 42 * e, by = y - b * bh;
        const cara = g.createLinearGradient(0, by - bh, 0, by);
        cara.addColorStop(0, tinta("48,34,21", 0.97));
        cara.addColorStop(1, tinta("34,24,15", 0.97));
        g.fillStyle = cara;
        g.fillRect(x - bw / 2, by - bh, bw, bh);
        g.strokeStyle = tinta("205,160,90", 0.5 * luz);
        g.lineWidth = 1.2;
        g.strokeRect(x - bw / 2, by - bh, bw, bh);
        /* runa cuadrada grabada en la cara */
        g.strokeStyle = tinta("245,195,110", 0.55 * luz);
        g.strokeRect(x - 8 * e, by - bh / 2 - 8 * e, 16 * e, 16 * e);
        g.fillStyle = tinta("250,205,120", 0.5 * luz);
        g.fillRect(x - 2, by - bh / 2 - 2, 4, 4);
      }
      /* caída de metal fundido por el frente */
      g.save();
      g.globalCompositeOperation = "lighter";
      g.strokeStyle = tinta("252,190,95", 0.34 * luz);
      g.lineWidth = 4 * e;
      g.beginPath();
      g.moveTo(x + 12 * e, y - 118 * e);
      g.quadraticCurveTo(x + 16 * e, y - 60 * e, x + 13 * e, y);
      g.stroke();
      g.strokeStyle = tinta("255,238,190", 0.6 * luz);
      g.lineWidth = 1.6 * e;
      g.beginPath();
      g.moveTo(x + 12 * e, y - 118 * e);
      g.quadraticCurveTo(x + 15 * e, y - 60 * e, x + 13 * e, y);
      g.stroke();
      g.restore();
      llamaVert(x, y - 126 * e, 88 * e, 16 * e, sem, 0.62);
    };
    pilar(66, 700, 0.8, 1);
    pilar(636, 710, 0.85, 2);
    pilar(152, 826, 0.95, 3);
    pilar(550, 836, 1, 4);
    pilar(98, 986, 1.05, 5);
    pilar(606, 996, 1.1, 6);

    /* ── LINTERNAS-OCTAEDRO colgantes ──
       En la referencia son JAULAS de oro: pirámide superior con cara plana en
       fuga, pirámide inferior en punta, montantes gruesos, cristal oscuro y un
       chorro de metal que gotea de la punta. Estaban dibujadas como un rombo
       plano de 1,3 px, y las grandes iban a menos de la mitad de su tamaño
       (medido: semiancho 58 y semialto 65 en el lienzo, no 26 y 36). */
    const rombo = (x: number, y: number, rx: number, ry: number, brillo: number, goteo = 0) => {
      const tapa = ry * 0.42, fuga = rx * 0.34;
      /* cadena de la que cuelga */
      g.strokeStyle = tinta("200,160,90", 0.3);
      g.lineWidth = 1.2;
      g.beginPath(); g.moveTo(x, 0); g.lineTo(x, y - ry); g.stroke();
      for (let e = 0; e < 10; e++) {
        g.fillStyle = tinta("214,172,104", 0.32 * luz);
        g.fillRect(x - 1.6, (y - ry) * ((e + 0.5) / 10) - 2.5, 3.2, 5);
      }
      /* cristal: cara superior en fuga + cuerpo */
      g.fillStyle = tinta("34,24,15", 0.94);
      g.beginPath();
      g.moveTo(x - rx * 0.5, y - ry); g.lineTo(x + rx * 0.5, y - ry);
      g.lineTo(x + rx, y - ry + tapa); g.lineTo(x, y + ry);
      g.lineTo(x - rx, y - ry + tapa);
      g.closePath(); g.fill();
      const vidrio = g.createLinearGradient(0, y - ry, 0, y + ry);
      vidrio.addColorStop(0, tinta("70,50,28", 0.5));
      vidrio.addColorStop(1, tinta("150,92,36", 0.24 * brillo));
      g.fillStyle = vidrio;
      g.fill();
      /* montantes de oro */
      const barra = (x1: number, y1: number, x2: number, y2: number, e: number) => {
        g.strokeStyle = tinta("150,108,52", 0.6 * luz);
        g.lineWidth = 4.4 * e;
        g.beginPath(); g.moveTo(x1, y1); g.lineTo(x2, y2); g.stroke();
        g.strokeStyle = tinta("250,214,146", 0.62 * brillo * luz);
        g.lineWidth = 1.7 * e;
        g.beginPath(); g.moveTo(x1, y1); g.lineTo(x2, y2); g.stroke();
      };
      const hombro: Array<[number, number]> = [
        [x - rx, y - ry + tapa], [x - fuga, y - ry + tapa * 0.35],
        [x + fuga, y - ry + tapa * 0.35], [x + rx, y - ry + tapa],
      ];
      barra(x - rx * 0.5, y - ry, x + rx * 0.5, y - ry, 0.8);
      for (const [hx, hy] of hombro) {
        barra(hx, hy, x, y + ry, 0.9);
        barra(hx, hy, hx > x ? x + rx * 0.5 : x - rx * 0.5, y - ry, 0.7);
      }
      for (let i = 0; i < hombro.length - 1; i++)
        barra(hombro[i][0], hombro[i][1], hombro[i + 1][0], hombro[i + 1][1], 0.8);
      /* runa en la cara y brasa en la punta */
      g.fillStyle = tinta("244,198,124", 0.45 * brillo * luz);
      g.fillRect(x - 3, y - ry * 0.1, 6, 12);
      g.save();
      g.globalCompositeOperation = "lighter";
      const gl = g.createRadialGradient(x, y + ry * 0.72, 1, x, y + ry * 0.72, rx * 0.9);
      gl.addColorStop(0, tinta("255,224,164", 0.42 * brillo * luz));
      gl.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = gl;
      g.fillRect(x - rx, y + ry * 0.72 - rx, rx * 2, rx * 2);
      /* goteo de metal desde la punta */
      if (goteo) {
        /* el chorro serpentea: recto era un poste de farola */
        const y0 = y + ry;
        const trazo = () => {
          g.beginPath();
          g.moveTo(x, y0);
          for (let s = 1; s <= 8; s++) {
            const u = s / 8;
            const w = Math.sin(u * 7.3 + x * 0.11) * 6 * (0.3 + u);
            g.lineTo(x + w, y0 + goteo * u);
          }
        };
        g.strokeStyle = tinta("252,186,92", 0.26 * luz);
        g.lineWidth = 8; trazo(); g.stroke();
        g.strokeStyle = tinta("255,242,206", 0.4 * luz);
        g.lineWidth = 2.6; trazo(); g.stroke();
        const ch = g.createRadialGradient(x, y0 + goteo, 1, x, y0 + goteo, 44);
        ch.addColorStop(0, tinta("255,232,180", 0.55 * luz));
        ch.addColorStop(1, "rgba(0,0,0,0)");
        g.fillStyle = ch;
        g.beginPath(); g.ellipse(x, y0 + goteo, 44, 17, 0, 0, Math.PI * 2); g.fill();
      }
      g.restore();
    };
    rombo(175, 302, 38, 44, 0.85);
    rombo(527, 302, 38, 44, 0.85);
    rombo(98, 405, 58, 65, 0.95, 260);
    rombo(604, 405, 58, 65, 0.95, 260);

    /* ── POLIEDRO INCANDESCENTE ──
       Medido sobre la referencia: el poliedro va de x463 a x737 de la página
       (semiancho 139 en el lienzo) y su centro cae en y138, no en y152. Estaba
       dibujado a R=96 — un tercio más chico — y con aristas de 1,6 px, así que
       leía como un hexágono negro; en la referencia es una jaula de oro. */
    const PY = 138, R = 139;
    const glow = g.createRadialGradient(CX, PY, 20, CX, PY, 262);
    glow.addColorStop(0, tinta("255,220,150", 0.7 * luz));
    glow.addColorStop(0.5, tinta("240,155,62", 0.32 * luz));
    glow.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = glow;
    g.fillRect(CX - 262, PY - 262, 524, 524);
    g.save();
    g.globalCompositeOperation = "lighter";
    /* penacho que sube por detrás del poliedro: en la referencia la banda alta
       del centro está encendida, y medida contra la nuestra salía 30 puntos de
       luminancia por debajo — era el mayor déficit de la lámina */
    const pen = g.createLinearGradient(0, PY - R * 0.5, 0, -70);
    pen.addColorStop(0, tinta("255,206,132", 0.5 * luz));
    pen.addColorStop(0.55, tinta("246,164,70", 0.26 * luz));
    pen.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = pen;
    g.beginPath();
    g.moveTo(CX - R * 0.94, PY + 26);
    g.quadraticCurveTo(CX - R * 0.7, PY - 90, CX - R * 0.3, -40);
    g.lineTo(CX + R * 0.3, -40);
    g.quadraticCurveTo(CX + R * 0.7, PY - 90, CX + R * 0.94, PY + 26);
    g.closePath(); g.fill();
    for (let k = 0; k < 16; k++) {
      const u = (k / 15 - 0.5) * 2;
      const fl = 0.5 + 0.5 * Math.sin((fase * 2.2 + k * 0.43) * Math.PI * 2);
      g.strokeStyle = tinta("255,224,168", 0.3 * fl * luz);
      g.lineWidth = 1.6 + 1.6 * (1 - Math.abs(u));
      g.beginPath();
      g.moveTo(CX + u * R * 0.82, PY + 10);
      g.quadraticCurveTo(CX + u * R * 0.6 + 14, PY - 80, CX + u * R * 0.4, PY - 170 - 40 * (1 - Math.abs(u)));
      g.stroke();
    }
    /* fuego que envuelve al poliedro. Antes las estrías salían disparadas hasta
       f.l entero y formaban un ABANICO de rayos que la referencia no tiene:
       ahí el fuego es una pelusa corta y densa pegada a las aristas. */
    for (const f of llamas) {
      const fl = 0.6 + 0.4 * Math.sin((fase + f.v) * Math.PI * 2 * 3);
      const largo = f.l * 0.3;
      g.strokeStyle = tinta("255,200,110", f.o * 0.85 * fl * luz);
      g.lineWidth = f.w * 1.7;
      g.beginPath();
      g.moveTo(CX + Math.cos(f.a) * R * 0.72, PY + Math.sin(f.a) * R * 0.72);
      g.quadraticCurveTo(
        CX + Math.cos(f.a) * (R * 0.72 + largo * 0.6) + (f.v - 0.5) * 16,
        PY + Math.sin(f.a) * (R * 0.72 + largo * 0.6) - largo * 0.25,
        CX + Math.cos(f.a) * (R * 0.72 + largo), PY + Math.sin(f.a) * (R * 0.72 + largo) - largo * 0.5
      );
      g.stroke();
    }
    g.restore();
    /* facetas: corona hexagonal exterior + anillo interior */
    const hex: Array<[number, number]> = [], mid: Array<[number, number]> = [];
    for (let k = 0; k < 6; k++) {
      const a = (k / 6) * Math.PI * 2 - Math.PI / 2;
      hex.push([CX + Math.cos(a) * R, PY + Math.sin(a) * R * 0.92]);
      const am = a + Math.PI / 6;
      mid.push([CX + Math.cos(am) * R * 0.58, PY + Math.sin(am) * R * 0.55]);
    }
    /* cuerpo: cristal oscuro pero encendido por dentro, no negro plano */
    const cuerpo = g.createLinearGradient(0, PY - R, 0, PY + R);
    cuerpo.addColorStop(0, tinta("66,48,28", 0.88));
    cuerpo.addColorStop(0.62, tinta("52,36,20", 0.88));
    cuerpo.addColorStop(1, tinta("74,46,22", 0.8));
    g.fillStyle = cuerpo;
    g.beginPath();
    hex.forEach(([x, y], i) => (i ? g.lineTo(x, y) : g.moveTo(x, y)));
    g.closePath(); g.fill();
    /* fuego DENTRO de la jaula. Medida por quintos, la franja central de la
       lámina salía 61 puntos de luminancia por debajo de la referencia en la
       banda alta: el poliedro estaba apagado por dentro. */
    g.save();
    g.beginPath();
    hex.forEach(([x, y], i) => (i ? g.lineTo(x, y) : g.moveTo(x, y)));
    g.closePath();
    g.clip();
    g.globalCompositeOperation = "lighter";
    /* la brasa va ARRIBA del centro del poliedro: medido por quintos, la mitad
       alta salía 36 puntos por debajo y la baja 55 por encima */
    const brasa = g.createRadialGradient(CX, PY - R * 0.34, 4, CX, PY - R * 0.34, R * 1.15);
    brasa.addColorStop(0, tinta("255,244,214", 0.34 * luz));
    brasa.addColorStop(0.34, tinta("252,190,96", 0.18 * luz));
    brasa.addColorStop(1, tinta("196,104,34", 0.03 * luz));
    g.fillStyle = brasa;
    g.fillRect(CX - R, PY - R, R * 2, R * 2);
    for (let k = 0; k < 14; k++) {
      const u = (k / 13 - 0.5) * 1.7;
      const fl = 0.5 + 0.5 * Math.sin((fase * 2.6 + k * 0.51) * Math.PI * 2);
      g.strokeStyle = tinta("255,232,182", 0.2 * fl * luz);
      g.lineWidth = 2.2;
      g.beginPath();
      g.moveTo(CX + u * R * 0.7, PY + R * 0.8);
      g.quadraticCurveTo(CX + u * R * 0.45 + 10, PY, CX + u * R * 0.3, PY - R * 0.8);
      g.stroke();
    }
    g.restore();
    /* aristas: montante grueso mate + filo brillante encima (así se ve el
       oro macizo de la referencia; una línea de 1,6 px no lo consigue) */
    const arista = (x1: number, y1: number, x2: number, y2: number, e: number) => {
      g.strokeStyle = tinta("146,104,48", 0.85 * luz);
      g.lineWidth = 5.4 * e;
      g.beginPath(); g.moveTo(x1, y1); g.lineTo(x2, y2); g.stroke();
      g.strokeStyle = tinta("250,214,146", 0.95 * luz);
      g.lineWidth = 2 * e;
      g.beginPath(); g.moveTo(x1, y1); g.lineTo(x2, y2); g.stroke();
    };
    for (let i = 0; i < 6; i++) {
      const j = (i + 1) % 6;
      arista(hex[i][0], hex[i][1], hex[j][0], hex[j][1], (hex[i][1] + hex[j][1]) / 2 < PY ? 1.5 : 1);
      arista(hex[i][0], hex[i][1], mid[i][0], mid[i][1], 0.72);
      arista(mid[i][0], mid[i][1], hex[j][0], hex[j][1], 0.72);
      arista(mid[i][0], mid[i][1], mid[j][0], mid[j][1], 0.62);
    }
    /* marcas rúnicas en facetas (fijas) */
    g.fillStyle = tinta("240,200,130", 0.5 * luz);
    for (const [mx, my] of mid) g.fillRect(mx - 3, my - 6, 6, 12);
    /* cadena de suspensión */
    g.strokeStyle = tinta("220,180,110", 0.4);
    g.lineWidth = 1.4;
    g.beginPath(); g.moveTo(CX, 0); g.lineTo(CX, PY - R * 0.92); g.stroke();

    /* ── TORRENTE de luz fundida (y248..y382) ── */
    g.save();
    g.globalCompositeOperation = "lighter";
    const tor = g.createLinearGradient(0, PY + R, 0, 400);
    tor.addColorStop(0, tinta("255,240,195", 0.9 * luz));
    tor.addColorStop(1, tinta("250,185,85", 0.6 * luz));
    g.fillStyle = tor;
    g.beginPath();
    g.moveTo(CX - 34, PY + R * 0.7);
    g.quadraticCurveTo(CX - 22, 320, CX - 13, 384);
    g.lineTo(CX + 13, 384);
    g.quadraticCurveTo(CX + 22, 320, CX + 34, PY + R * 0.7);
    g.closePath(); g.fill();
    /* turbulencia: hebras que serpentean dentro del chorro */
    for (let k = 0; k < 13; k++) {
      const off = (k - 6) * 5;
      const fl = 0.5 + 0.5 * Math.sin((fase * 4 + k * 0.13) * Math.PI * 2);
      g.strokeStyle = tinta("255,244,210", (0.16 + (k % 3) * 0.14) * fl * luz);
      g.lineWidth = 2.6 - (k % 3) * 0.6;
      g.beginPath();
      g.moveTo(CX + off, PY + R * 0.72);
      g.bezierCurveTo(
        CX + off * 1.6 + Math.sin(k * 2.1) * 10, 290,
        CX + off * 0.8 - Math.sin(k * 1.3) * 9, 340,
        CX + off * 0.4, 382
      );
      g.stroke();
    }
    /* resplandor lateral del chorro */
    const torGlow = g.createRadialGradient(CX, 310, 10, CX, 310, 120);
    torGlow.addColorStop(0, tinta("255,210,120", 0.4 * luz));
    torGlow.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = torGlow;
    g.fillRect(CX - 120, 190, 240, 240);
    g.restore();

    /* ── OCTAEDRO INVERTIDO (cx, y452) ── */
    /* ── EMBUDO: el cono invertido que recibe el torrente ──
       Estaba relleno de (14,10,6): una cometa NEGRA justo donde la referencia
       tiene un cono de oro con la boca encendida. Medido: boca de semiancho 73
       en y401 del lienzo, punta en y534. */
    const OY = 452, ORX = 73, ORY = 86;
    const bocaY = OY - ORY * 0.35;
    const embudo = () => {
      g.beginPath();
      g.moveTo(CX - ORX, bocaY);
      g.lineTo(CX, OY - ORY);
      g.lineTo(CX + ORX, bocaY);
      g.lineTo(CX, OY + ORY);
      g.closePath();
    };
    const gc = g.createLinearGradient(0, OY - ORY, 0, OY + ORY);
    gc.addColorStop(0, tinta("46,33,20", 0.95));
    gc.addColorStop(0.45, tinta("74,50,26", 0.95));
    gc.addColorStop(1, tinta("140,84,32", 0.9));
    g.fillStyle = gc;
    embudo(); g.fill();
    /* gajos del cono */
    g.strokeStyle = tinta("214,166,96", 0.4 * luz);
    g.lineWidth = 1;
    for (let k = -3; k <= 3; k++) {
      g.beginPath();
      g.moveTo(CX + (k / 3) * ORX, bocaY);
      g.lineTo(CX, OY + ORY);
      g.stroke();
    }
    /* boca: elipse encendida donde cae el fuego */
    g.save();
    g.globalCompositeOperation = "lighter";
    const boca = g.createRadialGradient(CX, bocaY, 2, CX, bocaY, ORX);
    boca.addColorStop(0, tinta("255,248,224", 0.85 * luz));
    boca.addColorStop(0.4, tinta("252,196,102", 0.4 * luz));
    boca.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = boca;
    g.beginPath(); g.ellipse(CX, bocaY, ORX, ORX * 0.24, 0, 0, Math.PI * 2); g.fill();
    g.restore();
    /* montantes de oro */
    g.strokeStyle = tinta("150,108,52", 0.9 * luz);
    g.lineWidth = 5; embudo(); g.stroke();
    g.strokeStyle = tinta("252,216,150", 0.95 * luz);
    g.lineWidth = 1.9; embudo(); g.stroke();
    g.strokeStyle = tinta("240,200,130", 0.7 * luz);
    g.lineWidth = 2.4;
    g.beginPath();
    g.moveTo(CX - ORX, bocaY); g.lineTo(CX + ORX, bocaY);
    g.stroke();
    g.strokeStyle = tinta("236,190,116", 0.55 * luz);
    g.lineWidth = 1.4;
    g.beginPath(); g.ellipse(CX, bocaY, ORX * 0.62, ORX * 0.15, 0, 0, Math.PI * 2); g.stroke();

    /* ── COLUMNA de fuego fina (y540..y948) ── */
    g.save();
    g.globalCompositeOperation = "lighter";
    /* la columna es LLAMA, no barra: silueta dentada por capas, con
       ondulación determinista y deriva por fase */
    const yTop = OY + ORY, yBot = 878;
    const capas: Array<[number, string, number]> = [
      [30, "250,170,70", 0.34],
      [18, "253,205,110", 0.6],
      [7.5, "255,244,215", 0.9],
    ];
    for (const [wMax, col, op] of capas) {
      g.fillStyle = tinta(col, op * luz);
      g.beginPath();
      const N = 22;
      for (let s = 0; s <= N; s++) {
        const u = s / N;
        const y = yTop + (yBot - yTop) * u;
        const ond =
          Math.sin(u * 21 + fase * Math.PI * 2) * 0.4 +
          Math.sin(u * 9 - fase * Math.PI * 4) * 0.35 +
          Math.sin(u * 33 + 1.7) * 0.25;
        const wl = wMax * (0.65 + 0.35 * Math.sin(u * 14 + 2.2) * Math.sin(u * 5.3)) * (1 + ond * 0.5);
        const x = CX + ond * wMax * 0.5;
        if (s === 0) g.moveTo(x - wl, y);
        else g.lineTo(x - wl, y);
      }
      for (let s = N; s >= 0; s--) {
        const u = s / N;
        const y = yTop + (yBot - yTop) * u;
        const ond =
          Math.sin(u * 21 + fase * Math.PI * 2) * 0.4 +
          Math.sin(u * 9 - fase * Math.PI * 4) * 0.35 +
          Math.sin(u * 33 + 1.7) * 0.25;
        const wl = wMax * (0.65 + 0.35 * Math.sin(u * 14 + 2.2) * Math.sin(u * 5.3)) * (1 + ond * 0.5);
        const x = CX + ond * wMax * 0.5;
        g.lineTo(x + wl, y);
      }
      g.closePath();
      g.fill();
    }
    /* velo del eje: la referencia no tiene una cinta de fuego sobre negro,
       tiene toda la franja central encendida (chispas, humo y reverbero).
       Medido por quintos, ahí faltaban entre 17 y 35 puntos de luminancia. */
    const brillo = g.createLinearGradient(CX - 116, 0, CX + 116, 0);
    brillo.addColorStop(0, "rgba(0,0,0,0)");
    brillo.addColorStop(0.34, tinta("236,148,60", 0.14 * luz));
    brillo.addColorStop(0.5, tinta("250,182,82", 0.36 * luz));
    brillo.addColorStop(0.66, tinta("236,148,60", 0.14 * luz));
    brillo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = brillo;
    g.fillRect(CX - 116, yTop, 232, yBot - yTop);
    /* zarcillos que se desprenden de la columna */
    for (let k = 0; k < 8; k++) {
      const yk = yTop + 30 + k * 52;
      const lado = k % 2 ? 1 : -1;
      const fl = 0.5 + 0.5 * Math.sin((fase * 2 + k * 0.37) * Math.PI * 2);
      g.strokeStyle = tinta("255,230,165", 0.5 * fl * luz);
      g.lineWidth = 1.7;
      g.beginPath();
      g.moveTo(CX + lado * 8, yk + 30);
      g.bezierCurveTo(
        CX + lado * 30, yk + 12,
        CX + lado * 20, yk - 12,
        CX + lado * 36, yk - 28
      );
      g.stroke();
    }
    g.restore();

    /* ── COLADAS de metal fundido ──
       En la referencia no son tubos: son cintas serpenteantes que caen de los
       caños de los bloques, bajan en S por las terrazas y se abren en abanico
       al llegar al suelo. Un solo bezier no serpentea, así que la colada toma
       una polilínea y la suaviza por puntos medios. */
    const colada = (pts: Array<[number, number]>, e: number, brillo = 1) => {
      const trazar = () => {
        g.beginPath();
        g.moveTo(pts[0][0], pts[0][1]);
        for (let i = 1; i < pts.length - 1; i++) {
          const [x, y] = pts[i], [xn, yn] = pts[i + 1];
          g.quadraticCurveTo(x, y, (x + xn) / 2, (y + yn) / 2);
        }
        g.lineTo(pts[pts.length - 1][0], pts[pts.length - 1][1]);
      };
      g.lineCap = "round";
      g.lineJoin = "round";
      g.save();
      g.globalCompositeOperation = "lighter";
      g.strokeStyle = tinta("255,140,45", 0.08 * brillo * luz);
      g.lineWidth = 30 * e; trazar(); g.stroke();
      g.strokeStyle = tinta("250,168,64", 0.36 * brillo * luz);
      g.lineWidth = 15 * e; trazar(); g.stroke();
      g.strokeStyle = tinta("255,214,140", 0.5 * brillo * luz);
      g.lineWidth = 8 * e; trazar(); g.stroke();
      g.strokeStyle = tinta("255,248,225", 0.8 * brillo * luz);
      g.lineWidth = 3.4 * e; trazar(); g.stroke();
      /* abanico donde la colada toca el suelo */
      const [fx, fy] = pts[pts.length - 1];
      const ab = g.createRadialGradient(fx, fy, 2, fx, fy, 54 * e);
      ab.addColorStop(0, tinta("255,236,190", 0.7 * brillo * luz));
      ab.addColorStop(0.45, tinta("250,168,64", 0.3 * brillo * luz));
      ab.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = ab;
      g.beginPath(); g.ellipse(fx, fy, 54 * e, 20 * e, 0, 0, Math.PI * 2); g.fill();
      g.restore();
      g.lineCap = "butt";
      g.lineJoin = "miter";
    };
    const espejo = (pts: Array<[number, number]>): Array<[number, number]> =>
      pts.map(([x, y]) => [2 * CX - x, y] as [number, number]);
    /* las dos grandes S laterales dominan la mitad baja de la referencia:
       nacen de un caño alto, serpentean por las terrazas y se abren abajo */
    const sIzq: Array<[number, number]> = [
      [130, 700], [170, 744], [152, 792], [112, 848],
      [88, 912], [106, 972], [142, 1032], [176, 1084],
    ];
    const canoIzq: Array<[number, number]> = [[198, 706], [228, 730], [240, 768], [234, 812]];
    const coladasLaterales = () => {
      colada(sIzq, 0.86, 0.46);
      colada(espejo(sIzq), 0.86, 0.46);
      colada(canoIzq, 0.66, 0.6);
      colada(espejo(canoIzq), 0.66, 0.6);
    };

    /* ── CRISOL: tambor macizo de piedra escalonado ──
       La referencia NO tiene un aro de alambre: tiene un TAMBOR con volumen,
       cara frontal de sillares verticales y un segundo escalón más ancho.
       Antes esto se dibujaba con elipses de relleno negro y solo se veían sus
       filos dorados: leía como jaula de pájaros, no como piedra. */
    const DY = 880, DRX = 162, DRY = 32, DH = 113;

    /* silueta del tambor (elipse superior + pared + elipse inferior) */
    const cuerpoTambor = (cx: number, cy: number, rx: number, ry: number, h: number) => {
      g.beginPath();
      g.ellipse(cx, cy, rx, ry, 0, 0, Math.PI);
      g.lineTo(cx - rx, cy + h);
      g.ellipse(cx, cy + h, rx, ry, 0, Math.PI, 0, true);
      g.closePath();
    };

    /* pared de sillares: nervaduras verticales con luz que cae hacia los lados */
    const paredTambor = (cx: number, cy: number, rx: number, ry: number, h: number, n: number, f = 1) => {
      const gr = g.createLinearGradient(0, cy, 0, cy + h);
      gr.addColorStop(0, tinta(f > 1 ? "78,58,36" : "58,42,26", 0.98));
      gr.addColorStop(0.42, tinta(f > 1 ? "46,33,21" : "30,21,13", 0.98));
      gr.addColorStop(1, tinta(f > 1 ? "26,19,12" : "14,10,7", 0.98));
      g.fillStyle = gr;
      cuerpoTambor(cx, cy, rx, ry, h);
      g.fill();
      /* rescoldo que sube desde la base: la piedra está caliente */
      g.save();
      g.globalCompositeOperation = "lighter";
      const asc = g.createLinearGradient(0, cy + h * 0.25, 0, cy + h + ry);
      asc.addColorStop(0, "rgba(0,0,0,0)");
      asc.addColorStop(1, tinta("196,116,44", 0.3 * luz));
      g.fillStyle = asc;
      cuerpoTambor(cx, cy, rx, ry, h);
      g.fill();
      g.restore();
      for (let k = 0; k <= n; k++) {
        const a = (k / n) * Math.PI;
        const x = cx + Math.cos(a) * rx, yy = cy + Math.sin(a) * ry;
        const frente = Math.sin(a);
        g.strokeStyle = tinta("214,166,96", (0.1 + 0.3 * frente) * luz);
        g.lineWidth = 1.1;
        g.beginPath(); g.moveTo(x, yy); g.lineTo(x, yy + h); g.stroke();
      }
      /* moldura horizontal a media pared */
      g.strokeStyle = tinta("226,178,104", 0.32 * luz);
      g.lineWidth = 1.4;
      g.beginPath(); g.ellipse(cx, cy + h * 0.46, rx, ry, 0, 0, Math.PI); g.stroke();
      /* filo superior y filo inferior */
      g.strokeStyle = tinta("248,200,120", 0.6 * luz);
      g.lineWidth = 2.2;
      g.beginPath(); g.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2); g.stroke();
      g.strokeStyle = tinta("226,168,88", 0.34 * luz);
      g.lineWidth = 1.6;
      g.beginPath(); g.ellipse(cx, cy + h, rx, ry, 0, 0, Math.PI); g.stroke();
    };

    /* ── TERRAZAS: el anfiteatro de sillares que rodea el crisol ──
       En la referencia la mitad baja no es fondo negro: es una grada de
       bloques de piedra con cantos dorados y placas rúnicas. Sin esto el
       crisol flota en el vacío (y la medición lo cobra: la referencia tiene
       tinta ahí y nosotros no). */
    const bloque = (x: number, y: number, w: number, h: number, s: number, f = 1) => {
      const d = w * 0.34;
      /* cara frontal */
      const gf = g.createLinearGradient(0, y, 0, y + h);
      gf.addColorStop(0, tinta(f > 1 ? "104,76,44" : "74,54,32", 0.98));
      gf.addColorStop(1, tinta(f > 1 ? "46,33,21" : "33,24,15", 0.98));
      g.fillStyle = gf;
      g.fillRect(x - w / 2, y, w, h);
      /* cara superior en fuga */
      g.fillStyle = tinta(f > 1 ? "122,90,52" : "92,68,40", 0.98);
      g.beginPath();
      g.moveTo(x - w / 2, y);
      g.lineTo(x - w / 2 + d * 0.5, y - d * 0.42);
      g.lineTo(x + w / 2 + d * 0.5, y - d * 0.42);
      g.lineTo(x + w / 2, y);
      g.closePath(); g.fill();
      /* cantos dorados */
      g.strokeStyle = tinta("222,176,104", 0.5 * luz);
      g.lineWidth = 1;
      g.strokeRect(x - w / 2, y, w, h);
      g.stroke();
      /* placa rúnica en el frente */
      if (s % 3 === 0) {
        g.strokeStyle = tinta("240,190,110", 0.4 * luz);
        g.strokeRect(x - w * 0.18, y + h * 0.3, w * 0.36, h * 0.34);
      } else if (s % 3 === 1) {
        g.fillStyle = tinta(s % 6 === 1 ? "168,132,224" : "244,192,112", 0.4 * luz);
        g.fillRect(x - 2, y + h * 0.42, 4, h * 0.2);
      }
    };
    /* cuatro gradas concéntricas, de atrás hacia adelante, salteando el frente
       central donde cae el metal */
    const gradas: Array<[number, number, number, number, number, number]> = [
      [214, 52, 918, 46, 13, 1],
      [258, 64, 966, 54, 15, 1],
      [304, 76, 1016, 62, 17, 1.12],
      [352, 90, 1064, 70, 19, 1.12],
    ];
    for (const [rx, ry, cy, w, n, f] of gradas) {
      for (let k = 0; k < n; k++) {
        const a = Math.PI * (0.03 + (k / (n - 1)) * 0.94);
        const bx = CX + Math.cos(a) * rx;
        const by = cy + Math.sin(a) * ry;
        if (Math.abs(bx - CX) < 46 && Math.sin(a) > 0.9) continue;
        bloque(bx, by, w, w * 0.82, k + n, f);
      }
    }

    /* escalón inferior (más ancho), después las coladas laterales — que en la
       referencia pasan por detrás del tambor alto y por delante de la terraza —
       y por último el tambor principal */
    paredTambor(CX, DY + DH + 8, 238, 46, 84, 30, 1.06);
    coladasLaterales();
    paredTambor(CX, DY, DRX, DRY, DH, 26);

    /* superficie del crisol: disco con anillo rúnico brillante */
    const supg = g.createRadialGradient(CX, DY, 8, CX, DY, DRX);
    supg.addColorStop(0, tinta("74,50,26", 0.98));
    supg.addColorStop(1, tinta("22,15,9", 0.98));
    g.fillStyle = supg;
    g.beginPath(); g.ellipse(CX, DY, DRX - 6, DRY - 3, 0, 0, Math.PI * 2); g.fill();
    g.save();
    g.globalCompositeOperation = "lighter";
    /* losas radiales de la tapa */
    g.strokeStyle = tinta("206,158,90", 0.22 * luz);
    g.lineWidth = 1;
    for (let k = 0; k < 24; k++) {
      const a = (k / 24) * Math.PI * 2;
      g.beginPath();
      g.moveTo(CX + Math.cos(a) * 77, DY + Math.sin(a) * 15);
      g.lineTo(CX + Math.cos(a) * (DRX - 8), DY + Math.sin(a) * (DRY - 2));
      g.stroke();
    }
    g.strokeStyle = tinta("236,186,108", 0.34 * luz);
    g.lineWidth = 1.4;
    g.beginPath(); g.ellipse(CX, DY, 124, 24, 0, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("255,220,150", 0.85 * luz);
    g.lineWidth = 3;
    g.beginPath(); g.ellipse(CX, DY, 90, 18, 0, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("250,190,90", 0.45 * luz);
    g.lineWidth = 7;
    g.beginPath(); g.ellipse(CX, DY, 90, 18, 0, 0, Math.PI * 2); g.stroke();
    for (let k = 0; k < 30; k++) {
      const a = (k / 30) * Math.PI * 2;
      g.fillStyle = tinta("255,230,170", 0.6 * luz);
      g.fillRect(CX + Math.cos(a) * 73 - 1.5, DY + Math.sin(a) * 14 - 3, 3, 6);
    }
    /* círculo mágico sobre la superficie del crisol: doble anillo +
       estrella de cinco puntas + marcas rúnicas (así es la referencia) */
    g.strokeStyle = tinta("255,225,155", 0.7 * luz);
    g.lineWidth = 1.6;
    g.beginPath(); g.ellipse(CX, DY, 60, 12, 0, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("252,205,120", 0.5 * luz);
    g.beginPath(); g.ellipse(CX, DY, 44, 9, 0, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("255,235,175", 0.6 * luz);
    g.lineWidth = 1.2;
    g.beginPath();
    for (let k = 0; k <= 5; k++) {
      const a = ((k * 2) % 5 / 5) * Math.PI * 2 - Math.PI / 2;
      const x = CX + Math.cos(a) * 44, y = DY + Math.sin(a) * 9;
      if (k === 0) g.moveTo(x, y); else g.lineTo(x, y);
    }
    g.stroke();
    const impacto = g.createRadialGradient(CX, DY, 2, CX, DY, 130);
    impacto.addColorStop(0, tinta("255,250,230", 1 * luz));
    impacto.addColorStop(0.35, tinta("253,205,110", 0.7 * luz));
    impacto.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = impacto;
    g.beginPath(); g.ellipse(CX, DY, 130, 30, 0, 0, Math.PI * 2); g.fill();
    /* corona de salpicaduras del impacto */
    for (let k = 0; k < 12; k++) {
      const a = (k / 12) * Math.PI * 2;
      const fl = 0.5 + 0.5 * Math.sin((fase * 3 + k * 0.41) * Math.PI * 2);
      g.strokeStyle = tinta("255,238,185", 0.55 * fl * luz);
      g.lineWidth = 1.8;
      g.beginPath();
      g.moveTo(CX + Math.cos(a) * 22, DY + Math.sin(a) * 5);
      g.quadraticCurveTo(
        CX + Math.cos(a) * 46, DY + Math.sin(a) * 10 - 26,
        CX + Math.cos(a) * 62, DY + Math.sin(a) * 14 - 8
      );
      g.stroke();
    }
    g.restore();

    /* derrame de metal por la cara frontal del propio tambor: chorrea sobre la
       pared y muere en la base, no baja hasta el suelo (bajaba, y las dos
       coladas leían como patas de trípode delante del crisol) */
    colada([[CX - 6, DY + 18], [CX - 12, DY + 60], [CX - 18, DY + DH - 6], [CX - 24, DY + DH + 26]], 0.62, 0.95);
    colada([[CX + 9, DY + 20], [CX + 16, DY + 64], [CX + 22, DY + DH - 4], [CX + 30, DY + DH + 24]], 0.5, 0.85);

    /* chispas: deriva lenta hacia arriba + titileo */
    g.save();
    g.globalCompositeOperation = "lighter";
    for (const s of chispas) {
      const y = ((s.y - fase * 60 * (0.4 + s.v)) % (H + 40) + H + 40) % (H + 40) - 20;
      const tw = 0.5 + 0.5 * Math.sin((fase * 6 + s.v) * Math.PI * 2);
      g.fillStyle = tinta(s.v < 0.15 ? "180,150,235" : "255,215,140", s.o * tw * luz);
      g.beginPath(); g.arc(s.x, y, s.r, 0, Math.PI * 2); g.fill();
    }
    g.restore();

    /* ── VIÑETA: centro iluminado, bordes a negro (lección del piloto) */
    const vin = g.createRadialGradient(CX, 580, 300, CX, 580, 640);
    vin.addColorStop(0, "rgba(0,0,0,0)");
    vin.addColorStop(0.7, "rgba(2,1,1,0.45)");
    vin.addColorStop(1, "rgba(2,1,1,0.9)");
    g.fillStyle = vin;
    g.fillRect(0, 0, W, H);
  };

  montarLienzo({ raiz, cuadro: pintar, periodo: 20000, periodoReducido: 56000 });
  montarEscala();
</script>
