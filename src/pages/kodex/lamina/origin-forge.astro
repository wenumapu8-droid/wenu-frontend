  }
  .of-caja--riel-izq :global(.arch-riel > * + *) { margin-top: 8px; padding-top: 10px; }
  .of-caja--riel-izq :global(.arch-riel > * + *)::before { background: rgba(169, 141, 84, 0.3); }
  .of-riel-titulo {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
