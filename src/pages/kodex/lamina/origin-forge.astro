  .of-cajita__clase { font-size: 11px; letter-spacing: 0.14em; margin-top: 7px !important; color: #b9a06a; }

  /* ── riel izquierdo x26..266 y300..1350 ───────────────────────── */
  .of-caja--riel-izq { top: 300px; left: 26px; height: 1050px; }
  .of-caja--riel-izq > :global(.arch-riel) {
    height: 100%;
    justify-content: space-between;
    border-color: rgba(169, 141, 84, 0.45);
