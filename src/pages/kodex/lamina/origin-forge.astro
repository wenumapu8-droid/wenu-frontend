---
/**
 * KODEX−∞ · ORIGIN FORGE · PAGE 22 (a22)
 *
 * Lámina de la serie de archivo, misma estructura que el piloto
 * silence-engine (a28): cromo con los componentes de
 * src/components/kodex/archivo/ + organismo central procedural en
 * canvas (montarLienzo) + montarEscala.
 *
 * VARIANTE DE CABECERA: a22 es CENTRADA como a21 — título grande al
 * eje, "KODEX−∞" al centro de la primera fila, y DOS cajas enmarcadas
 * en las esquinas (PAGE 22 a la izquierda, PRIMORDIAL CONSTRUCT a la
 * derecha). Se decidió MIRANDO la referencia, no por analogía.
 *
 * TODO el texto visible está TRANSCRITO de
 * reference/pendientes/origin-forge.png (reencodeada de
 * a22-origin-forge.png). Nada inventado; los renglones de glifos
 * ilegibles van como MARCAS con semilla, no como texto.
 *
 * CAJAS MEDIDAS (perfil de tinta, bandas.mjs + probes):
 * · marco exterior x7..12 / y13..18 (doble línea)
 * · fila 1 cabecera y41..64 · cajas esquina y81..279 (izq x42..186,
 *   der x1024..1184) · título y102..196 · subtítulo y224..244 ·
 *   consigna y268..278
 * · riel izq x26..266 y300..1350 (línea vertical de conexión x≈91)
 * · riel der x969..1195: paneles y301..644 / 656..850 / 860..1114 /
 *   1123..1395
 * · centro (canvas) x264..968 y298..1390
 * · pie: aforismo y1408..1444 · fila de sellos y1460..1512
 *
 * EL ORGANISMO (lo que se VE en la referencia, transcrito): una cámara
 * abovedada de forja; de lo alto cuelga un poliedro facetado envuelto
 * en fuego dorado que vierte un torrente de luz fundida sobre un
 * octaedro invertido negro de aristas doradas; del vértice baja una
 * columna fina de fuego hasta un crisol circular escalonado del que
 * salen RÍOS de metal fundido en canales radiales. Alrededor: cadenas
 * verticales, linternas-rombo colgantes, pilares de bloques con
 * llamas, anillos de runas concéntricos al fondo (oro/violeta),
 * chispas, y viñeta fuerte a negro en los bordes.
 */
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/600.css";
import CabeceraArchivo from "../../../components/kodex/archivo/CabeceraArchivo.astro";
import TituloBilingue from "../../../components/kodex/archivo/TituloBilingue.astro";
import TarjetaMetrica from "../../../components/kodex/archivo/TarjetaMetrica.astro";
import RielMetricas from "../../../components/kodex/archivo/RielMetricas.astro";
import AforismoPie from "../../../components/kodex/archivo/AforismoPie.astro";
import SelloClasificacion from "../../../components/kodex/archivo/SelloClasificacion.astro";
import { rng } from "../../../components/kodex/lamina/kit/rng";

/* ── Marcas de glifos ilegibles (rng con semilla; NO texto real) ──── */
const glifos = (semilla: number, n: number, alto = 8) => {
  const r = rng(semilla);
  const partes: string[] = [];
  let x = 1;
  for (let i = 0; i < n; i++) {
    const trazos = 2 + Math.floor(r() * 3);
    for (let t = 0; t < trazos; t++) {
      const x1 = x + r() * 6, y1 = 0.5 + r() * (alto - 1);
      const x2 = x + r() * 6, y2 = 0.5 + r() * (alto - 1);
      partes.push(`M${x1.toFixed(1)} ${y1.toFixed(1)}L${x2.toFixed(1)} ${y2.toFixed(1)}`);
    }
    x += 9 + r() * 5;
  }
  return { d: partes.join(""), w: Math.ceil(x) };
};
const gPagina = glifos(0x22a, 8);
const gClase = glifos(0x22b, 9);
const gPieIzq = glifos(0x22c, 9);
const gPieDer = glifos(0x22d, 9);

/* ── SYMBOL DENSITY: perfil espigado violeta + oro (semilla fija) ──
   MEDIDO sobre la referencia: la traza es BIPOLAR alrededor de una línea
   base en y=790 (real), sube hasta y=740 y baja hasta y=806. La nuestra
   era unipolar y de la mitad de amplitud: la franja y748..798 salía 17,6
   puntos de luminancia por debajo. */
const perfilEspigas = (semilla: number, amp: number) => {
  const r = rng(semilla);
  const pts: string[] = [];
  for (let i = 0; i <= 108; i++) {
    const x = 6 + (i / 108) * 190;
    /* los picos altos de la referencia llegan 50 px por encima de la base y
       los valles 16 por debajo; con r() plano casi nunca se alcanzaban */
    const pico = r() < 0.24 ? (0.45 + r() * 0.55) * amp : r() * amp * 0.11;
    const hondo = r() < 0.3 ? (0.3 + r() * 0.7) * amp * 0.4 : 0;
    const y = 58 - pico + hondo;
    pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
  }
  return pts.join(" ");
};
const espigasVioleta = perfilEspigas(0x2201, 52);
const espigasOro = perfilEspigas(0x2202, 14);

/* ── Geometría polar para las ruedas de sigilo (medida, no estimada) ── */
const P = (r: number, a: number): [number, number] => {
  const t = ((a - 90) * Math.PI) / 180;
  return [Number((r * Math.cos(t)).toFixed(2)), Number((r * Math.sin(t)).toFixed(2))];
};
const poli = (r: number, n: number, off = 0) =>
  Array.from({ length: n }, (_, i) => P(r, off + (i * 360) / n).join(",")).join(" ");
const estrella = (re: number, ri: number, n: number, off = 0) =>
  Array.from({ length: n * 2 }, (_, i) => P(i % 2 ? ri : re, off + (i * 180) / n).join(",")).join(" ");
const angulos = (n: number, off = 0) => Array.from({ length: n }, (_, i) => off + (i * 360) / n);

/* ── HEAT INDEX: filamentos de la columna de fuego (semilla fija) ─── */
const filamento = (semilla: number, amp: number) => {
  const r = rng(semilla);
  const pts: string[] = [];
  for (let i = 0; i <= 36; i++) {
    const t = i / 36;
    const y = 22 + t * 166;
    const x = 104 + (r() - 0.5) * 2 * amp * (0.25 + t);
    pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
  }
  return pts.join(" ");
};
const hilos = [filamento(0x2210, 3.2), filamento(0x2211, 2.1), filamento(0x2212, 4.4)];

const pasos = [
  { n: "01", t1: "CHAOS", t2: "INFUSION", d: "Raw potential is drawn from the unformed." },
  { n: "02", t1: "SIGIL", t2: "MOLTING", d: "Molten glyphs are cast into the crucible of intention." },
  { n: "03", t1: "FORM", t2: "ALIGNMENT", d: "Geometric molds shape the sigil into coherent structure." },
  { n: "04", t1: "LIGHT", t2: "QUENCH", d: "Form is sealed in white-gold fire, becoming immutable." },
  { n: "05", t1: "WORLD", t2: "EMISSION", d: "The forged code is released into the lattice to seed reality." },
];

const notas = [
  ["ALIGN INTENTION WITH PRIME WILL."],
  ["FEED CHAOS WITHOUT FEAR."],
  ["PRECISION OF FORM", "REQUIRES SACRED GEOMETRY."],
  ["ONLY COHERENT SYMBOLS", "MAY ENTER THE LATTICE."],
  ["A FLAW IN FORM BECOMES A", "FLAW IN WORLDS."],
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · ORIGIN FORGE · PAGE 22</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam arch-marco" data-lam="origin-forge" style="width:1229px;height:1536px;">
      {/* marco doble exterior medido x7..12 / y13..18 */}
      <div class="of-marco of-marco--ext" aria-hidden="true"></div>
      <div class="of-marco of-marco--int" aria-hidden="true"></div>

      {/* ── fila 1 de cabecera: esquinas + KODEX−∞ al centro ─────── */}
      <div class="arch-caja of-caja--cab">
        <CabeceraArchivo
          marca="THE KODEX ARCHIVES"
          lema="UNIVERSAL PRINCIPLES EDITION"
          rotuloPagina="VOLUME ∞ / SECTION 1"
          pagina="CREATION MECHANICS"
        >
          <div slot="adorno" class="of-cab-centro">
            <svg width="150" height="10" viewBox="0 0 150 10" fill="none" aria-hidden="true">
              <line x1="0" y1="5" x2="140" y2="5" stroke="currentColor" stroke-opacity="0.4" />
              <rect x="141" y="2" width="6" height="6" transform="rotate(45 144 5)" stroke="currentColor" stroke-opacity="0.6" fill="none" />
            </svg>
            <span class="of-kodex">KODEX−∞</span>
            <svg width="150" height="10" viewBox="0 0 150 10" fill="none" aria-hidden="true">
              <rect x="3" y="2" width="6" height="6" transform="rotate(45 6 5)" stroke="currentColor" stroke-opacity="0.6" fill="none" />
              <line x1="10" y1="5" x2="150" y2="5" stroke="currentColor" stroke-opacity="0.4" />
            </svg>
          </div>
        </CabeceraArchivo>
      </div>

      {/* ── título centrado (variante a21/a22) ────────────────────── */}
      <div class="arch-caja of-caja--titulo">
        <TituloBilingue titulo="ORIGIN FORGE" subtitulo="FORJA DEL ORIGEN" />
        <p class="of-consigna">WHERE CHAOS BECOMES CODE. WHERE CODE BECOMES WORLDS.</p>
      </div>

      {/* ── caja esquina izq: PAGE 22 ─────────────────────────────── */}
      <div class="arch-caja of-caja--pagina of-cajita">
        <p class="of-cajita__rotulo">PAGE</p>
        <p class="of-cajita__numero">22</p>
        <p class="of-cajita__codigo">KX ∞ - 22</p>
        <svg width={gPagina.w} height="9" viewBox={`0 0 ${gPagina.w} 9`} aria-hidden="true">
          <path d={gPagina.d} stroke="#8d7b58" stroke-width="0.8" stroke-opacity="0.8" fill="none" />
        </svg>
      </div>

      {/* ── caja esquina der: sello del constructo ────────────────── */}
      <div class="arch-caja of-caja--constructo of-cajita">
        <svg width="112" height="100" viewBox="0 0 112 100" fill="none" aria-hidden="true" class="of-sello-geo">
          <circle cx="56" cy="50" r="44" stroke="#a98d54" stroke-opacity="0.7" />
          <circle cx="56" cy="50" r="36" stroke="#a98d54" stroke-opacity="0.4" stroke-dasharray="2 4" />
          <path d="M56 16 L88 74 L24 74 Z" stroke="#c9ab6a" stroke-opacity="0.85" fill="none" />
          <path d="M56 30 L76 68 L36 68 Z" stroke="#c9ab6a" stroke-opacity="0.5" fill="none" />
          <circle cx="56" cy="16" r="3" stroke="#c9ab6a" stroke-opacity="0.8" fill="none" />
          <circle cx="88" cy="74" r="3" stroke="#c9ab6a" stroke-opacity="0.8" fill="none" />
          <circle cx="24" cy="74" r="3" stroke="#c9ab6a" stroke-opacity="0.8" fill="none" />
          <line x1="56" y1="2" x2="56" y2="10" stroke="#a98d54" stroke-opacity="0.6" />
          <line x1="56" y1="90" x2="56" y2="98" stroke="#a98d54" stroke-opacity="0.6" />
          <line x1="8" y1="50" x2="16" y2="50" stroke="#a98d54" stroke-opacity="0.6" />
          <line x1="96" y1="50" x2="104" y2="50" stroke="#a98d54" stroke-opacity="0.6" />
        </svg>
        <p class="of-cajita__dos-lineas">PRIMORDIAL<br />CONSTRUCT</p>
        <p class="of-cajita__clase">CLASS: FORGE-ORIGIN</p>
        <svg width={gClase.w} height="9" viewBox={`0 0 ${gClase.w} 9`} aria-hidden="true">
          <path d={gClase.d} stroke="#8d7b58" stroke-width="0.8" stroke-opacity="0.8" fill="none" />
        </svg>
      </div>

      {/* ── riel izquierdo: THE FORGE PROCESS ─────────────────────── */}
      <div class="arch-caja of-caja--riel-izq">
        <RielMetricas ancho={240} rotulo="el proceso de la forja">
          <h2 class="of-riel-titulo">THE FORGE PROCESS</h2>
          {pasos.map((p, i) => (
            <article class="of-paso">
              <div class="of-paso__icono">
                <canvas id={`of-p${i + 1}`} width="120" height="120" aria-hidden="true"></canvas>
              </div>
              <div class="of-paso__texto">
                <p class="of-paso__n">{p.n}</p>
                <h3 class="of-paso__titulo">{p.t1}<br />{p.t2}</h3>
                <p class="of-paso__desc">{p.d}</p>
              </div>
            </article>
          ))}
          <div class="of-ciclo">
            <p class="of-ciclo__texto">CYCLE IS ETERNAL.<br />CREATION IS RELENTLESS.<br />THE FORGE NEVER SLEEPS.</p>
            <svg width="120" height="110" viewBox="0 0 120 110" fill="none" aria-hidden="true">
              <circle cx="60" cy="55" r="44" stroke="#a98d54" stroke-opacity="0.45" />
              <path d="M60 8 C86 30 86 80 60 102 C34 80 34 30 60 8 Z" stroke="#c9ab6a" stroke-opacity="0.6" fill="none" />
              <path d="M18 40 L102 70 M102 40 L18 70" stroke="#a98d54" stroke-opacity="0.3" />
              <text x="60" y="63" text-anchor="middle" class="of-ciclo__inf">∞</text>
            </svg>
          </div>
        </RielMetricas>
      </div>

      {/* ── EL ORGANISMO: la forja del origen, procedural ─────────── */}
      <canvas class="arch-caja of-caja--forja" id="of-forja" width="704" height="1092" aria-hidden="true"></canvas>

      {/* ── riel derecho: FORGE METRICS en 4 paneles ──────────────── */}
      <div class="arch-caja of-panel of-panel--1">
        <RielMetricas ancho={226} rotulo="métricas de la forja">
          <h2 class="of-riel-titulo">FORGE METRICS</h2>
          <TarjetaMetrica tituloEn="HEAT INDEX" tituloEs="" valor="9.87 ∞" etiqueta="EXA-KELVIN" conPie={false}>
            <svg width="196" height="216" viewBox="0 0 196 216" fill="none" aria-hidden="true">
              {/* La columna de la referencia NO es una cuña naranja plana: es una
                 hoja de fuego blanco-oro de 5 px envuelta en un halo ancho, y
                 remata en una rosa encendida de ~28 px de radio. Medido: las
                 franjas y449..648 de este panel salían entre 7 y 13,5 puntos de
                 luminancia por debajo de la referencia. */}
              <defs>
                <linearGradient id="of-llama-g" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#fff6dd" />
                  <stop offset="45%" stop-color="#ffd489" />
                  <stop offset="100%" stop-color="#f0a840" />
                </linearGradient>
                <radialGradient id="of-halo-col" cx="0.5" cy="0.5" r="0.5">
                  <stop offset="0%" stop-color="#ffcf86" stop-opacity="0.4" />
                  <stop offset="34%" stop-color="#f2a848" stop-opacity="0.17" />
                  <stop offset="100%" stop-color="#f2a848" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="of-halo-pie" cx="0.5" cy="0.5" r="0.5">
                  <stop offset="0%" stop-color="#fff0c8" stop-opacity="0.5" />
                  <stop offset="40%" stop-color="#f0a840" stop-opacity="0.2" />
                  <stop offset="100%" stop-color="#f0a840" stop-opacity="0" />
                </radialGradient>
              </defs>
              {[0, 1, 2, 3, 4, 5].map((i) => (
                <>
                  <text x="34" y={20 + i * 36} class="of-gauge-num" text-anchor="end">{10 - i * 2} ∞</text>
                  <line x1="42" y1={16 + i * 36} x2="160" y2={16 + i * 36} stroke="#a98d54" stroke-opacity="0.28" stroke-dasharray="1 4" />
                </>
              ))}
              <ellipse cx="104" cy="106" rx="42" ry="106" fill="url(#of-halo-col)" />
              <ellipse cx="104" cy="192" rx="48" ry="46" fill="url(#of-halo-pie)" />
              <path d="M104 20 L109 186 L104 198 L99 186 Z" fill="url(#of-llama-g)" />
              <path d="M104 24 L116 184 L104 200 L92 184 Z" fill="#ffbe63" fill-opacity="0.22" />
              {hilos.map((h, k) => (
                <polyline
                  points={h}
                  stroke={k === 1 ? "#fff8e6" : "#ffd489"}
                  stroke-opacity={k === 1 ? 0.95 : 0.5}
                  stroke-width={k === 1 ? 1.5 : 0.9}
                  fill="none"
                />
              ))}
              <line x1="104" y1="22" x2="104" y2="188" stroke="#fffaf0" stroke-opacity="0.85" stroke-width="1.4" />
              <circle cx="104" cy="16" r="6" stroke="#ffe6a8" stroke-opacity="0.95" fill="none" />
              <circle cx="104" cy="16" r="2.4" fill="#fff6dd" fill-opacity="0.9" />
              {/* rosa de los vientos del pie, encendida */}
              <g transform="translate(104 192)">
                <circle r="28" stroke="#d8bd85" stroke-opacity="0.55" />
                <circle r="21" stroke="#e8c56a" stroke-opacity="0.6" />
                <circle r="13" stroke="#f2ddb0" stroke-opacity="0.7" />
                {angulos(16).map((a) => (
                  <line x1={P(13, a)[0]} y1={P(13, a)[1]} x2={P(28, a)[0]} y2={P(28, a)[1]} stroke="#e8c56a" stroke-opacity="0.45" />
                ))}
                <polygon points={estrella(32, 9, 4)} stroke="#f2ddb0" stroke-opacity="0.7" fill="none" />
                <polygon points={estrella(21, 6, 6, 30)} fill="#ffeec4" fill-opacity="0.55" />
                <circle r="6" fill="#fffaf0" fill-opacity="0.9" />
              </g>
            </svg>
          </TarjetaMetrica>
        </RielMetricas>
      </div>

      <div class="arch-caja of-panel of-panel--2">
        <RielMetricas ancho={226} rotulo="densidad de símbolos">
          <TarjetaMetrica tituloEn="SYMBOL DENSITY" tituloEs="" valor="Φ 7.314" etiqueta="SIGILS / m³" conPie={false}>
            <svg width="202" height="100" viewBox="0 0 202 100" fill="none" aria-hidden="true">
              {/* la referencia no encierra la traza en un marco brillante: es una
                 retícula tenue con la señal encendida encima */}
              <rect x="2" y="2" width="198" height="84" stroke="#8d7b58" stroke-opacity="0.2" fill="none" />
              {[0, 1, 2, 3].map((i) => (
                <line x1="2" y1={19 + i * 21} x2="200" y2={19 + i * 21} stroke="#a98d54" stroke-opacity="0.13" stroke-dasharray="2 5" />
              ))}
              {[0, 1, 2, 3, 4, 5].map((i) => (
                <line x1={16 + i * 34} y1="2" x2={16 + i * 34} y2="86" stroke="#a98d54" stroke-opacity="0.13" stroke-dasharray="2 5" />
              ))}
              <line x1="4" y1="58" x2="198" y2="58" stroke="#a98d54" stroke-opacity="0.3" />
              <polyline points={espigasVioleta} stroke="#8f72d8" stroke-opacity="0.13" stroke-width="2.6" fill="none" />
              <polyline points={espigasOro} stroke="#e8c56a" stroke-opacity="0.55" stroke-width="1" fill="none" />
              <polyline points={espigasVioleta} stroke="#b294f0" stroke-opacity="0.9" stroke-width="1.15" fill="none" />
              {[0, 1, 2, 3, 4, 5].map((i) => (
                <>
                  <line x1={16 + i * 34} y1="86" x2={16 + i * 34} y2="90" stroke="#8d7b58" stroke-opacity="0.5" />
                  <path d={glifos(0x2230 + i, 1, 5).d} transform={`translate(${10 + i * 34} 93)`} stroke="#8d7b58" stroke-opacity="0.6" stroke-width="0.7" fill="none" />
                </>
              ))}
            </svg>
          </TarjetaMetrica>
        </RielMetricas>
      </div>

      <div class="arch-caja of-panel of-panel--3">
        <RielMetricas ancho={226} rotulo="índice de coherencia">
          <TarjetaMetrica tituloEn="COHERENCE INDEX" tituloEs="" valor="Ψ 0.963" etiqueta="STABILITY RATIO" conPie={false}>
            <svg width="200" height="158" viewBox="0 0 200 158" fill="none" aria-hidden="true">
              {/* RUEDA DE SIGILOS · medida contra la referencia: el disco llega a
                  r≈70 y los brazos cardinales a r≈96 dentro del panel de 226 px.
                  La nuestra moría en r=56 y por eso la franja y947..1097 salía
                  20 puntos de luminancia por debajo — el mayor hueco del riel. */}
              <g transform="translate(100 79)">
                <circle r="70" stroke="#a98d54" stroke-opacity="0.28" />
                <circle r="64" stroke="#c9ab6a" stroke-opacity="0.45" stroke-dasharray="1.5 4" />
                <circle r="57" stroke="#a98d54" stroke-opacity="0.42" />
                <circle r="46" stroke="#c9ab6a" stroke-opacity="0.5" />
                <circle r="36" stroke="#d8bd85" stroke-opacity="0.58" />
                <circle r="27" stroke="#d8bd85" stroke-opacity="0.68" />
                <circle r="18" stroke="#e8c56a" stroke-opacity="0.72" />
                {angulos(24).map((a) => (
                  <line
                    x1={P(57, a)[0]} y1={P(57, a)[1]} x2={P(64, a)[0]} y2={P(64, a)[1]}
                    stroke="#a98d54" stroke-opacity="0.5"
                  />
                ))}
                <polygon points={poli(36, 3)} stroke="#d8bd85" stroke-opacity="0.62" fill="none" />
                <polygon points={poli(36, 3, 60)} stroke="#d8bd85" stroke-opacity="0.62" fill="none" />
                <polygon points={estrella(27, 18, 12)} stroke="#e8c56a" stroke-opacity="0.42" fill="none" />
                <polygon points={poli(46, 6, 30)} stroke="#c9ab6a" stroke-opacity="0.3" fill="none" />
                {/* corona de glifos pequeños entre los dos anillos medios */}
                {angulos(8, 22.5).map((a) => (
                  <g transform={`translate(${P(51.5, a)[0]} ${P(51.5, a)[1]})`}>
                    <circle r="4.6" stroke="#c9ab6a" stroke-opacity="0.6" />
                    <circle r="1.4" fill="#e8c56a" fill-opacity="0.75" />
                  </g>
                ))}
                {/* cuatro medallones cardinales, con su tallo hacia el centro */}
                {angulos(4).map((a) => (
                  <g>
                    <line
                      x1={P(46, a)[0]} y1={P(46, a)[1]} x2={P(54, a)[0]} y2={P(54, a)[1]}
                      stroke="#c9ab6a" stroke-opacity="0.6"
                    />
                    <g transform={`translate(${P(64, a)[0]} ${P(64, a)[1]})`}>
                      <circle r="9.5" stroke="#d8bd85" stroke-opacity="0.75" />
                      <circle r="5.5" stroke="#c9ab6a" stroke-opacity="0.5" />
