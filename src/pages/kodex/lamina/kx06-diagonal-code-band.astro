---
/**
 * KODEX-∞ · KX-06 · DIAGONAL CODE BAND
 *
 * Reproducción en código de `reference/pendientes/kx06-diagonal-code-band.png`
 * (1122×1402) — la primera lámina construida del lote de Drive del 15/08. La
 * plancha se nombra sola: "DIAGONAL CODE BAND · ISSUE 06 · KX-06", así que el
 * slug no inventa nada.
 *
 * MEDIDO de la referencia, no estimado:
 *   · banda: eje por (602,635) a 47,84° (PCA de los píxeles blancos >230);
 *     ancho perpendicular p5..p95 = 101 px; celda 31 px por autocorrelación.
 *     La plancha DECLARA "ALIGN: 33.333°" — es su texto, se transcribe; el
 *     ángulo real del dibujo es el medido, y manda el dibujo.
 *   · ámbar #d7b114 (1.505 px muestreados) · rosa #c46a8b (459 px).
 *   · 29 glifos y 8 marcas en posiciones exactas (receta del extractor).
 *   · tinta total de la referencia: 118.774 px.
 *
 * TODO el texto está transcrito de la plancha con zoom — pasaje, claves, bloque
 * de datos, pie y rótulos de fragmentos. Nada de copy inventado.
 *
 * La banda es procedural con semilla fija (mulberry32 del kit): celdas de 31 px
 * en 3 filas sobre el eje medido, subgrilla 4×4 por celda. El ciclo de vida es
 * `montarLienzo` — un brillo lento recorre la banda (SLOW FIELD), y congelado
 * el cuadro es idéntico en cualquier fase, así que el banco mide estable.
 */
import "../../../styles/kodex-lamina.css";
import receta from "../../../../scripts/lamina/campo/pend-12.json";

/* Los 29 glifos medidos: cruces KODEX en sus coordenadas exactas. */
const glifos: Array<[number, number, number]> = [];
for (let i = 0; i < receta.glifos.length; i += 3) {
  glifos.push([receta.glifos[i], receta.glifos[i + 1], Math.max(4, receta.glifos[i + 2])]);
}
const pasaje = ["A PASSAGE IS NOT WRITTEN.", "IT IS WOVEN.", "A CODE IS NOT GIVEN.", "IT IS REMEMBERED."];
const claves = ["THE BAND IS THE PATH.", "THE PATTERN IS THE KEY.", "THE KEY IS THE RETURN."];
const datos = ["ALIGN: 33.333°", "VECTOR: PRIMARY", "BAND: ACTIVE", "MODE: PASSAGE"];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · DIAGONAL CODE BAND · KX-06</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="kx06-diagonal-code-band">
      <canvas id="kx06-banda" width="1122" height="1402" style="position:absolute;inset:0;"></canvas>

      <svg viewBox="0 0 1122 1402" style="position:absolute;inset:0;" aria-hidden="true">
        <!-- ── marcas de registro superiores ─────────────────────────── -->
        <text x="420" y="36" class="k6-mini">•••·00·•••</text>
        <g class="k6-star" transform="translate(1052,42)">
          <path d="M0 -26 L4 -6 L0 26 L-4 -6 Z M-22 0 L-5 -3 L22 0 L-5 3 Z" />
        </g>
        <path class="k6-cruz" d="M148 34 h24 M160 22 v24" />

        <!-- ── bloque de título (transcrito) ─────────────────────────── -->
        <text x="718" y="196" class="k6-titulo" textLength="341">KODEX−∞</text>
        <line x1="718" y1="212" x2="1059" y2="212" class="k6-regla" />
        <text x="718" y="248" class="k6-subtitulo" textLength="341">DIAGONAL CODE BAND</text>
        <line x1="718" y1="264" x2="1059" y2="264" class="k6-regla" />

        <!-- el pasaje -->
        {pasaje.map((l, i) => <text x="845" y={324 + i * 28} class="k6-texto">{l}</text>)}
        <text x="845" y="462" class="k6-texto k6-dim">− ◇ −</text>
        {claves.map((l, i) => <text x="845" y={512 + i * 28} class="k6-texto">{l}</text>)}
        <text x="845" y="620" class="k6-texto">◆ KX·06</text>

        <!-- ── bloque de datos (transcrito) ──────────────────────────── -->
        <path class="k6-cruz" d="M129 591 h16 M137 583 v16" />
        {datos.map((l, i) => <text x="161" y={628 + i * 28} class="k6-dato">{l}</text>)}
        <rect x="130" y="736" width="16" height="16" class="k6-caja" />
        <line x1="160" y1="744" x2="330" y2="744" class="k6-regla" />
        <path class="k6-cruz" d="M322 736 v16 M314 744 h16" />

        <!-- ── fragmento de brújula (H-REFERENCE) ────────────────────── -->
        <g transform="translate(210,968)">
          <circle r="118" class="k6-circulo" />
          <circle r="86" class="k6-circulo k6-tenue" />
          <g class="k6-brujula">
            <path d="M0 -96 L7 -14 L0 96 L-7 -14 Z" />
            <path d="M-96 0 L-14 -5 L96 0 L-14 5 Z" />
            <path d="M-48 -48 L-6 -2 L48 48 L-2 -6 Z" opacity=".55" />
            <path d="M48 -48 L2 -6 L-48 48 L6 -2 Z" opacity=".55" />
          </g>
          <circle r="4" class="k6-nucleo" />
        </g>
        <text x="118" y="1122" class="k6-rotulo">COMPASS FRAGMENT</text>
        <text x="118" y="1140" class="k6-rotulo k6-dim">// H-REFERENCE</text>

        <!-- ── fragmento de núcleo (A-REFERENCE), rosa medido ────────── -->
        <g transform="translate(760,1215)">
          <circle r="100" class="k6-rosa-c" />
          <circle r="72" class="k6-rosa-c" opacity=".5" />
          <circle r="40" class="k6-rosa-c" />
          {Array.from({ length: 16 }, (_, k) => {
            const a = (k / 16) * Math.PI * 2;
            return (
              <line
                x1={Math.cos(a) * 18} y1={Math.sin(a) * 18}
                x2={Math.cos(a) * 96} y2={Math.sin(a) * 96}
                class="k6-rosa-r"
              />
            );
          })}
          <path class="k6-rosa-p" d="M0 -52 L30 0 L0 52 L-30 0 Z" />
          <path class="k6-rosa-p" d="M-37 -37 L0 -21 L37 37 L0 21 Z" opacity=".6" />
          <circle r="56" class="k6-rosa-c" opacity=".45" />
          <circle r="9" class="k6-rosa-n" />
        </g>
        <text x="880" y="1300" class="k6-rotulo">CORE FRAGMENT</text>
        <text x="880" y="1318" class="k6-rotulo k6-dim">// A-REFERENCE</text>

        <!-- ── glifos medidos: cruces en sus coordenadas exactas ─────── -->
        {glifos.map(([x, y, r]) => (
          <path class="k6-glifo" d={`M${x - r} ${y} h${r * 2} M${x} ${y - r} v${r * 2}`} />
        ))}

        <!-- ── rieles verticales ─────────────────────────────────────── -->
        <text x="30" y="420" class="k6-riel" transform="rotate(-90 30 420)">DIAGONAL CODE BAND / KX-06</text>
        <text x="1094" y="760" class="k6-riel" transform="rotate(90 1094 760)">33.333°</text>

        <!-- ── pie (transcrito), con sus esquineros ──────────────────── -->
        <path class="k6-esquina" d="M74 1188 v-14 h14 M330 1174 h14 v14 M74 1352 v14 h14 M330 1366 h14 v-14" />
        <path class="k6-cruz" d="M66 1180 h16 M74 1172 v16" />
        <text x="80" y="1236" class="k6-texto">KODEX−∞</text>
        <text x="80" y="1276" class="k6-texto">DIAGONAL CODE BAND</text>
        <text x="80" y="1302" class="k6-texto">ISSUE 06</text>
        <text x="86" y="1390" class="k6-mini">MMXXV</text>
        <path class="k6-esquina" d="M74 1398 v-22" />
      </svg>
    </div>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px; height: 1402px;
        background: #000;
        transform-origin: 0 0;
        font-family: var(--lam-mono);
      }
      .k6-titulo   { fill: #d7b114; font-family: var(--lam-mono); font-size: 66px; font-weight: 700; letter-spacing: .04em; }
      .k6-subtitulo{ fill: #d7b114; font-family: var(--lam-mono); font-size: 30px; letter-spacing: .18em; }
      .k6-regla    { stroke: #d7b114; stroke-width: 1.4; opacity: .8; }
      .k6-texto    { fill: #d7b114; font-family: var(--lam-mono); font-size: 15px; letter-spacing: .1em; }
      .k6-dato     { fill: #d7b114; font-family: var(--lam-mono); font-size: 16px; letter-spacing: .1em; font-weight: 600; }
      .k6-mini     { fill: #d7b114; font-family: var(--lam-mono); font-size: 13px; letter-spacing: .2em; }
      .k6-riel     { fill: #d7b114; font-family: var(--lam-mono); font-size: 12px; letter-spacing: .3em; opacity: .75; }
      .k6-rotulo   { fill: #d7b114; font-family: var(--lam-mono); font-size: 13px; letter-spacing: .16em; }
      .k6-dim      { opacity: .6; }
      .k6-cruz     { stroke: #d7b114; stroke-width: 1.4; fill: none; opacity: .9; }
      .k6-caja     { stroke: #d7b114; stroke-width: 1.4; fill: none; }
      .k6-esquina  { stroke: #d7b114; stroke-width: 1.4; fill: none; opacity: .85; }
      .k6-star     { fill: #f2f2ef; }
      .k6-circulo  { stroke: #cfccc5; stroke-width: 1.1; fill: none; opacity: .55; }
      .k6-tenue    { opacity: .3; }
      .k6-brujula  { fill: #f2f2ef; }
      .k6-nucleo   { fill: #f2f2ef; }
      .k6-glifo    { stroke: #bab6ae; stroke-width: 1.2; fill: none; opacity: .55; }
      .k6-rosa-c   { stroke: #c46a8b; stroke-width: 1.1; fill: none; opacity: .8; }
      .k6-rosa-r   { stroke: #c46a8b; stroke-width: .8; opacity: .6; }
      .k6-rosa-p   { stroke: #c46a8b; stroke-width: 1.2; fill: rgba(196,106,139,.14); }
      .k6-rosa-n   { fill: #c46a8b; }
    </style>

    <script>
      import { montarLienzo } from "../../../components/kodex/lamina/kit/lienzo";
      import { montarEscala } from "../../../components/kodex/lamina/kit/escala";
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";
      import { rng } from "../../../components/kodex/lamina/kit/rng";

      const canvas = document.getElementById("kx06-banda") as HTMLCanvasElement;
      const raiz = document.querySelector("[data-lam]") as HTMLElement;
      const g = canvas.getContext("2d")!;

      /* La banda, con los números medidos de la referencia. */
      const CX = 602, CY = 635;
      const ANG = (47.84 * Math.PI) / 180;
      const CELDA = 31, SUB = 4;
      const CO = Math.cos(ANG), SE = Math.sin(ANG);

      /* Las celdas se deciden UNA vez con semilla fija: el cuadro es idéntico
         en cualquier fase y el banco mide estable. */
      const rnd = rng(0x1206); // KX-06, issue 06
      type Celda = { t: number; fila: number; sub: boolean[] };
      const celdas: Celda[] = [];
      for (let t = -29; t <= 29; t++) {
        for (let fila = -2; fila <= 2; fila++) {
          const borde = Math.abs(fila) === 2;
          if (borde ? rnd() > 0.24 : rnd() > 0.93) continue; // filas ±2 ralas, centro denso
          const sub: boolean[] = [];
          for (let s = 0; s < SUB * SUB; s++) sub.push(rnd() < 0.74);
          celdas.push({ t: t * CELDA, fila, sub });
        }
      }

      const pintar = (fase: number) => {
        g.clearRect(0, 0, 1122, 1402);
        const s = CELDA / SUB;
        for (const c of celdas) {
          const bx = CX + CO * c.t - SE * (c.fila * CELDA);
          const by = CY + SE * c.t + CO * (c.fila * CELDA);
          /* SLOW FIELD: un brillo recorre la banda; congelado (fase fija) el
             cuadro no cambia entre capturas. */
          const onda = 0.82 + 0.18 * Math.cos(Math.PI * 2 * (fase - c.t / 1860));
          g.fillStyle = `rgba(242,242,239,${0.92 * onda})`;
          for (let i = 0; i < SUB; i++)
            for (let j = 0; j < SUB; j++) {
              if (!c.sub[i * SUB + j]) continue;
              const lx = (i - SUB / 2) * s, ly = (j - SUB / 2) * s;
              g.fillRect(
                Math.round(bx + CO * lx - SE * ly),
                Math.round(by + SE * lx + CO * ly),
                Math.ceil(s), Math.ceil(s),
              );
            }
        }
      };

      montarLienzo({ raiz, cuadro: pintar, periodo: 22000, periodoReducido: 60000 });

      montarEscala();
      montarMovil();
    
      import { montarVida } from "../../../lib/kodex/vida/montar";
      montarVida({ id: "kx06-diagonal-code-band" });
    
      import { montarNavegacion } from "../../../components/kodex/lamina/kit/navegacion";
      montarNavegacion();
    
      import { montarTriptico } from "../../../components/kodex/lamina/kit/triptico";
      montarTriptico();
    </script>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>

    <!-- Tarjeta de cruce (costura 3): "cruzar al siguiente estrato" con
         progreso, del diseño del creador. Oculta al congelar (banco intacto). -->
    <a class="lam-siguiente" href="/kodex/lamina/pend-01/">NEXT PLATE · PEND 01 → <i>05/25</i></a>
    <style>
      .lam-siguiente{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:9;
        font:11px ui-monospace,monospace;letter-spacing:.18em;color:rgba(240,237,232,.66);
        text-decoration:none;padding:11px 16px;background:rgba(0,0,0,.5);
        border:1px solid rgba(240,237,232,.16);white-space:nowrap;max-width:92vw;overflow:hidden;text-overflow:ellipsis;}
      .lam-siguiente i{font-style:normal;color:rgba(240,237,232,.38);margin-left:10px}
      .lam-siguiente:hover{color:#fff;border-color:rgba(240,237,232,.45)}
      html[data-kdx-frozen] .lam-siguiente{display:none}
    </style>
  </body>
</html>
