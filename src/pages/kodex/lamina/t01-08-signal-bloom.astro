---
/**
 * KODEX-∞ · LÁMINA t01-08 · SIGNAL BLOOM
 *
 * Segunda lámina, y la primera producida con el método v2: cajas medidas de la
 * referencia antes de escribir una línea, arte fija trazada en vez de dibujada,
 * instrumentos compuestos desde el kit, y cada panel con su propio puntaje para
 * que el agente itere solo.
 *
 * Cajas MEDIDAS (umbral de tinta 9 — los marcos de esta lámina son magenta
 * tenue, con pico 23-28, y con el umbral 26 que servía en DESCENT TUNNEL
 * simplemente no se ven).
 *
 * Trampa encontrada acá y que conviene recordar: el detector automático marcó
 * una columna maestra en x=835 que NO es un marco — es el eje de simetría de la
 * floración. La obra puede fabricar reglas falsas, así que las bandas se miden
 * donde hay chrome y no donde hay organismo.
 *
 * Medir:  node scripts/lamina/iterate.mjs t01-08-signal-bloom
 */
import "../../../styles/kodex-lamina.css";

import Header      from "../../../components/kodex/lamina/t01-08/Header.astro";
import SignalStates from "../../../components/kodex/lamina/t01-08/SignalStates.astro";
import MotionNotes from "../../../components/kodex/lamina/t01-08/MotionNotes.astro";
import TextureCrops from "../../../components/kodex/lamina/t01-08/TextureCrops.astro";
import WaveformSpectral from "../../../components/kodex/lamina/t01-08/WaveformSpectral.astro";
import TransmissionField from "../../../components/kodex/lamina/t01-08/TransmissionField.astro";
import MiniPoster from "../../../components/kodex/lamina/t01-08/MiniPoster.astro";
import MobileTile from "../../../components/kodex/lamina/t01-08/MobileTile.astro";
import PaletteGradient from "../../../components/kodex/lamina/t01-08/PaletteGradient.astro";
import Authentication from "../../../components/kodex/lamina/t01-08/Authentication.astro";
import SignalLogic from "../../../components/kodex/lamina/t01-08/SignalLogic.astro";
import DataTags from "../../../components/kodex/lamina/t01-08/DataTags.astro";
import Footer from "../../../components/kodex/lamina/t01-08/Footer.astro";
import EscenaLamina from "../../../components/kodex/escena/EscenaLamina.astro";

const W = 1672;
const H = 941;

/* PARADAS DE LA CAMARA MOVIL · 2026-08-31
 * Las coordenadas NO se estiman: son las mismas cajas medidas que ya usa
 * el layout de escritorio, abajo en este archivo. El organismo va primero
 * porque debe dominar el primer frame; lo denso espera detras del gesto.
 * cover:true solo en organismos radialmente simetricos -- en los demas
 * recortaria justo lo que hay que ver. */
const paradas = [
  { id: "signalstates", label: "SIGNAL STATES", x: 14, y: 88, w: 488, h: 187 },
  { id: "motionnotes", label: "MOTION NOTES", x: 14, y: 287, w: 488, h: 148 },
  { id: "texturecrops", label: "TEXTURE CROPS", x: 14, y: 447, w: 488, h: 153 },
  { id: "waveformspectral", label: "WAVEFORM SPECTRAL", x: 14, y: 607, w: 488, h: 218 },
  { id: "transmissionfield", label: "TRANSMISSION FIELD", x: 510, y: 87, w: 661, h: 491 },
  { id: "miniposter", label: "MINI POSTER", x: 515, y: 583, w: 204, h: 272 },
  { id: "mobiletile", label: "MOBILE TILE", x: 729, y: 583, w: 194, h: 272 },
  { id: "palettegradient", label: "PALETTE GRADIENT", x: 934, y: 583, w: 229, h: 272 },
  { id: "authentication", label: "AUTHENTICATION", x: 1181, y: 87, w: 485, h: 325 },
  { id: "signallogic", label: "SIGNAL LOGIC", x: 1181, y: 438, w: 485, h: 274 },
  { id: "datatags", label: "DATA TAGS", x: 1181, y: 723, w: 485, h: 127 },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · lámina t01-08 · SIGNAL BLOOM</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      html, body { margin: 0; padding: 0; background: #000; overflow: hidden; }
      .kdx-lam-fit { --s: 1; --tx: 0px; --ty: 0px; position: absolute; inset: 0; overflow: hidden; }
      .kdx-lam-fit > .kdx-lam {
        position: absolute; left: 0; top: 0;
        transform-origin: 0 0;
        transform: translate(var(--tx), var(--ty)) scale(var(--s));
      }
    </style>
  </head>
  <body>
    <div class="kdx-lam-fit">
      <div class="kdx-lam kdx-lam--bloom" style={`width:${W}px;height:${H}px`} data-lamina="t01-08-signal-bloom">
        {/* El andamio inline hacia Math.min(1, vw/1672, vh/941) ES el
            desktop encogido que el creador rechazo el 25-08. EscenaLamina
            conserva ese ajuste en escritorio y en movil lo cambia por camara
            temporal: una parada por gesto, a escala legible. La plancha no se
            redibuja, cambia la camara. */}
        <EscenaLamina lamina="t01-08-signal-bloom" paradas={paradas}>
        <Header            box="left:0;top:0;width:1672px;height:85px" />

          <SignalStates      box="left:14px;top:88px;width:488px;height:187px" />
          <MotionNotes       box="left:14px;top:287px;width:488px;height:148px" />
          <TextureCrops      box="left:14px;top:447px;width:488px;height:153px" />
          <WaveformSpectral  box="left:14px;top:607px;width:488px;height:218px" />

          <TransmissionField box="left:510px;top:87px;width:661px;height:491px" />
          <MiniPoster        box="left:515px;top:583px;width:204px;height:272px" />
          <MobileTile        box="left:729px;top:583px;width:194px;height:272px" />
          <PaletteGradient   box="left:934px;top:583px;width:229px;height:272px" />

          <Authentication    box="left:1181px;top:87px;width:485px;height:325px" />
          <SignalLogic       box="left:1181px;top:438px;width:485px;height:274px" />
          <DataTags          box="left:1181px;top:723px;width:485px;height:127px" />

          <Footer            box="left:0;top:866px;width:1672px;height:75px" />
        </EscenaLamina>
      </div>
    </div>

    <script>
      const sinks = [];
      window.__kdxRegisterFreeze = (fn) => sinks.push(fn);
      window.__kdxFreeze = (t = 0) => {
        for (const fn of sinks) fn(t);
        document.documentElement.dataset.kdxFrozen = "1";
      };
      const fit = document.querySelector(".kdx-lam-fit");
      if (fit) {
        const ajustar = () => {
          const vw = window.innerWidth, vh = window.innerHeight;
          const s = Math.min(1, vw / 1672, vh / 941);
          fit.style.setProperty("--s", String(s));
          fit.style.setProperty("--tx", ((vw - 1672 * s) / 2).toFixed(2) + "px");
          fit.style.setProperty("--ty", ((vh - 941 * s) / 2).toFixed(2) + "px");
        };
        ajustar();
        addEventListener("resize", ajustar, { passive: true });
      }

      /* ── LOS RÓTULOS QUE VIVEN EN <div> ───────────────────────────────────
         Medido a 390 px con el tríptico ya montado: 22 rótulos de ESTA lámina
         —IDLE / BUILD / BLOOM / DISPERSE, PULSE / TRANSMIT / GLITCH / RETURN,
         los cuatro TEXTURE CROPS con sus hexadecimales, y la rotulación de
         WAVEFORM & SPECTRAL— seguían pintados ENCIMA de las páginas SIGNAL y
         EVIDENCE a 2,2-2,9 px efectivos. Ilegibles y, además, repetidos.

         Los dos síntomas tienen UNA causa. El kit lee la plancha con
         `p,h1,h2,h3,strong,b,span,dd,dt,li,em,small` y la hoja la oculta con
         ese mismo `:is(…)`. Estos rótulos son `<div>`, así que caían fuera de
         las dos listas: ni entraban al tríptico —por eso EVIDENCE no los
         tenía— ni se ocultaban con el resto del cromo.

         No se toca el kit (es de todos) ni los bloques de esta lámina (son de
         otro nodo). Se NORMALIZA la plancha antes de que el kit la lea:
         el texto suelto de cada hoja se envuelve en un `<span>`. Entonces el
         kit sí lo transcribe a EVIDENCE, y la regla
         `[data-kdx-tri="0"] :is(… span …)` sí lo oculta en SIGNAL.

         Sólo se envuelven HOJAS —`children.length === 0`— así que el `<span>`
         en línea ocupa exactamente la caja que ocupaba el nodo de texto: no
         hay reflujo posible. Y sólo bajo 560 px: en escritorio a esta plancha
         no se le mueve ni un nodo. */
      if (matchMedia("(max-width:560px)").matches) {
        const HOJAS = "p,h1,h2,h3,strong,b,span,dd,dt,li,em,small";
        const NUNCA = new Set(["SCRIPT", "STYLE", "TITLE", "TEXTAREA", "CANVAS", "OPTION"]);
        const plancha = document.querySelector("[data-lamina]");
        if (plancha) {
          for (const el of plancha.querySelectorAll("*")) {
            if (el.children.length || el.matches(HOJAS)) continue;
            if (NUNCA.has(el.tagName) || el.closest("svg")) continue;
            for (const n of [...el.childNodes]) {
              if (n.nodeType !== 3 || !n.textContent.trim()) continue;
              const s = document.createElement("span");
              s.textContent = n.textContent;
              n.replaceWith(s);
            }
          }
        }
      }

      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";
      montarMovil();
    
      import { montarVida } from "../../../lib/kodex/vida/montar";
      montarVida({ id: "t01-08-signal-bloom" });
    
      import { montarNavegacion } from "../../../components/kodex/lamina/kit/navegacion";
      montarNavegacion();
    
      import { montarTriptico } from "../../../components/kodex/lamina/kit/triptico";
      montarTriptico();
    
      import { montarSonido } from "../../../lib/kodex/sonido-montar";
      montarSonido();
    
      import { montarFases } from "../../../lib/kodex/estado";
      montarFases();
    </script>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>

    <!-- Tarjeta de cruce (costura 3): "cruzar al siguiente estrato" con
         progreso, del diseño del creador. Oculta al congelar (banco intacto). -->
    <a class="lam-siguiente" href="/kodex/lamina/teorema-del-retorno/">NEXT PLATE · TEOREMA DEL RETORNO → <i>14/25</i></a>
    <style>
      .lam-siguiente{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:9;
        font:11px ui-monospace,monospace;letter-spacing:.18em;color:rgba(240,237,232,.66);
        text-decoration:none;padding:11px 16px;background:rgba(0,0,0,.5);
        border:1px solid rgba(240,237,232,.16);white-space:nowrap;max-width:92vw;overflow:hidden;text-overflow:ellipsis;}
      .lam-siguiente i{font-style:normal;color:rgba(240,237,232,.38);margin-left:10px}
      .lam-siguiente:hover{color:#fff;border-color:rgba(240,237,232,.45)}
      html[data-kdx-frozen] .lam-siguiente{display:none}
    </style>
  </body>
</html>
