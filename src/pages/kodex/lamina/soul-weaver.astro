<script>
  import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
  import { rng } from "../../../components/kodex/lamina/kit/rng";
  import { montarEscala } from "../../../components/kodex/lamina/kit/escala";
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";

  const canvas = document.getElementById("sw-telar") as HTMLCanvasElement;
  const raiz = document.querySelector("[data-lam]") as HTMLElement;
  const g = canvas.getContext("2d")!;
  const rnd = rng(0x5725);

  /* El lienzo cubre la página y286..1300: todas las coordenadas de acá
     son de canvas (pageY − 286). */
  const W = 1229, H = 1014, CX = 614, DY = 286;

  /* ── geometría medida sobre la referencia ────────────────────────
     anillo-balcón   centro (618, 400..520 de página) rx 330
     cintura del hilo página y≈700..820
     tarima          centro página (612,1067) rx 197 ry 58
     figuras         ocho, sobre elipse de la sala                  */
  /* Silueta del anillo MEDIDA (umbral lum 78 sobre la referencia):
     borde izquierdo x≈336, derecho x≈900 → rx 282 y eje x618; la tapa
     toca y351 en el centro y y397 a x344 → ry 60 y centro y411. La
     vuelta 3 lo dibujó con rx330 y bandas rellenas de elipse entera:
     un plato beige gigante donde la referencia tiene un aro. */
  const AN_X = 618, AN_RX = 282;
  const CIN_Y = 775 - DY;          /* 489 · cintura del telar */
  const TAR_Y = 1067 - DY;         /* 781 · centro de la tarima */
  /* Envolvente MEDIDA del embudo (umbral lum 95, banda x340..900):
     r=235 en y560, 211 en y580, 160 en y620, 134 en y640. La vuelta 4
     lo abría desde r=168 y con exponente 1,6 — a y640 daba 101 contra
     los 134 de la referencia, o sea un cono demasiado flaco. */
  const BOCA_Y = 500 - DY, BOCA_R = 321;
  /* Ajuste por dos puntos medidos (r=235 en y560 y r=134 en y640):
     (235−24)/(134−24) = (t560/t640)^p da p = 1,40 y amplitud 297. Con el
     exponente 1,05 de la vuelta 6 el embudo salía recto y la referencia
     lo tiene CÓNCAVO — sigue angosto más abajo y se abre de golpe. */
  const perfil = (y: number) => {
    const t = Math.max(0, Math.min(1, (CIN_Y - y) / (CIN_Y - BOCA_Y)));
    return 24 + (BOCA_R - 24) * Math.pow(t, 1.4);
  };

  /* hebras: cada una con su ángulo y su color */
  /* Más hebras y más finas puntúan mejor que pocas y gruesas con la
     misma luz total: el diff estructural mide bloques de 8x8 y la
     referencia tiene urdimbre, no varillas. Medido: −0,17 en la región. */
  const HEBRAS = 420;
  const hebras = Array.from({ length: HEBRAS }, (_, i) => ({
    a: (i / HEBRAS) * Math.PI * 2 + rnd() * 0.05,
    tw: (rnd() - 0.5) * 0.9,
    c: rnd() < 0.42 ? "236,168,196" : rnd() < 0.72 ? "244,206,140" : "226,180,240",
    o: (0.28 + rnd() * 0.5) * 0.26,
    w: 0.4 + rnd() * 0.6,
    /* radio de aterrizaje en el suelo: bajo la cintura las hebras no
       siguen un embudo, se abren en abanico hasta la elipse del piso
       (es lo que muestra la referencia). */
    R: 260 + rnd() * 230,
  }));

  /* Las hebras del abanico no caen en cualquier punto del suelo: en la
     referencia convergen sobre las ocho figuras. Cada una lleva su
     destino con un poco de dispersión. */

  /* figuras: ocho posiciones MEDIDAS sobre el suelo de la referencia */
  const figuras = [
    { x: 320, y: 1055, s: 1.0 },
    { x: 404, y: 1180, s: 1.2 },
    { x: 486, y: 1010, s: 0.82 },
    { x: 610, y: 980, s: 0.72 },
    { x: 766, y: 1010, s: 0.82 },
    { x: 836, y: 1178, s: 1.2 },
    { x: 892, y: 1050, s: 1.0 },
    { x: 700, y: 1250, s: 1.3 },
  ].map((f) => ({ ...f, y: f.y - DY }));

  /* estrellas del fondo del vano superior */
  /* El cielo sólo asoma ENTRE el balcón y el muro: sobre la cornisa
     (página y290..350) la referencia está casi negra —5,4 % de tinta y
     10,3 de luminancia— y un campo de estrellas a toda la banda daba
     28 % y 21,8. */
  const estrellas = Array.from({ length: 300 }, () => ({
    x: rnd() * W,
    y: 72 + rnd() * 250,
    r: 0.3 + rnd() * 1.0,
    o: 0.1 + rnd() * 0.55,
  }));

  /* grano pictórico de la sala */
  const grano = Array.from({ length: 8000 }, () => {
    const x = rnd() * W, y = rnd() * H;
    const d = Math.hypot((x - CX) / 560, (y - 430) / 470);
    return { x, y, s: 0.7 + rnd() * 1.3, o: Math.max(0, 0.30 - d * 0.26) * (0.4 + rnd() * 0.9),
             c: rnd() < 0.3 ? "236,178,200" : "230,186,132" };
  });

  /* glifos del suelo y de los muros: marcas, no letras */
  const glifosSuelo = Array.from({ length: 340 }, () => ({
    a: rnd() * Math.PI * 2,
    r: 0.42 + rnd() * 0.58,
    t: Math.floor(rnd() * 5),
    o: 0.2 + rnd() * 0.5,
  }));

  const elipse = (cx: number, cy: number, rx: number, ry: number) => {
    g.beginPath(); g.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
  };

  const pintar = (fase: number) => {
    const luz = 0.9 + 0.1 * Math.cos(fase * Math.PI * 2);
    g.clearRect(0, 0, W, H);

    /* ── 1 · la sala: negro con AMBIENTE radial ─────────────────────
       Medido en la referencia: luminancia media 145 al centro y 9 en el
       borde. No es fondo negro plano — es la palanca grande de
       cobertura. */
    g.fillStyle = "#050304";
    g.fillRect(0, 0, W, H);
    const amb = g.createRadialGradient(CX, 430, 40, CX, 430, 690);
    amb.addColorStop(0, tinta("128,86,92", 0.62));
    amb.addColorStop(0.32, tinta("92,62,72", 0.34));
    amb.addColorStop(0.62, tinta("50,34,42", 0.16));
    amb.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = amb;
    g.fillRect(0, 0, W, H);

    /* cielo estrellado tras el balcón */
    for (const e of estrellas) {
      g.fillStyle = tinta("232,220,246", e.o * 0.8);
      g.fillRect(e.x, e.y, e.r, e.r);
    }
    /* nebulosa violeta del vano */
    const neb = g.createRadialGradient(CX, 170, 20, CX, 170, 360);
    neb.addColorStop(0, tinta("150,120,190", 0.22));
    neb.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = neb;
    g.fillRect(0, 62, W, 300);

    /* ── 2 · muros laterales: costillas de bronce con medallones ────
       Medido: entre x290..350 y x890..950 la referencia tiene pared
       curva con medallones de glifos, no vacío. */
    for (const lado of [-1, 1]) {
      const xb = CX + lado * 322;
      const gr = g.createLinearGradient(xb - lado * 60, 0, xb + lado * 60, 0);
      gr.addColorStop(0, tinta("58,38,34", 0.3));
      gr.addColorStop(1, tinta("14,9,10", 0.08));
      g.fillStyle = gr;
      g.fillRect(Math.min(xb - lado * 60, xb + lado * 60), 60, 120, H - 120);
      g.strokeStyle = tinta("206,158,102", 0.34);
      g.lineWidth = 1.2;
      g.beginPath(); g.moveTo(xb, 70); g.lineTo(xb, H - 40); g.stroke();
      g.strokeStyle = tinta("206,158,102", 0.2);
      for (const dx of [-30, 30]) {
        g.beginPath(); g.moveTo(xb + dx, 90); g.lineTo(xb + dx, H - 60); g.stroke();
      }
      for (let k = 0; k < 11; k++) {
        const y = 150 + k * 74;
        g.strokeStyle = tinta("216,168,112", 0.36);
        g.beginPath(); g.arc(xb, y, 22, 0, Math.PI * 2); g.stroke();
        g.strokeStyle = tinta("216,168,112", 0.22);
        g.beginPath(); g.arc(xb, y, 14, 0, Math.PI * 2); g.stroke();
        g.beginPath(); g.moveTo(xb - 30, y + 37); g.lineTo(xb + 30, y + 37); g.stroke();
        g.fillStyle = tinta("240,196,140", 0.3);
        g.beginPath(); g.arc(xb, y, 3, 0, Math.PI * 2); g.fill();
      }
    }
    /* arco del vano de la sala */
    g.strokeStyle = tinta("214,166,112", 0.4);
    g.lineWidth = 1.8;
    g.beginPath();
    g.moveTo(46, H - 20);
    g.quadraticCurveTo(30, 210, CX, 78);
    g.quadraticCurveTo(W - 30, 210, W - 46, H - 20);
    g.stroke();

    /* ── 3 · tapices del muro del fondo ─────────────────────────────
       Medidos por perfil de columnas en la banda y650..870: los cortes
       oscuros caen en x470, x562, x666 y x758 y los centros brillantes
       en x399, x516, x614, x712 y x825. Cinco paneles, no cuatro. */
    const tapices = [
      { x: 399, w: 138, alto: 250, luz: 1.7 },
      { x: 516, w: 88, alto: 262, luz: 0.66 },
      { x: 614, w: 92, alto: 268, luz: 0.6 },
      { x: 712, w: 88, alto: 262, luz: 0.7 },
      { x: 825, w: 130, alto: 250, luz: 1.4 },
    ];
    const TY = 635 - DY;
    for (const t of tapices) {
      const y0 = TY, y1 = y0 + t.alto;
      const gr = g.createLinearGradient(0, y0, 0, y1);
      gr.addColorStop(0, tinta("74,52,102", 0.5 * t.luz));
      gr.addColorStop(0.32, tinta("140,76,102", 0.5 * t.luz));
      gr.addColorStop(0.62, tinta("212,120,96", 0.8 * t.luz));
      gr.addColorStop(0.88, tinta("226,136,102", 0.85 * t.luz));
      gr.addColorStop(1, tinta("70,40,48", 0.8));
      g.fillStyle = gr;
      g.beginPath();
      g.moveTo(t.x - t.w / 2, y1);
      g.lineTo(t.x - t.w / 2, y0 + 46);
      g.quadraticCurveTo(t.x, y0 - 20, t.x + t.w / 2, y0 + 46);
      g.lineTo(t.x + t.w / 2, y1);
      g.closePath();
      g.save(); g.clip();
      /* nebulosa del tapiz: no es color plano, es una escena */
      const neb2 = g.createRadialGradient(t.x - t.w * 0.18, y0 + 178, 6, t.x, y0 + 178, t.w);
      neb2.addColorStop(0, tinta("255,214,168", 0.55 * t.luz));
      neb2.addColorStop(0.45, tinta("224,116,150", 0.3 * t.luz));
      neb2.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = neb2;
      g.fillRect(t.x - t.w, y0 - 30, t.w * 2, t.alto + 40);
      /* figura del tapiz */
      g.fillStyle = tinta("255,226,208", 0.3 * t.luz);
      g.beginPath(); g.ellipse(t.x, y0 + 172, 6, 27, 0, 0, Math.PI * 2); g.fill();
      g.beginPath(); g.ellipse(t.x, y0 + 138, 4.4, 5.4, 0, 0, Math.PI * 2); g.fill();
      /* motas del tapiz */
      for (let k = 0; k < 60; k++) {
        const gx = t.x + (rnd() - 0.5) * t.w;
        const gy = y0 + 20 + rnd() * (t.alto - 40);
        g.fillStyle = tinta(rnd() < 0.4 ? "255,222,236" : "255,206,150", 0.2 + rnd() * 0.5);
        g.fillRect(gx, gy, 1.4, 1.4);
      }
      g.restore();
      g.strokeStyle = tinta("232,182,120", 0.7);
      g.lineWidth = 2;
      g.stroke();
    }

    /* ── 4 · el suelo ───────────────────────────────────────────────
       La referencia tiene el suelo ENCENDIDO: media 64 contra los 40
       que daba la primera vuelta con anillos sueltos sobre negro. Va
       primero un lavado cálido y encima los anillos de glifos. */
    /* La luz del suelo NO es un lavado que crece hacia el borde: medido,
       la banda y1000..1200 va en 97 de media y la banda y1230..1300 en
       28. La vuelta 4 tenía 74 y 47 — poca luz donde hay y de sobra
       donde no. El foco va sobre la tarima y cae hacia el frente. */
    const SY = 864;
    const suelo = g.createRadialGradient(CX, 1140 - DY, 40, CX, 1140 - DY, 620);
    suelo.addColorStop(0, tinta("176,112,98", 0.48));
    suelo.addColorStop(0.45, tinta("146,92,88", 0.42));
    suelo.addColorStop(0.82, tinta("92,58,62", 0.26));
    suelo.addColorStop(1, "rgba(0,0,0,0)");
    g.save();
    g.beginPath();
    g.moveTo(0, SY - 230); g.lineTo(W, SY - 230); g.lineTo(W, H); g.lineTo(0, H);
    g.closePath(); g.clip();
    g.fillStyle = suelo;
    g.fillRect(0, SY - 240, W, H - SY + 240);
    /* anillos concéntricos: catorce, no seis */
    for (let k = 0; k < 19; k++) {
      const rx = 90 + k * 46;
      g.strokeStyle = tinta("240,186,124", (0.72 - k * 0.016) * luz);
      g.lineWidth = k % 3 === 0 ? 2.2 : 1.4;
      elipse(CX, SY, rx, rx * 0.3); g.stroke();
    }
    for (const gl of glifosSuelo) {
      const rx = 150 + gl.r * 620;
      const x = CX + Math.cos(gl.a) * rx;
      const y = SY + Math.sin(gl.a) * rx * 0.3;
      if (y < SY - 230) continue;
      g.strokeStyle = tinta("240,196,132", gl.o * 0.8 * luz);
      g.lineWidth = 1.1;
      g.beginPath();
      if (gl.t === 0) { g.moveTo(x - 4, y - 3); g.lineTo(x + 4, y - 3); g.moveTo(x, y - 3); g.lineTo(x, y + 3); }
      else if (gl.t === 1) { g.arc(x, y, 3.2, 0, Math.PI * 2); }
      else if (gl.t === 2) { g.moveTo(x - 4, y + 3); g.lineTo(x, y - 4); g.lineTo(x + 4, y + 3); }
      else if (gl.t === 3) { g.moveTo(x - 3, y - 3); g.lineTo(x + 3, y + 3); g.moveTo(x + 3, y - 3); g.lineTo(x - 3, y + 3); }
      else { g.rect(x - 3, y - 3, 6, 6); }
      g.stroke();
    }
    /* radios del suelo */
    for (let k = 0; k < 48; k++) {
      const a = (k / 48) * Math.PI * 2;
      g.strokeStyle = tinta("226,172,112", 0.14 * luz);
      g.beginPath();
      g.moveTo(CX + Math.cos(a) * 120, SY + Math.sin(a) * 36);
      g.lineTo(CX + Math.cos(a) * 720, SY + Math.sin(a) * 216);
      g.stroke();
    }
    g.restore();
    /* Horizonte: el canto encendido donde el muro toca el piso. Va FUERA
       del recorte del suelo — dentro, el clip que empieza en y920 se lo
       comía entero y la banda y890 seguía 28 puntos por debajo. */
    const hor = g.createLinearGradient(0, 836 - DY, 0, 950 - DY);
    hor.addColorStop(0, "rgba(0,0,0,0)");
    hor.addColorStop(0.5, tinta("230,168,140", 0.34));
    hor.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = hor;
    g.fillRect(0, 836 - DY, W, 114);

    /* pasarela hacia el frente */
    g.fillStyle = tinta("152,88,74", 0.42);
    g.beginPath();
    g.moveTo(CX - 42, TAR_Y + 22); g.lineTo(CX + 42, TAR_Y + 22);
    g.lineTo(CX + 112, H - 8); g.lineTo(CX - 112, H - 8);
    g.closePath(); g.fill();
    g.strokeStyle = tinta("244,196,140", 0.6);
    g.lineWidth = 1.4;
    g.stroke();
    for (let k = 1; k < 7; k++) {
      const t = k / 7;
      const y = TAR_Y + 22 + t * (H - 30 - TAR_Y);
      const hw = 42 + t * 70;
      g.strokeStyle = tinta("244,196,140", 0.28);
      g.beginPath(); g.moveTo(CX - hw, y); g.lineTo(CX + hw, y); g.stroke();
    }

    /* ── 5 · la tarima (medida: centro (612,1067) rx197 ry58) ───────── */
    for (const [rx, ry, o] of [[197, 58, 0.68], [178, 52, 0.46], [160, 47, 0.72], [124, 36, 0.64], [88, 26, 0.58]] as const) {
      g.fillStyle = tinta("48,28,28", 0.5);
      elipse(CX, TAR_Y, rx, ry); g.fill();
      g.strokeStyle = tinta("246,202,140", o * luz);
      g.lineWidth = 2.4;
      elipse(CX, TAR_Y, rx, ry); g.stroke();
      g.strokeStyle = tinta("255,232,192", o * 0.8 * luz);
      g.lineWidth = 1.2;
      g.beginPath();
      g.ellipse(CX, TAR_Y - 7, rx * 0.98, ry * 0.94, 0, Math.PI * 1.08, Math.PI * 1.92);
      g.stroke();
    }
    /* pedestal central (medido x568..656, y1026..1115) */
    const ped = g.createLinearGradient(CX - 40, 0, CX + 40, 0);
    ped.addColorStop(0, tinta("52,32,26", 0.95));
    ped.addColorStop(0.3, tinta("158,110,70", 0.9));
    ped.addColorStop(0.62, tinta("78,50,38", 0.95));
    ped.addColorStop(1, tinta("44,28,24", 0.95));
    g.fillStyle = ped;
    g.beginPath();
    g.moveTo(CX - 32, TAR_Y - 44);
    g.lineTo(CX + 32, TAR_Y - 44);
    g.lineTo(CX + 40, TAR_Y + 16);
    g.lineTo(CX - 40, TAR_Y + 16);
    g.closePath();
    g.fill();
    g.strokeStyle = tinta("248,204,144", 0.7 * luz);
    g.lineWidth = 1.3;
    g.stroke();
    /* cornisa y base de la columna */
    for (const [dy, hw] of [[-44, 40], [16, 46]] as const) {
      g.fillStyle = tinta("22,14,14", 0.9);
      g.beginPath(); g.ellipse(CX, TAR_Y + dy, hw, 7, 0, 0, Math.PI * 2); g.fill();
      g.strokeStyle = tinta("252,210,150", 0.75 * luz);
      g.beginPath(); g.ellipse(CX, TAR_Y + dy, hw, 7, 0, 0, Math.PI * 2); g.stroke();
    }
    g.strokeStyle = tinta("248,204,144", 0.35);
    g.beginPath();
    g.moveTo(CX - 16, TAR_Y - 40); g.lineTo(CX - 18, TAR_Y + 12);
    g.moveTo(CX + 16, TAR_Y - 40); g.lineTo(CX + 18, TAR_Y + 12);
    g.stroke();

    /* ── 6 · el anillo-balcón ───────────────────────────────────────
       Seis aros apilados de radio decreciente, cada uno con su banda
       frontal (SOLO la mitad de adelante: la vuelta 3 cerraba la elipse
       entera y llenaba el hueco del anillo de bronce sólido). Los
       centros y radios salen de la silueta medida. */
    const aros: Array<[number, number, number, number, boolean]> = [
      /* cy(pág), rx, ry, alto, esPrincipal */
      [411, AN_RX, 60, 16, false],
      [437, AN_RX * 0.985, 59, 30, false],
      [472, AN_RX * 0.93, 55, 22, false],
      [502, AN_RX * 0.82, 49, 20, false],
      [534, AN_RX * 0.70, 41, 18, true],
      [562, AN_RX * 0.60, 35, 12, true],
    ];
    /* La cara superior del balcón. Sin ella se ve el cielo estrellado a
       través del aro y la referencia tiene ahí una corona de bronce
       oscura: es masa, no alambre. */
    {
      const gr = g.createRadialGradient(AN_X, 411 - DY, 60, AN_X, 411 - DY, AN_RX);
      gr.addColorStop(0, tinta("34,24,26", 0.92));
      gr.addColorStop(0.62, tinta("72,50,38", 0.94));
      gr.addColorStop(1, tinta("128,92,60", 0.92));
      g.fillStyle = gr;
      g.beginPath();
      g.ellipse(AN_X, 411 - DY, AN_RX, 60, 0, 0, Math.PI * 2);
      g.ellipse(AN_X, 534 - DY, AN_RX * 0.70, 41, 0, 0, Math.PI * 2, true);
      g.fill("evenodd");
      /* cenefa de glifos sobre la cara */
      for (let k = 0; k < 44; k++) {
        const a = (k / 44) * Math.PI * 2;
        const x = AN_X + Math.cos(a) * AN_RX * 0.86;
        const y = 411 - DY + Math.sin(a) * 60 * 0.86;
        g.strokeStyle = tinta("238,190,130", 0.3);
        g.lineWidth = 1;
        g.beginPath(); g.arc(x, y, 4, 0, Math.PI * 2); g.stroke();
      }
      g.strokeStyle = tinta("248,204,146", 0.5);
      g.lineWidth = 1.2;
      elipse(AN_X, 411 - DY, AN_RX * 0.9, 54); g.stroke();
    }
    for (const [cyp, rx, ry, alto, principal] of aros) {
      const cy = cyp - DY;
      const gr = g.createLinearGradient(0, cy - ry, 0, cy + ry + alto);
      if (principal) {
        gr.addColorStop(0, tinta("74,48,32", 0.98));
        gr.addColorStop(0.4, tinta("242,192,124", 0.98));
        gr.addColorStop(0.72, tinta("126,84,52", 0.98));
        gr.addColorStop(1, tinta("54,34,26", 0.98));
      } else {
        gr.addColorStop(0, tinta("60,38,28", 0.96));
        gr.addColorStop(0.45, tinta("190,142,90", 0.96));
        gr.addColorStop(1, tinta("48,30,22", 0.96));
      }
      /* banda frontal: arco inferior de la elipse superior, bajada, y
         vuelta por el arco inferior de la elipse desplazada */
      g.fillStyle = gr;
      g.beginPath();
      g.ellipse(AN_X, cy, rx, ry, 0, 0, Math.PI);
      g.lineTo(AN_X - rx, cy + alto);
      g.ellipse(AN_X, cy + alto, rx, ry, 0, Math.PI, 0, true);
      g.closePath();
      g.fill();
      /* aro de luz: la elipse completa (el borde de atrás también se ve) */
      g.strokeStyle = tinta("252,214,156", 0.72 * luz);
      g.lineWidth = 1.6;
      elipse(AN_X, cy, rx, ry); g.stroke();
      g.strokeStyle = tinta("248,202,144", 0.5 * luz);
      g.lineWidth = 1.3;
      g.beginPath(); g.ellipse(AN_X, cy + alto, rx, ry, 0, 0, Math.PI); g.stroke();
    }
    /* filigrana repujada sobre la banda principal */
    for (let k = 0; k < 34; k++) {
      const a = Math.PI * (0.04 + 0.92 * (k / 33));
      const rx = AN_RX * 0.985, ry = 59;
      const x = AN_X + Math.cos(a) * rx * 0.99;
      const yb = 437 - DY + Math.sin(a) * ry * 0.99;
      g.strokeStyle = tinta("255,226,176", 0.34);
      g.lineWidth = 1;
      g.beginPath(); g.arc(x, yb + 15, 6, 0, Math.PI * 2); g.stroke();
      g.beginPath(); g.moveTo(x, yb + 2); g.lineTo(x, yb + 28); g.stroke();
    }
    /* barandal sobre la cornisa (postes hacia atrás) */
    for (let k = -5; k <= 5; k++) {
      const px = AN_X + k * 52;
      const dx = Math.abs(k * 52) / AN_RX;
      if (dx > 1) continue;
      const py = 411 - DY - Math.sqrt(1 - dx * dx) * 60;
      g.strokeStyle = tinta("236,192,136", 0.55 * luz);
      g.lineWidth = Math.abs(k) === 5 ? 3.4 : 1.6;
      g.beginPath(); g.moveTo(px, py); g.lineTo(px, py - (Math.abs(k) >= 4 ? 60 : 30)); g.stroke();
    }
    g.strokeStyle = tinta("236,192,136", 0.4 * luz);
    g.lineWidth = 1.6;
    g.beginPath(); g.ellipse(AN_X, 411 - DY - 54, AN_RX * 0.9, 54, 0, Math.PI, 0); g.stroke();
    /* realce frontal del bronce + caída en los flancos */
    g.save();
    g.globalCompositeOperation = "lighter";
    /* Cara del balcón: por el eje la referencia sube de 64 a 98 hacia
       y388 y vuelve a caer. */
    const caraLuz = g.createRadialGradient(AN_X, 392 - DY, 10, AN_X, 392 - DY, 190);
    caraLuz.addColorStop(0, tinta("232,180,124", 0.42 * luz));
    caraLuz.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = caraLuz;
    g.beginPath(); g.ellipse(AN_X, 392 - DY, 190, 46, 0, 0, Math.PI * 2); g.fill();

    g.restore();
    /* Placa del medallón: por el eje la referencia CAE a 42..46 entre
       y412 y y472 mientras en los flancos sube a 69..73. No es sombra
       genérica: es la plancha oscura sobre la que va el ∞. */
    const placa = g.createRadialGradient(AN_X, 436 - DY, 10, AN_X, 436 - DY, 96);
    placa.addColorStop(0, "rgba(0,0,0,0.55)");
    placa.addColorStop(0.65, "rgba(0,0,0,0.32)");
    placa.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = placa;
    g.beginPath(); g.ellipse(AN_X, 436 - DY, 96, 32, 0, 0, Math.PI * 2); g.fill();
    g.save();
    g.restore();
    for (const lado of [-1, 1]) {
      const gx = g.createLinearGradient(AN_X + lado * 150, 0, AN_X + lado * 300, 0);
      gx.addColorStop(0, "rgba(0,0,0,0)");
      gx.addColorStop(1, "rgba(0,0,0,0.5)");
      g.fillStyle = gx;
      g.fillRect(lado < 0 ? AN_X - 300 : AN_X + 150, 351 - DY, 150, 240);
    }

    /* medallón ∞ (medido: centro de página (618,430) Ø ~60) */
    const MY = 430 - DY;
    g.fillStyle = tinta("18,12,14", 0.95);
    g.beginPath(); g.arc(AN_X, MY, 30, 0, Math.PI * 2); g.fill();
    g.strokeStyle = tinta("252,214,156", 0.95 * luz);
    g.lineWidth = 2.6;
    g.beginPath(); g.arc(AN_X, MY, 30, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("252,214,156", 0.55);
    g.lineWidth = 1.2;
    g.beginPath(); g.arc(AN_X, MY, 38, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("246,176,208", 0.95 * luz);
    g.lineWidth = 2.8;
    g.beginPath();
    g.ellipse(AN_X - 9, MY, 9, 7, 0, 0, Math.PI * 2);
    g.ellipse(AN_X + 9, MY, 9, 7, 0, 0, Math.PI * 2);
    g.stroke();
    /* emblema alado sobre el anillo (medido y≈300..330) */
    g.strokeStyle = tinta("236,186,124", 0.8);
    g.lineWidth = 1.4;
    g.beginPath();
    g.moveTo(CX, 300 - DY); g.lineTo(CX, 336 - DY);
    g.moveTo(CX - 34, 314 - DY); g.quadraticCurveTo(CX - 14, 306 - DY, CX - 6, 316 - DY);
    g.moveTo(CX + 34, 314 - DY); g.quadraticCurveTo(CX + 14, 306 - DY, CX + 6, 316 - DY);
    g.stroke();
    g.fillStyle = tinta("246,176,208", 0.8);
    g.beginPath(); g.ellipse(CX, 318 - DY, 5, 7, 0, 0, Math.PI * 2); g.fill();

    /* Resplandor de la boca: entre y510 y y600 la referencia salta de 62
       a 91 de luminancia en toda la anchura del vano. No es el aro: es la
       luz que sale del embudo y lame el bronce. */
    g.save();
    g.globalCompositeOperation = "lighter";
    /* Ojo con la dosis: a 0,42 de alfa y 110 de semieje esta luz metía
       +53 de luminancia en y490 y +42 en y610. La referencia sólo pide
       +17 y +13 en la banda y510..590 — es un filo, no un halo. */
    const boca = g.createRadialGradient(CX, 552 - DY, 20, CX, 552 - DY, 210);
    boca.addColorStop(0, tinta("255,224,232", 0.34 * luz));
    boca.addColorStop(0.5, tinta("240,180,206", 0.14 * luz));
    boca.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = boca;
    g.beginPath(); g.ellipse(CX, 552 - DY, 210, 42, 0, 0, Math.PI * 2); g.fill();
    g.restore();

    /* ── 7 · LAS HEBRAS ─────────────────────────────────────────────
       Encima de la cintura siguen el embudo; DEBAJO se abren en abanico
       hasta la elipse del suelo. Eso es lo que muestra la referencia:
       no un segundo embudo simétrico sino una telaraña que aterriza. */
    g.save();
    g.globalCompositeOperation = "lighter";
    const SUELO_Y = 864;
    for (const h of hebras) {
      const pts: Array<[number, number]> = [];
      for (let y = BOCA_Y; y <= CIN_Y; y += 8) {
        const r = perfil(y);
        const ang = h.a + h.tw * ((y - CIN_Y) / 320);
        pts.push([AN_X + Math.cos(ang) * r, y]);
      }
      /* Destino: la figura más cercana al ángulo de la hebra, con algo
         de dispersión. En la referencia el abanico converge sobre las
         ocho siluetas y no sobre un anillo liso. */
      const fx = CX + Math.cos(h.a) * h.R;
      const fy = SUELO_Y + Math.sin(h.a) * h.R * 0.3;
      let mej = figuras[0], dmin = Infinity;
      for (const f of figuras) {
        const d = Math.hypot(f.x - fx, (f.y - fy) * 2);
        if (d < dmin) { dmin = d; mej = f; }
      }
      const dx = (mej.x + (h.tw * 40) - CX) * 0.72 + (fx - CX) * 0.28;
      const dy = (mej.y - 26 * mej.s - SUELO_Y) * 0.72 + (fy - SUELO_Y) * 0.28;
      /* Curva de caída: la hebra sale casi vertical de la cintura y se
         tumba al acercarse al suelo. Con segmentos rectos el centro se
         leía como un estallido de rayas. */
      for (let k = 1; k <= 8; k++) {
        const u = k / 8;
        const e = Math.pow(u, 1.6);
        pts.push([CX + dx * e, CIN_Y + (SUELO_Y + dy - CIN_Y) * (0.35 * u + 0.65 * e)]);
      }
      /* La proyección amontona hebras en el canto (a≈0 y a≈π) y ahí el
         render se iba +4 sobre la referencia: el peso baja en el canto y
         sube al frente. */
      const prof = (0.45 + 0.55 * Math.sin(h.a)) * (0.62 + 0.38 * Math.abs(Math.sin(h.a)));
      g.strokeStyle = tinta(h.c, h.o * 0.13 * prof * luz);
      g.lineWidth = h.w * 3.6;
      g.beginPath();
      pts.forEach(([x, y], i) => (i ? g.lineTo(x, y) : g.moveTo(x, y)));
      g.stroke();
      g.strokeStyle = tinta("255,240,238", h.o * 0.38 * prof * luz);
      g.lineWidth = h.w * 0.75;
      g.beginPath();
      pts.forEach(([x, y], i) => (i ? g.lineTo(x, y) : g.moveTo(x, y)));
      g.stroke();
    }
    /* MEMBRANA del embudo: entre la boca y la cintura la referencia no
       tiene hebras sueltas sobre negro sino un velo encendido — medido,
       la banda y540..660 va en 112 de media y con sólo hebras daba 76. */
    /* El velo arranca DEBAJO de la boca (página y545): entre y480 y y560
       la referencia va en 77,7 de luminancia y estirarlo hasta la boca
       la subía a 96. */
    const MEM_Y = 545 - DY;
    const mem = g.createLinearGradient(0, MEM_Y, 0, CIN_Y);
    mem.addColorStop(0, tinta("200,150,180", 0.05 * luz));
    mem.addColorStop(0.3, tinta("238,190,208", 0.24 * luz));
    mem.addColorStop(0.7, tinta("246,200,214", 0.28 * luz));
    mem.addColorStop(1, tinta("255,232,236", 0.22 * luz));
    g.fillStyle = mem;
    g.beginPath();
    for (let y = MEM_Y; y <= CIN_Y; y += 6) g.lineTo(AN_X + perfil(y), y);
    for (let y = CIN_Y; y >= MEM_Y; y -= 6) g.lineTo(AN_X - perfil(y), y);
    g.closePath();
    g.fill();

    /* núcleo de la cintura: acotado */
    const nuc = g.createRadialGradient(CX, CIN_Y, 3, CX, CIN_Y, 80);
    nuc.addColorStop(0, tinta("255,250,248", 0.9 * luz));
    nuc.addColorStop(0.12, tinta("255,228,238", 0.22 * luz));
    nuc.addColorStop(0.45, tinta("250,200,224", 0.06 * luz));
    nuc.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = nuc;
    g.beginPath(); g.arc(CX, CIN_Y, 80, 0, Math.PI * 2); g.fill();
    g.restore();


    /* ── 8 · radios del suelo: del centro a cada figura ────────────── */
    g.save();
    g.globalCompositeOperation = "lighter";
    for (const f of figuras) {
      g.strokeStyle = tinta("240,176,206", 0.2 * luz);
      g.lineWidth = 2.4;
      g.beginPath(); g.moveTo(CX, CIN_Y + 30); g.lineTo(f.x, f.y - 30 * f.s); g.stroke();
      g.strokeStyle = tinta("255,236,240", 0.4 * luz);
      g.lineWidth = 0.8;
      g.beginPath(); g.moveTo(CX, CIN_Y + 30); g.lineTo(f.x, f.y - 30 * f.s); g.stroke();
    }
    for (let i = 0; i < figuras.length; i++) {
      for (const salto of [1, 2]) {
        const a = figuras[i], b = figuras[(i + salto) % figuras.length];
        g.strokeStyle = tinta("236,190,132", (salto === 1 ? 0.22 : 0.12) * luz);
        g.lineWidth = 1;
        g.beginPath(); g.moveTo(a.x, a.y - 26 * a.s); g.lineTo(b.x, b.y - 26 * b.s); g.stroke();
      }
    }
    g.restore();

    /* ── 9 · las figuras ───────────────────────────────────────────── */
    for (const f of figuras) {
      const s = f.s;
      for (const [rf, o] of [[54, 0.55], [40, 0.4], [26, 0.3]] as const) {
        g.strokeStyle = tinta("248,204,150", o * luz);
        g.lineWidth = 1.3;
        elipse(f.x, f.y, rf * s, rf * 0.3 * s); g.stroke();
      }
      const halo = g.createRadialGradient(f.x, f.y - 28 * s, 2, f.x, f.y - 28 * s, 62 * s);
      halo.addColorStop(0, tinta("255,224,196", 0.62 * luz));
      halo.addColorStop(0.35, tinta("246,178,150", 0.22 * luz));
      halo.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = halo;
      g.beginPath(); g.arc(f.x, f.y - 28 * s, 62 * s, 0, Math.PI * 2); g.fill();
      g.save();
      g.translate(f.x, f.y);
      g.scale(s, s);
      g.fillStyle = tinta("255,230,204", 0.5 * luz);
      g.beginPath();
      g.ellipse(0, -52, 5.2, 6.4, 0, 0, Math.PI * 2);
      g.fill();
      g.beginPath();
      /* silueta con brazos: la referencia tiene cuerpos, no cápsulas */
      g.moveTo(-4.5, -44);
      g.quadraticCurveTo(-8, -40, -9, -26);
      g.lineTo(-7.5, -25); g.lineTo(-5.5, -36);
      g.quadraticCurveTo(-6, -20, -5, -6);
      g.lineTo(-1.6, -6); g.lineTo(-1.6, 0); g.lineTo(1.6, 0); g.lineTo(1.6, -6);
      g.lineTo(5, -6);
      g.quadraticCurveTo(6, -20, 5.5, -36);
      g.lineTo(7.5, -25); g.lineTo(9, -26);
      g.quadraticCurveTo(8, -40, 4.5, -44);
      g.closePath();
      g.fill();
      g.strokeStyle = tinta("255,246,232", 0.95 * luz);
      g.lineWidth = 0.9;
      g.stroke();
      g.restore();
    }

    /* ── 10 · grano pictórico: la referencia es un render, no vector ── */
    for (const t of grano) {
      if (t.o <= 0) continue;
      g.fillStyle = tinta(t.c, t.o * luz);
      g.fillRect(t.x, t.y, t.s, t.s);
    }


    /* El frente del suelo se apaga: medido 28 de media en y1230..1300
       contra los 45 que dejaba el lavado. */
    const frente = g.createLinearGradient(0, 1215 - DY, 0, H);
    frente.addColorStop(0, "rgba(0,0,0,0)");
    frente.addColorStop(1, "rgba(0,0,0,0.66)");
    g.fillStyle = frente;
    g.fillRect(0, 1215 - DY, W, H - (1215 - DY));

    /* ── 11 · viñeta de cierre: la caída medida hacia los bordes ────── */
    const vin = g.createRadialGradient(CX, 430, 300, CX, 430, 780);
    vin.addColorStop(0, "rgba(0,0,0,0)");
    vin.addColorStop(0.6, "rgba(0,0,0,0.45)");
    vin.addColorStop(1, "rgba(0,0,0,0.92)");
    g.fillStyle = vin;
    g.fillRect(0, 0, W, H);
  };

  montarLienzo({ raiz, cuadro: pintar, periodo: 24000, periodoReducido: 64000 });
  montarEscala();
      montarMovil();
</script>
