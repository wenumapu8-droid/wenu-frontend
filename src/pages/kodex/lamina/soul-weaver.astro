---
/**
 * KODEX−∞ · LAB · SERIE ARCHIVO · a25 SOUL WEAVER (PAGE 25)
 *
 * Misma estructura que el piloto silence-engine y que star-lattice:
 * cromo con los seis componentes de src/components/kodex/archivo/ en
 * cajas absolutas MEDIDAS + organismo procedural en canvas
 * (montarLienzo) + montarEscala. Entra como lab, noindex.
 *
 * TODO el texto visible está TRANSCRITO de
 * reference/pendientes/a25-soul-weaver.png (recortes a 2,6×–4×). Nada
 * se inventa: aforismos, rótulos y cifras son del creador.
 *
 * Las columnas de glifos de los cantos (izq x≈29, der x≈1197) NO son
 * texto latino en la referencia sino runas ilegibles: van como MARCAS
 * MÍNIMAS de SVG, no como texto inventado.
 *
 * GEOMETRÍA MEDIDA (perfil de tinta por fila/columna sobre el PNG):
 *   marco exterior      inset 11 px + segunda línea inset 14 px
 *   caja PAGE           x62..160  y49..164   (octógono)
 *   caja CYCLE          x1068..1166 y49..164
 *   "KODEX − ∞"         y38..51
 *   lema                y67..76
 *   título SOUL WEAVER  y100..198 · x224..1015 (versal 98, ancho 791)
 *   TEJEDOR DE ALMAS    y227..247 · reglas hasta x207..1014
 *   línea de verbos     y270..279 · x283..931
 *   panel izq           x31..261 (borde interior x37/x266)
 *     THREAD RESONANCE  y298..777
 *     COMPASSION FIELD  y803..1187
 *     WEAVER'S CREED    y1214..1355
 *   panel der           x953..1195 (borde interior x960/x1189)
 *     INCARNATION LINKS y298..777
 *     PATTERN COMPLEX.  y805..1332
 *   aforismo            4 versos en y1332/1355/1378/1401 (versal 9)
 *   emblema             centro (615,1454) Ø ~62, reglas x415..572 y x660..812
 *   sellos              izq x67..273 · der x961..1162 · y≈1413..1485
 *   pie de página       y1499..1506
 *
 * VIÑETA MEDIDA (luminancia media por anillo desde el centro):
 *   r0.00 145 · r0.20 101 · r0.35 45 · r0.50 33 · r0.65 17 · r0.80 9
 * O sea: la referencia NO es negro plano, es una sala iluminada al
 * centro con caída fuerte al borde. El ambiente del lienzo reproduce
 * esa curva; fuera del lienzo la página queda negra porque la
 * referencia también lo está (media 7 en la banda del pie).
 *
 * PALETA MEDIDA (picos): título rgb(250,223,196) · subtítulo
 * rgb(228,177,196) rosa · aforismo rgb(190,177,161) · marco
 * rgb(185,154,126) · centro casi blanco cálido rgb(255,244,245).
 */
import CabeceraArchivo from "../../../components/kodex/archivo/CabeceraArchivo.astro";
import TituloBilingue from "../../../components/kodex/archivo/TituloBilingue.astro";
import TarjetaMetrica from "../../../components/kodex/archivo/TarjetaMetrica.astro";
import RielMetricas from "../../../components/kodex/archivo/RielMetricas.astro";
import AforismoPie from "../../../components/kodex/archivo/AforismoPie.astro";
import SelloClasificacion from "../../../components/kodex/archivo/SelloClasificacion.astro";
import { rng } from "../../../components/kodex/lamina/kit/rng";

/* ── diagramas de las tarjetas: geometría determinista ───────────── */

/* THREAD RESONANCE: mandala con hebra en doble hélice. */
const rHilo = rng(0x25a);
const hebra = (fase: number, amp: number) =>
  Array.from({ length: 61 }, (_, i) => {
    const u = i / 60;
    const y = 8 + u * 164;
    const x = 95 + Math.sin(u * Math.PI * 3 + fase) * amp * Math.sin(u * Math.PI) ;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(" ");
const hebraA = hebra(0, 26);
const hebraB = hebra(Math.PI, 26);
const motasHilo = Array.from({ length: 130 }, () => {
  const a = rHilo() * Math.PI * 2;
  const r = 16 + rHilo() * 72;
  return { x: 95 + r * Math.cos(a), y: 90 + r * Math.sin(a), s: 0.7 + rHilo() * 1.6 };
});

/* barras de resonancia: valor transcrito de la referencia */
const barras = [
  { en: "GOLD", es: "(PURPOSE)", v: "89.7%", f: 0.897, c: "#d8ac60" },
  { en: "ROSE", es: "(LOVE)", v: "94.3%", f: 0.943, c: "#cf4c70" },
  { en: "VIOLET", es: "(WISDOM)", v: "82.6%", f: 0.826, c: "#9059c4" },
  { en: "WHITE", es: "(TRUTH)", v: "91.1%", f: 0.911, c: "#d6d0c6" },
];

/* onda de OVERRIDE HARMONICS: peine denso con envolvente */
/* Traza continua y no peine: en la referencia (banda y681..723) es una
   oscilación fina de un solo trazo, y un peine macizo paga como bloque
   entero de tinta donde el original tiene aire. */
const rOnda = rng(0x25b);
let envO = 0.4;
const ondaD = Array.from({ length: 240 }, (_, i) => {
  envO = Math.max(0.06, Math.min(1, envO + (rOnda() - 0.5) * 0.34));
  const u = i / 239;
  const amp = envO * Math.sin(u * Math.PI) * 19;
  const x = u * 204;
  const y = 22 + Math.sin(i * 1.9) * amp;
  return `${x.toFixed(1)},${y.toFixed(1)}`;
}).join(" ");

/* COMPASSION FIELD: telaraña radial con corazón al centro */
const rCF = rng(0x25c);
const cfMotas = Array.from({ length: 110 }, () => {
  const a = rCF() * Math.PI * 2;
  const r = 14 + rCF() * 78;
  return { x: 100 + r * Math.cos(a), y: 94 + r * Math.sin(a), s: 0.6 + rCF() * 1.3 };
});

/* INCARNATION LINKS: ocho orbes en anillo + figura al centro */
const orbes = [
  { c: "#f0a95e", n: "LIFE 1", t: "SACRED KEEPER", v: "-1487" },
  { c: "#eaa0b4", n: "LIFE 2", t: "DESERT SAGE", v: "-732" },
  { c: "#b9c7ee", n: "LIFE 3", t: "OCEAN HEALER", v: "231" },
  { c: "#b39ae0", n: "LIFE 4", t: "SKY WATCHER", v: "1056" },
  { c: "#eec3ae", n: "LIFE 5", t: "CURRENT THREAD", v: "NOW" },
];
const anillo8 = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * Math.PI * 2 - Math.PI / 2;
  return {
    x: 100 + 74 * Math.cos(a),
    y: 96 + 74 * Math.sin(a),
    c: ["#f0a95e", "#eaa0b4", "#c8bff0", "#b9c7ee", "#eaa0b4", "#f0a95e", "#e8b7d2", "#f2c9a8"][i],
  };
});
/* onda de LINK STRENGTH */
const rLS = rng(0x25d);
let envL = 0.3;
const ondaL = Array.from({ length: 120 }, (_, i) => {
  envL = Math.max(0.05, Math.min(1, envL + (rLS() - 0.5) * 0.6));
  const u = i / 119;
  const amp = envL * (0.3 + rLS() * 0.7) * 16;
  const x = u * 200;
  return `M${x.toFixed(1)} ${(20 - amp).toFixed(1)}L${x.toFixed(1)} ${(20 + amp).toFixed(1)}`;
}).join("");

/* PATTERN COMPLEXITY: grafo denso de nodos sobre círculo */
const rPC = rng(0x25e);
const pcNodos: Array<{ x: number; y: number; r: number; c: string }> = [];
[[0, 1], [26, 6], [48, 10], [70, 14], [88, 18], [100, 22]].forEach(([rad, n]) => {
  for (let i = 0; i < n; i++) {
    const a = (i / n) * Math.PI * 2 + (rad === 0 ? 0 : rad * 0.013);
    pcNodos.push({
      x: 104 + rad * Math.cos(a),
      y: 104 + rad * Math.sin(a),
      r: rad === 0 ? 4 : 1.6 + rPC() * 1.8,
      c: rPC() < 0.18 ? "#c69ae8" : rPC() < 0.5 ? "#f4d9a8" : "#f0b98a",
    });
  }
});
const pcAristas: Array<[number, number]> = [];
for (let i = 0; i < pcNodos.length; i++) {
  for (let j = i + 1; j < pcNodos.length; j++) {
    const d = Math.hypot(pcNodos[i].x - pcNodos[j].x, pcNodos[i].y - pcNodos[j].y);
    if (d < 74) pcAristas.push([i, j]);
  }
}
/* barras crecientes del pie de PATTERN COMPLEXITY (medidas: rampa) */
const pcBarras = Array.from({ length: 44 }, (_, i) => {
  const u = i / 43;
  return 3 + Math.pow(u, 1.9) * 76;
});

/* glifos de canto: marcas mínimas (en la referencia son runas ilegibles) */
const glifos = ["Ψ", "ᛉ", "Ω", "ᛏ", "Ⴔ", "Ⴕ", "ᛇ", "Ф", "ᚨ", "Ø", "ᛗ", "Ж", "ᛃ", "Ꙩ", "ᚿ", "Ⴑ"];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · SOUL WEAVER · PAGE 25</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam arch-marco" data-lam="soul-weaver" style="width:1229px;height:1536px;">
      {/* ── EL TELAR, procedural (detrás del cromo) ─────────────────── */}
      <canvas class="arch-caja sw-telar" id="sw-telar" width="1229" height="1014" aria-hidden="true"></canvas>

      {/* ── marco exterior doble, medido inset 11 y 14 ──────────────── */}
      <div class="sw-marco" aria-hidden="true"></div>

      {/* ── filigranas de esquina ───────────────────────────────────── */}
      {[
        ["izq-arr", ""],
        ["der-arr", "scaleX(-1)"],
        ["izq-aba", "scaleY(-1)"],
        ["der-aba", "scale(-1,-1)"],
      ].map(([clase, tr]) => (
        <svg class={`sw-filigrana sw-filigrana--${clase}`} style={tr ? `transform:${tr}` : undefined}
             width="112" height="112" viewBox="0 0 112 112" fill="none" aria-hidden="true">
          <path d="M2 30C2 15 15 2 30 2h58" stroke="currentColor" stroke-opacity="0.6" />
          <path d="M2 52C2 25 25 2 52 2" stroke="currentColor" stroke-opacity="0.45" />
          <path d="M2 74C2 34 34 2 74 2" stroke="currentColor" stroke-opacity="0.3" />
          <path d="M10 16h18v-8" stroke="currentColor" stroke-opacity="0.5" />
          <circle cx="24" cy="24" r="6" stroke="currentColor" stroke-opacity="0.65" />
          <circle cx="24" cy="24" r="2" fill="currentColor" fill-opacity="0.7" />
          <path d="M2 96h6M96 2v6" stroke="currentColor" stroke-opacity="0.4" />
        </svg>
      ))}

      {/* Tercera regla del marco. No se ve en el cuerpo de la lámina
          porque los paneles la tapan —por eso no aparecía en el perfil de
          columnas de y310..1250— pero en la cabecera y en el pie está:
          x40..41 y x1187..1188, luminancia 36..41, de y160 a y1500. Va
          POR DEBAJO de los paneles. */}
      {/* El canto INFERIOR del marco no cae igual que el superior en la
          referencia: arriba es una fila (y11 en 134) y abajo son dos
          (y1524-1525 en 83 y 89, y1521-1522 en 39 y 36). No es simetría
          rota a propósito, es el render original fuera de rejilla — pero
          se mide igual. */}
      <span class="sw-canto-sup sw-canto-sup--a" aria-hidden="true"></span>
      <span class="sw-canto-sup sw-canto-sup--b" aria-hidden="true"></span>
      <span class="sw-canto-sup sw-canto-sup--c" aria-hidden="true"></span>
      <span class="sw-canto-v sw-canto-v--izq" aria-hidden="true"></span>
      <span class="sw-canto-v sw-canto-v--der" aria-hidden="true"></span>
      <span class="sw-canto-v sw-canto-v--der2" aria-hidden="true"></span>
      <span class="sw-canto-inf sw-canto-inf--a" aria-hidden="true"></span>
      <span class="sw-canto-inf sw-canto-inf--b" aria-hidden="true"></span>
      <span class="sw-regla-int sw-regla-int--izq" aria-hidden="true"></span>
      <span class="sw-regla-int sw-regla-int--der" aria-hidden="true"></span>

      {/* ── columnas de glifos del canto: marcas mínimas ─────────────── */}
      <div class="sw-glifos sw-glifos--izq" aria-hidden="true">
        {glifos.map((g) => <span>{g}</span>)}
      </div>
      <div class="sw-glifos sw-glifos--der" aria-hidden="true">
        {glifos.slice().reverse().map((g) => <span>{g}</span>)}
      </div>

      {/* ── cabecera: marca centrada + bloque PAGE en octógono ───────── */}
      <div class="arch-caja arch-caja--cabecera">
        <CabeceraArchivo
          centrada
          marca="K O D E X  −  ∞"
          lema="UNIVERSAL WEAVING ENGINE • ARCHIVE PROTOCOL 7.7.7"
          rotuloPagina="PAGE"
          pagina="25"
        />
      </div>
      {/* adorno de flechas a los lados de la marca (medido y≈44) */}
      <svg class="sw-flechas" width="1229" height="16" viewBox="0 0 1229 16" fill="none" aria-hidden="true">
        <path d="M409 8h85m0 0-9-4m9 4-9 4" stroke="currentColor" stroke-opacity="0.55" />
        <path d="M812 8h-84m0 0 9-4m-9 4 9 4" stroke="currentColor" stroke-opacity="0.55" />
      </svg>

      {/* octógonos de esquina: PAGE 25 OF ∞ · CYCLE ∞ ETERNAL */}
      <svg class="sw-octo sw-octo--izq" width="98" height="115" viewBox="0 0 98 115" fill="none" aria-hidden="true">
        <path d="M15 .5h68L97.5 15v85L83 114.5H15L.5 100V15z" stroke="currentColor" stroke-opacity="0.75" />
        <path d="M18 5.5h62L92.5 18v79L80 109.5H18L5.5 97V18z" stroke="currentColor" stroke-opacity="0.3" />
      </svg>
      <svg class="sw-octo sw-octo--der" width="98" height="115" viewBox="0 0 98 115" fill="none" aria-hidden="true">
        <path d="M15 .5h68L97.5 15v85L83 114.5H15L.5 100V15z" stroke="currentColor" stroke-opacity="0.75" />
        <path d="M18 5.5h62L92.5 18v79L80 109.5H18L5.5 97V18z" stroke="currentColor" stroke-opacity="0.3" />
      </svg>
      {/* corchetes que abrazan cada octógono (medidos x40 y x169) */}
      {["izq", "der"].map((lado) => (
        <svg class={`sw-corchete sw-corchete--${lado}`} width="150" height="130" viewBox="0 0 150 130" fill="none" aria-hidden="true">
          <path d="M34 6 6 22v22" stroke="currentColor" stroke-opacity="0.5" />
          <path d="M28 2 2 18" stroke="currentColor" stroke-opacity="0.35" />
          <path d="M116 6l28 16v22" stroke="currentColor" stroke-opacity="0.5" />
          <path d="M122 2l26 16" stroke="currentColor" stroke-opacity="0.35" />
          <path d="M34 124 6 108V86" stroke="currentColor" stroke-opacity="0.5" />
          <path d="M116 124l28-16v-22" stroke="currentColor" stroke-opacity="0.5" />
        </svg>
      ))}
      <p class="sw-of" aria-hidden="true">OF ∞</p>
      <div class="sw-ciclo">
        <p class="sw-ciclo__rot">CYCLE</p>
        <p class="sw-ciclo__num">∞</p>
        <p class="sw-ciclo__pie">ETERNAL</p>
      </div>

      {/* ── título bilingüe ─────────────────────────────────────────── */}
      <div class="arch-caja arch-caja--titulo">
        <TituloBilingue titulo="SOUL WEAVER" subtitulo="TEJEDOR DE ALMAS" />
      </div>
      {/* Reglas del subtítulo: medidas x207..401 y x821..1014 con punta de
          flecha hacia el texto; el eje va en y238. */}
      <svg class="sw-regla-sub" width="1229" height="14" viewBox="0 0 1229 14" fill="none" aria-hidden="true">
        <line x1="207" y1="7" x2="398" y2="7" stroke="currentColor" stroke-opacity="0.55" />
        <path d="M420 7h-16m0 0 7-4m-7 4 7 4M424 3l6 4-6 4z" stroke="currentColor" stroke-opacity="0.75" fill="none" />
        <line x1="1014" y1="7" x2="823" y2="7" stroke="currentColor" stroke-opacity="0.55" />
        <path d="M801 7h16m0 0-7-4m7 4-7 4M797 3l-6 4 6 4z" stroke="currentColor" stroke-opacity="0.75" fill="none" />
      </svg>
      <p class="sw-verbos">WEAVING MEMORY. &nbsp; BINDING PURPOSE. &nbsp; HONORING CHOICE. &nbsp; HOLDING COMPASSION.</p>

      {/* ══ panel izq 1 · THREAD RESONANCE ═══════════════════════════ */}
      <div class="arch-caja sw-caja sw-caja--tr">
        <RielMetricas ancho={236} rotulo="resonancia de las hebras">
          <TarjetaMetrica tituloEn="THREAD RESONANCE" tituloEs="" valor="OFF" etiqueta="OVERRIDE HARMONICS" conPie={false}>
            <div class="sw-cuerpo">
              <svg width="138" height="131" viewBox="0 0 190 180" fill="none" aria-hidden="true" class="sw-mandala">
                <defs>
                  <radialGradient id="sw-nuc-a" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#ffe8cf" stop-opacity="0.95" />
                    <stop offset="30%" stop-color="#e8a070" stop-opacity="0.36" />
                    <stop offset="70%" stop-color="#c07850" stop-opacity="0.18" />
                    <stop offset="100%" stop-color="#a06040" stop-opacity="0.07" />
                  </radialGradient>
                </defs>
                {/* La referencia llena el disco: 52,6 % de tinta contra el
                    28 % que daban cinco aros sueltos. */}
                {[88, 82, 74, 66, 58, 50, 42, 34, 26, 18].map((r, i) => (
                  <circle cx="95" cy="90" r={r} stroke="#d8a468" stroke-opacity={(0.55 - i * 0.03).toFixed(2)} />
                ))}
                {Array.from({ length: 36 }, (_, i) => {
                  const a = (i / 36) * Math.PI * 2;
                  return (
                    <line x1={95 + 14 * Math.cos(a)} y1={90 + 14 * Math.sin(a)}
                          x2={95 + 88 * Math.cos(a)} y2={90 + 88 * Math.sin(a)}
                          stroke="#c99a68" stroke-opacity="0.32" />
                  );
                })}
                {Array.from({ length: 12 }, (_, i) => {
                  const a = (i / 12) * Math.PI * 2;
                  const b = ((i + 5) / 12) * Math.PI * 2;
                  return (
                    <line x1={95 + 88 * Math.cos(a)} y1={90 + 88 * Math.sin(a)}
                          x2={95 + 88 * Math.cos(b)} y2={90 + 88 * Math.sin(b)}
                          stroke="#c99a68" stroke-opacity="0.2" />
                  );
                })}
                <circle cx="95" cy="90" r="88" fill="url(#sw-nuc-a)" />
                {motasHilo.map((m) => (
                  <circle cx={m.x.toFixed(1)} cy={m.y.toFixed(1)} r={m.s.toFixed(1)} fill="#f7d9a8" fill-opacity="0.75" />
                ))}
                <polyline points={hebraA} stroke="#ffd9a0" stroke-opacity="0.95" stroke-width="2.2" fill="none" />
                <polyline points={hebraB} stroke="#f7b6a0" stroke-opacity="0.85" stroke-width="1.8" fill="none" />
                {[[95, 12], [95, 168], [30, 90], [160, 90]].map(([cx, cy]) => (
                  <circle cx={cx} cy={cy} r="3.4" fill="#ffeccb" />
                ))}
              </svg>

              <dl class="sw-barras">
                {barras.map((b) => (
                  <div>
                    <dt><span class="sw-barras__en">{b.en}</span> <span class="sw-barras__es">{b.es}</span></dt>
                    <dd>{b.v}</dd>
                    <div class="sw-barras__pista">
                      <span class="sw-barras__llena" style={`width:${(b.f * 100).toFixed(1)}%;background:${b.c};opacity:0.82`}></span>
                    </div>
                  </div>
                ))}
              </dl>

              <svg width="204" height="44" viewBox="0 0 204 44" fill="none" aria-hidden="true" class="sw-onda">
                <polyline points={ondaD} stroke="#c07a58" stroke-opacity="0.85" stroke-width="1" fill="none" />
                <line x1="0" y1="22" x2="204" y2="22" stroke="#a87848" stroke-opacity="0.28" />
              </svg>
            </div>
          </TarjetaMetrica>
        </RielMetricas>
      </div>

      {/* ══ panel izq 2 · COMPASSION FIELD ═══════════════════════════ */}
      <div class="arch-caja sw-caja sw-caja--cf">
        <RielMetricas ancho={236} rotulo="campo de compasión">
          <TarjetaMetrica tituloEn="COMPASSION FIELD" tituloEs="" valor="97.2%" etiqueta="FIELD STRENGTH" conPie={false}>
            <div class="sw-cuerpo">
              <svg width="174" height="170" viewBox="0 0 200 196" fill="none" aria-hidden="true" class="sw-mandala">
                <defs>
                  <radialGradient id="sw-nuc-b" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#ffd9e8" stop-opacity="0.95" />
                    <stop offset="28%" stop-color="#e07aa8" stop-opacity="0.32" />
                    <stop offset="66%" stop-color="#b05480" stop-opacity="0.16" />
                    <stop offset="100%" stop-color="#8a4266" stop-opacity="0.06" />
                  </radialGradient>
                </defs>
                {[92, 84, 76, 68, 60, 52, 44, 36, 28, 20].map((r, i) => (
                  <circle cx="100" cy="94" r={r} stroke="#c9739e" stroke-opacity={(0.5 - i * 0.028).toFixed(2)} />
                ))}
                {Array.from({ length: 32 }, (_, i) => {
                  const a = (i / 32) * Math.PI * 2;
                  return (
                    <line x1="100" y1="94" x2={100 + 92 * Math.cos(a)} y2={94 + 92 * Math.sin(a)}
                          stroke="#c9739e" stroke-opacity="0.3" />
                  );
                })}
                {Array.from({ length: 14 }, (_, i) => {
                  const a = (i / 14) * Math.PI * 2;
                  const b = ((i + 6) / 14) * Math.PI * 2;
                  return (
                    <line x1={100 + 92 * Math.cos(a)} y1={94 + 92 * Math.sin(a)}
                          x2={100 + 92 * Math.cos(b)} y2={94 + 92 * Math.sin(b)}
                          stroke="#c9739e" stroke-opacity="0.2" />
                  );
                })}
                <line x1="8" y1="94" x2="192" y2="94" stroke="#e6a0c0" stroke-opacity="0.5" />
                <line x1="100" y1="4" x2="100" y2="186" stroke="#e6a0c0" stroke-opacity="0.35" />
                {cfMotas.map((m) => (
                  <circle cx={m.x.toFixed(1)} cy={m.y.toFixed(1)} r={m.s.toFixed(1)} fill="#f5c6dd" fill-opacity="0.7" />
                ))}
