  .vo-pie__remate { display: block; margin: 2px auto 0; }
</style>

<script>
  import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
  import { rng } from "../../../components/kodex/lamina/kit/rng";
  import { montarEscala } from "../../../components/kodex/lamina/kit/escala";
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";

  const raiz = document.querySelector("[data-lam]") as HTMLElement;
  const gF = (document.getElementById("vo-fondo") as HTMLCanvasElement).getContext("2d")!;
  const gV = (document.getElementById("vo-vivo") as HTMLCanvasElement).getContext("2d")!;
  const W = 1229, H = 1536;
  const CX = 614;
  const rnd = rng(0x5e21);

  /* Cajas de los paneles (mismas medidas que el CSS): el canvas pinta
     su placa casi negra — detrás de los paneles la referencia mide
     rgb(5,4,4), no nebulosa. */
  const placas: Array<[number, number, number, number]> = [
    [44, 240, 194, 314], [44, 583, 194, 319], [44, 927, 194, 344], [44, 1298, 194, 129],
    [953, 240, 232, 334], [953, 588, 232, 392], [953, 1002, 232, 322], [953, 1324, 232, 135],
  ];

  /* ── geometría fija por semilla ──────────────────────────────────── */

  /* nebulosa: manchas violetas, más densas y claras hacia el eje.
     Medido v2: la referencia promedia rgb(59,48,63) en el centro y
     rgb(39,34,52) arriba — la vuelta 1 quedó a la mitad (29,22,38). */
  const nubes: Array<{x:number;y:number;r:number;o:number;c:string}> = [];
  for (let k = 0; k < 330; k++) {
    const x = 40 + rnd() * (W - 80);
    /* y arranca en 300 y no en 90: arriba está el título y la referencia
       ahí es negra — una nube alta se le mete de fondo a la tipografía. */
    const y = 300 + rnd() * (H - 400);
    const dx = Math.abs(x - CX) / CX;
    const c = rnd() < 0.3 ? "150,122,180" : rnd() < 0.6 ? "104,82,136" : "72,56,98";
    nubes.push({ x, y, r: 50 + rnd() * 150, o: (0.08 + rnd() * 0.13) * (1 - dx * 0.62), c });
  }
  /* grumos chicos y claros del centro: la textura granulada de la pintura */
  const grumos: Array<{x:number;y:number;r:number;o:number;c:string}> = [];
  for (let k = 0; k < 340; k++) {
    const x = 260 + rnd() * 710;
    const y = 300 + rnd() * 1080;
    const c = rnd() < 0.35 ? "176,148,200" : rnd() < 0.7 ? "132,106,162" : "96,76,124";
    grumos.push({ x, y, r: 14 + rnd() * 54, o: 0.09 + rnd() * 0.20, c });
  }
  /* polvo y estrellas */
  const polvo = Array.from({ length: 2600 }, () => ({
    x: rnd() * W, y: rnd() * H,
    s: 0.6 + rnd() * 1.1,
    o: 0.06 + rnd() * 0.4,
    c: rnd() < 0.12 ? "222,196,130" : rnd() < 0.5 ? "196,178,220" : "160,142,190",
  }));
  /* grano fino del centro: la nebulosa de la referencia es ruidosa */
  /* Medido: la banda central de la referencia tiene desviación típica de
     luminancia 35, la lámina en la vuelta 13 tenía 19. No es sólo que esté
     más oscura: está más LISA. El grano y los grumos son la mitad de esa
     diferencia — la nebulosa pintada es ruidosa y chispea. */
  const grano = Array.from({ length: 3400 }, () => ({
    x: 255 + rnd() * 720, y: 290 + rnd() * 1120,
    s: 0.5 + rnd() * 1.2,
    o: 0.10 + rnd() * 0.45,
    c: rnd() < 0.18 ? "228,206,150" : rnd() < 0.55 ? "204,184,226" : "168,148,198",
  }));
  /* chispas: los puntos claros que la referencia tiene sembrados por toda la
     nebulosa, con halo — son los que levantan la desviación típica */
  const chispas = Array.from({ length: 190 }, () => ({
    x: 262 + rnd() * 700, y: 320 + rnd() * 1050,
    r: 1.1 + rnd() * 2.0, o: 0.35 + rnd() * 0.5,
    c: rnd() < 0.3 ? "244,226,168" : "226,214,248",
  }));

  /* el árbol: tronco + ramas recursivas, guardadas como segmentos */
  type Seg = { x1:number;y1:number;x2:number;y2:number;w:number };
  const ramas: Seg[] = [];
  /* La rama de la referencia es NUDOSA: quiebra a cada paso, se afina rápido
     y suelta ramitas a lo largo, no sólo en la punta. Una rama suave y larga
     lee como cable de tendido; ésta tiene que leer como madera muerta. */
  const rama = (x:number, y:number, ang:number, len:number, w:number, prof:number) => {
    let px = x, py = y, a = ang;
    const pasos = 7;
    for (let i = 0; i < pasos; i++) {
      const nx = px + Math.cos(a) * (len / pasos);
      const ny = py + Math.sin(a) * (len / pasos);
      ramas.push({ x1: px, y1: py, x2: nx, y2: ny, w: Math.max(0.5, w * (1 - i / pasos * 0.4)) });
      px = nx; py = ny;
      a += (rnd() - 0.5) * 0.78;
      /* ramita al costado, a media rama: es lo que llena la copa */
      if (prof > 1 && i > 1 && i < pasos - 1 && rnd() < 0.55) {
        rama(px, py, a + (rnd() < 0.5 ? -1 : 1) * (0.7 + rnd() * 0.7),
             len * (0.3 + rnd() * 0.22), Math.max(0.5, w * 0.4), prof - 2);
      }
    }
    if (prof > 0) {
      const nHijas = prof > 2 ? 3 : 2;
      for (let i = 0; i < nHijas; i++) {
        rama(px, py, a + (rnd() - 0.5) * 1.9, len * (0.5 + rnd() * 0.25), Math.max(0.5, w * 0.52), prof - 1);
      }
    } else {
      /* dedos terminales: tres astillas cortas por punta */
      for (let i = 0; i < 3; i++) {
        const aa = a + (i - 1) * (0.4 + rnd() * 0.35);
        ramas.push({
          x1: px, y1: py,
          x2: px + Math.cos(aa) * (8 + rnd() * 16),
          y2: py + Math.sin(aa) * (8 + rnd() * 16),
          w: 0.5,
        });
      }
    }
  };
  /* EL ÁRBOL, medido contra la referencia: la copa no es un adorno arriba
     del tronco, es la mitad de la lámina. En a21 la ramazón negra ocupa de
     x≈280 a x≈950 y de y≈330 a y≈900, y es lo que APAGA el centro: sin ella
     la nebulosa calibrada deja la banda central en 95 % de píxeles
     encendidos contra el 60 % de la referencia. La copa es la sombra. */
  /* La copa NO sube por encima de la vaina mayor: en la referencia el techo
     de la ramazón está en y≈560 y la vaina (y≈460) queda despejada contra la
     nebulosa y sus anillos de oro. Primera versión de la copa nacía en y=600
     apuntando arriba y la cruzaba: centro-alto empeoró 0,9 pese a mejorar el
     árbol. La copa es ANCHA, no alta. */
  for (let i = 0; i < 13; i++) {
    const a = -Math.PI / 2 + (i - 6) * 0.24;
    /* las del medio, las que irían contra la vaina, salen más cortas */
    const centrada = 1 - Math.abs(i - 6) / 6;
    rama(CX + (rnd() - 0.5) * 18, 660, a, (120 + rnd() * 70) * (1 - centrada * 0.45), 8, 4);
  }
  /* brazos mayores: los dos que barren afuera y abajo, hasta x≈280 y x≈950 */
  for (const lado of [-1, 1]) {
    rama(CX + lado * 10, 700, -Math.PI / 2 + lado * 1.35, 240 + rnd() * 60, 10, 4);
    rama(CX + lado * 14, 780, lado * 0.35, 220 + rnd() * 60, 8, 4);
  }
  /* ramas medias que cuelgan hacia los lados */
  for (let i = 0; i < 10; i++) {
    const lado = i % 2 ? 1 : -1;
    rama(CX + lado * 14, 700 + i * 32, lado * (0.15 + rnd() * 0.55), 170 + rnd() * 90, 6, 3);
  }
  /* La campana de raigones (se dibuja como cinta en pintarFondo): la tabla
     vive acá porque sus puntas siguen en ramitas, y la ramazón se genera una
     sola vez, antes de pintar. Generarla dentro de pintarFondo la dejaría
     empujando segmentos a un array ya dibujado — código muerto. */
  const salidasRaigon: Array<[number, number, number, number]> = [
    [726, 286, 1024, 19],
    [772, 238, 1036, 17],
    [818, 322, 1040, 15],
    [864, 176, 1042, 13],
    [906, 262, 1046, 11],
    [952, 122, 1046, 10],
  ];
  const curvaRaigon = new Map<string, [number, number]>();
  for (const lado of [-1, 1]) {
    for (const [y0, alcance, yFin] of salidasRaigon) {
      curvaRaigon.set(`${lado}:${y0}`, [
        CX + lado * alcance * (0.62 + rnd() * 0.3),
        y0 + (yFin - y0) * (0.15 + rnd() * 0.25),
      ]);
      rama(CX + lado * alcance, yFin, lado * (0.2 + rnd() * 0.7) + (rnd() - 0.5) * 0.5,
           60 + rnd() * 70, 3, 2);
    }
  }
  /* raíces colgando bajo la isla */
  const raices: Seg[] = [];
  const raiz2 = (x:number, y:number, ang:number, len:number, w:number, prof:number) => {
    let px = x, py = y, a = ang;
    for (let i = 0; i < 5; i++) {
      const nx = px + Math.cos(a) * (len / 5);
      const ny = py + Math.sin(a) * (len / 5);
      raices.push({ x1: px, y1: py, x2: nx, y2: ny, w });
      px = nx; py = ny;
      a += (rnd() - 0.5) * 0.4;
    }
    if (prof > 0) {
      raiz2(px, py, a + (rnd() - 0.5) * 0.9, len * 0.6, w * 0.6, prof - 1);
      if (rnd() < 0.6) raiz2(px, py, a + (rnd() - 0.5) * 1.2, len * 0.5, w * 0.55, prof - 1);
    }
  };
  for (let i = 0; i < 9; i++) {
    raiz2(CX + (i - 4) * 48 + (rnd() - 0.5) * 30, 1096 + rnd() * 24, Math.PI / 2 + (rnd() - 0.5) * 0.5, 90 + rnd() * 110, 3, 2);
  }

  /* goteos que cuelgan del techo de la caverna (y≈300, donde arranca el
     campo) — en la referencia son decenas de hilos finos con una gota de luz
     en la punta, no dos docenas */
  const goteos = Array.from({ length: 64 }, () => ({
    x: 258 + rnd() * 706, y0: 300 + rnd() * 40, l: 26 + rnd() * 170,
    o: 0.12 + rnd() * 0.22,
  }));

  /* ── LAS PAREDES DE ROCA ────────────────────────────────────────────
     El diff de centro-alto es rojo entero en los flancos: la referencia
     tiene formaciones NEGRAS colgando a izquierda y derecha del campo
     (x250..370 y x810..950, de y300 a y980) con estalactitas, y entre
     ellas la nebulosa clara. Sin ellas la banda central queda pareja y
     lisa, y ninguna cantidad de luz la arregla — falta el contraste, no
     el brillo. */
  type Roca = { pts: Array<[number, number]>; drips: Array<[number, number, number]> };
  const rocas: Roca[] = [];
  for (const lado of [-1, 1]) {
    const borde = lado < 0 ? 248 : 980;
    const dentro = lado < 0 ? 1 : -1;
    const pts: Array<[number, number]> = [[borde, 292]];
    const drips: Array<[number, number, number]> = [];
    /* El perfil va en pasos CORTOS. Con pasos de 30..100 px la pared salía
       como un polígono de cuatro lados rectos —se leía el triángulo— y la
       referencia tiene un canto roto, de grano fino, que nunca dibuja una
       diagonal larga. */
    let y = 292;
    let hondoPrev = 40;
    while (y < 1000) {
      y += 9 + rnd() * 16;
      /* la pared entra y sale, pero por deriva: cada tramo se aparta poco
         del anterior, y encima le monta el detalle chico */
      const objetivo = (24 + rnd() * 96) * (y < 390 || y > 890 ? 1.45 : 1);
      hondoPrev += (objetivo - hondoPrev) * 0.22;
      const hondo = Math.max(8, hondoPrev + (rnd() - 0.5) * 26);
      const x = borde + dentro * hondo;
      pts.push([x, y]);
      if (rnd() < 0.2) drips.push([x, y, 20 + rnd() * 120]);
    }
    pts.push([borde, 1000]);
    rocas.push({ pts, drips });
  }
  /* repisas colgantes sueltas dentro del campo (las islitas de roca que en
     la referencia flotan entre la pared y el árbol) */
  const repisas = Array.from({ length: 7 }, (_, i) => ({
    x: i % 2 ? 780 + rnd() * 150 : 280 + rnd() * 150,
    y: 330 + rnd() * 560,
    w: 40 + rnd() * 90,
    h: 14 + rnd() * 26,
  }));

  /* ── LAS VAINAS ─────────────────────────────────────────────────────
     Mapa MEDIDO, no estimado a ojo: se umbralizó la referencia en lum > 150
     y se etiquetaron los componentes conexos de más de 26 px. Cada núcleo
     que salió de ahí es una vaina encendida, con su centro, su caja y su
     color medio — y eso corrigió tres errores de la primera tabla: la vaina
     de la izquierda estaba 75 px abajo (y700 contra y626), había una en
     x1207 que cae ENCIMA del panel derecho y no existe en la referencia, y
     faltaba entero el racimo violeta de x520..570, y700..970, que es el que
     llena el flanco izquierdo del tronco.
     La vaina del estanque (y≈1390) NO aparece en el umbral: en la
     referencia está apagada, no encendida. Baja de br 0,9 a 0,5. */
  type Vaina = { x:number;y:number;rx:number;ry:number;tono:"verde"|"violeta"|"palida";br:number;f:number };
  const vainas: Vaina[] = [
    /* la mayor: el núcleo medido va de y408 a y547, con satélites */
    { x: 614,  y: 478,  rx: 44, ry: 72, tono: "verde",   br: 1.0,  f: 0.0 },
    { x: 886,  y: 450,  rx: 26, ry: 35, tono: "verde",   br: 0.85, f: 0.2 },
    { x: 272,  y: 626,  rx: 24, ry: 33, tono: "verde",   br: 0.85, f: 0.4 },
    { x: 319,  y: 877,  rx: 22, ry: 29, tono: "verde",   br: 0.8,  f: 0.7 },
    { x: 411,  y: 948,  rx: 14, ry: 19, tono: "verde",   br: 0.6,  f: 0.35 },
    { x: 717,  y: 718,  rx: 12, ry: 16, tono: "verde",   br: 0.5,  f: 0.62 },
    { x: 882,  y: 965,  rx: 15, ry: 21, tono: "verde",   br: 0.6,  f: 0.3 },
    { x: 325,  y: 1137, rx: 16, ry: 22, tono: "verde",   br: 0.65, f: 0.9 },
    /* racimo violeta del flanco izquierdo del tronco */
    { x: 536,  y: 945,  rx: 16, ry: 31, tono: "violeta", br: 0.8,  f: 0.15 },
    { x: 528,  y: 912,  rx: 11, ry: 18, tono: "violeta", br: 0.6,  f: 0.45 },
    { x: 521,  y: 970,  rx: 9,  ry: 15, tono: "violeta", br: 0.55, f: 0.75 },
    { x: 567,  y: 740,  rx: 14, ry: 31, tono: "violeta", br: 0.75, f: 0.5 },
    { x: 556,  y: 710,  rx: 13, ry: 27, tono: "violeta", br: 0.65, f: 0.85 },
    /* violetas sueltas */
    { x: 876,  y: 806,  rx: 10, ry: 16, tono: "violeta", br: 0.55, f: 0.25 },
    { x: 877,  y: 394,  rx: 11, ry: 13, tono: "violeta", br: 0.5,  f: 0.55 },
    { x: 291,  y: 572,  rx: 10, ry: 13, tono: "violeta", br: 0.5,  f: 0.05 },
    { x: 442,  y: 569,  rx: 10, ry: 14, tono: "palida",  br: 0.5,  f: 0.1 },
    { x: 413,  y: 796,  rx: 9,  ry: 11, tono: "violeta", br: 0.45, f: 0.68 },
    { x: 471,  y: 1181, rx: 8,  ry: 16, tono: "violeta", br: 0.5,  f: 0.4 },
    { x: 614,  y: 1390, rx: 28, ry: 42, tono: "violeta", br: 0.5,  f: 0.15 },
  ];

  /* ── LAS BURBUJAS ───────────────────────────────────────────────────
     Las esferas de vidrio que flotan por todo el centro de la referencia:
     interior oscuro, canto encendido y un punto de brillo arriba. Son la
     mitad del contraste local que faltaba — medido, la banda central de la
     referencia tiene desviación típica 35 y la lámina 23, y una burbuja
     aporta las dos cosas a la vez: una masa oscura y un filo claro. */
  const burbujas = Array.from({ length: 13 }, () => {
    const x = 268 + rnd() * 686;
    const y = 360 + rnd() * 880;
    /* lejos del eje de la vaina mayor: en la referencia las burbujas
       rodean el foco, no lo tapan */
    const fuera = Math.abs(x - 614) < 120 && y < 620;
    return {
      x, y: fuera ? y + 300 : y,
      r: 13 + rnd() * 28,
      o: 0.3 + rnd() * 0.34,
      violeta: rnd() < 0.7,
    };
  });

  /* motas del haz central, ascendentes */
  const motas = Array.from({ length: 70 }, () => ({
    x: CX + (rnd() - 0.5) * 60, o: 0.2 + rnd() * 0.5,
    r: 0.6 + rnd() * 1.2, v: rnd(), y0: 500 + rnd() * 860,
  }));
  /* polvo vivo a la deriva por el centro */
  const deriva = Array.from({ length: 110 }, () => ({
    x: 270 + rnd() * 690, y: 320 + rnd() * 1080,
    r: 0.5 + rnd() * 1.1, o: 0.1 + rnd() * 0.35, v: rnd(),
  }));

  const trazar = (g: CanvasRenderingContext2D, segs: Seg[], color: string, alfa: number) => {
    for (const s of segs) {
      g.strokeStyle = tinta(color, alfa);
      g.lineWidth = s.w;
      g.beginPath(); g.moveTo(s.x1, s.y1); g.lineTo(s.x2, s.y2); g.stroke();
    }
  };

  const vainaShell = (g: CanvasRenderingContext2D, v: Vaina) => {
    /* cáscara: lente oscura con retícula y borde iluminado */
    g.save();
    g.translate(v.x, v.y);
    g.fillStyle = v.tono === "violeta" ? "rgba(24,16,36,0.9)" : "rgba(18,20,12,0.9)";
    g.beginPath();
    g.moveTo(0, -v.ry);
    g.quadraticCurveTo(v.rx, 0, 0, v.ry);
    g.quadraticCurveTo(-v.rx, 0, 0, -v.ry);
    g.fill();
    const borde = v.tono === "violeta" ? "170,140,220" : "180,190,120";
    g.strokeStyle = tinta(borde, 0.5 * v.br);
    g.lineWidth = 1.4;
    g.stroke();
    /* nervaduras */
    g.strokeStyle = tinta(borde, 0.28 * v.br);
    g.lineWidth = 0.8;
    for (const k of [0.45, 0.75]) {
      g.beginPath();
      g.moveTo(0, -v.ry * k);
      g.quadraticCurveTo(v.rx * k, 0, 0, v.ry * k);
      g.quadraticCurveTo(-v.rx * k, 0, 0, -v.ry * k);
      g.stroke();
    }
    g.beginPath(); g.moveTo(0, -v.ry); g.lineTo(0, v.ry); g.stroke();
    /* ramitas que la sostienen */
    g.strokeStyle = "rgba(10,7,12,0.9)";
    g.lineWidth = 2;
    g.beginPath(); g.moveTo(0, -v.ry); g.lineTo((rnd() - 0.5) * 14, -v.ry - 10 - rnd() * 16); g.stroke();
    g.restore();
  };

  /* ── fondo: se pinta UNA vez ─────────────────────────────────────── */
  const pintarFondo = () => {
    gF.fillStyle = "#050308";
    gF.fillRect(0, 0, W, H);

    /* ── AMBIENTE · la palanca del piloto ──────────────────────────────
       La referencia NO es negro plano con dibujos encima: es una PARED de
       nebulosa iluminada al centro que cae a negro en los bordes. Medido
       sobre a21 en malla 8×12: la banda central (x307..921, y350..1350)
       promedia rgb(45,38,50) con 40..85 % de píxeles encendidos, y el pico
       (x460..770, y384..700) llega a rgb(80,70,85) con 94 %. La vuelta 1
       daba rgb(20,16,25) con 10 % encendido: de ahí salía el 45 % de
       cobertura, no de que faltaran dibujos.
       El campo es más alto que ancho, así que el degradado radial se pinta
       escalado — un radialGradient de canvas siempre es circular. */
    const ambiente = (
      cx: number, cy: number, rx: number, ry: number,
      paradas: Array<[number, string]>
    ) => {
      gF.save();
      gF.translate(cx, cy);
      gF.scale(1, ry / rx);
      const gr = gF.createRadialGradient(0, 0, 0, 0, 0, rx);
      for (const [p, c] of paradas) gr.addColorStop(p, c);
      gF.fillStyle = gr;
      gF.beginPath(); gF.arc(0, 0, rx, 0, Math.PI * 2); gF.fill();
      gF.restore();
    };
    /* pared de nebulosa: el cuerpo del ambiente.
       El campo ARRANCA en y≈330: arriba de esa línea vive el título y la
       referencia ahí es negra (medido rgb(19,16,16), 14 % encendido). La
       primera calibración lo estiró hasta y=60 y el título saltó a 312 %
       de cobertura — el campo se le metió detrás a la tipografía. */
    ambiente(CX, 810, 400, 520, [
      [0, "rgba(118,96,146,0.68)"],
      [0.45, "rgba(96,78,124,0.58)"],
      [0.75, "rgba(64,50,86,0.36)"],
      [1, "rgba(0,0,0,0)"],
    ]);
    /* foco alto: la corona alrededor de la vaina mayor es el punto más
       claro de la lámina (medido rgb(80,70,85)) */
    ambiente(CX, 570, 300, 250, [
      [0, "rgba(140,116,170,0.38)"],
      [0.6, "rgba(104,84,134,0.16)"],
      [1, "rgba(0,0,0,0)"],
    ]);
    /* foco bajo: el estanque de la vaina final vuelve a encenderse
       (y1280..1400 mide 77..83 % encendido antes del pie negro) */
    ambiente(610, 1320, 300, 175, [
      [0, "rgba(112,88,148,0.40)"],
      [0.6, "rgba(80,62,108,0.20)"],
      [1, "rgba(0,0,0,0)"],
    ]);

    /* nebulosa */
    for (const n of nubes) {
      const gr = gF.createRadialGradient(n.x, n.y, 0, n.x, n.y, n.r);
      gr.addColorStop(0, tinta(n.c, n.o));
      gr.addColorStop(1, "rgba(0,0,0,0)");
      gF.fillStyle = gr;
      gF.fillRect(n.x - n.r, n.y - n.r, n.r * 2, n.r * 2);
    }
    /* grumos: la nebulosa de la referencia está grumosa, no lisa */
    for (const gm of grumos) {
      const gr = gF.createRadialGradient(gm.x, gm.y, 0, gm.x, gm.y, gm.r);
      gr.addColorStop(0, tinta(gm.c, gm.o));
      gr.addColorStop(1, "rgba(0,0,0,0)");
      gF.fillStyle = gr;
      gF.fillRect(gm.x - gm.r, gm.y - gm.r, gm.r * 2, gm.r * 2);
    }

    /* polvo */
    for (const p of polvo) {
      gF.fillStyle = tinta(p.c, p.o);
      gF.fillRect(p.x, p.y, p.s, p.s);
    }
    /* grano fino del centro */
    for (const t of grano) {
      gF.fillStyle = tinta(t.c, t.o);
      gF.fillRect(t.x, t.y, t.s, t.s);
    }
    /* PAREDES DE ROCA: negras, con estalactitas y canto apenas dorado */
    for (const roca of rocas) {
      gF.fillStyle = "rgba(6,4,9,0.97)";
      gF.beginPath();
      gF.moveTo(roca.pts[0][0], roca.pts[0][1]);
      for (const [x, y] of roca.pts) gF.lineTo(x, y);
      gF.lineTo(roca.pts[0][0] < CX ? 0 : W, 1000);
      gF.lineTo(roca.pts[0][0] < CX ? 0 : W, 292);
      gF.closePath();
      gF.fill();
      gF.strokeStyle = tinta("178,150,104", 0.16);
      gF.lineWidth = 1;
      gF.beginPath();
      roca.pts.forEach(([x, y], i) => (i ? gF.lineTo(x, y) : gF.moveTo(x, y)));
      gF.stroke();
      /* estalactitas */
      for (const [x, y, l] of roca.drips) {
        gF.strokeStyle = "rgba(6,4,9,0.95)";
        gF.lineWidth = 2.6;
        gF.beginPath();
        gF.moveTo(x, y);
        gF.quadraticCurveTo(x + (x < CX ? 4 : -4), y + l * 0.6, x, y + l);
        gF.stroke();
        gF.fillStyle = tinta("196,172,120", 0.3);
        gF.beginPath(); gF.arc(x, y + l, 1.3, 0, Math.PI * 2); gF.fill();
      }
    }
    /* Repisas sueltas que flotan entre la pared y el árbol. El canto de abajo
       va dentado: como cuadrilátero limpio leían como recortes de papel. */
    for (const r of repisas) {
      gF.fillStyle = "rgba(7,5,10,0.95)";
      gF.beginPath();
      gF.moveTo(r.x - r.w / 2, r.y);
      gF.lineTo(r.x + r.w / 2, r.y - 3);
      for (let i = 6; i >= 0; i--) {
        const u = i / 6;
        gF.lineTo(
          r.x - r.w * 0.34 + u * r.w * 0.64,
          r.y + r.h * (0.55 + 0.75 * Math.sin(u * Math.PI)) + Math.sin(u * 11) * 4
        );
      }
      gF.closePath();
      gF.fill();
      gF.strokeStyle = tinta("196,172,120", 0.24);
      gF.lineWidth = 0.9;
      gF.beginPath();
      gF.moveTo(r.x - r.w / 2 + 3, r.y - 1); gF.lineTo(r.x + r.w / 2 - 3, r.y - 4);
      gF.stroke();
    }

    /* goteos del techo de la caverna */
    for (const gt of goteos) {
      gF.strokeStyle = tinta("140,120,170", gt.o);
      gF.lineWidth = 0.8;
      gF.beginPath(); gF.moveTo(gt.x, gt.y0); gF.lineTo(gt.x + 3, gt.y0 + gt.l); gF.stroke();
      gF.fillStyle = tinta("200,180,230", gt.o + 0.15);
      gF.beginPath(); gF.arc(gt.x + 3, gt.y0 + gt.l, 1.2, 0, Math.PI * 2); gF.fill();
    }

    /* ── GEOMETRÍA SAGRADA TRAS LA VAINA MAYOR ─────────────────────────
       En la referencia es el elemento más legible de la lámina después del
       título: anillos de oro NÍTIDOS de radio 70..160 alrededor de y462,
       con arcos de compás cruzados y púas en el borde. Iban al 0,14 de alfa
       —invisibles a tamaño real— y el foco de la lámina quedaba sin marco. */
    for (const [r, o] of [[74, 0.34], [104, 0.3], [132, 0.26], [158, 0.4]] as const) {
      gF.strokeStyle = tinta("205,181,121", o);
      gF.lineWidth = r === 158 ? 1.1 : 0.9;
      gF.beginPath(); gF.arc(CX, 462, r, 0, Math.PI * 2); gF.stroke();
    }
    /* arcos de compás: seis circunferencias del mismo radio centradas en el
       anillo — la construcción de la flor, como en la referencia */
    for (let k = 0; k < 6; k++) {
      const a = (k / 6) * Math.PI * 2 - Math.PI / 2;
      gF.strokeStyle = tinta("205,181,121", 0.18);
      gF.lineWidth = 0.8;
      gF.beginPath();
      gF.arc(CX + Math.cos(a) * 104, 462 + Math.sin(a) * 104, 104, 0, Math.PI * 2);
      gF.stroke();
    }
    for (let k = 0; k < 48; k++) {
      const a = (k / 48) * Math.PI * 2;
      gF.strokeStyle = tinta("205,181,121", k % 4 ? 0.24 : 0.45);
      gF.lineWidth = k % 4 ? 0.8 : 1.1;
      gF.beginPath();
      gF.moveTo(CX + Math.cos(a) * 158, 462 + Math.sin(a) * 158);
      gF.lineTo(CX + Math.cos(a) * (k % 4 ? 164 : 172), 462 + Math.sin(a) * (k % 4 ? 164 : 172));
      gF.stroke();
    }
    /* marco ojival de la vaina mayor: el arco apuntado negro que la abraza */
    gF.strokeStyle = tinta("188,164,112", 0.42);
    gF.lineWidth = 2;
    gF.beginPath();
    gF.moveTo(CX, 372);
    gF.quadraticCurveTo(CX + 62, 420, CX + 60, 486);
    gF.quadraticCurveTo(CX + 58, 552, CX, 574);
    gF.quadraticCurveTo(CX - 58, 552, CX - 60, 486);
    gF.quadraticCurveTo(CX - 62, 420, CX, 372);
    gF.stroke();
    gF.strokeStyle = tinta("188,164,112", 0.2);
    gF.lineWidth = 1;
    gF.beginPath();
    gF.moveTo(CX, 386);
    gF.quadraticCurveTo(CX + 52, 428, CX + 50, 486);
    gF.quadraticCurveTo(CX + 48, 544, CX, 562);
    gF.quadraticCurveTo(CX - 48, 544, CX - 50, 486);
    gF.quadraticCurveTo(CX - 52, 428, CX, 386);
    gF.stroke();

    /* EL ÁRBOL: silueta oscura con canto iluminado.
       El canto iba en alfa 0,08: a tamaño real no existe. La rama de a21 es
       negra por dentro y CLARA en el filo — y ese filo es la mitad del 13 %
       de píxeles sobre 80 que la referencia tiene y la lámina no. */
    trazar(gF, ramas, "8,5,11", 0.95);
    /* El canto va sólo donde HAY canto. Con el hilo en todas las ramas, su
       ancho mínimo de 0,5 px tapaba entera la ramita de 0,5..1 px y la copa
       salía de alambre de latón: con lupa sobre la referencia (x420..680,
       y560..760) la rama de a21 es NEGRA de punta a punta y el oro entra de
       a destellos. Cuesta 0,14 de puntaje y lo vale — v39 puntuaba 11,86 %
       con la copa dorada y esto 12,00 % con la copa negra, que es la que se
       parece. */
    gF.save();
    gF.translate(-0.9, -0.9);
    for (const sg of ramas) {
      if (sg.w < 1.5) continue;
      gF.strokeStyle = tinta("206,176,116", 0.26);
      gF.lineWidth = sg.w * 0.38;
      gF.beginPath(); gF.moveTo(sg.x1, sg.y1); gF.lineTo(sg.x2, sg.y2); gF.stroke();
    }
    gF.restore();
    /* tronco: columna cónica del centro */
    gF.fillStyle = "rgba(9,6,12,0.96)";
    /* Tronco medido: en la referencia arranca en la isla con ~80 px de
       ancho, se estrecha a media altura y vuelve a abrirse en la horquilla
       de donde sale la copa. La vuelta 1 lo tenía en 52 px planos: leía
       como poste, no como árbol. */
    /* v59 · el tronco seguía flaco. Masa oscura por columnas de 10 px en la
       ventana y760..1020, umbral 22:
         x      520 530 540 550 560 570 580 590 | 630 640 650 660 670 680 690
         ref     29  37  49  60  68  73  68  69 |  65  71  67  67  67  57  43
         lám     23  19  20  20  26  47  66  69 |  79  61  43  38  35  34  34
       La referencia tiene una meseta oscura de x545 a x695 —150 px de madera
       de par en par— y la lámina llegaba a esa meseta sólo en los 30 px
       pegados al eje. El tronco iba en ±44 px abajo y ±20 arriba. */
    /* v59 · el tronco iba flaco. Masa oscura por columnas de 10 px en la
       ventana y760..1020, umbral 22:
         x      520 530 540 550 560 570 580 590 | 630 640 650 660 670 680 690
         ref     29  37  49  60  68  73  68  69 |  65  71  67  67  67  57  43
         lám     23  19  20  20  26  47  66  69 |  79  61  43  38  35  34  34
       La referencia tiene una meseta oscura de x545 a x695 —150 px de madera
       de par en par— y la lámina llegaba a esa meseta sólo en los 30 px
       pegados al eje. El tronco iba en ±44 px abajo y ±20 arriba; ahora en
       ±68 y ±34.  centro-medio 20,20 % → 19,00 %
       v60 probó partirlo en siete cordones con luz entre medio, porque la
       meseta de la referencia se queda en 65..73 % y nunca llega a 90 como
       la nuestra. Salió peor (19,00 % → 19,23 %) y por una razón que vale
       anotar: el desbalance no está en el tronco. Medido, la lámina pesa
       mucho más a la DERECHA del eje que a la izquierda (x650..670 en 82..91
       contra 67 de la referencia) mientras el flanco izquierdo se queda
       corto — eso viene de la campana de raigones y de la copa, no de acá.
       Partir el tronco sólo le sacó masa al lado que ya faltaba. */
    gF.beginPath();
    gF.moveTo(CX - 68, 1038);
    gF.quadraticCurveTo(CX - 46, 860, CX - 34, 700);
    gF.quadraticCurveTo(CX - 34, 610, CX - 12, 548);
    gF.lineTo(CX + 12, 548);
    gF.quadraticCurveTo(CX + 34, 610, CX + 34, 700);
    gF.quadraticCurveTo(CX + 46, 860, CX + 68, 1038);
    gF.closePath();
    gF.fill();
    /* ── LA CAMPANA DE RAIGONES ────────────────────────────────────────
       El diff de centro-medio (y720..1020) era rojo de borde a borde: en la
       referencia esa banda no es tronco con fondo, es un sistema de raigones
       que se abre EN CAMPANA de x≈280 a x≈950 y tapa la nebulosa entera. Un
       tronco de 88 px ahí deja el 90 % de la banda vacía.
       Cada raigón es una cinta que sale del eje, se curva hacia afuera y
       abajo, y se afina: se dibuja como polígono de dos bordes paralelos. */
    const raigon = (
      x0: number, y0: number, x1: number, y1: number,
      cx: number, cy: number, w0: number, w1: number
    ) => {
      const pt = (t: number) => ({
        x: (1 - t) * (1 - t) * x0 + 2 * (1 - t) * t * cx + t * t * x1,
        y: (1 - t) * (1 - t) * y0 + 2 * (1 - t) * t * cy + t * t * y1,
      });
      const izq: Array<[number, number]> = [];
      const der: Array<[number, number]> = [];
      const N = 16;
      for (let i = 0; i <= N; i++) {
        const t = i / N;
        const a = pt(Math.max(0, t - 0.02));
        const b = pt(Math.min(1, t + 0.02));
        const ang = Math.atan2(b.y - a.y, b.x - a.x) + Math.PI / 2;
        const w = (w0 + (w1 - w0) * t) / 2;
        const p = pt(t);
        /* el borde se perturba: un raigón de canto liso lee como arco de
           hormigón, y la referencia tiene madera nudosa */
        const jz = 1 + (rnd() - 0.5) * 0.55;
        const jd = 1 + (rnd() - 0.5) * 0.55;
        izq.push([p.x + Math.cos(ang) * w * jz, p.y + Math.sin(ang) * w * jz]);
        der.push([p.x - Math.cos(ang) * w * jd, p.y - Math.sin(ang) * w * jd]);
      }
      gF.beginPath();
      izq.forEach(([x, y], i) => (i ? gF.lineTo(x, y) : gF.moveTo(x, y)));
      for (let i = der.length - 1; i >= 0; i--) gF.lineTo(der[i][0], der[i][1]);
      gF.closePath();
      gF.fill();
      /* SIN canto de oro en el raigón. Se probó en dos fuerzas y las dos
         empeoraron la banda donde vive la campana:
           v37  alfa 0,34 ancho 1,3  →  centro-medio 19,92 % → 20,24 %
           v38  alfa 0,78 ancho 0,9  →  centro-medio 20,24 % → 22,53 %
                                        centro-alto  16,89 % → 20,23 %
         La lectura: la luz de a21 NO está repartida por todos los cantos.
         Está concentrada — el corazón de filigrana del tronco, las vainas,
         las burbujas — y la madera de la campana es masa oscura de verdad.
         Encender cada borde sube la cobertura a 108 % y llena de medio tono
         justo la zona que la referencia tiene apagada. */
    };
    gF.fillStyle = "rgba(8,5,11,0.96)";
    for (const lado of [-1, 1]) {
      /* Seis raigones por lado, angostos: la campana tiene que ser CELOSÍA,
         no muro. Con cintas anchas la banda cayó a 89,7 % de cobertura y el
         puntaje empeoró — en la referencia la nebulosa se ve ENTRE las
         raíces, que es justo lo que las hace leer como raíces. */
      for (const [y0, alcance, yFin, ancho] of salidasRaigon) {
        const [cx, cy] = curvaRaigon.get(`${lado}:${y0}`)!;
        raigon(CX + lado * 16, y0, CX + lado * alcance, yFin, cx, cy, ancho, 2.5);
      }
      /* contrafuertes cortos de la base sobre la isla */
      raigon(CX + lado * 20, 900, CX + lado * 130, 1044, CX + lado * 78, 995, 22, 5);
    }
    /* vetas de oro que suben por el tronco (medidas en la referencia como
       hilos claros sobre la madera negra, no como contorno) */
    gF.lineWidth = 1;
    for (let i = 0; i < 7; i++) {
      const off = (i - 3) * 5;
      gF.strokeStyle = tinta("214,180,112", 0.1 + (i % 3) * 0.06);
      gF.beginPath();
      gF.moveTo(CX + off * 3.4, 1030);
      gF.quadraticCurveTo(CX + off * 1.6, 860, CX + off * 1.2, 700);
      gF.quadraticCurveTo(CX + off * 1.4, 610, CX + off, 552);
      gF.stroke();
    }
    gF.strokeStyle = tinta("150,124,90", 0.12);
    gF.lineWidth = 1;
    gF.stroke();
    /* copa que abraza la vaina mayor */
    gF.strokeStyle = "rgba(9,6,12,0.9)";
    for (let i = 0; i < 10; i++) {
      const a = -Math.PI / 2 + (i - 4.5) * 0.32;
      gF.lineWidth = 2.5 - (i % 3) * 0.6;
      gF.beginPath();
      gF.moveTo(CX + Math.cos(a) * 20, 545);
      gF.quadraticCurveTo(
        CX + Math.cos(a) * 70, 480 + Math.sin(a) * 40,
        CX + Math.cos(a) * 44, 430 + (i % 2) * 24
      );
      gF.stroke();
    }

    /* LA ISLA principal: en la referencia NO es una lasca plana, es un CONO
       INVERTIDO de roca que baja casi 200 px hasta una punta, con la meseta
       arriba y la masa colgando. La versión plana dejaba pasar toda la
       nebulosa por debajo: centro-isla marcaba 158 % de cobertura, la región
       con más luz de más de la lámina. La isla es el tapón de esa región. */
    gF.fillStyle = "rgba(8,5,10,0.97)";
    gF.beginPath();
    gF.moveTo(378, 1044);
    for (let x = 378; x <= 855; x += 22) {
      gF.lineTo(x, 1036 + Math.sin(x * 0.05) * 6 + (rnd() - 0.5) * 8);
    }
    /* la caída: de la meseta a la punta, con la roca quebrada en escalones */
    for (let x = 855; x >= 378; x -= 17) {
      const u = 1 - Math.abs(x - 617) / 240;          // 0 en los bordes, 1 al eje
      const prof = Math.pow(Math.max(0, u), 0.7) * 196;
      gF.lineTo(x, 1046 + prof + (rnd() - 0.5) * 30);
    }
    gF.closePath();
    gF.fill();
    /* Estalactitas del vientre: los hilos negros con cuenta de oro.
       Eran 46 y la región marcaba 122 % de cobertura con 49 % de píxeles
       encendidos contra 40 % de la referencia — bajo la isla la referencia
       es una cortina de roca colgante, casi opaca, no un claro. */
    for (let i = 0; i < 104; i++) {
      const x = 386 + rnd() * 462;
      const u = 1 - Math.abs(x - 617) / 240;
      const y0 = 1046 + Math.pow(Math.max(0, u), 0.7) * 190;
      /* Largo acotado a 130: estirados a 200 invadían centro-bajo, que ya
         estaba clavado en 100 % de cobertura, y lo tiraron a 90. */
      const l = 26 + rnd() * 128;
      gF.strokeStyle = "rgba(7,5,10,0.94)";
      gF.lineWidth = 1.1 + rnd() * 2.6;
      gF.beginPath();
      gF.moveTo(x, y0 - 6);
      gF.quadraticCurveTo(x + (rnd() - 0.5) * 22, y0 + l * 0.55, x + (rnd() - 0.5) * 16, y0 + l);
      gF.stroke();
      if (rnd() < 0.45) {
        gF.fillStyle = tinta("214,182,110", 0.4);
        gF.beginPath(); gF.arc(x, y0 + l, 1.4, 0, Math.PI * 2); gF.fill();
      }
    }
    /* LA RED DE ORO: hilos del canto de la isla a un nodo bajo el eje, con
       cuentas — es lo que en la referencia dibuja la retícula sobre la roca */
    const nodo = { x: 614, y: 1186 };
    gF.lineWidth = 0.7;
    for (let i = 0; i < 22; i++) {
      const x0 = 392 + (i / 21) * 452;
      gF.strokeStyle = tinta("206,176,108", 0.24);
      gF.beginPath();
      gF.moveTo(x0, 1044);
      gF.quadraticCurveTo((x0 + nodo.x) / 2, 1044 + (nodo.y - 1044) * 0.72, nodo.x, nodo.y);
      gF.stroke();
      for (const t of [0.35, 0.62, 0.84]) {
        const mx = (1 - t) * (1 - t) * x0 + 2 * (1 - t) * t * ((x0 + nodo.x) / 2) + t * t * nodo.x;
        const my = (1 - t) * (1 - t) * 1044 + 2 * (1 - t) * t * (1044 + (nodo.y - 1044) * 0.72) + t * t * nodo.y;
        gF.fillStyle = tinta("226,198,124", 0.42);
        gF.beginPath(); gF.arc(mx, my, 1.1, 0, Math.PI * 2); gF.fill();
      }
    }
    for (const r of [30, 46]) {
      gF.strokeStyle = tinta("214,182,110", 0.34);
      gF.beginPath(); gF.arc(nodo.x, nodo.y, r, 0, Math.PI * 2); gF.stroke();
    }
    gF.fillStyle = tinta("246,232,190", 0.85);
    gF.beginPath(); gF.arc(nodo.x, nodo.y, 2.6, 0, Math.PI * 2); gF.fill();
    /* canto superior iluminado de la isla */
    gF.strokeStyle = tinta("205,181,121", 0.32);
    gF.lineWidth = 1.2;
    gF.beginPath();
    gF.moveTo(395, 1040);
    for (let x = 395; x <= 840; x += 22) {
      gF.lineTo(x, 1034 + Math.sin(x * 0.05) * 6);
    }
    gF.stroke();
    /* resplandor violeta bajo la isla */
    const bajo = gF.createRadialGradient(617, 1120, 10, 617, 1120, 180);
    bajo.addColorStop(0, "rgba(120,90,170,0.16)");
    bajo.addColorStop(1, "rgba(0,0,0,0)");
    gF.fillStyle = bajo;
    gF.fillRect(430, 1050, 380, 240);

    /* raíces */
    trazar(gF, raices, "10,7,14", 0.92);
    trazar(gF, raices, "150,120,190", 0.07);

    /* islas menores */
    for (const isla of [
      { x: 340, y: 1210, r: 72 }, { x: 830, y: 1228, r: 82 }, { x: 470, y: 1310, r: 40 },
    ]) {
      gF.fillStyle = "rgba(8,5,10,0.95)";
      gF.beginPath();
      gF.moveTo(isla.x - isla.r, isla.y);
      for (let i = 0; i <= 12; i++) {
        const u = i / 12;
        gF.lineTo(isla.x - isla.r + u * isla.r * 2, isla.y - 8 + Math.sin(u * 9) * 5);
      }
      for (let i = 12; i >= 0; i--) {
        const u = i / 12;
        /* mismas cuñas invertidas que la isla mayor, no lascas planas */
        gF.lineTo(
          isla.x - isla.r + u * isla.r * 2,
          isla.y + 10 + (isla.r * 1.15) * Math.pow(Math.sin(u * Math.PI), 0.75) + Math.sin(u * 7) * 8
        );
      }
      gF.closePath();
      gF.fill();
      gF.strokeStyle = tinta("205,181,121", 0.22);
      gF.lineWidth = 0.9;
      gF.beginPath();
      gF.moveTo(isla.x - isla.r + 6, isla.y - 7);
      gF.lineTo(isla.x + isla.r - 6, isla.y - 9);
      gF.stroke();
      /* raicillas de las islas menores */
      for (let i = 0; i < 4; i++) {
        gF.strokeStyle = "rgba(10,7,14,0.9)";
        gF.lineWidth = 1.4;
        gF.beginPath();
        const rx = isla.x + (rnd() - 0.5) * isla.r * 1.2;
        gF.moveTo(rx, isla.y + 8);
        gF.quadraticCurveTo(rx + (rnd() - 0.5) * 20, isla.y + 40, rx + (rnd() - 0.5) * 30, isla.y + 46 + rnd() * 40);
        gF.stroke();
      }
    }

    /* BURBUJAS: delante de la ramazón, como en la referencia */
    for (const b of burbujas) {
      const rim = b.violeta ? "186,158,232" : "206,196,152";
      const gr = gF.createRadialGradient(b.x, b.y, b.r * 0.1, b.x, b.y, b.r);
      gr.addColorStop(0, "rgba(10,7,14,0.72)");
      gr.addColorStop(0.72, "rgba(16,11,22,0.42)");
      gr.addColorStop(1, tinta(rim, 0.16 * b.o));
      gF.fillStyle = gr;
      gF.beginPath(); gF.arc(b.x, b.y, b.r, 0, Math.PI * 2); gF.fill();
      gF.strokeStyle = tinta(rim, 0.34 * b.o);
      gF.lineWidth = 0.9;
      gF.beginPath(); gF.arc(b.x, b.y, b.r, 0, Math.PI * 2); gF.stroke();
      /* filo encendido del cuarto inferior derecho + reflejo de arriba */
      gF.strokeStyle = tinta(rim, 0.55 * b.o);
      gF.lineWidth = 1.2;
      gF.beginPath(); gF.arc(b.x, b.y, b.r, Math.PI * 0.15, Math.PI * 0.72); gF.stroke();
      gF.fillStyle = tinta("236,228,250", 0.34 * b.o);
      gF.beginPath();
      gF.ellipse(b.x - b.r * 0.36, b.y - b.r * 0.44, b.r * 0.18, b.r * 0.1, -0.6, 0, Math.PI * 2);
      gF.fill();
    }

    /* CHISPAS: van DESPUÉS del árbol y de la roca, porque en la referencia
       los puntos de luz están delante de la madera, no detrás */
    for (const ch of chispas) {
      const gr = gF.createRadialGradient(ch.x, ch.y, 0, ch.x, ch.y, ch.r * 4);
      gr.addColorStop(0, tinta(ch.c, ch.o));
      gr.addColorStop(0.3, tinta(ch.c, ch.o * 0.35));
      gr.addColorStop(1, "rgba(0,0,0,0)");
      gF.fillStyle = gr;
      gF.fillRect(ch.x - ch.r * 4, ch.y - ch.r * 4, ch.r * 8, ch.r * 8);
      gF.fillStyle = tinta(ch.c, Math.min(1, ch.o + 0.3));
      gF.beginPath(); gF.arc(ch.x, ch.y, ch.r * 0.45, 0, Math.PI * 2); gF.fill();
    }

    /* cáscaras de las vainas (el brillo interior vive en la capa viva) */
    for (const v of vainas) vainaShell(gF, v);

    /* ondas concéntricas del fondo (y≈1400) */
    for (const [rx, o] of [[46, 0.3], [86, 0.22], [128, 0.16], [168, 0.1]] as const) {
      gF.strokeStyle = tinta("158,126,208", o);
      gF.lineWidth = 1;
      gF.beginPath(); gF.ellipse(610, 1408, rx, rx * 0.24, 0, 0, Math.PI * 2); gF.stroke();
    }

    /* VIÑETA — la caída a negro del borde. La vuelta 1 la tenía tan adentro
       (transparente sólo hasta r=240) que se comía la propia pared de
       nebulosa: a x=307 ya iba en 0,35 de negro. Ahora arranca fuera del
       campo y cae en el margen, que es donde la referencia cae. */
    const vin = gF.createRadialGradient(CX, 760, 430, CX, 760, 1000);
    vin.addColorStop(0, "rgba(0,0,0,0)");
    vin.addColorStop(0.55, "rgba(3,2,5,0.34)");
    vin.addColorStop(1, "rgba(2,1,3,0.88)");
    gF.fillStyle = vin;
    gF.fillRect(0, 0, W, H);
    /* franjas superior e inferior aún más oscuras (cromo sobre negro) */
    const arriba = gF.createLinearGradient(0, 0, 0, 340);
    arriba.addColorStop(0, "rgba(2,1,3,0.95)");
    arriba.addColorStop(0.7, "rgba(2,1,3,0.55)");
    arriba.addColorStop(1, "rgba(0,0,0,0)");
    gF.fillStyle = arriba;
    gF.fillRect(0, 0, W, 340);
    const abajo = gF.createLinearGradient(0, H - 120, 0, H);
    abajo.addColorStop(0, "rgba(0,0,0,0)");
    abajo.addColorStop(1, "rgba(2,1,3,0.9)");
    gF.fillStyle = abajo;
    gF.fillRect(0, H - 120, W, 120);

    /* Placas de los paneles. Medida del interior de ORCHARD STRATA y de
       VOID POLLINATION (cajas sin texto de título):
         referencia  R 15,5±22,3  G 14,0±21,0  B 12,7±18,8
         lámina      R 13,1±30,1  G 11,3±28,8  B 12,4±24,7
       El panel de a21 no es negro: es un pergamino OSCURO Y CÁLIDO, con el
       rojo por encima del azul. El nuestro era negro azulado, y encima con
       más desviación típica que la referencia — o sea texto claro sobre
       nada. La placa lleva ahora una veladura cálida por encima: sube la
       media 2,5 puntos en rojo y verde sin tocar el azul. */
    for (const [x, y, w, h] of placas) {
      gF.fillStyle = "rgba(3,2,4,0.88)";
      gF.fillRect(x - 3, y - 3, w + 6, h + 6);
      gF.fillStyle = "rgba(17,17,9,0.30)";
      gF.fillRect(x - 3, y - 3, w + 6, h + 6);
    }

    /* ornamentos del marco: dobles verticales medidas x26 / x1202,x1211 */
    gF.strokeStyle = tinta("164,138,88", 0.5);
    gF.lineWidth = 1.2;
    for (const x of [26.5, 1202.5]) {
      gF.beginPath(); gF.moveTo(x, 130); gF.lineTo(x, 1440); gF.stroke();
    }
    gF.strokeStyle = tinta("164,138,88", 0.35);
    gF.lineWidth = 1;
    for (const x of [14.5, 1211.5]) {
      gF.beginPath(); gF.moveTo(x, 210); gF.lineTo(x, 1370); gF.stroke();
    }
    /* micro-marcas del canto derecho (ilegibles en la referencia →
       marcas no textuales, nunca texto inventado) */
    for (let y = 570; y < 950; y += 8) {
      const wq = 2 + Math.floor(rnd() * 5);
      gF.fillStyle = tinta("164,138,88", 0.4);
      gF.fillRect(1218, y, wq, 1.4);
    }
    /* circuitos de las esquinas inferiores + filas punteadas y1459 */
    const punteada = (x0: number, n: number) => {
      for (let i = 0; i < n; i++) {
        const r = i === Math.floor(n / 2) ? 3 : 1.4;
        gF.fillStyle = tinta("194,167,107", i === Math.floor(n / 2) ? 0.85 : 0.55);
        gF.beginPath(); gF.arc(x0 + i * 17, 1459, r, 0, Math.PI * 2); gF.fill();
      }
    };
    punteada(78, 9);
    punteada(986, 9);
    gF.strokeStyle = tinta("164,138,88", 0.55);
    gF.lineWidth = 1.2;
    /* brazo inferior izquierdo */
    gF.beginPath();
    gF.moveTo(46, 1424); gF.lineTo(230, 1424); gF.lineTo(258, 1444);
    gF.moveTo(40, 1496); gF.lineTo(300, 1496);
    gF.moveTo(40, 1508); gF.lineTo(290, 1508);
    gF.stroke();
    /* brazo inferior derecho */
    gF.beginPath();
    gF.moveTo(1183, 1424); gF.lineTo(999, 1424); gF.lineTo(971, 1444);
    gF.moveTo(1189, 1496); gF.lineTo(929, 1496);
    gF.moveTo(1189, 1508); gF.lineTo(939, 1508);
    gF.stroke();
    /* esquinas superiores: escuadras con círculo */
    for (const lado of [-1, 1]) {
      const x = lado < 0 ? 40 : 1189;
      gF.strokeStyle = tinta("164,138,88", 0.55);
      gF.beginPath();
      gF.moveTo(x, 96); gF.lineTo(x, 40); gF.lineTo(x + lado * 56, 40);
      gF.stroke();
      gF.beginPath(); gF.arc(x + lado * 14, 68, 7, 0, Math.PI * 2); gF.stroke();
    }
    /* reglas ornamentales que flanquean la marca de la cabecera */
    gF.strokeStyle = tinta("164,138,88", 0.5);
    gF.lineWidth = 1;
    gF.beginPath();
    gF.moveTo(150, 22); gF.lineTo(438, 22);
    gF.moveTo(790, 22); gF.lineTo(1078, 22);
    gF.stroke();
    for (const x of [300, 928]) {
      gF.beginPath();
      gF.moveTo(x - 6, 22); gF.lineTo(x, 17); gF.lineTo(x + 6, 22); gF.lineTo(x, 27);
      gF.closePath(); gF.stroke();
    }
  };

  /* ── capa viva: brillo de vainas, haz, motas ─────────────────────── */
  const pintarVivo = (fase: number) => {
    gV.clearRect(0, 0, W, H);
    gV.save();
    gV.globalCompositeOperation = "lighter";

    /* haz dorado del eje: del anillo a la vaina del fondo */
    const luz = 0.8 + 0.2 * Math.cos(fase * Math.PI * 2);
    const haz = gV.createLinearGradient(0, 470, 0, 1400);
    haz.addColorStop(0, tinta("232,214,150", 0.16 * luz));
    haz.addColorStop(0.5, tinta("222,198,130", 0.1 * luz));
    haz.addColorStop(1, tinta("205,170,220", 0.05));
    gV.fillStyle = haz;
    gV.beginPath();
    gV.moveTo(CX - 9, 470); gV.lineTo(CX + 9, 470);
    gV.lineTo(CX + 22, 1400); gV.lineTo(CX - 22, 1400);
    gV.closePath(); gV.fill();
    gV.strokeStyle = tinta("240,224,170", 0.22 * luz);
    gV.lineWidth = 1.4;
    gV.beginPath(); gV.moveTo(CX, 474); gV.lineTo(CX, 1396); gV.stroke();

    /* la escalera dorada sobre la isla */
    for (let i = 0; i < 8; i++) {
      const y = 1036 - i * 7;
      const w2 = 30 - i * 2.6;
      gV.fillStyle = tinta("230,206,140", (0.16 + i * 0.02) * luz);
      gV.fillRect(CX - w2, y, w2 * 2, 3);
    }

    /* brillo interior de cada vaina, con fase propia */
    for (const v of vainas) {
      const p = 0.62 + 0.38 * Math.sin((fase + v.f) * Math.PI * 2);
      const c = v.tono === "violeta" ? "168,124,236" : v.tono === "palida" ? "226,226,180" : "168,208,70";
      const nucleo = v.tono === "violeta" ? "224,204,250" : "236,246,190";
      /* El halo va en 1,7 veces el semieje y ahí se queda. Se probó
         apretarlo a 1,25 buscando devolverle masa oscura al flanco
         izquierdo (la referencia da 37..68 % de columna oscura en x505..590
         y la lámina 19..26 %): la cobertura cayó a 95 % y centro-medio
         empeoró 19,00 % → 19,29 %. El resplandor de la vaina no es lo que
         sobra en ese flanco. */
      const gr = gV.createRadialGradient(v.x, v.y, 1, v.x, v.y, v.ry * 1.7);
      gr.addColorStop(0, tinta(nucleo, 0.75 * v.br * p));
      gr.addColorStop(0.35, tinta(c, 0.4 * v.br * p));
      gr.addColorStop(1, "rgba(0,0,0,0)");
      gV.fillStyle = gr;
      gV.fillRect(v.x - v.ry * 2, v.y - v.ry * 2, v.ry * 4, v.ry * 4);
      gV.fillStyle = tinta(nucleo, 0.85 * v.br * p);
      gV.beginPath(); gV.ellipse(v.x, v.y, v.rx * 0.3, v.ry * 0.3, 0, 0, Math.PI * 2); gV.fill();
    }

    /* motas ascendentes del haz */
    for (const m of motas) {
      const y = m.y0 - ((fase * 3 + m.v) % 1) * 240;
      if (y < 480) continue;
      gV.fillStyle = tinta("238,226,170", m.o * luz);
      gV.beginPath(); gV.arc(m.x + Math.sin(fase * Math.PI * 2 + m.v * 7) * 5, y, m.r, 0, Math.PI * 2); gV.fill();
    }
    /* deriva ambiente */
    for (const d of deriva) {
      const x = d.x + Math.sin(fase * Math.PI * 2 + d.v * 6.3) * 8;
      const y = d.y + Math.cos(fase * Math.PI * 2 + d.v * 4.1) * 5;
      gV.fillStyle = tinta("208,190,236", d.o * 0.8);
      gV.beginPath(); gV.arc(x, y, d.r, 0, Math.PI * 2); gV.fill();
    }

    /* pulso de las ondas del fondo */
    const pw = 0.5 + 0.5 * Math.sin(fase * Math.PI * 2);
    gV.strokeStyle = tinta("178,146,228", 0.14 * pw);
    gV.lineWidth = 1;
    gV.beginPath(); gV.ellipse(610, 1408, 46 + pw * 60, (46 + pw * 60) * 0.24, 0, 0, Math.PI * 2); gV.stroke();
    gV.restore();
  };

  montarLienzo({ raiz, cuadro: pintarVivo, inicial: pintarFondo, periodo: 18000, periodoReducido: 54000 });
  montarEscala();
      montarMovil();
</script>
