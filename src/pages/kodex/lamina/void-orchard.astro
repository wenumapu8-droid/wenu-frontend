---
/**
 * KODEX−∞ · LAB · CROMO DE ARCHIVO · a21 VOID ORCHARD
 *
 * Segunda lámina de la serie de archivo, sobre el piloto silence-engine.
 * Entra como lab —mismo precedente—: noindex hasta que el creador la mire.
 *
 * TODO el texto visible está TRANSCRITO de
 * reference/pendientes/a21-void-orchard.png (recortes con zoom 3×).
 * Nada se inventa: la regla dura de la serie es que aforismos y rótulos
 * son del creador.
 *
 * DIFERENCIAS MEDIDAS contra el piloto a28 (perfil de tinta dorada,
 * umbral lum 25):
 * · Cabecera CENTRADA (variante `centrada` de CabeceraArchivo): marca
 *   y14..31, lema "• LIVING ARCHIVE OF THE UNBOUND •" y43..50;
 *   "// PAGE / 21" a la IZQUIERDA (bloque propio de esta página, el
 *   componente solo trae uno) y "SPECIMEN / VØ-21" a la derecha.
 * · Título y84..166 (versal 82 → cuerpo 131), subtítulo violeta
 *   y192..217 (versal 25 → 40). a21 NO tiene la regla ornamental de
 *   a28 entre título y subtítulo: se oculta.
 * · DOS columnas de paneles con marco dorado propio y huecos entre sí
 *   (no un riel único): izq x44..238 con cortes y240/554, y583/902,
 *   y927/1271, y1298/1427; der x953..1185 con y240/574, y588/980,
 *   y1002/1324, y1324/1459. Punteado de remate en y1459.
 * · El fondo NO es negro: es pintura violeta de borde a borde con
 *   viñeta (centro rgb(55,45,61) medido, bordes rgb(12,9,6), detrás de
 *   los paneles rgb(5,4,4)). Por eso el canvas acá es de PÁGINA ENTERA
 *   (1229×1536) y las placas oscuras de los paneles se pintan en él.
 * · a21 NO tiene sello de clasificación ni canto con texto: las
 *   esquinas llevan circuitos ornamentales sin letra. Regla dura:
 *   texto ilegible/inexistente → marcas no textuales, así que
 *   SelloClasificacion y TarjetaMetrica (vocabulario de a28/a24) no
 *   aparecen — este cromo es de fichas clave/valor, no de tarjetas
 *   de métrica con valor grande.
 */
import CabeceraArchivo from "../../../components/kodex/archivo/CabeceraArchivo.astro";
import TituloBilingue from "../../../components/kodex/archivo/TituloBilingue.astro";
import AforismoPie from "../../../components/kodex/archivo/AforismoPie.astro";
import { rng } from "../../../components/kodex/lamina/kit/rng";

/* ── diagramas del riel: geometría determinista (rng del kit) ─────── */

/* SYSTEM READING: onda mitad verde-lima mitad violeta sobre retícula.
   Forma transcrita: ruido de picos, más denso al centro de cada mitad. */
const rOnda = rng(0x5e21);
const N = 72;
const puntosOnda = Array.from({ length: N }, (_, i) => {
  const u = i / (N - 1);
  const x = u * 196;
  const pico =
    Math.sin(u * Math.PI * 9 + 0.7) * 10 +
    Math.sin(u * Math.PI * 23) * 7 +
    (rOnda() - 0.5) * 26;
  const env = 0.45 + 0.55 * Math.sin(((u * 2) % 1) * Math.PI);
  return { x, y: 44 - pico * env };
});
const mitad = Math.floor(N / 2);
const ondaVerde = puntosOnda.slice(0, mitad + 1).map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
const ondaVioleta = puntosOnda.slice(mitad).map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");

/* VOID POLLINATION: rueda radial con seis vainas sobre los anillos.
   Transcrito del recorte: cruz de ejes, 3 anillos + retícula fina,
   ticks radiales, vainas violeta/verde con destello, centro dorado. */
const vainasPolen = [-90, -30, 30, 90, 150, 210].map((grados, i) => {
  const a = (grados * Math.PI) / 180;
  const r = i % 2 ? 64 : 56;
  return {
    x: 85 + r * Math.cos(a),
    y: 85 + r * Math.sin(a),
    rot: grados + 90,
    tono: i % 3 === 1 ? "violeta" : i % 3 === 2 ? "palida" : "oscura",
  };
});
const ticksPolen = Array.from({ length: 24 }, (_, i) => {
  const a = (i / 24) * Math.PI * 2;
  return {
    x1: 85 + 70 * Math.cos(a), y1: 85 + 70 * Math.sin(a),
    x2: 85 + (i % 2 ? 74 : 78) * Math.cos(a), y2: 85 + (i % 2 ? 74 : 78) * Math.sin(a),
  };
});
/* VOID POLLINATION · retícula fina: en la referencia la rueda tiene una
   telaraña de arcos y radios entre los anillos gruesos, no tres aros pelados.
   El panel medía 61 % de cobertura. */
const radiosPolen = Array.from({ length: 16 }, (_, i) => (i / 16) * Math.PI * 2);
const orbitasPolen = vainasPolen.map((v) => ({ x: v.x, y: v.y }));

/* ORCHARD STRATA · cada estrato es un nido de anillos con radios y púas. */
const radiosEstrato = Array.from({ length: 16 }, (_, i) => (i / 16) * Math.PI * 2);
/* dosel del estrato alto: ramitas del árbol verde encendido */
const doselEstrato = Array.from({ length: 14 }, (_, i) => {
  const a = -Math.PI / 2 + (i - 6.5) * 0.28;
  const l = 20 + ((i * 5) % 11);
  return {
    x: +(48 + Math.cos(a) * l).toFixed(1),
    y: +(46 + Math.sin(a) * l).toFixed(1),
    o: +(0.4 + (i % 3) * 0.16).toFixed(2),
    w: +(0.7 + (i % 2) * 0.5).toFixed(1),
    r: +(1.4 + (i % 3) * 0.7).toFixed(1),
  };
});
const hilosEstrato = [-30, -18, -8, 8, 18, 30].map((d) => ({ x: 48 + d, b: d * 0.35 }));
/* espiral del océano de semillas: tres vueltas achatadas */
const espiralSemillas = Array.from({ length: 130 }, (_, i) => {
  const t = i / 129;
  const a = t * Math.PI * 6;
  const r = 40 * (1 - t);
  return `${(48 + Math.cos(a) * r).toFixed(1)},${(302 + Math.sin(a) * r * 0.3).toFixed(1)}`;
}).map((p, i) => (i ? `L${p}` : `M${p}`)).join(" ");
const motasSemillas = Array.from({ length: 26 }, (_, i) => {
  const a = (i * 2.39996) % (Math.PI * 2);
  const r = 6 + ((i * 7) % 34);
  return {
    x: (48 + Math.cos(a) * r).toFixed(1),
    y: (302 + Math.sin(a) * r * 0.3).toFixed(1),
    r: (0.7 + (i % 3) * 0.35).toFixed(1),
    o: (0.35 + (i % 4) * 0.14).toFixed(2),
  };
});
/* SEED MORPHOLOGY · nervios, pétalos y malla de las tres semillas.
   Medido sobre la referencia con lupa (crop x44..144, y990..1230): la semilla
   ocupa ~56x59 px y está LADEADA ~16°. Es un ovoide GORDO y vidrioso, no una
   lasca: la vuelta 27 la dibujó de 56x84 en punta y el panel pasó de 11,10 %
   a 12,78 % — la silueta equivocada cuesta más que la falta de relleno. */
const nerviosSemilla = Array.from({ length: 12 }, (_, i) => {
  const a = (i / 12) * Math.PI * 2;
  return {
    x: +(27 + Math.cos(a) * 21).toFixed(1),
    y: +(31 + Math.sin(a) * 26).toFixed(1),
  };
});
const petalosSemilla = Array.from({ length: 6 }, (_, i) => {
  const a = (i / 6) * Math.PI * 2 - Math.PI / 2;
  return { x: +(27 + Math.cos(a) * 8).toFixed(1), y: +(31 + Math.sin(a) * 10).toFixed(1) };
});
const mallaHusk = Array.from({ length: 8 }, (_, i) => {
  const y = 9 + i * 6.4;
  const w = 22 * Math.sin(((y - 1) / 60) * Math.PI);
  return { x1: +(27 - w).toFixed(1), y1: +y.toFixed(1), x2: +(27 + w).toFixed(1), y2: +y.toFixed(1) };
});
