  .vo-diagrama { margin-top: 10px; }
  /* La rueda de VOID POLLINATION va de borde a borde de la caja. Medida en la
     referencia (recorte x38..246 del panel) abarca de x19 a x192: 173 px de
     diámetro contra los 140 de la lámina, que además dejaba un margen de aire
     a los dos lados que allá no existe. Se agranda el dibujo y se le deja
     morder el acolchado del panel. */
  .vo-panel--polen .vo-diagrama { width: 178px; height: 178px; margin: 8px -4px 0; }
  /* Las cuatro notas de VOID POLLINATION entran cada una en UN renglón en la
     referencia. "LAS SEMILLAS FLOTAN EN EL ÉTER." son 31 caracteres que allá
     miden 169 px — 5,45 px por carácter — y acá iban en 9 px con 0,1em de
     tracking, 6,85 px por carácter, 212 px: se partían las dos españolas. */
  .vo-nota {
    margin-top: 8px !important;
    font-weight: 500;
    font-size: 8.2px;
    letter-spacing: 0.005em;
    opacity: 0.85;
  }
  .vo-nota + .vo-nota { margin-top: 3px !important; }
  .vo-nota--es { color: #99a07f; opacity: 0.75; }
  .vo-nota--es + .vo-nota--es { margin-top: 3px !important; }
  p.vo-nota--es:nth-of-type(3) { margin-top: 10px !important; }

  /* La columna de texto de SEED MORPHOLOGY mide 112 px (170 de interior menos
     la semilla y el hueco). "POTENTIAL: NARRATIVE" son 20 caracteres: a 8,4 px
     con 0,02em caben en 113. Con la metrica anterior partia en dos renglones
     en las tres filas y la ultima se salia de la caja. */
  /* Las tres filas se reparten TODA la caja. Centros de semilla, leídos del
     perfil de tinta por filas de la columna x52..118 (sólo semillas, sin
     texto), umbral 45:
       referencia  y1032 · y1110 · y1197   (paso 78 y 87)
       lámina v45  y1025 · y1096 · y1168   (paso 71)
     La lámina apretaba las tres arriba y dejaba caja vacía abajo. Con paso
     85 y sin tocar nada más las tres bajaban 8 px de más (1039/1123/1207):
     el paso va en 82 y la regla del panel cede 8 px de aire. */
  .vo-morfo {
    margin-top: 23px;
    display: flex;
    align-items: center;
    gap: 8px;
    text-align: left;
  }
  .vo-morfo__en { font-weight: 600; font-size: 9px; letter-spacing: 0.045em; color: #9ba283; }
  .vo-morfo__es { margin-top: 3px !important; font-weight: 500; font-size: 8.6px; letter-spacing: 0.045em; color: var(--arch-acento); opacity: 0.9; }
  .vo-morfo__pot { margin-top: 6px !important; font-weight: 500; font-size: 8.4px; letter-spacing: 0.02em; color: #94997a; opacity: 0.85; }

  /* La cita entra en CUATRO renglones en la referencia y acá salían cinco.
     '"IN THE ABSENCE OF FORM,' son 24 caracteres y allá van de x95 a x238,
     143 px: 5,95 px por carácter. Acá iban en 10 px con 0,1em de tracking,
     7,6 px por carácter, 182 px — y el renglón se partía. */
  .vo-cita__texto { text-align: left; }
  .vo-cita__en { font-weight: 500; font-size: 9px; letter-spacing: 0.005em; color: #9c8a5c; }
  .vo-cita__en + .vo-cita__en { margin-top: 4px !important; }
  .vo-cita__es { margin-top: 4px !important; font-weight: 500; font-size: 8.6px; letter-spacing: 0.005em; color: var(--arch-acento); }
  p.vo-cita__es:nth-of-type(3) { margin-top: 10px !important; }

  .vo-estratos { position: relative; margin-top: 10px; text-align: left; }
  .vo-estratos > svg { display: block; }
  .vo-estratos__rotulos { position: absolute; left: 98px; top: 0; right: 0; }
  .vo-estratos__rotulos > div { position: absolute; }
  /* En la referencia "CANOPY OF POTENTIAL" y "CONDUCTOS RADICALES" entran de
     una en su renglón. Acá partían en dos, y cada partición corre los cuatro
     rótulos hacia abajo hasta desalinearlos de sus discos. */
  .vo-estratos__rotulos .vo-metrica__en {
    font-size: 8.5px;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .vo-estratos__rotulos .vo-metrica__es {
    font-size: 7.5px;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .vo-lectura__senal { text-align: left; }
  .vo-metrica--linea { margin-top: 10px; align-items: baseline; }
  .vo-metrica--linea .vo-metrica__valor { font-size: 13px; }
  .vo-obs__titulo { margin-bottom: 8px !important; }
  .vo-panel--observacion .vo-ficha__v {
