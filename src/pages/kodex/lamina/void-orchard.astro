    letter-spacing: 0.02em;
  }
  .vo-panel--observacion .vo-violeta:nth-of-type(4) { margin-top: 9px !important; }
  .vo-obs__glifo { position: absolute; right: 8px; top: 12px; }

  /* ── pie: regla y1459, versos y1471..1495, remate ∞ y1511..1519 ── */
  .arch-caja--pie { left: 250px; width: 730px; top: 1452px; }
  .arch-caja--pie :global(.arch-pie__regla) { display: none; }
  .arch-caja--pie :global(.arch-pie__aforismo) { margin-top: 14px; }
  .arch-caja--pie :global(.arch-pie__verso) {
    font-family: var(--vo-sans);
