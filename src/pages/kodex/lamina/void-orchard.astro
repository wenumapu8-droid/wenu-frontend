  /* fichas clave/valor (ARCHIVE DATA) */
  .vo-ficha { margin-top: 11px; }
  /* La sans del sistema en 700 es más ANCHA que la de la referencia: los
     rótulos de panel que allá entran en un renglón ("CANOPY OF POTENTIAL",
