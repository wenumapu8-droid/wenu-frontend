    letter-spacing: 0.1em;
  }
  .sl-inf--izq { left: 165px; }
  .sl-inf--der { right: 165px; }
</style>

<script>
  import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
  import { rng } from "../../../components/kodex/lamina/kit/rng";
  import { montarEscala } from "../../../components/kodex/lamina/kit/escala";

  const canvas = document.getElementById("sl-reticula") as HTMLCanvasElement;
  const raiz = document.querySelector("[data-lam]") as HTMLElement;
  const g = canvas.getContext("2d")!;
  const rnd = rng(0x5124);
  const W = 1229, H = 810;

  /* centro del volante en coords de página (el canvas arranca en y=0) */
  const CX = 614, CY = 470, RXO = 505, RYO = 205;

  /* ── campo de estrellas fijo ── */
  const estrellas: Array<{x:number;y:number;r:number;o:number;v:number;cruz:boolean}> = [];
  for (let k = 0; k < 760; k++) {
    estrellas.push({
      x: rnd() * W, y: rnd() * H,
      r: 0.3 + rnd() * 1.1,
      o: 0.12 + rnd() * 0.55,
      v: rnd(),
      cruz: rnd() < 0.06,
    });
  }

  /* galaxias: posición, tamaño, rotación (medidas a ojo de la referencia) */
  const galaxias = [
    { x: 300, y: 242, r: 22, rot: 0.4 },
    { x: 935, y: 256, r: 34, rot: -0.5 },
    { x: 250, y: 465, r: 20, rot: 0.9 },
    { x: 958, y: 695, r: 30, rot: 0.3 },
    { x: 172, y: 740, r: 36, rot: -0.8 },
  ];

  /* ── geometría de la retícula: nodos en 3 anillos + centro ── */
  type Nodo = { x: number; y: number; prof: number; anillo: number; torre: boolean; h: number };
  const proy = (ang: number, f: number) => ({
    x: CX + Math.cos(ang) * RXO * f,
    y: CY + Math.sin(ang) * RYO * f,
    prof: Math.sin(ang),
  });
  const anillos = [
    { f: 1.0, n: 10, off: Math.PI / 10, torres: (i: number) => true, h: 56 },
    { f: 0.72, n: 10, off: 0, torres: (i: number) => true, h: 44 },
    { f: 0.44, n: 8, off: Math.PI / 8, torres: (i: number) => i % 2 === 0, h: 38 },
  ];
  const nodos: Nodo[][] = anillos.map((a, ai) =>
    Array.from({ length: a.n }, (_, i) => {
      const ang = (i / a.n) * Math.PI * 2 + a.off;
      const p = proy(ang, a.f);
      return { ...p, anillo: ai, torre: a.torres(i), h: a.h * (0.8 + rnd() * 0.4) };
    })
  );

  const linea = (a: {x:number;y:number}, b: {x:number;y:number}, estilo: string, w = 1, dash?: number[]) => {
    g.strokeStyle = estilo;
    g.lineWidth = w;
    if (dash) g.setLineDash(dash);
    g.beginPath(); g.moveTo(a.x, a.y); g.lineTo(b.x, b.y); g.stroke();
    if (dash) g.setLineDash([]);
  };

  /* HILO de la retícula.
     En la referencia la telaraña DOMINA: cada arista es un núcleo casi blanco
     con un resplandor azul alrededor, y los cristales son sólo acentos sobre
     ella. Un trazo plano de 0,7 px sobre fondo negro se lee gris y desaparece
     bajo los halos de los cristales — por eso la retícula era invisible. Cada
     hilo va en dos pasadas: resplandor aditivo ancho y difuso, y encima el
     núcleo fino y brillante. */
  const hilo = (
    a: {x:number;y:number}, b: {x:number;y:number},
    rgb: string, alfa: number, w = 1, dash?: number[]
  ) => {
    g.save();
    g.globalCompositeOperation = "lighter";
    linea(a, b, tinta(rgb, alfa * 0.3), w * 3.4, dash);
    linea(a, b, tinta(rgb, alfa * 0.5), w * 1.9, dash);
    g.restore();
    linea(a, b, tinta("232,240,255", alfa), w, dash);
  };

  const elipse = (f: number, estilo: string, w = 1, dash?: number[]) => {
    g.strokeStyle = estilo;
    g.lineWidth = w;
    if (dash) g.setLineDash(dash);
    g.beginPath(); g.ellipse(CX, CY, RXO * f, RYO * f, 0, 0, Math.PI * 2); g.stroke();
    if (dash) g.setLineDash([]);
  };

  /* torre de cristal: plataforma + tallo + cristal + halo */
  const cristal = (x: number, y: number, h: number, luz: number, cerca: number) => {
    const w = h * 0.16;
    /* plataforma */
    g.strokeStyle = tinta("211,207,200", 0.35 * cerca);
    g.lineWidth = 1;
    g.beginPath(); g.ellipse(x, y, w * 2.6, w * 0.85, 0, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("176,150,110", 0.25 * cerca);
    g.beginPath(); g.ellipse(x, y, w * 1.6, w * 0.55, 0, 0, Math.PI * 2); g.stroke();
    /* colgante bajo la plataforma */
    g.strokeStyle = tinta("150,170,220", 0.3 * cerca);
    g.beginPath(); g.moveTo(x, y + 2); g.lineTo(x, y + h * 0.34); g.stroke();
    g.fillStyle = tinta("120,150,220", 0.28 * cerca);
    g.beginPath();
    g.moveTo(x, y + h * 0.36 + 8);
    g.lineTo(x - w * 0.5, y + h * 0.3);
    g.lineTo(x, y + h * 0.22);
    g.lineTo(x + w * 0.5, y + h * 0.3);
    g.closePath(); g.fill();
    /* halo aditivo */
    g.save();
    g.globalCompositeOperation = "lighter";
    const halo = g.createRadialGradient(x, y - h * 0.55, 2, x, y - h * 0.55, h * 0.95);
    halo.addColorStop(0, tinta("155,190,255", 0.5 * luz * cerca));
    halo.addColorStop(0.5, tinta("125,135,235", 0.16 * luz * cerca));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo;
    g.beginPath(); g.arc(x, y - h * 0.55, h * 0.95, 0, Math.PI * 2); g.fill();
    /* cuerpo del cristal */
    const grad = g.createLinearGradient(x, y - h, x, y);
    grad.addColorStop(0, tinta("235,244,255", 0.95 * cerca));
    grad.addColorStop(0.45, tinta("150,190,255", 0.8 * cerca));
    grad.addColorStop(1, tinta("90,110,200", 0.5 * cerca));
    g.fillStyle = grad;
    g.beginPath();
    g.moveTo(x, y - h);
    g.lineTo(x + w, y - h * 0.55);
    g.lineTo(x + w * 0.55, y - h * 0.12);
    g.lineTo(x, y);
    g.lineTo(x - w * 0.55, y - h * 0.12);
    g.lineTo(x - w, y - h * 0.55);
    g.closePath(); g.fill();
    g.strokeStyle = tinta("225,238,255", 0.6 * cerca);
    g.lineWidth = 0.8;
    g.stroke();
    g.beginPath(); g.moveTo(x, y - h); g.lineTo(x, y); g.stroke();
    /* destello del vértice */
    g.strokeStyle = tinta("240,248,255", 0.75 * luz * cerca);
    g.lineWidth = 1;
    g.beginPath();
    g.moveTo(x - 7, y - h); g.lineTo(x + 7, y - h);
    g.moveTo(x, y - h - 7); g.lineTo(x, y - h + 7);
    g.stroke();
    g.restore();
  };

  const pintar = (fase: number) => {
    g.clearRect(0, 0, W, H);
    const luz = 0.88 + 0.12 * Math.cos(fase * Math.PI * 2);

    /* fondo profundo con bruma azul */
    const fondo = g.createLinearGradient(0, 0, 0, H);
    fondo.addColorStop(0, "#04060d");
    fondo.addColorStop(0.5, "#060a15");
    fondo.addColorStop(1, "#04050c");
    g.fillStyle = fondo;
    g.fillRect(0, 0, W, H);

    /* ambiente radial calibrado: la referencia tiene viñeta — centro
       encendido, cantos a negro */
    const amb = g.createRadialGradient(CX, CY + 10, 60, CX, CY + 10, 620);
    amb.addColorStop(0, tinta("70,90,150", 0.35));
    amb.addColorStop(0.55, tinta("40,52,95", 0.14));
    amb.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = amb;
    g.fillRect(0, 0, W, H);

    /* estrellas con titileo */
    for (const e of estrellas) {
      const tw = 0.7 + 0.3 * Math.sin((fase * 2 + e.v) * Math.PI * 2);
      g.fillStyle = tinta("214,224,245", e.o * tw);
      g.beginPath(); g.arc(e.x, e.y, e.r, 0, Math.PI * 2); g.fill();
      if (e.cruz) {
        g.strokeStyle = tinta("214,224,245", e.o * 0.5 * tw);
        g.lineWidth = 0.6;
        g.beginPath();
        g.moveTo(e.x - 4, e.y); g.lineTo(e.x + 4, e.y);
        g.moveTo(e.x, e.y - 4); g.lineTo(e.x, e.y + 4);
        g.stroke();
      }
    }

    /* galaxias suaves */
    for (const ga of galaxias) {
      g.save();
      g.translate(ga.x, ga.y);
      g.rotate(ga.rot);
      const gg = g.createRadialGradient(0, 0, 1, 0, 0, ga.r);
      gg.addColorStop(0, tinta("225,220,240", 0.5));
      gg.addColorStop(0.3, tinta("160,150,190", 0.2));
      gg.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = gg;
      g.beginPath(); g.ellipse(0, 0, ga.r, ga.r * 0.45, 0, 0, Math.PI * 2); g.fill();
      g.strokeStyle = tinta("200,195,220", 0.18);
      g.lineWidth = 0.8;
      g.beginPath(); g.ellipse(0, 0, ga.r * 0.7, ga.r * 0.28, 0, 0.5, Math.PI * 1.6); g.stroke();
      g.restore();
    }

    /* arcos orbitales amplios (trazo fino cálido) */
    for (const [f, o] of [[1.18, 0.1], [1.06, 0.08]] as const) {
      elipse(f, tinta("196,180,150", o), 0.8);
    }

    /* ── mitad LEJANA de la retícula (prof < 0) al 55 % ── */
    const dib = (filtro: (p: number) => boolean, cerca: number) => {
      /* aros de la retícula: sólo tramo correspondiente */
      for (const a of anillos) {
        g.strokeStyle = tinta("205,200,190", 0.45 * cerca);
        g.lineWidth = 1;
        g.beginPath();
        g.ellipse(CX, CY, RXO * a.f, RYO * a.f, 0, filtro(-1) ? Math.PI : 0, filtro(-1) ? Math.PI * 2 : Math.PI);
        g.stroke();
        /* riel doble del anillo exterior */
        if (a.f === 1) {
          g.strokeStyle = tinta("205,200,190", 0.18 * cerca);
          g.beginPath();
          g.ellipse(CX, CY, RXO * a.f, RYO * a.f + 5, 0, filtro(-1) ? Math.PI : 0, filtro(-1) ? Math.PI * 2 : Math.PI);
          g.stroke();
          g.setLineDash([1, 5]);
          g.beginPath();
          g.ellipse(CX, CY, RXO * a.f, RYO * a.f + 2.5, 0, filtro(-1) ? Math.PI : 0, filtro(-1) ? Math.PI * 2 : Math.PI);
          g.stroke();
          g.setLineDash([]);
        }
      }
      /* órbitas punteadas intermedias */
      elipse(0.93, tinta("170,180,215", 0.16 * cerca), 0.8, [2, 5]);
      elipse(0.86, tinta("170,180,215", 0.2 * cerca), 0.8, [2, 5]);
      elipse(0.58, tinta("170,180,215", 0.18 * cerca), 0.8, [2, 5]);
      elipse(0.5, tinta("170,180,215", 0.15 * cerca), 0.8, [1, 4]);

      /* cuerdas y radios */
      for (let ai = 0; ai < nodos.length; ai++) {
        const ring = nodos[ai];
        for (let i = 0; i < ring.length; i++) {
          const nd = ring[i];
          if (!filtro(nd.prof)) continue;
          /* radio al centro */
          hilo(nd, { x: CX, y: CY }, "150,180,245", 0.5 * cerca, 0.9);
          /* al vecino del mismo anillo: viga doble en el exterior */
          const vec = ring[(i + 1) % ring.length];
          hilo(nd, vec, "130,165,245", 0.92 * cerca, ai === 0 ? 1.8 : 1.3);
          if (ai === 0) {
            hilo({ x: nd.x, y: nd.y + 5 }, { x: vec.x, y: vec.y + 5 }, "130,165,245", 0.5 * cerca, 0.9);
            linea({ x: nd.x, y: nd.y + 2.5 }, { x: vec.x, y: vec.y + 2.5 }, tinta("205,205,215", 0.34 * cerca), 0.6, [1, 4]);
          }
          /* al anillo interior */
          if (ai < nodos.length - 1) {
            const inner = nodos[ai + 1];
            const j = Math.round((i / ring.length) * inner.length) % inner.length;
            hilo(nd, inner[j], "150,180,245", 0.6 * cerca, 1, [3, 4]);
            hilo(nd, inner[(j + 1) % inner.length], "150,180,245", 0.38 * cerca, 0.85);
          }
          /* cuerdas largas del anillo exterior */
          if (ai === 0) {
            hilo(nd, ring[(i + 3) % ring.length], "145,165,235", 0.4 * cerca, 0.85, [1, 4]);
            if (i % 2 === 0) hilo(nd, ring[(i + 4) % ring.length], "145,165,235", 0.3 * cerca, 0.85);
          }
          /* motas de luz sobre la viga */
          if (ai === 0) {
            for (const t of [0.3, 0.62, 0.85]) {
              const mx = nd.x + (vec.x - nd.x) * t, my = nd.y + (vec.y - nd.y) * t;
              g.fillStyle = tinta("225,235,255", 0.6 * cerca);
              g.beginPath(); g.arc(mx, my, 1, 0, Math.PI * 2); g.fill();
            }
          }
        }
      }

      /* nodos y torres, ordenados por y proyectada */
      const capa = nodos.flat().filter((nd) => filtro(nd.prof)).sort((a, b) => a.y - b.y);
      for (const nd of capa) {
        /* nodo con brillo */
        g.save();
        g.globalCompositeOperation = "lighter";
        const halo = g.createRadialGradient(nd.x, nd.y, 0.5, nd.x, nd.y, 12);
        halo.addColorStop(0, tinta("190,215,255", 0.6 * luz * cerca));
        halo.addColorStop(1, "rgba(0,0,0,0)");
        g.fillStyle = halo;
        g.beginPath(); g.arc(nd.x, nd.y, 12, 0, Math.PI * 2); g.fill();
        g.restore();
        g.fillStyle = tinta("235,242,255", 0.85 * cerca);
        g.beginPath(); g.arc(nd.x, nd.y, 1.6, 0, Math.PI * 2); g.fill();
        if (nd.torre) cristal(nd.x, nd.y, nd.h, luz, cerca);
      }
    };

    dib((p) => p < 0, 0.55);

    /* ── centro: rosetón de anillos + eje + gran cristal ── */
    for (const [f, o] of [
      [0.32, 0.3], [0.28, 0.25], [0.24, 0.35], [0.2, 0.3],
      [0.165, 0.45], [0.13, 0.35], [0.095, 0.45], [0.06, 0.4],
    ] as const) {
      elipse(f, tinta("205,200,190", o), 1);
    }
    elipse(0.36, tinta("170,185,225", 0.22), 0.8, [2, 4]);
    /* aro encendido del rosetón */
    g.save();
    g.globalCompositeOperation = "lighter";
    g.strokeStyle = tinta("150,180,255", 0.45 * luz);
    g.lineWidth = 3;
    g.beginPath(); g.ellipse(CX, CY, RXO * 0.135, RYO * 0.135, 0, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("170,195,255", 0.3 * luz);
    g.lineWidth = 1.4;
    g.beginPath(); g.ellipse(CX, CY, RXO * 0.2, RYO * 0.2, 0, 0, Math.PI * 2); g.stroke();
    g.restore();
    /* peine de marcas del rosetón */
    for (let k = 0; k < 40; k++) {
      const a = (k / 40) * Math.PI * 2;
      g.strokeStyle = tinta("190,195,220", 0.3);
      g.lineWidth = 0.7;
      g.beginPath();
      g.moveTo(CX + Math.cos(a) * RXO * 0.24, CY + Math.sin(a) * RYO * 0.24);
      g.lineTo(CX + Math.cos(a) * RXO * (k % 4 ? 0.26 : 0.29), CY + Math.sin(a) * RYO * (k % 4 ? 0.26 : 0.29));
      g.stroke();
    }
    /* eje vertical de la lámina */
    g.strokeStyle = tinta("200,210,240", 0.3);
    g.lineWidth = 0.8;
    g.beginPath(); g.moveTo(CX, 200); g.lineTo(CX, H - 18); g.stroke();
    for (const y of [215, 252, CY + 240, CY + 290]) {
      g.strokeStyle = tinta("210,220,245", 0.4);
      g.beginPath();
      g.moveTo(CX - 4, y); g.lineTo(CX, y - 5); g.lineTo(CX + 4, y); g.lineTo(CX, y + 5);
      g.closePath(); g.stroke();
    }
    /* gran cristal central */
    cristal(CX, CY + 8, 150, luz, 1);
    g.save();
    g.globalCompositeOperation = "lighter";
    const nucleo = g.createRadialGradient(CX, CY - 60, 4, CX, CY - 60, 150);
    nucleo.addColorStop(0, tinta("210,228,255", 0.6 * luz));
    nucleo.addColorStop(0.5, tinta("135,155,240", 0.2 * luz));
    nucleo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = nucleo;
    g.beginPath(); g.arc(CX, CY - 60, 150, 0, Math.PI * 2); g.fill();
    g.restore();
    /* cristal colgante bajo el centro */
    g.strokeStyle = tinta("160,180,230", 0.4);
    g.beginPath(); g.moveTo(CX, CY + 16); g.lineTo(CX, CY + 150); g.stroke();
    const inv = (x: number, y: number, h: number, o: number) => {
      g.fillStyle = tinta("130,160,230", o);
      g.beginPath();
      g.moveTo(x, y + h);
      g.lineTo(x - h * 0.18, y + h * 0.4);
      g.lineTo(x, y);
      g.lineTo(x + h * 0.18, y + h * 0.4);
      g.closePath(); g.fill();
    };
    inv(CX, CY + 150, 56, 0.5);

    /* ── mitad CERCANA (prof ≥ 0) a pleno ── */
    dib((p) => p >= 0, 1);

    /* viñeta final: los cantos de la referencia caen a negro */
    const vin = g.createRadialGradient(CX, CY + 30, 300, CX, CY + 30, 700);
    vin.addColorStop(0, "rgba(0,0,0,0)");
    vin.addColorStop(1, "rgba(2,3,7,0.55)");
    g.fillStyle = vin;
    g.fillRect(0, 0, W, H);
  };

  montarLienzo({ raiz, cuadro: pintar, periodo: 22000, periodoReducido: 60000 });
  montarEscala();
</script>
