---
/**
 * KODEX−∞ · LAB · SERIE ARCHIVO · a24 STAR LATTICE (PAGE 24)
 *
 * Misma estructura que el piloto silence-engine: cromo con los seis
 * componentes de src/components/kodex/archivo/ + organismo procedural
 * en canvas (montarLienzo) + montarEscala. Entra como lab, noindex.
 *
 * TODO el texto visible está TRANSCRITO de
 * reference/pendientes/a24-star-lattice.png (recortes a 2×). Nada se
 * inventa. En a24 las TarjetaMetrica van EN FILA horizontal con marco
 * propio (no riel lateral): mismo vocabulario, otra disposición.
 *
 * EL ORGANISMO: la retícula estelar — red de nodos-estrella con torres
 * de cristal sobre un anillo elíptico visto en perspectiva, aristas
 * finas entre vecinos, halos en los nodos mayores, galaxias y polvo al
 * fondo. Procedural determinista (rng con semilla), proyección simple
 * 3D→2D ordenada por profundidad.
 *
 * La lámina se dibuja a 1229×1536 (el tamaño de su referencia) y se
 * escala con transform calculado en JS (trampa documentada de scale()).
 */
import CabeceraArchivo from "../../../components/kodex/archivo/CabeceraArchivo.astro";
import TituloBilingue from "../../../components/kodex/archivo/TituloBilingue.astro";
import TarjetaMetrica from "../../../components/kodex/archivo/TarjetaMetrica.astro";
import AforismoPie from "../../../components/kodex/archivo/AforismoPie.astro";
import { rng } from "../../../components/kodex/lamina/kit/rng";

/* ── Diagramas chicos de las tarjetas: geometría determinista ─────── */

/* NODE COUNT: retícula hexagonal — hexágono + hexagrama + nodos. */
const hex = (cx: number, cy: number, r: number, rot = 0) =>
  Array.from({ length: 6 }, (_, i) => {
    const a = (i / 6) * Math.PI * 2 + rot;
    return [cx + r * Math.cos(a), cy + r * Math.sin(a)] as const;
  });
const hexPts = (pts: ReadonlyArray<readonly [number, number]>) =>
  pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
const hx1 = hex(100, 78, 62, Math.PI / 6);
const hx2 = hex(100, 78, 40, 0);
const hx3 = hex(100, 78, 22, Math.PI / 6);

/* NODE DENSITY: señal montañosa violeta, con semilla. */
const rDen = rng(0x24a);
let denAcc = 0.45;
const denPts = Array.from({ length: 120 }, (_, i) => {
  denAcc = Math.max(0.06, Math.min(0.96, denAcc + (rDen() - 0.5) * 0.34));
  const pico = rDen() < 0.07 ? 0.35 + rDen() * 0.4 : 0;
  const v = Math.min(0.98, denAcc + pico);
  return `${(i / 119) * 218},${(52 - v * 46).toFixed(1)}`;
}).join(" ");

/* COHERENCE OVER TIME: serie casi plana con puntos. */
const rCoh = rng(0x24b);
const cohVals = Array.from({ length: 13 }, (_, i) => 0.52 + Math.sin(i * 0.9) * 0.06 + (rCoh() - 0.5) * 0.08);
const cohPts = cohVals.map((v, i) => [8 + (i / 12) * 202, 46 - v * 40] as const);

/* ROUTE VECTORS: órbitas elípticas cruzadas con nodos. */
const rOrb = rng(0x24c);
const orbNodos = Array.from({ length: 14 }, () => ({
  a: rOrb() * Math.PI * 2,
  e: 0.5 + rOrb() * 0.5,
  rot: (rOrb() - 0.5) * 1.2,
  c: rOrb() < 0.4 ? "#a184e8" : "#8fb8f2",
}));

/* VECTOR DISTRIBUTION: dona en segmentos azul→violeta. */
const donaSeg = [
  { v: 6.7, c: "#5a72d8" },
  { v: 26.7, c: "#5f8ae6" },
  { v: 32.1, c: "#7a74e0" },
  { v: 34.5, c: "#9a6fe0" },
];
const donaR = 34;
const donaCirc = 2 * Math.PI * donaR;
let donaOff = 0;
const donaArcos = donaSeg.map((s) => {
  const len = (s.v / 100) * donaCirc;
  const arco = { c: s.c, dash: `${(len - 3).toFixed(1)} ${(donaCirc - len + 3).toFixed(1)}`, off: -donaOff };
  donaOff += len;
  return arco;
});

/* COSMOGRAPHIC ALIGNMENT: telaraña radial con motas. */
const rCos = rng(0x24d);
const cosMotas = Array.from({ length: 46 }, () => {
  const a = rCos() * Math.PI * 2;
  const r = 12 + rCos() * 58;
  return { x: 100 + r * Math.cos(a), y: 82 + r * Math.sin(a), s: 0.7 + rCos() * 1.3, v: rCos() < 0.3 };
});

/* ALIGNMENT SPECTRUM / LATTICE SIGNAL: peines densos azul→violeta. */
const peine = (semilla: number, n: number, w: number, h: number) => {
  const r = rng(semilla);
  let env = 0.3;
  return Array.from({ length: n }, (_, i) => {
    env = Math.max(0.08, Math.min(1, env + (r() - 0.5) * 0.5));
    const amp = env * (0.25 + r() * 0.75) * (h / 2 - 2);
    const x = (i / (n - 1)) * w;
    return `M${x.toFixed(1)} ${(h / 2 - amp).toFixed(1)}L${x.toFixed(1)} ${(h / 2 + amp).toFixed(1)}`;
  }).join("");
};
const specD = peine(0x24e, 150, 232, 60);
const sigD = peine(0x24f, 130, 236, 78);
