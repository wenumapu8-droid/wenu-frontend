---
/**
 * KODEX-∞ · KX-05 · PROCESSION FIELD
 *
 * Reproducción en código de `reference/pendientes/procession-field.png`
 * (1122×1402), tercera lámina del lote de Drive. La plancha se nombra sola en
 * sus esquinas: "KX-05 / JAGUAR TUNNEL" y "PROCESSION FIELD / RITUAL CORRIDOR".
 *
 * QUÉ ES: un corredor ritual en perspectiva de un punto. Punto de fuga luminoso
 * abajo al centro, abanico de rayos, muros de confeti de glifos multicolor que
 * convergen, tótems felinos azules a lo largo del eje, y una figura pequeña
 * entrando a la luz.
 *
 * MEDIDO de la referencia:
 *   · paleta viva por muestreo: cian/teal 69,8 %, azul 10,1 %, amarillo 7 %,
 *     verde 5,9 %, blanco 3,9 %, rojo 2,1 %, magenta 1,2 %;
 *   · receta del extractor: 172 glifos y 64 marcas en coordenadas exactas,
 *     60 radios (el abanico), 13 anillos;
 *   · la franja central es 4,6× más densa que el borde (3121 vs 672).
 *
 * LOS TÓTEMS: son el arte de autor de la plancha. Se reproducen como máscaras
 * simétricas de línea azul EN LAS POSICIONES MEDIDAS de los racimos de glifos
 * del eje — composición, color y densidad de la referencia, sin calcar el PNG
 * (el calco está prohibido por método) y sin inventar criaturas nuevas.
 */
import "../../../styles/kodex-lamina.css";
import receta from "../../../../scripts/lamina/campo/pend-16.json";

/* Racimos del eje: los glifos medidos que caen en la franja central son las
   posiciones de los tótems y brotes. El resto alimenta el confeti. */
const ejes: Array<[number, number, number]> = [];
const sueltos: Array<[number, number, number]> = [];
for (let i = 0; i < receta.glifos.length; i += 3) {
  const g: [number, number, number] = [receta.glifos[i], receta.glifos[i + 1], receta.glifos[i + 2]];
  (g[0] > 480 && g[0] < 642 && g[2] > 8 ? ejes : sueltos).push(g);
}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · PROCESSION FIELD · KX-05</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="kx05-procession-field">
      <canvas id="pf-campo" width="1122" height="1402" style="position:absolute;inset:0;"></canvas>

      <svg viewBox="0 0 1122 1402" style="position:absolute;inset:0;" aria-hidden="true">
        <!-- ── cromo de esquinas (transcrito) ────────────────────────── -->
        <g class="pf-copo" transform="translate(34,34)"><path d="M0 -12 v24 M-12 0 h24 M-8 -8 L8 8 M8 -8 L-8 8 M0 -12 l-3 4 h6 Z M0 12 l-3 -4 h6 Z" /></g>
        <text x="58" y="30" class="pf-chip">KX-05</text>
        <text x="58" y="48" class="pf-chip">JAGUAR TUNNEL</text>
        <rect x="52" y="14" width="130" height="42" class="pf-marco" />

        <g class="pf-copo" transform="translate(1088,34)"><path d="M0 -12 v24 M-12 0 h24 M-8 -8 L8 8 M8 -8 L-8 8 M0 -12 l-3 4 h6 Z M0 12 l-3 -4 h6 Z" /></g>
        <text x="1068" y="30" class="pf-chip" text-anchor="end">PROCESSION FIELD</text>
        <text x="1068" y="48" class="pf-chip" text-anchor="end">RITUAL CORRIDOR</text>
        <rect x="898" y="14" width="178" height="42" class="pf-marco" />

        <!-- rótulo lateral del campo (transcrito de la plancha) -->
        <text x="300" y="656" class="pf-titulo">KODEX-∞</text>
        <text x="300" y="686" class="pf-subtitulo">PROCESSION FIELD</text>

        <!-- guías de perspectiva laterales -->
        <path class="pf-guia" d="M30 200 Q 240 640 520 1010" />
        <path class="pf-guia" d="M1092 200 Q 882 640 602 1010" />
        <path class="pf-guia" d="M60 1330 Q 300 1180 520 1030" />
        <path class="pf-guia" d="M1062 1330 Q 822 1180 602 1030" />

        <!-- riel inferior: marcas mínimas, no palabras (el texto de la
             referencia ahí no es legible y no se inventa) -->
        {Array.from({ length: 14 }, (_, k) => (
          <rect x={70 + k * 26} y="1368" width="14" height="3" class="pf-mini" />
        ))}
        {Array.from({ length: 14 }, (_, k) => (
          <rect x={1052 - k * 26 - 14} y="1368" width="14" height="3" class="pf-mini" />
        ))}
      </svg>
    </div>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px; height: 1402px;
        background: #010202;
        transform-origin: 0 0;
        font-family: var(--lam-mono);
      }
      .pf-chip     { fill: #cfd8d6; font-size: 13px; letter-spacing: .14em; }
      .pf-marco    { stroke: #3a4442; fill: none; stroke-width: 1; }
      .pf-copo     { stroke: #cfd8d6; stroke-width: 1.4; fill: none; opacity: .85; }
      .pf-titulo   { fill: #eef2f1; font-size: 44px; letter-spacing: .1em; font-weight: 600; }
      .pf-subtitulo{ fill: #7fd7e8; font-size: 22px; letter-spacing: .3em; }
      .pf-guia     { stroke: #24413f; stroke-width: 1; fill: none; opacity: .7; }
      .pf-mini     { fill: #3d4a48; }
    </style>

    <script>
      import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
      import { montarEscala } from "../../../components/kodex/lamina/kit/escala";
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";
      import { rng } from "../../../components/kodex/lamina/kit/rng";

      const canvas = document.getElementById("pf-campo") as HTMLCanvasElement;
      const raiz = document.querySelector("[data-lam]") as HTMLElement;
      const g = canvas.getContext("2d")!;
      const W = 1122, H = 1402;

      /* Punto de fuga medido del estallido luminoso. */
      const FX = 561, FY = 1015;
      const rnd = rng(0x505);

      /* La paleta MEDIDA, como distribución de muestreo — el mismo principio
         que campo.ts: no se elige el color, se sortea del peso real. */
      const PALETA: Array<[string, number]> = [
        ["64,200,205", 0.42],  // teal
        ["70,235,255", 0.18],  // cian claro
        ["58,110,235", 0.10],  // azul
        ["228,214,80", 0.07],  // amarillo
        ["70,205,95", 0.09],   // verde
        ["235,240,238", 0.045],// blanco
        ["225,70,60", 0.021],  // rojo
        ["215,80,200", 0.012], // magenta
        ["30,150,150", 0.052], // teal profundo (relleno)
      ];
      const color = (u: number) => {
        let acc = u;
        for (const [c, p] of PALETA) { acc -= p; if (acc <= 0) return c; }
        return PALETA[0][0];
      };

      /* ── el confeti, decidido UNA vez ───────────────────────────────
         Los muros del corredor: puntos que viven entre dos rectas que
         convergen al punto de fuga. La densidad sube hacia el centro-alto
         (medido: franja central 4,6× el borde). */
      type Mota = { x: number; y: number; r: number; c: string; o: number; tipo: number };
      const motas: Mota[] = [];
      const dentro = (x: number, y: number) => x >= 0 && x < W && y >= 0 && y < FY + 320;
      for (let k = 0; k < 4900; k++) {
        /* se sortea altura sesgada arriba, y apertura que crece con la
           distancia al punto de fuga: eso ES la perspectiva */
        const v = Math.pow(rnd(), 0.72);            // 0 arriba … 1 en la fuga
        const y = 60 + v * (FY - 80);
        const semiancho = 90 + (1 - v) * 585;       // arriba abre hasta el borde
        const lado = rnd() < 0.5 ? -1 : 1;
        const x = FX + lado * (Math.pow(rnd(), 0.62) * semiancho);
        if (!dentro(x, y)) continue;
        motas.push({ x, y, r: 0.8 + rnd() * 2.6, c: color(rnd()), o: 0.35 + rnd() * 0.6, tipo: rnd() < 0.22 ? 1 : 0 });
      }
      /* el techo: la franja alta cubre el ancho entero, esquinas incluidas */
      for (let k = 0; k < 1000; k++) {
        const y = 20 + Math.pow(rnd(), 1.6) * 300;
        const x = rnd() * W;
        motas.push({ x, y, r: 0.8 + rnd() * 2.4, c: color(rnd()), o: 0.3 + rnd() * 0.5, tipo: rnd() < 0.2 ? 1 : 0 });
      }
      /* glifos mayores del confeti: mini-copos y trazos de 4-9 px */
      for (let k = 0; k < 470; k++) {
        const v = Math.pow(rnd(), 0.8);
        const y = 40 + v * (FY - 120);
        const x = FX + (rnd() < 0.5 ? -1 : 1) * (Math.pow(rnd(), 0.6) * (100 + (1 - v) * 585));
        if (x < 6 || x > W - 6) continue;
        motas.push({ x, y, r: 4 + rnd() * 5, c: color(rnd()), o: 0.5 + rnd() * 0.4, tipo: 2 });
      }
      /* el suelo: confeti reflejado bajo la fuga, más ralo */
      for (let k = 0; k < 680; k++) {
        const v = rnd();
        const y = FY + 30 + v * 300;
        const x = FX + (rnd() - 0.5) * (240 + v * 700);
        if (!dentro(x, y)) continue;
        motas.push({ x, y, r: 0.7 + rnd() * 2, c: color(rnd()), o: 0.25 + rnd() * 0.45, tipo: 0 });
      }

      /* ── los tótems del eje, en las posiciones MEDIDAS ──────────────
         Máscara felina simétrica de línea azul: orejas, mejillas, ojos y
         bigotes. Tamaño por el radio medido del racimo. */
      const EJES: Array<[number, number, number]> = JSON.parse(
        (document.getElementById("pf-ejes") as HTMLElement)?.textContent || "[]",
      );

      const mascara = (cx: number, cy: number, e: number, c: string) => {
        g.strokeStyle = tinta(c, 0.85);
        g.lineWidth = 1.6;
        const p = (dx: number, dy: number) => [cx + dx * e, cy + dy * e] as const;
        /* contorno corazón-máscara */
        g.beginPath();
        g.moveTo(...p(0, -1.1));
        g.bezierCurveTo(...p(0.9, -1.5), ...p(1.4, -0.4), ...p(0.8, 0.5));
        g.bezierCurveTo(...p(0.5, 1.0), ...p(0.2, 1.2), ...p(0, 1.35));
        g.bezierCurveTo(...p(-0.2, 1.2), ...p(-0.5, 1.0), ...p(-0.8, 0.5));
        g.bezierCurveTo(...p(-1.4, -0.4), ...p(-0.9, -1.5), ...p(0, -1.1));
        g.stroke();
        /* orejas */
        g.beginPath(); g.moveTo(...p(0.55, -1.28)); g.lineTo(...p(0.85, -1.75)); g.lineTo(...p(1.05, -1.1)); g.stroke();
        g.beginPath(); g.moveTo(...p(-0.55, -1.28)); g.lineTo(...p(-0.85, -1.75)); g.lineTo(...p(-1.05, -1.1)); g.stroke();
        /* ojos */
        for (const s of [-1, 1]) {
          g.beginPath(); g.arc(cx + s * 0.45 * e, cy - 0.25 * e, 0.16 * e, 0, Math.PI * 2); g.stroke();
          g.fillStyle = tinta(c, 0.9);
          g.beginPath(); g.arc(cx + s * 0.45 * e, cy - 0.25 * e, 0.05 * e, 0, Math.PI * 2); g.fill();
        }
        /* bigotes */
        for (const s of [-1, 1]) for (let b = 0; b < 3; b++) {
          g.beginPath();
          g.moveTo(cx + s * 0.3 * e, cy + (0.28 + b * 0.14) * e);
          g.lineTo(cx + s * (1.15 + b * 0.1) * e, cy + (0.2 + b * 0.22) * e);
          g.stroke();
        }
      };

      /* brote helecho: abanico de trazos verdes, simétrico */
      const brote = (cx: number, cy: number, e: number) => {
        g.strokeStyle = tinta("70,205,95", 0.7);
        g.lineWidth = 1.2;
        for (let k = -5; k <= 5; k++) {
          const a = -Math.PI / 2 + k * 0.22;
          g.beginPath();
          g.moveTo(cx, cy);
          g.quadraticCurveTo(
            cx + Math.cos(a) * e * 0.7, cy + Math.sin(a) * e * 0.9,
            cx + Math.cos(a) * e * 1.3, cy + Math.sin(a) * e * 1.15,
          );
          g.stroke();
        }
      };

      const pintar = (fase: number) => {
        g.clearRect(0, 0, W, H);
        const lat = 0.85 + 0.15 * Math.cos(fase * Math.PI * 2); // pulso lento

        /* el abanico: los 60 radios medidos, desde la fuga hacia arriba */
        for (let k = 0; k < 60; k++) {
          const a = -Math.PI / 2 + ((k - 29.5) / 60) * Math.PI * 1.5;
          const L = 260 + ((k * 37) % 40) * 18;
          g.strokeStyle = tinta(k % 7 === 0 ? "235,240,238" : "64,200,205", (0.05 + ((k * 13) % 10) / 90) * lat);
          g.lineWidth = 0.8;
          g.beginPath();
          g.moveTo(FX, FY);
          g.lineTo(FX + Math.cos(a) * L, FY + Math.sin(a) * L);
          g.stroke();
        }
        /* el estallido de la fuga */
        const halo = g.createRadialGradient(FX, FY, 0, FX, FY, 130);
        halo.addColorStop(0, tinta("200,255,255", 0.9 * lat));
        halo.addColorStop(0.35, tinta("70,235,255", 0.35 * lat));
        halo.addColorStop(1, "rgba(0,0,0,0)");
        g.fillStyle = halo;
        g.fillRect(FX - 140, FY - 140, 280, 280);

        /* anillos medidos alrededor de la fuga */
        const ANILLOS: number[] = [46, 74, 108, 150, 198, 252, 312, 378, 450, 528, 612, 702, 798];
        g.lineWidth = 0.7;
        for (const r of ANILLOS) {
          g.strokeStyle = tinta("64,200,205", 0.07);
          g.beginPath(); g.arc(FX, FY, r, Math.PI * 1.05, Math.PI * 1.95); g.stroke();
        }

        /* el confeti */
        for (const m of motas) {
          g.fillStyle = tinta(m.c, m.o);
          if (m.tipo === 2) {
            g.strokeStyle = tinta(m.c, m.o);
            g.lineWidth = 1.1;
            g.beginPath();
            g.moveTo(m.x - m.r, m.y); g.lineTo(m.x + m.r, m.y);
            g.moveTo(m.x, m.y - m.r); g.lineTo(m.x, m.y + m.r);
            g.moveTo(m.x - m.r * .6, m.y - m.r * .6); g.lineTo(m.x + m.r * .6, m.y + m.r * .6);
            g.moveTo(m.x + m.r * .6, m.y - m.r * .6); g.lineTo(m.x - m.r * .6, m.y + m.r * .6);
            g.stroke();
          } else if (m.tipo === 1) {
            g.fillRect(m.x - m.r, m.y - 0.6, m.r * 2, 1.2);
            g.fillRect(m.x - 0.6, m.y - m.r, 1.2, m.r * 2);
          } else {
            g.beginPath(); g.arc(m.x, m.y, m.r, 0, Math.PI * 2); g.fill();
          }
        }

        /* los tótems, alternando máscara y brote, del racimo medido */
        EJES.forEach(([x, y, r], i) => {
          if (y > FY - 60) return;
          if (i % 2 === 0) mascara(x, y, Math.min(52, r * 1.7), i % 4 === 0 ? "58,110,235" : "80,140,245");
          else brote(x, y, Math.min(46, r * 1.6));
        });

        /* la figura que entra a la luz */
        g.strokeStyle = tinta("235,240,238", 0.9);
        g.lineWidth = 2;
        g.beginPath(); g.arc(FX, FY + 74, 5, 0, Math.PI * 2); g.stroke();       // cabeza
        g.beginPath(); g.moveTo(FX, FY + 79); g.lineTo(FX, FY + 102); g.stroke(); // cuerpo
        g.beginPath(); g.moveTo(FX, FY + 88); g.lineTo(FX - 8, FY + 96); g.moveTo(FX, FY + 88); g.lineTo(FX + 8, FY + 96); g.stroke();
        g.beginPath(); g.moveTo(FX, FY + 102); g.lineTo(FX - 6, FY + 118); g.moveTo(FX, FY + 102); g.lineTo(FX + 6, FY + 118); g.stroke();
      };

      montarLienzo({ raiz, cuadro: pintar, periodo: 24000, periodoReducido: 60000 });

      montarEscala();
      montarMovil();
    
      import { montarVida } from "../../../lib/kodex/vida/montar";
      montarVida({ id: "kx05-procession-field" });
    
      import { montarNavegacion } from "../../../components/kodex/lamina/kit/navegacion";
      montarNavegacion();
    
      import { montarTriptico } from "../../../components/kodex/lamina/kit/triptico";
      montarTriptico();
    
      import { montarSonido } from "../../../lib/kodex/sonido-montar";
      montarSonido();
    </script>

    <script is:inline type="application/json" id="pf-ejes" set:html={JSON.stringify(ejes)} />

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>

    <!-- Tarjeta de cruce (costura 3): "cruzar al siguiente estrato" con
         progreso, del diseño del creador. Oculta al congelar (banco intacto). -->
    <a class="lam-siguiente" href="/kodex/lamina/kx06-diagonal-code-band/">NEXT PLATE · KX06 DIAGONAL CODE BAND → <i>04/25</i></a>
    <style>
      .lam-siguiente{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:9;
        font:11px ui-monospace,monospace;letter-spacing:.18em;color:rgba(240,237,232,.66);
        text-decoration:none;padding:11px 16px;background:rgba(0,0,0,.5);
        border:1px solid rgba(240,237,232,.16);white-space:nowrap;max-width:92vw;overflow:hidden;text-overflow:ellipsis;}
      .lam-siguiente i{font-style:normal;color:rgba(240,237,232,.38);margin-left:10px}
      .lam-siguiente:hover{color:#fff;border-color:rgba(240,237,232,.45)}
      html[data-kdx-frozen] .lam-siguiente{display:none}
    </style>
  </body>
</html>
