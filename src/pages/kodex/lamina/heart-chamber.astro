    <title>KODEX−∞ · HEART CHAMBER · Cámara del Corazón</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="heart-chamber" style="width:1536px;height:1024px;">
      <canvas id="hc-campo" width="1536" height="1024" style="position:absolute;inset:0;"></canvas>

      <svg viewBox="0 0 1536 1024" style="position:absolute;inset:0;" aria-hidden="true">
        <!-- ── cabecera central (transcrita) ─────────────────────────── -->
        <text x="700" y="46" class="h-titulo" text-anchor="middle">KODEX−∞</text>
        <path class="h-filete" d="M560 60 h280" />
        <text x="700" y="94" class="h-tituloG" text-anchor="middle">HEART CHAMBER</text>
