---
/**
 * KODEX-∞ · HEART CHAMBER · CÁMARA DEL CORAZÓN
 *
 * Reproducción en código de `reference/pendientes/pend-19.png` (1536×1024,
 * apaisada), séptima lámina del lote de Drive. La plancha se nombra sola.
 *
 * QUÉ ES: el panel HUD de la Cámara del Corazón — el corazón-constelación al
 * centro con su cruz de registro, signos vitales a la izquierda (PULSE 72 BPM,
 * HRV 63 ms, BREATH COHERENCE 5.4/min), coherencia y funciones a la derecha,
 * la navegación de nodos del KODEX, la tira de escenas abajo y la sentencia
 * WHAT YOU FEEL, YOU REMEMBER. / WHAT YOU REMEMBER, YOU BECOME.
 *
 * DOS NOTAS DE CANON:
 * 1. La navegación de esta plancha lista el corredor REAL (THRESHOLD, PROLOGUE,
 *    DESCENT, ARCHIVE, MACHINE, COSMOLOGY, RETURN) con HEART CHAMBER insertada
 *    — es evidencia de autor para promover la escena HEART al corredor. Queda
 *    registrado; la promoción la decide el creador.
 * 2. Los "signos vitales" son ARTE: números fijos transcritos de la plancha.
 *    Nada se mide de nadie — la regla de privacidad de la biblia (sin
 *    biometría) aplica a las escenas vivas, y esta página es una lámina.
 *
 * TODO el texto transcrito con zoom. Los diagramas (ECG, HRV, respiración,
 * coherencia, sello geométrico, miniaturas de nodos) son procedurales
 * deterministas — nada calcado.
 */
import "../../../styles/kodex-lamina.css";

const funciones = ["INTEGRATE", "HEAL", "AMPLIFY", "TRANSMUTE", "REMEMBER", "TRANSCEND"];
const metricas = [
  { t: "EMOTIONAL INTENSITY", v: "78%" },
  { t: "MEMORY DENSITY", v: "0.87" },
  { t: "ENERGETIC FLOW", v: "HIGH" },
  { t: "INTEGRATION DEPTH", v: "91.2%" },
];
const nav = [
  { n: "00", t: "THRESHOLD", s: "THE GATE", act: false },
  { n: "05", t: "HEART CHAMBER", s: "CÁMARA DEL CORAZÓN", act: true },
  { n: "01", t: "PROLOGUE", s: "THE SIGNAL", act: false },
  { n: "02", t: "DESCENT", s: "INTO THE FIELD", act: false },
  { n: "03", t: "ARCHIVE", s: "LIVING MEMORY", act: false },
  { n: "04", t: "MACHINE", s: "THE CONSTRUCT", act: false },
  { n: "05", t: "COSMOLOGY", s: "THE MAP", act: false },
  { n: "06", t: "RETURN", s: "THE CYCLE", act: false },
];
const tira = [
  { n: "00", t: "THRESHOLD", s: "THE GATE", tipo: 0 },
  { n: "01", t: "PROLOGUE", s: "THE SIGNAL", tipo: 1 },
  { n: "02", t: "DESCENT", s: "INTO THE FIELD", tipo: 2 },
  { n: "03", t: "ARCHIVE", s: "LIVING MEMORY", tipo: 3 },
  { n: "04", t: "MACHINE", s: "THE CONSTRUCT", tipo: 4 },
  { n: "05", t: "HEART CHAMBER", s: "CÁMARA DEL CORAZÓN", tipo: 5 },
  { n: "06", t: "RETURN", s: "THE CYCLE", tipo: 6 },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
