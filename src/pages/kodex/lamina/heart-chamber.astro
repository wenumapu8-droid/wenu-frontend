        <rect x="1000" y="318" width="240" height="140" class="h-caja" />
        <text x="1020" y="344" class="h-panelt">◇ FUNCTIONS</text>
        {funciones.map((f, i) => (
          <g>
            <text x="1020" y={368 + i * 15} class="h-func">{f}</text>
            <circle cx="1218" cy={363 + i * 15} r="4.5" class="h-toggle" />
          </g>
        ))}

        <rect x="1000" y="474" width="240" height="86" class="h-caja" />
        <text x="1020" y="500" class="h-panelt">+ SIGNAL QUALITY</text>
        <text x="1020" y="530" class="h-dato">A++</text>
        <text x="1020" y="552" class="h-micro">NOISE ± 2 %</text>

        <rect x="1000" y="576" width="240" height="170" class="h-caja" />
        <text x="1020" y="602" class="h-panelt">◇ GEOMETRY LOCK</text>
        <text x="1120" y="716" class="h-micro" text-anchor="middle">LOCKED</text>
        <text x="1120" y="736" class="h-micro" text-anchor="middle">△  7/7  △</text>

        <!-- ── navegación (transcrita) ───────────────────────────────── -->
        <rect x="1268" y="20" width="248" height="726" class="h-caja" />
        <text x="1288" y="46" class="h-panelt">KODEX NAVIGATION</text>
        <text x="1498" y="46" class="h-panelt" text-anchor="end">✕</text>
        {nav.map((e, i) => (
          <g>
            {e.act && <rect x="1278" y={64 + i * 74} width="228" height="66" class="h-activa" />}
            <circle cx="1306" cy={96 + i * 74} r="16" class="h-navglifo" />
            <text x="1334" y={86 + i * 74} class="h-navnum">{e.n}</text>
            <text x="1334" y={104 + i * 74} class={e.act ? "h-navtit h-on" : "h-navtit"}>{e.t}</text>
            <text x="1334" y={120 + i * 74} class="h-navsub">{e.s}</text>
          </g>
        ))}
        <rect x="1288" y="656" width="208" height="34" class="h-caja" />
        <text x="1392" y="678" class="h-micro" text-anchor="middle">⊞ SYSTEM LOG</text>
        <rect x="1288" y="700" width="208" height="34" class="h-caja" />
        <text x="1392" y="722" class="h-micro" text-anchor="middle">⚙ SETTINGS</text>

        <!-- ── métricas centrales y sentencia (transcritas) ──────────── -->
        {metricas.map((m, i) => (
          <g transform={`translate(${432 + i * 143},598)`}>
            <rect x="0" y="0" width="133" height="52" class="h-caja" />
            <text x="66" y="20" class="h-mmt" text-anchor="middle">{m.t}</text>
            <text x="66" y="42" class="h-mmv" text-anchor="middle">{m.v}</text>
          </g>
        ))}
        <rect x="424" y="662" width="580" height="74" class="h-cajaS" />
        <text x="714" y="694" class="h-sentencia" text-anchor="middle">WHAT YOU FEEL, YOU REMEMBER.</text>
        <text x="714" y="720" class="h-sentencia" text-anchor="middle">WHAT YOU REMEMBER, YOU BECOME.</text>

        <!-- ── tira de escenas (transcrita) ──────────────────────────── -->
        <text x="38" y="776" class="h-panelt">KODEX - SCENES</text>
        {tira.map((e, i) => (
          <g transform={`translate(${38 + i * 212},790)`}>
            <rect x="0" y="0" width="198" height="170" class={e.tipo === 5 ? "h-cajaAct" : "h-caja"} />
            <text x="14" y="140" class="h-navnum">{e.n}</text>
            <text x="14" y="156" class={e.tipo === 5 ? "h-navtit h-on" : "h-navtit"}>{e.t}</text>
            <text x="14" y="168" class="h-navsub">{e.s}</text>
          </g>
        ))}

        <!-- ── pie (transcrito) ──────────────────────────────────────── -->
        <text x="38" y="1000" class="h-chip">KODEX-∞</text>
        <text x="768" y="1000" class="h-micro" text-anchor="middle">LISTEN. FEEL. INTEGRATE. BECOME.</text>
        <text x="1498" y="1000" class="h-micro" text-anchor="end">© KODEX-∞ ARCHIVE SYSTEMS · VERSION 0.5.0</text>
      </svg>
    </div>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam { position: relative; background: #0a0705; transform-origin: 0 0; font-family: var(--lam-mono); }
      .h-titulo  { fill: #e8c9a8; font-size: 22px; letter-spacing: .34em; }
      .h-tituloG { fill: #eda75c; font-family: Georgia, serif; font-size: 40px; letter-spacing: .22em; }
      .h-subes   { fill: #a97843; font-size: 13px; letter-spacing: .3em; }
      .h-chip    { fill: #d9a86a; font-size: 15px; letter-spacing: .22em; }
      .h-micro   { fill: #9c7040; font-size: 11.5px; letter-spacing: .14em; }
      .h-panelt  { fill: #d9a86a; font-size: 13px; letter-spacing: .18em; }
      .h-verdad  { fill: #e0b98a; font-size: 17px; letter-spacing: .2em; }
      .h-dato    { fill: #f0c890; font-size: 30px; letter-spacing: .06em; }
      .h-datoG   { fill: #f0c890; font-size: 34px; letter-spacing: .04em; }
      .h-esc     { fill: #7a5730; font-size: 10.5px; letter-spacing: .1em; }
      .h-nota    { fill: #9c7040; font-size: 11px; letter-spacing: .1em; }
      .h-func    { fill: #cf9c60; font-size: 12.5px; letter-spacing: .18em; }
      .h-toggle  { stroke: #d14; fill: none; stroke-width: 1.4; }
      .h-caja    { stroke: #6a4a26; fill: rgba(14,9,5,.5); stroke-width: 1; }
      .h-cajaS   { stroke: #8a6234; fill: rgba(16,10,5,.6); stroke-width: 1.2; }
      .h-cajaAct { stroke: #eda75c; fill: rgba(40,22,8,.5); stroke-width: 1.6; }
      .h-activa  { stroke: #eda75c; fill: rgba(50,28,10,.55); stroke-width: 1.4; }
      .h-navglifo{ stroke: #8a6234; fill: none; stroke-width: 1; }
      .h-navnum  { fill: #9c7040; font-size: 11px; letter-spacing: .18em; }
      .h-navtit  { fill: #cf9c60; font-size: 14px; letter-spacing: .12em; }
      .h-on      { fill: #f5c98d; }
      .h-navsub  { fill: #8a6234; font-size: 10px; letter-spacing: .12em; }
      .h-mmt     { fill: #9c7040; font-size: 10px; letter-spacing: .1em; }
      .h-mmv     { fill: #f0c890; font-size: 18px; letter-spacing: .06em; }
      .h-sentencia{ fill: #eebc84; font-family: Georgia, serif; font-size: 21px; letter-spacing: .28em; }
      .h-filete  { stroke: #8a6234; stroke-width: 1; }
    </style>

    <script>
      import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
      import { montarEscala } from "../../../components/kodex/lamina/kit/escala";
      import { rng } from "../../../components/kodex/lamina/kit/rng";

      const canvas = document.getElementById("hc-campo") as HTMLCanvasElement;
      const raiz = document.querySelector("[data-lam]") as HTMLElement;
      const g = canvas.getContext("2d")!;
      const rnd = rng(0x4ea7);

      /* ── el corazón-constelación ────────────────────────────────────
         Silueta paramétrica clásica del corazón, muestreada como nodos con
         relleno interior por rechazo; aristas entre vecinos = constelación. */
      const CX = 700, CY = 400, E = 11.5;
      const borde: Array<[number, number]> = [];
      for (let t = 0; t < Math.PI * 2; t += 0.03) {
        const x = 16 * Math.pow(Math.sin(t), 3);
        const y = -(13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));
        borde.push([CX + x * E, CY + y * E]);
      }
      /* nodos: borde denso + interior ralo */
      const nodos: Array<[number, number, number]> = [];
      for (const [x, y] of borde) if (rnd() < 0.55) nodos.push([x + (rnd() - 0.5) * 8, y + (rnd() - 0.5) * 8, 1 + rnd() * 1.8]);
      for (let k = 0; k < 760; k++) {
        const t = rnd() * Math.PI * 2, u = Math.sqrt(rnd());
        const x = 16 * Math.pow(Math.sin(t), 3) * u;
        const y = -(13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t)) * u;
        nodos.push([CX + x * E, CY + y * E, 0.7 + rnd() * 1.6]);
      }
      /* aristas entre vecinos cercanos */
      const aristas: Array<[number, number]> = [];
      for (let i = 0; i < nodos.length; i++)
        for (let j = i + 1; j < nodos.length; j++) {
          const dx = nodos[i][0] - nodos[j][0], dy = nodos[i][1] - nodos[j][1];
          if (dx * dx + dy * dy < 1100 && rnd() < 0.42) aristas.push([i, j]);
        }

      /* polvo ambiente, fijo: denso alrededor del corazón, presente en toda
         la plancha y dentro de las tarjetas de la tira */
      const polvo: Array<{ x: number; y: number; r: number; o: number }> = [];
      for (let k = 0; k < 2400; k++) {
        const cerca = rnd() < 0.55;
        const x = cerca ? CX + (rnd() - 0.5) * 560 : rnd() * 1536;
        const y = cerca ? CY + (rnd() - 0.5) * 460 : rnd() * 1024;
        polvo.push({ x, y, r: 0.4 + rnd() * 1.3, o: 0.08 + rnd() * 0.3 });
      }
      for (let i = 0; i < 7; i++)
        for (let k = 0; k < 90; k++)
          polvo.push({ x: 38 + i * 212 + 10 + rnd() * 178, y: 800 + rnd() * 120, r: 0.4 + rnd() * 1.2, o: 0.1 + rnd() * 0.35 });

      /* ondas del riel: ECG, HRV, respiración — deterministas */
      const ecg: Array<[number, number]> = [];
      for (let x = 0; x < 300; x++) {
        const f = x % 60;
        let y = (rnd() - 0.5) * 2;
        if (f === 28) y = -26; else if (f === 30) y = 34; else if (f === 32) y = -10;
        else if (f === 44) y = -7;
        ecg.push([58 + x, 440 + y * 0.8]);
      }
      const hrv: number[] = Array.from({ length: 120 }, () => 2 + rnd() * 16);

      const pintar = (fase: number) => {
        g.clearRect(0, 0, 1536, 1024);
        const lat = 1 + 0.05 * Math.sin(fase * Math.PI * 2 * 3); // triple latido por ciclo

        /* la cruz de registro y los anillos del centro */
        g.strokeStyle = tinta("176,110,56", 0.28);
        g.lineWidth = 0.8;
        g.beginPath(); g.moveTo(420, CY); g.lineTo(985, CY); g.stroke();
        g.beginPath(); g.moveTo(CX, 130); g.lineTo(CX, 585); g.stroke();
        for (const r of [120, 175, 228]) {
          g.beginPath(); g.arc(CX, CY, r, 0, Math.PI * 2); g.stroke();
        }
        for (let k = 0; k < 36; k++) {
          const a = (k / 36) * Math.PI * 2;
          g.beginPath();
          g.moveTo(CX + Math.cos(a) * 224, CY + Math.sin(a) * 224);
          g.lineTo(CX + Math.cos(a) * (k % 3 ? 228 : 236), CY + Math.sin(a) * (k % 3 ? 228 : 236));
          g.stroke();
        }

        /* polvo ambiente cálido */
        for (const p of polvo) {
          g.fillStyle = tinta("208,126,62", p.o);
          g.beginPath(); g.arc(p.x, p.y, p.r, 0, Math.PI * 2); g.fill();
        }

        /* aristas y nodos del corazón, latiendo */
        g.save();
        g.translate(CX, CY); g.scale(lat, lat); g.translate(-CX, -CY);
        g.strokeStyle = tinta("226,110,60", 0.42);
        g.lineWidth = 0.8;
        for (const [i, j] of aristas) {
          g.beginPath();
          g.moveTo(nodos[i][0], nodos[i][1]);
          g.lineTo(nodos[j][0], nodos[j][1]);
          g.stroke();
        }
        for (const [x, y, r] of nodos) {
          g.fillStyle = tinta(r > 2 ? "250,170,110" : "230,120,64", 0.5 + r * 0.16);
          g.beginPath(); g.arc(x, y, r, 0, Math.PI * 2); g.fill();
        }
        /* el núcleo */
        const halo = g.createRadialGradient(CX, CY - 10, 0, CX, CY - 10, 90);
        halo.addColorStop(0, tinta("255,150,80", 0.5));
        halo.addColorStop(1, "rgba(0,0,0,0)");
        g.fillStyle = halo;
        g.fillRect(CX - 95, CY - 105, 190, 190);
        g.restore();

        /* ── ondas de los paneles ─────────────────────────────────── */
        g.strokeStyle = tinta("237,167,92", 0.85);
        g.lineWidth = 1.2;
        g.beginPath();
        ecg.forEach(([x, y], i) => (i ? g.lineTo(x, y) : g.moveTo(x, y)));
        g.stroke();

        for (let i = 0; i < hrv.length; i++) {
          g.strokeStyle = tinta("237,167,92", 0.6);
          g.beginPath();
          g.moveTo(60 + i * 2.4, 566);
          g.lineTo(60 + i * 2.4, 566 - hrv[i]);
          g.stroke();
        }

        g.strokeStyle = tinta("237,167,92", 0.75);
        g.lineWidth = 1.3;
        g.beginPath();
        for (let x = 0; x <= 290; x += 2) {
          const y = 676 + Math.sin((x / 290) * Math.PI * 4 + fase * Math.PI * 2) * 9;
          x ? g.lineTo(58 + x, y) : g.moveTo(58 + x, y);
        }
        g.stroke();

        /* ── diagramas del panel derecho ──────────────────────────── */
        /* coherencia: estallido radial */
        for (let k = 0; k < 24; k++) {
          const a = (k / 24) * Math.PI * 2;
          const L = 18 + ((k * 29) % 5) * 12;
          g.strokeStyle = tinta("237,140,70", 0.55);
          g.lineWidth = 0.8;
          g.beginPath();
          g.moveTo(1120 + Math.cos(a) * 6, 180 + Math.sin(a) * 6);
          g.lineTo(1120 + Math.cos(a) * L, 180 + Math.sin(a) * L);
          g.stroke();
        }
        /* sello: hexagrama en circulo */
        g.strokeStyle = tinta("237,167,92", 0.6);
        g.lineWidth = 1;
        g.beginPath(); g.arc(1120, 656, 42, 0, Math.PI * 2); g.stroke();
        for (const rot of [0, Math.PI]) {
          g.beginPath();
          for (let k = 0; k <= 3; k++) {
            const a = rot + -Math.PI / 2 + (k / 3) * Math.PI * 2;
            const x = 1120 + Math.cos(a) * 38, y = 656 + Math.sin(a) * 38;
            k ? g.lineTo(x, y) : g.moveTo(x, y);
          }
          g.stroke();
        }

        /* ── glifos de navegación y miniaturas de la tira ─────────── */
        const mini = (cx: number, cy: number, tipo: number, esc: number) => {
          g.strokeStyle = tinta("226,130,66", 0.6);
          g.lineWidth = 0.8;
          if (tipo === 0) for (const r of [0.3, 0.6, 1]) { g.beginPath(); g.arc(cx, cy, 30 * esc * r, 0, Math.PI * 2); g.stroke(); }
          else if (tipo === 1) for (let k = 0; k < 7; k++) { g.beginPath(); g.moveTo(cx - 24 * esc + k * 8 * esc, cy - 26 * esc); g.lineTo(cx - 24 * esc + k * 8 * esc, cy + ((k * 17) % 3) * 12 * esc - 4); g.stroke(); }
          else if (tipo === 2) { g.beginPath(); for (let t = 0; t < 5 * Math.PI; t += 0.1) { const r = 2 + t * 2.2 * esc; const x = cx + r * Math.cos(t), y = cy + r * Math.sin(t) * 0.7; t ? g.lineTo(x, y) : g.moveTo(x, y); } g.stroke(); }
          else if (tipo === 3) { g.beginPath(); g.moveTo(cx, cy + 28 * esc); g.lineTo(cx, cy); g.stroke(); for (let k = 0; k < 6; k++) { const a = -Math.PI / 2 + (k - 2.5) * 0.42; g.beginPath(); g.moveTo(cx, cy + 6); g.lineTo(cx + Math.cos(a) * 30 * esc, cy + 6 + Math.sin(a) * 30 * esc); g.stroke(); } }
          else if (tipo === 4) { g.strokeRect(cx - 14 * esc, cy - 22 * esc, 28 * esc, 44 * esc); g.beginPath(); g.arc(cx, cy - 30 * esc, 7 * esc, 0, Math.PI * 2); g.stroke(); }
          else if (tipo === 5) { g.beginPath(); for (let t = 0; t < Math.PI * 2; t += 0.12) { const x = cx + 16 * Math.pow(Math.sin(t), 3) * 1.6 * esc; const y = cy - (13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t)) * 1.6 * esc; t ? g.lineTo(x, y) : g.moveTo(x, y); } g.closePath(); g.stroke(); }
          else { for (const r of [0.4, 0.7, 1]) { g.beginPath(); g.arc(cx, cy, 28 * esc * r, 0.3, Math.PI * 2 - 0.3); g.stroke(); } }
        };
        /* miniaturas de la tira (7 tarjetas) */
        for (let i = 0; i < 7; i++) mini(38 + i * 212 + 99, 790 + 66, i, 1);
        /* glifos chicos de la navegación */
        const tiposNav = [0, 5, 1, 2, 3, 4, 2, 6];
        for (let i = 0; i < 8; i++) mini(1306, 96 + i * 74, tiposNav[i], 0.4);
      };

      montarLienzo({ raiz, cuadro: pintar, periodo: 9000, periodoReducido: 40000 });

      montarEscala();
    </script>

