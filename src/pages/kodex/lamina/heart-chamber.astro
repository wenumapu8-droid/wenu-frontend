        <text x="58" y="744" class="h-panelt">◇ FIELD NOTES</text>
        <text x="58" y="766" class="h-micro">ENTRY : 05-24  ∞</text>
        {["OBSERVATION:", "COHERENT EMOTIONAL", "STATES INCREASE SIGNAL", "INTEGRITY AND MEMORY", "CONSOLIDATION."].map((l, i) => (
          <text x="58" y={786 + i * 15} class="h-nota">{l}</text>
        ))}

        <!-- ── panel derecho (transcrito) ────────────────────────────── -->
        <rect x="1000" y="86" width="240" height="216" class="h-caja" />
        <text x="1020" y="112" class="h-panelt">◇ COHERENCE</text>
        <text x="1120" y="252" class="h-datoG" text-anchor="middle">94.7%</text>
