---
/**
 * KODEX-∞ · UNIVERSE PAGE 10 · THE COMMONS
 *
 * Reproducción en código de `reference/canon/u10-commons.png` (1122×1402).
 *
 * La lámina del campo común: héroe radial procedural (campo estelar con
 * trazas, símbolos y frases manuscritas), paneles laterales WRITE · DRAW ·
 * OBSERVE · FIELD CONDITIONS / CONSENT · SYSTEM NOTICE, PUBLIC TRACE central,
 * y pie compartido de la serie UNIVERSE.
 *
 * FONDO NEGRO PURO, medido.
 */
import "../../../styles/kodex-lamina.css";
import Cabecera from "../../../components/kodex/lamina/u10/Cabecera.astro";
import Heroe from "../../../components/kodex/lamina/u10/Heroe.astro";
import Paneles from "../../../components/kodex/lamina/u10/Paneles.astro";
import Pie from "../../../components/kodex/lamina/u10/Pie.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · THE COMMONS · PAGE 10</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="u10-commons">
      <Cabecera />
      <Heroe />
      <Paneles />
      <Pie />
    </div>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px;
        height: 1402px;
        background: #000;
        color: #d8d4d0;
        overflow: hidden;
        transform-origin: 0 0;
        font-family: "JetBrains Mono", ui-monospace, monospace;
      }
      .lam [data-bloque] { position: absolute; }
    </style>

    <script>
      const lam = document.querySelector(".lam");
      const ajustar = () => {
        const k = Math.min(innerWidth / 1122, innerHeight / 1402);
        lam.style.transform = `scale(${k})`;
        document.body.style.height = `${1402 * k}px`;
      };
      ajustar();
      addEventListener("resize", ajustar, { passive: true });
    </script>
  </body>
</html>
