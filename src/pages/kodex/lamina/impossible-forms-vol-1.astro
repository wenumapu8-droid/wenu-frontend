---
/**
 * KODEX-∞ · IMPOSSIBLE FORMS VOL. 1
 *
 * Reproducción en código de `reference/pendientes/pend-24.png` (1024×1536),
 * cuarta lámina del lote de Drive. La plancha se nombra sola: "KODEX-∞ /
 * IMPOSSIBLE FORMS VOL. 1", serie /// 001 VOLUME SERIES, año MMXXIV.
 *
 * QUÉ ES: un tribar de Penrose en oro sobre campo geodésico tenue, con
 * etiquetas de espécimen en las esquinas del campo (FORM-ID 001 · CLASS
 * IMPOSSIBLE · STRUCTURE NON-EUCLIDEAN · STABILITY PARADOX), sol radiante con
 * el sello KX/∞ al pie y la línea KNOWLEDGE · ORDER · DESIGN · EXISTENCE.
 *
 * MEDIDO: oro medio #b07c4e (2.667 muestras), centro del tribar ~(511,713),
 * tinta total de la referencia 71.221 px con lum>40 — es una plancha OSCURA:
 * la masa está en los filos dorados y su brillo, no en rellenos.
 *
 * EL TRIBAR: tres caras trapezoidales entre el triángulo exterior y el hueco
 * interior, cada una con su gradiente propio, y el tejido imposible hecho a
 * mano: en cada esquina la cara anterior se redibuja ENCIMA de la siguiente,
 * en ciclo — que es exactamente lo que hace imposible al objeto.
 */
import "../../../styles/kodex-lamina.css";

const datos = [
  { x: 70, y: 560, up: "FORM-ID", dn: "001", lado: "izq" },
  { x: 954, y: 560, up: "CLASS", dn: "IMPOSSIBLE", lado: "der" },
  { x: 70, y: 1128, up: "STRUCTURE", dn: "NON-EUCLIDEAN", lado: "izq" },
  { x: 954, y: 1128, up: "STABILITY", dn: "PARADOX", lado: "der" },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · IMPOSSIBLE FORMS VOL. 1</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="impossible-forms-vol-1" style="width:1024px;height:1536px;">
      <canvas id="if-campo" width="1024" height="1536" style="position:absolute;inset:0;"></canvas>

      <svg viewBox="0 0 1024 1536" style="position:absolute;inset:0;" aria-hidden="true">
        <!-- ── cabecera (transcrita) ─────────────────────────────────── -->
        <text x="512" y="34" class="if-mini" text-anchor="middle">K O D E X - ∞   U N I V E R S E</text>
        <path class="if-filete" d="M60 30 h330 M634 30 h330" />
        <rect x="26" y="44" width="52" height="52" class="if-caja" />
        <text x="52" y="66" class="if-chip" text-anchor="middle">KX</text>
        <text x="52" y="86" class="if-chip" text-anchor="middle">∞</text>
        <text x="998" y="58" class="if-chip" text-anchor="end">/// 001</text>
        <text x="998" y="76" class="if-micro" text-anchor="end">VOLUME SERIES</text>

        <!-- ── título (transcrito) ───────────────────────────────────── -->
        <text x="512" y="150" class="if-titulo" text-anchor="middle" textLength="760">KODEX-∞</text>
        <path class="if-filete" d="M292 186 h440 M472 197 l40 0" />
        <path class="if-rombo" d="M512 192 l7 5 -7 5 -7 -5 Z" />
        <text x="512" y="248" class="if-subtitulo" text-anchor="middle" textLength="580">IMPOSSIBLE FORMS VOL. 1</text>
        <text x="512" y="286" class="if-puntos" text-anchor="middle">· · · · ·  ∞  · · · · ·</text>

        <!-- ── etiquetas de espécimen (transcritas) ──────────────────── -->
        {datos.map((d) => (
          <g>
            <text x={d.x} y={d.y} class="if-micro" text-anchor={d.lado === "izq" ? "start" : "end"}>{d.up}</text>
            <text x={d.x} y={d.y + 22} class="if-dato" text-anchor={d.lado === "izq" ? "start" : "end"}>{d.dn}</text>
            <path class="if-filete" d={d.lado === "izq" ? `M${d.x} ${d.y + 34} h64` : `M${d.x - 64} ${d.y + 34} h64`} />
          </g>
        ))}

        <!-- ── esquinas inferiores ───────────────────────────────────── -->
        <rect x="26" y="1408" width="56" height="56" class="if-caja" />
        <path class="if-glifo" d="M54 1420 L70 1452 L38 1452 Z" />
        <rect x="942" y="1408" width="56" height="56" class="if-caja" />
        <g class="if-glifo">
          <circle cx="970" cy="1436" r="17" />
          <ellipse cx="970" cy="1436" rx="17" ry="7" />
          <ellipse cx="970" cy="1436" rx="7" ry="17" />
        </g>

        <!-- ── pie (transcrito) ──────────────────────────────────────── -->
        <text x="512" y="1490" class="if-pie" text-anchor="middle">KNOWLEDGE · ORDER · DESIGN · EXISTENCE</text>
        <text x="512" y="1518" class="if-micro" text-anchor="middle">MMXXIV</text>
      </svg>
    </div>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        background: #060504;
        transform-origin: 0 0;
        font-family: var(--lam-mono);
      }
      .if-titulo   { fill: #cf9a5e; font-family: Georgia, "Times New Roman", serif; font-size: 96px; font-weight: 700; letter-spacing: .06em; }
      .if-subtitulo{ fill: #b07c4e; font-family: Georgia, "Times New Roman", serif; font-size: 40px; letter-spacing: .3em; }
      .if-puntos   { fill: #8a6238; font-size: 15px; letter-spacing: .2em; }
      .if-mini     { fill: #8a6238; font-size: 14px; letter-spacing: .5em; }
      .if-micro    { fill: #7d5c38; font-size: 11.5px; letter-spacing: .26em; }
      .if-chip     { fill: #b07c4e; font-size: 17px; letter-spacing: .1em; }
      .if-dato     { fill: #cf9a5e; font-size: 15px; letter-spacing: .18em; font-weight: 600; }
      .if-pie      { fill: #a5754a; font-size: 15.5px; letter-spacing: .3em; }
      .if-caja     { stroke: #6e4f2e; fill: none; stroke-width: 1.1; }
      .if-filete   { stroke: #6e4f2e; fill: none; stroke-width: 1; opacity: .8; }
      .if-rombo    { fill: #b07c4e; }
      .if-glifo    { stroke: #b07c4e; fill: none; stroke-width: 1.3; }
    </style>

    <script>
      import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
      import { montarEscala } from "../../../components/kodex/lamina/kit/escala";
      import { rng } from "../../../components/kodex/lamina/kit/rng";

      const canvas = document.getElementById("if-campo") as HTMLCanvasElement;
      const raiz = document.querySelector("[data-lam]") as HTMLElement;
      const g = canvas.getContext("2d")!;
      const rnd = rng(0x1f24);

      /* Geometría medida del tribar. */
      const CX = 512, CY = 700;
      const R = 315;       // circunradio del triángulo exterior
      const RH = 186;      // circunradio del hueco
      const ang = (k: number) => -Math.PI / 2 + (k * 2 * Math.PI) / 3;
      const V = [0, 1, 2].map((k) => [CX + R * Math.cos(ang(k)), CY + R * Math.sin(ang(k))] as const);
      /* el hueco: mismo rumbo, radio menor — el tribar es un ANILLO triangular */
      const I = [0, 1, 2].map((k) => [CX + RH * Math.cos(ang(k)), CY + RH * Math.sin(ang(k))] as const);

      /* Cara k: banda trapezoidal entre el lado exterior V[k]→V[k+1] y el lado
         interior I[k]→I[k+1]. Tres tonos de oro, como la referencia. */
      const CARAS = [
        { p: [V[0], V[1], I[1], I[0]], oro: "212,158,96" },
        { p: [V[1], V[2], I[2], I[1]], oro: "166,112,62" },
        { p: [V[2], V[0], I[0], I[2]], oro: "128,84,44" },
      ];

      /* chispas de las caras: polvo luminoso dentro de cada banda */
      const chispas = Array.from({ length: 560 }, () => {
        const c = Math.floor(rnd() * 3);
        const [a, b, ci, di] = CARAS[c].p;
        const s = rnd(), t = rnd();
        const ex = a[0] + (b[0] - a[0]) * s, ey = a[1] + (b[1] - a[1]) * s;
        const fx = di[0] + (ci[0] - di[0]) * s, fy = di[1] + (ci[1] - di[1]) * s;
        return { x: ex + (fx - ex) * t, y: ey + (fy - ey) * t, r: 0.4 + rnd() * 1.3, o: 0.15 + rnd() * 0.6 };
      });

      const cara = (k: number, brillo: number) => {
        const { p, oro } = CARAS[k];
        const [a, b, ci, di] = p;
        const mx = (a[0] + b[0]) / 2, my = (a[1] + b[1]) / 2;
        const nx = (ci[0] + di[0]) / 2, ny = (ci[1] + di[1]) / 2;
        const gr = g.createLinearGradient(mx, my, nx, ny);
        gr.addColorStop(0, tinta(oro, 0.78 * brillo));
        gr.addColorStop(1, tinta("46,30,15", 0.95));
        g.fillStyle = gr;
        g.beginPath();
        g.moveTo(a[0], a[1]); g.lineTo(b[0], b[1]); g.lineTo(ci[0], ci[1]); g.lineTo(di[0], di[1]);
        g.closePath();
        g.fill();
        /* bisel: la mitad interior de la banda va mas oscura — es lo que
           convierte la banda plana en BARRA con dos planos */
        const bm = (q: readonly (readonly [number, number])[]) => q.map((pt, i) => {
          const o = p[i < 2 ? i : 5 - i]; // empareja a<->di, b<->ci
          return [(pt[0] + o[0]) / 2, (pt[1] + o[1]) / 2] as const;
        });
        const m1 = [(a[0] + di[0]) / 2, (a[1] + di[1]) / 2];
        const m2 = [(b[0] + ci[0]) / 2, (b[1] + ci[1]) / 2];
        g.fillStyle = tinta("30,19,9", 0.55);
        g.beginPath();
        g.moveTo(m1[0], m1[1]); g.lineTo(m2[0], m2[1]); g.lineTo(ci[0], ci[1]); g.lineTo(di[0], di[1]);
        g.closePath(); g.fill();
        g.strokeStyle = tinta("235,185,120", 0.5 * brillo);
        g.lineWidth = 1;
        g.beginPath(); g.moveTo(m1[0], m1[1]); g.lineTo(m2[0], m2[1]); g.stroke();
        /* filo dorado con resplandor */
        g.save();
        g.shadowColor = "rgba(230,170,100,0.9)";
        g.shadowBlur = 14 * brillo;
        g.strokeStyle = tinta("235,185,120", 0.95 * brillo);
        g.lineWidth = 2.2;
        g.stroke();
        g.restore();
      };

      const pintar = (fase: number) => {
        g.clearRect(0, 0, 1024, 1536);
        const brillo = 0.86 + 0.14 * Math.cos(fase * Math.PI * 2);

        /* ── el campo geodésico tenue ─────────────────────────────── */
        g.strokeStyle = tinta("176,124,78", 0.14);
        g.lineWidth = 0.8;
        for (const r of [356, 300]) { g.beginPath(); g.arc(CX, CY, r, 0, Math.PI * 2); g.stroke(); }
        for (const ry of [120, 220, 300]) { g.beginPath(); g.ellipse(CX, CY, 356, ry, 0, 0, Math.PI * 2); g.stroke(); }
        g.beginPath(); g.ellipse(CX, CY, 140, 356, 0, 0, Math.PI * 2); g.stroke();
        /* crucetas diagonales del campo */
        g.strokeStyle = tinta("176,124,78", 0.12);
        for (const [dx, dy] of [[-1, -1], [1, -1], [-1, 1], [1, 1]] as const) {
          g.beginPath();
          g.moveTo(CX + dx * 150, CY + dy * 150);
          g.lineTo(CX + dx * 430, CY + dy * 430);
          g.stroke();
        }
        /* anillo punteado exterior */
        for (let k = 0; k < 72; k++) {
          const a = (k / 72) * Math.PI * 2;
          g.fillStyle = tinta("176,124,78", k % 6 === 0 ? 0.5 : 0.2);
          g.beginPath();
          g.arc(CX + Math.cos(a) * 398, CY + Math.sin(a) * 398, k % 6 === 0 ? 1.8 : 1, 0, Math.PI * 2);
          g.fill();
        }

        /* ── el tribar ────────────────────────────────────────────── */
        cara(0, brillo); cara(1, brillo); cara(2, brillo);
        /* EL TEJIDO IMPOSIBLE: cada esquina, la cara anterior pisa a la
           siguiente. Se redibuja el pico de la cara k−1 sobre la cara k,
           recortado a un radio corto alrededor del vértice compartido. */
        for (let k = 0; k < 3; k++) {
          const vk = V[(k + 1) % 3]; // vértice donde se cruzan cara k y k+1
          g.save();
          g.beginPath(); g.arc(vk[0], vk[1], 86, 0, Math.PI * 2); g.clip();
          cara(k, brillo);
          g.restore();
        }
        /* vértices radiantes */
        for (const [vx, vy] of V) {
          const halo = g.createRadialGradient(vx, vy, 0, vx, vy, 46);
          halo.addColorStop(0, tinta("245,205,140", 0.62 * brillo));
          halo.addColorStop(1, "rgba(0,0,0,0)");
          g.fillStyle = halo;
          g.fillRect(vx - 48, vy - 48, 96, 96);
        }
        /* chispas */
        for (const c of chispas) {
          g.fillStyle = tinta("235,190,130", c.o * brillo);
          g.beginPath(); g.arc(c.x, c.y, c.r, 0, Math.PI * 2); g.fill();
        }

        /* ── el sol del sello, al pie ─────────────────────────────── */
        const SX = 512, SY = 1338;
        for (let k = 0; k < 48; k++) {
          const a = (k / 48) * Math.PI * 2;
          const L = 26 + ((k * 31) % 5) * 9 + (k % 2 ? 0 : 14);
          g.strokeStyle = tinta("176,124,78", 0.5 * brillo);
          g.lineWidth = 0.9;
          g.beginPath();
          g.moveTo(SX + Math.cos(a) * 24, SY + Math.sin(a) * 24);
          g.lineTo(SX + Math.cos(a) * (24 + L), SY + Math.sin(a) * (24 + L));
          g.stroke();
        }
        g.strokeStyle = tinta("207,154,94", 0.85);
        g.lineWidth = 1.2;
        g.beginPath(); g.arc(SX, SY, 22, 0, Math.PI * 2); g.stroke();
        g.fillStyle = tinta("207,154,94", 0.95);
        g.font = "700 13px Georgia, serif";
        g.textAlign = "center";
        g.fillText("KX", SX, SY - 2);
        g.fillText("∞", SX, SY + 13);
      };

      montarLienzo({ raiz, cuadro: pintar, periodo: 28000, periodoReducido: 68000 });

      montarEscala();
    </script>

    <!-- Salida de la lamina. Hallazgo #5 de la auditoria: 0 enlaces, callejon
         sin salida. El banco congela antes de capturar (data-kdx-frozen), asi
         que la salida NO entra en la medicion. -->
    <a class="lam-salida" href="/kodex/lamina/">← KODEX−∞ · PLATES</a>
    <style>
      .lam-salida{position:fixed;top:10px;left:12px;z-index:9;font:11px ui-monospace,monospace;
        letter-spacing:.18em;color:rgba(240,237,232,.62);text-decoration:none;
        padding:10px 12px;background:rgba(0,0,0,.45);border:1px solid rgba(240,237,232,.14);}
      .lam-salida:hover{color:#fff;border-color:rgba(240,237,232,.4)}
      html[data-kdx-frozen] .lam-salida{display:none}
    </style>
  </body>
</html>
