<script>
  import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
  import { rng } from "../../../components/kodex/lamina/kit/rng";
  import { montarEscala } from "../../../components/kodex/lamina/kit/escala";

  const raiz = document.querySelector("[data-lam]") as HTMLElement;

  /* ══ EL SIGILO DE LA CABECERA (riel izquierdo, estático) ════════ */
  {
    const c = document.getElementById("ak-sello") as HTMLCanvasElement;
    const g = c.getContext("2d")!;
    const CX = 83, CY = 77, R = 64;
    const r = rng(0x29a1);
    /* retícula de oro: círculo exterior, dodecágono, radios y una
       maraña de cuerdas finas — así se lee el sigilo de la referencia */
    g.strokeStyle = tinta("201,169,97", 0.65);
    g.lineWidth = 1;
    g.beginPath(); g.arc(CX, CY, R, 0, Math.PI * 2); g.stroke();
    g.strokeStyle = tinta("157,133,79", 0.45);
    g.beginPath(); g.arc(CX, CY, R - 7, 0, Math.PI * 2); g.stroke();
    g.beginPath(); g.arc(CX, CY, 40, 0, Math.PI * 2); g.stroke();
    for (let k = 0; k < 24; k++) {
      const a = (k / 24) * Math.PI * 2;
      g.strokeStyle = tinta("176,141,78", 0.22 + r() * 0.2);
      g.beginPath();
      g.moveTo(CX + Math.cos(a) * 8, CY + Math.sin(a) * 8);
      g.lineTo(CX + Math.cos(a) * (R - 7), CY + Math.sin(a) * (R - 7));
      g.stroke();
    }
    for (let k = 0; k < 34; k++) {
      const a1 = r() * Math.PI * 2, a2 = a1 + 1.2 + r() * 2.4;
      g.strokeStyle = tinta("201,169,97", 0.12 + r() * 0.2);
      g.beginPath();
      g.moveTo(CX + Math.cos(a1) * 52, CY + Math.sin(a1) * 52);
      g.lineTo(CX + Math.cos(a2) * 52, CY + Math.sin(a2) * 52);
      g.stroke();
    }
    /* nodos del anillo */
    for (let k = 0; k < 8; k++) {
      const a = (k / 8) * Math.PI * 2 - Math.PI / 2;
      const x = CX + Math.cos(a) * R, y = CY + Math.sin(a) * R;
      g.fillStyle = tinta("10,7,4", 0.95);
      g.beginPath(); g.arc(x, y, 5, 0, Math.PI * 2); g.fill();
      g.strokeStyle = tinta("232,205,140", 0.85);
      g.beginPath(); g.arc(x, y, 5, 0, Math.PI * 2); g.stroke();
      g.fillStyle = tinta("245,230,180", 0.9);
      g.beginPath(); g.arc(x, y, 1.6, 0, Math.PI * 2); g.fill();
    }
    /* EL ∞ VIOLETA — el único acento frío de la esquina */
    const halo = g.createRadialGradient(CX, CY, 2, CX, CY, 44);
    halo.addColorStop(0, tinta("157,127,216", 0.55));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo;
    g.beginPath(); g.arc(CX, CY, 44, 0, Math.PI * 2); g.fill();
    const lazo = (ancho: number, alto: number, al: number, col: string) => {
      g.strokeStyle = tinta(col, al);
      g.lineWidth = ancho;
      g.beginPath();
      for (let i = 0; i <= 90; i++) {
        const t = (i / 90) * Math.PI * 2;
        const d = 1 + Math.sin(t) ** 2;
        const x = CX + (28 * Math.cos(t)) / d;
        const y = CY + (28 * Math.sin(t) * Math.cos(t)) / d;
        i ? g.lineTo(x, y) : g.moveTo(x, y);
      }
      g.closePath(); g.stroke();
      void alto;
    };
    lazo(9, 0.5, 0.55, "125,86,214");
    lazo(4.4, 0, 0.95, "222,204,255");
    lazo(1.6, 0, 1, "255,255,255");
  }

  /* ══ CRISTALES (paneles 03 y 05) ═══════════════════════════════ */
  const cristal = (
    id: string, cx: number, cyTop: number, w: number, h: number,
    semilla: number, brillo = 1,
  ) => {
    const c = document.getElementById(id) as HTMLCanvasElement;
    if (!c) return;
    const g = c.getContext("2d")!;
    const r = rng(semilla);
    const punta = h * 0.16, base = h * 0.22;
    const cyBot = cyTop + h;
    /* halo */
    const halo = g.createRadialGradient(cx, cyTop + h * 0.6, 4, cx, cyTop + h * 0.6, w * 1.5);
    halo.addColorStop(0, tinta("168,138,232", 0.4 * brillo));
    halo.addColorStop(0.5, tinta("120,92,190", 0.14 * brillo));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo;
    g.fillRect(0, 0, c.width, c.height);
    /* cuerpo prismático */
    const cuerpo = new Path2D();
    cuerpo.moveTo(cx, cyTop);
    cuerpo.lineTo(cx + w / 2, cyTop + punta);
    cuerpo.lineTo(cx + w / 2, cyBot - base);
    cuerpo.lineTo(cx, cyBot);
    cuerpo.lineTo(cx - w / 2, cyBot - base);
    cuerpo.lineTo(cx - w / 2, cyTop + punta);
    cuerpo.closePath();
    const lg = g.createLinearGradient(cx - w / 2, 0, cx + w / 2, 0);
    lg.addColorStop(0, tinta("120,96,180", 0.55 * brillo));
    lg.addColorStop(0.35, tinta("214,196,248", 0.72 * brillo));
    lg.addColorStop(0.62, tinta("158,128,220", 0.6 * brillo));
    lg.addColorStop(1, tinta("196,178,236", 0.62 * brillo));
    g.fillStyle = lg;
    g.fill(cuerpo);
    /* facetas */
    g.save();
    g.clip(cuerpo);
    g.strokeStyle = tinta("240,232,255", 0.55 * brillo);
    g.lineWidth = 1;
    for (const f of [-0.5, -0.18, 0.18, 0.5]) {
      g.beginPath();
      g.moveTo(cx + w * f, cyTop + punta * (1 - Math.abs(f) * 1.4));
      g.lineTo(cx + w * f * 0.85, cyBot - base * (1 - Math.abs(f)));
      g.stroke();
    }
    g.beginPath(); g.moveTo(cx - w / 2, cyTop + punta); g.lineTo(cx, cyTop + punta * 1.9); g.lineTo(cx + w / 2, cyTop + punta); g.stroke();
    g.beginPath(); g.moveTo(cx - w / 2, cyBot - base); g.lineTo(cx, cyBot - base * 1.6); g.lineTo(cx + w / 2, cyBot - base); g.stroke();
    /* corazón encendido */
    g.save();
    g.globalCompositeOperation = "lighter";
    const nucleo = g.createRadialGradient(cx, cyBot - base * 1.2, 1, cx, cyBot - base * 1.2, w * 0.8);
    nucleo.addColorStop(0, tinta("255,250,255", 0.85 * brillo));
    nucleo.addColorStop(0.4, tinta("196,164,255", 0.28 * brillo));
    nucleo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = nucleo;
    g.fillRect(0, 0, c.width, c.height);
    for (let k = 0; k < 26; k++) {
      const x = cx + (r() - 0.5) * w, y = cyTop + r() * h;
      g.fillStyle = tinta("255,248,230", (0.15 + r() * 0.5) * brillo);
      g.beginPath(); g.arc(x, y, 0.5 + r() * 1.2, 0, Math.PI * 2); g.fill();
    }
    g.restore();
    g.restore();
    /* aristas */
    g.strokeStyle = tinta("246,240,255", 0.85 * brillo);
    g.lineWidth = 1.3;
    g.stroke(cuerpo);
  };
  cristal("ak-cristal-izq", 55, 7, 64, 156, 0x29b1, 1);
  cristal("ak-cristal-der", 60, 4, 76, 222, 0x29b2, 1.05);

  /* ══ EL GUARDIÁN (panel 06) ════════════════════════════════════ */
  {
    const c = document.getElementById("ak-guardian") as HTMLCanvasElement;
    const g = c.getContext("2d")!;
    const CX = 100, CY = 74;
    /* anillos de oro concéntricos con nodos cardinales */
    for (const [rr, al] of [[72, 0.28], [62, 0.5], [48, 0.6], [37, 0.3]] as const) {
      g.strokeStyle = tinta("176,141,78", al);
      g.lineWidth = 1;
      g.beginPath(); g.arc(CX, CY, rr, 0, Math.PI * 2); g.stroke();
    }
    const r = rng(0x29c1);
    for (let k = 0; k < 30; k++) {
      const a = r() * Math.PI * 2, d = 44 + r() * 42;
      g.fillStyle = tinta("232,205,140", 0.3 + r() * 0.5);
      g.beginPath(); g.arc(CX + Math.cos(a) * d, CY + Math.sin(a) * d * 0.98, 1.1, 0, Math.PI * 2); g.fill();
    }
    /* la figura encapuchada: silueta violeta con reborde de luz */
    const halo = g.createRadialGradient(CX, CY - 6, 3, CX, CY - 6, 52);
    halo.addColorStop(0, tinta("140,110,200", 0.42));
    halo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = halo;
    g.beginPath(); g.arc(CX, CY, 52, 0, Math.PI * 2); g.fill();
    const capa = new Path2D();
    capa.moveTo(CX, CY - 44);
    capa.bezierCurveTo(CX + 20, CY - 42, CX + 24, CY - 16, CX + 22, CY - 4);
    capa.bezierCurveTo(CX + 40, CY + 6, CX + 44, CY + 30, CX + 44, CY + 48);
    capa.lineTo(CX - 44, CY + 48);
    capa.bezierCurveTo(CX - 44, CY + 30, CX - 40, CY + 6, CX - 22, CY - 4);
    capa.bezierCurveTo(CX - 24, CY - 16, CX - 20, CY - 42, CX, CY - 44);
    capa.closePath();
    const tela = g.createLinearGradient(0, CY - 44, 0, CY + 48);
    tela.addColorStop(0, tinta("74,58,120", 0.95));
    tela.addColorStop(0.5, tinta("38,30,62", 0.97));
    tela.addColorStop(1, tinta("20,16,34", 0.98));
    g.fillStyle = tela;
    g.fill(capa);
    g.strokeStyle = tinta("176,150,236", 0.55);
    g.lineWidth = 1.1;
    g.stroke(capa);
    /* el vacío de la capucha */
    g.fillStyle = "#05030a";
    g.beginPath(); g.ellipse(CX, CY - 18, 13, 17, 0, 0, Math.PI * 2); g.fill();
    g.strokeStyle = tinta("190,168,240", 0.5);
    g.beginPath(); g.ellipse(CX, CY - 20, 15, 20, 0, 0, Math.PI * 2); g.stroke();
    /* broche */
    g.strokeStyle = tinta("232,205,140", 0.75);
    g.beginPath(); g.moveTo(CX - 9, CY + 16); g.lineTo(CX, CY + 24); g.lineTo(CX + 9, CY + 16); g.stroke();
    /* cuatro glifos cardinales */
    for (let k = 0; k < 4; k++) {
      const a = (k / 4) * Math.PI * 2 - Math.PI / 2;
      const x = CX + Math.cos(a) * 72, y = CY + Math.sin(a) * 72;
      g.fillStyle = "#08050e";
      g.beginPath(); g.arc(x, y, 12, 0, Math.PI * 2); g.fill();
      g.strokeStyle = tinta("201,169,97", 0.85);
      g.beginPath(); g.arc(x, y, 12, 0, Math.PI * 2); g.stroke();
      g.strokeStyle = tinta("240,223,168", 0.9);
      g.lineWidth = 1.2;
      g.strokeRect(x - 4, y - 5, 8, 10);
      g.beginPath(); g.moveTo(x, y - 7); g.lineTo(x, y + 7); g.stroke();
      g.lineWidth = 1;
    }
  }

  /* ══ EL ORGANISMO · LA CORONA AKÁSHICA ═════════════════════════
     Lienzo 830×1200 anclado en la página en (200,250). MEDIDO sobre la
     referencia y no estimado:
     · el eje luminoso NO cae en el centro de la lámina (x614,5) sino en
       x≈636 → 436 del lienzo (mapa de luminancia 18×22: 145..193 en esa
       columna contra 6..20 en los cantos);
     · el cristal mayor va de y311 a y490 (canvas 61..240) y mide 63 px
       de ancho;
     · la cinta de runas ocupa y495..553 (canvas 245..303) con semieje
       285 px;
     · los tres sigilos ensartados en el haz caen en y819/869/925
       (canvas 569/619/675) con radio 21;
     · el estrado tiene su elipse mayor en y1240 (canvas 990) y semieje
       290 px; los guardianes apoyan en y1201 (canvas 951). ────────── */
  const canvas = document.getElementById("ak-corona") as HTMLCanvasElement;
  const g = canvas.getContext("2d")!;
  const W = 830, H = 1200;
  const EJE = 436;          /* x636 de la página */
  const CRISTAL_Y = 150;    /* centro del cristal mayor: y400 */
  const CINTA_Y = 245;      /* cinta de runas: y495 */
  const SUELO_Y = 990;      /* estrado: y1240 */
  const rnd = rng(0x29ff);

  /* polvo de estrellas fijo: la referencia tiene nebulosa, no negro */
  const polvo = Array.from({ length: 4200 }, () => {
    const x = rnd() * W, y = rnd() * H;
    return {
      x, y,
      s: 0.6 + rnd() * 1.4,
      o: 0.08 + rnd() * 0.5,
      c: rnd() < 0.35 ? "232,205,140" : rnd() < 0.6 ? "168,140,224" : "196,190,232",
    };
  });
  const chispas = Array.from({ length: 420 }, () => ({
    x: rnd() * W, y: rnd() * H, r: 0.6 + rnd() * 1.5, o: 0.2 + rnd() * 0.7, v: rnd(),
  }));
  const nubes = Array.from({ length: 20 }, () => ({
    x: rnd() * W, y: 40 + rnd() * 760, r: 60 + rnd() * 160,
    o: 0.04 + rnd() * 0.09,
    c: rnd() < 0.5 ? "96,62,160" : "60,48,120",
  }));

  /* Un aro del candelabro no es una línea: MEDIDO, en y620..670 de la
     página la referencia da 108 y 100 de luminancia media en cajas de
     36×50 px, y ningún trazo de 1,8 px levanta eso. Son aros con
     CUERPO, y por eso se pintan como corona circular. */
  const anillo = (cx: number, cy: number, rx: number, ry: number, t: number,
                  al: number, luz: number) => {
    const ri = rx - t, rj = Math.max(1, ry - (t * ry) / rx);
    g.save();
    g.beginPath();
    g.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
    g.ellipse(cx, cy, ri, rj, 0, 0, Math.PI * 2);
    const gr = g.createLinearGradient(cx - rx, 0, cx + rx, 0);
    gr.addColorStop(0, tinta("255,232,168", 0.95 * al * luz));
    gr.addColorStop(0.24, tinta("214,166,92", 0.5 * al * luz));
    gr.addColorStop(0.5, tinta("246,206,132", 0.7 * al * luz));
    gr.addColorStop(0.76, tinta("214,166,92", 0.5 * al * luz));
    gr.addColorStop(1, tinta("255,232,168", 0.95 * al * luz));
    g.fillStyle = gr;
    g.fill("evenodd");
    g.restore();
    g.strokeStyle = tinta("255,246,214", 0.55 * al * luz);
    g.lineWidth = 1;
    g.beginPath(); g.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2); g.stroke();
  };
  const arco = (cx: number, cy: number, rx: number, ry: number, a0: number, a1: number,
                col: string, al: number, gr = 1) => {
    g.strokeStyle = tinta(col, al);
    g.lineWidth = gr;
    g.beginPath(); g.ellipse(cx, cy, rx, ry, 0, a0, a1); g.stroke();
  };
  const elipse = (cx: number, cy: number, rx: number, ry: number, col: string, al: number, gr = 1) => {
    g.strokeStyle = tinta(col, al);
    g.lineWidth = gr;
    g.beginPath(); g.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2); g.stroke();
  };

  /* cristal de cuarzo colgante: el módulo que se repite diez veces */
  const gema = (x: number, y: number, w0: number, h0: number, br: number, luz: number, cadena = true) => {
    if (cadena) {
      g.strokeStyle = tinta("201,169,97", 0.26);
      g.lineWidth = 0.9;
      g.beginPath(); g.moveTo(x, 0); g.lineTo(x, y - h0 / 2); g.stroke();
    }
    g.save();
    g.globalCompositeOperation = "lighter";
    const hg = g.createRadialGradient(x, y, 1, x, y, w0 * 2.2);
    hg.addColorStop(0, tinta("190,164,252", 0.34 * br * luz));
    hg.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = hg;
    g.fillRect(x - w0 * 2.2, y - w0 * 2.2, w0 * 4.4, w0 * 4.4);
    g.restore();
    const p = new Path2D();
    p.moveTo(x, y - h0 / 2);
    p.lineTo(x + w0 / 2, y - h0 / 2 + h0 * 0.18);
    p.lineTo(x + w0 / 2, y + h0 / 2 - h0 * 0.22);
    p.lineTo(x, y + h0 / 2);
    p.lineTo(x - w0 / 2, y + h0 / 2 - h0 * 0.22);
    p.lineTo(x - w0 / 2, y - h0 / 2 + h0 * 0.18);
    p.closePath();
    const lg = g.createLinearGradient(x - w0 / 2, 0, x + w0 / 2, 0);
    lg.addColorStop(0, tinta("128,104,190", 0.62 * br));
    lg.addColorStop(0.38, tinta("226,214,255", 0.82 * br));
    lg.addColorStop(0.7, tinta("158,132,220", 0.6 * br));
    lg.addColorStop(1, tinta("196,178,238", 0.66 * br));
    g.fillStyle = lg;
    g.fill(p);
    g.strokeStyle = tinta("248,242,255", 0.75 * br * luz);
    g.lineWidth = 1;
    g.stroke(p);
    g.beginPath(); g.moveTo(x, y - h0 / 2); g.lineTo(x, y + h0 / 2); g.stroke();
  };

  const pintar = (fase: number) => {
    const luz = 0.9 + 0.1 * Math.cos(fase * Math.PI * 2);
    g.clearRect(0, 0, W, H);

    /* ── 1 · la cámara ──────────────────────────────────────────── */
    const fondo = g.createLinearGradient(0, 0, 0, H);
    fondo.addColorStop(0, "#080418");
    fondo.addColorStop(0.4, "#130c2a");
    fondo.addColorStop(0.76, "#170e2e");
    fondo.addColorStop(1, "#090614");
    g.fillStyle = fondo;
    g.fillRect(0, 0, W, H);

    /* ── 2 · AMBIENTE RADIAL. La lección más cara de la serie: la
       referencia NO es negro plano, es una cámara iluminada al centro
       con caída a los bordes. ──────────────────────────────────── */
    /* meseta de la bóveda: casi plana entre canvas x100 y x770 */
    g.save();
    g.translate(EJE, 210);
    g.scale(1, 0.52);
    const amb = g.createRadialGradient(0, 0, 120, 0, 0, 400);
    amb.addColorStop(0, tinta("150,116,224", 0.2 * luz));
    amb.addColorStop(0.5, tinta("126,96,200", 0.17 * luz));
    amb.addColorStop(0.82, tinta("84,64,144", 0.11 * luz));
    amb.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = amb;
    g.fillRect(-EJE, -400, W, 800);
    g.restore();
    /* el corredor mide 15..25 en la referencia: apenas un velo */
    const amb1b = g.createLinearGradient(0, 430, 0, 880);
    amb1b.addColorStop(0, tinta("96,74,158", 0.07 * luz));
    amb1b.addColorStop(1, tinta("70,54,120", 0.02));
    g.fillStyle = amb1b;
    g.fillRect(60, 430, W - 120, 450);
    /* y el estrado, que en la referencia mide 60..160 de luminancia */
    g.save();
    g.translate(EJE, SUELO_Y - 70);
    g.scale(1, 0.36);
    const amb2 = g.createRadialGradient(0, 0, 40, 0, 0, 470);
    amb2.addColorStop(0, tinta("226,180,116", 0.6 * luz));
    amb2.addColorStop(0.5, tinta("200,158,106", 0.5 * luz));
    amb2.addColorStop(0.86, tinta("158,120,86", 0.34 * luz));
    amb2.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = amb2;
    g.fillRect(-EJE, -470, W, 940);
    g.restore();

    g.save();
    g.globalCompositeOperation = "lighter";
    for (const n of nubes) {
      const gr = g.createRadialGradient(n.x, n.y, 2, n.x, n.y, n.r);
      gr.addColorStop(0, tinta(n.c, n.o));
      gr.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = gr;
      g.fillRect(n.x - n.r, n.y - n.r, n.r * 2, n.r * 2);
    }
    g.restore();
    for (const p of polvo) {
      g.fillStyle = tinta(p.c, p.o * (0.7 + 0.3 * luz));
      g.fillRect(p.x, p.y, p.s, p.s);
    }

    /* ── 3 · ARQUITECTURA: columnas de la cámara ────────────────── */
    const columna = (x: number, ancho: number, y0: number, y1: number, al: number) => {
      const gr = g.createLinearGradient(x - ancho / 2, 0, x + ancho / 2, 0);
      gr.addColorStop(0, tinta("14,10,26", 0.92));
      gr.addColorStop(0.4, tinta("40,28,58", 0.86));
      gr.addColorStop(0.62, tinta("70,52,38", 0.16 * al));
      gr.addColorStop(1, tinta("12,8,22", 0.94));
      g.fillStyle = gr;
      g.fillRect(x - ancho / 2, y0, ancho, y1 - y0);
      g.strokeStyle = tinta("214,176,104", 0.1 * al * luz);
      g.lineWidth = 1;
      g.beginPath();
      g.moveTo(x + ancho / 2, y0); g.lineTo(x + ancho / 2, y1);
      g.moveTo(x - ancho / 2, y0); g.lineTo(x - ancho / 2, y1);
      g.stroke();
      for (let y = y0 + 46; y < y1; y += 82) {
        g.strokeStyle = tinta("214,176,104", 0.14 * al);
        g.beginPath(); g.moveTo(x - ancho / 2 - 3, y); g.lineTo(x + ancho / 2 + 3, y); g.stroke();
      }
    };
    for (const [x, a, al] of [[62, 30, 0.35], [806, 30, 0.35],
                              [160, 26, 0.3], [712, 26, 0.3]] as const) {
      columna(x, a, 330, 980, al);
    }

    /* ── ARCADA DEL FONDO ──
       MEDIDO con el mapa de cobertura: las celdas de los cantos del
       centro (páginas x246..340 y x900..987 bajo y1000) daban entre el
       1 % y el 31 % de la tinta de la referencia. Lo que falta ahí no
       es brillo suelto: es ARQUITECTURA — arcos apuntados con filo de
       oro y, en los extremos, los estandartes de runas. */
    const arcada = (x: number, w0: number, base: number, alto: number, al: number) => {
      const cima = base - alto;
      g.save();
      g.beginPath();
      g.moveTo(x - w0, base);
      g.lineTo(x - w0, cima + w0 * 0.9);
      g.quadraticCurveTo(x, cima - w0 * 0.35, x + w0, cima + w0 * 0.9);
      g.lineTo(x + w0, base);
      g.closePath();
      const hueco = g.createLinearGradient(0, cima, 0, base);
      hueco.addColorStop(0, tinta("58,42,96", 0.5 * al));
      hueco.addColorStop(0.5, tinta("86,62,132", 0.42 * al * luz));
      hueco.addColorStop(1, tinta("30,22,52", 0.6 * al));
      g.fillStyle = hueco;
      g.fill();
      g.restore();
      g.strokeStyle = tinta("226,186,116", 0.42 * al * luz);
      g.lineWidth = 1.6;
      g.beginPath();
      g.moveTo(x - w0, base);
      g.lineTo(x - w0, cima + w0 * 0.9);
      g.quadraticCurveTo(x, cima - w0 * 0.35, x + w0, cima + w0 * 0.9);
      g.lineTo(x + w0, base);
      g.stroke();
      /* clave del arco */
      g.fillStyle = tinta("246,212,140", 0.5 * al * luz);
      g.beginPath();
      g.arc(x, cima + w0 * 0.3, 3.4, 0, Math.PI * 2);
      g.fill();
    };
