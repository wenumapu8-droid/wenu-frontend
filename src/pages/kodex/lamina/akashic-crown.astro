      const w0 = alto * 0.3;
      const p = new Path2D();
      p.moveTo(x, y - alto);
      p.bezierCurveTo(x + w0 * 0.42, y - alto * 0.97, x + w0 * 0.5, y - alto * 0.76, x + w0 * 0.44, y - alto * 0.68);
      p.bezierCurveTo(x + w0 * 0.9, y - alto * 0.58, x + w0, y - alto * 0.2, x + w0, y);
      p.lineTo(x - w0, y);
      p.bezierCurveTo(x - w0, y - alto * 0.2, x - w0 * 0.9, y - alto * 0.58, x - w0 * 0.44, y - alto * 0.68);
      p.bezierCurveTo(x - w0 * 0.5, y - alto * 0.76, x - w0 * 0.42, y - alto * 0.97, x, y - alto);
      p.closePath();
      const tela = g.createLinearGradient(0, y - alto, 0, y);
      /* MEDIDO: los nuestros salían PÁLIDOS sobre el fondo. En la
         referencia son siluetas casi negras con un filo de oro. */
      tela.addColorStop(0, tinta("34,26,58", 0.96 * al));
      tela.addColorStop(0.55, tinta("20,15,36", 0.97 * al));
      tela.addColorStop(1, tinta("10,7,18", 0.98 * al));
      g.fillStyle = tela;
      g.fill(p);
      g.strokeStyle = tinta("232,196,140", 0.55 * al * luz);
      g.lineWidth = 1;
      g.stroke(p);
      g.fillStyle = tinta("4,3,8", 0.95);
      g.beginPath(); g.ellipse(x, y - alto * 0.84, w0 * 0.24, alto * 0.09, 0, 0, Math.PI * 2); g.fill();
    };
    for (const [x, alto] of [
      [111, 122], [196, 118], [264, 114], [322, 110],
      [580, 110], [633, 114], [685, 118], [743, 122],
    ] as const) {
      guardian(x, 942, alto, 0.95);
    }

    /* ── 8 · LA FIGURA SENTADA (cabeza en y1100 de la página) ───── */
    {
      const x = EJE, y = SUELO_Y - 8;
      g.save();
      g.globalCompositeOperation = "lighter";
      const aura = g.createRadialGradient(x, y - 110, 6, x, y - 110, 150);
      aura.addColorStop(0, tinta("255,242,214", 0.34 * luz));
      aura.addColorStop(0.33, tinta("186,150,250", 0.09 * luz));
      aura.addColorStop(1, "rgba(0,0,0,0)");
      g.fillStyle = aura;
      g.fillRect(x - 150, y - 290, 300, 340);
      g.restore();
      const piel = g.createLinearGradient(0, y - 180, 0, y);
      piel.addColorStop(0, tinta("92,70,148", 0.98));
      piel.addColorStop(0.6, tinta("54,42,92", 0.98));
      piel.addColorStop(1, tinta("28,22,52", 0.98));
      g.fillStyle = piel;
      g.beginPath(); g.ellipse(x, y - 14, 88, 24, 0, 0, Math.PI * 2); g.fill();
      g.beginPath();
      g.moveTo(x - 38, y - 22);
      g.bezierCurveTo(x - 44, y - 86, x - 32, y - 122, x - 23, y - 134);
      g.lineTo(x + 23, y - 134);
      g.bezierCurveTo(x + 32, y - 122, x + 44, y - 86, x + 38, y - 22);
      g.closePath();
      g.fill();
      g.strokeStyle = tinta("60,46,100", 0.98);
      g.lineWidth = 14;
      g.beginPath();
      g.moveTo(x - 32, y - 112); g.quadraticCurveTo(x - 80, y - 72, x - 68, y - 28); g.stroke();
      g.beginPath();
      g.moveTo(x + 32, y - 112); g.quadraticCurveTo(x + 80, y - 72, x + 68, y - 28); g.stroke();
      g.fillStyle = piel;
      g.beginPath(); g.ellipse(x, y - 160, 24, 30, 0, 0, Math.PI * 2); g.fill();
      g.strokeStyle = tinta("236,206,150", 0.5 * luz);
      g.lineWidth = 1.3;
      g.beginPath(); g.ellipse(x, y - 160, 24, 30, 0, 0, Math.PI * 2); g.stroke();
      g.save();
      g.globalCompositeOperation = "lighter";
      for (const [cy, rad, col] of [
        [y - 192, 24, "236,214,255"], [y - 134, 18, "255,238,196"],
        [y - 92, 16, "236,214,255"], [y - 44, 14, "255,238,196"],
      ] as Array<[number, number, string]>) {
        const gl = g.createRadialGradient(x, cy, 1, x, cy, rad * 2.4);
        gl.addColorStop(0, tinta(col, 0.9 * luz));
        gl.addColorStop(0.3, tinta(col, 0.32 * luz));
        gl.addColorStop(1, "rgba(0,0,0,0)");
        g.fillStyle = gl;
        g.fillRect(x - rad * 2.4, cy - rad * 2.4, rad * 4.8, rad * 4.8);
      }
      g.restore();
      for (const [cy, rad] of [[y - 144, 58], [y - 92, 74], [y - 42, 92]] as const) {
        g.strokeStyle = tinta("240,214,150", 0.45 * luz);
        g.lineWidth = 1;
        g.beginPath(); g.arc(x, cy, rad, 0, Math.PI * 2); g.stroke();
      }
    }

    /* ── 9 · chispas ────────────────────────────────────────────── */
    g.save();
    g.globalCompositeOperation = "lighter";
    for (const c of chispas) {
      const y = c.y + Math.sin(fase * Math.PI * 2 + c.v * 6.28) * 5;
      const cerca = Math.abs(c.x - EJE) < 260 ? 1 : 0.4;
      g.fillStyle = tinta("255,238,196", c.o * cerca * luz);
      g.beginPath(); g.arc(c.x, y, c.r, 0, Math.PI * 2); g.fill();
    }
    g.restore();

    /* ── 10 · VIÑETA. La palanca grande de la serie: la caída a los
       bordes es lo que hace que el centro LEA como cámara. MEDIDO: es
       ELÍPTICA y no circular — con la circular la franja y1344 de la
       página (el reflejo del haz bajo el estrado) salía 103 puntos por
       debajo, porque la viñeta se comía justo lo que la referencia
       tiene encendido. ───────────────────────────────────────────── */
    g.save();
    g.translate(EJE, 600);
    g.scale(1, 1.34);
    const vin = g.createRadialGradient(0, 0, 130, 0, 0, 520);
    vin.addColorStop(0, "rgba(0,0,0,0)");
    vin.addColorStop(0.52, "rgba(3,2,7,0.3)");
    vin.addColorStop(1, "rgba(3,2,7,0.95)");
    g.fillStyle = vin;
    g.fillRect(-EJE, -600 / 1.34, W, H / 1.34 + 400);
    g.restore();
    const bordeArriba = g.createLinearGradient(0, 0, 0, 30);
    bordeArriba.addColorStop(0, "rgba(5,3,10,1)");
    bordeArriba.addColorStop(1, "rgba(5,3,10,0)");
    g.fillStyle = bordeArriba;
    g.fillRect(0, 0, W, 30);
    const bordeAbajo = g.createLinearGradient(0, H - 70, 0, H);
    bordeAbajo.addColorStop(0, "rgba(5,3,10,0)");
    bordeAbajo.addColorStop(1, "rgba(5,3,10,1)");
    g.fillStyle = bordeAbajo;
    g.fillRect(0, H - 70, W, 70);

    /* EL HAZ SIGUE BAJO EL ESTRADO. MEDIDO: la franja y1344 de la
       página sale 124 puntos por debajo en la columna del eje. */
    g.save();
    g.globalCompositeOperation = "lighter";
    const bajo = g.createLinearGradient(0, SUELO_Y, 0, 1180);
    bajo.addColorStop(0, tinta("255,248,230", 0.6 * luz));
    bajo.addColorStop(0.45, tinta("246,228,255", 0.9 * luz));
    bajo.addColorStop(1, tinta("226,196,255", 0.3));
    g.fillStyle = bajo;
    g.fillRect(EJE - 7, SUELO_Y, 14, 200);
    const bajoHalo = g.createLinearGradient(EJE - 54, 0, EJE + 54, 0);
    bajoHalo.addColorStop(0, "rgba(0,0,0,0)");
    bajoHalo.addColorStop(0.5, tinta("214,180,255", 0.4 * luz));
    bajoHalo.addColorStop(1, "rgba(0,0,0,0)");
    g.fillStyle = bajoHalo;
    g.fillRect(EJE - 38, SUELO_Y, 76, 170);
    g.restore();

    /* el sigilo que el haz proyecta bajo el estrado */
    for (const [cy, rad] of [[1052, 44], [1112, 34]] as const) {
      g.strokeStyle = tinta("226,196,255", 0.8 * luz);
      g.lineWidth = 1.4;
      g.beginPath(); g.ellipse(EJE, cy, rad, rad * 0.62, 0, 0, Math.PI * 2); g.stroke();
      g.strokeStyle = tinta("255,244,224", 0.7);
      g.beginPath();
      g.moveTo(EJE, cy - rad * 0.42); g.lineTo(EJE + rad * 0.38, cy);
      g.lineTo(EJE, cy + rad * 0.42); g.lineTo(EJE - rad * 0.38, cy);
      g.closePath(); g.stroke();
    }

  };

  montarLienzo({ raiz, cuadro: pintar, periodo: 24000, periodoReducido: 64000 });
  montarEscala();
</script>
