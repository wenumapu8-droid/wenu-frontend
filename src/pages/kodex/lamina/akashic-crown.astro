          <path d="M5.5 -6 V101 L15 116 H79 L88.5 101 V-6" stroke="#9d854f" stroke-opacity="0.3" />
          <g transform="translate(47 122)" stroke="#c9a961" stroke-opacity="0.8" fill="none">
            <polygon points={estrella(9, 3, 4)} />
