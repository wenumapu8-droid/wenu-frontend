---
/**
 * KODEX−∞ · AKASHIC CROWN · PAGE 29 (a29)
 *
 * Lámina de la serie de archivo, mismo cromo que el piloto silence-engine
 * (a28) y que origin-forge (a22): componentes de
 * src/components/kodex/archivo/ en cajas absolutas MEDIDAS + organismo
 * central procedural en canvas (montarLienzo) + montarEscala.
 *
 * TODO el texto visible está TRANSCRITO de
 * reference/pendientes/akashic-crown.png (reencodeada de
 * a29-akashic-crown.png). Nada inventado.
 *
 * CAJAS MEDIDAS (perfil de tinta, _ak_probe.mjs sobre la referencia):
 * · marco exterior: x5..6 y x1214..1215 · y17..18 · doble regla al pie
 *   en y1525..1526 y y1529..1530.
 * · cabecera: "K O D E X − ∞" y30..41 (versal 12) x531..695 ·
 *   "UNIVERSAL ARCHIVE // VOL. I" y55..61 (versal 7) x460..768 ·
 *   caja PAGE x1107..1200, rótulo y41..50, número y67..104 (alto 38).
 * · título "AKASHIC CROWN" x238..1058 (821 px): versal grande y81..178
 *   (98 px), versalita y98..178 (81 px) → es VERSALITA REAL, no dos
 *   cuerpos sueltos. Subtítulo "CORONA AKÁSHICA" x311..960 y203..231.
 *   Consigna x275..971 y248..258 (versal 9).
 * · riel izq: caja alta del sigilo x23..189 (hasta y458); paneles
 *   01/02/03 x21..239 en y478..801, y811..1135, y1145..1429.
 * · riel der: paneles 04/05/06 x987..1202 en y286..801, y811..1135,
 *   y1145..1429.
 * · pie: aforismo y1405..1415 y y1431..1441 · firma y1499..1506 con
 *   su regla en y1503.
 *
 * EL ORGANISMO (transcrito de lo que se VE): una cámara abovedada de
 * archivo; del techo cuelga LA CORONA — anillos de oro concéntricos en
 * fuga con una cinta de runas, cristales de cuarzo violeta colgando de
 * cadenas, y un cristal mayor apuntando hacia abajo del que baja una
 * COLUMNA DE LUZ que atraviesa tres sigilos anillados hasta la coronilla
 * de una figura sentada en flor de loto sobre un estrado circular de
 * anillos grabados. Alrededor del estrado, guardianes encapuchados;
 * detrás, columnas altas y nebulosa violeta con polvo de estrellas.
 *
 * MEDIDO y que manda sobre el dibujo: el eje luminoso NO cae en el
 * centro de la lámina (x614,5) sino en x≈636; el mapa de luminancia
 * 18×22 del centro da 145..193 en esa columna y 6..20 en los bordes:
 * hay AMBIENTE RADIAL con caída fuerte, no negro plano.
 */
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/700.css";
import CabeceraArchivo from "../../../components/kodex/archivo/CabeceraArchivo.astro";
import TituloBilingue from "../../../components/kodex/archivo/TituloBilingue.astro";
import TarjetaMetrica from "../../../components/kodex/archivo/TarjetaMetrica.astro";
import RielMetricas from "../../../components/kodex/archivo/RielMetricas.astro";
import AforismoPie from "../../../components/kodex/archivo/AforismoPie.astro";
import { rng } from "../../../components/kodex/lamina/kit/rng";

/* ── geometría polar (misma del cromo de a22) ─────────────────────── */
const P = (r: number, a: number): [number, number] => {
  const t = ((a - 90) * Math.PI) / 180;
  return [Number((r * Math.cos(t)).toFixed(2)), Number((r * Math.sin(t)).toFixed(2))];
};
const poli = (r: number, n: number, off = 0) =>
  Array.from({ length: n }, (_, i) => P(r, off + (i * 360) / n).join(",")).join(" ");
const estrella = (re: number, ri: number, n: number, off = 0) =>
  Array.from({ length: n * 2 }, (_, i) => P(i % 2 ? ri : re, off + (i * 180) / n).join(",")).join(" ");
const angulos = (n: number, off = 0) => Array.from({ length: n }, (_, i) => off + (i * 360) / n);

/* ── ondas de los canales de memoria (semilla fija, nunca Math.random) ── */
const onda = (semilla: number, amp: number) => {
  const r = rng(semilla);
  const pts: string[] = [];
  for (let i = 0; i <= 56; i++) {
    const u = i / 56;
    /* envolvente: la referencia cierra las ondas en las puntas */
    const env = Math.sin(u * Math.PI) ** 0.6;
    const v = (r() - 0.5) * 2 * amp * env;
    pts.push(`${(i * 1.5).toFixed(1)},${(11 + v).toFixed(1)}`);
  }
  return pts.join(" ");
};

/* ── PANEL 01 · CANALES DE MEMORIA (transcritos) ──────────────────── */
const canales = [
  { n: "ORIGIN", hz: "7.83 Hz", s: 0x2901, a: 9.5 },
  { n: "SOUL", hz: "11.11 Hz", s: 0x2902, a: 8.0 },
  { n: "ANCESTRAL", hz: "14.44 Hz", s: 0x2903, a: 7.0 },
  { n: "COLLECTIVE", hz: "18.18 Hz", s: 0x2904, a: 9.0 },
  { n: "FUTURE", hz: "21.21 Hz", s: 0x2905, a: 8.5 },
  { n: "TIMELESS", hz: "∞ Hz", s: 0x2906, a: 7.5 },
];

/* ── PANEL 03 · pasos del acceso (transcritos) ────────────────────── */
const acceso = ["INTENT", "ALIGNMENT", "RESONANCE", "AUTHORIZATION", "INTEGRATION"];

/* ── PANEL 04 · escala del ancho de banda (transcrita) ────────────── */
const banda = [
  { v: "∞", t: "TRANSCENDENT", d: "ALL ACCESS", y: 14 },
  { v: "100%", t: "UNITY", d: "NO FILTER", y: 75 },
  { v: "75%", t: "WISDOM", d: "PATTERN SEEN", y: 128 },
  { v: "50%", t: "INSIGHT", d: "TRUTH RECEIVED", y: 184 },
  { v: "25%", t: "LEARNING", d: "DATA ABSORBED", y: 241 },
  { v: "10%", t: "AWARENESS", d: "GLIMPSE ONLY", y: 300 },
  { v: "0%", t: "UNCONSCIOUS", d: "DISCONNECTED", y: 354 },
];

/* ── PANEL 05 · capas del cristal (transcritas) ───────────────────── */
const capas = [
  { a: "PURE MEMORY", b: "ESSENCE", y: 60, cx: 100, cy: 26 },
  { a: "AKASHIC", b: "RECORD", y: 102, cx: 114, cy: 70 },
  { a: "TEMPORAL", b: "INDEX", y: 144, cx: 122, cy: 116 },
  { a: "SOUL", b: "SIGNATURE", y: 185, cx: 116, cy: 162 },
  { a: "EXPERIENCE", b: "IMPRINT", y: 228, cx: 100, cy: 205 },
];

/* ── nodos del diagrama de armónicos (semilla fija) ───────────────── */
const rArm = rng(0x2910);
const chispasArm = Array.from({ length: 34 }, () => {
  const a = rArm() * Math.PI * 2;
  const d = 12 + rArm() * 82;
  return { x: 100 + Math.cos(a) * d, y: 100 + Math.sin(a) * d * 0.98, r: 0.7 + rArm() * 1.5 };
});
