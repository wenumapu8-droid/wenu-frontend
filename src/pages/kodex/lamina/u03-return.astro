---
/**
 * KODEX-∞ · UNIVERSE PAGE 03 · RETURN
 *
 * Reproducción en código de `reference/canon/u03-return.png` (1122×1402).
 *
 * PAGE 03 de la serie UNIVERSE: THE CONVERGENT RETURN // ALL PATHS LEAD HOME.
 * A diferencia de las demás láminas de la serie, ésta va sobre BLANCO HUESO
 * —OPEN WHITE es literal—: diez muestras de fondo dan rgb(247±2,244±2,241±3),
 * ni un píxel negro de base. El héroe es una flor radial de filamentos que
 * convergen en un núcleo luminoso, procedural en canvas 2D como manda el
 * contrato: ni un bitmap, ni un SVG calcado.
 */
import "../../../styles/kodex-lamina.css";
import Cabecera from "../../../components/kodex/lamina/u03/Cabecera.astro";
import Flor from "../../../components/kodex/lamina/u03/Flor.astro";
import Paneles from "../../../components/kodex/lamina/u03/Paneles.astro";
import Pie from "../../../components/kodex/lamina/u03/Pie.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · RETURN · PAGE 03</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="u03-return">
      <Cabecera />
      <Flor />
      <Paneles />
      <Pie />
    </div>

    <style is:global>
      /* La lámina se dibuja a tamaño de referencia y se escala desde 0,0. */
      html, body { margin: 0; background: #f8f5f2; }
      .lam {
        position: relative;
        width: 1122px;
        height: 1402px;
        /* Blanco hueso MEDIDO: rgb(248,245,242) de media en las diez muestras
           de fondo. Esta lámina no es sobre negro como sus hermanas — copiar
           el #000 de u02 acá sería pintar el papel del color de la noche. */
        background: #f8f5f2;
        color: #4a4744;
        overflow: hidden;
        transform-origin: 0 0;
        font-family: "JetBrains Mono", ui-monospace, monospace;
      }
      .lam [data-bloque] { position: absolute; }
    </style>

    <script>
      /* `100vw / 1122` en CSS da una LONGITUD y `scale()` quiere un NÚMERO. */
      const lam = document.querySelector(".lam");
      const ajustar = () => {
        const k = Math.min(innerWidth / 1122, innerHeight / 1402);
        lam.style.transform = `scale(${k})`;
        document.body.style.height = `${1402 * k}px`;
      };
      ajustar();
      addEventListener("resize", ajustar, { passive: true });
    </script>
  </body>
</html>
