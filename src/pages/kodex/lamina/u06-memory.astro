---
/**
 * KODEX-∞ · UNIVERSE PAGE 06 · MEMORY
 *
 * Reproducción en código de `reference/canon/u06-memory.png` (1122×1402).
 *
 * La lámina de la ARQUEOLOGÍA TEMPORAL: la pila estratificada de seis capas
 * translúcidas (héroe procedural en canvas, con su núcleo espiral vivo), los
 * paneles STRATIFIED MEMORY STACK / EROSION OVER TIME / MEMORY TRACE /
 * VERSION INDEX, la banda RE-ENTRY con K → K', la línea de tiempo E0-E6 y la
 * fila SEDIMENTED SIGNALS / FIELD EXCAVATION PROTOCOL / EROSION LAW.
 *
 * FONDO NEGRO PURO, medido: doce muestras dan rgb(0,0,0)..rgb(1,1,1). No es
 * el blanco hueso de u03.
 */
import "../../../styles/kodex-lamina.css";
import Cabecera from "../../../components/kodex/lamina/u06/Cabecera.astro";
import Estratos from "../../../components/kodex/lamina/u06/Estratos.astro";
import Paneles from "../../../components/kodex/lamina/u06/Paneles.astro";
import Bandas from "../../../components/kodex/lamina/u06/Bandas.astro";
import Sedimentos from "../../../components/kodex/lamina/u06/Sedimentos.astro";
import Pie from "../../../components/kodex/lamina/u06/Pie.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · MEMORY · PAGE 06</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="u06-memory">
      <Cabecera />
      <Estratos />
      <Paneles />
      <Bandas />
      <Sedimentos />
      <Pie />
    </div>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1122px;
        height: 1402px;
        background: #000;
        color: #d8d4d0;
        overflow: hidden;
        transform-origin: 0 0;
        font-family: "JetBrains Mono", ui-monospace, monospace;
      }
      .lam [data-bloque] { position: absolute; }
    </style>

    <script>
      /* `100vw / 1122` en CSS da una LONGITUD y `scale()` quiere un NÚMERO. */
      const lam = document.querySelector(".lam");
      const ajustar = () => {
        const k = Math.min(innerWidth / 1122, innerHeight / 1402);
        lam.style.transform = `scale(${k})`;
        document.body.style.height = `${1402 * k}px`;
      };
      ajustar();
      addEventListener("resize", ajustar, { passive: true });
    </script>
  </body>
</html>
