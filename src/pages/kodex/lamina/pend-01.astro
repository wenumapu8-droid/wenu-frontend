---
/**
 * KODEX-∞ · PEND-01 · banner del árbol dorado
 *
 * Reproducción en código de `reference/pendientes/pend-01.png` (1731×909,
 * apaisada — medida con sharp, no supuesta). La plancha sólo lleva el
 * cabezal del códice ("KODEX-∞") y un lema; no se nombra con un título
 * propio, así que el slug queda pend-01 — los nombres no se inventan.
 *
 * TEXTO TRANSCRITO con zoom de recortes (todo legible):
 *   · título:  KODEX-∞
 *   · lema:    THE ARCHIVE DOES NOT STORE. IT REMEMBERS.
 * No hay más texto en la plancha; el resto son símbolos (estrella de ocho
 * puntas, lunas crecientes, aros con punto, aro-cruz) que van como marcas
 * no-textuales.
 *
 * MEDIDO de la referencia:
 *   · fondo rgb(2,2,1); oro alto rgb(228,195,131), oro medio rgb(158,121,71),
 *     oro bajo rgb(80,55,29) — muestreo por bandas de luminancia;
 *   · eje del árbol x=866; centro de anillos (866,447); anillo mayor r≈296;
 *   · copa: y 190..470, medio ancho máx ~295 (y≈360..430);
 *   · tronco brillante x 785..955 arriba, angosto (~860..875) en y≈520;
 *   · nudo ∞: caja brillante x 770..950, y 440..540, centro (865,492);
 *   · raíces: y 530..758, extensión x 640..1095;
 *   · símbolos del eje horizontal (y≈450): estrella (32), aro-punto (258),
 *     luna (332) — espejados a la derecha (1386, 1466, 1701);
 *   · receta pend-01.json: 47 glifos y 11 marcas EN SUS COORDENADAS.
 */
import "../../../styles/kodex-lamina.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KODEX−∞ · PEND-01</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="kdx-lam">
    <div class="lam" data-lam="pend-01">
      <canvas id="p1-fondo" width="1731" height="909" style="position:absolute;inset:0;"></canvas>
      <canvas id="p1-vivo" width="1731" height="909" style="position:absolute;inset:0;"></canvas>

      <svg viewBox="0 0 1731 909" style="position:absolute;inset:0;" aria-hidden="true">
        <!-- ── marco doble ─────────────────────────────────────────────── -->
        <rect x="36" y="32" width="1659" height="845" class="p-marco" />
        <rect x="56" y="52" width="1619" height="805" class="p-marco-fino" />
        <!-- esquinas: aro pequeño y muescas -->
        {[[46, 42], [1685, 42], [46, 867], [1685, 867]].map(([x, y]) => (
          <circle cx={x} cy={y} r="5" class="p-marco-fino" />
        ))}
        {[[120, 32], [1611, 32], [120, 877], [1611, 877]].map(([x, y]) => (
          <g class="p-marco-fino">
            <line x1={x - 26} y1={y} x2={x - 8} y2={y} />
            <circle cx={x} cy={y} r="2" />
            <line x1={x + 8} y1={y} x2={x + 26} y2={y} />
          </g>
        ))}
        <!-- puntitos triples cerca de las esquinas -->
        {[[190, 62], [1541, 62], [190, 847], [1541, 847]].map(([x, y]) => (
          <g class="p-pto-g">
            <circle cx={x - 10} cy={y} r="1.4" />
            <circle cx={x} cy={y} r="1.4" />
            <circle cx={x + 10} cy={y} r="1.4" />
          </g>
        ))}

        <!-- ── glifo sobre el título (aro con tallo) ───────────────────── -->
        <circle cx="866" cy="26" r="7" class="p-simbolo" />
        <line x1="866" y1="33" x2="866" y2="52" class="p-simbolo" opacity=".7" />

        <!-- ── título transcrito ───────────────────────────────────────── -->
        <text x="862" y="92" class="p-titulo" text-anchor="middle" textLength="196">KODEX-∞</text>
        <g class="p-adorno">
          <line x1="622" y1="83" x2="688" y2="83" />
          <circle cx="704" cy="83" r="1.8" />
          <line x1="716" y1="83" x2="732" y2="83" />
          <circle cx="744" cy="83" r="1.4" />
          <circle cx="984" cy="83" r="1.4" />
          <line x1="996" y1="83" x2="1012" y2="83" />
          <circle cx="1024" cy="83" r="1.8" />
          <line x1="1040" y1="83" x2="1106" y2="83" />
        </g>

        <!-- ── eje horizontal punteado ─────────────────────────────────── -->
        <line x1="62" y1="450" x2="556" y2="450" class="p-eje" />
        <line x1="1176" y1="450" x2="1668" y2="450" class="p-eje" />
        <!-- eje vertical tenue -->
        <line x1="866" y1="56" x2="866" y2="140" class="p-eje" opacity=".5" />
        <line x1="866" y1="756" x2="866" y2="822" class="p-eje" opacity=".5" />

        <!-- ── símbolos del eje: izquierda ─────────────────────────────── -->
        <!-- estrella de ocho puntas -->
        <g class="p-simbolo-v" transform="translate(32,452)">
          <line x1="0" y1="-56" x2="0" y2="56" />
          <line x1="-30" y1="0" x2="30" y2="0" />
          <line x1="-14" y1="-14" x2="14" y2="14" />
          <line x1="-14" y1="14" x2="14" y2="-14" />
          <circle cx="0" cy="0" r="5" />
          <circle cx="0" cy="0" r="10" opacity=".6" />
        </g>
        <!-- aro con punto -->
        <g class="p-simbolo" transform="translate(258,449)">
          <circle cx="0" cy="0" r="9" />
          <circle cx="0" cy="0" r="2.4" class="p-lleno" />
        </g>
        <!-- luna creciente (abre a la derecha) -->
        <g class="p-simbolo-v" transform="translate(333,449)">
          <path d="M6 -16 A17 17 0 1 0 6 16 A13.5 13.5 0 1 1 6 -16 Z" />
        </g>

        <!-- ── símbolos del eje: derecha (espejo) ──────────────────────── -->
        <g class="p-simbolo-v" transform="translate(1390,449) scale(-1,1)">
          <path d="M6 -16 A17 17 0 1 0 6 16 A13.5 13.5 0 1 1 6 -16 Z" />
        </g>
        <g class="p-simbolo" transform="translate(1470,449)">
          <circle cx="0" cy="0" r="9" />
          <circle cx="0" cy="0" r="2.4" class="p-lleno" />
        </g>
        <g class="p-simbolo-v" transform="translate(1700,452)">
          <line x1="0" y1="-56" x2="0" y2="56" />
          <line x1="-30" y1="0" x2="30" y2="0" />
          <line x1="-14" y1="-14" x2="14" y2="14" />
          <line x1="-14" y1="14" x2="14" y2="-14" />
          <circle cx="0" cy="0" r="5" />
          <circle cx="0" cy="0" r="10" opacity=".6" />
        </g>

        <!-- ── cardinales del anillo mayor ─────────────────────────────── -->
        <g class="p-simbolo" transform="translate(866,155)">
          <circle cx="0" cy="0" r="11" />
          <line x1="0" y1="-11" x2="0" y2="11" />
          <line x1="-11" y1="0" x2="11" y2="0" />
        </g>
        <g class="p-simbolo" transform="translate(866,743)">
          <circle cx="0" cy="0" r="9" />
          <circle cx="0" cy="0" r="2.2" class="p-lleno" />
        </g>
        <g class="p-simbolo" transform="translate(572,447)">
          <circle cx="0" cy="0" r="10" />
          <circle cx="0" cy="0" r="5" opacity=".7" />
          <circle cx="0" cy="0" r="1.8" class="p-lleno" />
        </g>
        <g class="p-simbolo" transform="translate(1160,447)">
          <circle cx="0" cy="0" r="10" />
          <circle cx="0" cy="0" r="5" opacity=".7" />
          <circle cx="0" cy="0" r="1.8" class="p-lleno" />
        </g>

        <!-- ── lema transcrito ─────────────────────────────────────────── -->
        <text x="871" y="806" class="p-lema" text-anchor="middle" textLength="668">THE ARCHIVE DOES NOT STORE. IT REMEMBERS.</text>
        <g class="p-adorno">
          <line x1="437" y1="800" x2="516" y2="800" />
          <circle cx="528" cy="800" r="1.8" />
          <circle cx="1218" cy="800" r="1.8" />
          <line x1="1230" y1="800" x2="1308" y2="800" />
        </g>
        <!-- aro-cruz bajo el lema -->
        <g class="p-simbolo" transform="translate(866,836)">
          <circle cx="0" cy="0" r="9" />
          <line x1="-16" y1="0" x2="-9" y2="0" />
          <line x1="9" y1="0" x2="16" y2="0" />
          <line x1="0" y1="-14" x2="0" y2="-9" />
          <line x1="0" y1="9" x2="0" y2="14" />
        </g>
      </svg>
    </div>

    <style is:global>
      html, body { margin: 0; background: #000; }
      .lam {
        position: relative;
        width: 1731px; height: 909px;
        background: #020201;
        transform-origin: 0 0;
        font-family: var(--lam-mono);
      }
      .p-titulo { fill: #e3c98f; font-family: var(--lam-mono); font-size: 31px; font-weight: 600; letter-spacing: .3em; }
      .p-lema { fill: #d9b877; font-family: var(--lam-mono); font-size: 16px; letter-spacing: .3em; }
      .p-adorno { stroke: #8a6a3a; stroke-width: 1.1; fill: #8a6a3a; }
      .p-adorno line { fill: none; }
      .p-marco { fill: none; stroke: #6b5330; stroke-width: 1.2; }
      .p-marco-fino { fill: none; stroke: #503d22; stroke-width: .9; }
      .p-eje { stroke: #6b5330; stroke-width: 1; stroke-dasharray: 2 6; fill: none; }
      .p-simbolo { fill: none; stroke: #a5824a; stroke-width: 1.2; }
      .p-simbolo-v { fill: none; stroke: #c9a35e; stroke-width: 1.3; }
      .p-lleno { fill: #d9b877; stroke: none; }
      .p-pto-g circle { fill: #6b5330; stroke: none; }
    </style>

    <script>
      import { montarLienzo, tinta } from "../../../components/kodex/lamina/kit/lienzo";
      import { montarEscala } from "../../../components/kodex/lamina/kit/escala";
      import { montarMovil } from "../../../components/kodex/lamina/kit/movil";
      import { rng } from "../../../components/kodex/lamina/kit/rng";
      import receta from "../../../../scripts/lamina/campo/pend-01.json";

      const fondo = document.getElementById("p1-fondo") as HTMLCanvasElement;
      const vivo = document.getElementById("p1-vivo") as HTMLCanvasElement;
      const raiz = document.querySelector("[data-lam]") as HTMLElement;
      const gf = fondo.getContext("2d")!;
      const gv = vivo.getContext("2d")!;

      /* Medidas de la referencia. */
      const CX = 866;          // eje del árbol
      const CY = 447;          // centro de anillos
      const KX = 865, KY = 492; // centro del nudo ∞
      const rnd = rng(0x1731);

      /* Oros muestreados. */
      const ORO_HI = "228,195,131";
      const ORO_MED = "158,121,71";
      const ORO_BAJO = "80,55,29";
      const ORO_LUZ = "245,232,190";

      /* Glifos y marcas de la receta, en sus coordenadas. */
      const glifos: Array<[number, number, number]> = [];
      for (let i = 0; i < receta.glifos.length; i += 3) {
        glifos.push([receta.glifos[i], receta.glifos[i + 1], receta.glifos[i + 2]]);
      }
      const marcas: Array<[number, number, number, number]> = [];
      for (let i = 0; i < receta.marcas.length; i += 4) {
        marcas.push([receta.marcas[i], receta.marcas[i + 1], receta.marcas[i + 2], receta.marcas[i + 3]]);
      }

      /* Lemniscata del nudo (Bernoulli, achatada a las medidas: 172×72). */
      const A = 86;
      const lemni = (t: number): [number, number] => {
        const d = 1 + Math.sin(t) * Math.sin(t);
        return [KX + (A * Math.cos(t)) / d, KY + (A * 1.08 * Math.sin(t) * Math.cos(t)) / d];
      };

      /* Polvo de estrellas, fijo. */
      const polvo = Array.from({ length: 720 }, () => ({
        x: 40 + rnd() * 1651, y: 36 + rnd() * 838,
        r: rnd() < 0.88 ? 0.6 : 1.3, o: 0.08 + rnd() * 0.4,
      }));

      /* ── árbol procedural: ramas recursivas deterministas ──────────────
         La copa vive dentro del anillo mayor: se recorta contra r≈282
         alrededor de (866,400). */
      type Rama = { x0: number; y0: number; x1: number; y1: number; xc: number; yc: number; lw: number; prof: number };
      type Hoja = { x: number; y: number; a: number; s: number };
      const ramas: Rama[] = [];
      const hojas: Hoja[] = [];
      /* La copa es una ELIPSE (866,368) rx 255 ry 188: el follaje de la
         referencia queda a ±250 del eje, adentro del anillo, y el
         lateral no baja de y≈556. */
      const dentroCopa = (x: number, y: number) => {
        const dx = (x - CX) / 255, dy = (y - 368) / 188;
        return dx * dx + dy * dy < 1 && y > 178;
      };
      const rama = (x: number, y: number, ang: number, len: number, lw: number, prof: number) => {
        if (prof <= 0 || len < 8) return;
        const x1 = x + Math.cos(ang) * len;
        const y1 = y + Math.sin(ang) * len;
        if (!dentroCopa(x1, y1)) {
          if (len > 22) { rama(x, y, ang, len * 0.5, lw, prof); }
          return;
        }
        const curva = (rnd() - 0.5) * 0.5;
        const xc = x + Math.cos(ang + curva) * len * 0.55;
        const yc = y + Math.sin(ang + curva) * len * 0.55;
        ramas.push({ x0: x, y0: y, x1, y1, xc, yc, lw, prof });
        if (prof <= 3) {
          /* hojas gordas en el tramo final y en la punta; también
             adentro de la copa, no sólo en la cáscara */
          const nh = prof <= 2 ? 1 : rnd() < 0.35 ? 1 : 0;
          for (let k = 0; k <= nh; k++) {
            if (rnd() < 0.3) continue;                       // aire entre hojas
            const f = 0.55 + 0.45 * (k / Math.max(1, nh));
            hojas.push({
              x: x + (x1 - x) * f + (rnd() - 0.5) * 7,
              y: y + (y1 - y) * f + (rnd() - 0.5) * 7,
              a: ang + (rnd() - 0.5) * 1.6,
              s: 0.85 + rnd() * 0.5,
            });
          }
        }
        const nh = prof > 4 ? 3 : 2;
        for (let k = 0; k < nh; k++) {
          const abre = (k - (nh - 1) / 2) * (0.42 + rnd() * 0.2) + (rnd() - 0.5) * 0.22;
          /* candelabro: las puntas se enroscan hacia arriba */
          const hija = (ang + abre) * 0.86 + -Math.PI / 2 * 0.14;
          rama(x1, y1, hija, len * (0.6 + rnd() * 0.14), Math.max(0.7, lw * 0.66), prof - 1);
        }
      };
      /* tronco: fan de miembros desde la boca superior del nudo */
      rama(CX, 452, -Math.PI / 2, 96, 9, 7);                 // líder central
      rama(CX - 6, 458, -Math.PI / 2 - 0.55, 88, 7.5, 6);    // miembros medios
      rama(CX + 6, 458, -Math.PI / 2 + 0.55, 88, 7.5, 6);
      rama(CX - 10, 466, -Math.PI / 2 - 0.95, 80, 6, 6);     // miembros bajos
      rama(CX + 10, 466, -Math.PI / 2 + 0.95, 80, 6, 6);
      rama(CX - 12, 474, -Math.PI - 0.35, 62, 5, 5);         // brazos casi horizontales
      rama(CX + 12, 474, 0.35, 62, 5, 5);

      /* ── raíces: trenzadas hacia abajo desde el nudo ─────────────────── */
      type Trazo = { pts: Array<[number, number]>; lw: number; o: number };
      const trazosRaiz: Trazo[] = [];
      const raizRec = (x: number, y: number, ang: number, len: number, lw: number, prof: number) => {
        if (prof <= 0 || len < 6) return;
        const pts: Array<[number, number]> = [[x, y]];
        let cx = x, cy = y, a = ang;
        const seg = 4;
        const onda = rnd() * Math.PI * 2;                    // fase propia: curva en S
        for (let k = 0; k < seg; k++) {
          a += (rnd() - 0.5) * 0.55 + Math.sin(onda + k * 1.9) * 0.3;
          a = a * 0.95 + (Math.PI / 2) * 0.05;               // gravedad apenas
          /* siempre hacia abajo, nunca de vuelta arriba */
          if (Math.sin(a) < 0.06) a = a > Math.PI / 2 ? Math.PI - Math.asin(0.06) : Math.asin(0.06);
          cx += Math.cos(a) * (len / seg);
          cy += Math.sin(a) * (len / seg);
          if (cy > 752 || Math.abs(cx - CX) > 236) return;   // fuera del abanico: la raíz muere
          pts.push([cx, cy]);
        }
        trazosRaiz.push({ pts, lw, o: 0.55 + 0.4 * (prof / 7) });
        const nh = prof > 2 ? 2 : rnd() < 0.6 ? 2 : 1;
        for (let k = 0; k < nh; k++) {
          const abre = (k - (nh - 1) / 2) * (0.6 + rnd() * 0.4) + (rnd() - 0.5) * 0.25;
          raizRec(cx, cy, a + abre, len * (0.64 + rnd() * 0.12), Math.max(0.5, lw * 0.68), prof - 1);
        }
      };
      /* nacen del vientre del nudo en falda (~120 px) y caen como garra:
         las exteriores arrancan casi horizontales y la gravedad las
         dobla; denso al centro, colas finas hacia los lados */
      for (let i = 0; i < 13; i++) {
        const f = i / 12;
        const ang = Math.PI / 2 + (f - 0.5) * 2.2;
        const x0 = KX + (f - 0.5) * 120;
        const y0 = 522 - Math.abs(f - 0.5) * 24;
        raizRec(x0, y0, ang, 64 + rnd() * 26, 4, 6);
      }

      const pintarFondo = () => {
        gf.clearRect(0, 0, 1731, 909);

        /* polvo */
        for (const p of polvo) {
          gf.fillStyle = tinta(ORO_HI, p.o * 0.5);
          gf.beginPath(); gf.arc(p.x, p.y, p.r, 0, Math.PI * 2); gf.fill();
        }

        /* halo cálido tras la copa */
        const halo = gf.createRadialGradient(CX, 400, 30, CX, 400, 280);
        halo.addColorStop(0, tinta(ORO_BAJO, 0.14));
        halo.addColorStop(1, tinta(ORO_BAJO, 0));
        gf.fillStyle = halo;
        gf.beginPath(); gf.arc(CX, 400, 280, 0, Math.PI * 2); gf.fill();

        /* ── anillos concéntricos (866,447) ─────────────────────────── */
        const anillos: Array<[number, number, number[] | null]> = [
          [296, 0.5, null],
          [258, 0.1, [1, 6]],
          [272, 0.1, [1, 6]],
          [310, 0.3, [2, 5]],
          [322, 0.16, [1, 7]],
          [340, 0.22, [2, 6]],
          [356, 0.12, [1, 7]],
          [370, 0.2, [2, 8]],
        ];
        for (const [r, o, dash] of anillos) {
          gf.strokeStyle = tinta(ORO_MED, o);
          gf.lineWidth = r === 296 ? 1.2 : 0.9;
          if (dash) gf.setLineDash(dash); else gf.setLineDash([]);
          gf.beginPath(); gf.arc(CX, CY, r, 0, Math.PI * 2); gf.stroke();
        }
        gf.setLineDash([]);
        /* 60 marcas radiales entre los anillos exteriores */
        for (let k = 0; k < 60; k++) {
          const a = (k / 60) * Math.PI * 2;
          gf.strokeStyle = tinta(ORO_MED, k % 5 === 0 ? 0.3 : 0.12);
          gf.lineWidth = 0.8;
          gf.beginPath();
          gf.moveTo(CX + Math.cos(a) * 348, CY + Math.sin(a) * 348);
          gf.lineTo(CX + Math.cos(a) * (k % 5 === 0 ? 370 : 360), CY + Math.sin(a) * (k % 5 === 0 ? 370 : 360));
          gf.stroke();
        }
        /* diagonales tenues a 45° */
        gf.setLineDash([1.5, 7]);
        for (const a of [Math.PI / 4, (3 * Math.PI) / 4, (5 * Math.PI) / 4, (7 * Math.PI) / 4]) {
          gf.strokeStyle = tinta(ORO_MED, 0.14);
          gf.lineWidth = 0.8;
          gf.beginPath();
          gf.moveTo(CX + Math.cos(a) * 120, CY + Math.sin(a) * 120);
          gf.lineTo(CX + Math.cos(a) * 368, CY + Math.sin(a) * 368);
          gf.stroke();
        }
        gf.setLineDash([]);
        /* puntos sobre el anillo r=310 */
        for (let k = 0; k < 36; k++) {
          const a = (k / 36) * Math.PI * 2;
          gf.fillStyle = tinta(ORO_HI, 0.35);
          gf.beginPath();
          gf.arc(CX + Math.cos(a) * 310, CY + Math.sin(a) * 310, 1.2, 0, Math.PI * 2);
          gf.fill();
        }

        /* arcos grandes tenues alrededor de cada estrella del borde */
        gf.setLineDash([1.5, 6]);
        for (const ex of [32, 1700]) {
          for (const r of [170, 300, 430]) {
            gf.strokeStyle = tinta(ORO_MED, 0.14);
            gf.lineWidth = 0.8;
            gf.beginPath(); gf.arc(ex, 452, r, 0, Math.PI * 2); gf.stroke();
          }
        }
        gf.setLineDash([]);

        /* ── raíces (debajo del nudo): metálicas, con borde oscuro ──── */
        gf.lineCap = "round";
        const trazoDe = (t: Trazo) => {
          gf.beginPath();
          gf.moveTo(t.pts[0][0], t.pts[0][1]);
          for (let i = 1; i < t.pts.length; i++) gf.lineTo(t.pts[i][0], t.pts[i][1]);
          gf.stroke();
        };
        /* sombra que recorta del fondo */
        for (const t of trazosRaiz) {
          if (t.lw < 1.6) continue;
          gf.strokeStyle = tinta(ORO_BAJO, 0.8);
          gf.lineWidth = t.lw + 1.6;
          trazoDe(t);
        }
        /* cuerpo */
        for (const t of trazosRaiz) {
          gf.strokeStyle = tinta(t.lw > 1.2 ? ORO_MED : ORO_BAJO, Math.min(1, t.o + 0.15));
          gf.lineWidth = t.lw;
          trazoDe(t);
        }
        /* lomo de luz sobre las raíces gruesas */
        for (const t of trazosRaiz) {
          if (t.lw < 1.8) continue;
          gf.strokeStyle = tinta(ORO_HI, 0.55);
          gf.lineWidth = t.lw * 0.42;
          trazoDe(t);
        }

        /* ── ramas ──────────────────────────────────────────────────── */
        for (const r of ramas) {
          gf.strokeStyle = tinta(r.lw > 2.5 ? ORO_MED : ORO_BAJO, 0.55 + Math.min(0.35, r.lw * 0.06));
          gf.lineWidth = r.lw;
          gf.lineCap = "round";
          gf.beginPath();
          gf.moveTo(r.x0, r.y0);
          gf.quadraticCurveTo(r.xc, r.yc, r.x1, r.y1);
          gf.stroke();
          if (r.lw > 2.2) {
            gf.strokeStyle = tinta(ORO_HI, 0.4);
            gf.lineWidth = r.lw * 0.38;
            gf.beginPath();
            gf.moveTo(r.x0, r.y0);
            gf.quadraticCurveTo(r.xc, r.yc, r.x1, r.y1);
            gf.stroke();
          }
        }

        /* ── hojas: almendras con vena ──────────────────────────────── */
        for (const h of hojas) {
          gf.save();
          gf.translate(h.x, h.y);
          gf.rotate(h.a);
          const L = 13 * h.s, W2 = 4.8 * h.s;
          const grad = gf.createLinearGradient(0, 0, L, 0);
          grad.addColorStop(0, tinta(ORO_BAJO, 0.85));
          grad.addColorStop(0.55, tinta(ORO_MED, 0.85));
          grad.addColorStop(1, tinta(ORO_HI, 0.8));
          gf.fillStyle = grad;
          gf.beginPath();
          gf.moveTo(0, 0);
          gf.quadraticCurveTo(L * 0.5, -W2, L, 0);
          gf.quadraticCurveTo(L * 0.5, W2, 0, 0);
          gf.fill();
          gf.strokeStyle = tinta("40,26,12", 0.7);           // rima oscura: relieve
          gf.lineWidth = 0.7;
          gf.stroke();
          gf.strokeStyle = tinta(ORO_HI, 0.6);
          gf.lineWidth = 0.6;
          gf.beginPath(); gf.moveTo(L * 0.12, 0); gf.lineTo(L * 0.88, 0); gf.stroke();
          gf.restore();
        }

        /* ── tronco tejido (encima de raíces y base de ramas) ────────
           En la referencia el tronco es una columna GRUESA de hebras
           trenzadas (~44 px en la base) que baja hasta fundirse con el
           nudo. Hebras claras y oscuras alternadas + borde oscuro. */
        gf.lineCap = "round";
        for (let s = 0; s < 11; s++) {
          const off = (s - 5) * 4.2;
          const borde = s === 0 || s === 10;
          /* cada hebra muere a su altura: el tronco se afina hacia el
             fan de miembros en vez de cortarse en peine */
          const tope = 424 + Math.abs(s - 5) * 7;
          gf.strokeStyle = borde
            ? tinta(ORO_BAJO, 0.9)
            : s % 2 ? tinta(ORO_MED, 0.9) : tinta(ORO_HI, 0.65);
          gf.lineWidth = borde ? 2 : 3.2;
          gf.beginPath();
          for (let y = 540; y >= tope; y -= 6) {
            const f = (540 - y) / 116;
            const ancho = 1 - f * 0.42;
            const x = CX + off * ancho + Math.sin(y * 0.085 + s * 1.7) * 3.2;
            if (y === 540) gf.moveTo(x, y); else gf.lineTo(x, y);
          }
          gf.stroke();
        }
        /* lomo de luz del tronco */
        gf.strokeStyle = tinta(ORO_LUZ, 0.55);
        gf.lineWidth = 2.4;
        gf.beginPath();
        for (let y = 536; y >= 428; y -= 6) {
          const x = CX - 4 + Math.sin(y * 0.085) * 3.2;
          if (y === 536) gf.moveTo(x, y); else gf.lineTo(x, y);
        }
        gf.stroke();

        /* ── nudo ∞ trenzado (lo más brillante de la plancha) ─────────
           Banda sólida ~26 px: hebras interiores gruesas alternadas,
           bordes oscuros que la recortan del fondo, y especular. */
        const paso = 0.02;
        const hebra = (d: number, color: string, lw: number) => {
          gf.strokeStyle = color;
          gf.lineWidth = lw;
          gf.beginPath();
          let primero = true;
          for (let t = 0; t <= Math.PI * 2 + paso; t += paso) {
            const [x, y] = lemni(t);
            const [x2, y2] = lemni(t + paso);
            const nx = -(y2 - y), ny = x2 - x;
            const nl = Math.hypot(nx, ny) || 1;
            const px = x + (nx / nl) * d;
            const py = y + (ny / nl) * d;
            if (primero) { gf.moveTo(px, py); primero = false; } else gf.lineTo(px, py);
          }
          gf.stroke();
        };
        /* banda sólida: contorno oscuro → cuerpo medio → lomo claro */
        hebra(0, tinta(ORO_BAJO, 0.95), 27);
        hebra(0, tinta(ORO_MED, 0.98), 22);
        hebra(0, tinta(ORO_HI, 0.75), 12);
        hebra(-3, tinta(ORO_LUZ, 0.35), 4);
        /* grabado: vetas finas que siguen la banda */
        hebra(-8, tinta(ORO_BAJO, 0.5), 1.1);
        hebra(-4, tinta(ORO_BAJO, 0.35), 1);
        hebra(4, tinta(ORO_BAJO, 0.45), 1.1);
        hebra(8, tinta(ORO_BAJO, 0.55), 1.2);
        /* trenza: sombras diagonales tenues que cruzan la banda */
        gf.strokeStyle = tinta(ORO_BAJO, 0.35);
        gf.lineWidth = 1.4;
        for (let t = 0; t < Math.PI * 2; t += 0.2) {
          const [x, y] = lemni(t);
          const [x2, y2] = lemni(t + paso);
          const nx = -(y2 - y), ny = x2 - x;
          const nl = Math.hypot(nx, ny) || 1;
          gf.beginPath();
          gf.moveTo(x - (nx / nl) * 10 + 2.5, y - (ny / nl) * 10);
          gf.lineTo(x + (nx / nl) * 10 - 2.5, y + (ny / nl) * 10);
          gf.stroke();
        }
        /* el cruce teje: el ramal que sube a la derecha pasa ENCIMA */
        gf.save();
        gf.beginPath();
        gf.rect(KX - 30, KY - 32, 60, 64);
        gf.clip();
        gf.lineCap = "round";
        gf.strokeStyle = tinta(ORO_BAJO, 0.95);
        gf.lineWidth = 27;
        gf.beginPath(); gf.moveTo(KX - 26, KY + 24); gf.lineTo(KX + 26, KY - 24); gf.stroke();
        gf.strokeStyle = tinta(ORO_MED, 0.98);
        gf.lineWidth = 22;
        gf.beginPath(); gf.moveTo(KX - 26, KY + 24); gf.lineTo(KX + 26, KY - 24); gf.stroke();
        gf.strokeStyle = tinta(ORO_HI, 0.7);
        gf.lineWidth = 12;
        gf.beginPath(); gf.moveTo(KX - 26, KY + 24); gf.lineTo(KX + 26, KY - 24); gf.stroke();
        /* grabado también sobre el ramal que cruza */
        gf.strokeStyle = tinta(ORO_BAJO, 0.4);
        gf.lineWidth = 1.3;
        for (let d = -18; d <= 18; d += 6) {
          gf.beginPath();
          gf.moveTo(KX - 10 + d, KY + 14 + d * 0.9);
          gf.lineTo(KX + 10 + d, KY - 14 + d * 0.9);
          gf.stroke();
        }
        gf.restore();
        /* luz especular en los lomos superiores del nudo */
        gf.strokeStyle = tinta(ORO_LUZ, 0.85);
        gf.lineWidth = 2.6;
        for (const [t0, t1] of [[Math.PI * 0.62, Math.PI * 0.95], [Math.PI * 1.55, Math.PI * 1.9]]) {
          gf.beginPath();
          let primero = true;
          for (let t = t0; t <= t1; t += paso) {
            const [x, y] = lemni(t);
            if (primero) { gf.moveTo(x, y - 4); primero = false; } else gf.lineTo(x, y - 4);
          }
          gf.stroke();
        }

        /* ── glifos de la receta: densidades de follaje, donde están ── */
        for (const [x, y, s] of glifos) {
          const r = Math.max(4, s * 0.55);
          const g2 = gf.createRadialGradient(x, y, 0, x, y, r);
          g2.addColorStop(0, tinta(ORO_HI, 0.3));
          g2.addColorStop(1, tinta(ORO_HI, 0));
          gf.fillStyle = g2;
          gf.beginPath(); gf.arc(x, y, r, 0, Math.PI * 2); gf.fill();
          gf.fillStyle = tinta(ORO_LUZ, 0.5);
          gf.beginPath(); gf.arc(x, y, 1.1, 0, Math.PI * 2); gf.fill();
        }
        /* marcas alargadas: vetas de luz en su caja */
        for (const [x, y, w, h] of marcas) {
          const a = w >= h ? 0 : Math.PI / 2;
          const largo = Math.max(w, h), grueso = Math.min(w, h);
          const n = Math.max(2, Math.round(largo / 14));
          for (let k = 0; k < n; k++) {
            const dd = (k / Math.max(1, n - 1) - 0.5) * grueso;
            gf.strokeStyle = tinta(ORO_HI, 0.12 + rnd() * 0.1);
            gf.lineWidth = 0.7;
            gf.beginPath();
            gf.moveTo(x - Math.cos(a) * largo * 0.45 + Math.sin(a) * dd, y - Math.sin(a) * largo * 0.45 + Math.cos(a) * dd);
            gf.lineTo(x + Math.cos(a) * largo * 0.45 + Math.sin(a) * dd, y + Math.sin(a) * largo * 0.45 + Math.cos(a) * dd);
            gf.stroke();
          }
        }
      };

      /* ── vida: fulgor fase-continuo ──────────────────────────────────
         Un destello recorre el nudo ∞ (cierra sin costura: fase completa
         = una vuelta de la lemniscata) y las hojas titilan en cosenos
         enteros de la fase. */
      const chispas = glifos.filter((_, i) => i % 2 === 0);
      const pintarVivo = (fase: number) => {
        gv.clearRect(0, 0, 1731, 909);

        /* destello viajero sobre el nudo */
        const t0 = fase * Math.PI * 2;
        for (let k = 0; k < 16; k++) {
          const t = t0 - k * 0.045;
          const [x, y] = lemni(t);
          const o = (1 - k / 16) * 0.55;
          const r = 7 - k * 0.32;
          const g3 = gv.createRadialGradient(x, y, 0, x, y, r * 2.4);
          g3.addColorStop(0, tinta(ORO_LUZ, o));
          g3.addColorStop(1, tinta(ORO_HI, 0));
          gv.fillStyle = g3;
          gv.beginPath(); gv.arc(x, y, r * 2.4, 0, Math.PI * 2); gv.fill();
        }

        /* titileo de follaje: cosenos de período entero — sin costura */
        chispas.forEach(([x, y], i) => {
          const b = 0.5 + 0.5 * Math.cos((fase + i / chispas.length) * Math.PI * 2 * (1 + (i % 3)));
          gv.fillStyle = tinta(ORO_LUZ, 0.12 + 0.3 * b);
          gv.beginPath(); gv.arc(x, y, 1.5 + b, 0, Math.PI * 2); gv.fill();
        });

        /* respiración del halo del nudo */
        const br = 0.05 + 0.03 * Math.cos(fase * Math.PI * 2);
        const g4 = gv.createRadialGradient(KX, KY, 0, KX, KY, 130);
        g4.addColorStop(0, tinta(ORO_HI, br));
        g4.addColorStop(1, tinta(ORO_HI, 0));
        gv.fillStyle = g4;
        gv.beginPath(); gv.arc(KX, KY, 130, 0, Math.PI * 2); gv.fill();
      };

      montarLienzo({
        raiz,
        inicial: pintarFondo,
        cuadro: pintarVivo,
        periodo: 18000,
        periodoReducido: 54000,
      });

      montarEscala();
      montarMovil();
    
      import { montarVida } from "../../../lib/kodex/vida/montar";
      montarVida({ id: "pend-01" });
    </script>

