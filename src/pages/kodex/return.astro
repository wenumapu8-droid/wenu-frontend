---
// KODEX −∞ · RETURN — the final generative sequence. When a cycle completes,
// the system uses the visitor's journey + their specimen to build an
// irrepeatable ~38s close: convergence → recognition → transmutation →
// manifestation → return → seal (the form collapses INTO the KODEX mark).
// First pass = Canvas 2D generative (mobile-safe); WebGL/shader upgrade next.
// Isolated via KodexShell. Reference language only — no copied assets.
import KodexShell from '../../layouts/KodexShell.astro';
---

<KodexShell title="KODEX −∞ · Return">
  <main class="rt" data-rt>
    <canvas class="rt-canvas" data-canvas></canvas>

    <!-- movement text — appears one line at a time, revealed by the sequence -->
    <div class="rt-text" data-text aria-live="polite"></div>

    <!-- SEAL — the mark the form collapses into (revealed only at the end) -->
    <div class="rt-seal" data-seal hidden>
      <p class="rt-seal__mark">KODEX<span>−∞</span></p>
      <p class="rt-seal__line">KODEX HAS RECORDED THE DIFFERENCE.</p>
      <p class="rt-seal__cycle" data-cycle>CYCLE 01 COMPLETE.</p>
      <div class="rt-card" data-card>
        <p class="rt-card__code" data-code>KDX-—</p>
        <p class="rt-card__st">FORM CHANGED · CORE PRESERVED · MEMORY +1</p>
        <p class="rt-card__note" data-curated hidden>CURATED RETURN</p>
      </div>
      <nav class="rt-acts">
        <a class="rt-act" href="/kodex/works/">◈ HOLD THIS SPECIMEN</a>
        <button class="rt-act" data-again>↺ BEGIN ANOTHER CYCLE</button>
        <a class="rt-act" href="/kodex/">− RETURN TO CIRCUIT</a>
        <a class="rt-act rt-act--w" href="https://wenumapuonline.com/shop">△ MANIFEST THROUGH WENU MAPU</a>
      </nav>
    </div>

    <div class="rt-ctrl" data-ctrl>
      <button class="rt-c" data-skip>SKIP →</button>
      <button class="rt-c" data-sound>♪ SOUND</button>
      <button class="rt-c" data-reduce>◐ REDUCE MOTION</button>
    </div>
  </main>

  <style>
    .rt{ position:fixed; inset:0; background:#000; overflow:hidden; color:#eef2f7;
      font-family:'JetBrains Mono',ui-monospace,monospace; }
    .rt-canvas{ position:absolute; inset:0; width:100%; height:100%; display:block; }

    .rt-text{ position:absolute; left:0; right:0; top:50%; transform:translateY(-50%); z-index:3;
      text-align:center; padding:0 24px; pointer-events:none; }
    .rt-text p{ margin:.35em 0; font-family:'Instrument Serif',serif; font-weight:400; line-height:1.15;
      font-size:clamp(1.4rem,5vw,2.6rem); letter-spacing:.01em; color:#f4f8ff;
      text-shadow:0 0 28px rgba(120,180,255,.35); opacity:0; transform:translateY(8px);
      transition:opacity 1.1s ease, transform 1.1s ease; }
    .rt-text p.on{ opacity:1; transform:none; }
    .rt-text p.mono{ font-family:'JetBrains Mono',monospace; font-size:clamp(.8rem,3.4vw,1.15rem);
      letter-spacing:.16em; color:#a6ff00; text-shadow:0 0 14px rgba(166,255,0,.4); }
    .rt-text p.small{ font-size:clamp(.72rem,3vw,1rem); letter-spacing:.22em; color:#8fb3d8; text-shadow:none; }

    .rt-seal{ position:absolute; inset:0; z-index:4; display:flex; flex-direction:column; align-items:center;
      justify-content:center; gap:14px; text-align:center; padding:40px 24px; opacity:0; transition:opacity 1.4s ease;
      background:radial-gradient(circle at 50% 46%, rgba(10,14,22,.2), #000 72%); }
    .rt-seal[data-open]{ opacity:1; }
    .rt-seal__mark{ font-family:'Instrument Serif',serif; font-size:clamp(2.4rem,9vw,4.4rem); margin:0; color:#f4f8ff;
      text-shadow:0 0 40px rgba(160,200,255,.4); }
    .rt-seal__mark span{ color:#8f8f8f; }
    .rt-seal__line{ font-size:clamp(.72rem,3vw,.95rem); letter-spacing:.22em; color:#c8d4e4; margin:6px 0 0; }
    .rt-seal__cycle{ font-size:11px; letter-spacing:.24em; color:#c9a84c; margin:0; }
    .rt-card{ margin-top:14px; border:1px solid #1c2530; padding:16px 22px; background:rgba(6,10,16,.6);
      box-shadow:0 0 30px rgba(0,240,255,.1); }
    .rt-card__code{ font-size:clamp(.85rem,3.6vw,1.15rem); letter-spacing:.14em; color:#00f0ff;
      text-shadow:0 0 12px rgba(0,240,255,.5); margin:0; }
    .rt-card__st{ font-size:9.5px; letter-spacing:.18em; color:#8fb3d8; margin:10px 0 0; }
    .rt-card__note{ font-size:9px; letter-spacing:.2em; color:#6a6a6a; margin:8px 0 0; }
    .rt-acts{ display:flex; flex-wrap:wrap; justify-content:center; gap:8px; margin-top:20px; max-width:520px; }
    .rt-act{ font-family:inherit; font-size:9.5px; letter-spacing:.16em; color:#c8d4e4; background:rgba(0,0,0,.4);
      border:1px solid #24303c; padding:11px 15px; cursor:pointer; text-decoration:none; transition:.25s; }
    .rt-act:hover{ border-color:#6fb3ff; color:#fff; box-shadow:0 0 16px rgba(111,179,255,.2); }
    .rt-act--w{ border-color:#3a2f14; color:#c9a84c; } .rt-act--w:hover{ border-color:#c9a84c; box-shadow:0 0 16px rgba(201,168,76,.2); }

    .rt-ctrl{ position:absolute; bottom:18px; right:16px; z-index:6; display:flex; gap:6px; }
    .rt-c{ font-family:inherit; font-size:8.5px; letter-spacing:.14em; color:#8fb3d8; background:rgba(0,0,0,.4);
      border:1px solid #1c2530; padding:8px 10px; cursor:pointer; transition:.25s; }
    .rt-c:hover{ color:#fff; border-color:#6fb3ff; }
    .rt-c[aria-pressed="true"]{ color:#0a0a0a; background:#6fb3ff; border-color:#6fb3ff; }

    @media (max-width:640px){ .rt-ctrl{ bottom:14px; right:12px; } .rt-acts{ gap:6px; } }
  </style>

  <script>
    import { readSpecimen, record } from '../../kodex/return/memory.js';
    const root = document.querySelector('[data-rt]');
    const cv = document.querySelector('[data-canvas]');
    const cx = cv.getContext('2d');
    const textEl = document.querySelector('[data-text]');
    const sealEl = document.querySelector('[data-seal]');
    let reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── the visitor's specimen (from the journey, or curated) ──
    const spec = readSpecimen(Date.now());
    document.querySelector('[data-code]').textContent = spec.code;
    document.querySelector('[data-cycle]').textContent = 'CYCLE ' + String(spec.cycle).padStart(2, '0') + ' COMPLETE.';
    if (spec.curated) document.querySelector('[data-curated]').hidden = false;
    record({ type: 'cycle' }); // this visit completes a cycle

    // palette — black · spectral blue · white · gold/cyan/violet as SIGNAL
    const BLUE = [111, 179, 255], WHITE = [244, 248, 255], GOLD = [201, 168, 76], CYAN = [0, 240, 255], VIO = [150, 110, 235];
    const rgba = (c, a) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;

    let W = 0, H = 0, DPR = Math.min(devicePixelRatio || 1, reduce ? 1.5 : 2), cxp = 0, cyp = 0;
    const resize = () => { W = cv.width = innerWidth * DPR; H = cv.height = innerHeight * DPR; cv.style.width = innerWidth + 'px'; cv.style.height = innerHeight + 'px'; cxp = W / 2; cyp = H / 2; };
    resize(); addEventListener('resize', resize);

    // rng from the specimen seed → reproducible
    let sd = spec.seed >>> 0; const rnd = () => { sd = (sd * 1664525 + 1013904223) >>> 0; return sd / 4294967296; };

    // particle field — born at the periphery, converge to centre, keep trails
    const NP = reduce ? 160 : (innerWidth < 640 ? 320 : 620);
    const P = [];
    for (let i = 0; i < NP; i++) { const a = rnd() * 6.2832, r = (0.55 + rnd() * 0.7) * Math.max(W, H); P.push({ a, r, r0: r, sp: 0.4 + rnd() * 1.4, sz: (0.6 + rnd() * 1.7) * DPR, tw: rnd() * 6.28 }); }

    // the visitor's last form → central mask
    const form = new Image(); form.decoding = 'async'; let formOk = false;
    form.onload = () => { formOk = true; }; form.onerror = () => {}; form.src = spec.lastWork;

    // ── timeline: 7 movements over ~38s ──
    const MV = [ [0,4],[4,9],[9,14],[14,21],[21,27],[27,34],[34,38.5] ];
    const LINES = [
      { t: 0.6, cls: 'small', s: 'RETURN PROTOCOL' },
      { t: 1.8, cls: 'small', s: 'MEMORY FOUND' },
      { t: 5.0, cls: '',      s: 'WHAT ENTERED AS NOISE' },
      { t: 10.5, cls: '',     s: 'RETURNED AS SIGNAL' },
      { t: 15.5, cls: '',     s: 'WHAT ENTERED AS SIGNAL' },
      { t: 17.2, cls: '',     s: 'RETURNED AS FORM' },
      { t: 22.5, cls: 'mono', s: spec.code },
      { t: 27.6, cls: '',     s: 'YOU DID NOT REACH THE END.' },
      { t: 29.4, cls: '',     s: 'YOU BECAME THE RETURN.' },
      { t: 31.6, cls: 'small',s: 'WHAT RETURNED AS FORM · NOW LIVES AS MEMORY' },
    ];
    // clear text at each movement boundary
    const CLEARS = [4, 9, 14, 21, 27, 34];
    let shown = 0, cleared = 0, pulses = [], sealed = false, done = false;
    const t0 = performance.now();
    let paused = false;

    const setText = (line) => {
      const p = document.createElement('p'); if (line.cls) p.className = line.cls; p.textContent = line.s;
      textEl.appendChild(p); requestAnimationFrame(() => p.classList.add('on'));
    };
    const clearText = () => { [...textEl.children].forEach((p) => { p.classList.remove('on'); setTimeout(() => p.remove(), 1100); }); };

    const pulse = (t, str) => { if (reduce) return; pulses.push({ t0: t, str }); };
    let lastPulseM = -1;

    // audio — generative return soundscape (only if the visitor chose sound)
    let actx = null, master = null, drone = [], audioOn = false;
    const buildAudio = () => {
      const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;
      actx = new AC(); master = actx.createGain(); master.gain.value = 0;
      const lim = actx.createDynamicsCompressor(); lim.threshold.value = -16; lim.ratio.value = 12;
      master.connect(lim); lim.connect(actx.destination);
      [49, 98, 147].forEach((f, k) => { const o = actx.createOscillator(); o.type = k ? 'triangle' : 'sine'; o.frequency.value = f; const g = actx.createGain(); g.gain.value = 0.05 / (k + 1); o.connect(g); g.connect(master); o.start(); drone.push(o); });
      // filtered noise bed
      const nb = actx.createBuffer(1, actx.sampleRate * 2, actx.sampleRate); const nd = nb.getChannelData(0); for (let i = 0; i < nd.length; i++) nd[i] = Math.random() * 2 - 1;
      const ns = actx.createBufferSource(); ns.buffer = nb; ns.loop = true; const nf = actx.createBiquadFilter(); nf.type = 'bandpass'; nf.frequency.value = 480; const ng = actx.createGain(); ng.gain.value = 0.02; ns.connect(nf); nf.connect(ng); ng.connect(master); ns.start();
    };
    const thump = (t) => { if (!actx) return; const o = actx.createOscillator(); o.type = 'sine'; const g = actx.createGain(); o.frequency.setValueAtTime(90, t); o.frequency.exponentialRampToValueAtTime(38, t + 0.2); g.gain.setValueAtTime(0.4, t); g.gain.exponentialRampToValueAtTime(0.001, t + 0.5); o.connect(g); g.connect(master); o.start(t); o.stop(t + 0.55); };
    const shimmer = (t) => { if (!actx) return; const base = [392, 523, 659, 784][Math.random() * 4 | 0]; const o = actx.createOscillator(); o.type = 'sine'; o.frequency.value = base * 2; const g = actx.createGain(); g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(0.03, t + 0.6); g.gain.exponentialRampToValueAtTime(0.001, t + 2.2); o.connect(g); g.connect(master); o.start(t); o.stop(t + 2.4); };
    const setSound = (v) => {
      audioOn = v; const b = document.querySelector('[data-sound]'); b.setAttribute('aria-pressed', String(v));
      if (v) { if (!actx) buildAudio(); actx.resume?.(); master.gain.setTargetAtTime(0.6, actx.currentTime, 0.8); }
      else if (actx) master.gain.setTargetAtTime(0, actx.currentTime, 0.4);
    };
    document.querySelector('[data-sound]').addEventListener('click', () => setSound(!audioOn));
    try { if (sessionStorage.getItem('kx-audio') === '1') setSound(true); } catch (e) {}

    // ── render ──
    const draw = (now) => {
      const t = Math.min(38.6, (now - t0) / 1000);
      // find movement
      let m = 0; for (let k = 0; k < MV.length; k++) if (t >= MV[k][0]) m = k;
      const mp = (t - MV[m][0]) / (MV[m][1] - MV[m][0]); // 0..1 within movement

      // trails: fade to transparent-ish black (afterimage)
      cx.globalCompositeOperation = 'source-over';
      cx.fillStyle = 'rgba(0,0,0,' + (reduce ? 0.5 : 0.14) + ')'; cx.fillRect(0, 0, W, H);
      cx.globalCompositeOperation = 'lighter';

      // convergence factor: particles pull inward from M2 on, explode in M5
      const conv = t < 4 ? 0.02 : t < 21 ? 0.35 + 0.4 * Math.min(1, (t - 4) / 17) : (t < 27 ? -0.9 : 0.5);
      const spin = (spec.chirality) * (0.15 + spec.signal * 0.3);
      const colBase = t < 21 ? WHITE : (t < 27 ? mixc(WHITE, CYAN, 0.6) : mixc(BLUE, GOLD, 0.4));

      for (const p of P) {
        p.a += 0.0016 * p.sp * spin * 60 / 60;
        p.r += (conv) * p.sp * (H * 0.0009);
        if (p.r < 6) p.r = p.r0; if (p.r > Math.max(W, H) * 0.9) p.r = Math.max(W, H) * 0.6 * (0.6 + rnd() * 0.5);
        const x = cxp + Math.cos(p.a) * p.r, y = cyp + Math.sin(p.a) * p.r * 0.86;
        const tw = 0.5 + 0.5 * Math.sin(now * 0.004 + p.tw);
        cx.beginPath(); cx.arc(x, y, p.sz * (0.6 + tw * 0.7), 0, 6.2832);
        cx.fillStyle = rgba(colBase, 0.5 * tw); cx.fill();
      }

      // instrumental geometry — concentric rings = cycles, radial meridians, toroidal scan
      if (t > 8) {
        const gI = Math.min(1, (t - 8) / 4) * (t < 34 ? 1 : Math.max(0, 1 - (t - 34) / 2));
        const rings = Math.min(9, 3 + spec.cycle);
        const baseR = Math.min(W, H) * (0.10 + 0.16 * Math.min(1, (t - 8) / 20));
        cx.lineWidth = 1 * DPR;
        for (let k = 0; k < rings; k++) {
          const rr = baseR * (1 + k * 0.42);
          cx.strokeStyle = rgba(t < 27 ? BLUE : GOLD, 0.16 * gI);
          cx.beginPath(); cx.ellipse(cxp, cyp, rr, rr * (0.62 + 0.12 * Math.sin(now * 0.0006 + k)), spin * now * 0.0002, 0, 6.2832); cx.stroke();
        }
        const merid = 12;
        for (let k = 0; k < merid; k++) { const a = k / merid * 6.2832 + spin * now * 0.0003; cx.strokeStyle = rgba(BLUE, 0.09 * gI); cx.beginPath(); cx.moveTo(cxp, cyp); cx.lineTo(cxp + Math.cos(a) * baseR * 3.4, cyp + Math.sin(a) * baseR * 3.4); cx.stroke(); }
      }

      // central form — the visitor's work, scanned, mirrored (from M3)
      if (formOk && t > 9 && t < 35) {
        const grow = t < 27 ? Math.min(1, (t - 9) / 14) : Math.max(0, 1 - (t - 27) / 8);
        const sz = Math.min(W, H) * 0.20 * grow;
        cx.globalCompositeOperation = 'source-over';
        cx.save(); cx.translate(cxp, cyp); cx.globalAlpha = 0.9 * grow;
        cx.drawImage(form, -sz, -sz, sz * 2, sz * 2);
        if (t > 14) { cx.scale(-1, 1); cx.globalAlpha = 0.45 * grow; cx.drawImage(form, -sz, -sz, sz * 2, sz * 2); } // mirror
        cx.restore(); cx.globalCompositeOperation = 'lighter';
      }

      // movement pulses (safe: max ~1 per movement, white flash)
      if (m !== lastPulseM) { lastPulseM = m; if (m === 2 || m === 3 || m === 4 || m === 6) { pulse(now, m === 6 ? 0.9 : 0.6); if (audioOn) { m === 6 ? thump(actx.currentTime) : thump(actx.currentTime); } } if (m === 4 && audioOn) shimmer(actx.currentTime); }
      pulses = pulses.filter((pl) => now - pl.t0 < 420);
      for (const pl of pulses) { const k = 1 - (now - pl.t0) / 420; cx.globalCompositeOperation = 'source-over'; cx.fillStyle = rgba(WHITE, pl.str * k * k * 0.7); cx.fillRect(0, 0, W, H); cx.globalCompositeOperation = 'lighter'; }

      // text scheduling
      while (shown < LINES.length && t >= LINES[shown].t) { setText(LINES[shown]); shown++; }
      while (cleared < CLEARS.length && t >= CLEARS[cleared]) { clearText(); cleared++; }

      // SEAL
      if (t >= 34 && !sealed) { sealed = true; clearText(); openSeal(); if (audioOn) thump(actx.currentTime); }

      if (t < 38.6 && !done && !paused) requestAnimationFrame(draw);
      else if (!done && !paused) { done = true; }
    };

    function mixc(a, b, k) { return [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k]; }
    function openSeal() { sealEl.hidden = false; requestAnimationFrame(() => sealEl.setAttribute('data-open', '')); if (audioOn) { master.gain.setTargetAtTime(0.3, actx.currentTime, 1.2); } }

    // controls
    document.querySelector('[data-skip]').addEventListener('click', () => { if (!sealed) { sealed = true; clearText(); openSeal(); } });
    document.querySelector('[data-reduce]').addEventListener('click', (e) => { reduce = !reduce; e.currentTarget.setAttribute('aria-pressed', String(reduce)); });
    document.querySelector('[data-again]').addEventListener('click', () => { record({ type: 'cycle' }); location.reload(); });
    document.addEventListener('visibilitychange', () => { paused = document.hidden; if (!paused && !done) requestAnimationFrame(draw); });

    requestAnimationFrame(draw);
  </script>
</KodexShell>
