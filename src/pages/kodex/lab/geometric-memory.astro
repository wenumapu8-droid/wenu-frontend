---
import Base from '../../../layouts/Base.astro';
---

<Base
  title="KODEX Lab — Geometric Memory Signature"
  description="Internal route-memory to geometry proof. Visited memory only."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="kdx-gmem" data-kdx-gmem>
    <header class="kdx-gmem__header">
      <div>
        <p>KODEX−∞ / NATURAL LAW P0.3</p>
        <h1>GEOMETRIC MEMORY SIGNATURE</h1>
      </div>
      <dl>
        <div><dt>TOPOLOGY</dt><dd data-topology>SEED_POINT</dd></div>
        <div><dt>SIGNATURE</dt><dd data-signature>KDX-MEM-</dd></div>
        <div><dt>DEPTH</dt><dd data-depth>0</dd></div>
        <div><dt>KNOWN</dt><dd data-known>1</dd></div>
      </dl>
    </header>

    <section class="kdx-gmem__grid">
      <article class="kdx-gmem__canvas">
        <svg data-memory-svg viewBox="0 0 1000 1000" role="img" aria-label="Geometric memory signature derived only from visited KODEX nodes">
          <g data-memory-edges></g>
          <g data-memory-nodes></g>
        </svg>
        <div class="kdx-gmem__legend">
          <span>NODE SIZE = VISITS</span>
          <span>LINES = OBSERVED TRAVERSAL</span>
          <span>RING = CURRENT NODE</span>
        </div>
      </article>

      <aside class="kdx-gmem__trace">
        <p>DERIVED FROM EXISTING MEMORY</p>
        <dl>
          <div><dt>VISITS</dt><dd data-total-visits>1</dd></div>
          <div><dt>REVISITS</dt><dd data-revisits>0</dd></div>
          <div><dt>RETURNS</dt><dd data-returns>0</dd></div>
          <div><dt>BRANCH POINTS</dt><dd data-branches>0</dd></div>
          <div><dt>FIELDS</dt><dd data-fields>1</dd></div>
          <div><dt>NATURAL PATTERN TRACE</dt><dd data-patterns>DEEP_REPRESENTATION_COMPRESSION</dd></div>
        </dl>
        <p class="kdx-gmem__boundary">VISITED NODES ONLY · NO HIDDEN GRAPH · NO SCORE · NO PROFILE · NO AUTO NAVIGATION</p>
        <p class="kdx-gmem__verdict">CREATOR REVIEW: <b>NOT_RUN</b><br/>MEANING_CARRIED / DECORATIVE_ONLY / MISLEADING</p>
      </aside>
    </section>

    <section class="kdx-gmem__routes" aria-label="route controls">
      <div>
        <p>CURRENT NODE</p>
        <strong data-current-title>Living Systems</strong>
        <small data-current-id>SCI-BIOLOGY</small>
      </div>
      <div class="kdx-gmem__doors" data-doors></div>
    </section>

    <footer class="kdx-gmem__footer">
      <div class="kdx-gmem__presets" aria-label="bounded review scenarios">
        <button type="button" data-preset="SEED">SEED</button>
        <button type="button" data-preset="SPIRAL">SPIRAL</button>
        <button type="button" data-preset="CONSTELLATION">CONSTELLATION</button>
        <button type="button" data-preset="ORBIT">ORBIT</button>
        <button type="button" data-preset="WEAVE">WEAVE</button>
      </div>
      <button type="button" data-reset>RESET</button>
    </footer>
  </main>
</Base>

<script>
  import {
    MICRO_UNIVERSE_NODES,
    buildMicroUniverseFrame,
    createMicroUniverseState,
    enterMicroUniverseNode,
  } from '../../../lib/kodex/micro-universe.js';
  import { buildGeometricMemorySignature } from '../../../lib/kodex/geometric-memory-signature.js';

  const root = document.querySelector('[data-kdx-gmem]');
  if (root) {
    const $ = (selector) => root.querySelector(selector);
    const svgNS = 'http://www.w3.org/2000/svg';
    const presets = {
      SEED: [],
      SPIRAL: ['SCI-PATTERN', 'SCI-COSMOS', 'TECH-CITY'],
      CONSTELLATION: ['TECH-NETWORK', 'ART-FORM', 'CON-MIND'],
      ORBIT: ['SCI-PATTERN', 'SCI-COSMOS', 'SCI-BIOLOGY'],
      WEAVE: ['SCI-PATTERN', 'SCI-COSMOS', 'SCI-BIOLOGY', 'ART-FORM'],
    };

    let state = createMicroUniverseState({ routeSignature: 'KDX-GMEM-LAB' });

    const setText = (selector, value) => {
      const target = $(selector);
      if (target) target.textContent = String(value);
    };

    const renderSvg = (signature) => {
      const edgeLayer = $('[data-memory-edges]');
      const nodeLayer = $('[data-memory-nodes]');
      edgeLayer.replaceChildren();
      nodeLayer.replaceChildren();
      const byId = new Map(signature.nodes.map((node) => [node.id, node]));

      for (const edge of signature.edges) {
        const from = byId.get(edge.from);
        const to = byId.get(edge.to);
        if (!from || !to) continue;
        const line = document.createElementNS(svgNS, 'line');
        line.setAttribute('x1', String(from.x));
        line.setAttribute('y1', String(from.y));
        line.setAttribute('x2', String(to.x));
        line.setAttribute('y2', String(to.y));
        line.setAttribute('data-role', edge.role || 'ROUTE');
        line.setAttribute('vector-effect', 'non-scaling-stroke');
        edgeLayer.append(line);
      }

      for (const node of signature.nodes) {
        const group = document.createElementNS(svgNS, 'g');
        group.setAttribute('transform', `translate(${node.x} ${node.y})`);
        group.setAttribute('data-current', node.isCurrent ? 'true' : 'false');
        group.setAttribute('data-field', node.field || 'unknown');

        const orbit = document.createElementNS(svgNS, 'circle');
        orbit.setAttribute('class', 'kdx-gmem__orbit');
        orbit.setAttribute('r', String(node.radius + (node.isCurrent ? 14 : 7)));
        group.append(orbit);

        const core = document.createElementNS(svgNS, 'circle');
        core.setAttribute('class', 'kdx-gmem__core');
        core.setAttribute('r', String(node.radius));
        group.append(core);

        const title = document.createElementNS(svgNS, 'title');
        title.textContent = `${node.title} · ${node.visits} visit${node.visits === 1 ? '' : 's'} · ${node.field}`;
        group.append(title);
        nodeLayer.append(group);
      }

      const svg = $('[data-memory-svg]');
      svg.setAttribute('aria-label', `${signature.topology} geometric memory signature with ${signature.metrics.visitedCount} visited nodes and ${signature.metrics.totalVisits} total visits`);
    };

    const renderRoutes = () => {
      const frame = buildMicroUniverseFrame(state);
      const doors = $('[data-doors]');
      doors.replaceChildren();
      for (const route of frame.selected) {
        const node = MICRO_UNIVERSE_NODES[route.id];
        const button = document.createElement('button');
        button.type = 'button';
        button.innerHTML = `<small>${route.role || 'ROUTE'}</small><strong>${node.title}</strong><span>${node.field}</span>`;
        button.addEventListener('click', () => {
          state = enterMicroUniverseNode(state, route.id, route.role);
          render();
        });
        doors.append(button);
      }
    };

    const render = () => {
      const signature = buildGeometricMemorySignature(state);
      const current = MICRO_UNIVERSE_NODES[state.currentNodeId];
      setText('[data-topology]', signature.topology);
      setText('[data-signature]', signature.id);
      setText('[data-depth]', signature.metrics.depth);
      setText('[data-known]', signature.metrics.visitedCount);
      setText('[data-total-visits]', signature.metrics.totalVisits);
      setText('[data-revisits]', signature.metrics.revisitCount);
      setText('[data-returns]', signature.metrics.closedReturnCount);
      setText('[data-branches]', signature.metrics.branchPointCount);
      setText('[data-fields]', signature.metrics.fieldCount);
      setText('[data-patterns]', signature.patterns.map((pattern) => pattern.id).join(' + '));
      setText('[data-current-title]', current?.title || state.currentNodeId);
      setText('[data-current-id]', state.currentNodeId);
      renderSvg(signature);
      renderRoutes();
    };

    root.querySelectorAll('[data-preset]').forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.getAttribute('data-preset');
        const sequence = presets[key] || [];
        state = createMicroUniverseState({ routeSignature: `KDX-GMEM-${key}` });
        for (const nodeId of sequence) state = enterMicroUniverseNode(state, nodeId, 'CONTINUITY');
        render();
      });
    });

    $('[data-reset]').addEventListener('click', () => {
      state = createMicroUniverseState({ routeSignature: 'KDX-GMEM-LAB' });
      render();
    });

    render();
  }
</script>

<style>
  :global(body) { margin:0; overflow:hidden; background:#050606; color:#f2f1eb; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; }
  .kdx-gmem { height:100dvh; box-sizing:border-box; display:grid; grid-template-rows:auto minmax(0,1fr) auto auto; gap:12px; padding:clamp(12px,2vw,28px); background:radial-gradient(circle at 45% 45%,#111516 0,#070808 52%,#030303 100%); }
  .kdx-gmem__header,.kdx-gmem__footer { display:flex; align-items:center; justify-content:space-between; gap:20px; }
  .kdx-gmem__header { padding-bottom:12px; border-bottom:1px solid #26302e; }
  .kdx-gmem p { margin:0; font-size:8px; letter-spacing:.14em; opacity:.56; }
  .kdx-gmem h1 { margin:4px 0 0; font-size:clamp(14px,1.7vw,24px); letter-spacing:.09em; font-weight:600; }
  .kdx-gmem__header dl { display:grid; grid-template-columns:repeat(4,minmax(90px,auto)); gap:16px; margin:0; }
  .kdx-gmem dt { font-size:7px; letter-spacing:.12em; opacity:.42; }
  .kdx-gmem dd { margin:4px 0 0; font-size:9px; max-width:160px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .kdx-gmem__grid { min-height:0; display:grid; grid-template-columns:minmax(0,1fr) minmax(220px,.34fr); gap:16px; }
  .kdx-gmem__canvas { position:relative; min-height:0; border:1px solid #29302f; background:rgba(0,0,0,.26); overflow:hidden; }
  .kdx-gmem__canvas svg { width:100%; height:100%; min-height:280px; }
  .kdx-gmem__canvas :global(line) { stroke:rgba(220,235,226,.34); stroke-width:1.4; }
  .kdx-gmem__canvas :global(line[data-role="BRIDGE"]) { stroke-dasharray:9 8; }
  .kdx-gmem__canvas :global(.kdx-gmem__orbit) { fill:none; stroke:rgba(205,226,215,.3); stroke-width:1.2; }
  .kdx-gmem__canvas :global(.kdx-gmem__core) { fill:#dce8df; stroke:#f8fff9; stroke-width:1; }
  .kdx-gmem__canvas :global(g[data-current="true"] .kdx-gmem__orbit) { stroke:#d7ff4f; stroke-width:3; }
  .kdx-gmem__canvas :global(g[data-current="true"] .kdx-gmem__core) { fill:#d7ff4f; }
  .kdx-gmem__legend { position:absolute; left:10px; bottom:10px; display:flex; flex-wrap:wrap; gap:6px 14px; font-size:7px; letter-spacing:.08em; opacity:.48; }
  .kdx-gmem__trace { border:1px solid #29302f; padding:14px; overflow:auto; }
  .kdx-gmem__trace dl { margin:14px 0; display:grid; gap:8px; }
  .kdx-gmem__trace dl div { padding-top:7px; border-top:1px solid rgba(255,255,255,.06); }
  .kdx-gmem__trace dd { white-space:normal; max-width:none; line-height:1.35; }
  .kdx-gmem__boundary { line-height:1.5; }
  .kdx-gmem__verdict { margin-top:16px !important; padding-top:12px; border-top:1px solid #29302f; line-height:1.55; }
  .kdx-gmem__verdict b { color:#d7ff4f; }
  .kdx-gmem__routes { display:grid; grid-template-columns:minmax(120px,.22fr) minmax(0,1fr); gap:12px; align-items:stretch; }
  .kdx-gmem__routes > div:first-child { display:flex; flex-direction:column; justify-content:center; padding:9px 11px; border:1px solid #29302f; }
  .kdx-gmem__routes strong { font-size:11px; margin-top:4px; }
  .kdx-gmem__routes small { margin-top:3px; font-size:8px; opacity:.45; }
  .kdx-gmem__doors { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:7px; }
  .kdx-gmem__doors :global(button),.kdx-gmem__footer button { color:inherit; background:#080a09; border:1px solid #313b38; cursor:pointer; font:inherit; }
  .kdx-gmem__doors :global(button) { min-width:0; padding:8px 9px; text-align:left; display:grid; gap:3px; }
  .kdx-gmem__doors :global(button:hover),.kdx-gmem__doors :global(button:focus-visible),.kdx-gmem__footer button:hover,.kdx-gmem__footer button:focus-visible { border-color:#d7ff4f; outline:none; }
  .kdx-gmem__doors :global(small) { font-size:7px; opacity:.4; }
  .kdx-gmem__doors :global(strong) { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:10px; }
  .kdx-gmem__doors :global(span) { font-size:7px; opacity:.45; text-transform:uppercase; }
  .kdx-gmem__footer { padding-top:10px; border-top:1px solid #26302e; }
  .kdx-gmem__presets { display:flex; flex-wrap:wrap; gap:6px; }
  .kdx-gmem__footer button { padding:7px 10px; font-size:8px; letter-spacing:.08em; }
  @media (max-width:760px) {
    :global(body) { overflow:auto; }
    .kdx-gmem { min-height:100dvh; height:auto; grid-template-rows:auto auto auto auto; }
    .kdx-gmem__header { align-items:flex-start; flex-direction:column; }
    .kdx-gmem__header dl { grid-template-columns:repeat(2,minmax(0,1fr)); width:100%; }
    .kdx-gmem__grid { grid-template-columns:1fr; }
    .kdx-gmem__canvas { height:48dvh; min-height:330px; }
    .kdx-gmem__routes { grid-template-columns:1fr; }
    .kdx-gmem__doors { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
</style>
