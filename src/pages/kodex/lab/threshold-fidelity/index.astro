---
import KodexThresholdMembrane from '../../../../components/kodex/threshold/KodexThresholdMembrane.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="color-scheme" content="dark" />
    <title>KODEX−∞ · THRESHOLD Fidelity Lab</title>
    <meta
      name="description"
      content="Internal noindex KODEX−∞ THRESHOLD visual-convergence laboratory for KOD-49."
    />
  </head>
  <body>
    <main class="threshold-lab" data-kdx-visible-assembly data-motion="full" aria-labelledby="threshold-title">
      <KodexThresholdMembrane class="threshold-lab__membrane" />
      <div class="threshold-lab__depth" aria-hidden="true"></div>
      <div class="threshold-lab__macro" aria-hidden="true">THRESHOLD</div>
      <div class="threshold-lab__signal" aria-hidden="true"></div>

      <header class="threshold-lab__chrome">
        <div class="threshold-lab__identity">
          <strong>KODEX−∞</strong>
          <span>KOD-49 / THRESHOLD</span>
          <span>Fidelity Lab / noindex</span>
        </div>
        <div class="threshold-lab__controls">
          <span>STATE <strong data-visual-state>DORMANT</strong></span>
          <button type="button" data-motion-toggle>MOTION: FULL</button>
        </div>
      </header>

      <section class="threshold-lab__composition">
        <div class="threshold-lab__copy">
          <p class="threshold-lab__eyebrow">A / −∞ / VOLUNTARY ENTRY</p>
          <h1 id="threshold-title">THE GATE IS A LIVING AGREEMENT.</h1>
          <p class="threshold-lab__lede">
            Presence changes the membrane. It does not identify you. Crossing remains an explicit choice.
          </p>
          <p class="threshold-lab__question">
            WILL YOU ENTER A SYSTEM THAT REMEMBERS TRANSFORMATION?
          </p>

          <div class="threshold-lab__actions">
            <a class="threshold-lab__enter" href="/kodex/lab/visible-assembly/">
              <span>A</span>
              <strong>ENTER VOLUNTARILY</strong>
              <small>Continue into the canonical functional Visible Assembly.</small>
            </a>
          </div>
        </div>
      </section>

      <aside class="threshold-lab__telemetry" aria-label="Scene implementation status">
        <div><span>SCENE</span><strong>THRESHOLD</strong></div>
        <div><span>VISUAL LAYER</span><strong>NATIVE CANVAS2D</strong></div>
        <div><span>POINTER</span><strong>ATMOSPHERIC ONLY</strong></div>
        <div><span>IDENTITY CLAIM</span><strong>NONE</strong></div>
        <div><span>MOTION</span><strong data-telemetry-motion>FULL</strong></div>
        <div><span>VISUAL STATE</span><strong data-telemetry-state>DORMANT</strong></div>
        <div><span>MEMORY WRITE</span><strong>NONE / PRE-ENTRY</strong></div>
        <div><span>ENTRY</span><strong>VOLUNTARY</strong></div>
      </aside>

      <div class="threshold-lab__index" aria-hidden="true">
        <span class="threshold-lab__index--bars"></span>
        <span class="threshold-lab__index--caption">VISUAL INDEX — NOT AUTH</span>
      </div>

      <div class="threshold-lab__aperture-note" data-aperture-note aria-hidden="true">
        APPROACH THE MEMBRANE
      </div>

      <footer class="threshold-lab__footer">
        <span>VISUAL IMPACT / FRONTIER REVIEW PENDING</span>
        <span>NATIVE IMPLEMENTATION / PORT CANDIDATE</span>
        <span>NOT PRODUCTION</span>
      </footer>
    </main>

    <script>
      const root = document.querySelector<HTMLElement>('.threshold-lab');
      if (root) {
        const motionToggle = root.querySelector<HTMLButtonElement>('[data-motion-toggle]');
        const stateLabel = root.querySelector<HTMLElement>('[data-visual-state]');
        const apertureNote = root.querySelector<HTMLElement>('[data-aperture-note]');
        const telemetryMotion = root.querySelector<HTMLElement>('[data-telemetry-motion]');
        const telemetryState = root.querySelector<HTMLElement>('[data-telemetry-state]');
        const modes = ['FULL', 'REDUCED', 'OFF'] as const;
        let motionIndex = matchMedia('(prefers-reduced-motion: reduce)').matches ? 1 : 0;
        let visualState: 'DORMANT' | 'AWARE' | 'OPEN' = 'DORMANT';
        let dwell = 0;
        let near = false;
        let veryNear = false;
        let lastTick = performance.now();

        const renderControls = () => {
          const motion = modes[motionIndex] ?? 'FULL';
          root.dataset.motion = motion.toLowerCase();
          if (motionToggle) motionToggle.textContent = `MOTION: ${motion}`;
          if (stateLabel) stateLabel.textContent = visualState;
          if (telemetryMotion) telemetryMotion.textContent = motion;
          if (telemetryState) telemetryState.textContent = visualState;
          if (apertureNote) {
            apertureNote.textContent = visualState === 'DORMANT'
              ? 'APPROACH THE MEMBRANE'
              : visualState === 'AWARE'
                ? 'PRESENCE MODULATES / IDENTITY UNKNOWN'
                : 'APERTURE STABLE / CHOICE REQUIRED';
          }
        };

        const setVisualState = (next: 'DORMANT' | 'AWARE' | 'OPEN') => {
          if (visualState === next) return;
          visualState = next;
          renderControls();
        };

        const updateVisualState = (event: PointerEvent) => {
          const rect = root.getBoundingClientRect();
          const compact = rect.width < 900;
          // Shared focal contract with KodexThresholdMembrane.astro.
          const focalX = rect.width * (compact ? 0.5 : 0.6);
          const focalY = rect.height * (compact ? 0.32 : 0.46);
          const dx = event.clientX - rect.left - focalX;
          const dy = event.clientY - rect.top - focalY;
          const distance = Math.hypot(dx, dy);
          near = distance < Math.min(rect.width, rect.height) * 0.31;
          veryNear = distance < Math.min(rect.width, rect.height) * 0.19;

          if (veryNear) setVisualState(dwell >= 0.62 ? 'OPEN' : 'AWARE');
          else if (near) setVisualState('AWARE');
          else if (dwell <= 0.1) setVisualState('DORMANT');
        };

        root.addEventListener('pointermove', updateVisualState, { passive: true });
        root.addEventListener('pointerleave', () => {
          near = false;
          veryNear = false;
        }, { passive: true });

        motionToggle?.addEventListener('click', () => {
          motionIndex = (motionIndex + 1) % modes.length;
          renderControls();
        });

        // Match the membrane renderer's approximate frame-based dwell/decay rates,
        // but make semantics elapsed-time based so a stationary pointer can open the gate.
        const stateTimer = window.setInterval(() => {
          const now = performance.now();
          const dt = Math.min(0.25, Math.max(0, (now - lastTick) / 1000));
          lastTick = now;

          if (veryNear) dwell = Math.min(1, dwell + dt * 0.25);
          else dwell = Math.max(0, dwell - dt * 0.44);

          if (veryNear) setVisualState(dwell >= 0.62 ? 'OPEN' : 'AWARE');
          else if (near) setVisualState('AWARE');
          else setVisualState(dwell > 0.1 ? 'AWARE' : 'DORMANT');
        }, 50);

        addEventListener('pagehide', () => clearInterval(stateTimer), { once: true });
        renderControls();
      }
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #020203; color-scheme: dark; }
  :global(body) {
    margin: 0;
    overflow: hidden;
    background: #020203;
    color: #f0eee8;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  :global(a), :global(button) { font: inherit; }

  .threshold-lab {
    position: relative;
    width: 100vw;
    height: 100svh;
    min-height: 38rem;
    overflow: hidden;
    background: #020203;
  }

  .threshold-lab__membrane { z-index: 0; }
  .threshold-lab__depth {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.42), transparent 43%, transparent 74%, rgb(0 0 0 / 0.16)),
      radial-gradient(circle at 60% 46%, transparent 0 18%, rgb(0 0 0 / 0.08) 45%, rgb(0 0 0 / 0.42) 100%);
  }

  .threshold-lab__macro {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: flex;
    align-items: center;
    padding-inline: clamp(1rem, 4vw, 4rem);
    pointer-events: none;
    overflow: hidden;
    white-space: nowrap;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(6rem, 18vw, 21rem);
    font-weight: 800;
    line-height: 0.78;
    letter-spacing: -0.05em;
    color: rgb(240 238 232 / 0.045);
    user-select: none;
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.9) 0 30%, transparent 78%);
    -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.9) 0 30%, transparent 78%);
  }

  .threshold-lab__signal {
    position: absolute;
    z-index: 3;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 24% 22%, rgb(180 144 255 / 0.05) 0 1px, transparent 2px),
      radial-gradient(circle at 34% 30%, rgb(180 144 255 / 0.04) 0 1px, transparent 2px),
      radial-gradient(circle at 55% 18%, rgb(214 202 232 / 0.05) 0 1px, transparent 2px),
      radial-gradient(circle at 70% 24%, rgb(180 144 255 / 0.04) 0 1px, transparent 2px);
    background-size: 160px 160px, 130px 130px, 200px 200px, 180px 180px;
  }

  .threshold-lab__chrome,
  .threshold-lab__footer {
    position: absolute;
    z-index: 20;
    inset-inline: max(0.8rem, env(safe-area-inset-left)) max(0.8rem, env(safe-area-inset-right));
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: rgb(240 238 232 / 0.48);
    font-size: clamp(0.56rem, 1vw, 0.7rem);
    line-height: 1.4;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .threshold-lab__chrome { top: max(0.72rem, env(safe-area-inset-top)); align-items: flex-start; }
  .threshold-lab__footer { bottom: max(0.65rem, env(safe-area-inset-bottom)); align-items: flex-end; }
  .threshold-lab__identity,
  .threshold-lab__controls { display: flex; flex-wrap: wrap; gap: 0.35rem 0.85rem; }
  .threshold-lab__identity strong,
  .threshold-lab__controls strong { color: #f0eee8; font-weight: 600; }
  .threshold-lab__controls { justify-content: flex-end; }
  .threshold-lab__controls button {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }
  .threshold-lab__controls button:hover,
  .threshold-lab__controls button:focus-visible { color: #f0eee8; outline: none; }

  .threshold-lab__composition {
    position: absolute;
    z-index: 8;
    inset: 3.5rem 0 2.5rem;
    display: grid;
    grid-template-columns: minmax(19rem, 0.82fr) minmax(32rem, 1.18fr);
    align-items: center;
    padding: clamp(1.5rem, 5vw, 5rem);
    pointer-events: none;
  }

  .threshold-lab__copy {
    width: min(43rem, 100%);
    pointer-events: auto;
  }
  .threshold-lab__eyebrow {
    margin: 0 0 1.4rem;
    color: #ac98df;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
  }
  .threshold-lab h1 {
    margin: 0;
    max-width: 9.5ch;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(3.5rem, 7vw, 7.2rem);
    font-weight: 650;
    line-height: 0.83;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }
  .threshold-lab__lede {
    max-width: 50ch;
    margin: 1.5rem 0 0;
    color: rgb(240 238 232 / 0.58);
    font-size: clamp(0.76rem, 1.1vw, 0.95rem);
    line-height: 1.65;
  }
  .threshold-lab__question {
    max-width: 52ch;
    margin: 2rem 0 0;
    color: rgb(240 238 232 / 0.82);
    font-size: 0.68rem;
    line-height: 1.6;
    letter-spacing: 0.12em;
  }
  .threshold-lab__actions { margin-top: 1.4rem; }
  .threshold-lab__enter {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem 0.85rem;
    width: min(24rem, 100%);
    padding: 1rem 1.05rem;
    border: 1px solid rgb(193 171 246 / 0.44);
    background: linear-gradient(118deg, rgb(34 23 53 / 0.9), rgb(6 6 9 / 0.86));
    color: #f0eee8;
    text-decoration: none;
    backdrop-filter: blur(12px);
    box-shadow: 0 1.4rem 4rem rgb(0 0 0 / 0.42);
  }
  .threshold-lab__enter > span { grid-row: 1 / 3; color: #a982ff; font-size: 0.68rem; }
  .threshold-lab__enter strong { font-size: 0.78rem; letter-spacing: 0.12em; }
  .threshold-lab__enter small { color: rgb(240 238 232 / 0.48); line-height: 1.42; }
  .threshold-lab__enter:hover,
  .threshold-lab__enter:focus-visible { border-color: #d7c7ff; outline: none; background: linear-gradient(118deg, rgb(47 29 72 / 0.94), rgb(8 8 12 / 0.9)); }

  .threshold-lab__telemetry {
    position: absolute;
    z-index: 10;
    top: 4.8rem;
    right: 1.5rem;
    width: min(15rem, 32vw);
    display: grid;
    gap: 0.45rem;
    pointer-events: none;
    color: rgb(240 238 232 / 0.38);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
  }
  .threshold-lab__telemetry div {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgb(240 238 232 / 0.08);
  }
  .threshold-lab__telemetry strong { color: rgb(240 238 232 / 0.66); font-weight: 500; text-align: right; }

  .threshold-lab__index {
    position: absolute;
    z-index: 10;
    right: 1.5rem;
    bottom: 3.4rem;
    display: grid;
    gap: 0.35rem;
    justify-items: end;
    pointer-events: none;
    color: rgb(240 238 232 / 0.4);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .threshold-lab__index--bars {
    display: block;
    width: 5.5rem;
    height: 0.9rem;
    background:
      repeating-linear-gradient(90deg,
        rgb(240 238 232 / 0.55) 0 2px, transparent 2px 5px,
        rgb(240 238 232 / 0.32) 5px 6px, transparent 6px 10px,
        rgb(240 238 232 / 0.6) 10px 13px, transparent 13px 16px);
  }
  .threshold-lab__index--caption { color: rgb(240 238 232 / 0.3); }

  .threshold-lab__aperture-note {
    position: absolute;
    z-index: 9;
    left: 60%;
    top: 46%;
    transform: translate(-50%, min(32vw, 22rem));
    color: rgb(240 238 232 / 0.38);
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .threshold-lab { min-height: 0; }
    .threshold-lab__depth {
      background:
        linear-gradient(180deg, transparent 0 42%, rgb(2 2 3 / 0.08) 52%, rgb(2 2 3 / 0.93) 77%, #020203 100%),
        radial-gradient(circle at 50% 32%, transparent 0 17%, rgb(0 0 0 / 0.12) 42%, rgb(0 0 0 / 0.45) 100%);
    }
    .threshold-lab__macro {
      align-items: flex-start;
      padding-top: clamp(3.5rem, 12svh, 6rem);
      font-size: clamp(4rem, 26vw, 8rem);
      mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.9) 0 40%, transparent 88%);
      -webkit-mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.9) 0 40%, transparent 88%);
    }
    .threshold-lab__signal { opacity: 0.7; }
    .threshold-lab__chrome { gap: 0.5rem; }
    .threshold-lab__identity span:nth-of-type(2),
    .threshold-lab__identity span:nth-of-type(3),
    .threshold-lab__controls > span { display: none; }
    .threshold-lab__composition {
      inset: 3rem 0 2.2rem;
      display: flex;
      align-items: flex-end;
      padding: 1rem 1rem 1.6rem;
    }
    .threshold-lab__copy { width: 100%; }
    .threshold-lab__eyebrow { margin-bottom: 0.75rem; }
    .threshold-lab h1 { max-width: 8.5ch; font-size: clamp(2.9rem, 13.5vw, 4.4rem); }
    .threshold-lab__lede { display: none; }
    .threshold-lab__question { margin-top: 0.9rem; max-width: 40ch; font-size: 0.56rem; }
    .threshold-lab__actions { margin-top: 0.75rem; }
    .threshold-lab__enter { width: 100%; padding: 0.85rem 0.9rem; }
    .threshold-lab__telemetry { top: 4rem; right: 0.75rem; width: 9.5rem; font-size: 0.48rem; }
    .threshold-lab__telemetry div:nth-child(n + 5) { display: none; }
    .threshold-lab__index { right: 0.75rem; bottom: 2.6rem; }
    .threshold-lab__index--caption { display: none; }
    .threshold-lab__aperture-note { left: 50%; top: 32%; transform: translate(-50%, 24vw); font-size: 0.48rem; white-space: nowrap; }
    .threshold-lab__footer { gap: 0.4rem; font-size: 0.48rem; }
    .threshold-lab__footer span:nth-child(2) { display: none; }
  }
</style>