---
import Base from '../../../layouts/Base.astro';
import KodexHoloCoreWebGLSourceLab from '../../../components/kodex/holocore/KodexHoloCoreWebGLSourceLab.astro';
const forceFallback = Astro.url.searchParams.get('fallback') === 'canvas';
---

<Base title="KODEX−∞ · Toroidal Field WebGL" description="Internal KODEX toroidal perceptual benchmark using the existing HoloCore WebGL source adapter." robots="noindex, nofollow" kodexFonts={true} noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}>
  <main class="torus-page" aria-labelledby="torus-title">
    <header class="torus-page__header">
      <div><p>KDX-HOLO-BENCH-001 // PERCEPTUAL MATERIALITY TEST</p><h1 id="torus-title">TOROIDAL FIELD</h1></div>
      <div class="torus-page__truth"><span>ART / COMP / SPEC</span><span>AMBIENT / UNCLOSED</span><span>CREATOR ACCEPTANCE · PENDING</span></div>
    </header>
    <section class="torus-page__core" aria-label="Toroidal HoloCore WebGL field">
      <KodexHoloCoreWebGLSourceLab variant="toroidal" forceFallback={forceFallback} label="KODEX toroidal field: an authored volumetric torus visualization rendered in WebGL" />
    </section>
    <footer class="torus-page__footer"><span>ONE DOMINANT FIELD</span><span>NO SCIENTIFIC SIMULATION CLAIM</span><span>NO SEAM CLAIM</span></footer>
  </main>
</Base>

<style is:global>html:has(.torus-page),body:has(.torus-page){margin:0;width:100%;min-height:100%;overflow:hidden;background:#020204}</style>
<style>
  .torus-page{box-sizing:border-box;width:100%;height:100dvh;display:grid;grid-template-rows:clamp(58px,8vh,78px) minmax(0,1fr) 32px;padding:8px;overflow:hidden;background:radial-gradient(circle at 50% 48%,#090410 0,#020204 68%);color:#eeeaf2;font-family:'Share Tech Mono',ui-monospace,monospace}
  .torus-page__header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 clamp(8px,1.5vw,20px);border-bottom:1px solid rgba(176,126,255,.13)}
  .torus-page__header p{margin:0;font-size:7px;letter-spacing:.15em;color:rgba(230,224,238,.38)}
  .torus-page h1{margin:2px 0 0;font-family:'Cormorant Garamond','Times New Roman',serif;font-size:clamp(24px,3.6vw,52px);font-weight:400;line-height:.9;letter-spacing:.08em}
  .torus-page__truth{display:flex;gap:16px;font-size:6px;letter-spacing:.12em;color:rgba(190,150,255,.58)}
  .torus-page__core{min-height:0;min-width:0;padding:clamp(4px,.7vw,9px)}
  .torus-page__footer{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 10px;border-top:1px solid rgba(176,126,255,.13);font-size:6px;letter-spacing:.12em;color:rgba(230,224,238,.35)}
  @media(max-width:700px){.torus-page{padding:5px;grid-template-rows:62px minmax(0,1fr) 28px}.torus-page__header{padding:0 5px}.torus-page__truth{display:none}.torus-page__header p{font-size:5px}.torus-page h1{font-size:30px}.torus-page__core{padding:3px}.torus-page__footer{font-size:5px;padding:0 4px;gap:5px}}
</style>
