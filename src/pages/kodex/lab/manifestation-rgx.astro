---
import KodexManifestationRGXCore from '../../../components/kodex/holocore/KodexManifestationRGXCore.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>KODEX Manifestation × RGX Integration Lab</title>
  </head>
  <body>
    <main class="manifest-rgx-lab" data-manifestation-rgx-lab>
      <section class="manifest-rgx-lab__core" aria-label="Manifestation RGX state visualization">
        <KodexManifestationRGXCore />
      </section>

      <aside class="manifest-rgx-lab__panel">
        <header>
          <p>KODEX−∞ / INTEGRATION LAB</p>
          <h1>MANIFESTATION × RGX</h1>
          <span>ONE CAUSAL STATE / ONE ACTIVE RENDERER / CODE-NATIVE FORM</span>
        </header>

        <div class="manifest-rgx-lab__status" aria-live="polite">
          <div><span>PHASE</span><strong data-lab-phase>POTENTIAL</strong></div>
          <div><span>RGX FORM</span><strong data-lab-specimen>SOURCE CHAMBER</strong></div>
          <div><span>CAUSAL LOAD</span><strong data-lab-load>0.00</strong></div>
          <div><span>TRACE</span><strong data-lab-trace>0</strong></div>
        </div>

        <div class="manifest-rgx-lab__route" aria-label="Expected causal route">
          <span>SOURCE</span><i>→</i><span>SIGNAL</span><i>→</i><span>PORTAL</span><i>→</i><span>VORTEX</span><i>→</i><span>DNA</span><i>→</i><span>MEMORY</span>
        </div>

        <div class="manifest-rgx-lab__controls" aria-label="Manifestation controls">
          <button type="button" data-action="declare">01 / DECLARE DNA ASCENT INTENT</button>
          <button type="button" data-action="signal">02 / EMIT SIGNAL</button>
          <button type="button" data-action="blocker">+ ADD INTERFERENCE</button>
          <button type="button" data-action="resolve">03 / RESOLVE INTERFERENCE</button>
          <button type="button" data-action="transform">04 / BEGIN TRANSFORMATION</button>
          <button type="button" data-action="realize">05 / REALIZE NODE FORM</button>
          <button type="button" data-action="trace">06 / WRITE TRACE</button>
          <button type="button" data-action="reset">RESET CORE</button>
        </div>

        <div class="manifest-rgx-lab__truth">
          <strong>TRUTH BOUNDARY</strong>
          <p>Software causal-state model. RGX re-executes reference topology in code. No source pixels, biometric inference, metaphysical claim or hidden engagement score.</p>
        </div>

        <div class="manifest-rgx-lab__event" data-lab-event>READY</div>
      </aside>
    </main>

    <script>
      const lab = document.querySelector('[data-manifestation-rgx-lab]');
      const core = document.querySelector('[data-kdx-manifestation-rgx-core]');
      if (lab instanceof HTMLElement && core instanceof HTMLElement) {
        const phase = lab.querySelector('[data-lab-phase]');
        const specimen = lab.querySelector('[data-lab-specimen]');
        const load = lab.querySelector('[data-lab-load]');
        const trace = lab.querySelector('[data-lab-trace]');
        const eventLine = lab.querySelector('[data-lab-event]');

        const blocker = {
          id: 'rgx-integration-creator-gate',
          type: 'CREATOR_ACCEPTANCE',
          label: 'Creator visual acceptance pending',
          severity: 0.62,
          sourceRef: 'KOD-67 / PR-75',
        };

        const send = detail => {
          core.dispatchEvent(new CustomEvent('kdx:manifestation:event', { detail }));
          if (eventLine) eventLine.textContent = detail.type;
        };

        core.addEventListener('kdx:manifestation:rgx-view', event => {
          const detail = event.detail || {};
          if (phase) phase.textContent = detail.phase || '—';
          if (specimen) specimen.textContent = String(detail.rgxSpecimenId || '—').replaceAll('-', ' ').toUpperCase();
          if (load) load.textContent = Number(detail.causalLoad || 0).toFixed(2);
          if (trace) trace.textContent = String(detail.traceLength || 0);
          lab.dataset.phase = detail.phase || '';
          lab.dataset.specimen = detail.rgxSpecimenId || '';
          lab.dataset.blocked = String(Boolean(detail.blocked));
          lab.dataset.visualResolutionSource = detail.visualResolutionSource || '';
          lab.dataset.rgxResolutionSource = detail.rgxResolutionSource || '';
        });

        lab.querySelectorAll('button[data-action]').forEach(button => {
          button.addEventListener('click', () => {
            const action = button.dataset.action;
            if (action === 'declare') {
              send({
                type: 'DECLARE_INTENT',
                intentId: 'KDX-RGX-INTENT-DNA-001',
                intent: 'MATERIALIZE DNA ASCENT',
                nodeId: 'KDX-NODE-DNA-ASCENT',
                at: performance.timeOrigin + performance.now(),
              });
            }
            if (action === 'signal') send({ type: 'EMIT_SIGNAL' });
            if (action === 'blocker') send({ type: 'ADD_BLOCKER', blocker });
            if (action === 'resolve') send({ type: 'RESOLVE_BLOCKER', blockerId: blocker.id });
            if (action === 'transform') send({ type: 'BEGIN_TRANSFORMATION' });
            if (action === 'realize') send({ type: 'REALIZE', at: performance.timeOrigin + performance.now() });
            if (action === 'trace') send({ type: 'WRITE_TRACE', routeSignature: 'KDX-RGX-DNA-ASCENT', memoryRef: 'KOD-67' });
            if (action === 'reset') send({ type: 'RESET' });
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; background: #020205; }
  * { box-sizing: border-box; }
  html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #020205; }
  body { font-family: 'Share Tech Mono', ui-monospace, monospace; color: #ece8ef; }

  .manifest-rgx-lab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 312px;
    gap: 12px;
    width: 100%;
    height: 100dvh;
    min-height: 0;
    padding: 12px;
    overflow: hidden;
    background:
      linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.015) 1px, transparent 1px),
      #020205;
    background-size: 32px 32px;
  }

  .manifest-rgx-lab__core { min-width: 0; min-height: 0; }

  .manifest-rgx-lab__panel {
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: auto auto auto minmax(0, 1fr) auto auto;
    gap: 9px;
    padding: 12px;
    border: 1px solid rgba(255,255,255,.16);
    background: rgba(3,3,7,.94);
    overflow: hidden;
  }

  .manifest-rgx-lab__panel header p,
  .manifest-rgx-lab__panel header span,
  .manifest-rgx-lab__truth,
  .manifest-rgx-lab__event {
    margin: 0;
    font-size: 7px;
    line-height: 1.4;
    letter-spacing: .12em;
    color: rgba(236,232,239,.52);
  }

  .manifest-rgx-lab__panel h1 {
    margin: 6px 0 4px;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: .08em;
  }

  .manifest-rgx-lab__status {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: rgba(255,255,255,.12);
  }

  .manifest-rgx-lab__status div {
    min-width: 0;
    display: grid;
    gap: 4px;
    padding: 8px;
    background: #05050a;
  }
  .manifest-rgx-lab__status span { font-size: 6px; letter-spacing: .12em; color: rgba(255,255,255,.42); }
  .manifest-rgx-lab__status strong { overflow: hidden; text-overflow: ellipsis; font-size: 8px; font-weight: 500; color: #e8dfb9; }

  .manifest-rgx-lab__route {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;
    padding: 7px;
    border: 1px solid rgba(255,255,255,.1);
    color: rgba(255,255,255,.55);
    font-size: 6px;
    letter-spacing: .08em;
  }
  .manifest-rgx-lab__route i { color: rgba(255,255,255,.2); font-style: normal; }

  .manifest-rgx-lab__controls {
    min-height: 0;
    display: grid;
    align-content: start;
    gap: 5px;
    overflow: auto;
    scrollbar-width: thin;
  }
  .manifest-rgx-lab__controls button {
    width: 100%;
    min-height: 34px;
    padding: 8px 9px;
    border: 1px solid rgba(255,255,255,.14);
    color: rgba(244,240,247,.82);
    background: rgba(255,255,255,.025);
    font: inherit;
    font-size: 7px;
    letter-spacing: .08em;
    text-align: left;
    cursor: pointer;
  }
  .manifest-rgx-lab__controls button:hover,
  .manifest-rgx-lab__controls button:focus-visible { border-color: #e8dfb9; color: #fff; outline: none; }

  .manifest-rgx-lab__truth { padding-top: 8px; border-top: 1px solid rgba(255,255,255,.1); }
  .manifest-rgx-lab__truth strong { color: #e8dfb9; font-weight: 500; }
  .manifest-rgx-lab__truth p { margin: 4px 0 0; }
  .manifest-rgx-lab__event { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  @media (max-width: 700px) {
    .manifest-rgx-lab {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) 286px;
      gap: 8px;
      padding: 8px;
    }
    .manifest-rgx-lab__panel {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      gap: 6px;
      padding: 8px;
    }
    .manifest-rgx-lab__panel header { grid-column: 1 / -1; }
    .manifest-rgx-lab__panel header span { display: none; }
    .manifest-rgx-lab__panel h1 { margin: 3px 0 0; font-size: 12px; }
    .manifest-rgx-lab__status { grid-column: 1; grid-row: 2; }
    .manifest-rgx-lab__route { display: none; }
    .manifest-rgx-lab__controls { grid-column: 2; grid-row: 2 / 5; }
    .manifest-rgx-lab__controls button { min-height: 29px; padding: 5px 6px; font-size: 6px; }
    .manifest-rgx-lab__truth { grid-column: 1; grid-row: 3; }
    .manifest-rgx-lab__event { grid-column: 1; grid-row: 4; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; }
  }
</style>
