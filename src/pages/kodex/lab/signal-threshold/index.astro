---
import Base from '../../../../layouts/Base.astro';

import { SIGNAL_THRESHOLD as recipe } from '../../../../lib/kodex/motion-lab/signal-threshold.mjs';

---
<Base title="KDX-FILM-001 — SIGNAL_THRESHOLD | Internal Lab" description="KODEX Motion Lab prototype" robots="noindex, nofollow" kodexFonts={true} noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}>
  <main class="film" data-kdx-film data-duration={recipe.total} data-film-id={recipe.id}>
    <header class="film__top">
      <div><span class="eyebrow">KODEX−∞ / MOTION LAB / EXPERIMENT 001</span><h1>SIGNAL_THRESHOLD</h1></div>
      <a href="/kodex/" class="film__back">← EXIT LAB</a>
    </header>
    <section class="film__stage" aria-label="Signal Threshold rough renderer" data-film-stage data-state="VOID">
      <div class="film__grid" aria-hidden="true"></div>
      <div class="film__visual" aria-hidden="true">
        <div class="film__halo"></div>
        <div class="film__ring film__ring--outer"></div>
        <div class="film__ring film__ring--inner"></div>
        <div class="film__core"></div>
        <div class="film__horizon"></div>
      </div>
      <div class="film__hud"><span>REC / KDX-001</span><span data-clock>00:00.00 / 00:14.00</span></div>
      <div class="film__caption"><span data-number>01 / 05</span><strong data-state-label>VOID</strong><p data-state-note>Silencio / potencial</p></div>
      <p class="film__watermark">ROUGH RENDER · NOT FINAL ART</p>
    </section>
    <section class="film__controls" aria-label="Motion controls">
      <div class="film__buttons"><button type="button" data-play aria-pressed="false">▶ PLAY</button><button type="button" data-reset>↺ RESET</button><button type="button" data-prev>← PREV</button><button type="button" data-next>NEXT →</button></div>
      <label for="film-seek">PLAYHEAD <span data-seek-label>0.00s</span></label>
      <input id="film-seek" data-seek type="range" min="0" max={recipe.total} step="0.01" value="0" />
      <div class="film__ticks" aria-hidden="true">{recipe.stages.map((stage) => <span style={`width:${(stage.end-stage.start)/recipe.total*100}%`}>{stage.id}</span>)}</div>
      <p class="film__help">SPACE = play/pause · ←/→ = previous/next state · HOME/END = start/end. Respects reduced motion.</p>
    </section>
    <details class="film__provenance">
      <summary>PROVENANCE / RECIPE / VALIDATION</summary>
      <dl>
        <div><dt>RECORD</dt><dd>{recipe.id} · v{recipe.version}</dd></div>
        <div><dt>STATUS</dt><dd>PROTOTYPE · UNTESTED IN DEPLOYMENT</dd></div>
        <div><dt>SOURCE</dt><dd>KODEX Motion Lab architecture brief, user-supplied project context</dd></div>
        <div><dt>RENDERER</dt><dd>Original CSS shapes + DOM / requestAnimationFrame; no AI media or external assets</dd></div>
        <div><dt>REUSE</dt><dd>Astro layout / existing design dependencies; no production engine modified</dd></div>
        <div><dt>ACCESS</dt><dd>Internal noindex route. Not authentication-protected.</dd></div>
        <div><dt>AUDIO</dt><dd>None; silent pilot</dd></div>
      </dl>
      <p>Gate: verify build, mobile viewports (390×844, 412×915), keyboard focus, state timing, reduced motion and screenshots before merge.</p>
    </details>
  </main>
</Base>
<style>
  :global(html), :global(body) { margin:0; min-height:100%; background:#08090b; }
  :global(body) { overflow-x:hidden; }
  .film { box-sizing:border-box; min-height:100dvh; background:#08090b; color:#e3e5e4; font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, monospace; padding:clamp(14px,2vw,32px); }
  .film *, .film *::before, .film *::after { box-sizing:border-box; }
  .film__top {display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin:0 auto 15px;max-width:1400px;}
  h1 {font-family: 'Space Grotesk',sans-serif; font-size:clamp(20px,3vw,42px);letter-spacing:-.04em;margin:6px 0 0;}
  .eyebrow,.film__back,.film__hud,.film__watermark,.film__help {font-size:10px;letter-spacing:.11em;color:#99a3a5;}
  .film__back {text-decoration:none;border:1px solid #555;padding:10px;white-space:nowrap;}
  .film__back:hover,.film button:hover {border-color:#d4f974;color:#d4f974;}
  .film__stage {position:relative;isolation:isolate;overflow:hidden;min-height:360px;height:min(62dvh,720px);border:1px solid #3a4245;background:#08090b;max-width:1400px;margin:auto;}
  .film__grid {position:absolute;inset:0;background-image:linear-gradient(#a6c1c209 1px,transparent 1px),linear-gradient(90deg,#a6c1c209 1px,transparent 1px);background-size:36px 36px;}
  .film__visual {position:absolute;inset:0;display:grid;place-items:center;--progress:0;--energy:0;--open:0;}
  .film__halo {position:absolute;width:min(60vw,430px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,#d4f97434 0%,#65dacc14 35%,transparent 70%);opacity:var(--energy);transform:scale(calc(.5 + var(--progress) * 1.5));filter:blur(35px);}
  .film__ring {position:absolute;width:min(55vw,380px);aspect-ratio:1;border:1px solid #c3f683;border-radius:50%;opacity:var(--energy);transform:scale(calc(.3 + var(--progress)*1.5));}
  .film__ring--inner {width:min(36vw,240px);border-color:#84e5dc;transform:rotate(45deg) scale(calc(.45 + var(--progress)*1.5));}
  .film__core {width:clamp(12px,5vw,62px);aspect-ratio:1;background:#d4f974;box-shadow:0 0 45px #b9fa7588;clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%);opacity:var(--energy);transform:scale(calc(.25 + var(--progress)*2.2));}
  .film__horizon {position:absolute;left:0;right:0;top:50%;height:1px;background:#d4f974;opacity:var(--open);box-shadow:0 0 35px 7px #d4f9746b;transform:scaleY(calc(1 + var(--open)*120));}
  .film__hud {position:absolute;inset:15px 18px auto;display:flex;justify-content:space-between;gap:10px;}
  .film__caption {position:absolute;bottom:25px;left:clamp(17px,5vw,70px);max-width:calc(100% - 40px);}
  .film__caption>span {display:block;color:#d4f974;font-size:11px;margin-bottom:8px;}
  .film__caption strong {font-family:'Space Grotesk',sans-serif;font-size:clamp(38px,8vw,110px);line-height:1;letter-spacing:-.06em;display:block;max-width:100%;overflow-wrap:anywhere;}
  .film__caption p {font-size:11px;letter-spacing:.14em;color:#a9b8b3;margin-top:10px;}
  .film__watermark {position:absolute;right:15px;bottom:10px;font-size:9px;}
  .film__controls,.film__provenance {max-width:1400px;margin:18px auto 0;}
  .film__buttons {display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;}
  .film button {cursor:pointer;background:transparent;color:#e3e5e4;border:1px solid #596164;padding:11px 16px;font:inherit;font-size:11px;}
  .film button:focus-visible,.film a:focus-visible,.film input:focus-visible,.film summary:focus-visible {outline:3px solid #d4f974;outline-offset:3px;}
  .film__controls label {display:flex;justify-content:space-between;font-size:11px;letter-spacing:.08em;}
  .film input[type=range] {width:100%;accent-color:#d4f974;cursor:pointer;}
  .film__ticks {display:flex;width:100%;gap:2px;}
  .film__ticks span {border-top:2px solid #4e6e67;padding-top:5px;font-size:9px;overflow:hidden;white-space:nowrap;color:#a5b0b0;}
  .film__help {line-height:1.7;letter-spacing:0;margin-top:18px;}
  .film__provenance {border-top:1px solid #394145;padding-top:15px;font-size:11px;line-height:1.7;}
  .film__provenance summary {cursor:pointer;letter-spacing:.15em;color:#d4f974;}
  .film__provenance dl>div {display:grid;grid-template-columns:120px minmax(0,1fr);gap:10px;border-bottom:1px solid #2c3436;padding:6px 0;}
  .film__provenance dt {color:#94a3a2}.film__provenance dd {margin:0;overflow-wrap:anywhere;}
  @media(max-width:600px){.film__stage{height:52dvh;min-height:300px}.film__caption{bottom:32px}.film__watermark{font-size:8px}.film__ticks span{font-size:7px}.film__provenance dl>div{grid-template-columns:80px minmax(0,1fr)}}
  @media(prefers-reduced-motion:reduce){.film__visual *{transition:none!important;animation:none!important}}
</style>
<script>
  import { SIGNAL_THRESHOLD, frameAt, stageIndexAt } from '../../../../lib/kodex/motion-lab/signal-threshold.mjs';
  const root = document.querySelector('[data-kdx-film]');
  if (root) {
    const stages = SIGNAL_THRESHOLD.stages;
    const duration=SIGNAL_THRESHOLD.total, scene=root.querySelector('[data-film-stage]');
    const visual=root.querySelector('.film__visual');
    const seek=root.querySelector('[data-seek]');
    const play=root.querySelector('[data-play]');
    const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
    const $=(q)=>root.querySelector(q);
    let t=0, playing=false, previous=0, handle=0;
    const clamp=(n,a,b)=>Math.max(a,Math.min(b,n));
    const activeIndex=()=>stageIndexAt(t);
    function render() {
      const {index:i, stage:s, energy, progress, open} = frameAt(t, SIGNAL_THRESHOLD, reduced.matches);
      scene.dataset.state=s.id.split(' ')[0];
      $('[data-state-label]').textContent=s.id;
      $('[data-state-note]').textContent=s.note;
      $('[data-number]').textContent=String(i+1).padStart(2,'0')+' / 05';
      $('[data-clock]').textContent='00:'+t.toFixed(2).padStart(5,'0')+' / 00:14.00';
      $('[data-seek-label]').textContent=t.toFixed(2)+'s';
      seek.value=String(t);
      visual.style.setProperty('--energy',String(energy));
      visual.style.setProperty('--progress',String(progress));
      visual.style.setProperty('--open',String(open));
    }
    function pause(){playing=false;cancelAnimationFrame(handle);play.textContent='▶ PLAY';play.setAttribute('aria-pressed','false');}
    function jump(time){t=clamp(time,0,duration);render();}
    function tick(now){if(!playing)return;const dt=previous?Math.max(0,(now-previous)/1000):0;previous=now;jump(t+dt);if(t>=duration){pause();return;}handle=requestAnimationFrame(tick);}
    function start(){if(t>=duration)jump(0);if(reduced.matches){jump(stages[Math.min(activeIndex()+1,stages.length-1)].start);return;}playing=true;previous=0;play.textContent='Ⅱ PAUSE';play.setAttribute('aria-pressed','true');handle=requestAnimationFrame(tick);}
    play.addEventListener('click',()=>playing?pause():start());
    $('[data-reset]').addEventListener('click',()=>{pause();jump(0);});
    $('[data-prev]').addEventListener('click',()=>{pause();const i=activeIndex();jump(stages[Math.max(0,t>stages[i].start+.15?i:i-1)].start);});
    $('[data-next]').addEventListener('click',()=>{pause();jump(stages[Math.min(stages.length-1,activeIndex()+1)].start);});
    seek.addEventListener('input',()=>{pause();jump(Number(seek.value));});
    reduced.addEventListener('change',()=>{pause();render();});
    document.addEventListener('visibilitychange',()=>{if(document.hidden)pause();});
    document.addEventListener('keydown',(e)=>{
      if(e.altKey||e.ctrlKey||e.metaKey||['INPUT','TEXTAREA','SELECT','BUTTON','SUMMARY'].includes(document.activeElement?.tagName) || document.activeElement?.isContentEditable)return;
      if(e.code==='Space'){e.preventDefault();playing?pause():start();}
      if(e.key==='ArrowRight'){e.preventDefault();$('[data-next]').click();}
      if(e.key==='ArrowLeft'){e.preventDefault();$('[data-prev]').click();}
      if(e.key==='Home'){e.preventDefault();pause();jump(0);}
      if(e.key==='End'){e.preventDefault();pause();jump(duration);}
    });
    render();
  }
</script>
