---
import Base from '../../../layouts/Base.astro';
import KodexHoloCoreRGX from '../../../components/kodex/holocore/KodexHoloCoreRGX.astro';
---

<Base
  title="KODEX−∞ · HoloCore RGX Lab"
  description="Internal code-native reference-grounded HoloCore fidelity test."
  robots="noindex, nofollow"
  kodexFonts={true}
  noNav={true}
  noFooter={true}
  noOverlays={true}
  noQuote={true}
  noThemes={true}
  noKai={true}
  noCart={true}
  noImmersive={true}
>
  <main class="rgx-lab" aria-labelledby="rgx-title">
    <header class="rgx-lab__header">
      <div>
        <p>KODEX−∞ // SYSTEMS LAB // HOLOCORE FIDELITY TEST</p>
        <h1 id="rgx-title">ORBITAL CITY / RGX</h1>
      </div>
      <dl>
        <div><dt>METHOD</dt><dd>CODE RE-EXECUTION</dd></div>
        <div><dt>RASTER</dt><dd>MICROGLYPH</dd></div>
        <div><dt>STRUCTURE</dt><dd>VECTOR SCAFFOLD</dd></div>
        <div><dt>SOURCE PIXELS</dt><dd>NONE</dd></div>
      </dl>
    </header>

    <aside class="rgx-lab__rail rgx-lab__rail--left">
      <span>REFERENCE LOCK</span>
      <strong>AXIS</strong>
      <strong>STRATA</strong>
      <strong>HABITAT RING</strong>
      <strong>NODES</strong>
      <strong>PLANET</strong>
    </aside>

    <section class="rgx-lab__core" aria-label="Reference-grounded HoloCore code emulation">
      <KodexHoloCoreRGX />
    </section>

    <aside class="rgx-lab__rail rgx-lab__rail--right">
      <span>QA CONTRACT</span>
      <strong>24 S SEAM</strong>
      <strong>100DVH</strong>
      <strong>MOBILE BOUND</strong>
      <strong>REDUCED MOTION</strong>
      <strong>DENSITY ≥ 200 COL</strong>
    </aside>

    <footer class="rgx-lab__footer">
      <span>REFERENCE → TOPOLOGY → FIELD → MICROGLYPH</span>
      <strong>THE IMAGE IS NOT DISPLAYED. THE STRUCTURE IS EXECUTED.</strong>
    </footer>
  </main>
</Base>

<style is:global>
  html:has(.rgx-lab), body:has(.rgx-lab) {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow: hidden;
    background: #020204;
  }
</style>

<style>
  .rgx-lab {
    box-sizing: border-box;
    width: 100%;
    height: 100dvh;
    display: grid;
    grid-template-columns: clamp(58px, 7vw, 92px) minmax(0, 1fr) clamp(68px, 8vw, 108px);
    grid-template-rows: clamp(74px, 10vh, 104px) minmax(0, 1fr) clamp(44px, 6vh, 62px);
    grid-template-areas:
      'header header header'
      'left core right'
      'footer footer footer';
    padding: 8px;
    overflow: hidden;
    color: #eeeaf2;
    background: radial-gradient(circle at 50% 50%, rgba(112,70,157,.06), transparent 44%), #020204;
    font-family: 'Share Tech Mono', ui-monospace, monospace;
  }

  .rgx-lab__header {
    grid-area: header;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 0 14px;
    border: 1px solid rgba(255,255,255,.08);
  }
  .rgx-lab__header p { margin: 0; font-size: 7px; letter-spacing: .15em; color: rgba(236,230,243,.46); }
  .rgx-lab h1 {
    margin: 5px 0 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-size: clamp(28px, 4vw, 58px);
    font-weight: 400;
    line-height: .9;
    letter-spacing: .08em;
  }
  .rgx-lab dl { margin: 0; display: grid; grid-template-columns: auto auto; gap: 4px 12px; font-size: 6px; letter-spacing: .08em; }
  .rgx-lab dt { color: rgba(236,230,243,.35); }
  .rgx-lab dd { margin: 0; color: rgba(196,157,239,.78); }

  .rgx-lab__core { grid-area: core; min-width: 0; min-height: 0; padding: 10px; }
  .rgx-lab__rail {
    min-height: 0;
    padding: 10px 7px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 15px;
    overflow: hidden;
    font-size: 6px;
    letter-spacing: .1em;
  }
  .rgx-lab__rail span { color: rgba(236,230,243,.32); }
  .rgx-lab__rail strong { color: rgba(205,179,233,.58); font-weight: 500; }
  .rgx-lab__rail--left { grid-area: left; border-right: 1px solid rgba(255,255,255,.07); }
  .rgx-lab__rail--right { grid-area: right; border-left: 1px solid rgba(255,255,255,.07); }

  .rgx-lab__footer {
    grid-area: footer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 14px;
    border: 1px solid rgba(255,255,255,.08);
    font-size: 6px;
    letter-spacing: .1em;
    color: rgba(236,230,243,.44);
  }
  .rgx-lab__footer strong { font-weight: 500; color: rgba(213,193,234,.66); }

  @media (max-width: 700px) {
    .rgx-lab {
      grid-template-columns: 34px minmax(0, 1fr) 40px;
      grid-template-rows: 70px minmax(0, 1fr) 48px;
      padding: 5px;
    }
    .rgx-lab__header { padding: 0 7px; }
    .rgx-lab__header dl { display: none; }
    .rgx-lab h1 { font-size: clamp(23px, 8vw, 36px); }
    .rgx-lab__header p { font-size: 5px; }
    .rgx-lab__core { padding: 5px; }
    .rgx-lab__rail { padding: 4px; gap: 9px; }
    .rgx-lab__rail strong, .rgx-lab__rail span { writing-mode: vertical-rl; font-size: 5px; }
    .rgx-lab__footer { padding: 0 6px; font-size: 5px; }
    .rgx-lab__footer strong { display: none; }
  }
</style>
