---
import Base from '../../../layouts/Base.astro';
import {
  KODEX_V0_CHECKPOINTS,
  KODEX_V0_RELEASE_GATES,
  v0Readiness,
  validateV0Manifest,
} from '../../../lib/kodex/v0-vertical-slice.js';

const readiness = v0Readiness();
const validation = validateV0Manifest();
---

<Base
  title="KODEX Lab — V0 Readiness"
  description="Internal noindex KODEX tangible V0 readiness manifest."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="v0">
    <header class="v0__header">
      <div>
        <p>KODEX−∞ / TANGIBLE V0</p>
        <h1>WHAT IS REAL.<br />WHAT IS BLOCKED.</h1>
      </div>
      <dl>
        <div><dt>MANIFEST</dt><dd>{validation.valid ? 'PASS' : 'FAIL'}</dd></div>
        <div><dt>CHECKPOINTS</dt><dd>{readiness.checkpointCount}</dd></div>
        <div><dt>BLOCKED</dt><dd>{readiness.blocked.length}</dd></div>
        <div><dt>PRODUCTION</dt><dd>{readiness.productionReady ? 'READY' : 'NO'}</dd></div>
      </dl>
    </header>

    <section class="v0__timeline" aria-label="V0 journey checkpoints">
      {KODEX_V0_CHECKPOINTS.map((item, index) => (
        <article class="checkpoint" data-status={item.status}>
          <div class="checkpoint__index">{String(index + 1).padStart(2, '0')}</div>
          <div>
            <p>{item.id} / {item.scene.toUpperCase()}</p>
            <h2>{item.label}</h2>
            <strong>{item.status}</strong>
            <div class="checkpoint__cols">
              <div><h3>ACCEPTANCE</h3><ul>{item.required.map((rule) => <li>{rule}</li>)}</ul></div>
              <div><h3>BLOCKERS</h3><ul>{item.blockers.map((rule) => <li>{rule}</li>)}</ul></div>
            </div>
            <a href={item.href}>OPEN CURRENT IMPLEMENTATION ↗</a>
          </div>
        </article>
      ))}
    </section>

    <section class="v0__gates" aria-labelledby="gate-title">
      <p>RELEASE CONTRACT</p>
      <h2 id="gate-title">GATES</h2>
      <div>
        {KODEX_V0_RELEASE_GATES.map((gate) => (
          <article data-status={gate.status}>
            <span>{gate.id}</span><strong>{gate.label}</strong><em>{gate.status}</em>
          </article>
        ))}
      </div>
    </section>

    <footer>
      <a href="/kodex/lab/scene-registry/">SCENE REGISTRY ↗</a>
      <a href="/kodex/lab/archive-evidence/">ARCHIVE EVIDENCE ↗</a>
      <p>DEPLOYMENT REMAINS LOCKED. THIS SURFACE CANNOT AUTHORIZE RELEASE.</p>
    </footer>
  </main>
</Base>

<style>
  :global(body){margin:0;background:#050505;color:#f0ede5;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.v0{min-height:100dvh;padding:clamp(20px,4vw,64px);background:radial-gradient(circle at 80% 0,#15111c 0,#050505 34%)}
  .v0__header{display:grid;grid-template-columns:1fr auto;gap:32px;align-items:end;padding-bottom:28px;border-bottom:1px solid #39363e}.v0__header>div>p,.v0__gates>p{margin:0 0 8px;font-size:9px;letter-spacing:.18em;opacity:.5}h1{margin:0;font-size:clamp(40px,8vw,100px);line-height:.86;letter-spacing:-.06em;font-weight:520}.v0__header dl{display:grid;grid-template-columns:repeat(2,minmax(110px,1fr));gap:16px;margin:0}dl div{display:grid;gap:5px}dt{font-size:8px;letter-spacing:.14em;opacity:.45}dd{margin:0;font-size:11px}
  .v0__timeline{border-top:1px solid #26242a;margin-top:42px}.checkpoint{display:grid;grid-template-columns:minmax(54px,8vw) 1fr;gap:10px;padding:28px 0;border-bottom:1px solid #26242a}.checkpoint__index{font-size:clamp(24px,5vw,58px);color:#ad9cff}.checkpoint p{margin:0 0 6px;font-size:9px;letter-spacing:.13em;opacity:.5}.checkpoint h2{margin:0 0 12px;font-size:clamp(26px,4vw,52px);letter-spacing:-.035em}.checkpoint>div>strong{display:inline-block;padding:5px 8px;border:1px solid #4e4955;font-size:9px;color:#c6bbff}.checkpoint[data-status^='BLOCKED']>div>strong{border-color:#8c555e;color:#ffadb8}.checkpoint__cols{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin:22px 0}.checkpoint h3{font-size:8px;letter-spacing:.15em;opacity:.45}.checkpoint li{margin:6px 0;font-size:10px;line-height:1.5;opacity:.72}.checkpoint a,footer a{color:inherit;font-size:9px;letter-spacing:.1em}
  .v0__gates{padding:60px 0}.v0__gates h2{margin:0 0 24px;font-size:48px}.v0__gates>div{border:1px solid #302d34}.v0__gates article{display:grid;grid-template-columns:120px 1fr auto;gap:20px;align-items:center;padding:14px;border-bottom:1px solid #302d34}.v0__gates article:last-child{border-bottom:0}.v0__gates span,.v0__gates em{font-size:9px;letter-spacing:.1em;opacity:.55}.v0__gates strong{font-size:10px;font-weight:500}.v0__gates em{font-style:normal}.v0__gates article[data-status='LOCKED'] em{color:#ff9aa6;opacity:1}
  footer{display:flex;gap:20px;flex-wrap:wrap;padding-top:20px;border-top:1px solid #39363e}footer p{width:100%;font-size:9px;letter-spacing:.1em;opacity:.45}
  @media(max-width:760px){.v0__header{grid-template-columns:1fr}.checkpoint__cols{grid-template-columns:1fr}.v0__gates article{grid-template-columns:1fr}.v0__header dl{grid-template-columns:1fr 1fr}}
</style>
