---
import KodexManifestationCore from '../../../components/kodex/holocore/KodexManifestationCore.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>KODEX Manifestation Engine Lab</title>
  </head>
  <body>
    <main class="manifest-lab" data-manifestation-lab>
      <section class="manifest-lab__core" aria-label="Manifestation state visualization">
        <KodexManifestationCore />
      </section>

      <aside class="manifest-lab__panel">
        <header>
          <p>KODEX−∞ / INTERNAL LAB</p>
          <h1>MANIFESTATION ENGINE</h1>
          <span>CAUSAL STATE / EXPLICIT BLOCKERS / NO METAPHYSICAL CLAIM</span>
        </header>

        <div class="manifest-lab__status" aria-live="polite">
          <div><span>PHASE</span><strong data-lab-phase>POTENTIAL</strong></div>
          <div><span>SPECIMEN</span><strong data-lab-specimen>SOURCE CHAMBER</strong></div>
          <div><span>CAUSAL LOAD</span><strong data-lab-load>0.00</strong></div>
          <div><span>TRACE</span><strong data-lab-trace>0</strong></div>
        </div>

        <div class="manifest-lab__controls" aria-label="Manifestation controls">
          <button type="button" data-action="declare">01 / DECLARE INTENT</button>
          <button type="button" data-action="signal">02 / EMIT SIGNAL</button>
          <button type="button" data-action="blocker" data-blocker="evidence">+ MISSING EVIDENCE</button>
          <button type="button" data-action="blocker" data-blocker="creator">+ CREATOR ACCEPTANCE</button>
          <button type="button" data-action="blocker" data-blocker="runtime">+ RUNTIME GATE</button>
          <button type="button" data-action="resolve">03 / RESOLVE BLOCKERS</button>
          <button type="button" data-action="transform">04 / BEGIN TRANSFORMATION</button>
          <button type="button" data-action="realize">05 / REALIZE</button>
          <button type="button" data-action="trace">06 / WRITE TRACE</button>
          <button type="button" data-action="reset">RESET</button>
        </div>

        <div class="manifest-lab__truth">
          <strong>TRUTH BOUNDARY</strong>
          <p>This lab models software state and explicit production constraints. It does not predict physical manifestation or infer psychology, spirituality, biometrics or intent strength.</p>
        </div>

        <div class="manifest-lab__event" data-lab-event>READY</div>
      </aside>
    </main>

    <script>
      const lab = document.querySelector('[data-manifestation-lab]');
      const core = document.querySelector('[data-kdx-manifestation-core]');
      if (lab instanceof HTMLElement && core instanceof HTMLElement) {
        const phase = lab.querySelector('[data-lab-phase]');
        const specimen = lab.querySelector('[data-lab-specimen]');
        const load = lab.querySelector('[data-lab-load]');
        const trace = lab.querySelector('[data-lab-trace]');
        const eventLine = lab.querySelector('[data-lab-event]');

        const blockers = {
          evidence: {
            id: 'lab-missing-evidence',
            type: 'MISSING_EVIDENCE',
            label: 'Browser evidence missing',
            severity: 0.78,
            sourceRef: 'KOD-67',
          },
          creator: {
            id: 'lab-creator-acceptance',
            type: 'CREATOR_ACCEPTANCE',
            label: 'Creator visual acceptance pending',
            severity: 0.62,
            sourceRef: 'KOD-67',
          },
          runtime: {
            id: 'lab-runtime-gate',
            type: 'RUNTIME_GATE',
            label: 'Runtime gate unresolved',
            severity: 0.48,
            sourceRef: 'KOD-67',
          },
        };

        const send = detail => {
          core.dispatchEvent(new CustomEvent('kdx:manifestation:event', { detail }));
          if (eventLine) eventLine.textContent = detail.type;
        };

        core.addEventListener('kdx:manifestation:view', event => {
          const detail = event.detail || {};
          if (phase) phase.textContent = detail.phase || '—';
          if (specimen) specimen.textContent = String(detail.visualSpecimenId || '—').replaceAll('-', ' ').toUpperCase();
          if (load) load.textContent = Number(detail.causalLoad || 0).toFixed(2);
          if (trace) trace.textContent = String(detail.traceLength || 0);
          lab.dataset.phase = detail.phase || '';
          lab.dataset.specimen = detail.visualSpecimenId || '';
          lab.dataset.blocked = String(Boolean(detail.blocked));
        });

        lab.querySelectorAll('button[data-action]').forEach(button => {
          button.addEventListener('click', () => {
            const action = button.dataset.action;
            if (action === 'declare') {
              send({
                type: 'DECLARE_INTENT',
                intentId: 'KDX-LAB-INTENT-001',
                intent: 'MATERIALIZE VERIFIED KODEX FORM',
                nodeId: 'KDX-NODE-PORTAL-RING',
                at: performance.timeOrigin + performance.now(),
              });
            }
            if (action === 'signal') send({ type: 'EMIT_SIGNAL' });
            if (action === 'blocker') {
              const blocker = blockers[button.dataset.blocker];
              if (blocker) send({ type: 'ADD_BLOCKER', blocker });
            }
            if (action === 'resolve') {
              Object.values(blockers).forEach(blocker => send({ type: 'RESOLVE_BLOCKER', blockerId: blocker.id }));
            }
            if (action === 'transform') send({ type: 'BEGIN_TRANSFORMATION' });
            if (action === 'realize') send({ type: 'REALIZE', at: performance.timeOrigin + performance.now() });
            if (action === 'trace') send({
              type: 'WRITE_TRACE',
              routeSignature: 'KDX-LAB-ROUTE',
              memoryRef: 'KOD-67',
            });
            if (action === 'reset') send({ type: 'RESET' });
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; background: #020205; }
  * { box-sizing: border-box; }
  html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #020205; }
  body { font-family: 'Share Tech Mono', ui-monospace, monospace; color: #ece8ef; }

  .manifest-lab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 12px;
    width: 100%;
    height: 100dvh;
    min-height: 0;
    padding: 12px;
    overflow: hidden;
    background:
      linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.015) 1px, transparent 1px),
      #020205;
    background-size: 32px 32px;
  }

  .manifest-lab__core { min-width: 0; min-height: 0; }

  .manifest-lab__panel {
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto auto;
    gap: 10px;
    padding: 12px;
    border: 1px solid rgba(255,255,255,.16);
    background: rgba(3,3,7,.94);
    overflow: hidden;
  }

  .manifest-lab__panel header p,
  .manifest-lab__panel header span,
  .manifest-lab__truth,
  .manifest-lab__event {
    margin: 0;
    font-size: 8px;
    line-height: 1.4;
    letter-spacing: .12em;
    color: rgba(236,232,239,.52);
  }

  .manifest-lab__panel h1 {
    margin: 6px 0 4px;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: .08em;
  }

  .manifest-lab__status {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: rgba(255,255,255,.12);
  }

  .manifest-lab__status div {
    min-width: 0;
    display: grid;
    gap: 4px;
    padding: 8px;
    background: #05050a;
  }

  .manifest-lab__status span { font-size: 7px; letter-spacing: .12em; color: rgba(255,255,255,.42); }
  .manifest-lab__status strong { overflow: hidden; text-overflow: ellipsis; font-size: 9px; font-weight: 500; color: #e8dfb9; }

  .manifest-lab__controls {
    min-height: 0;
    display: grid;
    align-content: start;
    gap: 5px;
    overflow: auto;
    scrollbar-width: thin;
  }

  .manifest-lab__controls button {
    width: 100%;
    min-height: 34px;
    padding: 8px 9px;
    border: 1px solid rgba(255,255,255,.14);
    color: rgba(244,240,247,.82);
    background: rgba(255,255,255,.025);
    font: inherit;
    font-size: 8px;
    letter-spacing: .08em;
    text-align: left;
    cursor: pointer;
  }

  .manifest-lab__controls button:hover,
  .manifest-lab__controls button:focus-visible {
    border-color: #e8dfb9;
    color: #fff;
    outline: none;
  }

  .manifest-lab__truth {
    padding-top: 8px;
    border-top: 1px solid rgba(255,255,255,.1);
  }
  .manifest-lab__truth strong { color: #e8dfb9; font-weight: 500; }
  .manifest-lab__truth p { margin: 4px 0 0; }

  .manifest-lab__event {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 700px) {
    .manifest-lab {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) 270px;
      gap: 8px;
      padding: 8px;
    }

    .manifest-lab__panel {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: 7px;
      padding: 8px;
    }

    .manifest-lab__panel header { grid-column: 1 / -1; }
    .manifest-lab__panel header span { display: none; }
    .manifest-lab__panel h1 { margin: 3px 0 0; font-size: 13px; }
    .manifest-lab__status { grid-template-columns: 1fr 1fr; }
    .manifest-lab__controls { grid-row: 2 / 4; grid-column: 2; }
    .manifest-lab__controls button { min-height: 31px; padding: 6px 7px; font-size: 7px; }
    .manifest-lab__truth { grid-column: 1; }
    .manifest-lab__event { grid-column: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; }
  }
</style>
