---
import Base from '../../../../layouts/Base.astro';
import KodexPlateSpecRenderer from '../../../../components/kodex/grammar/KodexPlateSpecRenderer.astro';
import { KDX_GOLDEN_PLATE_CASES } from '../../../../lib/kodex/grammar/golden-plate-benchmark.v0.1.js';
import { assemblePlateSpec } from '../../../../lib/kodex/grammar/deterministic-assembler.js';
import { compilePlateRenderModel } from '../../../../lib/kodex/grammar/plate-render-model.js';

export function getStaticPaths() {
  return KDX_GOLDEN_PLATE_CASES.map((entry) => {
    const spec = assemblePlateSpec(entry.node, entry.plate_type, entry.seed);
    const model = compilePlateRenderModel(spec);
    return {
      params: { case: entry.case_id.toLowerCase() },
      props: { entry, model },
    };
  });
}

const { entry, model } = Astro.props;
---

<Base
  title={`KODEX Golden Plate — ${entry.case_id}`}
  description={`Internal deterministic Assembly OS rendered benchmark plate ${entry.case_id}.`}
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="kdx-golden-shell" data-kdx-golden-plate>
    <KodexPlateSpecRenderer
      model={model}
      domain={entry.domain}
      caseId={entry.case_id}
    />
  </main>
</Base>

<style is:global>
  html:has(.kdx-golden-shell), body:has(.kdx-golden-shell) { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #070808; }
  .kdx-golden-shell { width: 100%; height: 100dvh; min-height: 100dvh; overflow: hidden; }
</style>
