---
import Base from '../../../../layouts/Base.astro';
import KodexPlateSpecRenderer from '../../../../components/kodex/grammar/KodexPlateSpecRenderer.astro';
import { assemblePlateSpec } from '../../../../lib/kodex/grammar/deterministic-assembler.js';
import { KDX_GOLDEN_PLATE_CASES } from '../../../../lib/kodex/grammar/golden-plate-benchmark.v0.1.js';
import { compilePlateRenderModel } from '../../../../lib/kodex/grammar/plate-render-model.js';
import '../../../../styles/kodex-golden-curatorial.css';

export function getStaticPaths() {
  return KDX_GOLDEN_PLATE_CASES.map((entry) => ({
    params: { case_id: entry.case_id.toLowerCase() },
    props: { caseId: entry.case_id, domain: entry.domain, node: entry.node, plateType: entry.plate_type, seed: entry.seed },
  }));
}

const { caseId, domain, node, plateType, seed } = Astro.props;
const plateSpec = assemblePlateSpec(node, plateType, seed);
const renderModel = compilePlateRenderModel(plateSpec);
---

<Base
  title={`KODEX Golden Plate — ${caseId}`}
  description="Internal Assembly OS Golden Plate render benchmark."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="kdx-golden-lab" data-kdx-golden-plate data-case-id={caseId}>
    <KodexPlateSpecRenderer model={renderModel} caseId={caseId} domain={domain} />
  </main>
</Base>

<style is:global>
  html:has(.kdx-golden-lab), body:has(.kdx-golden-lab) {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #070808;
  }
  .kdx-golden-lab {
    width: 100vw;
    height: 100dvh;
    min-height: 100dvh;
    max-height: 100dvh;
    overflow: hidden;
  }
</style>
