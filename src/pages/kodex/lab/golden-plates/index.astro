---
import Base from '../../../../layouts/Base.astro';
import { KDX_GOLDEN_PLATE_CASES, getGoldenPlateBenchmarkSummary } from '../../../../lib/kodex/grammar/golden-plate-benchmark.v0.1.js';
const summary = getGoldenPlateBenchmarkSummary();
---

<Base
  title="KODEX Assembly OS — Golden Plate Benchmark"
  description="Internal 12-plate deterministic Assembly OS render benchmark."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="kdx-golden-index" data-kdx-golden-index>
    <header>
      <p>KODEX−∞ / ASSEMBLY OS / INTERNAL BENCHMARK</p>
      <h1>12 GOLDEN PLATES</h1>
      <div class="stats">
        <span>{summary.total} CASES</span>
        <span>4 DOMAINS</span>
        <span>{summary.protectedArtworkActivators} PROTECTED ART ACTIVATORS</span>
        <span>{summary.livingFieldActivators} LIVING FIELD ACTIVATOR</span>
      </div>
    </header>

    <section aria-label="Golden Plate cases">
      {KDX_GOLDEN_PLATE_CASES.map((entry, index) => (
        <a href={`/kodex/lab/golden-plates/${entry.case_id.toLowerCase()}/`}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div><strong>{entry.case_id}</strong><small>{entry.domain.toUpperCase()} · {entry.plate_type}</small></div>
          <code>{entry.node_id}</code>
          <b>OPEN →</b>
        </a>
      ))}
    </section>

    <footer>
      <p>CONTRACT/FATORY STATUS ≠ VISUAL ACCEPTANCE. Protected artwork bytes remain withheld unless explicitly permitted.</p>
      <p>HUMAN CURATOR ACCEPTANCE: NOT_RUN</p>
    </footer>
  </main>
</Base>

<style is:global>
  html:has(.kdx-golden-index), body:has(.kdx-golden-index) { margin: 0; width: 100%; min-height: 100%; background: #070808; color: #f2f3ee; }
  .kdx-golden-index { min-height: 100dvh; padding: clamp(1rem, 3vw, 2.5rem); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
  .kdx-golden-index header { border-bottom: 1px solid #343836; padding-bottom: 1.25rem; }
  .kdx-golden-index header p, .kdx-golden-index footer { color: #8c9491; font-size: .68rem; letter-spacing: .1em; }
  .kdx-golden-index h1 { margin: .35rem 0 1rem; font: 500 clamp(2.5rem, 8vw, 7rem)/.9 ui-sans-serif, system-ui, sans-serif; letter-spacing: -.06em; }
  .kdx-golden-index .stats { display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; color: #d7ff4f; font-size: .65rem; }
  .kdx-golden-index section { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 1rem; border-top: 1px solid #242826; border-left: 1px solid #242826; }
  .kdx-golden-index section a { min-height: 6rem; padding: .8rem; border-right: 1px solid #242826; border-bottom: 1px solid #242826; color: inherit; text-decoration: none; display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto auto; align-items: center; gap: .8rem; }
  .kdx-golden-index section a:hover, .kdx-golden-index section a:focus-visible { outline: none; background: #0e1110; box-shadow: inset 0 0 0 1px #d7ff4f; }
  .kdx-golden-index a > span, .kdx-golden-index a small, .kdx-golden-index a code { color: #7f8784; font-size: .62rem; }
  .kdx-golden-index a div { display: grid; gap: .3rem; }
  .kdx-golden-index a b { color: #d7ff4f; font-size: .65rem; font-weight: 500; }
  .kdx-golden-index footer { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1rem; }
  @media (max-width: 760px) {
    .kdx-golden-index section { grid-template-columns: 1fr; }
    .kdx-golden-index section a { grid-template-columns: 1.7rem minmax(0, 1fr) auto; }
    .kdx-golden-index section a code { display: none; }
    .kdx-golden-index footer { display: grid; }
  }
</style>
