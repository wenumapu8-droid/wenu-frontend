---
import Base from '../../../layouts/Base.astro';
import { scenes } from '../../../lib/kodexScenes.js';

const domains = ['SIGNAL', 'MATTER', 'MEMORY', 'OBSERVER'];
const processes = ['POTENTIAL', 'FORM', 'INTERACTION', 'MUTATION', 'DISSOLUTION', 'RETURN'];
---

<Base
  title="KODEX Lab — Semantic Relation Wheel"
  description="Internal noindex proof translating nested radial taxonomy, inertial spin and fracture/return interaction into KODEX semantics."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="kdx-rwheel" data-kdx-wheel data-state="DORMANT">
    <header class="kdx-rwheel__head">
      <div>
        <p>KODEX−∞ / LAB / REF-UX-003</p>
        <h1>RELATION WHEEL</h1>
      </div>
      <dl>
        <div><dt>STATE</dt><dd data-state>DORMANT</dd></div>
        <div><dt>INPUT</dt><dd>DRAG / FLICK</dd></div>
        <div><dt>MODEL</dt><dd>3 RINGS</dd></div>
      </dl>
    </header>

    <section class="kdx-rwheel__instrument" aria-label="KODEX semantic relation instrument">
      <div class="kdx-rwheel__axis" aria-hidden="true"><i></i><span>ACTIVE ALIGNMENT</span></div>

      <div
        class="kdx-rwheel__stage"
        data-wheel-stage
        role="application"
        tabindex="0"
        aria-label="Drag or flick to rotate the KODEX relation wheel. Left and right arrow keys also rotate it."
      >
        <div class="kdx-ring kdx-ring--domain" data-ring="domain" aria-label="Domain ring">
          <div class="kdx-ring__disc" aria-hidden="true"></div>
          {domains.map((token, index) => (
            <button class="kdx-ring__item" type="button" data-token={token} data-index={index}>
              <span class="kdx-ring__chip"><b>{token}</b><small>DOMAIN</small></span>
            </button>
          ))}
        </div>

        <div class="kdx-ring kdx-ring--process" data-ring="process" aria-label="Process ring">
          <div class="kdx-ring__disc" aria-hidden="true"></div>
          {processes.map((token, index) => (
            <button class="kdx-ring__item" type="button" data-token={token} data-index={index}>
              <span class="kdx-ring__chip"><b>{token}</b><small>PROCESS</small></span>
            </button>
          ))}
        </div>

        <div class="kdx-ring kdx-ring--scene" data-ring="scene" aria-label="Scene ring">
          <div class="kdx-ring__disc" aria-hidden="true"></div>
          {scenes.map((scene, index) => (
            <button
              class="kdx-ring__item"
              type="button"
              data-token={scene.code}
              data-index={index}
              data-href={scene.href}
              style={`--scene-accent:${scene.accentHex}`}
            >
              <span class="kdx-ring__chip"><b>{scene.index}</b><small>{scene.code}</small></span>
            </button>
          ))}
        </div>

        <div class="kdx-rwheel__core" aria-live="polite">
          <span>KDX</span>
          <strong data-core-code>00</strong>
          <small>ALIGN</small>
        </div>
      </div>

      <aside class="kdx-rwheel__readout" aria-label="Current semantic alignment">
        <p>CURRENT ALIGNMENT</p>
        <div class="kdx-rwheel__triad">
          <span data-active-domain>SIGNAL</span>
          <i>×</i>
          <span data-active-process>POTENTIAL</span>
          <i>×</i>
          <span data-active-scene>THRESHOLD</span>
        </div>
        <p class="kdx-rwheel__trace" data-trace>SIGNAL → POTENTIAL → THRESHOLD</p>
        <div class="kdx-rwheel__actions">
          <a data-open-scene href="/kodex/">OPEN CURRENT SCENE ↗</a>
          <button type="button" data-repair hidden>RETURN / REASSEMBLE</button>
        </div>
      </aside>
    </section>

    <footer class="kdx-rwheel__foot">
      <span>DRAG TO RECOMBINE · FLICK FOR INERTIA · FAST INPUT MAY ENTER ANOMALY</span>
      <span>← → ROTATE · ENTER OPEN SCENE · R RETURN</span>
      <span>REFERENCE TRANSLATION · NOT CANON</span>
    </footer>
  </main>
</Base>

<script>
  const root = document.querySelector('[data-kdx-wheel]');
  const stage = root?.querySelector('[data-wheel-stage]');

  if (root && stage instanceof HTMLElement) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ringConfig = {
      domain: { factor: 0.55, radius: 20 },
      process: { factor: -0.8, radius: 33 },
      scene: { factor: 1, radius: 45 },
    };

    let masterAngle = 0;
    let velocity = 0;
    let dragging = false;
    let fractured = false;
    let pointerId = null;
    let lastPointerAngle = 0;
    let lastTime = 0;
    let raf = 0;

    const stateEl = root.querySelector('[data-state]');
    const domainOut = root.querySelector('[data-active-domain]');
    const processOut = root.querySelector('[data-active-process]');
    const sceneOut = root.querySelector('[data-active-scene]');
    const traceOut = root.querySelector('[data-trace]');
    const coreCode = root.querySelector('[data-core-code]');
    const openScene = root.querySelector('[data-open-scene]');
    const repair = root.querySelector('[data-repair]');

    const setState = (value) => {
      root.dataset.state = value;
      if (stateEl) stateEl.textContent = value;
    };

    const norm = (deg) => ((deg % 360) + 360) % 360;
    const signedDelta = (from, to) => {
      let delta = norm(to) - norm(from);
      if (delta > 180) delta -= 360;
      if (delta < -180) delta += 360;
      return delta;
    };

    const pointerAngle = (event) => {
      const r = stage.getBoundingClientRect();
      const x = event.clientX - (r.left + r.width / 2);
      const y = event.clientY - (r.top + r.height / 2);
      return Math.atan2(y, x) * 180 / Math.PI;
    };

    const ringItems = (name) => [...root.querySelectorAll(`[data-ring="${name}"] .kdx-ring__item`)];

    const layoutRing = (name) => {
      const config = ringConfig[name];
      const ring = root.querySelector(`[data-ring="${name}"]`);
      const disc = ring?.querySelector('.kdx-ring__disc');
      const items = ringItems(name);
      const rotation = masterAngle * config.factor;
      if (disc instanceof HTMLElement) disc.style.transform = `rotate(${rotation}deg)`;

      let active = null;
      let best = Infinity;
      items.forEach((item, index) => {
        const base = -90 + index * (360 / items.length);
        const angle = base + rotation;
        const rad = angle * Math.PI / 180;
        const x = 50 + Math.cos(rad) * config.radius;
        const y = 50 + Math.sin(rad) * config.radius;
        item.style.left = `${x}%`;
        item.style.top = `${y}%`;
        const distance = Math.abs(signedDelta(angle, -90));
        const isActive = distance < best;
        if (isActive) {
          if (active) active.removeAttribute('data-active');
          active = item;
          best = distance;
          item.setAttribute('data-active', '');
        } else {
          item.removeAttribute('data-active');
        }
      });
      return active;
    };

    const render = () => {
      const domain = layoutRing('domain');
      const process = layoutRing('process');
      const scene = layoutRing('scene');
      const d = domain?.dataset.token || 'SIGNAL';
      const p = process?.dataset.token || 'POTENTIAL';
      const s = scene?.dataset.token || 'THRESHOLD';
      if (domainOut) domainOut.textContent = d;
      if (processOut) processOut.textContent = p;
      if (sceneOut) sceneOut.textContent = s;
      if (traceOut) traceOut.textContent = `${d} → ${p} → ${s}`;
      if (coreCode) coreCode.textContent = String(scene?.dataset.index ?? '0').padStart(2, '0');
      if (openScene instanceof HTMLAnchorElement) openScene.href = scene?.dataset.href || '/kodex/';
      root.dataset.domain = d;
      root.dataset.process = p;
      root.dataset.scene = s;
    };

    const fracture = () => {
      if (fractured || reduced) return;
      fractured = true;
      velocity = 0;
      setState('ANOMALY');
      root.querySelectorAll('.kdx-ring__item').forEach((item, index) => {
        const sign = index % 2 ? 1 : -1;
        item.style.setProperty('--fracture-x', `${sign * (12 + (index % 4) * 8)}px`);
        item.style.setProperty('--fracture-y', `${((index % 5) - 2) * 11}px`);
        item.style.setProperty('--fracture-r', `${sign * (5 + (index % 3) * 6)}deg`);
      });
      if (repair instanceof HTMLButtonElement) repair.hidden = false;
    };

    const reassemble = () => {
      if (!fractured) return;
      fractured = false;
      velocity = 0;
      setState('RETURN');
      if (repair instanceof HTMLButtonElement) repair.hidden = true;
      window.setTimeout(() => setState('DORMANT'), reduced ? 0 : 720);
    };

    const animate = () => {
      cancelAnimationFrame(raf);
      if (dragging || fractured || reduced || Math.abs(velocity) < 0.001) return;
      masterAngle += velocity * 16.667;
      velocity *= 0.94;
      render();
      raf = requestAnimationFrame(animate);
    };

    const snapItem = (item) => {
      const ring = item.closest('[data-ring]');
      const name = ring?.getAttribute('data-ring');
      if (!name || !(name in ringConfig)) return;
      const items = ringItems(name);
      const index = items.indexOf(item);
      const factor = ringConfig[name].factor;
      const current = -90 + index * (360 / items.length) + masterAngle * factor;
      const delta = signedDelta(current, -90);
      masterAngle += delta / factor;
      velocity = 0;
      render();
      setState('AWARE');
      window.setTimeout(() => { if (!fractured && !dragging) setState('DORMANT'); }, 460);
    };

    stage.addEventListener('pointerdown', (event) => {
      if (fractured) return;
      pointerId = event.pointerId;
      stage.setPointerCapture(pointerId);
      dragging = true;
      cancelAnimationFrame(raf);
      velocity = 0;
      lastPointerAngle = pointerAngle(event);
      lastTime = performance.now();
      setState('AWARE');
    });

    stage.addEventListener('pointermove', (event) => {
      if (!dragging || event.pointerId !== pointerId || fractured) return;
      const now = performance.now();
      const next = pointerAngle(event);
      const delta = signedDelta(lastPointerAngle, next);
      const dt = Math.max(8, now - lastTime);
      masterAngle += delta;
      velocity = delta / dt;
      lastPointerAngle = next;
      lastTime = now;
      render();
    });

    const release = (event) => {
      if (!dragging || event.pointerId !== pointerId) return;
      dragging = false;
      try { stage.releasePointerCapture(pointerId); } catch (_) {}
      pointerId = null;
      const speed = Math.abs(velocity);
      if (!reduced && speed >= 0.72) {
        fracture();
        return;
      }
      setState(speed > 0.04 ? 'OPEN' : 'DORMANT');
      if (!reduced) animate();
      else velocity = 0;
    };

    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);

    root.querySelectorAll('.kdx-ring__item').forEach((item) => {
      item.addEventListener('click', () => {
        if (!fractured) snapItem(item);
      });
    });

    repair?.addEventListener('click', reassemble);

    stage.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        if (fractured) return;
        masterAngle += event.key === 'ArrowLeft' ? -14 : 14;
        velocity = 0;
        render();
        setState('AWARE');
      }
      if ((event.key === 'r' || event.key === 'R') && fractured) {
        event.preventDefault();
        reassemble();
      }
      if (event.key === 'Enter' && openScene instanceof HTMLAnchorElement) {
        event.preventDefault();
        window.location.href = openScene.href;
      }
    });

    render();
    window.__KDX_RELATION_WHEEL__ = {
      reference: 'REF-UX-003',
      getState: () => ({ masterAngle, velocity, fractured, domain: root.dataset.domain, process: root.dataset.process, scene: root.dataset.scene }),
      fracture,
      reassemble,
    };
  }
</script>

<style>
  :global(body){margin:0;overflow:hidden;background:#060706;color:#ecece5;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace}
  .kdx-rwheel{--ink:#ecece5;--muted:#8b8f89;--line:rgba(236,236,229,.16);--signal:#b7ff00;position:relative;width:100vw;height:100dvh;overflow:hidden;background:radial-gradient(circle at 50% 46%,#11140e 0,#080907 38%,#040504 72%);display:grid;grid-template-rows:auto 1fr auto}
  .kdx-rwheel::before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.014) 1px,transparent 1px);background-size:36px 36px;mask-image:radial-gradient(circle at 50% 50%,#000,transparent 75%)}
  .kdx-rwheel__head{position:relative;z-index:5;display:flex;justify-content:space-between;gap:24px;padding:18px 22px;border-bottom:1px solid var(--line);background:rgba(4,5,4,.72);backdrop-filter:blur(14px)}
  .kdx-rwheel__head p,.kdx-rwheel__head h1{margin:0}.kdx-rwheel__head p{font-size:9px;letter-spacing:.24em;color:var(--muted)}.kdx-rwheel__head h1{font-family:'Archivo','Space Grotesk',sans-serif;font-size:clamp(1.15rem,2.4vw,1.8rem);letter-spacing:.08em;margin-top:4px}
  .kdx-rwheel__head dl{display:flex;gap:24px;margin:0}.kdx-rwheel__head dl div{display:grid;gap:3px}.kdx-rwheel__head dt{font-size:8px;letter-spacing:.2em;color:var(--muted)}.kdx-rwheel__head dd{margin:0;font-size:10px;letter-spacing:.12em}
  .kdx-rwheel__instrument{position:relative;min-height:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,29vw);align-items:center;gap:clamp(16px,3vw,48px);padding:clamp(12px,2vh,24px) clamp(16px,3vw,42px)}
  .kdx-rwheel__axis{position:absolute;z-index:4;top:14px;left:calc((100% - minmax(240px,29vw))/2);pointer-events:none;color:var(--signal);font-size:8px;letter-spacing:.22em}.kdx-rwheel__axis i{display:block;width:1px;height:34px;background:linear-gradient(var(--signal),transparent);margin:auto}.kdx-rwheel__axis span{display:block;margin-top:3px}
  .kdx-rwheel__stage{position:relative;width:min(74vh,68vw,760px);aspect-ratio:1;margin:auto;touch-action:none;user-select:none;outline:none;cursor:grab}.kdx-rwheel__stage:active{cursor:grabbing}.kdx-rwheel__stage:focus-visible{outline:1px solid var(--signal);outline-offset:8px}
  .kdx-ring{position:absolute;inset:0;pointer-events:none}.kdx-ring__disc{position:absolute;left:50%;top:50%;translate:-50% -50%;border-radius:50%;transition:filter .3s ease,opacity .3s ease;will-change:transform}
  .kdx-ring--scene .kdx-ring__disc{width:92%;height:92%;border:1px solid rgba(236,236,229,.22);background:repeating-conic-gradient(from -90deg,rgba(236,236,229,.06) 0 1deg,transparent 1deg 51.4deg)}
  .kdx-ring--process .kdx-ring__disc{width:68%;height:68%;border:1px solid rgba(183,255,0,.22);background:repeating-conic-gradient(from -90deg,rgba(183,255,0,.07) 0 1deg,transparent 1deg 60deg)}
  .kdx-ring--domain .kdx-ring__disc{width:42%;height:42%;border:1px solid rgba(236,236,229,.28);background:repeating-conic-gradient(from -90deg,rgba(236,236,229,.08) 0 1deg,transparent 1deg 90deg)}
  .kdx-ring__item{position:absolute;z-index:3;translate:-50% -50%;pointer-events:auto;border:0;background:transparent;color:var(--muted);padding:0;cursor:pointer;font:inherit;text-align:center}.kdx-ring__chip{display:grid;gap:2px;min-width:56px;padding:5px 7px;border:1px solid transparent;background:rgba(4,5,4,.7);transition:transform .52s cubic-bezier(.2,.8,.2,1),border-color .2s,color .2s,background .2s,opacity .3s;transform:translate(var(--fracture-x,0),var(--fracture-y,0)) rotate(var(--fracture-r,0deg))}.kdx-ring__chip b{font-size:9px;letter-spacing:.08em;font-weight:500}.kdx-ring__chip small{font-size:6px;letter-spacing:.16em;color:inherit;opacity:.65}
  .kdx-ring--scene .kdx-ring__chip{border-color:color-mix(in srgb,var(--scene-accent,#ecece5) 30%,transparent)}.kdx-ring__item[data-active] .kdx-ring__chip{color:var(--ink);border-color:var(--signal);background:#10140c;box-shadow:0 0 24px rgba(183,255,0,.12)}
  .kdx-rwheel__core{position:absolute;z-index:5;left:50%;top:50%;translate:-50% -50%;width:17%;aspect-ratio:1;border-radius:50%;display:grid;place-content:center;text-align:center;border:1px solid var(--signal);background:#070907;box-shadow:0 0 0 10px rgba(183,255,0,.025),0 0 48px rgba(183,255,0,.08);pointer-events:none}.kdx-rwheel__core span,.kdx-rwheel__core small{font-size:7px;letter-spacing:.22em;color:var(--muted)}.kdx-rwheel__core strong{font-family:'Archivo','Space Grotesk',sans-serif;font-size:clamp(1.3rem,3vw,2.4rem);font-weight:500;line-height:1;color:var(--signal);margin:3px 0}
  .kdx-rwheel__readout{align-self:center;border-left:1px solid var(--line);padding:clamp(18px,3vw,38px);min-width:0}.kdx-rwheel__readout>p:first-child{font-size:8px;letter-spacing:.24em;color:var(--muted);margin:0 0 16px}.kdx-rwheel__triad{display:grid;gap:8px}.kdx-rwheel__triad span{font-family:'Archivo','Space Grotesk',sans-serif;font-size:clamp(1.25rem,3.1vw,2.8rem);line-height:.92;letter-spacing:-.035em;overflow-wrap:anywhere}.kdx-rwheel__triad i{font-style:normal;color:var(--signal);font-size:11px}.kdx-rwheel__trace{font-size:9px;line-height:1.6;letter-spacing:.12em;color:var(--muted);margin:22px 0}.kdx-rwheel__actions{display:flex;flex-wrap:wrap;gap:8px}.kdx-rwheel__actions a,.kdx-rwheel__actions button{appearance:none;border:1px solid var(--line);background:#080a07;color:var(--ink);padding:10px 12px;font:inherit;font-size:8px;letter-spacing:.14em;text-decoration:none;cursor:pointer}.kdx-rwheel__actions a:hover,.kdx-rwheel__actions button:hover,.kdx-rwheel__actions a:focus-visible,.kdx-rwheel__actions button:focus-visible{border-color:var(--signal);outline:none}.kdx-rwheel__actions button{color:var(--signal)}
  .kdx-rwheel__foot{position:relative;z-index:5;display:flex;justify-content:space-between;gap:18px;padding:11px 18px;border-top:1px solid var(--line);background:rgba(4,5,4,.8);font-size:7px;letter-spacing:.15em;color:var(--muted)}
  .kdx-rwheel[data-state="AWARE"] .kdx-ring__disc{filter:brightness(1.35)}.kdx-rwheel[data-state="OPEN"] .kdx-ring__disc{filter:brightness(1.5) drop-shadow(0 0 18px rgba(183,255,0,.08))}.kdx-rwheel[data-state="ANOMALY"]{--signal:#ff3b33}.kdx-rwheel[data-state="ANOMALY"] .kdx-ring__disc{opacity:.24;filter:blur(1px)}.kdx-rwheel[data-state="ANOMALY"] .kdx-ring__chip{background:#0b0707}.kdx-rwheel[data-state="RETURN"] .kdx-ring__chip{--fracture-x:0px!important;--fracture-y:0px!important;--fracture-r:0deg!important}
  @media(max-width:760px){:global(body){overflow:auto}.kdx-rwheel{min-height:100dvh;height:auto;overflow:visible}.kdx-rwheel__head{padding:13px 14px}.kdx-rwheel__head dl div:nth-child(2),.kdx-rwheel__head dl div:nth-child(3){display:none}.kdx-rwheel__instrument{grid-template-columns:1fr;grid-template-rows:auto auto;padding:16px 12px 22px}.kdx-rwheel__stage{width:min(94vw,68vh);margin-top:8px}.kdx-rwheel__axis{top:5px;left:50%;translate:-50% 0}.kdx-rwheel__readout{border-left:0;border-top:1px solid var(--line);padding:18px 8px 0}.kdx-rwheel__triad{grid-template-columns:1fr auto 1fr auto 1fr;align-items:end;gap:5px}.kdx-rwheel__triad span{font-size:clamp(.9rem,4vw,1.35rem);letter-spacing:-.02em}.kdx-ring__chip{min-width:42px;padding:4px}.kdx-ring__chip b{font-size:7px}.kdx-ring__chip small{font-size:5px}.kdx-rwheel__foot{position:sticky;bottom:0;display:grid;grid-template-columns:1fr auto;padding:10px 12px}.kdx-rwheel__foot span:first-child{display:none}.kdx-rwheel__foot span:last-child{text-align:right}}
  @media(prefers-reduced-motion:reduce){.kdx-ring__chip,.kdx-ring__disc{transition:none!important}.kdx-rwheel__foot span:first-child{display:none}}
</style>
