---
import Base from '../../../layouts/Base.astro';

// Deterministic synthetic pattern. Never represent as a sensor or measured frequency.
const bars = Array.from({ length: 49 }, (_, i) => ({
  leftX: 118 + i * 8.4,
  rightX: 922 - i * 8.4,
  length: 29 + Math.abs(Math.sin(i * 0.57) * 74) + Math.abs(Math.cos(i * 0.21) * 63),
  opacity: 0.18 + (i % 7) * 0.064,
  width: i % 9 === 0 ? 2 : 1,
}));
---

<Base
  title="KODEX−∞ LAB / Signal Convergence"
  description="Experimento editorial de señales convergentes y acceso a una fuente documentada."
  robots="noindex, nofollow"
  noNav={true}
  noFooter={true}
  noOverlays={true}
  noQuote={true}
  noThemes={true}
  noKai={true}
  noCart={true}
  noImmersive={true}
>
  <main class="kdx-convergence">
    <div class="page-frame">
      <header class="topbar" aria-label="Identificación del laboratorio">
        <div class="wordmark">KODEX<span>−∞</span><span class="wordmark-mark"> / LABORATORY</span></div>
        <div class="edition">EXPERIMENT 001 <span aria-hidden="true">·</span> REFERENCE / NOT CANON</div>
      </header>

      <section class="intro" aria-labelledby="lab-heading">
        <p class="overline"><span class="small-cross" aria-hidden="true">✣</span> SIGNAL / RELATION / ARCHIVE</p>
        <h1 id="lab-heading">LA SEÑAL<br /><span>REVELA UNA RELACIÓN.</span></h1>
        <div class="intro-bottom">
          <p>Dos campos sintéticos se aproximan. La coincidencia no demuestra una verdad: permite abrir una fuente, cuestionarla y conservar su procedencia.</p>
          <p class="mini-index">01 / 01<br />ARCHIVE × MACHINE</p>
        </div>
      </section>

      <section class="machine" aria-label="Simulación visual de dos campos convergentes">
        <div class="machine-top">
          <span>FIELD 01 &nbsp;↔&nbsp; FIELD 02</span>
          <span id="signal-state" role="status" aria-live="polite">AWAITING DELIBERATE ACTION</span>
        </div>
        <svg
          id="signal-stage"
          viewBox="0 0 1040 426"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-labelledby="signal-title signal-desc"
        >
          <title id="signal-title">Signal Convergence — dos campos de barras</title>
          <desc id="signal-desc">Dos patrones sintéticos de barras se acercan después de activar explícitamente el experimento. Se revela la palabra MEMORIA y la referencia bibliográfica SRC-151.</desc>
          <defs>
            <radialGradient id="field-fade" cx="50%" cy="52%" r="60%">
              <stop offset="0%" stop-color="#171f33" stop-opacity=".7" />
              <stop offset="100%" stop-color="#090d16" stop-opacity="0" />
            </radialGradient>
            <linearGradient id="left-field-color" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#7988a8" stop-opacity=".2" />
              <stop offset="100%" stop-color="#afbeff" />
            </linearGradient>
            <linearGradient id="right-field-color" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#e9b689" />
              <stop offset="100%" stop-color="#b88f71" stop-opacity=".15" />
            </linearGradient>
          </defs>
          <rect width="1040" height="426" fill="url(#field-fade)" />
          <path d="M0 213H1040 M520 0V426" stroke="#ffffff" stroke-opacity=".085" stroke-dasharray="2 10" />
          <path d="M500 18V54 M540 18V54 M500 372V409 M540 372V409" stroke="#c3c9dd" stroke-opacity=".32" />
          <circle cx="520" cy="213" r="142" stroke="#c7d2ff" stroke-opacity=".12" fill="none" />
          <circle cx="520" cy="213" r="104" stroke="#c7d2ff" stroke-opacity=".075" fill="none" />
          <g class="field-left" aria-hidden="true">
            {bars.map((bar) => (
              <line
                x1={bar.leftX} x2={bar.leftX}
                y1={213 - bar.length / 2} y2={213 + bar.length / 2}
                stroke="url(#left-field-color)" stroke-opacity={bar.opacity}
                stroke-width={bar.width}
              />
            ))}
          </g>
          <g class="field-right" aria-hidden="true">
            {bars.map((bar) => (
              <line
                x1={bar.rightX} x2={bar.rightX}
                y1={213 - bar.length / 2} y2={213 + bar.length / 2}
                stroke="url(#right-field-color)" stroke-opacity={bar.opacity}
                stroke-width={bar.width}
              />
            ))}
          </g>
          <g class="reveal-text" aria-hidden="true">
            <rect x="364" y="176" width="312" height="73" rx="2" fill="#0b0d15" fill-opacity=".96" />
            <line x1="384" y1="177" x2="656" y2="177" stroke="#d9c0a8" stroke-opacity=".7" />
            <text x="520" y="220" fill="#ece2d5" font-family="ui-monospace,monospace" font-size="28" text-anchor="middle" letter-spacing="8">MEMORIA</text>
            <text x="520" y="239" fill="#b2b6c0" font-family="ui-monospace,monospace" font-size="9" text-anchor="middle" letter-spacing="3">SRC–151 / HISTORICAL SOURCE</text>
          </g>
          <text x="36" y="390" fill="#abb3cd" opacity=".5" font-size="10" font-family="ui-monospace,monospace" letter-spacing="2">SYNTHETIC / NOT MEASURED</text>
          <text x="1004" y="390" fill="#abb3cd" opacity=".5" text-anchor="end" font-size="10" font-family="ui-monospace,monospace" letter-spacing="2">KDX-LAB-001</text>
        </svg>
        <div class="machine-bottom"><span>NO SENSOR DATA</span><span>DELIBERATE COMMIT REQUIRED</span><span>REDUCED MOTION SUPPORTED</span></div>
      </section>

      <div class="controls" aria-label="Controles del experimento">
        <button id="activate-convergence" class="activate" type="button">
          <span aria-hidden="true">✳</span> CONVERGER SEÑALES <span aria-hidden="true">↗</span>
        </button>
        <button id="reset-convergence" class="reset" type="button" disabled>RESTABLECER <span aria-hidden="true">↺</span></button>
        <p id="local-trace" role="status" aria-live="polite">Traza local: ninguna acción comprometida.</p>
      </div>

      <section id="source-panel" class="source-panel" aria-label="Resultado bibliográfico" hidden>
        <div class="source-label">SOURCE REVEALED <span>01 / HISTORICAL TEXT</span></div>
        <div class="source-details">
          <div>
            <p class="source-id">SRC-151 <span aria-hidden="true">→</span> ARCHIVE</p>
            <h2>The Secret Teachings<br />of All Ages</h2>
            <p>Manly P. Hall · 1928. Referencia documental para estudiar el índice, el aparato ilustrado y las interpretaciones simbólicas de Hall. Sus hipótesis esotéricas no constituyen evidencia científica contemporánea.</p>
          </div>
          <a href="https://sacred-texts.com/eso/sta/" target="_blank" rel="noopener noreferrer">ABRIR FUENTE ORIGINAL ↗</a>
        </div>
      </section>

      <footer class="footnotes">
        <div><span class="note-number">[01]</span> Prototipo experimental aislado: sin escritura en JourneyState ni asignación a una letra A–Y.</div>
        <div><span class="note-number">[02]</span> <a href="https://sacred-texts.com/eso/sta/">Fuente siempre accesible: Hall, 1928 / SRC-151</a>.</div>
        <div><span class="note-number">[03]</span> El patrón de barras es una representación artística sintética; no mide frecuencia, conciencia ni señales biológicas.</div>
      </footer>
    </div>
  </main>

  <style>
    :global(html) { background: #080a0f; }
    :global(body) { margin: 0; background: #080a0f; color: #e9e8e3; }
    .kdx-convergence {
      min-height: 100svh;
      color: #e9e8e3;
      background:
        radial-gradient(ellipse at 74% 38%, rgba(69,78,118,.11), transparent 46%),
        radial-gradient(ellipse at 4% 80%, rgba(83,44,79,.09), transparent 42%),
        #080a0f;
      font-family: "Instrument Sans", "Arial", sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .page-frame { max-width: 1450px; margin: 0 auto; padding: clamp(20px,3.8vw,62px); }
    .topbar, .machine-top, .machine-bottom, .edition, .overline, .mini-index, .source-label, .source-id, .footnotes, .controls button {
      font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
      font-size: 10px;
      letter-spacing: .13em;
    }
    .topbar { display: flex; gap: 20px; align-items: center; justify-content: space-between; padding-bottom: 18px; border-bottom: 1px solid #30313a; }
    .wordmark { font-family: "Instrument Sans", Arial, sans-serif; font-weight: 700; font-size: 18px; letter-spacing: -.06em; }
    .wordmark > span:first-child { color: #bfb2f7; }
    .wordmark-mark { margin-left: 10px; font-size: 10px; color: #757989; letter-spacing: .14em; font-family: ui-monospace, monospace; font-weight: 400; }
    .edition { color: #969bac; text-align: right; }
    .intro { padding-top: clamp(54px,8vw,140px); }
    .overline { margin: 0 0 32px; color: #b5b8c5; }
    .small-cross { display: inline-block; margin-right: 12px; color: #d5ae96; font-size: 17px; }
    h1 { font-size: clamp(48px,8.7vw,130px); line-height: .89; font-weight: 500; letter-spacing: -.085em; margin: 0; }
    h1 span { color: #bcbacc; }
    .intro-bottom { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 42px; gap: 30px; }
    .intro-bottom > p:first-child { max-width: 490px; margin: 0; font-size: clamp(14px,1.25vw,17px); line-height: 1.58; color: #a5a6b2; }
    .mini-index { margin: 0; text-align: right; color: #8e929e; line-height: 2; }
    .machine { margin-top: clamp(40px,6vw,90px); border: 1px solid #353744; position: relative; background: rgba(12,15,24,.57); }
    .machine-top, .machine-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 14px; padding: 15px 20px; color: #a3a6b4; }
    .machine-top { border-bottom: 1px solid #292d36; }
    .machine-top #signal-state { color: #d4bfa8; }
    .machine-bottom { border-top: 1px solid #292d36; color: #777e92; }
    #signal-stage { display: block; width: 100%; height: auto; max-height: 480px; }
    #signal-stage .field-left, #signal-stage .field-right { transition: transform 1350ms cubic-bezier(.18,.78,.17,1); }
    #signal-stage.is-assembled .field-left { transform: translateX(64px); }
    #signal-stage.is-assembled .field-right { transform: translateX(-64px); }
    #signal-stage .reveal-text { opacity: 0; transition: opacity 320ms ease 850ms; }
    #signal-stage.is-assembled .reveal-text { opacity: 1; }
    .controls { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 22px; }
    .controls button { min-height: 50px; cursor: pointer; border: 1px solid #5e6275; padding: 0 22px; border-radius: 0; }
    .controls .activate { background: #dfd8d0; border-color: #dfd8d0; color: #13151c; display: inline-flex; align-items: center; gap: 14px; font-weight: 700; }
    .controls .activate:hover:not(:disabled), .controls .activate:focus-visible { background: #faf3e9; }
    .controls .reset { background: transparent; color: #dcdded; }
    .controls button:disabled { opacity: .43; cursor: not-allowed; }
    .controls button:focus-visible, .source-details a:focus-visible, .footnotes a:focus-visible { outline: 2px solid #f1d0ad; outline-offset: 4px; }
    .controls p { color: #9295a7; font-family: ui-monospace, monospace; font-size: 11px; flex: 1; margin: 0 0 0 15px; }
    .source-panel { margin-top: 60px; border: 1px solid #4d4b4e; background: linear-gradient(140deg,#1d1c20,#11141b); }
    .source-panel[hidden] { display: none; }
    .source-label { border-bottom: 1px solid #48444a; padding: 20px 26px; color: #d6baa4; display: flex; justify-content: space-between; }
    .source-label span { color: #a29a98; }
    .source-details { display: flex; gap: 28px; padding: clamp(24px,4vw,60px); justify-content: space-between; align-items: flex-end; }
    .source-details h2 { font-size: clamp(36px,5vw,70px); font-weight: 500; letter-spacing: -.055em; line-height: .99; margin: 15px 0 24px; }
    .source-details p:not(.source-id) { color: #b5adb0; max-width: 530px; line-height: 1.6; font-size: 15px; margin: 0; }
    .source-id { color: #d7b496; margin: 0; }
    .source-details a { flex-shrink: 0; color: #111216; background: #eddbcc; padding: 17px 18px; text-decoration: none; font-family: ui-monospace, monospace; font-size: 11px; letter-spacing: .08em; }
    .source-details a:hover { background: #fff2e8; }
    .footnotes { margin: 70px 0 8px; border-top: 1px solid #34363e; padding-top: 22px; display: grid; gap: 12px; color: #8f929f; line-height: 1.55; letter-spacing: .02em; }
    .note-number { margin-right: 12px; color: #c9b7a5; }
    .footnotes a { color: #c2c8e6; }
    @media (max-width: 720px) {
      .topbar { align-items: flex-start; }
      .wordmark-mark { display: none; }
      .edition { max-width: 160px; font-size: 9px; line-height: 1.5; }
      .intro { padding-top: 68px; }
      h1 { font-size: clamp(43px,10.6vw,78px); letter-spacing: -.075em; }
      .intro-bottom { margin-top: 26px; }
      .mini-index { display: none; }
      .machine { margin-top: 40px; }
      .machine-top, .machine-bottom { font-size: 8px; gap: 8px; padding: 11px; }
      .machine-bottom span:nth-child(2) { display: none; }
      .controls { align-items: stretch; }
      .controls button { flex: 1; font-size: 9px; padding: 0 13px; }
      .controls p { flex-basis: 100%; margin: 8px 0 0; }
      .source-label { padding: 17px; font-size: 9px; }
      .source-details { flex-direction: column; align-items: flex-start; gap: 28px; }
      .source-details a { width: 100%; text-align: center; box-sizing: border-box; }
      .footnotes { margin-top: 45px; }
    }
    @media (prefers-reduced-motion: reduce) {
      #signal-stage .field-left, #signal-stage .field-right, #signal-stage .reveal-text { transition: none !important; }
    }
  </style>

  <script is:inline>
    (() => {
      const stage = document.getElementById('signal-stage');
      const activate = document.getElementById('activate-convergence');
      const reset = document.getElementById('reset-convergence');
      const source = document.getElementById('source-panel');
      const state = document.getElementById('signal-state');
      const trace = document.getElementById('local-trace');
      if (!stage || !activate || !reset || !source || !state || !trace) return;
      activate.addEventListener('click', () => {
        stage.classList.add('is-assembled');
        source.hidden = false;
        state.textContent = 'SOURCE REVEALED / SRC-151';
        trace.textContent = 'Traza local: SIGNAL_CONVERGENCE_COMMITTED → SRC-151. No persistida.';
        activate.disabled = true;
        reset.disabled = false;
      });
      reset.addEventListener('click', () => {
        stage.classList.remove('is-assembled');
        source.hidden = true;
        state.textContent = 'AWAITING DELIBERATE ACTION';
        trace.textContent = 'Traza local: ninguna acción comprometida.';
        activate.disabled = false;
        reset.disabled = true;
      });
    })();
  </script>
</Base>
