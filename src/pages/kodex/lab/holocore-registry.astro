---
import Base from '../../../layouts/Base.astro';
import KodexHoloCoreRegistry from '../../../components/kodex/holocore/KodexHoloCoreRegistry.astro';
---

<Base
  title="KODEX−∞ · HoloCore Registry Lab"
  description="Internal KODEX lab for query-addressable HoloCore procedural specimens."
  robots="noindex, nofollow"
  kodexFonts={true}
  noNav={true}
  noFooter={true}
  noOverlays={true}
  noQuote={true}
  noThemes={true}
  noKai={true}
  noCart={true}
  noImmersive={true}
>
  <main class="registry-lab" aria-labelledby="registry-title">
    <header class="registry-lab__header">
      <div>
        <p>KODEX−∞ // SYSTEMS LAB // REGISTRY V0.1</p>
        <h1 id="registry-title">HOLOCORE REGISTRY</h1>
      </div>
      <div class="registry-lab__status" aria-live="polite">
        <span>SPECIMEN</span><strong data-lab-specimen>RESOLVING</strong>
        <span>RENDER</span><strong data-lab-render>PROCEDURAL ASCII</strong>
        <span>STATE</span><strong>LAB / NOINDEX</strong>
      </div>
    </header>

    <section class="registry-lab__core" aria-label="Registry-driven HoloCore emulator">
      <KodexHoloCoreRegistry />
    </section>

    <aside class="registry-lab__rail" aria-label="HoloCore registry contract">
      <p>ONE CHAMBER</p>
      <p>MANY CONCEPT FIELDS</p>
      <p>STATE-BOUND</p>
      <p>REDUCED-MOTION SAFE</p>
    </aside>

    <footer class="registry-lab__footer" aria-label="Available HoloCore specimens">
      <a href="?specimen=orbital-city">01 ORBITAL CITY</a>
      <a href="?specimen=signal-core">02 SIGNAL CORE</a>
      <a href="?specimen=interference-portal">03 INTERFERENCE PORTAL</a>
      <strong>CONCEPT ID → REGISTRY → FIELD → PALETTE → HOLOCORE</strong>
    </footer>
  </main>

  <script>
    document.addEventListener('kdx:holocore:specimen', event => {
      const detail = event.detail;
      const specimen = document.querySelector('[data-lab-specimen]');
      const render = document.querySelector('[data-lab-render]');
      if (specimen) specimen.textContent = detail?.title || detail?.id || 'UNKNOWN';
      if (render) render.textContent = detail?.render || 'PROCEDURAL ASCII';
    });
  </script>
</Base>

<style is:global>
  html:has(.registry-lab),
  body:has(.registry-lab) {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow: hidden;
    background: #020204;
  }
</style>

<style>
  .registry-lab {
    box-sizing: border-box;
    width: 100%;
    height: 100dvh;
    padding: 10px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(72px, 9vw, 122px);
    grid-template-rows: clamp(72px, 10vh, 104px) minmax(0, 1fr) clamp(54px, 8vh, 78px);
    grid-template-areas:
      "header header"
      "core rail"
      "footer footer";
    color: #eeeaf2;
    background: #020204;
    font-family: 'Share Tech Mono', ui-monospace, monospace;
    overflow: hidden;
  }

  .registry-lab__header {
    grid-area: header;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-width: 0;
    padding: 0 16px;
    border: 1px solid rgba(255,255,255,.08);
  }
  .registry-lab__header p { margin: 0; font-size: 8px; letter-spacing: .16em; color: rgba(236,230,243,.46); }
  .registry-lab h1 {
    margin: 4px 0 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-size: clamp(30px, 4.5vw, 64px);
    font-weight: 400;
    line-height: .9;
    letter-spacing: .09em;
  }

  .registry-lab__status {
    display: grid;
    grid-template-columns: auto auto;
    gap: 5px 14px;
    font-size: 7px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .registry-lab__status span { color: rgba(236,230,243,.38); }
  .registry-lab__status strong { color: rgba(236,230,243,.78); font-weight: 500; }

  .registry-lab__core {
    grid-area: core;
    min-width: 0;
    min-height: 0;
    padding: 12px 12px 12px 0;
  }

  .registry-lab__rail {
    grid-area: rail;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    padding: 10px;
    border-left: 1px solid rgba(255,255,255,.08);
    overflow: hidden;
  }
  .registry-lab__rail p {
    margin: 0;
    font-size: 7px;
    line-height: 1.35;
    letter-spacing: .12em;
    color: rgba(236,230,243,.46);
  }

  .registry-lab__footer {
    grid-area: footer;
    display: grid;
    grid-template-columns: repeat(3, auto) minmax(0, 1fr);
    align-items: center;
    gap: clamp(10px, 2vw, 26px);
    padding: 0 16px;
    border: 1px solid rgba(255,255,255,.08);
  }
  .registry-lab__footer a,
  .registry-lab__footer strong {
    font-size: 7px;
    line-height: 1.2;
    letter-spacing: .1em;
    text-decoration: none;
  }
  .registry-lab__footer a { color: rgba(196,181,216,.72); }
  .registry-lab__footer a:hover,
  .registry-lab__footer a:focus-visible { color: #fff; outline: none; text-decoration: underline; }
  .registry-lab__footer strong {
    justify-self: end;
    text-align: right;
    font-weight: 500;
    color: rgba(236,230,243,.45);
  }

  @media (max-width: 700px) {
    .registry-lab {
      padding: 6px;
      grid-template-columns: minmax(0, 1fr) 38px;
      grid-template-rows: 72px minmax(0, 1fr) 58px;
    }
    .registry-lab__header { padding: 0 8px; }
    .registry-lab h1 { font-size: clamp(25px, 9vw, 38px); }
    .registry-lab__status { display: none; }
    .registry-lab__core { padding: 6px 6px 6px 0; }
    .registry-lab__rail { gap: 12px; padding: 4px; }
    .registry-lab__rail p { writing-mode: vertical-rl; font-size: 5px; }
    .registry-lab__footer { grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 0 4px; }
    .registry-lab__footer a { font-size: 5px; text-align: center; }
    .registry-lab__footer strong { display: none; }
  }
</style>
