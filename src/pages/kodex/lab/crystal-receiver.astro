---
import Base from '../../../layouts/Base.astro';
import '../../../styles/kodex.css';
---

<Base
  title="KODEX−∞ // CRYSTAL RECEIVER LAB"
  description="Bounded KODEX receiver device proof using the current epistemic capture contract without parallel memory or scoring."
  robots="noindex, nofollow"
  kodexFonts={true}
  noNav={true}
  noFooter={true}
  noOverlays={true}
  noQuote={true}
  noThemes={true}
  noKai={true}
  noCart={true}
  noImmersive={true}
>
  <main class="kdx-receiver" data-kdx-receiver-device data-device-state="DORMANT">
    <header class="kdx-receiver__header">
      <div>
        <p>KODEX−∞ // DEVICE LAB</p>
        <h1>CRYSTAL RECEIVER</h1>
      </div>
      <div class="kdx-receiver__state" aria-live="polite">
        <span>DEVICE STATE</span>
        <strong data-device-state-label>DORMANT</strong>
      </div>
    </header>

    <section class="kdx-receiver__body">
      <aside class="kdx-receiver__rail" aria-label="Receiver authority">
        <div><span>SOURCE</span><strong data-source>UNKNOWN</strong></div>
        <div><span>MEMORY</span><strong>EPHEMERAL</strong></div>
        <div><span>ROUTING</span><strong>NONE</strong></div>
        <div><span>SCORING</span><strong>NONE</strong></div>
      </aside>

      <section class="kdx-receiver__core" aria-labelledby="receiver-heading">
        <div class="kdx-receiver__field" aria-hidden="true">
          <span class="kdx-receiver__axis kdx-receiver__axis--x"></span>
          <span class="kdx-receiver__axis kdx-receiver__axis--y"></span>
          <span class="kdx-receiver__node kdx-receiver__node--matter">M</span>
          <span class="kdx-receiver__node kdx-receiver__node--signal">S</span>
          <span class="kdx-receiver__node kdx-receiver__node--observer">O</span>
          <button type="button" class="kdx-receiver__trigger" data-receiver-trigger aria-describedby="receiver-help">
            <span aria-hidden="true">◈</span>
            <span class="sr-only">Activate receiver</span>
          </button>
        </div>
        <h2 id="receiver-heading">MATTER × SIGNAL × OBSERVER</h2>
        <p id="receiver-help" data-device-instruction>ACTIVATE RECEIVER. RECORD FIRST. INTERPRET LATER.</p>
      </section>

      <aside class="kdx-receiver__truth" aria-label="Epistemic ladder">
        <p>TRUTH LAYER</p>
        <ol>
          <li data-truth="RECEIVED" data-active="true">RECEIVED</li>
          <li data-truth="INTERPRETED">INTERPRETED</li>
          <li data-truth="CORRELATED">CORRELATED</li>
          <li data-truth="VERIFIED">VERIFIED <small>EXTERNAL AUTHORITY</small></li>
        </ol>
      </aside>
    </section>

    <section class="kdx-receiver__capture" data-capture-panel hidden aria-labelledby="capture-heading">
      <div class="kdx-receiver__capture-head">
        <div>
          <p>SIGNAL CAPTURE</p>
          <h2 id="capture-heading">WHAT APPEARED?</h2>
        </div>
        <button type="button" data-close-capture>CLOSE</button>
      </div>

      <label>
        RAW SIGNAL // RECEIVED
        <textarea rows="4" data-raw-signal placeholder="Describe only what appeared."></textarea>
      </label>

      <label>
        INTERPRETATION // OPTIONAL
        <textarea rows="3" data-interpretation placeholder="What might it mean? Keep this separate from the observation."></textarea>
      </label>

      <div class="kdx-receiver__actions">
        <button type="button" data-hold-capture>HOLD CAPTURE</button>
        <button type="button" data-request-verified>REQUEST VERIFIED</button>
      </div>
    </section>

    <section class="kdx-receiver__readout" aria-live="polite" aria-atomic="true">
      <span>CAPTURE</span>
      <strong data-capture-status>NONE</strong>
      <span>RESOLUTION</span>
      <strong data-resolution-status>RECEIVED</strong>
    </section>

    <footer class="kdx-receiver__footer">
      <span>OBSERVATION ≠ INTERPRETATION ≠ CORRELATION ≠ VERIFICATION</span>
      <span>LAB / NO PERSISTENCE / NO VISITOR SCORE</span>
    </footer>
  </main>

  <script>
    import {
      createReceiverEpistemicCapture,
      resolveReceiverEpistemicStatus,
    } from '../../../lib/kodex/runtime/receiver-epistemic-contract.js';

    const root = document.querySelector('[data-kdx-receiver-device]');
    if (root instanceof HTMLElement) {
      const trigger = root.querySelector('[data-receiver-trigger]');
      const panel = root.querySelector('[data-capture-panel]');
      const raw = root.querySelector('[data-raw-signal]');
      const interpretation = root.querySelector('[data-interpretation]');
      const stateLabel = root.querySelector('[data-device-state-label]');
      const instruction = root.querySelector('[data-device-instruction]');
      const captureStatus = root.querySelector('[data-capture-status]');
      const resolutionStatus = root.querySelector('[data-resolution-status]');
      let sequence = 0;
      let currentCapture = null;

      const setDeviceState = (next) => {
        root.dataset.deviceState = next;
        if (stateLabel) stateLabel.textContent = next;
        if (instruction) {
          instruction.textContent = next === 'AWARE'
            ? 'RECEIVER OPEN. OBSERVE WITHOUT EXPLAINING.'
            : next === 'RECORDING'
              ? 'CAPTURE THE SIGNAL BEFORE INTERPRETATION.'
              : next === 'HELD'
                ? 'CAPTURE HELD EPHEMERALLY. NO JOURNEY MEMORY WAS WRITTEN.'
                : 'ACTIVATE RECEIVER. RECORD FIRST. INTERPRET LATER.';
        }
      };

      const setTruth = (status) => {
        root.querySelectorAll('[data-truth]').forEach((item) => {
          if (item instanceof HTMLElement) item.dataset.active = String(item.dataset.truth === status);
        });
        if (resolutionStatus) resolutionStatus.textContent = status;
      };

      trigger?.addEventListener('click', () => {
        if (root.dataset.deviceState === 'DORMANT') {
          setDeviceState('AWARE');
          return;
        }
        if (panel instanceof HTMLElement) panel.hidden = false;
        setDeviceState('RECORDING');
        if (raw instanceof HTMLTextAreaElement) raw.focus();
      });

      root.querySelector('[data-close-capture]')?.addEventListener('click', () => {
        if (panel instanceof HTMLElement) panel.hidden = true;
        setDeviceState(currentCapture ? 'HELD' : 'AWARE');
      });

      root.querySelector('[data-hold-capture]')?.addEventListener('click', () => {
        if (!(raw instanceof HTMLTextAreaElement) || !raw.value.trim()) {
          raw?.setAttribute('aria-invalid', 'true');
          raw?.focus();
          return;
        }
        raw.removeAttribute('aria-invalid');
        sequence += 1;
        currentCapture = createReceiverEpistemicCapture({
          captureId: `LAB-${String(sequence).padStart(3, '0')}`,
          raw: raw.value,
          interpretation: interpretation instanceof HTMLTextAreaElement ? interpretation.value : '',
        });
        const requested = currentCapture.interpretation ? 'INTERPRETED' : 'RECEIVED';
        const resolved = resolveReceiverEpistemicStatus({ capture: currentCapture, requestedStatus: requested });
        if (captureStatus) captureStatus.textContent = currentCapture.capture_id;
        setTruth(resolved.resolved_status);
        if (panel instanceof HTMLElement) panel.hidden = true;
        setDeviceState('HELD');
      });

      root.querySelector('[data-request-verified]')?.addEventListener('click', () => {
        if (!currentCapture) {
          if (captureStatus) captureStatus.textContent = 'CAPTURE REQUIRED';
          return;
        }
        const resolved = resolveReceiverEpistemicStatus({ capture: currentCapture, requestedStatus: 'VERIFIED' });
        setTruth(resolved.resolved_status);
      });

      window.__KDX_RECEIVER_DEVICE__ = {
        getState: () => root.dataset.deviceState,
        getCapture: () => currentCapture,
      };
    }
  </script>

  <style is:global>
    :root, body { margin: 0; background: #050505; color: #f3f1e8; }
    body { overflow: hidden; }
    .kdx-receiver { height: 100dvh; overflow: hidden; box-sizing: border-box; padding: 14px; display: grid; grid-template-rows: auto minmax(0, 1fr) auto auto; gap: 10px; background: radial-gradient(circle at 50% 44%, rgba(255,255,255,.055), transparent 32%), #050505; font-family: var(--font-mono, ui-monospace, monospace); }
    .kdx-receiver__header, .kdx-receiver__footer, .kdx-receiver__capture-head { display: flex; justify-content: space-between; gap: 16px; align-items: end; }
    .kdx-receiver__header { border-top: 1px solid rgba(255,255,255,.68); border-bottom: 1px solid rgba(255,255,255,.18); padding: 8px 0 10px; }
    .kdx-receiver h1, .kdx-receiver h2, .kdx-receiver p { margin: 0; }
    .kdx-receiver h1 { font-size: clamp(24px, 4.8vw, 64px); letter-spacing: -.05em; font-weight: 600; }
    .kdx-receiver h2 { font-size: clamp(13px, 1.7vw, 22px); letter-spacing: .08em; }
    .kdx-receiver__header p, .kdx-receiver__footer, .kdx-receiver__rail span, .kdx-receiver__truth, .kdx-receiver__readout { font-size: 9px; letter-spacing: .14em; text-transform: uppercase; }
    .kdx-receiver__state { display: grid; text-align: right; gap: 3px; }
    .kdx-receiver__state span { font-size: 8px; opacity: .45; letter-spacing: .16em; }
    .kdx-receiver__body { min-height: 0; display: grid; grid-template-columns: minmax(125px, 190px) minmax(0, 1fr) minmax(145px, 210px); border-bottom: 1px solid rgba(255,255,255,.16); }
    .kdx-receiver__rail, .kdx-receiver__truth { min-height: 0; padding: 12px; display: flex; flex-direction: column; justify-content: center; gap: 10px; }
    .kdx-receiver__rail { border-right: 1px solid rgba(255,255,255,.14); padding-left: 0; }
    .kdx-receiver__rail div { display: grid; grid-template-columns: 1fr auto; gap: 8px; border-bottom: 1px solid rgba(255,255,255,.08); padding-bottom: 6px; }
    .kdx-receiver__rail span { opacity: .42; }
    .kdx-receiver__rail strong { font-size: 9px; }
    .kdx-receiver__core { min-width: 0; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 14px; }
    .kdx-receiver__field { width: min(42vw, 360px, 42dvh); aspect-ratio: 1; position: relative; display: grid; place-items: center; }
    .kdx-receiver__axis { position: absolute; background: rgba(255,255,255,.15); }
    .kdx-receiver__axis--x { width: 84%; height: 1px; }
    .kdx-receiver__axis--y { height: 84%; width: 1px; }
    .kdx-receiver__node { position: absolute; width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.34); transform: rotate(45deg); font-size: 9px; }
    .kdx-receiver__node--matter { left: 5%; bottom: 16%; }
    .kdx-receiver__node--signal { right: 5%; bottom: 16%; }
    .kdx-receiver__node--observer { top: 3%; }
    .kdx-receiver__trigger { width: clamp(84px, 9vw, 118px); aspect-ratio: 1; border: 1px solid rgba(255,255,255,.72); background: rgba(0,0,0,.72); color: inherit; transform: rotate(45deg); cursor: pointer; transition: box-shadow .4s ease, background .4s ease; }
    .kdx-receiver__trigger > span:first-child { display: block; transform: rotate(-45deg); font-size: 38px; }
    .kdx-receiver[data-device-state='AWARE'] .kdx-receiver__trigger, .kdx-receiver[data-device-state='RECORDING'] .kdx-receiver__trigger { box-shadow: 0 0 44px rgba(255,255,255,.15); }
    .kdx-receiver[data-device-state='HELD'] .kdx-receiver__trigger { box-shadow: 0 0 70px rgba(255,255,255,.24); background: rgba(255,255,255,.05); }
    .kdx-receiver__core > p { margin-top: 8px; max-width: 620px; opacity: .52; font-size: 9px; letter-spacing: .12em; }
    .kdx-receiver__truth { border-left: 1px solid rgba(255,255,255,.14); padding-right: 0; }
    .kdx-receiver__truth > p { opacity: .42; }
    .kdx-receiver__truth ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
    .kdx-receiver__truth li { opacity: .24; display: grid; gap: 2px; }
    .kdx-receiver__truth li[data-active='true'] { opacity: 1; }
    .kdx-receiver__truth small { font-size: 7px; opacity: .52; }
    .kdx-receiver__capture { position: fixed; z-index: 20; inset: 10%; overflow: auto; border: 1px solid rgba(255,255,255,.42); background: rgba(5,5,5,.98); padding: 18px; }
    .kdx-receiver__capture[hidden] { display: none; }
    .kdx-receiver__capture label { display: grid; gap: 7px; margin-top: 14px; font-size: 9px; letter-spacing: .13em; }
    .kdx-receiver textarea { width: 100%; box-sizing: border-box; border: 1px solid rgba(255,255,255,.2); background: #090909; color: inherit; padding: 10px; font: inherit; resize: vertical; }
    .kdx-receiver textarea[aria-invalid='true'] { border-color: #fff; }
    .kdx-receiver button { font: inherit; }
    .kdx-receiver button:focus-visible, .kdx-receiver textarea:focus-visible { outline: 1px solid #fff; outline-offset: 3px; }
    .kdx-receiver__capture-head button, .kdx-receiver__actions button { border: 1px solid rgba(255,255,255,.25); background: transparent; color: inherit; padding: 9px 11px; font-size: 9px; letter-spacing: .11em; cursor: pointer; }
    .kdx-receiver__actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px; }
    .kdx-receiver__readout { display: grid; grid-template-columns: auto 1fr auto 1fr; gap: 8px 12px; align-items: center; border: 1px solid rgba(255,255,255,.14); padding: 8px 10px; }
    .kdx-receiver__readout span { opacity: .42; }
    .kdx-receiver__footer { padding-top: 2px; opacity: .48; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

    @media (max-width: 760px) {
      .kdx-receiver { padding: 10px; grid-template-rows: auto minmax(0, 1fr) auto auto; }
      .kdx-receiver__header { align-items: start; }
      .kdx-receiver h1 { font-size: clamp(22px, 8vw, 34px); }
      .kdx-receiver__body { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr) auto; }
      .kdx-receiver__rail { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.12); display: grid; grid-template-columns: repeat(2, 1fr); padding: 8px 0; gap: 6px 10px; }
      .kdx-receiver__truth { border-left: 0; border-top: 1px solid rgba(255,255,255,.12); padding: 7px 0; }
      .kdx-receiver__truth > p { display: none; }
      .kdx-receiver__truth ol { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 5px; }
      .kdx-receiver__truth li { font-size: 7px; letter-spacing: .08em; }
      .kdx-receiver__core { padding: 6px 0; }
      .kdx-receiver__field { width: min(66vw, 280px, 30dvh); }
      .kdx-receiver__node { width: 28px; height: 28px; font-size: 7px; }
      .kdx-receiver__trigger { width: 76px; }
      .kdx-receiver__trigger > span:first-child { font-size: 28px; }
      .kdx-receiver__readout { grid-template-columns: auto 1fr; }
      .kdx-receiver__footer { font-size: 7px; gap: 8px; }
      .kdx-receiver__capture { inset: 6%; }
    }

    @media (prefers-reduced-motion: reduce) {
      .kdx-receiver *, .kdx-receiver *::before, .kdx-receiver *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; }
    }
  </style>
</Base>
