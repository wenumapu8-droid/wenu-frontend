---
import Base from '../../../../layouts/Base.astro';
import KodexPlateSpecRenderer from '../../../../components/kodex/grammar/KodexPlateSpecRenderer.astro';
import { compileSemanticIrToPlateSpec } from '../../../../lib/kodex/grammar/semantic-ir-compiler.js';
import { KDX_SEMANTIC_IR_FIXTURES } from '../../../../lib/kodex/grammar/semantic-ir-fixtures.v0.1.js';
import { compilePlateRenderModel } from '../../../../lib/kodex/grammar/plate-render-model.js';
import '../../../../styles/kodex-golden-curatorial.css';
import '../../../../styles/kodex-golden-consciousness-materiality.css';
import '../../../../styles/kodex-golden-junction-materiality.css';

export function getStaticPaths() {
  return KDX_SEMANTIC_IR_FIXTURES.map((fixture) => ({
    params: { case_id: fixture.id.toLowerCase() },
    props: { fixture },
  }));
}

const { fixture } = Astro.props;
const compiled = compileSemanticIrToPlateSpec(fixture);
const renderModel = compilePlateRenderModel(compiled.plateSpec);
const trace = compiled.semanticTrace;
---

<Base
  title={`KODEX Semantic IR — ${fixture.principles[0]}`}
  description="Internal principle-to-manifestation proof through existing Assembly OS."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="kdx-semantic-lab" data-kdx-semantic-case={fixture.id}>
    <KodexPlateSpecRenderer model={renderModel} caseId={fixture.id} domain="semantic-ir" />
    <aside class="kdx-semantic-trace" aria-label="Semantic transduction trace">
      <p>TRANSDUCTION TRACE</p>
      <strong>{trace.principles.join(' + ')}</strong>
      <small>{trace.question}</small>
      <dl>
        <div><dt>OPERATORS</dt><dd>{trace.operators.join(' → ')}</dd></div>
        <div><dt>GEOMETRY</dt><dd>{trace.geometry?.primitives.join(' + ') || 'NONE'}</dd></div>
        <div><dt>RELATION</dt><dd>{trace.geometry?.relation || 'UNSPECIFIED'}</dd></div>
        <div><dt>GEOM CLASS</dt><dd>{trace.geometry?.evidence_class || 'UNSPECIFIED'}</dd></div>
        <div><dt>DEPTH</dt><dd>{trace.depth_types.join(' / ')}</dd></div>
        <div><dt>MEMORY</dt><dd>{trace.memory.effect}</dd></div>
        <div><dt>RETURN</dt><dd>{trace.return.effect}</dd></div>
        <div><dt>EPISTEMIC</dt><dd>{trace.epistemic.join(' / ')}</dd></div>
      </dl>
      <p class="kdx-semantic-fidelity">SEMANTIC FIDELITY: <b>NOT_RUN</b> · MEANING_CARRIED / DECORATIVE_ONLY / MISLEADING</p>
      <a href="/kodex/lab/semantic-ir/">← PRINCIPLES</a>
    </aside>
  </main>
</Base>

<style is:global>
  html:has(.kdx-semantic-lab), body:has(.kdx-semantic-lab) {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #070808;
  }
  .kdx-semantic-lab {
    position: relative;
    width: 100vw;
    height: 100dvh;
    min-height: 100dvh;
    max-height: 100dvh;
    overflow: hidden;
  }
  .kdx-semantic-trace {
    position: absolute;
    z-index: 40;
    right: clamp(.65rem, 2vw, 1.5rem);
    bottom: clamp(.65rem, 2vw, 1.5rem);
    width: min(30rem, calc(100vw - 1.3rem));
    padding: .8rem;
    border: 1px solid rgba(215, 255, 79, .45);
    background: rgba(5, 7, 6, .9);
    color: #eef0eb;
    backdrop-filter: blur(8px);
    font: 500 .66rem/1.4 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  .kdx-semantic-trace > p { margin: 0 0 .45rem; color: #d7ff4f; letter-spacing: .12em; }
  .kdx-semantic-trace > strong { display: block; font-size: .84rem; }
  .kdx-semantic-trace > small { display: block; margin-top: .2rem; color: #9da5a1; }
  .kdx-semantic-trace dl { display: grid; gap: .3rem; margin: .65rem 0; }
  .kdx-semantic-trace dl div { display: grid; grid-template-columns: 5.8rem minmax(0, 1fr); gap: .5rem; border-top: 1px solid rgba(255,255,255,.08); padding-top: .3rem; }
  .kdx-semantic-trace dt { color: #78817d; }
  .kdx-semantic-trace dd { margin: 0; }
  .kdx-semantic-trace .kdx-semantic-fidelity { color: #9da5a1; letter-spacing: .02em; border-top: 1px solid rgba(255,255,255,.08); padding-top: .45rem; }
  .kdx-semantic-trace .kdx-semantic-fidelity b { color: #eef0eb; }
  .kdx-semantic-trace a { color: #d7ff4f; text-decoration: none; }
  .kdx-semantic-trace a:focus-visible { outline: 1px solid #d7ff4f; outline-offset: 3px; }
  @media (max-width: 760px) {
    .kdx-semantic-trace { right: .55rem; bottom: .55rem; width: calc(100vw - 1.1rem); padding: .65rem; max-height: 46dvh; overflow: auto; }
    .kdx-semantic-trace dl { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kdx-semantic-trace dl div { grid-template-columns: 1fr; gap: .08rem; }
  }
</style>
