---
import Base from '../../../../layouts/Base.astro';
import { KDX_SEMANTIC_IR_FIXTURES } from '../../../../lib/kodex/grammar/semantic-ir-fixtures.v0.1.js';
---

<Base
  title="KODEX Semantic IR — Principle → Manifestation P0"
  description="Internal noindex proof that principles compile into the existing Assembly OS."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="kdx-semantic-index" data-kdx-semantic-index>
    <header>
      <p>KODEX−∞ / TRANSDUCTION CONTRACT / INTERNAL P0</p>
      <h1>PRINCIPLE → MANIFESTATION</h1>
      <p class="lede">One semantic contract. Existing Assembly OS. No parallel renderer, route engine or memory store.</p>
    </header>

    <section aria-label="Semantic IR proof cases">
      {KDX_SEMANTIC_IR_FIXTURES.map((fixture, index) => (
        <a href={`/kodex/lab/semantic-ir/${fixture.id.toLowerCase()}/`}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <strong>{fixture.principles[0]}</strong>
            <small>{fixture.question}</small>
          </div>
          <code>{fixture.operators.join(' → ')}</code>
          <b>MANIFEST →</b>
        </a>
      ))}
    </section>

    <footer>
      <p>SEMANTIC IR ≠ CANON PROMOTION. P0 proves transduction into existing PlateSpec only.</p>
      <p>CREATOR ACCEPTANCE: NOT_RUN</p>
    </footer>
  </main>
</Base>

<style is:global>
  html:has(.kdx-semantic-index), body:has(.kdx-semantic-index) { margin: 0; min-height: 100%; background: #070808; color: #f2f3ee; }
  .kdx-semantic-index { min-height: 100dvh; padding: clamp(1rem, 3vw, 2.5rem); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
  .kdx-semantic-index header { border-bottom: 1px solid #343836; padding-bottom: 1.25rem; }
  .kdx-semantic-index header > p:first-child, .kdx-semantic-index footer { color: #8c9491; font-size: .68rem; letter-spacing: .1em; }
  .kdx-semantic-index .lede { max-width: 64ch; color: #aeb5b2; font-size: .8rem; }
  .kdx-semantic-index h1 { margin: .35rem 0 1rem; font: 500 clamp(2.2rem, 7vw, 6.5rem)/.9 ui-sans-serif, system-ui, sans-serif; letter-spacing: -.06em; }
  .kdx-semantic-index section { display: grid; grid-template-columns: 1fr; margin-top: 1rem; border-top: 1px solid #242826; border-left: 1px solid #242826; }
  .kdx-semantic-index section a { min-height: 7rem; padding: .8rem; border-right: 1px solid #242826; border-bottom: 1px solid #242826; color: inherit; text-decoration: none; display: grid; grid-template-columns: 2rem minmax(0, 1fr) minmax(12rem, .8fr) auto; align-items: center; gap: .8rem; }
  .kdx-semantic-index section a:hover, .kdx-semantic-index section a:focus-visible { outline: none; background: #0e1110; box-shadow: inset 0 0 0 1px #d7ff4f; }
  .kdx-semantic-index a > span, .kdx-semantic-index a small, .kdx-semantic-index a code { color: #7f8784; font-size: .62rem; }
  .kdx-semantic-index a div { display: grid; gap: .35rem; }
  .kdx-semantic-index a b { color: #d7ff4f; font-size: .65rem; font-weight: 500; }
  .kdx-semantic-index footer { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1rem; }
  @media (max-width: 760px) {
    .kdx-semantic-index section a { grid-template-columns: 1.7rem minmax(0, 1fr) auto; }
    .kdx-semantic-index section a code { display: none; }
    .kdx-semantic-index footer { display: grid; }
  }
</style>
