---
import KodexThresholdGpuRecovery from '../../../../components/kodex/threshold-recovery/KodexThresholdGpuRecovery.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="color-scheme" content="dark" />
    <title>KODEX−∞ · THRESHOLD GPU Recovery</title>
    <meta name="description" content="KOD-49 recovered WebGL2 Threshold comparison lane." />
  </head>
  <body>
    <main class="kdx-recovery" data-recovery-root aria-labelledby="recovery-title">
      <KodexThresholdGpuRecovery class="kdx-recovery__visual" />
      <div class="kdx-recovery__veil" aria-hidden="true"></div>
      <div class="kdx-recovery__macro" aria-hidden="true">THRESHOLD</div>

      <header class="kdx-recovery__header">
        <div class="kdx-recovery__brand">
          <strong>KODEX−∞</strong>
          <span>00 / THRESHOLD</span>
          <span>GPU RECOVERY / KOD-49</span>
        </div>
        <div class="kdx-recovery__status">
          <span class="kdx-recovery__dot" aria-hidden="true"></span>
          <span>STATE <strong data-state>DORMANT</strong></span>
          <span data-renderer>RENDERER / INITIALIZING</span>
        </div>
      </header>

      <aside class="kdx-recovery__rail kdx-recovery__rail--left" aria-label="Threshold input contract">
        <div class="kdx-recovery__rail-title">ENTRY PROTOCOL</div>
        <dl>
          <div><dt>INPUT</dt><dd>POINTER / TOUCH</dd></div>
          <div><dt>PROXIMITY</dt><dd>MODULATES</dd></div>
          <div><dt>DWELL</dt><dd>STABILIZES</dd></div>
          <div><dt>MEMORY WRITE</dt><dd>NONE BEFORE ENTRY</dd></div>
          <div><dt>IDENTITY CLAIM</dt><dd>NONE</dd></div>
        </dl>
      </aside>

      <section class="kdx-recovery__copy">
        <p class="kdx-recovery__kicker">A / −∞ / THE FIRST CONSEQUENCE</p>
        <h1 id="recovery-title">THE GATE IS A<br />LIVING AGREEMENT.</h1>
        <p class="kdx-recovery__lede">
          Presence changes the field. It does not identify you. Crossing remains an explicit choice.
        </p>
        <p class="kdx-recovery__question">WILL YOU ENTER A SYSTEM THAT REMEMBERS TRANSFORMATION?</p>
        <a class="kdx-recovery__cta" href="/kodex/lab/visible-assembly/">
          <span>00</span>
          <strong>ENTER VOLUNTARILY</strong>
          <small>PRESS / TAP / CONTINUE</small>
        </a>
      </section>

      <aside class="kdx-recovery__rail kdx-recovery__rail--right" aria-label="Recovered renderer provenance">
        <div class="kdx-recovery__rail-title">RECOVERED ENGINE</div>
        <dl>
          <div><dt>SOURCE</dt><dd>OPEN VISUAL LAB V1</dd></div>
          <div><dt>PASS</dt><dd>THRESHOLD PORTAL</dd></div>
          <div><dt>FEEDBACK</dt><dd>FRAME PING-PONG</dd></div>
          <div><dt>MOTION</dt><dd>PREFERS-REDUCED AWARE</dd></div>
          <div><dt>PUBLIC ROUTE</dt><dd>UNCHANGED</dd></div>
        </dl>
      </aside>

      <div class="kdx-recovery__crosshair" aria-hidden="true"><i></i><b></b></div>

      <footer class="kdx-recovery__footer">
        <span>RECOVER → COMPARE → TUNE → INTEGRATE</span>
        <span>VISUAL TARGET / APPROVED THRESHOLD REFERENCES</span>
        <span>NOINDEX / NOT PRODUCTION</span>
      </footer>

      <p class="kdx-recovery__live sr-only" aria-live="polite" data-live>
        Threshold recovery renderer initializing.
      </p>
    </main>

    <script>
      const root = document.querySelector<HTMLElement>('[data-recovery-root]');
      if (root) {
        const state = root.querySelector<HTMLElement>('[data-state]');
        const renderer = root.querySelector<HTMLElement>('[data-renderer]');
        const live = root.querySelector<HTMLElement>('[data-live]');
        root.addEventListener('kdx:threshold-recovery-state', (event) => {
          const detail = (event as CustomEvent<{ state: string; renderer: string }>).detail;
          if (!detail) return;
          if (state) state.textContent = detail.state;
          if (renderer) renderer.textContent = `RENDERER / ${detail.renderer}`;
          if (live) live.textContent = `Threshold visual state ${detail.state}. Renderer ${detail.renderer}.`;
        });
      }
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html), :global(body) { margin: 0; width: 100%; height: 100%; background: #010102; }
  :global(body) {
    overflow: hidden;
    color: #f5f3ee;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  :global(a) { color: inherit; }

  .kdx-recovery {
    position: relative;
    width: 100vw;
    height: 100svh;
    min-height: 38rem;
    overflow: hidden;
    isolation: isolate;
    background: #010102;
  }
  .kdx-recovery__visual { z-index: 0; }
  .kdx-recovery__veil {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(0 0 0 / .78) 0 22%, transparent 43% 72%, rgb(0 0 0 / .5) 100%),
      linear-gradient(0deg, rgb(0 0 0 / .55), transparent 22% 80%, rgb(0 0 0 / .35));
  }
  .kdx-recovery__macro {
    position: absolute;
    z-index: 2;
    left: 3vw;
    top: 8vh;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(6rem, 17vw, 19rem);
    line-height: .75;
    font-weight: 800;
    letter-spacing: -.075em;
    color: rgb(255 255 255 / .025);
    pointer-events: none;
    white-space: nowrap;
  }

  .kdx-recovery__header,
  .kdx-recovery__footer {
    position: absolute;
    z-index: 10;
    inset-inline: max(1rem, env(safe-area-inset-left)) max(1rem, env(safe-area-inset-right));
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: rgb(245 243 238 / .48);
    font-size: clamp(.56rem, .75vw, .68rem);
    letter-spacing: .105em;
    text-transform: uppercase;
  }
  .kdx-recovery__header { top: max(.85rem, env(safe-area-inset-top)); }
  .kdx-recovery__footer { bottom: max(.75rem, env(safe-area-inset-bottom)); }
  .kdx-recovery__brand,
  .kdx-recovery__status { display: flex; gap: .55rem 1.1rem; flex-wrap: wrap; align-items: center; }
  .kdx-recovery__brand strong,
  .kdx-recovery__status strong { color: #f5f3ee; font-weight: 600; }
  .kdx-recovery__dot { width: .42rem; height: .42rem; border-radius: 50%; background: #a675ff; box-shadow: 0 0 1rem #7d41ff; }

  .kdx-recovery__copy {
    position: absolute;
    z-index: 8;
    left: clamp(1.25rem, 6vw, 7rem);
    top: 50%;
    width: min(37rem, 42vw);
    transform: translateY(-44%);
  }
  .kdx-recovery__kicker {
    margin: 0 0 1.3rem;
    color: #b69bff;
    font-size: .64rem;
    letter-spacing: .18em;
  }
  .kdx-recovery h1 {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(3.5rem, 6.5vw, 7.6rem);
    line-height: .82;
    letter-spacing: -.068em;
    font-weight: 700;
    text-wrap: balance;
  }
  .kdx-recovery__lede {
    max-width: 43ch;
    margin: 1.45rem 0 0;
    color: rgb(245 243 238 / .57);
    font-size: clamp(.74rem, .9vw, .9rem);
    line-height: 1.65;
  }
  .kdx-recovery__question {
    max-width: 45ch;
    margin: 1.5rem 0 0;
    color: rgb(245 243 238 / .82);
    font-size: .63rem;
    line-height: 1.6;
    letter-spacing: .12em;
  }
  .kdx-recovery__cta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .25rem .85rem;
    width: min(23rem, 100%);
    margin-top: 1.45rem;
    padding: .95rem 1rem;
    border: 1px solid rgb(183 151 255 / .5);
    background: rgb(6 4 12 / .67);
    backdrop-filter: blur(10px);
    text-decoration: none;
    box-shadow: 0 1rem 4rem rgb(0 0 0 / .4);
  }
  .kdx-recovery__cta span { grid-row: 1 / 3; color: #a675ff; font-size: .62rem; }
  .kdx-recovery__cta strong { font-size: .74rem; letter-spacing: .12em; }
  .kdx-recovery__cta small { color: rgb(245 243 238 / .42); font-size: .58rem; letter-spacing: .08em; }
  .kdx-recovery__cta:hover,
  .kdx-recovery__cta:focus-visible { outline: none; border-color: #e4dbff; background: rgb(31 17 58 / .72); }

  .kdx-recovery__rail {
    position: absolute;
    z-index: 7;
    top: 19vh;
    width: clamp(10rem, 15vw, 15rem);
    color: rgb(245 243 238 / .45);
    font-size: .54rem;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .kdx-recovery__rail--left { left: max(1rem, 2vw); transform: translateY(29rem); }
  .kdx-recovery__rail--right { right: max(1rem, 2vw); }
  .kdx-recovery__rail-title { padding-bottom: .55rem; border-bottom: 1px solid rgb(255 255 255 / .13); color: rgb(245 243 238 / .75); }
  .kdx-recovery__rail dl { margin: .3rem 0 0; }
  .kdx-recovery__rail dl div {
    display: grid;
    grid-template-columns: .82fr 1.18fr;
    gap: .4rem;
    padding: .38rem 0;
    border-bottom: 1px solid rgb(255 255 255 / .065);
  }
  .kdx-recovery__rail dt,
  .kdx-recovery__rail dd { margin: 0; }
  .kdx-recovery__rail dd { text-align: right; color: rgb(245 243 238 / .72); }

  .kdx-recovery__crosshair {
    position: absolute;
    z-index: 6;
    left: 62%;
    top: 49%;
    width: 3.4rem;
    height: 3.4rem;
    transform: translate(-50%, -50%);
    border: 1px solid rgb(225 214 255 / .18);
    border-radius: 50%;
    pointer-events: none;
  }
  .kdx-recovery__crosshair::before,
  .kdx-recovery__crosshair::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    background: rgb(225 214 255 / .34);
    transform: translate(-50%, -50%);
  }
  .kdx-recovery__crosshair::before { width: 4.5rem; height: 1px; }
  .kdx-recovery__crosshair::after { width: 1px; height: 4.5rem; }
  .kdx-recovery__crosshair i {
    position: absolute;
    inset: -.8rem;
    border: 1px solid rgb(166 117 255 / .08);
    border-radius: 50%;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .kdx-recovery { min-height: 0; }
    .kdx-recovery__veil {
      background:
        linear-gradient(0deg, rgb(0 0 0 / .76) 0 44%, transparent 68% 100%),
        radial-gradient(circle at 50% 30%, transparent 0 28%, rgb(0 0 0 / .18) 58%, rgb(0 0 0 / .44));
    }
    .kdx-recovery__macro { left: -4vw; top: 9vh; font-size: 28vw; }
    .kdx-recovery__header { align-items: flex-start; }
    .kdx-recovery__brand span:last-child { display: none; }
    .kdx-recovery__status { justify-content: flex-end; max-width: 46vw; text-align: right; }
    .kdx-recovery__copy {
      left: 1rem;
      right: 1rem;
      top: auto;
      bottom: max(3.1rem, calc(env(safe-area-inset-bottom) + 2.7rem));
      width: auto;
      transform: none;
    }
    .kdx-recovery h1 { font-size: clamp(3rem, 13.5vw, 5.4rem); max-width: 9ch; }
    .kdx-recovery__lede { max-width: 38ch; margin-top: .95rem; font-size: .72rem; }
    .kdx-recovery__question { margin-top: .85rem; max-width: 40ch; }
    .kdx-recovery__cta { width: min(21rem, 92vw); margin-top: .9rem; padding: .78rem .85rem; }
    .kdx-recovery__rail--left { left: 1rem; top: 5.4rem; transform: none; width: 10.5rem; }
    .kdx-recovery__rail--left dl div:nth-child(n+4) { display: none; }
    .kdx-recovery__rail--right { right: 1rem; top: 5.4rem; width: 10.5rem; }
    .kdx-recovery__rail--right dl div:nth-child(n+3) { display: none; }
    .kdx-recovery__crosshair { left: 50%; top: 31%; }
    .kdx-recovery__footer span:nth-child(2) { display: none; }
  }

  @media (max-height: 720px) and (max-width: 900px) {
    .kdx-recovery__lede { display: none; }
    .kdx-recovery__question { font-size: .56rem; }
    .kdx-recovery__rail { display: none; }
    .kdx-recovery__copy { bottom: 2.6rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kdx-recovery__dot { box-shadow: none; }
  }
</style>
