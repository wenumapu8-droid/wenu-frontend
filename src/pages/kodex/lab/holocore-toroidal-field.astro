---
import Base from '../../../layouts/Base.astro';
---

<Base
  title="KODEX−∞ · Toroidal Field"
  description="Internal KODEX perceptual benchmark for a dominant toroidal HoloCore field."
  robots="noindex, nofollow"
  kodexFonts={true}
  noNav={true}
  noFooter={true}
  noOverlays={true}
  noQuote={true}
  noThemes={true}
  noKai={true}
  noCart={true}
  noImmersive={true}
>
  <main class="toroid-lab" data-kdx-toroid-lab data-state="boot" tabindex="-1" aria-labelledby="toroid-title">
    <canvas data-toroid-canvas role="img" aria-label="Authored toroidal KODEX field; an artistic computational metaphor, not a scientific simulation"></canvas>
    <div class="toroid-lab__aura" aria-hidden="true"></div>
    <div class="toroid-lab__grain" aria-hidden="true"></div>

    <header class="toroid-lab__identity">
      <p>KDX-HOLO-BENCH-001</p>
      <h1 id="toroid-title">TOROIDAL FIELD</h1>
      <span>ART / COMP / SPEC</span>
    </header>

    <aside class="toroid-lab__status" aria-live="polite">
      <span data-toroid-state>RESOLVING FIELD</span>
      <span>24.00 S CLOSED LOOP</span>
    </aside>

    <p class="toroid-lab__note">A field turning through itself. Observe; do not optimize.</p>
  </main>

  <script>
    import { AsciiRenderer } from '../../../kodex/ascii/engine/AsciiRenderer.js';
    import { holocoreToroidalFieldScene } from '../../../kodex/ascii/scenes/holocore-toroidal-field.js';

    const instances = new WeakMap();

    function mount(root) {
      if (!(root instanceof HTMLElement) || instances.has(root)) return;
      const canvas = root.querySelector('[data-toroid-canvas]');
      const stateLabel = root.querySelector('[data-toroid-state]');
      if (!(canvas instanceof HTMLCanvasElement)) return;

      const renderer = new AsciiRenderer(canvas, {
        scene: holocoreToroidalFieldScene,
        profile: 'full',
        glyphSet: 'kodex',
        palette: ['#010103', '#090713', '#1e1533', '#4a2b69', '#9a63d7', '#eee7ff'],
      });

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let destroyed = false;
      let freezeTimer = 0;

      const stable = () => {
        if (destroyed) return;
        root.dataset.state = 'stable';
        if (stateLabel) stateLabel.textContent = reduced ? 'STILL FIELD' : 'STABLE FIELD';
        root.focus({ preventScroll: true });
      };

      const start = async () => {
        root.dataset.state = 'resolving';
        try { await document.fonts?.ready; } catch {}
        if (destroyed) return;
        renderer.start();
        requestAnimationFrame(() => root.classList.add('is-visible'));
        if (reduced) {
          freezeTimer = window.setTimeout(() => {
            renderer.stop();
            stable();
          }, 220);
        } else {
          window.setTimeout(stable, 720);
        }
      };

      void start();

      const destroy = () => {
        destroyed = true;
        window.clearTimeout(freezeTimer);
        renderer.destroy();
        instances.delete(root);
      };

      instances.set(root, { destroy });
    }

    function mountAll() {
      document.querySelectorAll('[data-kdx-toroid-lab]').forEach(mount);
    }

    mountAll();
    document.addEventListener('astro:page-load', mountAll);
    document.addEventListener('astro:before-swap', () => {
      document.querySelectorAll('[data-kdx-toroid-lab]').forEach(root => instances.get(root)?.destroy());
    });
  </script>
</Base>

<style is:global>
  html:has(.toroid-lab),
  body:has(.toroid-lab) {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow: hidden;
    background: #010103;
  }
</style>

<style>
  .toroid-lab {
    --accent: #a66cff;
    box-sizing: border-box;
    position: relative;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    isolation: isolate;
    outline: none;
    color: #f0ebf5;
    background:
      radial-gradient(circle at 50% 49%, rgba(90, 48, 132, .13), transparent 38%),
      radial-gradient(circle at 50% 50%, #050308 0, #010103 68%);
    font-family: 'Share Tech Mono', ui-monospace, monospace;
  }

  [data-toroid-canvas] {
    position: absolute;
    z-index: 2;
    inset: 3.5vh 3vw;
    display: block;
    width: 94vw;
    height: 93dvh;
    opacity: 0;
    transform: scale(.985);
    filter: contrast(1.28) saturate(1.04) drop-shadow(0 0 18px rgba(150, 89, 221, .22));
    transition: opacity 1.1s ease, transform 2.4s cubic-bezier(.18,.72,.18,1);
  }

  .is-visible [data-toroid-canvas] {
    opacity: 1;
    transform: scale(1);
  }

  .toroid-lab__aura,
  .toroid-lab__grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .toroid-lab__aura {
    z-index: 3;
    background:
      radial-gradient(ellipse at center, transparent 28%, rgba(1,1,3,.12) 49%, rgba(1,1,3,.72) 84%),
      linear-gradient(90deg, rgba(1,1,3,.55), transparent 13% 87%, rgba(1,1,3,.55));
  }

  .toroid-lab__grain {
    z-index: 4;
    opacity: .11;
    background: repeating-linear-gradient(to bottom, rgba(255,255,255,.026) 0 1px, transparent 1px 4px);
    mix-blend-mode: soft-light;
  }

  .toroid-lab__identity {
    position: absolute;
    z-index: 6;
    top: clamp(18px, 4vh, 44px);
    left: clamp(18px, 4vw, 64px);
    pointer-events: none;
  }

  .toroid-lab__identity p,
  .toroid-lab__identity span,
  .toroid-lab__status,
  .toroid-lab__note {
    margin: 0;
    font-size: 7px;
    line-height: 1.25;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(232,223,242,.45);
  }

  .toroid-lab__identity h1 {
    margin: 7px 0 6px;
    max-width: 10ch;
    font: 400 clamp(30px, 4.5vw, 72px)/.78 'Cormorant Garamond', 'Times New Roman', serif;
    letter-spacing: .08em;
    color: rgba(245,239,250,.88);
  }

  .toroid-lab__status {
    position: absolute;
    z-index: 6;
    top: clamp(20px, 4vh, 46px);
    right: clamp(18px, 4vw, 64px);
    display: grid;
    justify-items: end;
    gap: 7px;
    pointer-events: none;
  }

  .toroid-lab__note {
    position: absolute;
    z-index: 6;
    left: 50%;
    bottom: clamp(18px, 3.5vh, 38px);
    transform: translateX(-50%);
    width: min(82vw, 620px);
    text-align: center;
    letter-spacing: .12em;
    color: rgba(232,223,242,.31);
    pointer-events: none;
  }

  @media (max-width: 700px) {
    [data-toroid-canvas] {
      inset: 8dvh -12vw 5dvh;
      width: 124vw;
      height: 87dvh;
    }

    .toroid-lab__identity h1 { font-size: clamp(34px, 13vw, 54px); }
    .toroid-lab__status { top: auto; bottom: 58px; right: 16px; gap: 4px; }
    .toroid-lab__status span:last-child { display: none; }
    .toroid-lab__note { bottom: 20px; font-size: 6px; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-toroid-canvas] { transition: none; opacity: 1; transform: none; }
  }
</style>
