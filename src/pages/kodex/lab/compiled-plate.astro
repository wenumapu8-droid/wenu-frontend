---
/**
 * KODEX-∞ · LAB · PROOF DE ASSEMBLY OS L8 COMPILED PLATE
 *
 * Monta el output verificable del Assembly OS L8 Plate Assembler
 * (Mini, rama main). Es la evidencia visual de que la cadena L6→L10
 * cierra end-to-end:
 *
 *   L6 Element Library (17 HoloCore RGX cores machine-readable)
 *   L7 Recipe Engine (KDX_RECIPE_01 = OBSERVE)
 *   L8 Plate Assembler → KodexPlateCompiled.astro con:
 *      · Specimen id: spec-02a52eb7-9856
 *      · Checksum SHA-256: 434f1a05...928f9039
 *      · 5 slots wired a componentes reales (Observe, Field, CRT, Eje, Ascii)
 *      · Fallback declarado por cada slot
 *
 * NO ES UNA ESCENA DEL CORREDOR (regla: `pages/kodex/lab/**` = biblioteca).
 * Es lab route para inspeccion tecnica: si esta pagina renderiza limpio, la
 * cadena Assembly OS funciona en el corredor sin necesidad de reconciliar
 * runtime en cada escena.
 *
 * Fuente del componente: `src/components/kodex/compiled/KodexPlateCompiled.astro`,
 * generado por `ops/factory/assembler/plate_assembler.py` (rama main Mini).
 */
import KodexShell from '../../../layouts/KodexShell.astro';
import KodexPlateCompiled from '../../../components/kodex/compiled/KodexPlateCompiled.astro';
---

<KodexShell title="KODEX −∞ · LAB · Assembly OS L8 Compiled Plate Proof">
  <main class="kdx-lab-compiled" data-kdx-lab data-noindex>
    <header class="kdx-lab-compiled__head">
      <p class="kdx-lab-compiled__eyebrow">LAB · ASSEMBLY OS PROOF</p>
      <h1 class="kdx-lab-compiled__title">L8 COMPILED PLATE</h1>
      <dl class="kdx-lab-compiled__meta">
        <div>
          <dt>SPECIMEN</dt>
          <dd data-verbatim>spec-02a52eb7-9856</dd>
        </div>
        <div>
          <dt>RECIPE</dt>
          <dd data-verbatim>KDX_RECIPE_01 · OBSERVE</dd>
        </div>
        <div>
          <dt>CHECKSUM</dt>
          <dd data-verbatim>434f1a05ae7ea903be39f75ab50597bb980558fe19b46e5463947423928f9039</dd>
        </div>
        <div>
          <dt>SLOTS</dt>
          <dd>5 · hero-viewport / background-canvas / post-processing / vertical-axis / emblem</dd>
        </div>
      </dl>
      <p class="kdx-lab-compiled__note">
        Fuente: <code>ops/factory/assembler/plate_assembler.py</code>
        (Mini, rama <code>main</code>, Assembly OS v0.1). Si esta plancha
        renderiza limpio, la cadena L6→L10 cierra end-to-end sin volver a
        cablear runtime en cada escena.
      </p>
    </header>
    <div class="kdx-lab-compiled__frame">
      <KodexPlateCompiled />
    </div>
    <footer class="kdx-lab-compiled__foot">
      <p>
        Regla dura del proyecto: <code>pages/kodex/lab/**</code> es
        biblioteca de laboratorio, no corredor. Esta pagina es evidencia
        tecnica, no experiencia canonica.
      </p>
    </footer>
  </main>

  <style>
    .kdx-lab-compiled {
      padding: 32px clamp(16px, 4vw, 48px);
      color: var(--kdx-bone, #f0ede8);
      background: var(--kdx-obsidian, #0a0a0a);
      min-height: 100dvh;
    }
    .kdx-lab-compiled__head {
      max-width: 960px;
      margin: 0 auto 32px;
    }
    .kdx-lab-compiled__eyebrow {
      margin: 0 0 4px;
      font: 500 10px/1.6 ui-monospace, "SF Mono", Menlo, monospace;
      letter-spacing: 0.24em;
      color: var(--kdx-ember, #c9a84c);
      text-transform: uppercase;
    }
    .kdx-lab-compiled__title {
      margin: 0 0 24px;
      font: 400 clamp(28px, 5vw, 44px)/1.1 "Instrument Serif", serif;
    }
    .kdx-lab-compiled__meta {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      margin: 0 0 24px;
      padding: 16px;
      border: 1px solid color-mix(in srgb, var(--kdx-bone, #f0ede8) 20%, transparent);
      background: color-mix(in srgb, var(--kdx-bone, #f0ede8) 4%, transparent);
    }
    .kdx-lab-compiled__meta div {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .kdx-lab-compiled__meta dt {
      font: 500 9px/1.6 ui-monospace, "SF Mono", Menlo, monospace;
      letter-spacing: 0.2em;
      color: color-mix(in srgb, var(--kdx-bone, #f0ede8) 60%, transparent);
      text-transform: uppercase;
    }
    .kdx-lab-compiled__meta dd {
      margin: 0;
      font: 400 12px/1.4 ui-monospace, "SF Mono", Menlo, monospace;
      color: var(--kdx-bone, #f0ede8);
      overflow-wrap: anywhere;
    }
    .kdx-lab-compiled__meta dd[data-verbatim] {
      color: var(--kdx-ember, #c9a84c);
    }
    .kdx-lab-compiled__note {
      margin: 0;
      font: 400 13px/1.6 "Instrument Sans", system-ui, sans-serif;
      color: color-mix(in srgb, var(--kdx-bone, #f0ede8) 80%, transparent);
    }
    .kdx-lab-compiled__note code {
      font: 500 12px/1.3 ui-monospace, "SF Mono", Menlo, monospace;
      color: var(--kdx-bone, #f0ede8);
    }
    .kdx-lab-compiled__frame {
      max-width: 1400px;
      margin: 0 auto 32px;
      padding: 16px;
      border: 1px solid color-mix(in srgb, var(--kdx-ember, #c9a84c) 40%, transparent);
      background: #000;
      min-height: 60dvh;
    }
    .kdx-lab-compiled__foot {
      max-width: 960px;
      margin: 0 auto;
      padding-top: 16px;
      border-top: 1px solid color-mix(in srgb, var(--kdx-bone, #f0ede8) 12%, transparent);
    }
    .kdx-lab-compiled__foot p {
      margin: 0;
      font: 400 11px/1.6 "Instrument Sans", system-ui, sans-serif;
      color: color-mix(in srgb, var(--kdx-bone, #f0ede8) 55%, transparent);
    }
    .kdx-lab-compiled__foot code {
      color: var(--kdx-bone, #f0ede8);
    }
  </style>
</KodexShell>
