---
/**
 * KODEX−∞ · ESCENA 04 · DIGITAL ALTAR — el lab
 *
 * Prototipo de memoria LOCAL, por mandato: "Digital Altar local-memory
 * prototype before public Commons." Nada de lo ofrecido sale del navegador,
 * y la página lo dice en pantalla en vez de darlo por entendido.
 */
import Base from '../../../layouts/Base.astro';
import { ALTAR, SIMBOLOS, MAX_PALABRA } from '../../../lib/kodex/escenas/altar';
---

<Base
  title="KODEX Lab — Digital Altar"
  description="Private KODEX Digital Altar local-memory lab."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <section class="kdx-altar" data-kdx-altar data-state="dormant">
    <header class="kdx-altar__header">
      <a class="kdx-altar__logo" href="/kodex/">KODEX−∞</a>
      <div class="kdx-altar__meta">
        <span>SCENE 04 / DIGITAL ALTAR</span>
        <span>KDX://OFFERING/LOCAL</span>
      </div>
    </header>

    <div class="kdx-altar__stage">
      <canvas class="kdx-altar__canvas" data-kdx-altar-canvas aria-label="signal vortex — click to select a coordinate"></canvas>

      <div class="kdx-altar__body">
        <p class="kdx-altar__kicker">INSTRUMENT / OFFERING / VORTEX</p>
        <h1 class="kdx-altar__headline">{ALTAR.copy.weave}</h1>
        <p class="kdx-altar__lede">
          Leave a word, place a symbol, or click the field to choose a
          coordinate. What you offer travels into the archive — you will see it
          go. Everything stays in this browser. Nothing is sent anywhere.
        </p>

        <div class="kdx-altar__compose">
          <input
            class="kdx-altar__input" data-kdx-word type="text"
            maxlength={MAX_PALABRA} placeholder="A WORD FOR THE ARCHIVE"
            aria-label="word to offer"
          />
          <button class="kdx-altar__btn" type="button" data-kdx-offer-word>OFFER THE WORD</button>
        </div>

        <div class="kdx-altar__symbols" role="group" aria-label="symbols to place">
          {SIMBOLOS.map((s) => (
            <button class="kdx-altar__symbol" type="button" data-kdx-symbol>{s}</button>
          ))}
          <button class="kdx-altar__btn kdx-altar__btn--ghost" type="button" data-kdx-offer-coord>
            OFFER THE COORDINATE
          </button>
        </div>

        <div class="kdx-altar__woven-wrap">
          <p class="kdx-altar__woven-title">WOVEN · LOCAL ONLY</p>
          <div class="kdx-altar__woven" data-kdx-woven></div>
          <button class="kdx-altar__btn kdx-altar__btn--ghost" type="button" data-kdx-release>
            RELEASE EVERYTHING
          </button>
        </div>
      </div>
    </div>

    <footer class="kdx-altar__footer">
      <span>{ALTAR.node_id}</span>
      <span>STATE · <em data-kdx-state-readout>DORMANT</em></span>
      <span>LOCAL MEMORY · PUBLIC COMMONS IS A LATER, OPT-IN PHASE</span>
    </footer>
  </section>
</Base>

<style>
  .kdx-altar{
    min-height:100vh; min-height:100dvh; display:flex; flex-direction:column;
    background:#0a0a0a; color:#f0ede8; font-family:'IBM Plex Mono',ui-monospace,monospace;
  }
  .kdx-altar__header{
    display:flex; justify-content:space-between; align-items:center; gap:16px;
    padding:clamp(14px,2.4vh,22px) clamp(18px,3.4vw,44px);
    border-bottom:1px solid rgba(240,237,232,.1);
  }
  .kdx-altar__logo{ color:#f0ede8; text-decoration:none; letter-spacing:.18em; font-size:14px; }
  .kdx-altar__meta{ display:flex; gap:18px; font-size:10px; letter-spacing:.16em; color:rgba(240,237,232,.45); }
  .kdx-altar__stage{ position:relative; flex:1; display:grid; place-items:center; overflow:hidden; }
  .kdx-altar__canvas{ position:absolute; inset:0; width:100%; height:100%; cursor:crosshair;
    opacity:calc(.55 + var(--kdx-memoria,0) * .35); }
  .kdx-altar__body{
    position:relative; z-index:1; max-width:600px; width:min(92vw,600px);
    padding:clamp(22px,4vh,40px) clamp(18px,4vw,32px);
    display:flex; flex-direction:column; align-items:center; text-align:center; gap:clamp(12px,2vh,18px);
    pointer-events:none; /* el campo de atrás recibe los clicks de coordenada */
  }
  .kdx-altar__body > *{ pointer-events:auto; }
  .kdx-altar__kicker{ margin:0; font-size:10px; letter-spacing:.24em; color:#b07ecd; }
  .kdx-altar__headline{
    margin:0; font-family:'Cormorant Garamond',Georgia,serif; font-weight:400;
    font-size:clamp(26px,3.6vw,44px); line-height:1.14; text-wrap:balance;
  }
  .kdx-altar__lede{ margin:0; max-width:48ch; font-size:11.5px; line-height:1.7; letter-spacing:.05em; color:rgba(240,237,232,.62); }
  .kdx-altar__compose{ display:flex; gap:8px; width:100%; max-width:460px; }
  .kdx-altar__input{
    flex:1; min-height:40px; padding:0 12px; font:inherit; font-size:11px; letter-spacing:.12em;
    background:rgba(240,237,232,.05); color:#f0ede8; border:1px solid rgba(240,237,232,.25);
  }
  .kdx-altar__input:focus{ outline:none; border-color:#b07ecd; }
  .kdx-altar__btn{
    min-height:40px; padding:0 16px; cursor:pointer; font:inherit; font-size:10px; letter-spacing:.18em;
    background:rgba(176,126,205,.12); color:#f0ede8; border:1px solid rgba(176,126,205,.55);
    transition:background .2s ease, color .2s ease;
  }
  .kdx-altar__btn:hover{ background:#b07ecd; color:#0a0a0a; }
  .kdx-altar__btn--ghost{ background:transparent; border-color:rgba(240,237,232,.25); }
  .kdx-altar__symbols{ display:flex; flex-wrap:wrap; justify-content:center; gap:8px; }
  .kdx-altar__symbol{
    width:44px; height:44px; cursor:pointer; font-size:17px; color:#f0ede8;
    background:transparent; border:1px solid rgba(240,237,232,.2);
    transition:border-color .2s ease, background .2s ease;
  }
  .kdx-altar__symbol:hover{ border-color:#b07ecd; background:rgba(176,126,205,.12); }
  .kdx-altar__woven-wrap{ width:100%; max-width:460px; display:flex; flex-direction:column; gap:8px;
    border:1px solid rgba(240,237,232,.14); padding:12px 14px; }
  .kdx-altar__woven-title{ margin:0; font-size:9.5px; letter-spacing:.2em; color:rgba(240,237,232,.45); text-align:left; }
  .kdx-altar__woven{ min-height:34px; max-height:150px; overflow-y:auto; text-align:left; }
  .kdx-altar__woven p{ margin:0; font-size:10px; line-height:2; letter-spacing:.08em; color:rgba(240,237,232,.68); }
  .kdx-altar__footer{
    display:flex; flex-wrap:wrap; justify-content:space-between; gap:10px;
    padding:12px clamp(18px,3.4vw,44px); border-top:1px solid rgba(240,237,232,.1);
    font-size:9.5px; letter-spacing:.16em; color:rgba(240,237,232,.4);
  }
  .kdx-altar__footer em{ font-style:normal; color:#b07ecd; }
  @media (max-width:560px){
    .kdx-altar__meta{ display:none; }
    .kdx-altar__compose{ flex-direction:column; }
  }
</style>

<script>
  import { montarAltar } from '../../../lib/kodex/escenas/altar-cliente';
  const raiz = document.querySelector('[data-kdx-altar]');
  if (raiz instanceof HTMLElement) {
    montarAltar(raiz);
    const out = document.querySelector('[data-kdx-state-readout]');
    if (out) {
      new MutationObserver(() => {
        out.textContent = (raiz.dataset.state || 'dormant').toUpperCase();
      }).observe(raiz, { attributes: true, attributeFilter: ['data-state'] });
    }
  }
</script>
