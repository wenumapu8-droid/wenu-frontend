---
import SignalVortexLoop from '../../../../components/kodex/visual-systems/SignalVortexLoop.astro';

const requestedState = Astro.url.searchParams.get('state');
const state = requestedState === 'signal' ? 'signal' : 'black';
const reduced = Astro.url.searchParams.get('reduced') === '1';
const parsedSeed = Number.parseInt(Astro.url.searchParams.get('seed') || '1808', 10);
const seed = Number.isFinite(parsedSeed) ? parsedSeed : 1808;
const parsedDuration = Number.parseFloat(Astro.url.searchParams.get('duration') || '8');
const duration = Number.isFinite(parsedDuration) ? Math.min(30, Math.max(2, parsedDuration)) : 8;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="color-scheme" content="dark" />
    <title>KODEX VISUAL SYSTEMS — SIGNAL VORTEX LOOP 01</title>
    <style>
      * { box-sizing: border-box; }
      html, body, main { width: 100%; height: 100%; margin: 0; }
      html, body { overflow: hidden; background: #050505; }
      body { min-height: 100dvh; }
      main { position: fixed; inset: 0; }
    </style>
  </head>
  <body>
    <main
      data-kdx-visual-proof="KDX-VISUAL-SIGNAL-LOOP-001"
      data-source="KDX-SCREEN-SIGNAL-014"
      data-rights="NEEDS_CONFIRMATION"
      data-seed={String(seed)}
      data-duration={String(duration)}
      data-state={state}
    >
      <SignalVortexLoop seed={seed} duration={duration} state={state} reduced={reduced} />
    </main>
  </body>
</html>
