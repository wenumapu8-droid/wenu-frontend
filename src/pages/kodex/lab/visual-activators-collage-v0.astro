---
const activators = [
  {
    id: '00', scene: 'THRESHOLD', action: 'ENTER', accent: '#ff3b30',
    workId: 'OCN-MND-RED-001', fileId: '1W7CC8_XqlN31GNNU5R14YFWGegGj29Wc',
    mode: 'PULSE', line: 'THE GATE DOES NOT EXPLAIN ITSELF. IT RECOGNIZES.',
  },
  {
    id: '01', scene: 'PROLOGUE', action: 'BREATHE', accent: '#a975ff',
    workId: 'OCN-FRC-002', fileId: '1zAeyvWCkNleePJPxXfPmqke8iwjTLSMI',
    mode: 'EMERGE', line: 'BEFORE FORM, A PATTERN LEARNS TO APPEAR.',
  },
  {
    id: '02', scene: 'DESCENT', action: 'DESCEND', accent: '#7c4dff',
    workId: 'OCN-FRC-TUNNEL-001', fileId: '1DPsrHLLtpo7OEA9rchq9CUdwbvxUsJYu',
    mode: 'DEPTH', line: 'DEPTH IS NOT DISTANCE. IT IS RECURSION.',
  },
  {
    id: '03', scene: 'ARCHIVE', action: 'REVEAL', accent: '#30d5ff',
    workId: 'OCN-SQR-001', fileId: '12HskbMNm6lRGHgoUAQ43RbxF6idktRDO',
    mode: 'INDEX', line: 'EVERY FRAGMENT KEEPS A POSSIBLE RELATION.',
  },
  {
    id: '04', scene: 'MACHINE', action: 'ROTATE', accent: '#ff8a00',
    workId: 'OCN-TOR-001', fileId: '13jutXnFRQVnoXE1VO65LYeOgi9kC4jdh',
    mode: 'ENGINE', line: 'THE MACHINE DOES NOT THINK. IT TRANSFORMS SIGNAL.',
  },
  {
    id: '05', scene: 'COSMOLOGY', action: 'MAP', accent: '#adff2f',
    workId: 'OCN-FRC-COSMOS-001', fileId: '11wvq3IHYThJX9n705BUsTGRvp0VFpiiu',
    mode: 'FIELD', line: 'NO CENTER. ONLY RELATIONS AT DIFFERENT SCALES.',
  },
  {
    id: '06', scene: 'RETURN', action: 'RETURN', accent: '#ffffff',
    workId: 'OCN-TOR-RETURN-001', fileId: '13jutXnFRQVnoXE1VO65LYeOgi9kC4jdh',
    mode: 'INVERT', line: 'RETURN IS NOT THE END. IT IS FORM AFTER MEMORY.',
  },
];

const driveThumb = (fileId) => `https://drive.google.com/thumbnail?id=${fileId}&sz=w1600`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>KODEX−∞ — Visual Activators Collage V0</title>
    <style is:global>
      :root { color-scheme: dark; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
      * { box-sizing: border-box; }
      html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #050507; color: #ececec; }
      button { font: inherit; }
      .kdx { --accent: #ff3b30; position: relative; width: 100vw; height: 100dvh; overflow: hidden; isolation: isolate; background: #050507; }
      .kdx[data-scene="RETURN"] { background: #f4f2ed; color: #0a0a0b; }
      .grain, .scan { pointer-events:none; position:absolute; inset:0; z-index:20; }
      .grain { opacity:.11; background-image: radial-gradient(circle at 20% 20%, #fff 0 .55px, transparent .8px); background-size: 4px 4px; mix-blend-mode:soft-light; }
      .scan { opacity:.12; background: repeating-linear-gradient(to bottom, transparent 0 3px, #fff 4px, transparent 5px); }
      .shell { position:absolute; inset: max(14px, env(safe-area-inset-top)) max(14px, env(safe-area-inset-right)) max(14px, env(safe-area-inset-bottom)) max(14px, env(safe-area-inset-left)); display:grid; grid-template-rows:auto 1fr auto; gap:12px; z-index:2; }
      .top, .bottom { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:42px; }
      .brand { font: 700 clamp(21px,3vw,34px)/1 system-ui,sans-serif; letter-spacing:-.05em; }
      .scene-code, .state-label, .work-id, .hint { letter-spacing:.16em; font-size:10px; text-transform:uppercase; opacity:.68; }
      .stage { min-height:0; display:grid; grid-template-columns:minmax(0,1fr) minmax(230px,31vw); gap:clamp(12px,2vw,28px); align-items:stretch; }
      .art-zone { position:relative; min-height:0; border:1px solid color-mix(in srgb, var(--accent) 55%, transparent); overflow:hidden; background:#09090c; }
      [data-scene="RETURN"] .art-zone { background:#fff; border-color:#aaa; }
      .art-zone::before, .art-zone::after { content:""; position:absolute; z-index:4; pointer-events:none; inset:5%; border:1px solid color-mix(in srgb, var(--accent) 35%, transparent); transition:transform .8s cubic-bezier(.2,.8,.2,1), opacity .8s; }
      .art-zone::after { inset:12%; border-radius:50%; transform:rotate(22.5deg); opacity:.45; }
      .art { position:absolute; inset:4%; width:92%; height:92%; object-fit:contain; filter:none; transform:none; mix-blend-mode:normal; clip-path:none; opacity:1; transition:opacity .45s ease; }
      .ghost { position:absolute; z-index:3; pointer-events:none; border:1px solid var(--accent); overflow:hidden; background:#050507; opacity:.82; transition:all .8s cubic-bezier(.2,.8,.2,1); }
      .ghost img { width:100%; height:100%; object-fit:cover; }
      .g1 { width:23%; height:23%; right:3%; top:5%; }
      .g2 { width:17%; height:17%; left:4%; bottom:4%; }
      .crosshair { position:absolute; left:50%; top:50%; width:28px; height:28px; margin:-14px; z-index:5; border:1px solid var(--accent); border-radius:50%; opacity:.8; }
      .crosshair::before,.crosshair::after { content:""; position:absolute; background:var(--accent); }
      .crosshair::before { width:44px;height:1px;left:-9px;top:13px; }
      .crosshair::after { width:1px;height:44px;left:13px;top:-9px; }
      .panel { border:1px solid color-mix(in srgb, var(--accent) 35%, transparent); padding:clamp(16px,2.5vw,34px); display:flex; flex-direction:column; justify-content:space-between; min-height:0; background:linear-gradient(160deg, color-mix(in srgb, var(--accent) 7%, #050507), #050507 60%); }
      [data-scene="RETURN"] .panel { background:#f4f2ed; border-color:#bbb; }
      .number { color:var(--accent); font-size:clamp(34px,5vw,72px); font-weight:300; line-height:.85; }
      .scene { margin:.25em 0 0; font:700 clamp(24px,4.4vw,64px)/.9 system-ui,sans-serif; letter-spacing:.03em; }
      .mode { margin-top:12px; color:var(--accent); letter-spacing:.18em; font-size:11px; }
      .line { max-width:24ch; font-size:clamp(15px,1.6vw,24px); line-height:1.45; letter-spacing:.03em; }
      .states { display:grid; grid-template-columns:repeat(6,1fr); gap:4px; margin:16px 0; }
      .state { height:3px; background:color-mix(in srgb, currentColor 18%, transparent); }
      .state.on { background:var(--accent); box-shadow:0 0 12px color-mix(in srgb, var(--accent) 65%, transparent); }
      .activate { width:100%; min-height:50px; border:1px solid var(--accent); color:inherit; background:transparent; letter-spacing:.2em; text-transform:uppercase; cursor:pointer; transition:background .2s,color .2s,box-shadow .2s; }
      .activate:hover,.activate:focus-visible { outline:none; background:var(--accent); color:#050507; box-shadow:0 0 28px color-mix(in srgb,var(--accent) 30%,transparent); }
      .nav { display:flex; gap:8px; align-items:center; }
      .nav button { width:34px;height:34px;border:1px solid color-mix(in srgb,currentColor 30%,transparent);background:transparent;color:inherit;cursor:pointer; }
      .progress { display:flex; flex:1; justify-content:center; gap:8px; }
      .dot { width:8px;height:8px;border-radius:50%;border:1px solid currentColor;opacity:.35;cursor:pointer;background:transparent;padding:0; }
      .dot.active { opacity:1;background:var(--accent);border-color:var(--accent);box-shadow:0 0 10px var(--accent); }
      .kdx[data-phase="aware"] .art-zone::before { transform:scale(.97); }
      .kdx[data-phase="focus"] .art-zone::after { transform:rotate(67.5deg) scale(.88); opacity:.9; }
      .kdx[data-phase="open"] .g1 { width:31%; height:31%; top:2%; right:2%; }
      .kdx[data-phase="open"] .g2 { width:24%; height:24%; left:2%; bottom:2%; }
      .kdx[data-phase="crossed"] .art-zone::before { transform:scale(1.22); opacity:0; }
      .kdx[data-phase="crossed"] .crosshair { transform:scale(1.8); opacity:.15; transition:all .8s; }
      .phase-name { color:var(--accent); }
      @media (max-width:760px) {
        .shell { gap:8px; }
        .stage { grid-template-columns:1fr; grid-template-rows:minmax(0,1fr) auto; gap:8px; }
        .art-zone { min-height:0; }
        .panel { padding:12px 14px; display:grid; grid-template-columns:1fr auto; gap:6px 12px; align-items:end; }
        .number { font-size:24px; grid-row:1 / span 2; }
        .scene { font-size:22px; margin:0; }
        .mode { margin:0; text-align:right; }
        .line { display:none; }
        .states { grid-column:1/-1; margin:3px 0; }
        .activate { grid-column:1/-1; min-height:42px; }
        .ghost { display:none; }
        .top { min-height:34px; }
        .brand { font-size:22px; }
        .bottom { min-height:36px; }
        .scene-code { display:none; }
      }
      @media (prefers-reduced-motion: reduce) { *,*::before,*::after { transition-duration:.001ms !important; animation-duration:.001ms !important; } }
    </style>
  </head>
  <body>
    <main class="kdx" data-phase="dormant" data-scene={activators[0].scene} style={`--accent:${activators[0].accent}`}>
      <div class="grain"></div><div class="scan"></div>
      <div class="shell">
        <header class="top">
          <div class="brand">KODEX−∞</div>
          <div class="scene-code">AUTHORIAL ACTIVATOR LAB / NOINDEX / V0</div>
          <div class="state-label">STATE / <span class="phase-name">DORMANT</span></div>
        </header>
        <section class="stage">
          <figure class="art-zone" aria-label="Ocín original artwork activation field">
            <img class="art" src={driveThumb(activators[0].fileId)} alt={`${activators[0].workId} — Ocín original`} referrerpolicy="no-referrer" />
            <div class="ghost g1"><img src={driveThumb(activators[0].fileId)} alt="" referrerpolicy="no-referrer" /></div>
            <div class="ghost g2"><img src={driveThumb(activators[0].fileId)} alt="" referrerpolicy="no-referrer" /></div>
            <div class="crosshair"></div>
          </figure>
          <aside class="panel">
            <div>
              <div class="number">00</div>
              <h1 class="scene">THRESHOLD</h1>
              <div class="mode">ACTIVATOR / PULSE</div>
            </div>
            <p class="line">THE GATE DOES NOT EXPLAIN ITSELF. IT RECOGNIZES.</p>
            <div>
              <div class="work-id">OCN-MND-RED-001 / ORIGINAL AUTHORIAL SOURCE</div>
              <div class="states" aria-hidden="true">{Array.from({length:6}, (_,i)=><i class:list={['state',{on:i===0}]}></i>)}</div>
              <button class="activate" type="button">ENTER / ACTIVATE</button>
            </div>
          </aside>
        </section>
        <footer class="bottom">
          <div class="nav"><button class="prev" aria-label="Previous activator">←</button><button class="next" aria-label="Next activator">→</button></div>
          <div class="progress">{activators.map((a,i)=><button class:list={['dot',{active:i===0}]} data-index={i} aria-label={`Open ${a.scene}`}></button>)}</div>
          <div class="hint">ART IS THE SURFACE / SYSTEM IS THE RESPONSE</div>
        </footer>
      </div>
    </main>
    <script define:vars={{activators}}>
      const root = document.querySelector('.kdx');
      const art = document.querySelector('.art');
      const ghosts = [...document.querySelectorAll('.ghost img')];
      const number = document.querySelector('.number');
      const title = document.querySelector('.scene');
      const mode = document.querySelector('.mode');
      const line = document.querySelector('.line');
      const workId = document.querySelector('.work-id');
      const action = document.querySelector('.activate');
      const phaseName = document.querySelector('.phase-name');
      const stateBars = [...document.querySelectorAll('.state')];
      const dots = [...document.querySelectorAll('.dot')];
      let index = 0;
      let phase = 0;
      const phases = ['dormant','aware','focus','open','crossed','remembered'];
      const imageUrl = id => `https://drive.google.com/thumbnail?id=${id}&sz=w1600`;

      function renderScene(nextIndex) {
        index = (nextIndex + activators.length) % activators.length;
        phase = 0;
        const a = activators[index];
        root.style.setProperty('--accent', a.accent);
        root.dataset.scene = a.scene;
        root.dataset.phase = phases[phase];
        number.textContent = a.id;
        title.textContent = a.scene;
        mode.textContent = `ACTIVATOR / ${a.mode}`;
        line.textContent = a.line;
        workId.textContent = `${a.workId} / ORIGINAL AUTHORIAL SOURCE`;
        action.textContent = `${a.action} / ACTIVATE`;
        art.src = imageUrl(a.fileId);
        art.alt = `${a.workId} — Ocín original`;
        ghosts.forEach(g => g.src = imageUrl(a.fileId));
        updatePhase();
        dots.forEach((d,i)=>d.classList.toggle('active',i===index));
      }
      function updatePhase() {
        root.dataset.phase = phases[phase];
        phaseName.textContent = phases[phase].toUpperCase();
        stateBars.forEach((bar,i)=>bar.classList.toggle('on',i<=phase));
      }
      function advance() {
        if (phase < phases.length - 1) { phase += 1; updatePhase(); return; }
        renderScene(index + 1);
      }
      action.addEventListener('click', advance);
      document.querySelector('.art-zone').addEventListener('pointerenter', ()=>{ if (phase < 1) { phase=1; updatePhase(); }});
      document.querySelector('.art-zone').addEventListener('pointermove', ()=>{ if (phase < 2) { phase=2; updatePhase(); }});
      document.querySelector('.next').addEventListener('click', ()=>renderScene(index+1));
      document.querySelector('.prev').addEventListener('click', ()=>renderScene(index-1));
      dots.forEach(d=>d.addEventListener('click', ()=>renderScene(Number(d.dataset.index))));
      document.addEventListener('keydown', e=>{
        if (e.key === 'ArrowRight') renderScene(index+1);
        if (e.key === 'ArrowLeft') renderScene(index-1);
        if (e.key === 'Enter' || e.key === ' ') advance();
      });
    </script>
  </body>
</html>
