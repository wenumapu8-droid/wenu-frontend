---
import Base from '../../../layouts/Base.astro';
import { OCIN_GENESIS_REVIEW_V0 } from '../../../lib/kodex/ocin/authorial-corpus-v0';
import { evidenceFor, validateEvidenceRegistry } from '../../../lib/kodex/evidence-registry.js';

const archiveWorks = OCIN_GENESIS_REVIEW_V0.filter((work) => work.sceneRoles.includes('ARCHIVE'));
const archiveEvidence = evidenceFor('KDX-SCN-03');
const memoryEvidence = evidenceFor('KDX-CON-MEMORY');
const report = validateEvidenceRegistry();
---

<Base
  title="KODEX Lab — Archive Evidence"
  description="Noindex KODEX Archive evidence/provenance bridge."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="evidence-lab">
    <header class="evidence-lab__head">
      <div>
        <p>KODEX−∞ / ARCHIVE / TRACEABILITY LAB</p>
        <h1>ARTWORK ≠ CLAIM.<br />RELATION = TRACEABLE.</h1>
      </div>
      <dl>
        <div><dt>SCENE</dt><dd>KDX-SCN-03</dd></div>
        <div><dt>EVIDENCE</dt><dd>{report.valid ? 'PASS' : 'FAIL'}</dd></div>
        <div><dt>AUTHORIAL RECORDS</dt><dd>{archiveWorks.length}</dd></div>
        <div><dt>SOURCE RELATIONS</dt><dd>{archiveEvidence.length + memoryEvidence.length}</dd></div>
      </dl>
    </header>

    <section class="evidence-lab__section" aria-labelledby="art-title">
      <header><p>OCÍN / CREATOR REVIEW</p><h2 id="art-title">Authorial records eligible for ARCHIVE review</h2></header>
      <div class="work-grid">
        {archiveWorks.map((work) => (
          <article class="work-card">
            <div class="work-card__placeholder" aria-label="Artwork withheld pending public-use approval">
              <span>ARTWORK WITHHELD</span>
              <strong>{work.id}</strong>
              <small>{work.status}</small>
            </div>
            <div>
              <p>{work.series}</p>
              <h3>{work.title}</h3>
              <p>{work.curatorialNote}</p>
              <dl>
                <div><dt>ACTIVATION</dt><dd>{work.activation}</dd></div>
                <div><dt>DENSITY</dt><dd>{work.visualSignature.density}</dd></div>
                <div><dt>PALETTE</dt><dd>{work.visualSignature.palette}</dd></div>
                <div><dt>PUBLIC</dt><dd>{work.publicApproval ? 'APPROVED' : 'NO'}</dd></div>
              </dl>
            </div>
          </article>
        ))}
      </div>
      <a class="lab-link" href="/kodex/lab/ocin-authorial/">OPEN FULL OCÍN AUTHORIAL LAB ↗</a>
    </section>

    <section class="evidence-lab__section" aria-labelledby="sources-title">
      <header><p>ARCHIVE / SOURCE-BACKED RELATIONS</p><h2 id="sources-title">What the system can say — and what it cannot</h2></header>
      <div class="relation-grid">
        {[...archiveEvidence, ...memoryEvidence].map((relation) => (
          <article class="relation-card">
            <div class="relation-card__meta">
              <span>{relation.id}</span>
              <span>{relation.relation}</span>
              <span>{relation.layer}</span>
            </div>
            <h3>{relation.statement}</h3>
            <p class="boundary">BOUNDARY · {relation.boundary}</p>
            {relation.source && (
              <div class="source-packet">
                <p>{relation.source.id} / {relation.source.title}</p>
                <p>KNOWLEDGE · {relation.source.knowledgeClass}</p>
                <ul>
                  {relation.source.claims.map((claim) => <li>{claim}</li>)}
                </ul>
                <details>
                  <summary>LIMITATIONS + SOURCES</summary>
                  <ul>{relation.source.limitations.map((item) => <li>{item}</li>)}</ul>
                  <div class="source-links">
                    {relation.source.sources.map((source) => <a href={source.href} rel="noreferrer">{source.label} ↗</a>)}
                  </div>
                </details>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  :global(body){margin:0;background:#050505;color:#eeeae0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
  .evidence-lab{min-height:100dvh;padding:clamp(20px,4vw,64px);background:linear-gradient(180deg,#08070b,#050505 30%)}
  .evidence-lab__head{display:grid;grid-template-columns:1fr auto;gap:32px;align-items:end;padding-bottom:30px;border-bottom:1px solid #343139}
  .evidence-lab__head p,.evidence-lab__section>header p{margin:0 0 9px;font-size:10px;letter-spacing:.18em;opacity:.55}
  h1{margin:0;font-size:clamp(36px,7vw,92px);line-height:.9;letter-spacing:-.055em;font-weight:520}
  .evidence-lab__head dl{display:grid;grid-template-columns:repeat(2,minmax(120px,1fr));gap:16px;margin:0}
  dl div{display:grid;gap:4px}dt{font-size:8px;letter-spacing:.14em;opacity:.45}dd{margin:0;font-size:11px}
  .evidence-lab__section{padding:56px 0;border-bottom:1px solid #343139}.evidence-lab__section h2{margin:0 0 28px;font-size:clamp(26px,4vw,52px);font-weight:500;letter-spacing:-.035em}
  .work-grid,.relation-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:#29262d;border:1px solid #29262d}
  .work-card,.relation-card{background:#080808;padding:18px;display:grid;gap:18px}.work-card{grid-template-columns:minmax(160px,.7fr) 1.3fr}
  .work-card__placeholder{aspect-ratio:1;display:grid;place-content:center;text-align:center;border:1px dashed #4c4854;background:repeating-linear-gradient(135deg,#090909 0 8px,#0d0d0d 8px 16px)}
  .work-card__placeholder span,.work-card__placeholder small{font-size:8px;letter-spacing:.16em;opacity:.45}.work-card__placeholder strong{margin:10px 0;font-size:13px}
  .work-card h3,.relation-card h3{margin:0 0 10px;font-size:20px;font-weight:520}.work-card p,.relation-card p,.relation-card li{font-size:11px;line-height:1.6;opacity:.7}.work-card dl{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0 0}
  .relation-card__meta{display:flex;gap:8px;flex-wrap:wrap}.relation-card__meta span{padding:5px 7px;border:1px solid #4c4854;font-size:8px;letter-spacing:.1em}.boundary{padding:10px;border-left:1px solid #ab99ff;color:#c6bbff;opacity:1!important}
  .source-packet{padding-top:14px;border-top:1px solid #2c2930}.source-packet>p{margin:0 0 5px;font-size:9px;letter-spacing:.08em}.source-packet ul{padding-left:18px}.source-packet details{margin-top:14px}.source-packet summary{cursor:pointer;font-size:9px;letter-spacing:.12em}.source-links{display:grid;gap:6px}.source-links a,.lab-link{color:inherit;font-size:9px;letter-spacing:.1em}.lab-link{display:inline-block;margin-top:22px}
  @media(max-width:820px){.evidence-lab__head{grid-template-columns:1fr}.work-grid,.relation-grid{grid-template-columns:1fr}.work-card{grid-template-columns:1fr}.evidence-lab__head dl{grid-template-columns:1fr 1fr}}
</style>
