---
import Base from '../../../layouts/Base.astro';
import '../../../styles/kodex-motion-lab.css';
import { SIGNAL_THRESHOLD_RECIPE } from '../../../lib/kodex/motion-lab/recipes.js';
import { validateMotionRecipe } from '../../../lib/kodex/motion-lab/schema.js';

const recipe = SIGNAL_THRESHOLD_RECIPE;
const validation = validateMotionRecipe(recipe);
const recipeJson = JSON.stringify(recipe).replace(/</g, '\\u003c');
---

<Base
  title="KDX Motion Lab — Internal Prototype"
  description="Internal noindex KODEX motion-authoring prototype."
  robots="noindex, nofollow"
  kodexFonts={true}
  noNav={true}
  noFooter={true}
  noOverlays={true}
  noQuote={true}
  noThemes={true}
  noKai={true}
  noCart={true}
  noImmersive={true}
>
  <main class="kdx-motion-lab" data-motion-lab data-reduced="false">
    <div class="kdx-motion-lab__shell">
      <header class="kdx-motion-lab__masthead">
        <div>
          <p class="kdx-motion-lab__eyebrow">KDX.LAB / TEMPORAL GRAMMAR / P0</p>
          <h1>MOTION LAB</h1>
          <p class="kdx-motion-lab__meta">
            RECIPE {recipe.id} · {recipe.title} · {recipe.duration.toFixed(1)}S · INTERNAL / NOINDEX
          </p>
        </div>
        <div class="kdx-motion-lab__status">
          {validation.valid ? 'SCHEMA VALID' : 'SCHEMA ERROR'}
        </div>
      </header>

      <section class="kdx-motion-lab__previews" aria-label="Synchronized motion previews">
        <article class="kdx-motion-lab__preview kdx-motion-lab__rough" data-preview="rough">
          <p class="kdx-motion-lab__preview-tag"><strong>ROUGH</strong> / SURFACE-NEUTRAL</p>
          <div class="kdx-motion-lab__rough-core" aria-hidden="true">
            <span class="kdx-motion-lab__rough-ring"></span>
            <span class="kdx-motion-lab__rough-ring kdx-motion-lab__rough-ring--b"></span>
            <span class="kdx-motion-lab__rough-signal"></span>
            <span class="kdx-motion-lab__rough-aperture"></span>
            <span class="kdx-motion-lab__rough-trace"></span>
          </div>
          <div class="kdx-motion-lab__beat-label">
            <strong data-rough-beat>VOID</strong>
            <span data-rough-state>LATENT → DORMANT</span>
          </div>
        </article>

        <article class="kdx-motion-lab__preview kdx-motion-lab__styled" data-preview="styled">
          <p class="kdx-motion-lab__preview-tag"><strong>KODEX</strong> / RESTRAINED RENDER</p>
          <span class="kdx-motion-lab__styled-grid" aria-hidden="true"></span>
          <span class="kdx-motion-lab__styled-scan" aria-hidden="true"></span>
          <div class="kdx-motion-lab__styled-core" aria-hidden="true">
            <span class="kdx-motion-lab__styled-ring"></span>
            <span class="kdx-motion-lab__styled-ring kdx-motion-lab__styled-ring--b"></span>
            <span class="kdx-motion-lab__styled-ring kdx-motion-lab__styled-ring--c"></span>
            <span class="kdx-motion-lab__styled-signal"></span>
            <span class="kdx-motion-lab__styled-aperture"></span>
            <span class="kdx-motion-lab__styled-trace"></span>
          </div>
          <div class="kdx-motion-lab__beat-label">
            <strong data-styled-beat>VOID</strong>
            <span data-styled-state>LATENT → DORMANT</span>
          </div>
        </article>
      </section>

      <section class="kdx-motion-lab__transport" aria-label="Timeline transport">
        <button type="button" data-play>Play</button>
        <button type="button" data-restart>Restart</button>
        <input
          type="range"
          min="0"
          max={recipe.duration}
          step="0.001"
          value="0"
          aria-label="Motion timeline"
          data-scrub
        />
        <span class="kdx-motion-lab__time" data-time>00.000 / {recipe.duration.toFixed(3)}</span>
        <button type="button" data-reduce aria-pressed="false">Reduced</button>
      </section>

      <section class="kdx-motion-lab__timeline" aria-label="Semantic beat timeline">
        <div class="kdx-motion-lab__timeline-head">
          <span>SEMANTIC BEATS</span>
          <span>ONE CLOCK / TWO RENDERERS</span>
        </div>
        <div class="kdx-motion-lab__track" data-track style="--timeline-p:0">
          {recipe.beats.map((beat, index) => (
            <div
              class="kdx-motion-lab__beat"
              data-beat-id={beat.id}
              data-active={index === 0 ? 'true' : 'false'}
              style={`flex:${beat.end - beat.start}`}
            >
              <strong>{beat.type}</strong>
              <span>{beat.start.toFixed(1)}–{beat.end.toFixed(1)}</span>
            </div>
          ))}
          <span class="kdx-motion-lab__playhead" aria-hidden="true"></span>
        </div>
      </section>

      <section class="kdx-motion-lab__data-grid">
        <article class="kdx-motion-lab__panel">
          <h2>ACTIVE BEAT / INSPECTOR</h2>
          <dl class="kdx-motion-lab__datum">
            <div><dt>ID</dt><dd data-inspector-id>{recipe.beats[0].id}</dd></div>
            <div><dt>TYPE</dt><dd data-inspector-type>{recipe.beats[0].type}</dd></div>
            <div><dt>STATE</dt><dd data-inspector-state>{recipe.beats[0].stateIn} → {recipe.beats[0].stateOut}</dd></div>
            <div><dt>SUBJECT</dt><dd data-inspector-subject>{recipe.beats[0].subject}</dd></div>
            <div><dt>RENDERER</dt><dd data-inspector-renderer>{recipe.beats[0].renderer}</dd></div>
            <div><dt>FALLBACK</dt><dd data-inspector-fallback>{recipe.beats[0].fallback}</dd></div>
            <div><dt>PARAMS</dt><dd data-inspector-params>{JSON.stringify(recipe.beats[0].params)}</dd></div>
          </dl>
        </article>

        <article class="kdx-motion-lab__panel">
          <h2>PROVENANCE / STATUS</h2>
          <dl class="kdx-motion-lab__datum">
            <div><dt>RECIPE</dt><dd>{recipe.id}</dd></div>
            <div><dt>SCENE</dt><dd>{recipe.scene}</dd></div>
            <div><dt>SOURCE</dt><dd>{recipe.sourceIds.join(', ')}</dd></div>
            <div><dt>RIGHTS</dt><dd>{recipe.rightsStatus}</dd></div>
            <div><dt>PROVENANCE</dt><dd>{recipe.provenanceStatus}</dd></div>
            <div><dt>STATUS</dt><dd>{recipe.status} / NOT DEPLOYED</dd></div>
            <div><dt>CREATOR GATE</dt><dd>PENDING</dd></div>
          </dl>
          {!validation.valid && (
            <ul class="kdx-motion-lab__errors">
              {validation.errors.map((error) => <li>{error}</li>)}
            </ul>
          )}
        </article>
      </section>
    </div>
  </main>

  <script id="kdx-motion-recipe" type="application/json" set:html={recipeJson}></script>
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-motion-lab]');
      const dataNode = document.getElementById('kdx-motion-recipe');
      if (!root || !dataNode) return;

      const recipe = JSON.parse(dataNode.textContent || '{}');
      const rough = root.querySelector('[data-preview="rough"]');
      const styled = root.querySelector('[data-preview="styled"]');
      const scrub = root.querySelector('[data-scrub]');
      const play = root.querySelector('[data-play]');
      const restart = root.querySelector('[data-restart]');
      const reduce = root.querySelector('[data-reduce]');
      const timeLabel = root.querySelector('[data-time]');
      const track = root.querySelector('[data-track]');
      const beatBlocks = [...root.querySelectorAll('[data-beat-id]')];

      const output = {
        roughBeat: root.querySelector('[data-rough-beat]'),
        roughState: root.querySelector('[data-rough-state]'),
        styledBeat: root.querySelector('[data-styled-beat]'),
        styledState: root.querySelector('[data-styled-state]'),
        id: root.querySelector('[data-inspector-id]'),
        type: root.querySelector('[data-inspector-type]'),
        state: root.querySelector('[data-inspector-state]'),
        subject: root.querySelector('[data-inspector-subject]'),
        renderer: root.querySelector('[data-inspector-renderer]'),
        fallback: root.querySelector('[data-inspector-fallback]'),
        params: root.querySelector('[data-inspector-params]'),
      };

      let current = 0;
      let playing = false;
      let raf = 0;
      let last = 0;
      let reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const clamp01 = (value) => Math.min(1, Math.max(0, value));
      const ramp = (start, end, time) => clamp01((time - start) / (end - start));

      const beatAt = (time) => {
        return recipe.beats.find((beat, index) => {
          const isLast = index === recipe.beats.length - 1;
          return time >= beat.start && (time < beat.end || (isLast && time <= beat.end));
        }) || recipe.beats[recipe.beats.length - 1];
      };

      const setVars = (node, values) => {
        if (!node) return;
        Object.entries(values).forEach(([key, value]) => {
          node.style.setProperty(`--${key}`, String(value));
        });
      };

      const render = (time) => {
        current = Math.min(recipe.duration, Math.max(0, time));
        const beat = beatAt(current);

        const signal = ramp(2, 4.2, current);
        const focus = ramp(4.2, 6.2, current);
        const lock = ramp(6.2, 8.4, current);
        const open = ramp(8.4, 11, current);
        const ret = ramp(11, 12, current);

        const discrete = (value) => reduced ? (value > 0 ? 1 : 0) : value;
        const vars = {
          signal: discrete(signal),
          focus: discrete(focus),
          lock: discrete(lock),
          open: discrete(open),
          return: discrete(ret),
        };

        setVars(rough, vars);
        setVars(styled, vars);

        const stateText = `${beat.stateIn} → ${beat.stateOut}`;
        output.roughBeat.textContent = beat.type;
        output.roughState.textContent = stateText;
        output.styledBeat.textContent = beat.type;
        output.styledState.textContent = stateText;
        output.id.textContent = beat.id;
        output.type.textContent = beat.type;
        output.state.textContent = stateText;
        output.subject.textContent = beat.subject;
        output.renderer.textContent = beat.renderer;
        output.fallback.textContent = beat.fallback;
        output.params.textContent = JSON.stringify(beat.params);

        beatBlocks.forEach((block) => {
          block.dataset.active = block.dataset.beatId === beat.id ? 'true' : 'false';
        });

        const timelineProgress = current / recipe.duration;
        track?.style.setProperty('--timeline-p', String(timelineProgress));
        if (scrub) scrub.value = String(current);
        if (timeLabel) timeLabel.textContent = `${current.toFixed(3).padStart(6, '0')} / ${recipe.duration.toFixed(3)}`;
      };

      const stop = () => {
        playing = false;
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        if (play) play.textContent = 'Play';
      };

      const tick = (now) => {
        if (!playing) return;
        if (!last) last = now;
        const delta = (now - last) / 1000;
        last = now;
        const next = current + delta;

        if (next >= recipe.duration) {
          render(recipe.duration);
          stop();
          last = 0;
          return;
        }

        render(next);
        raf = requestAnimationFrame(tick);
      };

      play?.addEventListener('click', () => {
        if (playing) {
          stop();
          last = 0;
          return;
        }
        if (current >= recipe.duration) render(0);
        playing = true;
        last = 0;
        play.textContent = 'Pause';
        raf = requestAnimationFrame(tick);
      });

      restart?.addEventListener('click', () => {
        stop();
        last = 0;
        render(0);
      });

      scrub?.addEventListener('input', (event) => {
        stop();
        last = 0;
        render(Number(event.currentTarget.value));
      });

      reduce?.addEventListener('click', () => {
        reduced = !reduced;
        root.dataset.reduced = reduced ? 'true' : 'false';
        reduce.setAttribute('aria-pressed', reduced ? 'true' : 'false');
        render(current);
      });

      reduce?.setAttribute('aria-pressed', reduced ? 'true' : 'false');
      root.dataset.reduced = reduced ? 'true' : 'false';
      render(0);
    })();
  </script>
</Base>
