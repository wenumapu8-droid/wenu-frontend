---
const title = "KODEX−∞ M1 Vertical Slice Lab";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <main class="lab" data-kdx-m1-lab data-error="false">
      <header class="lab-header">
        <div>
          <p class="eyebrow">KODEX−∞ // INTERNAL LOGIC LAB // M1</p>
          <h1>VERTICAL SLICE<br />GRAPH RUNTIME</h1>
        </div>
        <div class="header-note">
          <strong>NO PUBLIC ROUTE REPLACED</strong>
          <span>B, C, H and K remain candidate coordinate assignments requiring Ocín approval.</span>
        </div>
      </header>

      <section class="node-panel" aria-labelledby="node-title">
        <div class="node-coordinate" aria-hidden="true">
          <span data-coordinate>A</span>
          <small data-coordinate-instance>A</small>
        </div>

        <div class="node-copy">
          <div class="metadata">
            <span data-assignment>CANONICAL</span>
            <span data-organism>FIELD / threshold-portal / PROTOTYPE</span>
          </div>
          <h2 id="node-title" data-title>THRESHOLD</h2>
          <p class="question" data-question>
            What are you willing to activate, and under which conditions?
          </p>
          <p class="runtime-status" data-status aria-live="polite">INSTANCE A · BASE STATE · Y LATENT</p>
        </div>
      </section>

      <section class="route-panel" aria-labelledby="route-title">
        <div>
          <p class="section-label" id="route-title">EVENT TRACE</p>
          <p class="route" data-route>A</p>
        </div>
        <div class="toolbar" aria-label="Laboratory controls">
          <button type="button" data-export>EXPORT TRACE</button>
          <button type="button" data-reset>RESET SESSION</button>
          <button type="button" data-clear-storage>CLEAR STORAGE</button>
        </div>
      </section>

      <div class="work-grid">
        <section class="work-panel" aria-labelledby="actions-title">
          <p class="section-label" id="actions-title">MEANINGFUL ACTIONS</p>
          <div class="button-stack" data-actions></div>
        </section>

        <section class="work-panel" aria-labelledby="exits-title">
          <p class="section-label" id="exits-title">AVAILABLE FIELD</p>
          <div class="button-stack" data-exits></div>
        </section>
      </div>

      <div class="diagnostic-grid">
        <section class="diagnostic-panel" aria-labelledby="memory-title">
          <p class="section-label" id="memory-title">PRIVACY-MINIMIZED MEMORY</p>
          <pre data-memory></pre>
        </section>

        <section class="diagnostic-panel" aria-labelledby="artifact-title">
          <p class="section-label" id="artifact-title">LATEST RETURN ARTIFACT</p>
          <pre data-artifact>No Return artifact has been generated in this laboratory session.</pre>
        </section>

        <section class="diagnostic-panel event-panel" aria-labelledby="events-title">
          <p class="section-label" id="events-title">RECENT EVENTS</p>
          <ol data-events></ol>
        </section>
      </div>

      <footer class="lab-footer">
        <span>A = −∞ / COMMON ORIGIN</span>
        <span>M = HEART / OPTIONAL</span>
        <span>Y = RETURN / TRACE-DERIVED</span>
        <span>DEPLOYMENT BLOCKED</span>
      </footer>
    </main>

    <script>
      import "../../../components/kodex/experience/kodex-vertical-slice-client";
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    color-scheme: dark;
    background: #050507;
  }

  :global(body) {
    margin: 0;
    min-width: 20rem;
    min-height: 100dvh;
    background:
      radial-gradient(circle at 50% 18%, rgb(117 75 190 / 0.13), transparent 32rem),
      linear-gradient(rgb(255 255 255 / 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.025) 1px, transparent 1px),
      #050507;
    background-size: auto, 24px 24px, 24px 24px, auto;
    color: #e6e0d8;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  button {
    color: inherit;
    font: inherit;
  }

  .lab {
    width: min(100%, 100rem);
    min-height: 100dvh;
    margin-inline: auto;
    padding: clamp(0.75rem, 2vw, 1.5rem);
  }

  .lab-header,
  .node-panel,
  .route-panel,
  .work-panel,
  .diagnostic-panel,
  .lab-footer {
    border: 1px solid rgb(230 224 216 / 0.24);
    background: rgb(5 5 7 / 0.78);
    box-shadow: inset 0 0 0 1px rgb(125 84 196 / 0.04);
  }

  .lab-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 28rem);
    gap: 1rem;
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .eyebrow,
  .section-label,
  .metadata,
  .runtime-status,
  .lab-footer,
  .header-note {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #a884df;
  }

  h1,
  h2,
  p {
    margin-block-start: 0;
  }

  h1 {
    max-width: 14ch;
    margin-block-end: 0;
    font-size: clamp(2.4rem, 7vw, 7rem);
    font-weight: 500;
    line-height: 0.82;
    letter-spacing: -0.065em;
  }

  .header-note {
    align-self: end;
    display: grid;
    gap: 0.75rem;
    line-height: 1.6;
    color: rgb(230 224 216 / 0.7);
  }

  .header-note strong {
    color: #ff6d73;
  }

  .node-panel {
    display: grid;
    grid-template-columns: minmax(7rem, 15rem) 1fr;
    min-height: 22rem;
    margin-top: 1rem;
  }

  .node-coordinate {
    display: grid;
    place-content: center;
    border-right: 1px solid rgb(230 224 216 / 0.2);
    text-align: center;
  }

  .node-coordinate span {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(6rem, 18vw, 14rem);
    line-height: 0.75;
    color: #bd96ff;
    text-shadow: 0 0 2rem rgb(156 91 255 / 0.38);
  }

  .node-coordinate small {
    margin-top: 1.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
  }

  .node-copy {
    align-self: center;
    padding: clamp(1.25rem, 4vw, 4rem);
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1.25rem;
    color: #a884df;
  }

  h2 {
    margin-bottom: 1rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.035em;
  }

  .question {
    max-width: 55rem;
    font-size: clamp(1rem, 2vw, 1.35rem);
    line-height: 1.55;
    color: rgb(230 224 216 / 0.78);
  }

  .runtime-status {
    margin: 2rem 0 0;
    color: #ff7780;
  }

  .lab[data-error="true"] .runtime-status {
    color: #ff414d;
  }

  .route-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: end;
    margin-top: 1rem;
    padding: 1rem;
  }

  .section-label {
    margin-bottom: 0.7rem;
    color: #a884df;
  }

  .route {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(1rem, 2vw, 1.35rem);
    line-height: 1.5;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .toolbar button {
    padding: 0.65rem 0.8rem;
    border: 1px solid rgb(230 224 216 / 0.28);
    background: transparent;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .toolbar button:hover,
  .toolbar button:focus-visible {
    border-color: #bd96ff;
    background: rgb(189 150 255 / 0.08);
  }

  .work-grid,
  .diagnostic-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .work-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .diagnostic-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .work-panel,
  .diagnostic-panel {
    min-width: 0;
    padding: 1rem;
  }

  .button-stack {
    display: grid;
    gap: 0.65rem;
  }

  :global(.lab-action),
  :global(.lab-exit) {
    display: grid;
    gap: 0.35rem;
    width: 100%;
    padding: 0.9rem;
    border: 1px solid rgb(230 224 216 / 0.2);
    background: rgb(255 255 255 / 0.015);
    text-align: left;
    cursor: pointer;
  }

  :global(.lab-action:hover),
  :global(.lab-action:focus-visible),
  :global(.lab-exit:hover),
  :global(.lab-exit:focus-visible) {
    border-color: #bd96ff;
    background: rgb(189 150 255 / 0.07);
  }

  :global(.lab-action strong),
  :global(.lab-exit strong) {
    color: #f0ebe4;
    font-size: 0.85rem;
  }

  :global(.lab-action span),
  :global(.lab-exit span),
  :global(.lab-exit small),
  :global(.lab-empty) {
    color: rgb(230 224 216 / 0.62);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  :global(.lab-exit small) {
    color: #9f7dd4;
  }

  pre {
    max-height: 32rem;
    margin: 0;
    overflow: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: rgb(230 224 216 / 0.72);
    font: 0.7rem/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .event-panel {
    grid-column: 1 / -1;
  }

  .event-panel ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event-panel li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    padding: 0.7rem;
    border: 1px solid rgb(230 224 216 / 0.12);
  }

  .event-panel li strong {
    color: #bd96ff;
  }

  .event-panel li span {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .event-panel li small {
    grid-column: 1 / -1;
    color: rgb(230 224 216 / 0.58);
    line-height: 1.4;
  }

  .lab-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    color: rgb(230 224 216 / 0.56);
  }

  @media (max-width: 800px) {
    .lab-header,
    .node-panel,
    .route-panel,
    .work-grid,
    .diagnostic-grid {
      grid-template-columns: 1fr;
    }

    .node-coordinate {
      min-height: 14rem;
      border-right: 0;
      border-bottom: 1px solid rgb(230 224 216 / 0.2);
    }

    .toolbar {
      justify-content: flex-start;
    }

    .event-panel {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.001ms !important;
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
