---
import HelixPassage from '../../../../components/kodex/dna/HelixPassage.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>KODEX−∞ DNA Passage Lab</title>
  </head>
  <body>
    <main class="lab">
      <header>
        <span>KODEX−∞ / INTERNAL LAB</span>
        <span>KDX-NODE-DNA-ASCENT</span>
        <span>SCIENTIFIC CLAIM POLICY: SYMBOLIC_ONLY</span>
      </header>
      <section class="intro">
        <h1>DNA PASSAGE</h1>
        <p>A recognizable biological reference form and a separate KODEX symbolic reading. This is not genetic data, diagnosis, ancestry inference or a simulation of a user's DNA.</p>
      </section>
      <HelixPassage />
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #020203; color-scheme: dark; }
  :global(body) { margin: 0; background: #020203; color: #ebe7ef; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .lab { width: min(100%, 120rem); min-height: 100dvh; margin: 0 auto; padding: clamp(.65rem, 1.5vw, 1.25rem); }
  header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; padding-bottom: .75rem; border-bottom: 1px solid rgb(235 231 239 / .16); font-size: .58rem; letter-spacing: .11em; color: rgb(235 231 239 / .58); }
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 34rem); gap: 1rem; align-items: end; padding: 1rem 0; }
  h1 { margin: 0; font-size: clamp(2.8rem, 8vw, 8rem); font-weight: 500; line-height: .82; letter-spacing: -.06em; }
  p { margin: 0; font-size: .68rem; line-height: 1.6; color: rgb(235 231 239 / .62); }
  @media (max-width: 700px) { .intro { grid-template-columns: 1fr; } header { justify-content: flex-start; } }
</style>
