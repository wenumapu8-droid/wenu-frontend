    .cr__memory-head { margin-top: 18px; align-items: center; }
    .cr__memory-head button { padding: 5px 6px; }
    .cr__memory { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 6px; }
    .cr__memory li { padding: 8px; border: 1px solid var(--line); background: rgba(255,255,255,.018); }
    .cr__memory li > div { display: flex; justify-content: space-between; color: var(--accent); font-size: 8px; }
    .cr__memory p { margin: 6px 0; color: #b6c0bc; font-size: 8px; line-height: 1.45; }
    .cr__memory small { color: var(--muted); font-size: 7px; }
