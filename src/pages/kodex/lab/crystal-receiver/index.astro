    .cr__readout span, .cr__readout strong { display: block; }
    .cr__readout span { color: var(--accent); font-size: clamp(10px, 1vw, 14px); letter-spacing: .22em; }
    .cr__readout strong { margin-top: 5px; color: var(--muted); font-size: 8px; font-weight: 400; }

