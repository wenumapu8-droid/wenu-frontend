    .cr__axis small { display: block; margin-top: 6px; color: var(--muted); font-size: 8px; }
    .cr__axis input[type="range"] { width: 100%; accent-color: #d7fff0; }

    .cr__decoder { display: grid; gap: 0; margin: 14px 0; border: 1px solid var(--line); }
