    .cr__footer {
      grid-template-columns: 1fr auto;
      gap: 20px;
      padding: 0 18px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 7px;
      letter-spacing: .08em;
      white-space: nowrap;
      overflow: hidden;
    }

    .cr[data-state="CRYSTAL"] { --accent: #eafff7; }
    .cr[data-state="CRYSTAL"] .cr__crystal { animation: cr-pulse 3.6s ease-in-out infinite; }
    .cr[data-state="CRYSTAL"] .cr__orbit--a { animation: cr-spin 18s linear infinite; }
    .cr[data-state="CRYSTAL"] .cr__orbit--b { animation: cr-spin-reverse 26s linear infinite; }
    .cr[data-state="DECODING"] .cr__sigil { animation: cr-decode .26s steps(2, end) infinite; }
    .cr[data-state="ATTENTION"] .cr__panel--capture { box-shadow: inset 0 0 0 1px rgba(255,93,87,.4); }

    @keyframes cr-spin { to { transform: rotate(360deg); } }
    @keyframes cr-spin-reverse { to { transform: rotate(-360deg); } }
    @keyframes cr-pulse { 50% { opacity: .55; transform: scale(.985); } }
    @keyframes cr-decode { 50% { transform: translateX(1px); filter: contrast(1.3); } }

    @media (max-width: 980px) {
      :global(html), :global(body) { overflow: auto; }
