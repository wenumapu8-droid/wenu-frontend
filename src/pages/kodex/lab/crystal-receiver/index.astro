    .cr__axis-label--signal { bottom: 18%; left: 8%; }
    .cr__axis-label--observer { bottom: 18%; right: 8%; }

    .cr__core-meta { position: absolute; z-index: 2; display: grid; gap: 3px; font-size: 8px; }
    .cr__core-meta span { color: var(--muted); }
    .cr__core-meta strong { color: var(--ink); font-weight: 500; }
    .cr__core-meta--tl { top: 14px; left: 14px; }
    .cr__core-meta--tr { top: 14px; right: 14px; text-align: right; }
    .cr__core-meta--bl { bottom: 14px; left: 14px; }
    .cr__core-meta--br { bottom: 14px; right: 14px; text-align: right; }

    .cr__axis { padding: 14px 0; border-bottom: 1px solid var(--line); }
