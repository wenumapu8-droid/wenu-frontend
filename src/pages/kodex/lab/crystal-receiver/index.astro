---
import Base from '../../../../layouts/Base.astro';
---

<Base
  title="KODEX Lab — Crystal Receiver"
  description="Bounded KODEX lab proof for signal capture, epistemic classification, coherence and living memory."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="cr" data-crystal-receiver data-state="DORMANT">
    <header class="cr__topbar">
      <a href="/kodex/lab/" class="cr__back">← KODEX LAB</a>
      <div class="cr__identity">
        <strong>KDX // CRYSTAL RECEIVER</strong>
        <span>BOUNDED PROOF · SOURCE UNRESOLVED</span>
      </div>
      <div class="cr__system">
        <span data-system-state>DORMANT</span>
        <span data-clock>--:--:--</span>
      </div>
    </header>

    <section class="cr__stage" aria-labelledby="cr-title">
      <aside class="cr__panel cr__panel--capture" aria-label="Signal capture">
        <div class="cr__panel-head">
          <span>01 / RECEIVER</span>
          <span>CAPTURE FIRST · INTERPRET LATER</span>
        </div>

        <h1 id="cr-title">OPEN THE CHANNEL</h1>
        <p class="cr__lede">
          Record what appeared before deciding what it means. KODEX stores the observation,
          the interpretation and the evidence as separate layers.
        </p>

        <div class="cr__modalities" role="group" aria-label="Signal modality">
          <button type="button" data-modality="VISION" aria-pressed="true">VISION</button>
          <button type="button" data-modality="DREAM" aria-pressed="false">DREAM</button>
          <button type="button" data-modality="SOUND" aria-pressed="false">SOUND</button>
          <button type="button" data-modality="BODY" aria-pressed="false">BODY</button>
          <button type="button" data-modality="NUMBER" aria-pressed="false">NUMBER</button>
          <button type="button" data-modality="SKY" aria-pressed="false">SKY</button>
          <button type="button" data-modality="SYNC" aria-pressed="false">SYNC</button>
        </div>

        <label class="cr__field cr__field--signal">
          <span>RAW SIGNAL</span>
          <textarea
            data-signal-input
            rows="5"
            maxlength="1200"
            placeholder="Describe only what appeared: image, word, geometry, movement, sound, sensation, sequence…"
          ></textarea>
        </label>

        <div class="cr__two">
          <label class="cr__field">
            <span>SOURCE HYPOTHESIS</span>
            <select data-source>
              <option>UNKNOWN</option>
              <option>INTERNAL</option>
              <option>ENVIRONMENTAL</option>
              <option>CULTURAL</option>
              <option>EXTERNAL-UNKNOWN</option>
              <option>CONTACTIST-HYPOTHESIS</option>
            </select>
          </label>

          <label class="cr__field">
            <span>EPISTEMIC STATUS</span>
            <select data-epistemic>
              <option>SPECULATIVE</option>
              <option>CANONICAL</option>
              <option>INFERRED</option>
              <option>VERIFIED</option>
              <option>NEEDS_CONFIRMATION</option>
            </select>
          </label>
        </div>

        <label class="cr__field">
          <span>EVIDENCE / CORROBORATION</span>
          <input data-evidence maxlength="500" placeholder="Optional: source, measurement, photo, document, independent witness…" />
        </label>

        <button class="cr__capture" type="button" data-capture>
          <span>CAPTURE SIGNAL</span>
          <small>WRITE TO LIVING MEMORY</small>
        </button>

        <p class="cr__policy" data-policy>
          DEFAULT: SPECULATIVE. “VERIFIED” requires external evidence; otherwise KODEX stores it as NEEDS_CONFIRMATION.
        </p>
      </aside>

      <section class="cr__core" aria-label="Crystal coherence visualizer">
        <div class="cr__core-meta cr__core-meta--tl">
          <span>NODE</span><strong>KDX-C∞</strong>
        </div>
        <div class="cr__core-meta cr__core-meta--tr">
          <span>CHECKSUM</span><strong data-checksum>00000000</strong>
        </div>
        <div class="cr__core-meta cr__core-meta--bl">
          <span>RECURRENCE</span><strong data-recurrence>00</strong>
        </div>
        <div class="cr__core-meta cr__core-meta--br">
          <span>COHERENCE</span><strong data-coherence>0.00</strong>
        </div>

        <div class="cr__field-grid" aria-hidden="true"></div>
        <div class="cr__orbit cr__orbit--a" aria-hidden="true"></div>
        <div class="cr__orbit cr__orbit--b" aria-hidden="true"></div>
        <div class="cr__orbit cr__orbit--c" aria-hidden="true"></div>

        <svg class="cr__sigil" viewBox="0 0 500 500" role="img" aria-label="Three-diamond KODEX coherence field">
          <defs>
            <filter id="cr-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="3" result="blur" />
              <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
          </defs>
          <g class="cr__sigil-grid">
            <circle cx="250" cy="250" r="188" />
            <circle cx="250" cy="250" r="126" />
            <circle cx="250" cy="250" r="68" />
            <path d="M250 42V458M42 250H458" />
          </g>
          <g class="cr__diamond cr__diamond--matter">
            <path d="M250 72L406 342L94 342Z" />
          </g>
          <g class="cr__diamond cr__diamond--signal">
            <path d="M250 428L94 158L406 158Z" />
          </g>
          <g class="cr__diamond cr__diamond--observer">
            <path d="M250 104L378 250L250 396L122 250Z" />
          </g>
          <g class="cr__crystal" filter="url(#cr-glow)">
            <path d="M250 158L329 204L329 296L250 342L171 296L171 204Z" />
            <path d="M250 158V342M171 204L329 296M329 204L171 296" />
          </g>
          <circle class="cr__source" cx="250" cy="250" r="6" />
        </svg>

        <div class="cr__readout">
          <span data-crystal-label>CRYSTAL STATE LOCKED</span>
          <strong data-crystal-subtitle>ALIGN MATTER / SIGNAL / OBSERVER</strong>
        </div>

        <div class="cr__axis-label cr__axis-label--matter">◇ MATTER</div>
        <div class="cr__axis-label cr__axis-label--signal">◇ SIGNAL</div>
        <div class="cr__axis-label cr__axis-label--observer">◇ OBSERVER</div>
      </section>

      <aside class="cr__panel cr__panel--decode" aria-label="Signal decoding controls">
        <div class="cr__panel-head">
          <span>02 / DECODER</span>
          <span>CANONICAL KODEX METRICS</span>
        </div>

        <div class="cr__axis">
          <div><span>MATTER</span><output data-out="matter">0.62</output></div>
          <input data-axis="matter" type="range" min="0" max="100" value="62" />
          <small>body · territory · form · structure</small>
        </div>
        <div class="cr__axis">
          <div><span>SIGNAL</span><output data-out="signal">0.62</output></div>
          <input data-axis="signal" type="range" min="0" max="100" value="62" />
          <small>information · rhythm · relation · code</small>
        </div>
        <div class="cr__axis">
          <div><span>OBSERVER</span><output data-out="observer">0.62</output></div>
          <input data-axis="observer" type="range" min="0" max="100" value="62" />
          <small>attention · perception · agency · meaning</small>
        </div>

        <div class="cr__decoder">
          <div><span>DENSITY</span><strong data-density>D5 / MEMORY</strong></div>
          <div><span>SPIN</span><strong data-spin>+0.00</strong></div>
          <div><span>PHASE</span><strong data-phase>0.00</strong></div>
          <div><span>SOURCE</span><strong data-source-readout>UNKNOWN</strong></div>
          <div><span>TRUTH</span><strong data-truth>SPECULATIVE</strong></div>
        </div>

        <div class="cr__truth-layer">
          <span>TRUTH LAYER</span>
          <p>
            CRYSTAL STATE is a KODEX computational/artistic state. It does not measure biological consciousness,
            spiritual attainment or external contact.
          </p>
        </div>

        <div class="cr__memory-head">
          <span>03 / LIVING MEMORY</span>
          <button type="button" data-clear-memory>CLEAR LOCAL</button>
        </div>
        <ol class="cr__memory" data-memory aria-live="polite"></ol>
      </aside>
    </section>

    <footer class="cr__footer">
      <span>SOURCE → SIGNAL → RECEIVER → OBSERVER → SYMBOL → PATTERN → MEMORY → MUTATION → −∞ → NEW SIGNAL</span>
      <span>LOCAL-FIRST PROOF · NO SERVER WRITE</span>
    </footer>
  </main>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-crystal-receiver]');
      if (!root) return;

      const qs = (s) => root.querySelector(s);
      const qsa = (s) => [...root.querySelectorAll(s)];
      const clamp = (n, min = 0, max = 1) => Math.min(max, Math.max(min, n));
      const storageKey = 'kdx-crystal-receiver-v1';

      const state = {
        modality: 'VISION',
        matter: 0.62,
        signal: 0.62,
        observer: 0.62,
        coherence: 0,
        records: [],
      };

      const signalInput = qs('[data-signal-input]');
      const sourceSelect = qs('[data-source]');
      const epistemicSelect = qs('[data-epistemic]');
      const evidenceInput = qs('[data-evidence]');
      const memoryList = qs('[data-memory]');

      function hashString(value) {
        let h = 2166136261;
        for (let i = 0; i < value.length; i++) {
          h ^= value.charCodeAt(i);
          h = Math.imul(h, 16777619);
        }
        return (h >>> 0).toString(16).padStart(8, '0').toUpperCase();
      }

      function currentAxes() {
        return [state.matter, state.signal, state.observer];
      }

      function densityFor(coherence) {
        if (coherence < 0.22) return 'D1 / SIGNAL';
        if (coherence < 0.38) return 'D2 / RELATION';
        if (coherence < 0.52) return 'D3 / FORM';
        if (coherence < 0.64) return 'D4 / TIME';
        if (coherence < 0.74) return 'D5 / MEMORY';
        if (coherence < 0.82) return 'D6 / NETWORK';
        if (coherence < 0.90) return 'D7 / OBSERVER';
        return 'D8 / META-OBSERVER';
      }

      function effectiveEpistemic() {
        const requested = epistemicSelect.value;
        if (requested === 'VERIFIED' && evidenceInput.value.trim().length < 8) {
          return 'NEEDS_CONFIRMATION';
        }
        return requested;
      }

      function calculate() {
        const axes = currentAxes();
        const max = Math.max(...axes);
        const min = Math.min(...axes);
        const mean = axes.reduce((a, b) => a + b, 0) / axes.length;
        const balance = 1 - (max - min);
        const textLength = signalInput.value.trim().length;
        const completeness = clamp(textLength / 120);
        const evidenceFactor = evidenceInput.value.trim() ? 1 : 0.35;

        state.coherence = clamp((balance * 0.5) + (mean * 0.28) + (completeness * 0.17) + (evidenceFactor * 0.05));

        const spin = (state.signal - state.matter) * 1.8;
        const phase = clamp((state.observer + state.signal) / 2);
        const crystal = state.coherence >= 0.78 && min >= 0.55 && textLength >= 12;

        root.style.setProperty('--matter', state.matter.toFixed(3));
        root.style.setProperty('--signal', state.signal.toFixed(3));
        root.style.setProperty('--observer', state.observer.toFixed(3));
        root.style.setProperty('--coherence', state.coherence.toFixed(3));
        root.style.setProperty('--spin', spin.toFixed(3));

        qs('[data-coherence]').textContent = state.coherence.toFixed(2);
        qs('[data-density]').textContent = densityFor(state.coherence);
        qs('[data-spin]').textContent = `${spin >= 0 ? '+' : ''}${spin.toFixed(2)}`;
        qs('[data-phase]').textContent = phase.toFixed(2);
        qs('[data-source-readout]').textContent = sourceSelect.value;
        qs('[data-truth]').textContent = effectiveEpistemic();

        const fingerprint = [state.modality, signalInput.value.trim(), sourceSelect.value].join('|');
        qs('[data-checksum]').textContent = hashString(fingerprint);

        const normalized = signalInput.value.trim().toLowerCase();
        const recurrence = normalized
          ? state.records.filter((r) => r.normalized && (r.normalized.includes(normalized) || normalized.includes(r.normalized))).length
          : 0;
        qs('[data-recurrence]').textContent = String(recurrence).padStart(2, '0');

        if (crystal) {
          root.dataset.state = 'CRYSTAL';
          qs('[data-system-state]').textContent = 'CRYSTAL';
          qs('[data-crystal-label]').textContent = 'CRYSTAL STATE UNLOCKED';
          qs('[data-crystal-subtitle]').textContent = 'COHERENCE ACROSS MATTER / SIGNAL / OBSERVER';
        } else if (textLength > 0) {
          root.dataset.state = 'RECEIVING';
          qs('[data-system-state]').textContent = 'RECEIVING';
          qs('[data-crystal-label]').textContent = 'CRYSTAL STATE LOCKED';
          qs('[data-crystal-subtitle]').textContent = 'ALIGN MATTER / SIGNAL / OBSERVER';
        } else {
          root.dataset.state = 'DORMANT';
          qs('[data-system-state]').textContent = 'DORMANT';
        }
      }

      function renderMemory() {
        memoryList.innerHTML = '';
        if (!state.records.length) {
          const empty = document.createElement('li');
          empty.className = 'cr__memory-empty';
          empty.textContent = 'NO SIGNALS CAPTURED';
          memoryList.appendChild(empty);
          return;
        }

        state.records.slice().reverse().slice(0, 6).forEach((record) => {
          const li = document.createElement('li');
          li.innerHTML = `
            <div><span>${record.modality}</span><time>${new Date(record.timestamp).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</time></div>
            <p>${escapeHTML(record.text.slice(0, 96))}${record.text.length > 96 ? '…' : ''}</p>
            <small>${record.epistemic} · C${record.coherence.toFixed(2)} · ${record.checksum}</small>
          `;
          memoryList.appendChild(li);
        });
      }

      function escapeHTML(value) {
        return value.replace(/[&<>'"]/g, (char) => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
        }[char]));
      }

      function persist() {
        try { localStorage.setItem(storageKey, JSON.stringify(state.records.slice(-50))); } catch (_) {}
      }

      function restore() {
        try {
          const raw = JSON.parse(localStorage.getItem(storageKey) || '[]');
          if (Array.isArray(raw)) state.records = raw;
        } catch (_) {
          state.records = [];
        }
        renderMemory();
      }

      qsa('[data-modality]').forEach((button) => {
        button.addEventListener('click', () => {
          state.modality = button.dataset.modality;
          qsa('[data-modality]').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
          calculate();
        });
      });

      qsa('[data-axis]').forEach((input) => {
        input.addEventListener('input', () => {
          const key = input.dataset.axis;
          state[key] = Number(input.value) / 100;
          qs(`[data-out="${key}"]`).textContent = state[key].toFixed(2);
          calculate();
        });
      });

      [signalInput, evidenceInput].forEach((el) => el.addEventListener('input', calculate));
      [sourceSelect, epistemicSelect].forEach((el) => el.addEventListener('change', calculate));

      qs('[data-capture]').addEventListener('click', () => {
        const text = signalInput.value.trim();
        if (!text) {
          signalInput.focus();
          root.dataset.state = 'ATTENTION';
          qs('[data-system-state]').textContent = 'INPUT REQUIRED';
          return;
        }

        root.dataset.state = 'DECODING';
        qs('[data-system-state]').textContent = 'DECODING';

        const epistemic = effectiveEpistemic();
        const record = {
          id: `KDX-SIG-${Date.now().toString(36).toUpperCase()}`,
          timestamp: new Date().toISOString(),
          modality: state.modality,
          text,
          normalized: text.toLowerCase(),
          source: sourceSelect.value,
          requestedEpistemic: epistemicSelect.value,
          epistemic,
          evidence: evidenceInput.value.trim(),
          axes: { matter: state.matter, signal: state.signal, observer: state.observer },
          coherence: state.coherence,
          density: densityFor(state.coherence),
          checksum: hashString([state.modality, text, sourceSelect.value].join('|')),
        };

        state.records.push(record);
        persist();
        renderMemory();

        setTimeout(() => {
          calculate();
        }, 260);
      });

      qs('[data-clear-memory]').addEventListener('click', () => {
        state.records = [];
        persist();
        renderMemory();
        calculate();
      });

      function tick() {
        qs('[data-clock]').textContent = new Date().toLocaleTimeString('en-GB', { hour12: false });
      }

      restore();
      calculate();
      tick();
      setInterval(tick, 1000);
    })();
  </script>

  <style>
    :global(html), :global(body) { margin: 0; background: #030406; overflow: hidden; }

    .cr {
      --ink: #e7ece8;
      --muted: #7d8884;
      --line: rgba(214, 232, 224, 0.16);
      --line-hot: rgba(214, 232, 224, 0.42);
      --accent: #d7fff0;
      --signal-color: #b9f9df;
      --danger: #ff5d57;
      --matter: .62;
      --signal: .62;
      --observer: .62;
      --coherence: .62;
      --spin: 0;
      position: fixed;
      inset: 0;
      display: grid;
      grid-template-rows: 58px 1fr 34px;
      min-width: 0;
      height: 100dvh;
      background:
        radial-gradient(circle at 50% 48%, rgba(190,255,226,0.06), transparent 32%),
        linear-gradient(rgba(255,255,255,0.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px),
        #030406;
      background-size: auto, 22px 22px, 22px 22px, auto;
      color: var(--ink);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      letter-spacing: .03em;
      isolation: isolate;
    }

    .cr::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 20;
      opacity: .15;
      background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(255,255,255,.04) 4px);
      mix-blend-mode: screen;
    }

    .cr__topbar,
    .cr__footer {
      z-index: 3;
      display: grid;
      align-items: center;
      border-color: var(--line);
      background: rgba(3,4,6,.88);
      backdrop-filter: blur(12px);
    }

    .cr__topbar {
      grid-template-columns: 1fr auto 1fr;
      gap: 18px;
      padding: 0 18px;
      border-bottom: 1px solid var(--line);
      font-size: 10px;
    }

    .cr__back { color: var(--muted); text-decoration: none; }
    .cr__back:hover { color: var(--accent); }
    .cr__identity { text-align: center; }
    .cr__identity strong, .cr__identity span { display: block; }
    .cr__identity strong { color: var(--accent); letter-spacing: .16em; }
    .cr__identity span { margin-top: 3px; color: var(--muted); font-size: 9px; }
    .cr__system { justify-self: end; display: flex; gap: 18px; color: var(--muted); }
    .cr__system span:first-child { color: var(--signal-color); }

    .cr__stage {
      min-height: 0;
      display: grid;
      grid-template-columns: minmax(280px, 0.86fr) minmax(340px, 1.35fr) minmax(280px, 0.86fr);
      overflow: hidden;
    }

    .cr__panel {
      min-width: 0;
      min-height: 0;
      padding: 18px;
      overflow: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--line-hot) transparent;
      background: rgba(3,4,6,.72);
    }
    .cr__panel--capture { border-right: 1px solid var(--line); }
    .cr__panel--decode { border-left: 1px solid var(--line); }

    .cr__panel-head,
    .cr__memory-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding-bottom: 9px;
      border-bottom: 1px solid var(--line);
      color: var(--muted);
      font-size: 8px;
      letter-spacing: .14em;
    }

    .cr h1 {
      margin: 24px 0 10px;
      font-size: clamp(24px, 2.5vw, 46px);
      line-height: .92;
      letter-spacing: -.045em;
      font-weight: 500;
    }
    .cr__lede { margin: 0 0 18px; max-width: 58ch; color: #9ca6a2; font-size: 10px; line-height: 1.65; }

    .cr__modalities { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; margin-bottom: 14px; }
    .cr__modalities button,
    .cr__memory-head button {
      appearance: none;
      border: 1px solid var(--line);
      background: transparent;
      color: var(--muted);
      font: inherit;
      font-size: 8px;
      padding: 7px 5px;
      cursor: pointer;
    }
    .cr__modalities button[aria-pressed="true"] { color: #020504; background: var(--accent); border-color: var(--accent); }

    .cr__field { display: grid; gap: 6px; margin: 10px 0; }
    .cr__field > span { color: var(--muted); font-size: 8px; letter-spacing: .12em; }
    .cr__field textarea,
    .cr__field input,
    .cr__field select {
      width: 100%;
      box-sizing: border-box;
      border: 1px solid var(--line);
      border-radius: 0;
      outline: 0;
      background: rgba(255,255,255,.025);
      color: var(--ink);
      padding: 9px 10px;
      font: 10px/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }
    .cr__field textarea { resize: none; }
    .cr__field textarea:focus,
    .cr__field input:focus,
    .cr__field select:focus { border-color: var(--line-hot); box-shadow: 0 0 0 1px rgba(215,255,240,.07); }
    .cr__two { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

    .cr__capture {
      width: 100%;
      margin-top: 11px;
      padding: 12px;
      border: 1px solid var(--accent);
      background: transparent;
      color: var(--accent);
      font: inherit;
      cursor: pointer;
      text-align: left;
    }
    .cr__capture span, .cr__capture small { display: block; }
    .cr__capture span { font-size: 11px; letter-spacing: .14em; }
    .cr__capture small { margin-top: 4px; color: var(--muted); font-size: 8px; }
    .cr__capture:hover { background: rgba(215,255,240,.07); }
    .cr__policy { color: var(--muted); font-size: 8px; line-height: 1.55; }

    .cr__core {
      position: relative;
      min-width: 0;
      min-height: 0;
      overflow: hidden;
      display: grid;
      place-items: center;
      background: radial-gradient(circle, rgba(215,255,240,calc(var(--coherence) * .055)), transparent 54%);
    }
    .cr__field-grid {
      position: absolute;
      inset: 10%;
      opacity: .35;
      background:
        linear-gradient(var(--line) 1px, transparent 1px),
        linear-gradient(90deg, var(--line) 1px, transparent 1px);
      background-size: 42px 42px;
      mask-image: radial-gradient(circle, #000 0 45%, transparent 72%);
    }

    .cr__sigil {
      width: min(72vh, 88%);
      max-width: 720px;
      overflow: visible;
      filter: drop-shadow(0 0 30px rgba(185,249,223,calc(var(--coherence) * .08)));
    }
    .cr__sigil-grid { fill: none; stroke: rgba(220,238,230,.16); stroke-width: .8; stroke-dasharray: 2 5; }
    .cr__diamond { fill: none; stroke-width: calc(1px + var(--coherence) * 2px); transform-origin: 250px 250px; }
    .cr__diamond--matter { stroke: rgba(255,255,255,calc(.18 + var(--matter) * .58)); transform: rotate(calc(var(--spin) * 8deg)); }
    .cr__diamond--signal { stroke: rgba(185,249,223,calc(.18 + var(--signal) * .64)); transform: rotate(calc(var(--spin) * -12deg)); }
    .cr__diamond--observer { stroke: rgba(206,218,255,calc(.16 + var(--observer) * .62)); transform: rotate(calc(var(--spin) * 5deg)); }
    .cr__crystal { fill: rgba(215,255,240,calc(var(--coherence) * .045)); stroke: rgba(215,255,240,calc(.12 + var(--coherence) * .8)); stroke-width: 1.2; opacity: calc(.34 + var(--coherence) * .66); }
    .cr__source { fill: var(--accent); opacity: calc(.38 + var(--coherence) * .62); }

    .cr__orbit { position: absolute; border: 1px solid var(--line); border-radius: 50%; pointer-events: none; }
    .cr__orbit--a { width: 46%; aspect-ratio: 1; }
    .cr__orbit--b { width: 62%; aspect-ratio: 1; border-style: dashed; }
