---
import Base from '../../../../layouts/Base.astro';
---

<Base
  title="KODEX Lab — Crystal Receiver / Phase Shift"
  description="Derived phase-transition state for the KODEX Crystal Receiver simulator."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="ps" data-phase-shift data-state="LOCKED">
    <header class="ps__topbar">
      <a href="/kodex/lab/crystal-receiver/">← CRYSTAL RECEIVER</a>
      <div>
        <strong>KDX // PHASE SHIFT ENGINE</strong>
        <span>DERIVED FROM LIVING MEMORY · SAME DEVICE</span>
      </div>
      <span data-state-label>LOCKED</span>
    </header>

    <section class="ps__grid">
      <aside class="ps__panel">
        <span class="ps__eyebrow">04 / TRANSITION CONDITIONS</span>
        <h1>QUANTUM LEAP</h1>
        <p>
          In KODEX, “quantum leap” is a canonical metaphor for a discrete state transition in the simulator.
          It is not a claim that human consciousness is undergoing a measured quantum-physical event.
        </p>

        <div class="ps__metric"><span>SIGNALS</span><strong data-signals>00</strong></div>
        <div class="ps__metric"><span>AVG COHERENCE</span><strong data-coherence>0.00</strong></div>
        <div class="ps__metric"><span>MODALITY DIVERSITY</span><strong data-diversity>0.00</strong></div>
        <div class="ps__metric"><span>EVIDENCE RATIO</span><strong data-evidence>0.00</strong></div>
        <div class="ps__metric"><span>TRUTH DISCIPLINE</span><strong data-truth>0.00</strong></div>

        <div class="ps__gate">
          <span>PHASE GATE</span>
          <div><i data-gate-fill></i></div>
          <strong data-readiness>0%</strong>
        </div>

        <button type="button" data-shift disabled>
          <span>INITIATE PHASE SHIFT</span>
          <small>requires ≥ 3 signals + readiness ≥ 68%</small>
        </button>
      </aside>

      <section class="ps__field" aria-label="Phase transition visualizer">
        <div class="ps__mesh" aria-hidden="true"></div>
        <div class="ps__ring ps__ring--outer" aria-hidden="true"></div>
        <div class="ps__ring ps__ring--mid" aria-hidden="true"></div>
        <div class="ps__ring ps__ring--inner" aria-hidden="true"></div>
        <div class="ps__before" aria-hidden="true"></div>
        <div class="ps__after" aria-hidden="true"></div>
        <div class="ps__bridge" aria-hidden="true"></div>

        <div class="ps__center">
          <span data-phase-code>KDX-PS / WAITING</span>
          <strong data-phase-title>STATE TRANSITION LOCKED</strong>
          <p data-phase-copy>Capture and classify signals in the Crystal Receiver first.</p>
        </div>

        <div class="ps__node ps__node--a">SOURCE</div>
        <div class="ps__node ps__node--b">MEMORY</div>
        <div class="ps__node ps__node--c">OBSERVER</div>
        <div class="ps__node ps__node--d">−∞</div>
      </section>

      <aside class="ps__panel ps__panel--right">
        <span class="ps__eyebrow">05 / STATE HISTORY</span>
        <div class="ps__decoder">
          <div><span>PREVIOUS HASH</span><strong data-prev>--------</strong></div>
          <div><span>NEXT HASH</span><strong data-next>--------</strong></div>
          <div><span>PHASE DELTA</span><strong data-delta>0.00</strong></div>
          <div><span>RESULT</span><strong data-result>UNRESOLVED</strong></div>
        </div>

        <p class="ps__note">
          The transition never upgrades an epistemic claim. A SPECULATIVE signal remains SPECULATIVE after the shift.
          The engine changes the simulated relationship between records; it does not change their truth status.
        </p>

        <ol class="ps__history" data-history></ol>
      </aside>
    </section>

    <footer class="ps__footer">
      <span>COHERENCE → THRESHOLD → DISCRETE TRANSITION → NEW CONFIGURATION → MEMORY</span>
      <span>LAB-ONLY · LOCAL-FIRST</span>
    </footer>
  </main>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-phase-shift]');
      if (!root) return;
      const qs = (s) => root.querySelector(s);
      const signalKey = 'kdx-crystal-receiver-v1';
      const eventKey = 'kdx-crystal-phase-events-v1';
      const clamp = (n, min = 0, max = 1) => Math.min(max, Math.max(min, n));

      function read(key) {
        try {
          const value = JSON.parse(localStorage.getItem(key) || '[]');
          return Array.isArray(value) ? value : [];
        } catch (_) { return []; }
      }

      function write(key, value) {
        try { localStorage.setItem(key, JSON.stringify(value)); } catch (_) {}
      }

      function hash(value) {
        let h = 2166136261;
        for (let i = 0; i < value.length; i++) {
          h ^= value.charCodeAt(i);
          h = Math.imul(h, 16777619);
        }
        return (h >>> 0).toString(16).padStart(8, '0').toUpperCase();
      }

      function metrics(records) {
        const count = records.length;
        const avg = count ? records.reduce((s, r) => s + Number(r.coherence || 0), 0) / count : 0;
        const modalities = new Set(records.map((r) => r.modality).filter(Boolean)).size;
        const diversity = clamp(modalities / 5);
        const evidence = count ? records.filter((r) => String(r.evidence || '').trim().length >= 8).length / count : 0;
        const truthSafe = count ? records.filter((r) => r.epistemic !== 'VERIFIED' || String(r.evidence || '').trim().length >= 8).length / count : 1;
        const memoryDepth = clamp(count / 7);
        const readiness = clamp(avg * .38 + diversity * .18 + evidence * .12 + truthSafe * .18 + memoryDepth * .14);
        return { count, avg, diversity, evidence, truthSafe, readiness };
      }

      function renderHistory(events) {
        const list = qs('[data-history]');
        list.innerHTML = '';
        if (!events.length) {
          const li = document.createElement('li');
          li.textContent = 'NO PHASE SHIFTS RECORDED';
          list.appendChild(li);
          return;
        }
        events.slice().reverse().slice(0, 8).forEach((event) => {
          const li = document.createElement('li');
          li.innerHTML = `<div><span>${event.code}</span><time>${new Date(event.timestamp).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</time></div><small>${event.before} → ${event.after} · Δ${event.delta}</small>`;
          list.appendChild(li);
        });
      }

      const records = read(signalKey);
      const events = read(eventKey);
      const m = metrics(records);
      const previousHash = hash(records.map((r) => r.checksum || '').join('|') || 'EMPTY');
      const unlocked = m.count >= 3 && m.readiness >= .68;

      qs('[data-signals]').textContent = String(m.count).padStart(2, '0');
      qs('[data-coherence]').textContent = m.avg.toFixed(2);
      qs('[data-diversity]').textContent = m.diversity.toFixed(2);
      qs('[data-evidence]').textContent = m.evidence.toFixed(2);
      qs('[data-truth]').textContent = m.truthSafe.toFixed(2);
      qs('[data-readiness]').textContent = `${Math.round(m.readiness * 100)}%`;
      qs('[data-gate-fill]').style.width = `${Math.round(m.readiness * 100)}%`;
      qs('[data-prev]').textContent = previousHash;
      renderHistory(events);

      if (unlocked) {
        root.dataset.state = 'READY';
        qs('[data-state-label]').textContent = 'READY';
        qs('[data-phase-title]').textContent = 'PHASE GATE OPEN';
        qs('[data-phase-copy]').textContent = 'The current memory configuration is stable enough to simulate a discrete transition.';
        qs('[data-phase-code]').textContent = 'KDX-PS / READY';
        qs('[data-shift]').disabled = false;
      }

      qs('[data-shift]').addEventListener('click', () => {
        if (!unlocked) return;
        root.dataset.state = 'SHIFTING';
        qs('[data-state-label]').textContent = 'SHIFTING';
        qs('[data-phase-title]').textContent = 'COLLAPSING CONFIGURATION';
        qs('[data-phase-copy]').textContent = 'Existing records are preserved. Only their simulated configuration is changing.';

        const delta = clamp((m.readiness - .5) * 1.7 + Math.min(events.length, 6) * .015);
        const seed = `${previousHash}|${Date.now()}|${m.readiness.toFixed(4)}|${m.count}`;
        const nextHash = hash(seed);
        const event = {
          code: `KDX-PS-${String(events.length + 1).padStart(3, '0')}`,
          timestamp: new Date().toISOString(),
          before: previousHash,
          after: nextHash,
          delta: delta.toFixed(2),
          readiness: m.readiness,
          signalCount: m.count,
        };

        setTimeout(() => {
          events.push(event);
          write(eventKey, events.slice(-50));
          root.dataset.state = 'SHIFTED';
          qs('[data-state-label]').textContent = 'SHIFTED';
          qs('[data-phase-code]').textContent = event.code;
          qs('[data-phase-title]').textContent = 'NEW CONFIGURATION ACTIVE';
          qs('[data-phase-copy]').textContent = 'The archive preserved its records and generated a new relational state from the same memory.';
          qs('[data-next]').textContent = nextHash;
          qs('[data-delta]').textContent = delta.toFixed(2);
          qs('[data-result]').textContent = delta >= .45 ? 'MUTATED' : 'RECONFIGURED';
          qs('[data-shift]').disabled = true;
          renderHistory(events);
        }, 620);
      });
    })();
  </script>

  <style>
    :global(html), :global(body) { margin: 0; background: #020305; overflow: hidden; }
    .ps {
      --ink: #e9efec;
      --muted: #7f8b86;
      --line: rgba(220,238,230,.16);
      --hot: #dfffee;
      position: fixed; inset: 0; height: 100dvh;
      display: grid; grid-template-rows: 58px 1fr 34px;
      color: var(--ink); background: #020305;
      font: 10px/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      letter-spacing: .04em;
    }
    .ps__topbar, .ps__footer { display: grid; align-items: center; border-color: var(--line); background: rgba(2,3,5,.9); z-index: 3; }
    .ps__topbar { grid-template-columns: 1fr auto 1fr; padding: 0 18px; border-bottom: 1px solid var(--line); }
    .ps__topbar a { color: var(--muted); text-decoration: none; }
    .ps__topbar > div { text-align: center; }
    .ps__topbar strong, .ps__topbar > div span { display: block; }
    .ps__topbar strong { color: var(--hot); letter-spacing: .16em; }
    .ps__topbar > div span { color: var(--muted); font-size: 8px; }
    .ps__topbar > span { justify-self: end; color: var(--hot); }
    .ps__grid { min-height: 0; display: grid; grid-template-columns: minmax(260px,.8fr) minmax(420px,1.5fr) minmax(260px,.8fr); }
    .ps__panel { padding: 20px; overflow: auto; border-right: 1px solid var(--line); background: rgba(255,255,255,.012); }
    .ps__panel--right { border-right: 0; border-left: 1px solid var(--line); }
    .ps__eyebrow { color: var(--muted); font-size: 8px; letter-spacing: .14em; }
    .ps h1 { margin: 24px 0 10px; font-size: clamp(30px,3vw,54px); line-height: .9; letter-spacing: -.05em; font-weight: 500; }
    .ps__panel > p { color: #9da8a3; font-size: 9px; line-height: 1.65; }
    .ps__metric { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid var(--line); }
    .ps__metric span { color: var(--muted); }
    .ps__metric strong { color: var(--hot); font-weight: 500; }
    .ps__gate { margin: 18px 0; }
    .ps__gate > span { display: block; margin-bottom: 7px; color: var(--muted); font-size: 8px; }
    .ps__gate > div { height: 4px; background: rgba(255,255,255,.06); overflow: hidden; }
    .ps__gate i { display: block; height: 100%; width: 0; background: var(--hot); }
    .ps__gate strong { display: block; margin-top: 6px; text-align: right; color: var(--hot); font-weight: 500; }
    [data-shift] { width: 100%; padding: 12px; border: 1px solid var(--hot); background: transparent; color: var(--hot); text-align: left; font: inherit; cursor: pointer; }
    [data-shift] span, [data-shift] small { display: block; }
    [data-shift] small { margin-top: 4px; color: var(--muted); font-size: 8px; }
    [data-shift]:disabled { opacity: .28; cursor: not-allowed; }
    .ps__field { position: relative; min-width: 0; min-height: 0; overflow: hidden; display: grid; place-items: center; background: radial-gradient(circle at center, rgba(210,255,235,.06), transparent 36%), #020305; }
    .ps__mesh { position: absolute; inset: 8%; background: linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px); background-size: 36px 36px; mask-image: radial-gradient(circle,#000 0 45%,transparent 72%); opacity: .3; }
    .ps__ring { position: absolute; border: 1px solid var(--line); border-radius: 50%; aspect-ratio: 1; }
    .ps__ring--outer { width: 78%; border-style: dashed; }
    .ps__ring--mid { width: 58%; }
    .ps__ring--inner { width: 38%; border-color: rgba(223,255,238,.3); }
    .ps__before, .ps__after { position: absolute; width: 22%; aspect-ratio: 1; border: 1px solid rgba(223,255,238,.48); transform: rotate(45deg); }
    .ps__before { left: 25%; }
    .ps__after { right: 25%; opacity: .28; }
    .ps__bridge { position: absolute; width: 34%; height: 1px; background: linear-gradient(90deg,transparent,var(--hot),transparent); opacity: .3; }
    .ps__center { position: relative; z-index: 2; width: min(440px,72%); text-align: center; }
    .ps__center span, .ps__center strong, .ps__center p { display: block; }
    .ps__center span { color: var(--muted); font-size: 8px; letter-spacing: .16em; }
    .ps__center strong { margin-top: 8px; color: var(--hot); font-size: clamp(16px,2vw,28px); font-weight: 500; letter-spacing: .06em; }
    .ps__center p { margin: 8px auto 0; color: var(--muted); max-width: 48ch; font-size: 8px; }
    .ps__node { position: absolute; color: var(--muted); font-size: 7px; letter-spacing: .14em; }
    .ps__node--a { top: 10%; left: 50%; transform: translateX(-50%); }
    .ps__node--b { left: 8%; top: 50%; }
    .ps__node--c { right: 8%; top: 50%; }
    .ps__node--d { bottom: 10%; left: 50%; transform: translateX(-50%); }
    .ps__decoder { margin-top: 22px; border: 1px solid var(--line); }
    .ps__decoder > div { display: flex; justify-content: space-between; gap: 10px; padding: 9px; border-bottom: 1px solid var(--line); }
    .ps__decoder > div:last-child { border-bottom: 0; }
    .ps__decoder span { color: var(--muted); }
    .ps__decoder strong { color: var(--hot); font-weight: 500; text-align: right; }
    .ps__note { margin-top: 16px; padding: 10px; border-left: 2px solid var(--hot); background: rgba(223,255,238,.03); }
    .ps__history { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 6px; }
    .ps__history li { padding: 8px; border: 1px solid var(--line); color: var(--muted); }
    .ps__history li > div { display: flex; justify-content: space-between; color: var(--hot); }
    .ps__footer { grid-template-columns: 1fr auto; padding: 0 18px; border-top: 1px solid var(--line); color: var(--muted); font-size: 7px; white-space: nowrap; overflow: hidden; }
    .ps[data-state="READY"] .ps__ring--outer { animation: spin 22s linear infinite; }
    .ps[data-state="READY"] .ps__after { opacity: .58; }
    .ps[data-state="SHIFTING"] .ps__before { animation: collapse .62s ease-in forwards; }
    .ps[data-state="SHIFTING"] .ps__after { animation: emerge .62s ease-out forwards; }
    .ps[data-state="SHIFTING"] .ps__bridge { animation: flash .62s ease-in-out; }
    .ps[data-state="SHIFTED"] .ps__after { opacity: 1; box-shadow: 0 0 50px rgba(223,255,238,.16); }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes collapse { to { transform: rotate(225deg) scale(.05); opacity: 0; } }
    @keyframes emerge { from { transform: rotate(45deg) scale(.05); opacity: 0; } to { transform: rotate(45deg) scale(1); opacity: 1; } }
    @keyframes flash { 50% { opacity: 1; transform: scaleX(1.7); } }
    @media (max-width: 980px) {
      :global(html), :global(body) { overflow: auto; }
      .ps { position: relative; height: auto; min-height: 100dvh; grid-template-rows: 54px auto 34px; }
      .ps__grid { grid-template-columns: 1fr; }
      .ps__field { min-height: 62dvh; order: -1; border-bottom: 1px solid var(--line); }
      .ps__panel, .ps__panel--right { border: 0; border-bottom: 1px solid var(--line); }
    }
    @media (max-width: 560px) {
      .ps__topbar { grid-template-columns: auto 1fr; padding: 0 10px; }
      .ps__topbar > div { text-align: left; }
      .ps__topbar > span { display: none; }
      .ps__field { min-height: 54dvh; }
      .ps__panel { padding: 14px; }
      .ps__footer { padding: 0 10px; grid-template-columns: 1fr; }
      .ps__footer span:last-child { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ps *, .ps *::before, .ps *::after { animation: none !important; transition: none !important; }
    }
  </style>
</Base>
