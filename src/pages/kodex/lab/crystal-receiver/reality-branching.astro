---
import Base from '../../../../layouts/Base.astro';
---

<Base
  title="KODEX Lab — Crystal Receiver / Reality Branching"
  description="Derived reality-branching state for the KODEX Crystal Receiver simulator."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="rb" data-reality-branching data-state="LOCKED">
    <header class="rb__topbar">
      <a href="/kodex/lab/crystal-receiver/phase-shift">← PHASE SHIFT</a>
      <div>
        <strong>KDX // REALITY BRANCHING</strong>
        <span>SAME MEMORY · DERIVED PATHS · NO TRUTH UPGRADE</span>
      </div>
      <span data-state-label>LOCKED</span>
    </header>

    <section class="rb__layout">
      <aside class="rb__panel rb__panel--left">
        <span class="rb__eyebrow">06 / BRANCH CONDITIONS</span>
        <h1>SELECT NO REALITY.<br />OBSERVE THE BRANCH.</h1>
        <p>
          KODEX derives four simulated paths from the same Receiver memory. A branch changes the
          relationship between records, visuals and future prompts. It does not make any cosmology true.
        </p>

        <div class="rb__metric"><span>SIGNALS</span><strong data-signals>00</strong></div>
        <div class="rb__metric"><span>PHASE EVENTS</span><strong data-phases>00</strong></div>
        <div class="rb__metric"><span>AVG COHERENCE</span><strong data-coherence>0.00</strong></div>
        <div class="rb__metric"><span>AMBIGUITY</span><strong data-ambiguity>0.00</strong></div>
        <div class="rb__metric"><span>BALANCE</span><strong data-balance>0.00</strong></div>

        <div class="rb__emergent">
          <span>EMERGENT PATH</span>
          <strong data-emergent>UNRESOLVED</strong>
          <small data-emergent-copy>Complete a Phase Shift first.</small>
        </div>

        <p class="rb__policy">
          Branch labels are canonical KODEX states. They are not diagnoses, predictions, dimensions,
          timelines or evidence of external contact.
        </p>
      </aside>

      <section class="rb__field" aria-label="Reality branch field">
        <div class="rb__mesh" aria-hidden="true"></div>
        <div class="rb__axis rb__axis--x" aria-hidden="true"></div>
        <div class="rb__axis rb__axis--y" aria-hidden="true"></div>
        <div class="rb__core" aria-hidden="true"><i></i><i></i><i></i></div>

        <button class="rb__branch rb__branch--matter" type="button" data-branch="ALPHA" disabled>
          <span>PATH α</span>
          <strong>MATTER</strong>
          <small>body · structure · territory · constraint</small>
          <output data-score="ALPHA">0.00</output>
        </button>

        <button class="rb__branch rb__branch--signal" type="button" data-branch="BETA" disabled>
          <span>PATH β</span>
          <strong>SIGNAL</strong>
          <small>pattern · relation · transmission · code</small>
          <output data-score="BETA">0.00</output>
        </button>

        <button class="rb__branch rb__branch--observer" type="button" data-branch="GAMMA" disabled>
          <span>PATH γ</span>
          <strong>OBSERVER</strong>
          <small>attention · agency · interpretation · self-model</small>
          <output data-score="GAMMA">0.00</output>
        </button>

        <button class="rb__branch rb__branch--unknown" type="button" data-branch="OMEGA" disabled>
          <span>PATH Ω</span>
          <strong>UNKNOWN</strong>
          <small>ambiguity · anomaly · unresolved source · −∞</small>
          <output data-score="OMEGA">0.00</output>
        </button>

        <div class="rb__center-copy">
          <span data-center-code>KDX-RB / WAITING</span>
          <strong data-center-title>BRANCH FIELD LOCKED</strong>
          <p data-center-copy>Phase Shift must exist before branching can be derived.</p>
        </div>
      </section>

      <aside class="rb__panel rb__panel--right">
        <span class="rb__eyebrow">07 / BRANCH MEMORY</span>
        <div class="rb__decoder">
          <div><span>SOURCE PHASE</span><strong data-phase-hash>--------</strong></div>
          <div><span>ACTIVE BRANCH</span><strong data-active>NONE</strong></div>
          <div><span>BRANCH HASH</span><strong data-branch-hash>--------</strong></div>
          <div><span>TRUTH STATUS</span><strong>PRESERVED</strong></div>
        </div>

        <p class="rb__note" data-branch-note>
          No branch has been entered. KODEX is showing only derived probabilities from local session memory.
        </p>

        <ol class="rb__history" data-history></ol>

        <a class="rb__return" href="/kodex/lab/crystal-receiver/">RETURN TO RECEIVER →</a>
      </aside>
    </section>

    <footer class="rb__footer">
      <span>MEMORY → PHASE SHIFT → BRANCH FIELD → CHOICE / EMERGENCE → NEW RELATIONAL STATE → RETURN</span>
      <span>LOCAL-FIRST · LAB-ONLY</span>
    </footer>
  </main>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-reality-branching]');
      if (!root) return;
      const qs = (s) => root.querySelector(s);
      const qsa = (s) => [...root.querySelectorAll(s)];
      const signalKey = 'kdx-crystal-receiver-v1';
      const phaseKey = 'kdx-crystal-phase-events-v1';
      const branchKey = 'kdx-crystal-branch-events-v1';
      const clamp = (n, min = 0, max = 1) => Math.min(max, Math.max(min, n));

      function read(key) {
        try {
          const value = JSON.parse(localStorage.getItem(key) || '[]');
          return Array.isArray(value) ? value : [];
        } catch (_) { return []; }
      }

      function write(key, value) {
        try { localStorage.setItem(key, JSON.stringify(value)); } catch (_) {}
      }

      function hash(value) {
        let h = 2166136261;
        for (let i = 0; i < value.length; i++) {
          h ^= value.charCodeAt(i);
          h = Math.imul(h, 16777619);
        }
        return (h >>> 0).toString(16).padStart(8, '0').toUpperCase();
      }

      function avgAxis(records, key) {
        return records.length
          ? records.reduce((sum, record) => sum + Number(record.axes?.[key] || 0), 0) / records.length
          : 0;
      }

      const records = read(signalKey);
      const phases = read(phaseKey);
      const branchEvents = read(branchKey);
      const latestPhase = phases.at(-1);
      const unlocked = records.length >= 3 && Boolean(latestPhase);

      const matter = avgAxis(records, 'matter');
      const signal = avgAxis(records, 'signal');
      const observer = avgAxis(records, 'observer');
      const avgCoherence = records.length
        ? records.reduce((sum, r) => sum + Number(r.coherence || 0), 0) / records.length
        : 0;
      const axisMax = Math.max(matter, signal, observer);
      const axisMin = Math.min(matter, signal, observer);
      const balance = clamp(1 - (axisMax - axisMin));
      const ambiguousSources = new Set(['UNKNOWN', 'EXTERNAL-UNKNOWN', 'CONTACTIST-HYPOTHESIS']);
      const ambiguity = records.length
        ? records.filter((r) => ambiguousSources.has(r.source)).length / records.length
        : 0;
      const modalityDiversity = clamp(new Set(records.map((r) => r.modality).filter(Boolean)).size / 5);

      const scores = {
        ALPHA: clamp(matter * .62 + balance * .16 + avgCoherence * .14 + (1 - ambiguity) * .08),
        BETA: clamp(signal * .58 + modalityDiversity * .18 + avgCoherence * .16 + ambiguity * .08),
        GAMMA: clamp(observer * .60 + balance * .14 + avgCoherence * .18 + modalityDiversity * .08),
        OMEGA: clamp(ambiguity * .44 + balance * .20 + avgCoherence * .14 + (1 - axisMax) * .08 + modalityDiversity * .14),
      };

      const names = {
        ALPHA: 'α / MATTER',
        BETA: 'β / SIGNAL',
        GAMMA: 'γ / OBSERVER',
        OMEGA: 'Ω / UNKNOWN',
      };

      const descriptions = {
        ALPHA: 'The archive privileges embodiment, structure, limits and material consequence.',
        BETA: 'The archive privileges relation, recurrence, transmission and pattern propagation.',
        GAMMA: 'The archive privileges attention, agency, interpretation and the observer model.',
        OMEGA: 'The archive preserves ambiguity and routes unresolved signals toward −∞ instead of forcing an explanation.',
      };

      const emergent = Object.entries(scores).sort((a, b) => b[1] - a[1])[0]?.[0] || 'OMEGA';

      qs('[data-signals]').textContent = String(records.length).padStart(2, '0');
      qs('[data-phases]').textContent = String(phases.length).padStart(2, '0');
      qs('[data-coherence]').textContent = avgCoherence.toFixed(2);
      qs('[data-ambiguity]').textContent = ambiguity.toFixed(2);
      qs('[data-balance]').textContent = balance.toFixed(2);
      qs('[data-emergent]').textContent = unlocked ? names[emergent] : 'UNRESOLVED';
      qs('[data-emergent-copy]').textContent = unlocked
        ? `Highest derived score: ${scores[emergent].toFixed(2)}. You may enter it or deliberately test another branch.`
        : 'Complete a Phase Shift first.';
      qs('[data-phase-hash]').textContent = latestPhase?.after || '--------';

      Object.entries(scores).forEach(([key, value]) => {
        qs(`[data-score="${key}"]`).textContent = value.toFixed(2);
      });

      function renderHistory() {
        const list = qs('[data-history]');
        list.innerHTML = '';
        if (!branchEvents.length) {
          const li = document.createElement('li');
          li.textContent = 'NO BRANCHES ENTERED';
          list.appendChild(li);
          return;
        }
        branchEvents.slice().reverse().slice(0, 8).forEach((event) => {
          const li = document.createElement('li');
          li.innerHTML = `<div><span>${event.code}</span><time>${new Date(event.timestamp).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</time></div><strong>${event.label}</strong><small>${event.phase} → ${event.hash}</small>`;
          list.appendChild(li);
        });
      }

      renderHistory();

      if (unlocked) {
        root.dataset.state = 'READY';
        qs('[data-state-label]').textContent = 'BRANCH FIELD OPEN';
        qs('[data-center-code]').textContent = 'KDX-RB / READY';
        qs('[data-center-title]').textContent = `${names[emergent]} EMERGES`;
        qs('[data-center-copy]').textContent = 'Emergence is derived from the current archive. Selection remains a conscious simulator action.';
        qsa('[data-branch]').forEach((button) => { button.disabled = false; });
        qs(`[data-branch="${emergent}"]`)?.setAttribute('data-emergent', 'true');
      }

      qsa('[data-branch]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!unlocked) return;
          const branch = button.dataset.branch;
          const phaseHash = latestPhase.after;
          const branchHash = hash(`${phaseHash}|${branch}|${records.map((r) => r.checksum).join('|')}|${branchEvents.length}`);
          const event = {
            code: `KDX-RB-${String(branchEvents.length + 1).padStart(3, '0')}`,
            timestamp: new Date().toISOString(),
            branch,
            label: names[branch],
            phase: phaseHash,
            hash: branchHash,
            score: scores[branch],
            emergent: branch === emergent,
          };

          branchEvents.push(event);
          write(branchKey, branchEvents.slice(-50));

          root.dataset.state = branch;
          qs('[data-state-label]').textContent = `ACTIVE ${names[branch]}`;
          qs('[data-active]').textContent = names[branch];
          qs('[data-branch-hash]').textContent = branchHash;
          qs('[data-center-code]').textContent = event.code;
          qs('[data-center-title]').textContent = `${names[branch]} ACTIVE`;
          qs('[data-center-copy]').textContent = descriptions[branch];
          qs('[data-branch-note]').textContent = `${descriptions[branch]} Original signal records and epistemic labels remain unchanged.`;
          qsa('[data-branch]').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
          renderHistory();
        });
      });
    })();
  </script>

  <style>
    :global(html), :global(body) { margin: 0; background: #020305; overflow: hidden; }
    .rb {
      --ink: #edf2ef;
      --muted: #7e8985;
      --line: rgba(220,238,230,.16);
      --hot: #e3fff2;
      --matter: #eee9dc;
      --signal: #c7ffe7;
      --observer: #d7dcff;
      --unknown: #efcbff;
      position: fixed; inset: 0; height: 100dvh;
      display: grid; grid-template-rows: 58px 1fr 34px;
      color: var(--ink); background: #020305;
      font: 10px/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      letter-spacing: .035em;
    }
    .rb__topbar, .rb__footer { display: grid; align-items: center; z-index: 3; background: rgba(2,3,5,.9); }
    .rb__topbar { grid-template-columns: 1fr auto 1fr; padding: 0 18px; border-bottom: 1px solid var(--line); }
    .rb__topbar a { color: var(--muted); text-decoration: none; }
    .rb__topbar > div { text-align: center; }
    .rb__topbar strong, .rb__topbar > div span { display: block; }
    .rb__topbar strong { color: var(--hot); letter-spacing: .16em; }
    .rb__topbar > div span { color: var(--muted); font-size: 8px; }
    .rb__topbar > span { justify-self: end; color: var(--hot); }
    .rb__layout { min-height: 0; display: grid; grid-template-columns: minmax(260px,.78fr) minmax(440px,1.55fr) minmax(260px,.78fr); }
    .rb__panel { padding: 20px; overflow: auto; background: rgba(255,255,255,.012); }
    .rb__panel--left { border-right: 1px solid var(--line); }
    .rb__panel--right { border-left: 1px solid var(--line); }
    .rb__eyebrow { color: var(--muted); font-size: 8px; letter-spacing: .15em; }
    .rb h1 { margin: 24px 0 10px; font-size: clamp(26px,2.7vw,48px); line-height: .9; letter-spacing: -.05em; font-weight: 500; }
    .rb__panel p { color: #9fa9a5; font-size: 9px; line-height: 1.65; }
    .rb__metric { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid var(--line); }
    .rb__metric span { color: var(--muted); }
    .rb__metric strong { color: var(--hot); font-weight: 500; }
    .rb__emergent { margin: 18px 0; padding: 12px; border: 1px solid var(--line); }
    .rb__emergent span, .rb__emergent strong, .rb__emergent small { display: block; }
    .rb__emergent span { color: var(--muted); font-size: 8px; }
    .rb__emergent strong { margin: 6px 0; color: var(--hot); font-size: 14px; font-weight: 500; }
    .rb__emergent small { color: var(--muted); line-height: 1.5; }
    .rb__policy { padding-left: 10px; border-left: 2px solid var(--hot); }

    .rb__field { position: relative; min-width: 0; min-height: 0; overflow: hidden; background: radial-gradient(circle, rgba(225,255,242,.055), transparent 38%), #020305; }
    .rb__mesh { position: absolute; inset: 7%; opacity: .26; background: linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px); background-size: 34px 34px; mask-image: radial-gradient(circle,#000 0 46%,transparent 75%); }
    .rb__axis { position: absolute; background: var(--line); }
    .rb__axis--x { left: 7%; right: 7%; top: 50%; height: 1px; }
    .rb__axis--y { top: 7%; bottom: 7%; left: 50%; width: 1px; }
    .rb__core { position: absolute; left: 50%; top: 50%; width: 92px; aspect-ratio: 1; transform: translate(-50%,-50%) rotate(45deg); border: 1px solid rgba(227,255,242,.35); }
    .rb__core i { position: absolute; inset: 18%; border: 1px solid rgba(227,255,242,.16); }
    .rb__core i:nth-child(2) { inset: 34%; }
    .rb__core i:nth-child(3) { inset: 46%; background: var(--hot); box-shadow: 0 0 24px rgba(227,255,242,.22); }

    .rb__branch { position: absolute; width: min(220px,30%); min-height: 102px; padding: 12px; border: 1px solid var(--line); background: rgba(2,3,5,.74); color: var(--ink); text-align: left; font: inherit; cursor: pointer; backdrop-filter: blur(8px); }
    .rb__branch span, .rb__branch strong, .rb__branch small, .rb__branch output { display: block; }
    .rb__branch span { color: var(--muted); font-size: 8px; letter-spacing: .15em; }
    .rb__branch strong { margin: 6px 0 4px; font-size: 14px; font-weight: 500; }
    .rb__branch small { color: var(--muted); font-size: 8px; line-height: 1.45; }
    .rb__branch output { position: absolute; right: 10px; top: 10px; color: var(--hot); }
    .rb__branch:disabled { opacity: .25; cursor: not-allowed; }
    .rb__branch[data-emergent="true"] { box-shadow: 0 0 0 1px rgba(227,255,242,.35), 0 0 40px rgba(227,255,242,.04); }
    .rb__branch[aria-pressed="true"] { background: rgba(227,255,242,.08); }
    .rb__branch--matter { left: 7%; top: 12%; }
    .rb__branch--signal { right: 7%; top: 12%; }
    .rb__branch--observer { left: 7%; bottom: 12%; }
    .rb__branch--unknown { right: 7%; bottom: 12%; }
    .rb__branch--matter strong { color: var(--matter); }
    .rb__branch--signal strong { color: var(--signal); }
    .rb__branch--observer strong { color: var(--observer); }
    .rb__branch--unknown strong { color: var(--unknown); }

    .rb__center-copy { position: absolute; left: 50%; top: 50%; width: min(280px,38%); transform: translate(-50%,-50%); text-align: center; pointer-events: none; }
    .rb__center-copy span, .rb__center-copy strong { display: block; }
    .rb__center-copy span { color: var(--muted); font-size: 8px; letter-spacing: .14em; }
    .rb__center-copy strong { margin-top: 64px; color: var(--hot); font-size: 13px; font-weight: 500; letter-spacing: .12em; }
    .rb__center-copy p { margin: 7px auto 0; max-width: 38ch; color: var(--muted); font-size: 8px; line-height: 1.5; }

    .rb__decoder { margin-top: 18px; border: 1px solid var(--line); }
    .rb__decoder div { display: flex; justify-content: space-between; gap: 10px; padding: 9px; border-bottom: 1px solid var(--line); font-size: 8px; }
    .rb__decoder div:last-child { border-bottom: 0; }
    .rb__decoder span { color: var(--muted); }
    .rb__decoder strong { color: var(--hot); font-weight: 500; text-align: right; }
    .rb__note { padding-left: 10px; border-left: 2px solid var(--hot); }
    .rb__history { list-style: none; margin: 16px 0; padding: 0; display: grid; gap: 6px; }
    .rb__history li { padding: 8px; border: 1px solid var(--line); color: var(--muted); font-size: 8px; }
    .rb__history li div { display: flex; justify-content: space-between; color: var(--hot); }
    .rb__history li strong, .rb__history li small { display: block; }
    .rb__history li strong { margin: 4px 0; color: var(--ink); font-weight: 500; }
    .rb__return { display: block; margin-top: 18px; padding: 10px; border: 1px solid var(--line); color: var(--hot); text-decoration: none; }
    .rb__footer { grid-template-columns: 1fr auto; gap: 18px; padding: 0 18px; border-top: 1px solid var(--line); color: var(--muted); font-size: 7px; white-space: nowrap; }

    .rb[data-state="ALPHA"] { --hot: var(--matter); }
    .rb[data-state="BETA"] { --hot: var(--signal); }
    .rb[data-state="GAMMA"] { --hot: var(--observer); }
    .rb[data-state="OMEGA"] { --hot: var(--unknown); }
    .rb:not([data-state="LOCKED"]) .rb__core { animation: rb-rotate 22s linear infinite; }
    .rb[data-state="OMEGA"] .rb__mesh { animation: rb-drift 8s ease-in-out infinite alternate; }
    @keyframes rb-rotate { to { transform: translate(-50%,-50%) rotate(405deg); } }
    @keyframes rb-drift { to { transform: scale(1.04) rotate(.8deg); opacity: .38; } }

    @media (max-width: 980px) {
      :global(html), :global(body) { overflow: auto; }
      .rb { position: relative; height: auto; min-height: 100dvh; grid-template-rows: 54px auto 34px; }
      .rb__layout { grid-template-columns: 1fr; }
      .rb__field { min-height: 74dvh; order: -1; border-bottom: 1px solid var(--line); }
      .rb__panel--left { border-right: 0; border-bottom: 1px solid var(--line); }
      .rb__panel--right { border-left: 0; }
      .rb__topbar { grid-template-columns: auto 1fr auto; }
    }
    @media (max-width: 560px) {
      .rb__topbar { padding: 0 10px; gap: 8px; }
      .rb__topbar > div span { display: none; }
      .rb__field { min-height: 82dvh; }
      .rb__branch { width: 42%; min-height: 112px; }
      .rb__branch--matter, .rb__branch--observer { left: 4%; }
      .rb__branch--signal, .rb__branch--unknown { right: 4%; }
      .rb__center-copy { width: 45%; }
      .rb__center-copy strong { margin-top: 74px; font-size: 10px; }
      .rb__footer { padding: 0 10px; grid-template-columns: 1fr; overflow: hidden; }
      .rb__footer span:last-child { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .rb *, .rb *::before, .rb *::after { animation: none !important; transition: none !important; }
    }
  </style>
</Base>
