---
import Base from '../../../layouts/Base.astro';
---

<Base
  title="KODEX Lab — SOL / Latent → Form"
  description="Experimental KODEX convergence proof: one latent potential, multiple explicit multimodal manifestations."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="kdx-sol" data-kdx-sol data-state="LATENT" data-modality="TEXT">
    <canvas class="kdx-sol__field" data-sol-canvas aria-hidden="true"></canvas>
    <div class="kdx-sol__veil" aria-hidden="true"></div>

    <header class="kdx-sol__top">
      <div>
        <p>KDX://LATENT/001</p>
        <strong>KODEX−∞</strong>
      </div>
      <div class="kdx-sol__top-meta">
        <span>EXPERIMENT · NOT CANON RUNTIME</span>
        <span>ONE POTENTIAL / MULTIPLE FORMS</span>
      </div>
    </header>

    <section
      class="kdx-sol__core"
      data-sol-core
      role="button"
      tabindex="0"
      aria-label="Observe SOL. Hold to commit the active manifestation. Use arrow keys or number keys 1 through 6 to change modality."
    >
      <div class="kdx-sol__axis" aria-hidden="true"></div>
      <div class="kdx-sol__orb" aria-hidden="true">
        <i></i><i></i><i></i>
      </div>

      <div class="kdx-sol__copy">
        <span data-state-label>STATE · LATENT</span>
        <h1 data-form-title>ONE POTENTIAL.</h1>
        <p data-form-subtitle>MANY FORMS.</p>
        <small data-instruction>HOLD TO OBSERVE</small>
      </div>
    </section>

    <aside class="kdx-sol__left">
      <p>POTENTIAL PRECEDES THE FORM.</p>
      <dl>
        <div><dt>NODE</dt><dd>KDX-LATENT-SOL</dd></div>
        <div><dt>OBSERVER</dt><dd>PRESENT</dd></div>
        <div><dt>MEMORY</dt><dd data-memory-count>0 EVENTS</dd></div>
        <div><dt>RETURN</dt><dd data-return-count>0</dd></div>
      </dl>
    </aside>

    <aside class="kdx-sol__right">
      <p>A UNIFIED FIELD OF MANIFESTATION.</p>
      <div class="kdx-sol__boundary">
        <span>QUANTUM-LIKE</span>
        <b>COMPUTATIONAL / ARTISTIC</b>
        <small>NO PHYSICAL QUANTUM OR CONSCIOUSNESS-MEASUREMENT CLAIM</small>
      </div>
      <button type="button" class="kdx-sol__sound" data-sound-toggle aria-pressed="false">
        SOUND · OFF
      </button>
    </aside>

    <nav class="kdx-sol__modalities" aria-label="SOL manifestations">
      <button type="button" data-modality-button="TEXT" aria-pressed="true"><span>01</span><b>TEXT</b><small>LANGUAGE</small></button>
      <button type="button" data-modality-button="IMAGE" aria-pressed="false"><span>02</span><b>IMAGE</b><small>VISUAL</small></button>
      <button type="button" data-modality-button="SOUND" aria-pressed="false"><span>03</span><b>SOUND</b><small>AUDITORY</small></button>
      <button type="button" data-modality-button="TOUCH" aria-pressed="false"><span>04</span><b>TOUCH</b><small>TACTILE</small></button>
      <button type="button" data-modality-button="MOTION" aria-pressed="false"><span>05</span><b>MOTION</b><small>DYNAMIC</small></button>
      <button type="button" data-modality-button="SIMULATION" aria-pressed="false"><span>06</span><b>SIMULATION</b><small>RELATIONAL</small></button>
    </nav>

    <footer class="kdx-sol__footer">
      <span data-probability>FIELD · READY</span>
      <span>EXPLICIT ACTION ONLY · SESSION MEMORY · NO PROFILE</span>
      <a href="/kodex/lab/">LAB INDEX ↗</a>
    </footer>
  </main>
</Base>

<script>
  import {
    KDX_SOL_MODALITIES,
    appendSolMemory,
    chooseSolManifestation,
    projectSolVisualState,
    sanitizeSolMemory,
  } from '../../../lib/kodex/latent-potential.js';

  const root = document.querySelector('[data-kdx-sol]');
  const canvas = root?.querySelector('[data-sol-canvas]');
  const core = root?.querySelector('[data-sol-core]');
  const storageKey = 'kdx:sol:v0';

  if (root && canvas instanceof HTMLCanvasElement && core instanceof HTMLElement) {
    const ctx = canvas.getContext('2d', { alpha: false });
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = (selector) => root.querySelector(selector);
    const buttons = [...root.querySelectorAll('[data-modality-button]')];
    const loadMemory = () => {
      try {
        return sanitizeSolMemory(JSON.parse(sessionStorage.getItem(storageKey) || 'null'));
      } catch {
        return sanitizeSolMemory(null);
      }
    };

    const state = {
      modality: 'TEXT',
      phase: 'LATENT',
      pointerX: 0.5,
      pointerY: 0.5,
      velocity: 0,
      holdStartedAt: 0,
      holdMs: 0,
      holding: false,
      soundEnabled: false,
      audio: null,
      memory: loadMemory(),
      particles: [],
      raf: 0,
      lastFrame: performance.now(),
      lastPointer: null,
    };

    state.memory.visitCount += 1;
    if (state.memory.visitCount > 1) {
      state.memory = appendSolMemory(state.memory, { modalityId: state.modality, action: 'RETURN' });
    }
    sessionStorage.setItem(storageKey, JSON.stringify(state.memory));

    const copyByModality = {
      TEXT: ['ONE POTENTIAL.', 'MANY FORMS.', 'LANGUAGE IS ONE PROJECTION'],
      IMAGE: ['FORM EMERGES.', 'THE FIELD BECOMES VISIBLE.', 'MOVE TO DISTURB THE IMAGE'],
      SOUND: ['SIGNAL BECOMES FREQUENCY.', 'LISTEN ONLY BY CHOICE.', 'ENABLE SOUND · THEN HOLD'],
      TOUCH: ['CONTACT CHANGES STATE.', 'THE BODY ENTERS THE LOOP.', 'HOLD · RELEASE · FEEL'],
      MOTION: ['MOVEMENT REWRITES THE FIELD.', 'CONTEXT IS TEMPORAL.', 'MOVE THROUGH THE POTENTIAL'],
      SIMULATION: ['ONE NODE. MANY RELATIONS.', 'THE MODEL DOES NOT END AT FORM.', 'TRACE THE NEXT POSSIBLE STATE'],
    };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 1.6);
      canvas.width = Math.max(1, Math.floor(innerWidth * dpr));
      canvas.height = Math.max(1, Math.floor(innerHeight * dpr));
      canvas.style.width = innerWidth + 'px';
      canvas.style.height = innerHeight + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      buildParticles();
      if (reduced) render(performance.now());
    };

    const seeded = (index) => {
      const value = Math.sin(index * 91.735 + state.memory.visitCount * 17.17) * 43758.5453;
      return value - Math.floor(value);
    };

    const buildParticles = () => {
      const count = reduced ? 130 : Math.min(360, Math.floor(innerWidth * innerHeight / 3600));
      state.particles = Array.from({ length: count }, (_, index) => ({
        r: 0.05 + seeded(index + 2) * 0.46,
        a: seeded(index + 17) * Math.PI * 2,
        jitter: seeded(index + 31),
        phase: seeded(index + 53) * Math.PI * 2,
        weight: 0.25 + seeded(index + 71) * 0.75,
      }));
    };

    const context = () => ({
      x: state.pointerX,
      y: state.pointerY,
      holdMs: state.holdMs,
      velocity: state.velocity,
      returnCount: Math.max(0, state.memory.visitCount - 1),
    });

    const setPhase = (phase) => {
      state.phase = phase;
      root.dataset.state = phase;
      const label = $('[data-state-label]');
      if (label) label.textContent = 'STATE · ' + phase;
    };

    const syncReadout = () => {
      const memoryCount = $('[data-memory-count]');
      const returnCount = $('[data-return-count]');
      if (memoryCount) memoryCount.textContent = state.memory.events.length + ' EVENTS';
      if (returnCount) returnCount.textContent = String(Math.max(0, state.memory.visitCount - 1));
    };

    const setModality = (id, { record = true } = {}) => {
      if (!KDX_SOL_MODALITIES.some((item) => item.id === id)) return;
      state.modality = id;
      root.dataset.modality = id;
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.modalityButton === id)));
      const [title, subtitle, instruction] = copyByModality[id];
      $('[data-form-title]').textContent = title;
      $('[data-form-subtitle]').textContent = subtitle;
      $('[data-instruction]').textContent = instruction;

      const candidate = chooseSolManifestation(context(), []);
      $('[data-probability]').textContent = 'FIELD · ' + candidate.id + ' · ' + candidate.score.toFixed(3);

      if (record) {
        state.memory = appendSolMemory(state.memory, { modalityId: id, action: 'SELECT' });
        sessionStorage.setItem(storageKey, JSON.stringify(state.memory));
        syncReadout();
      }

      updateAudio();
      if (reduced) render(performance.now());
    };

    const ensureAudio = () => {
      if (state.audio) return state.audio;
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      if (!AudioContext) return null;
      const audioContext = new AudioContext();
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();
      oscillator.type = 'sine';
      oscillator.frequency.value = 110;
      gain.gain.value = 0;
      oscillator.connect(gain).connect(audioContext.destination);
      oscillator.start();
      state.audio = { audioContext, oscillator, gain };
      return state.audio;
    };

    const updateAudio = () => {
      const audio = state.audio;
      if (!audio) return;
      const active = state.soundEnabled && state.modality === 'SOUND' && state.holding;
      const now = audio.audioContext.currentTime;
      const frequency = 92 + state.pointerX * 260 + Math.min(1, state.holdMs / 1600) * 120;
      audio.oscillator.frequency.cancelScheduledValues(now);
      audio.oscillator.frequency.linearRampToValueAtTime(frequency, now + 0.05);
      audio.gain.gain.cancelScheduledValues(now);
      audio.gain.gain.linearRampToValueAtTime(active ? 0.035 : 0, now + 0.08);
    };

    const commit = () => {
      const candidate = chooseSolManifestation(context(), []);
      setModality(candidate.id, { record: false });
      state.memory = appendSolMemory(state.memory, { modalityId: state.modality, action: 'HOLD_COMMIT' });
      sessionStorage.setItem(storageKey, JSON.stringify(state.memory));
      syncReadout();
      setPhase('COMMITTED');

      if (state.modality === 'TOUCH' && 'vibrate' in navigator) navigator.vibrate?.([20, 35, 40]);
      window.setTimeout(() => {
        if (!state.holding) setPhase('RETURN');
      }, reduced ? 0 : 360);
    };

    const beginHold = () => {
      state.holding = true;
      state.holdStartedAt = performance.now();
      state.holdMs = 0;
      setPhase('AWARE');
      updateAudio();
    };

    const endHold = () => {
      if (!state.holding) return;
      state.holdMs = performance.now() - state.holdStartedAt;
      state.holding = false;
      if (state.holdMs >= 520) commit();
      else setPhase('LATENT');
      updateAudio();
    };

    const pointerMove = (event) => {
      const rect = core.getBoundingClientRect();
      const x = Math.max(0, Math.min(1, (event.clientX - rect.left) / Math.max(1, rect.width)));
      const y = Math.max(0, Math.min(1, (event.clientY - rect.top) / Math.max(1, rect.height)));
      if (state.lastPointer) {
        const dx = x - state.lastPointer.x;
        const dy = y - state.lastPointer.y;
        state.velocity = Math.min(1.8, Math.hypot(dx, dy) * 22);
      }
      state.lastPointer = { x, y };
      state.pointerX = x;
      state.pointerY = y;
      if (reduced) render(performance.now());
      updateAudio();
    };

    const render = (now) => {
      const w = innerWidth;
      const h = innerHeight;
      const cx = w * 0.5;
      const cy = h * 0.47;
      const min = Math.min(w, h);
      const visual = projectSolVisualState(state.modality, context());
      const time = reduced ? 0 : now * 0.00018;

      ctx.fillStyle = '#050505';
      ctx.fillRect(0, 0, w, h);

      const gradient = ctx.createRadialGradient(cx, cy, min * 0.02, cx, cy, min * 0.43);
      gradient.addColorStop(0, 'rgba(255,39,51,.32)');
      gradient.addColorStop(0.22, 'rgba(115,0,12,.2)');
      gradient.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, w, h);

      ctx.save();
      ctx.translate(cx, cy);
      ctx.globalCompositeOperation = 'lighter';

      const baseRadius = min * 0.34 * visual.particleScale;
      for (let i = 0; i < state.particles.length; i += 1) {
        const p = state.particles[i];
        const orbit = time * visual.orbit * (0.6 + p.jitter);
        const wave = Math.sin(time * 7 + p.phase + state.holdMs * 0.004) * visual.pulse;
        const angle = p.a + orbit + (state.pointerX - 0.5) * 0.42;
        const radial = baseRadius * p.r * (0.74 + wave * 0.14 + visual.intensity * 0.1);
        const squeeze = 0.52 + Math.abs(state.pointerY - 0.5) * 0.42;
        const x = Math.cos(angle) * radial;
        const y = Math.sin(angle * (1 + visual.radialPull * 0.08)) * radial * squeeze;
        const mirror = i % 2 === 0 ? 1 : -1;
        const px = x * mirror;
        const alpha = 0.12 + p.weight * 0.5 + visual.intensity * 0.1;
        const size = 0.45 + p.weight * 1.15;

        ctx.fillStyle = 'rgba(255,48,61,' + Math.min(0.72, alpha) + ')';
        ctx.beginPath();
        ctx.arc(px, y, size, 0, Math.PI * 2);
        ctx.fill();

        if (i % 13 === 0) {
          ctx.strokeStyle = 'rgba(255,80,90,' + visual.lineAlpha + ')';
          ctx.lineWidth = 0.45;
          ctx.beginPath();
          ctx.moveTo(0, 0);
          ctx.lineTo(px, y);
          ctx.stroke();
        }
      }

      ctx.strokeStyle = 'rgba(237,237,237,.16)';
      ctx.lineWidth = 0.6;
      const ring = min * (0.19 + visual.intensity * 0.055);
      ctx.beginPath();
      ctx.ellipse(0, 0, ring, ring * 0.45, time * 0.2, 0, Math.PI * 2);
      ctx.stroke();
      ctx.beginPath();
      ctx.ellipse(0, 0, ring * 0.72, ring * 0.72, -time * 0.25, 0, Math.PI * 2);
      ctx.stroke();

      ctx.fillStyle = 'rgba(255,235,235,.95)';
      ctx.beginPath();
      ctx.arc(0, 0, 1.4 + visual.intensity * 2.6, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      if (state.holding) {
        state.holdMs = now - state.holdStartedAt;
        if (state.holdMs > 520 && state.phase !== 'OPEN') setPhase('OPEN');
        updateAudio();
      }

      state.velocity *= 0.9;
      state.lastFrame = now;
      if (!reduced) state.raf = requestAnimationFrame(render);
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => setModality(button.dataset.modalityButton));
    });

    core.addEventListener('pointerdown', (event) => {
      core.setPointerCapture?.(event.pointerId);
      pointerMove(event);
      beginHold();
    });
    core.addEventListener('pointermove', pointerMove, { passive: true });
    core.addEventListener('pointerup', endHold);
    core.addEventListener('pointercancel', endHold);
    core.addEventListener('pointerleave', () => {
      if (!state.holding) setPhase('LATENT');
    });

    core.addEventListener('keydown', (event) => {
      const index = Number(event.key) - 1;
      if (index >= 0 && index < KDX_SOL_MODALITIES.length) {
        event.preventDefault();
        setModality(KDX_SOL_MODALITIES[index].id);
        return;
      }
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        const current = KDX_SOL_MODALITIES.findIndex((item) => item.id === state.modality);
        const delta = event.key === 'ArrowRight' ? 1 : -1;
        const next = (current + delta + KDX_SOL_MODALITIES.length) % KDX_SOL_MODALITIES.length;
        setModality(KDX_SOL_MODALITIES[next].id);
        return;
      }
      if ((event.key === 'Enter' || event.key === ' ') && !state.holding) {
        event.preventDefault();
        beginHold();
      }
    });
    core.addEventListener('keyup', (event) => {
      if ((event.key === 'Enter' || event.key === ' ') && state.holding) {
        event.preventDefault();
        endHold();
      }
    });

    $('[data-sound-toggle]')?.addEventListener('click', async (event) => {
      const audio = ensureAudio();
      if (!audio) {
        event.currentTarget.textContent = 'SOUND · UNAVAILABLE';
        return;
      }
      if (audio.audioContext.state === 'suspended') await audio.audioContext.resume();
      state.soundEnabled = !state.soundEnabled;
      event.currentTarget.setAttribute('aria-pressed', String(state.soundEnabled));
      event.currentTarget.textContent = state.soundEnabled ? 'SOUND · ON' : 'SOUND · OFF';
      updateAudio();
    });

    addEventListener('resize', resize, { passive: true });
    syncReadout();
    setModality('TEXT', { record: false });
    resize();
    if (!reduced) state.raf = requestAnimationFrame(render);

    window.__KDX_SOL_V0__ = {
      latent: 'KDX-LATENT-SOL',
      get state() {
        return {
          phase: state.phase,
          modality: state.modality,
          memory: state.memory,
          boundaries: {
            readsConsciousness: false,
            physicalQuantumClaim: false,
            hiddenPsychologicalInference: false,
          },
        };
      },
    };
  }
</script>

<style>
  :global(body) {
    margin: 0;
    overflow: hidden;
    background: #050505;
    color: #ededed;
    font-family: 'Inter Tight', system-ui, sans-serif;
  }

  .kdx-sol {
    --signal: #ff2733;
    position: relative;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
    background: #050505;
    color: #ededed;
    isolation: isolate;
  }

  .kdx-sol__field,
  .kdx-sol__veil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .kdx-sol__field {
    display: block;
  }

  .kdx-sol__veil {
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent 0 49.96%, rgba(237,237,237,.11) 50%, transparent 50.04%),
      radial-gradient(circle at 50% 47%, transparent 0 26%, rgba(0,0,0,.12) 53%, rgba(0,0,0,.92) 100%),
      repeating-linear-gradient(0deg, rgba(255,255,255,.018) 0 1px, transparent 1px 4px);
    z-index: 1;
  }

  .kdx-sol__top,
  .kdx-sol__footer,
  .kdx-sol__left,
  .kdx-sol__right,
  .kdx-sol__modalities,
  .kdx-sol__core {
    position: absolute;
    z-index: 3;
  }

  .kdx-sol__top {
    top: 0;
    left: 0;
    right: 0;
    min-height: 66px;
    padding: 17px clamp(18px, 4vw, 52px);
    display: flex;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid rgba(237,237,237,.12);
    background: linear-gradient(180deg, rgba(5,5,5,.84), rgba(5,5,5,0));
    box-sizing: border-box;
  }

  .kdx-sol__top p,
  .kdx-sol__top-meta,
  .kdx-sol__left,
  .kdx-sol__right,
  .kdx-sol__footer,
  .kdx-sol__modalities {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
  }

  .kdx-sol__top p {
    margin: 0 0 6px;
    font-size: 8px;
    letter-spacing: .24em;
    color: #88888a;
  }

  .kdx-sol__top strong {
    font-family: 'Barlow Condensed', 'Inter Tight', system-ui, sans-serif;
    font-size: 23px;
    line-height: 1;
    letter-spacing: .09em;
    font-weight: 500;
  }

  .kdx-sol__top-meta {
    display: grid;
    align-content: start;
    gap: 5px;
    text-align: right;
    font-size: 7px;
    letter-spacing: .18em;
    color: #88888a;
  }

  .kdx-sol__core {
    inset: 74px 17vw 178px;
    display: grid;
    place-items: center;
    cursor: crosshair;
    touch-action: none;
    outline: none;
  }

  .kdx-sol__core:focus-visible {
    box-shadow: inset 0 0 0 1px rgba(255,39,51,.52);
  }

  .kdx-sol__axis {
    position: absolute;
    width: min(62vmin, 690px);
    aspect-ratio: 1;
    border: 1px solid rgba(255,39,51,.17);
    border-radius: 50%;
    pointer-events: none;
  }

  .kdx-sol__axis::before,
  .kdx-sol__axis::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    background: rgba(237,237,237,.13);
    transform: translate(-50%,-50%);
  }

  .kdx-sol__axis::before { width: 112%; height: 1px; }
  .kdx-sol__axis::after { width: 1px; height: 112%; }

  .kdx-sol__orb {
    width: min(42vmin, 460px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(237,237,237,.12);
    display: grid;
    place-items: center;
    pointer-events: none;
    transition: transform .55s cubic-bezier(.2,.7,.2,1), border-color .55s;
  }

  .kdx-sol[data-state="AWARE"] .kdx-sol__orb { transform: scale(1.04); border-color: rgba(255,39,51,.32); }
  .kdx-sol[data-state="OPEN"] .kdx-sol__orb { transform: scale(1.1); border-color: rgba(255,39,51,.58); }
  .kdx-sol[data-state="COMMITTED"] .kdx-sol__orb { transform: scale(.94); border-color: rgba(237,237,237,.55); }

  .kdx-sol__orb i {
    position: absolute;
    border: 1px solid rgba(237,237,237,.13);
    border-radius: 50%;
  }
  .kdx-sol__orb i:nth-child(1) { width: 72%; height: 34%; }
  .kdx-sol__orb i:nth-child(2) { width: 34%; height: 72%; }
  .kdx-sol__orb i:nth-child(3) { width: 8px; height: 8px; background: var(--signal); border-color: var(--signal); box-shadow: 0 0 28px rgba(255,39,51,.72); }

  .kdx-sol__copy {
    position: absolute;
    bottom: 4%;
    left: 50%;
    width: min(720px, 88%);
    transform: translateX(-50%);
    text-align: center;
    pointer-events: none;
  }

  .kdx-sol__copy span,
  .kdx-sol__copy small {
    display: block;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 8px;
    letter-spacing: .22em;
    color: #88888a;
  }

  .kdx-sol__copy h1,
  .kdx-sol__copy p {
    margin: 0;
    font-family: 'Barlow Condensed', 'Inter Tight', system-ui, sans-serif;
    text-transform: uppercase;
  }

  .kdx-sol__copy h1 {
    margin-top: 9px;
    font-size: clamp(2.8rem, 7vw, 7rem);
    line-height: .86;
    font-weight: 400;
    letter-spacing: .015em;
  }

  .kdx-sol__copy p {
    margin: 4px 0 14px;
    font-size: clamp(1.15rem, 2.2vw, 2rem);
    letter-spacing: .11em;
    color: rgba(237,237,237,.74);
  }

  .kdx-sol__left,
  .kdx-sol__right {
    top: 118px;
    width: min(220px, 16vw);
    font-size: 8px;
    line-height: 1.7;
    letter-spacing: .14em;
    color: #88888a;
  }

  .kdx-sol__left { left: clamp(18px, 4vw, 52px); }
  .kdx-sol__right { right: clamp(18px, 4vw, 52px); }

  .kdx-sol__left > p,
