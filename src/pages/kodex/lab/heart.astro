---
/**
 * KODEX−∞ · ESCENA 03 · HEART / NODE M — el lab
 *
 * La escena no existía en ninguna forma. Entra como lab —igual que Observe V2,
 * que es el precedente: construir acá, promover al corredor cuando el creador
 * la mire—. `noindex` hasta entonces.
 *
 * Todo el copy visible sale de la definición de escena. La frase única de esta
 * escena es la regla que la gobierna: THE HEART DOES NOT SCORE. IT ORIENTS.
 */
import Base from '../../../layouts/Base.astro';
import { HEART, CAMINOS } from '../../../lib/kodex/escenas/heart';
---

<Base
  title="KODEX Lab — Heart / Node M"
  description="Private KODEX Heart orientation lab."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <section class="kdx-heart" data-kdx-heart data-state="quiet">
    <header class="kdx-heart__header">
      <a class="kdx-heart__logo" href="/kodex/">KODEX−∞</a>
      <div class="kdx-heart__meta">
        <span>SCENE 03 / HEART · NODE M</span>
        <span>KDX://ORIENTATION/CONVERGENCE</span>
      </div>
    </header>

    <div class="kdx-heart__stage">
      <canvas class="kdx-heart__canvas" data-kdx-heart-canvas aria-hidden="true"></canvas>

      <div class="kdx-heart__body">
        <p class="kdx-heart__kicker">INSTRUMENT / ORIENTATION / NODE M</p>
        <h1 class="kdx-heart__headline">{HEART.copy.orientation}</h1>
        <p class="kdx-heart__lede">
          Your route appears around the heart. Nothing is missing. Nothing is
          scored. Choose where to go — every path is equal.
        </p>

        <div class="kdx-heart__actions">
          <button class="kdx-heart__btn" type="button" data-kdx-review aria-expanded="false">
            REVIEW THE ROUTE
          </button>
          <button class="kdx-heart__btn kdx-heart__btn--ghost" type="button" data-kdx-breath aria-pressed="false">
            BREATH-PACED MODE
          </button>
          <button class="kdx-heart__btn kdx-heart__btn--ghost" type="button" data-kdx-anchor aria-pressed="false">
            ANCHOR RETURN HERE
          </button>
        </div>

        <div class="kdx-heart__review" data-kdx-route-review hidden>
          <p class="kdx-heart__review-title">THE ROUTE, AS IT HAPPENED</p>
          <ul class="kdx-heart__route" data-kdx-route-list></ul>
        </div>

        <nav class="kdx-heart__paths" aria-label="paths from the heart">
          {CAMINOS.map((c) => (
            <a class="kdx-heart__path" href={c.ruta} data-kdx-path>
              <strong>{c.nombre}</strong>
              <span>{c.detalle}</span>
            </a>
          ))}
        </nav>
      </div>
    </div>

    <footer class="kdx-heart__footer">
      <span>{HEART.node_id}</span>
      <span>STATE · <em data-kdx-state-readout>QUIET</em></span>
      <span>PULSE IS SYMBOL, NOT BIOMETRICS</span>
    </footer>
  </section>
</Base>

<style>
  .kdx-heart{
    min-height:100vh; min-height:100dvh; display:flex; flex-direction:column;
    background:#0a0a0a; color:#f0ede8;
    font-family:'IBM Plex Mono',ui-monospace,monospace;
  }
  .kdx-heart__header{
    display:flex; justify-content:space-between; align-items:center; gap:16px;
    padding:clamp(14px,2.4vh,22px) clamp(18px,3.4vw,44px);
    border-bottom:1px solid rgba(240,237,232,.1);
  }
  .kdx-heart__logo{ color:#f0ede8; text-decoration:none; letter-spacing:.18em; font-size:14px; }
  .kdx-heart__meta{ display:flex; gap:18px; font-size:10px; letter-spacing:.16em; color:rgba(240,237,232,.45); }
  .kdx-heart__stage{ position:relative; flex:1; display:grid; place-items:center; overflow:hidden; }
  .kdx-heart__canvas{
    position:absolute; inset:0; width:100%; height:100%;
    /* La memoria ahonda también la presencia del campo. */
    opacity:calc(.55 + var(--kdx-memoria,0) * .35);
  }
  .kdx-heart__body{
    position:relative; z-index:1; max-width:560px; padding:clamp(22px,4vh,44px) clamp(18px,4vw,32px);
    display:flex; flex-direction:column; align-items:center; text-align:center; gap:clamp(12px,2vh,18px);
  }
  .kdx-heart__kicker{ margin:0; font-size:10px; letter-spacing:.24em; color:#c9a84c; }
  .kdx-heart__headline{
    margin:0; font-family:'Cormorant Garamond',Georgia,serif; font-weight:400;
    font-size:clamp(26px,3.6vw,44px); line-height:1.14; letter-spacing:.01em; text-wrap:balance;
  }
  .kdx-heart__lede{ margin:0; max-width:44ch; font-size:12px; line-height:1.7; letter-spacing:.06em; color:rgba(240,237,232,.62); }
  .kdx-heart__actions{ display:flex; flex-wrap:wrap; justify-content:center; gap:10px; }
  .kdx-heart__btn{
    min-height:40px; padding:0 18px; cursor:pointer;
    background:rgba(201,168,76,.1); color:#f0ede8;
    border:1px solid rgba(201,168,76,.5); font:inherit; font-size:10px; letter-spacing:.2em;
    transition:background .2s ease, color .2s ease;
  }
  .kdx-heart__btn:hover{ background:#c9a84c; color:#0a0a0a; }
  .kdx-heart__btn--ghost{ background:transparent; border-color:rgba(240,237,232,.25); }
  .kdx-heart__btn--ghost:hover{ background:rgba(240,237,232,.9); color:#0a0a0a; }
  .kdx-heart__btn[aria-pressed="true"]{ background:#c9a84c; color:#0a0a0a; border-color:#c9a84c; }
  .kdx-heart__review{ width:100%; border:1px solid rgba(240,237,232,.14); padding:14px 16px; text-align:left; }
  .kdx-heart__review-title{ margin:0 0 8px; font-size:9.5px; letter-spacing:.2em; color:rgba(240,237,232,.45); }
  .kdx-heart__route{ margin:0; padding:0; list-style:none; max-height:180px; overflow-y:auto;
    font-size:10.5px; line-height:2; letter-spacing:.08em; color:rgba(240,237,232,.72); }
  .kdx-heart__paths{ display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; width:100%; }
  .kdx-heart__path{
    display:flex; flex-direction:column; gap:4px; padding:12px 14px; text-align:left; text-decoration:none;
    border:1px solid rgba(240,237,232,.16); color:#f0ede8;
    transition:border-color .2s ease, background .2s ease;
  }
  .kdx-heart__path:hover{ border-color:#c9a84c; background:rgba(201,168,76,.07); }
  .kdx-heart__path strong{ font-size:11px; letter-spacing:.18em; font-weight:600; }
  .kdx-heart__path span{ font-size:9.5px; letter-spacing:.06em; color:rgba(240,237,232,.5); line-height:1.5; }
  .kdx-heart__footer{
    display:flex; flex-wrap:wrap; justify-content:space-between; gap:10px;
    padding:12px clamp(18px,3.4vw,44px); border-top:1px solid rgba(240,237,232,.1);
    font-size:9.5px; letter-spacing:.16em; color:rgba(240,237,232,.4);
  }
  .kdx-heart__footer em{ font-style:normal; color:#c9a84c; }
  @media (max-width:560px){
    .kdx-heart__meta{ display:none; }
    .kdx-heart__paths{ grid-template-columns:1fr 1fr; }
  }
</style>

<script>
  import { montarHeart } from '../../../lib/kodex/escenas/heart-cliente';
  const raiz = document.querySelector('[data-kdx-heart]');
  if (raiz instanceof HTMLElement) {
    montarHeart(raiz);
    /* El pie lee el estado que el enganche publica. */
    const out = document.querySelector('[data-kdx-state-readout]');
    if (out) {
      new MutationObserver(() => {
        out.textContent = (raiz.dataset.state || 'quiet').toUpperCase();
      }).observe(raiz, { attributes: true, attributeFilter: ['data-state'] });
    }
  }
</script>
