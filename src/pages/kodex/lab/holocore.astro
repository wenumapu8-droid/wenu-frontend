---
import Base from '../../../layouts/Base.astro';
import KodexHoloCore from '../../../components/kodex/holocore/KodexHoloCore.astro';
---

<Base
  title="KODEX−∞ · HoloCore Lab"
  description="Internal KODEX lab prototype for a bounded, signal-resolved, seamless-loop concept viewport."
  robots="noindex, nofollow"
  kodexFonts={true}
  noNav={true}
  noFooter={true}
  noOverlays={true}
  noQuote={true}
  noThemes={true}
  noKai={true}
  noCart={true}
  noImmersive={true}
>
  <main class="holocore-lab" aria-labelledby="holocore-title">
    <header class="holocore-lab__header">
      <div>
        <p class="holocore-lab__eyebrow">KODEX−∞ // SYSTEMS LAB // PROTOTYPE 0.1</p>
        <h1 id="holocore-title">HOLOCORE</h1>
      </div>
      <div class="holocore-lab__status" aria-label="prototype status">
        <span>CONCEPT</span><strong>ORBITAL CITY</strong>
        <span>RENDER</span><strong>PROCEDURAL ASCII</strong>
        <span>STATE</span><strong>LAB / NOINDEX</strong>
      </div>
    </header>

    <aside class="holocore-lab__rail holocore-lab__rail--left" aria-label="HoloCore thesis">
      <span class="holocore-lab__rail-index">06 / ∞</span>
      <div>
        <p class="holocore-lab__micro">THESIS</p>
        <p class="holocore-lab__vertical-copy">THE FORM DOES NOT APPEAR. IT RESOLVES.</p>
      </div>
    </aside>

    <section class="holocore-lab__core" aria-label="HoloCore visual emulator">
      <KodexHoloCore
        id="orbital-city-holocore"
        specimen="orbital-city"
        profile="balanced"
        accent="#a06cff"
        label="Procedural ASCII holographic visualization of an exploded orbital city, continuously resolving inside a bounded KODEX viewport"
      />
    </section>

    <aside class="holocore-lab__rail holocore-lab__rail--right" aria-label="HoloCore behavior contract">
      <dl>
        <div><dt>BOUNDARY</dt><dd>CONTAINED</dd></div>
        <div><dt>CYCLE</dt><dd>24.00 S</dd></div>
        <div><dt>MODE</dt><dd>ASCII FIELD</dd></div>
        <div><dt>INPUT</dt><dd>POINTER</dd></div>
        <div><dt>MOTION</dt><dd>AMBIENT</dd></div>
        <div><dt>REDUCED</dt><dd>STATIC PHASE</dd></div>
      </dl>
    </aside>

    <footer class="holocore-lab__footer">
      <p><span>01</span> SIGNAL</p>
      <p><span>02</span> SAMPLE</p>
      <p><span>03</span> RESOLVE</p>
      <p><span>04</span> LOOP</p>
      <strong>KODEX DOES NOT DISPLAY THE OBJECT. IT MATERIALIZES A READING OF IT.</strong>
    </footer>
  </main>
</Base>

<style is:global>
  html:has(.holocore-lab),
  body:has(.holocore-lab) {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow: hidden;
    background: #020204;
  }
</style>

<style>
  .holocore-lab {
    --lab-line: rgba(188, 151, 255, .23);
    --lab-muted: rgba(230, 221, 240, .49);
    box-sizing: border-box;
    width: 100%;
    height: 100dvh;
    display: grid;
    grid-template-columns: clamp(58px, 7vw, 92px) minmax(0, 1fr) clamp(72px, 9vw, 126px);
    grid-template-rows: clamp(76px, 10vh, 112px) minmax(0, 1fr) clamp(62px, 8vh, 88px);
    grid-template-areas:
      "header header header"
      "left core right"
      "footer footer footer";
    gap: 0;
    padding: 12px;
    color: #eeeaf2;
    background:
      radial-gradient(circle at 50% 48%, rgba(93, 57, 134, .08), transparent 42%),
      #020204;
    font-family: 'Share Tech Mono', ui-monospace, monospace;
    overflow: hidden;
  }

  .holocore-lab::before {
    content: '';
    position: fixed;
    inset: 7px;
    pointer-events: none;
    border: 1px solid rgba(255,255,255,.09);
    box-shadow: inset 0 0 0 1px rgba(160,108,255,.04);
  }

  .holocore-lab__header {
    grid-area: header;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-width: 0;
    padding: 0 clamp(12px, 2vw, 28px);
    border-bottom: 1px solid var(--lab-line);
  }

  .holocore-lab__eyebrow,
  .holocore-lab__micro {
    margin: 0;
    font-size: 9px;
    letter-spacing: .18em;
    color: var(--lab-muted);
  }

  .holocore-lab h1 {
    margin: 4px 0 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-size: clamp(34px, 5vw, 72px);
    font-weight: 400;
    line-height: .86;
    letter-spacing: .13em;
  }

  .holocore-lab__status {
    display: grid;
    grid-template-columns: auto auto;
    gap: 5px 16px;
    align-items: baseline;
    font-size: 8px;
    letter-spacing: .1em;
  }

  .holocore-lab__status span { color: var(--lab-muted); }
  .holocore-lab__status strong { font-weight: 500; color: #bda1e6; }

  .holocore-lab__rail {
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12px 8px;
    color: var(--lab-muted);
    overflow: hidden;
  }

  .holocore-lab__rail--left {
    grid-area: left;
    border-right: 1px solid var(--lab-line);
  }

  .holocore-lab__rail--right {
    grid-area: right;
    border-left: 1px solid var(--lab-line);
    justify-content: center;
  }

  .holocore-lab__rail-index {
    font-size: 9px;
    letter-spacing: .15em;
  }

  .holocore-lab__vertical-copy {
    margin: 12px 0 0;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 9px;
    letter-spacing: .16em;
    color: rgba(222,211,237,.64);
  }

  .holocore-lab__rail dl {
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .holocore-lab__rail dl div {
    display: grid;
    gap: 3px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255,255,255,.06);
  }

  .holocore-lab__rail dt,
  .holocore-lab__rail dd {
    margin: 0;
    font-size: 7px;
    line-height: 1.2;
    letter-spacing: .08em;
  }
  .holocore-lab__rail dt { color: rgba(231,224,239,.34); }
  .holocore-lab__rail dd { color: rgba(193,160,235,.76); }

  .holocore-lab__core {
    grid-area: core;
    min-width: 0;
    min-height: 0;
    padding: clamp(8px, 1.4vw, 18px);
  }

  .holocore-lab__footer {
    grid-area: footer;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(4, auto) minmax(0, 1fr);
    align-items: center;
    gap: clamp(10px, 2vw, 28px);
    padding: 0 clamp(12px, 2vw, 28px);
    border-top: 1px solid var(--lab-line);
  }

  .holocore-lab__footer p,
  .holocore-lab__footer strong {
    margin: 0;
    font-size: 8px;
    line-height: 1.2;
    letter-spacing: .12em;
    font-weight: 500;
  }

  .holocore-lab__footer p { color: var(--lab-muted); }
  .holocore-lab__footer p span { color: #a06cff; }
  .holocore-lab__footer strong {
    justify-self: end;
    text-align: right;
    max-width: 520px;
    color: rgba(236,230,243,.68);
  }

  @media (max-width: 720px) {
    .holocore-lab {
      grid-template-columns: 36px minmax(0, 1fr) 48px;
      grid-template-rows: 78px minmax(0, 1fr) 58px;
      padding: 6px;
    }

    .holocore-lab__header { padding: 0 8px; }
    .holocore-lab h1 { font-size: clamp(30px, 10vw, 44px); }
    .holocore-lab__eyebrow { font-size: 7px; }
    .holocore-lab__status { display: none; }
    .holocore-lab__rail { padding: 8px 4px; }
    .holocore-lab__rail--right dl { gap: 9px; }
    .holocore-lab__rail dt { display: none; }
    .holocore-lab__rail dd { font-size: 6px; writing-mode: vertical-rl; }
    .holocore-lab__vertical-copy { font-size: 7px; }
    .holocore-lab__core { padding: 6px; }
    .holocore-lab__footer {
      grid-template-columns: repeat(4, 1fr);
      gap: 4px;
      padding: 0 6px;
    }
    .holocore-lab__footer p { font-size: 6px; text-align: center; }
    .holocore-lab__footer strong { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .holocore-lab { scroll-behavior: auto; }
  }
</style>
