---
/**
 * KODEX−∞ · ESCENA 05 · SIGNAL TEMPLE — el lab
 *
 * "The altar contains the act; the temple contains the state." La arquitectura
 * sale determinista de los tres derivados de la memoria, y el panel los muestra
 * crudos: la mutación tiene que poder explicarse, no adivinarse.
 */
import Base from '../../../layouts/Base.astro';
import { TEMPLE } from '../../../lib/kodex/escenas/temple';
---

<Base
  title="KODEX Lab — Signal Temple"
  description="Private KODEX Signal Temple persistent-state lab."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <section class="kdx-temple" data-kdx-temple data-state="dormant">
    <header class="kdx-temple__header">
      <a class="kdx-temple__logo" href="/kodex/">KODEX−∞</a>
      <div class="kdx-temple__meta">
        <span>SCENE 05 / SIGNAL TEMPLE</span>
        <span>KDX://STATE/PERSISTENT</span>
      </div>
    </header>

    <div class="kdx-temple__stage">
      <canvas class="kdx-temple__canvas" data-kdx-temple-canvas aria-hidden="true"></canvas>

      <div class="kdx-temple__body">
        <p class="kdx-temple__kicker">ARCHITECTURE / STATE / NAVE</p>
        <h1 class="kdx-temple__headline">{TEMPLE.copy.containment}</h1>
        <p class="kdx-temple__lede">
          This architecture is built from what the system remembers of you.
          Columns, branches and ties are not decoration — each one corresponds
          to a real state variable, and you can see which.
        </p>
        <button class="kdx-temple__btn" type="button" data-kdx-see-state aria-expanded="false">
          SEE THE STATE THAT BUILT THIS
        </button>
        <div class="kdx-temple__statebox" data-kdx-state-box hidden>
          <p class="kdx-temple__statebox-title">MUTATION INPUTS · DETERMINISTIC</p>
          <div class="kdx-temple__panel" data-kdx-mutation-panel></div>
          <p class="kdx-temple__statebox-note">COLLECTIVE SIGNALS · NOT IMPLEMENTED — PUBLIC COMMONS IS A LATER PHASE</p>
        </div>
      </div>
    </div>

    <footer class="kdx-temple__footer">
      <span>{TEMPLE.node_id}</span>
      <span>STATE · <em data-kdx-state-readout>DORMANT</em></span>
      <span>NO RANDOMNESS — SAME MEMORY, SAME TEMPLE</span>
    </footer>
  </section>
</Base>

<style>
  .kdx-temple{
    min-height:100vh; min-height:100dvh; display:flex; flex-direction:column;
    background:#0a0a0a; color:#f0ede8; font-family:'IBM Plex Mono',ui-monospace,monospace;
  }
  .kdx-temple__header{
    display:flex; justify-content:space-between; align-items:center; gap:16px;
    padding:clamp(14px,2.4vh,22px) clamp(18px,3.4vw,44px);
    border-bottom:1px solid rgba(240,237,232,.1);
  }
  .kdx-temple__logo{ color:#f0ede8; text-decoration:none; letter-spacing:.18em; font-size:14px; }
  .kdx-temple__meta{ display:flex; gap:18px; font-size:10px; letter-spacing:.16em; color:rgba(240,237,232,.45); }
  .kdx-temple__stage{ position:relative; flex:1; display:grid; place-items:end center; overflow:hidden; }
  .kdx-temple__canvas{ position:absolute; inset:0; width:100%; height:100%;
    opacity:calc(.6 + var(--kdx-memoria,0) * .35); }
  .kdx-temple__body{
    position:relative; z-index:1; max-width:600px; width:min(92vw,600px);
    padding:clamp(18px,3vh,32px) clamp(18px,4vw,32px) clamp(26px,5vh,52px);
    display:flex; flex-direction:column; align-items:center; text-align:center; gap:clamp(10px,1.8vh,16px);
  }
  .kdx-temple__kicker{ margin:0; font-size:10px; letter-spacing:.24em; color:#c9a84c; }
  .kdx-temple__headline{
    margin:0; font-family:'Cormorant Garamond',Georgia,serif; font-weight:400;
    font-size:clamp(22px,3vw,36px); line-height:1.18; text-wrap:balance;
  }
  .kdx-temple__lede{ margin:0; max-width:52ch; font-size:11px; line-height:1.7; letter-spacing:.05em; color:rgba(240,237,232,.62); }
  .kdx-temple__btn{
    min-height:40px; padding:0 18px; cursor:pointer; font:inherit; font-size:10px; letter-spacing:.18em;
    background:rgba(201,168,76,.1); color:#f0ede8; border:1px solid rgba(201,168,76,.5);
    transition:background .2s ease, color .2s ease;
  }
  .kdx-temple__btn:hover{ background:#c9a84c; color:#0a0a0a; }
  .kdx-temple__statebox{ width:100%; max-width:480px; border:1px solid rgba(240,237,232,.14);
    padding:12px 14px; display:flex; flex-direction:column; gap:8px; text-align:left;
    background:rgba(10,10,10,.72); }
  .kdx-temple__statebox-title{ margin:0; font-size:9.5px; letter-spacing:.2em; color:rgba(240,237,232,.45); }
  .kdx-temple__panel p{ margin:0; font-size:10.5px; line-height:2; letter-spacing:.08em; color:rgba(240,237,232,.78);
    font-variant-numeric:tabular-nums; }
  .kdx-temple__statebox-note{ margin:0; font-size:9px; letter-spacing:.14em; color:rgba(240,237,232,.38); }
  .kdx-temple__footer{
    display:flex; flex-wrap:wrap; justify-content:space-between; gap:10px;
    padding:12px clamp(18px,3.4vw,44px); border-top:1px solid rgba(240,237,232,.1);
    font-size:9.5px; letter-spacing:.16em; color:rgba(240,237,232,.4);
  }
  .kdx-temple__footer em{ font-style:normal; color:#c9a84c; }
  @media (max-width:560px){ .kdx-temple__meta{ display:none; } }
</style>

<script>
  import { montarTemple } from '../../../lib/kodex/escenas/temple-cliente';
  const raiz = document.querySelector('[data-kdx-temple]');
  if (raiz instanceof HTMLElement) {
    montarTemple(raiz);
    const out = document.querySelector('[data-kdx-state-readout]');
    if (out) {
      new MutationObserver(() => {
        out.textContent = (raiz.dataset.state || 'dormant').toUpperCase();
      }).observe(raiz, { attributes: true, attributeFilter: ['data-state'] });
    }
  }
</script>
