---
import Base from '../../../layouts/Base.astro';
import KodexHoloCoreWebGLSourceLab from '../../../components/kodex/holocore/KodexHoloCoreWebGLSourceLab.astro';
---

<Base title="KODEX−∞ · HoloCore WebGL Source" description="Internal KODEX lab proving reuse of the existing OBSERVE source shader as a HoloCore renderer adapter." robots="noindex, nofollow" kodexFonts={true} noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}>
  <main class="webgl-page" aria-labelledby="webgl-title">
    <header class="webgl-page__header">
      <div><p>KODEX−∞ // SYSTEMS LAB // WEBGL SOURCE ADAPTER V0</p><h1 id="webgl-title">SOURCE FIELD</h1></div>
      <dl>
        <div><dt>SHADER</dt><dd>OBSERVE · SOURCE.FRAG</dd></div>
        <div><dt>ROLE</dt><dd>SOURCE GENERATOR</dd></div>
        <div><dt>TIME</dt><dd>AMBIENT / UNCLOSED</dd></div>
        <div><dt>REDUCED</dt><dd>STATIC TIME FRAME</dd></div>
      </dl>
    </header>
    <aside class="webgl-page__left"><span>W-01</span><p>DO NOT CLAIM A SEAM THAT THE SOURCE DOES NOT PROVE.</p></aside>
    <section class="webgl-page__core" aria-label="HoloCore WebGL source field"><KodexHoloCoreWebGLSourceLab /></section>
    <aside class="webgl-page__right"><p>INTERNAL SHADER</p><strong>→</strong><p>MINIMAL RUNNER</p><strong>→</strong><p>HOLOCORE</p><hr/><p>WEBGL2 OFF</p><strong>→</strong><p>STATIC RETICLE</p></aside>
    <footer class="webgl-page__footer"><span>01 SOURCE SHADER</span><span>02 UNIFORM CONTRACT</span><span>03 STATIC REDUCED MOTION</span><span>04 FALLBACK</span><strong>NO CLOSED-LOOP CLAIM</strong></footer>
  </main>
</Base>

<style is:global>html:has(.webgl-page),body:has(.webgl-page){margin:0;width:100%;min-height:100%;overflow:hidden;background:#020204}</style>
<style>
  .webgl-page{box-sizing:border-box;width:100%;height:100dvh;display:grid;grid-template-columns:clamp(52px,7vw,86px) minmax(0,1fr) clamp(74px,9vw,122px);grid-template-rows:clamp(78px,11vh,112px) minmax(0,1fr) clamp(58px,8vh,82px);grid-template-areas:"header header header" "left core right" "footer footer footer";padding:10px;overflow:hidden;background:#020204;color:#eeeaf2;font-family:'Share Tech Mono',ui-monospace,monospace}
  .webgl-page__header{grid-area:header;display:flex;align-items:center;justify-content:space-between;gap:20px;min-width:0;padding:0 clamp(10px,2vw,24px);border:1px solid rgba(176,126,255,.18)}
  .webgl-page__header p{margin:0;font-size:8px;letter-spacing:.16em;color:rgba(230,224,238,.45)}.webgl-page h1{margin:5px 0 0;font-family:'Cormorant Garamond','Times New Roman',serif;font-size:clamp(32px,5vw,68px);font-weight:400;line-height:.86;letter-spacing:.09em}
  .webgl-page__header dl{display:grid;grid-template-columns:auto auto;gap:4px 14px;margin:0;font-size:7px;letter-spacing:.08em}.webgl-page__header dl div{display:contents}.webgl-page__header dt{color:rgba(230,224,238,.34)}.webgl-page__header dd{margin:0;color:rgba(188,143,255,.78)}
  .webgl-page__left,.webgl-page__right{min-height:0;overflow:hidden;padding:10px 7px;color:rgba(230,224,238,.44);font-size:7px;line-height:1.4;letter-spacing:.1em}.webgl-page__left{grid-area:left;border-right:1px solid rgba(176,126,255,.14)}.webgl-page__right{grid-area:right;border-left:1px solid rgba(176,126,255,.14);display:flex;flex-direction:column;justify-content:center;gap:8px}.webgl-page__left p{writing-mode:vertical-rl;transform:rotate(180deg);margin:18px auto 0}.webgl-page__left span,.webgl-page__right strong{color:#b787ff}.webgl-page__right p{margin:0}.webgl-page__right strong{font-size:12px;font-weight:400}.webgl-page__right hr{width:100%;border:0;border-top:1px solid rgba(255,255,255,.08)}
  .webgl-page__core{grid-area:core;min-width:0;min-height:0;padding:clamp(7px,1.2vw,15px)}
  .webgl-page__footer{grid-area:footer;display:grid;grid-template-columns:repeat(4,auto) minmax(0,1fr);align-items:center;gap:clamp(8px,1.7vw,22px);padding:0 clamp(8px,2vw,24px);border:1px solid rgba(176,126,255,.18);font-size:7px;letter-spacing:.1em;color:rgba(230,224,238,.46)}.webgl-page__footer strong{justify-self:end;color:rgba(188,143,255,.7);font-weight:500}
  @media(max-width:700px){.webgl-page{grid-template-columns:34px minmax(0,1fr) 42px;grid-template-rows:74px minmax(0,1fr) 56px;padding:6px}.webgl-page__header{padding:0 7px}.webgl-page__header dl{display:none}.webgl-page h1{font-size:clamp(28px,9vw,42px)}.webgl-page__left,.webgl-page__right{padding:7px 3px;font-size:5px}.webgl-page__core{padding:5px}.webgl-page__footer{grid-template-columns:repeat(4,1fr);gap:2px;padding:0 3px;font-size:5px;text-align:center}.webgl-page__footer strong{display:none}}
</style>
