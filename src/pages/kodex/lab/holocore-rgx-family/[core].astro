---
import KodexHoloCoreRGXFamily from '../../../../components/kodex/holocore/KodexHoloCoreRGXFamily.astro';
import {
  HOLOCORE_RGX_PROFILE_IDS,
  resolveHoloCoreRGXProfile,
} from '../../../../kodex/holocore/reference-profiles/rgx-family.js';

export function getStaticPaths() {
  return HOLOCORE_RGX_PROFILE_IDS.map(core => ({ params: { core } }));
}

const { core } = Astro.params;
const profile = resolveHoloCoreRGXProfile(core);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{profile.title} — HoloCore RGX Lab</title>
  </head>
  <body>
    <main class="rgx-family-lab" data-rgx-family-lab data-concept={profile.conceptId}>
      <KodexHoloCoreRGXFamily conceptId={profile.conceptId} />
    </main>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #020205; }
  body { min-height: 100dvh; }
  .rgx-family-lab {
    width: 100vw;
    height: 100dvh;
    min-height: 0;
    padding: clamp(10px, 2vw, 24px);
    overflow: hidden;
    background: #020205;
  }

  /*
   * The SVG layer is the exact structural reference scaffold. VORTEX, SKULL
   * and SOURCE proved compositor-heavy in exact-head CI despite simplifying
   * the Canvas field. Their geometry remains fully present, but its secondary
   * glow/dash/node animation is static so the living phase loop is carried by
   * the microglyph signal layer instead of competing with SVG compositing.
   */
  [data-motif="vortex"] .kdx-rgx-family__scaffold,
  [data-motif="skull"] .kdx-rgx-family__scaffold,
  [data-motif="source"] .kdx-rgx-family__scaffold,
  [data-motif="vortex"] .kdx-rgx-family__scaffold > g,
  [data-motif="skull"] .kdx-rgx-family__scaffold > g,
  [data-motif="source"] .kdx-rgx-family__scaffold > g {
    filter: none !important;
  }

  [data-motif="vortex"] .rgx-p--ring,
  [data-motif="vortex"] .rgx-p--node,
  [data-motif="skull"] .rgx-p--ring,
  [data-motif="skull"] .rgx-p--node,
  [data-motif="source"] .rgx-p--ring,
  [data-motif="source"] .rgx-p--node {
    animation: none !important;
  }
</style>
