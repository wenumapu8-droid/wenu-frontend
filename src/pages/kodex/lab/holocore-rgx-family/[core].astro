---
import KodexHoloCoreRGXFamily from '../../../../components/kodex/holocore/KodexHoloCoreRGXFamily.astro';
import {
  HOLOCORE_RGX_PROFILE_IDS,
  resolveHoloCoreRGXProfile,
} from '../../../../kodex/holocore/reference-profiles/rgx-family.js';

export function getStaticPaths() {
  return HOLOCORE_RGX_PROFILE_IDS.map(core => ({ params: { core } }));
}

const { core } = Astro.params;
const profile = resolveHoloCoreRGXProfile(core);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{profile.title} — HoloCore RGX Lab</title>
  </head>
  <body>
    <main class="rgx-family-lab" data-rgx-family-lab data-concept={profile.conceptId}>
      <KodexHoloCoreRGXFamily conceptId={profile.conceptId} />
    </main>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #020205; }
  body { min-height: 100dvh; }
  .rgx-family-lab {
    width: 100vw;
    height: 100dvh;
    min-height: 0;
    padding: clamp(10px, 2vw, 24px);
    overflow: hidden;
    background: #020205;
  }

  /*
   * The SVG layer is the exact structural reference scaffold. VORTEX, SKULL
   * and SOURCE proved compositor-heavy in exact-head CI despite simplifying
   * the Canvas field. Their geometry remains fully present, but its secondary
   * glow/dash/node animation is static so the living phase loop is carried by
   * the microglyph signal layer instead of competing with SVG compositing.
   */
  [data-motif="vortex"] .kdx-rgx-family__scaffold,
  [data-motif="skull"] .kdx-rgx-family__scaffold,
  [data-motif="source"] .kdx-rgx-family__scaffold,
  [data-motif="vortex"] .kdx-rgx-family__scaffold > g,
  [data-motif="skull"] .kdx-rgx-family__scaffold > g,
  [data-motif="source"] .kdx-rgx-family__scaffold > g {
    filter: none !important;
  }

  [data-motif="vortex"] .rgx-p--ring,
  [data-motif="vortex"] .rgx-p--node,
  [data-motif="skull"] .rgx-p--ring,
  [data-motif="skull"] .rgx-p--node,
  [data-motif="source"] .rgx-p--ring,
  [data-motif="source"] .rgx-p--node {
    animation: none !important;
  }

  /*
   * SEMANTIC SILHOUETTE PASS
   *
   * These seven profiles were technically verified in the 42-state RGX gate,
   * but their desktop evidence read as generic ellipses/fields. The Canvas,
   * scene equations, source refs, 24 s loop and primitive topology are left
   * untouched. This pass only changes how the existing vector scaffold is
   * presented in the acceptance lab so a creator can judge semantic identity.
   *
   * Their normalized 100x100 scaffold is shown in a centered square instead of
   * being stretched to the widescreen chamber. This is intentionally lab-only
   * until creator visual acceptance promotes the treatment into the component.
   */
  [data-concept-id="memory-tree"] .kdx-rgx-family__scaffold,
  [data-concept-id="skull-archive"] .kdx-rgx-family__scaffold,
  [data-concept-id="heart-chamber"] .kdx-rgx-family__scaffold,
  [data-concept-id="source-chamber"] .kdx-rgx-family__scaffold,
  [data-concept-id="return-gate"] .kdx-rgx-family__scaffold,
  [data-concept-id="living-organism"] .kdx-rgx-family__scaffold,
  [data-concept-id="signal-seed"] .kdx-rgx-family__scaffold {
    inset: 50% auto auto 50% !important;
    width: min(100%, calc(100dvh - 62px)) !important;
    height: auto !important;
    aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%);
    overflow: visible;
  }

  [data-concept-id="memory-tree"] .rgx-p--ring,
  [data-concept-id="skull-archive"] .rgx-p--ring,
  [data-concept-id="heart-chamber"] .rgx-p--ring,
  [data-concept-id="source-chamber"] .rgx-p--ring,
  [data-concept-id="return-gate"] .rgx-p--ring,
  [data-concept-id="living-organism"] .rgx-p--ring,
  [data-concept-id="signal-seed"] .rgx-p--ring {
    opacity: .82;
    stroke-width: .13;
  }

  [data-concept-id="memory-tree"] .rgx-p--secondary,
  [data-concept-id="skull-archive"] .rgx-p--secondary,
  [data-concept-id="heart-chamber"] .rgx-p--secondary,
  [data-concept-id="source-chamber"] .rgx-p--secondary,
  [data-concept-id="return-gate"] .rgx-p--secondary,
  [data-concept-id="living-organism"] .rgx-p--secondary,
  [data-concept-id="signal-seed"] .rgx-p--secondary {
    opacity: .48;
    stroke-width: .075;
  }

  [data-concept-id="memory-tree"] .rgx-p--axis,
  [data-concept-id="skull-archive"] .rgx-p--axis,
  [data-concept-id="heart-chamber"] .rgx-p--axis,
  [data-concept-id="source-chamber"] .rgx-p--axis,
  [data-concept-id="return-gate"] .rgx-p--axis,
  [data-concept-id="living-organism"] .rgx-p--axis,
  [data-concept-id="signal-seed"] .rgx-p--axis {
    opacity: .48;
  }

  [data-concept-id="memory-tree"] .rgx-p--node,
  [data-concept-id="skull-archive"] .rgx-p--node,
  [data-concept-id="heart-chamber"] .rgx-p--node,
  [data-concept-id="source-chamber"] .rgx-p--node,
  [data-concept-id="return-gate"] .rgx-p--node,
  [data-concept-id="living-organism"] .rgx-p--node,
  [data-concept-id="signal-seed"] .rgx-p--node {
    opacity: .86;
  }

  /* MEMORY TREE: branches + roots must read before the orbit of memory nodes. */
  [data-concept-id="memory-tree"] [data-rgx-primitive^="branch-"],
  [data-concept-id="memory-tree"] [data-rgx-primitive^="root-"] {
    opacity: .96;
    stroke-width: .15;
    stroke-dasharray: none;
  }
  [data-concept-id="memory-tree"] [data-rgx-primitive^="twig-"] { opacity: .72; }
  [data-concept-id="memory-tree"] [data-rgx-primitive^="archive-"] { opacity: .4; }

  /* SKULL ARCHIVE: face landmarks dominate; measurement rings recede. */
  [data-concept-id="skull-archive"] [data-rgx-primitive="left-eye"],
  [data-concept-id="skull-archive"] [data-rgx-primitive="right-eye"],
  [data-concept-id="skull-archive"] [data-rgx-primitive^="jaw-"] {
    opacity: 1;
    stroke-width: .18;
    stroke-dasharray: none;
  }
  [data-concept-id="skull-archive"] [data-rgx-primitive^="nose-"] {
    opacity: .8;
    stroke-width: .11;
  }
  [data-concept-id="skull-archive"] [data-rgx-primitive^="scan-ring-"] { opacity: .18; }

  /* HEART CHAMBER: the encoded contour was correct but visually too small. */
  [data-concept-id="heart-chamber"] [data-rgx-primitive="heart-contour"] {
    transform: scale(2.65);
    transform-origin: center;
    opacity: 1;
    stroke-width: .18;
    stroke-dasharray: none;
  }
  [data-concept-id="heart-chamber"] [data-rgx-primitive^="heart-ring-"] { opacity: .2; }
  [data-concept-id="heart-chamber"] [data-rgx-primitive^="vessel-"] {
    opacity: .9;
    stroke-width: .13;
    stroke-dasharray: none;
  }

  /* SOURCE CHAMBER: rotate the existing twelve petals around the source. */
  [data-concept-id="source-chamber"] [data-rgx-primitive^="petal-"] {
    transform-box: view-box;
    transform-origin: 50px 43px;
    opacity: .78;
    stroke-width: .12;
    stroke-dasharray: none;
  }
  [data-concept-id="source-chamber"] [data-rgx-primitive="petal-0"] { transform: rotate(0deg); }
  [data-concept-id="source-chamber"] [data-rgx-primitive="petal-1"] { transform: rotate(30deg); }
  [data-concept-id="source-chamber"] [data-rgx-primitive="petal-2"] { transform: rotate(60deg); }
  [data-concept-id="source-chamber"] [data-rgx-primitive="petal-3"] { transform: rotate(90deg); }
  [data-concept-id="source-chamber"] [data-rgx-primitive="petal-4"] { transform: rotate(120deg); }
  [data-concept-id="source-chamber"] [data-rgx-primitive="petal-5"] { transform: rotate(150deg); }
  [data-concept-id="source-chamber"] [data-rgx-primitive="petal-6"] { transform: rotate(180deg); }
  [data-concept-id="source-chamber"] [data-rgx-primitive="petal-7"] { transform: rotate(210deg); }
  [data-concept-id="source-chamber"] [data-rgx-primitive="petal-8"] { transform: rotate(240deg); }
  [data-concept-id="source-chamber"] [data-rgx-primitive="petal-9"] { transform: rotate(270deg); }
  [data-concept-id="source-chamber"] [data-rgx-primitive="petal-10"] { transform: rotate(300deg); }
  [data-concept-id="source-chamber"] [data-rgx-primitive="petal-11"] { transform: rotate(330deg); }
  [data-concept-id="source-chamber"] [data-rgx-primitive="horizon"] { opacity: .66; stroke-width: .1; }
  [data-concept-id="source-chamber"] [data-rgx-primitive="reflection"] { opacity: .7; }

  /* RETURN GATE: portal depth and path must dominate the ambient fragments. */
  [data-concept-id="return-gate"] [data-rgx-primitive^="gate-"] {
    opacity: .88;
    stroke-width: .14;
  }
  [data-concept-id="return-gate"] [data-rgx-primitive^="path-"] {
    opacity: .96;
    stroke-width: .15;
    stroke-dasharray: none;
  }
  [data-concept-id="return-gate"] [data-rgx-primitive="horizon"] { opacity: .6; }
  [data-concept-id="return-gate"] [data-rgx-primitive^="fragment-"] { opacity: .64; }

  /* LIVING ORGANISM / SIGNAL SEED: membrane, chambers and lattice stay legible. */
  [data-concept-id="living-organism"] [data-rgx-primitive="inner-membrane"],
  [data-concept-id="signal-seed"] [data-rgx-primitive="inner-membrane"] {
    opacity: .7;
    stroke-width: .11;
    stroke-dasharray: none;
  }
  [data-concept-id="living-organism"] [data-rgx-primitive^="chamber-"],
  [data-concept-id="signal-seed"] [data-rgx-primitive^="chamber-"] {
    opacity: .78;
    stroke-width: .11;
  }
  [data-concept-id="living-organism"] [data-rgx-primitive^="filament-"],
  [data-concept-id="signal-seed"] [data-rgx-primitive^="filament-"] {
    opacity: .52;
  }

  @media (max-width: 700px) {
    [data-concept-id="heart-chamber"] [data-rgx-primitive="heart-contour"] {
      transform: scale(2.25);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-concept-id="memory-tree"] .rgx-p,
    [data-concept-id="skull-archive"] .rgx-p,
    [data-concept-id="heart-chamber"] .rgx-p,
    [data-concept-id="source-chamber"] .rgx-p,
    [data-concept-id="return-gate"] .rgx-p,
    [data-concept-id="living-organism"] .rgx-p,
    [data-concept-id="signal-seed"] .rgx-p {
      animation: none !important;
    }
  }
</style>
