<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="robots" content="noindex,nofollow,noarchive" />
<meta name="color-scheme" content="dark" />
<title>KODEX−∞ · HEART CHAMBER · Plate-to-Live v2</title>
<meta name="description" content="Internal HEART CHAMBER plate-to-live fidelity slice. Canon plate preserved; live readouts are simulated." />
</head>
<body>
<main class="heart-page" data-heart-page>
  <img class="ambient" aria-hidden="true" src="https://raw.githubusercontent.com/wenumapu8-droid/wenu-tools/57f50fbdb09a7df5c36f950ec8aa4ade386cd33c/kodex-preview/heart-chamber-plate-live-v1/heart-chamber-master.webp" />
  <section class="stage" data-heart-stage data-mode="integrate" aria-label="KODEX Heart Chamber interactive plate">
    <img class="plate" crossorigin="anonymous" src="https://raw.githubusercontent.com/wenumapu8-droid/wenu-tools/57f50fbdb09a7df5c36f950ec8aa4ade386cd33c/kodex-preview/heart-chamber-plate-live-v1/heart-chamber-master.webp" alt="KODEX Heart Chamber canonical plate: an anatomical heart suspended inside circular copper instrumentation on a black field." data-heart-plate draggable="false" />
    <canvas class="fx" data-heart-fx aria-hidden="true"></canvas>
    <div class="vignette" aria-hidden="true"></div>
    <div class="readout bpm" data-heart-bpm>72 BPM <small>SIM</small></div>
    <div class="readout coherence" data-heart-coherence>91.2% <small>SIM</small></div>
    <button class="hotspot integrate" data-heart-mode="integrate" aria-label="Orient toward Integrate"></button>
    <button class="hotspot heal" data-heart-mode="heal" aria-label="Orient toward Heal"></button>
    <button class="hotspot amplify" data-heart-mode="amplify" aria-label="Orient toward Amplify"></button>
    <button class="hotspot transmute" data-heart-mode="transmute" aria-label="Orient toward Transmute"></button>
    <button class="hotspot remember" data-heart-mode="remember" aria-label="Orient toward Remember"></button>
  </section>
  <div class="system-status" aria-live="polite">
    <span class="signal-dot" aria-hidden="true"></span>
    <strong>HEART / GATE 05</strong>
    <span>MODE <b data-heart-mode-label>INTEGRATE</b></span>
    <span class="status-detail">CANON PLATE · LIVE OVERLAY · SIMULATED DISPLAY / NOT BIOMETRIC</span>
  </div>
</main>
<script is:inline>
(()=>{
  const page=document.querySelector('[data-heart-page]');
  const stage=document.querySelector('[data-heart-stage]');
  const plate=document.querySelector('[data-heart-plate]');
  const canvas=document.querySelector('[data-heart-fx]');
  const bpmEl=document.querySelector('[data-heart-bpm]');
  const coherenceEl=document.querySelector('[data-heart-coherence]');
  const modeLabel=document.querySelector('[data-heart-mode-label]');
  if(!(page instanceof HTMLElement)||!(stage instanceof HTMLElement)||!(plate instanceof HTMLImageElement)||!(canvas instanceof HTMLCanvasElement)||!(bpmEl instanceof HTMLElement)||!(coherenceEl instanceof HTMLElement)||!(modeLabel instanceof HTMLElement)) return;
  const ctx=canvas.getContext('2d',{alpha:true});
  const sampleCanvas=document.createElement('canvas');
  const sampleCtx=sampleCanvas.getContext('2d',{willReadFrequently:true});
  if(!ctx||!sampleCtx) return;

  const reduced=matchMedia('(prefers-reduced-motion: reduce)');
  const staticPlate=new URLSearchParams(location.search).has('static');
  const palette={
    integrate:{r:255,g:133,b:91,energy:.78},
    heal:{r:222,g:158,b:113,energy:.66},
    amplify:{r:255,g:92,b:58,energy:1},
    transmute:{r:225,g:108,b:102,energy:.88},
    remember:{r:188,g:134,b:136,energy:.62},
  };
  let mode='integrate';
  let W=512,H=512,dpr=1,raf=0,visible=true,destroyed=false;
  let luminous=[{x:.5,y:.51,p:1},{x:.5,y:.2,p:.8},{x:.5,y:.72,p:.8},{x:.36,y:.44,p:.6},{x:.64,y:.44,p:.6}];
  let sparks=[];
  let started=performance.now();

  if(staticPlate){
    page.dataset.static='true';
    bpmEl.hidden=true;
    coherenceEl.hidden=true;
  }

  function resize(){
    const rect=stage.getBoundingClientRect();
    dpr=Math.min(devicePixelRatio||1,rect.width<700?1.25:1.65);
    W=Math.max(1,Math.round(rect.width*dpr));
    H=Math.max(1,Math.round(rect.height*dpr));
    if(canvas.width!==W||canvas.height!==H){canvas.width=W;canvas.height=H;}
  }

  function samplePlate(){
    try{
      sampleCanvas.width=512; sampleCanvas.height=512;
      sampleCtx.clearRect(0,0,512,512);
      sampleCtx.drawImage(plate,0,0,512,512);
      const data=sampleCtx.getImageData(0,0,512,512).data;
      const candidates=[];
      for(let y=62;y<452;y+=3){
        for(let x=108;x<392;x+=3){
          const i=(y*512+x)*4,r=data[i],g=data[i+1],b=data[i+2];
          const lum=.2126*r+.7152*g+.0722*b;
          if(lum>98&&r>g*1.07&&r>b*1.14){
            candidates.push({x:x/512,y:y/512,p:Math.min(1,(lum-96)/150)});
          }
        }
      }
      if(candidates.length){
        luminous=[];
        const count=Math.min(175,candidates.length);
        for(let i=0;i<count;i++) luminous.push(candidates[(i*7919)%candidates.length]);
      }
    }catch(error){console.warn('[kdx-heart] plate sampling unavailable; using deterministic fallback',error);}
    sparks=Array.from({length:52},(_,i)=>({
      h:luminous[i%luminous.length],
      phase:(i*2.39996)%6.283,
      speed:.22+(i%9)*.037,
      radius:.4+(i%6)*.25,
    }));
  }

  function drawWave(t,color){
    const x0=.064*W,x1=.189*W,y=.813*H;
    ctx.save();
    ctx.beginPath();
    for(let i=0;i<=42;i++){
      const q=i/42,x=x0+(x1-x0)*q;
      const envelope=Math.sin(q*Math.PI);
      const yy=y+Math.sin(q*36+t*7.54)*1.5*dpr*envelope+Math.sin(q*71-t*4.1)*.65*dpr*envelope;
      if(i===0)ctx.moveTo(x,yy);else ctx.lineTo(x,yy);
    }
    ctx.strokeStyle=`rgba(${color.r},${color.g},${color.b},.19)`;
    ctx.lineWidth=Math.max(.7,dpr*.65);
    ctx.stroke();
    ctx.restore();
  }

  function drawCoherence(t,color){
    const cx=.87*W,cy=.788*H;
    ctx.save();
    ctx.translate(cx,cy);
    const sweep=t*.16;
    for(let i=0;i<3;i++){
      ctx.beginPath();
      ctx.arc(0,0,(.025+i*.012)*W,sweep+i*.58,sweep+i*.58+1.25);
      ctx.strokeStyle=`rgba(${color.r},${color.g},${color.b},${.07-i*.013})`;
      ctx.lineWidth=Math.max(.6,dpr*.55);
      ctx.stroke();
    }
    ctx.restore();
  }

  function updateReadouts(t){
    if(staticPlate) return;
    const bpm=72+Math.sin(t*.45)*.7+Math.sin(t*1.13)*.22;
    const coherence=91.2+Math.sin(t*.17)*.52+Math.sin(t*.39)*.17;
    bpmEl.innerHTML=`${bpm.toFixed(0)} BPM <small>SIM</small>`;
    coherenceEl.innerHTML=`${coherence.toFixed(1)}% <small>SIM</small>`;
  }

  function render(now=performance.now()){
    if(destroyed)return;
    resize();
    ctx.clearRect(0,0,W,H);
    if(staticPlate)return;
    const t=(now-started)/1000;
    const color=palette[mode]||palette.integrate;
    const idle=(Math.sin(t*Math.PI*2/8.6)+1)*.5;
    const beat=(Math.sin(t*Math.PI*2*1.2-Math.PI/2)+1)*.5;
    const beatPeak=Math.pow(beat,9);
    const hx=.505*W,hy=.515*H;

    ctx.save();
    ctx.globalCompositeOperation='lighter';
    const glowRadius=(.055+.018*beatPeak+.009*idle)*W;
    const glow=ctx.createRadialGradient(hx,hy,0,hx,hy,glowRadius*3.2);
    glow.addColorStop(0,`rgba(255,229,206,${.12+.13*beatPeak})`);
    glow.addColorStop(.17,`rgba(${color.r},${color.g},${color.b},${.10+.10*beatPeak})`);
    glow.addColorStop(.55,`rgba(${color.r},${color.g},${color.b},${.026+.025*idle})`);
    glow.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=glow;ctx.beginPath();ctx.arc(hx,hy,glowRadius*3.2,0,Math.PI*2);ctx.fill();

    for(let k=0;k<3;k++){
      const radius=(.165+k*.067+idle*.0015)*W;
      ctx.beginPath();ctx.arc(hx,hy,radius,0,Math.PI*2);
      ctx.strokeStyle=`rgba(${color.r},${color.g},${color.b},${.013+.012*idle*color.energy})`;
      ctx.lineWidth=Math.max(.55,dpr*.48);ctx.stroke();
    }

    luminous.forEach((p,i)=>{
      const tw=(Math.sin(t*(.45+(i%11)*.023)+i*1.91)+1)*.5;
      if(tw<.7)return;
      const alpha=(.018+.065*tw*p.p)*color.energy;
      ctx.fillStyle=`rgba(${color.r},${Math.min(255,color.g+28)},${Math.min(255,color.b+18)},${alpha})`;
      ctx.beginPath();ctx.arc(p.x*W,p.y*H,(.32+p.p*.95)*dpr,0,Math.PI*2);ctx.fill();
    });

    if(!reduced.matches){
      sparks.forEach((s,i)=>{
        const phase=s.phase+t*s.speed;
        const drift=Math.sin(t*.37+i)*s.radius*dpr;
        const x=s.h.x*W+Math.cos(phase)*drift;
        const y=s.h.y*H+Math.sin(phase*.79)*drift;
        const alpha=.012+.034*((Math.sin(t*.31+i*1.3)+1)*.5);
        ctx.fillStyle=`rgba(${color.r},${color.g},${color.b},${alpha})`;
        ctx.fillRect(x,y,Math.max(.75,dpr*.55),Math.max(.75,dpr*.55));
      });
    }
    drawWave(t,color);
    drawCoherence(t,color);
    ctx.restore();
    updateReadouts(t);
    if(!reduced.matches&&visible&&!document.hidden) raf=requestAnimationFrame(render); else raf=0;
  }

  function stop(){if(raf){cancelAnimationFrame(raf);raf=0;}}
  function start(){stop();started=performance.now();render(started);}

  function setMode(next){
    if(!(next in palette))return;
    mode=next;stage.dataset.mode=next;modeLabel.textContent=next.toUpperCase();
    stage.dispatchEvent(new CustomEvent('kdx:heart-mode',{bubbles:true,detail:{nodeId:'KDX-NODE-HEART-CHAMBER',mode:next,writesToMemory:false,sourceId:'KDX-ASTRAL-GATE-05',simulated:true}}));
    if(!reduced.matches&&!staticPlate){
      stage.animate([{filter:'brightness(1)'},{filter:`brightness(${next==='amplify'?1.055:1.025})`},{filter:'brightness(1)'}],{duration:460,easing:'cubic-bezier(.2,.8,.2,1)'});
    }
    render();
  }

  document.querySelectorAll('[data-heart-mode]').forEach(button=>{
    button.addEventListener('click',()=>setMode(button.getAttribute('data-heart-mode')||'integrate'));
  });

  stage.addEventListener('pointermove',event=>{
    if(reduced.matches||staticPlate)return;
    const rect=stage.getBoundingClientRect();
    const nx=(event.clientX-rect.left)/rect.width-.5,ny=(event.clientY-rect.top)/rect.height-.5;
    stage.style.setProperty('--px',`${(nx*-2.2).toFixed(2)}px`);
    stage.style.setProperty('--py',`${(ny*-2.2).toFixed(2)}px`);
  },{passive:true});
  stage.addEventListener('pointerleave',()=>{stage.style.setProperty('--px','0px');stage.style.setProperty('--py','0px');},{passive:true});

  const ro=new ResizeObserver(()=>render());ro.observe(stage);
  const io=new IntersectionObserver(([entry])=>{visible=entry?.isIntersecting??true;if(visible)start();else stop();},{threshold:.01});io.observe(stage);
  const onMotion=()=>{if(reduced.matches)stop();render();if(!reduced.matches)start();};
  reduced.addEventListener('change',onMotion);
  document.addEventListener('visibilitychange',()=>document.hidden?stop():start());
  plate.addEventListener('load',()=>{samplePlate();start();},{once:true});
  if(plate.complete){samplePlate();start();}
  addEventListener('pagehide',()=>{destroyed=true;stop();ro.disconnect();io.disconnect();reduced.removeEventListener('change',onMotion);},{once:true});
})();
</script>
</body>
</html>
<style>
:global(*){box-sizing:border-box}
:global(html),:global(body){margin:0;width:100%;min-height:100%;background:#000;color:#e6c7ad;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
:global(body){overflow:hidden}
.heart-page{position:relative;min-height:100svh;display:grid;place-items:center;overflow:hidden;isolation:isolate;background:#020101;padding:max(8px,env(safe-area-inset-top)) max(8px,env(safe-area-inset-right)) max(8px,env(safe-area-inset-bottom)) max(8px,env(safe-area-inset-left))}
.ambient{position:absolute;z-index:-2;inset:-8%;width:116%;height:116%;object-fit:cover;filter:blur(38px) saturate(.72) brightness(.21);opacity:.72;transform:scale(1.08);pointer-events:none}
.heart-page::after{content:"";position:absolute;z-index:-1;inset:0;pointer-events:none;background:radial-gradient(circle at 50% 50%,transparent 0 27%,rgba(0,0,0,.22) 58%,rgba(0,0,0,.85) 100%),linear-gradient(180deg,rgba(0,0,0,.62),transparent 20% 79%,rgba(0,0,0,.74))}
.stage{position:relative;width:min(96vw,94svh,1060px);aspect-ratio:1;isolation:isolate;touch-action:manipulation;user-select:none;filter:drop-shadow(0 28px 78px rgba(0,0,0,.78));transform:translate3d(var(--px,0),var(--py,0),0);transition:transform .32s cubic-bezier(.2,.8,.2,1)}
.plate{position:absolute;z-index:0;inset:0;width:100%;height:100%;display:block;object-fit:contain;image-rendering:auto}
.fx{position:absolute;z-index:2;inset:0;width:100%;height:100%;display:block;mix-blend-mode:screen;pointer-events:none}
.vignette{position:absolute;z-index:3;inset:0;pointer-events:none;background:radial-gradient(circle at 50.5% 51.5%,transparent 0 19%,rgba(255,103,73,.009) 36%,transparent 57%),linear-gradient(90deg,rgba(0,0,0,.055),transparent 12% 88%,rgba(0,0,0,.055))}
.hotspot{position:absolute;z-index:6;border:0;background:transparent;cursor:pointer;padding:0;color:transparent;border-radius:2px}
.hotspot::after{content:"";position:absolute;right:6%;top:50%;width:6px;height:6px;border-radius:50%;transform:translateY(-50%) scale(.7);opacity:0;background:#f0906c;box-shadow:0 0 7px rgba(255,112,76,.9),0 0 18px rgba(255,86,52,.5);transition:opacity .18s ease,transform .18s ease}
.hotspot:hover::after,.hotspot:focus-visible::after,.stage[data-mode="integrate"] .integrate::after,.stage[data-mode="heal"] .heal::after,.stage[data-mode="amplify"] .amplify::after,.stage[data-mode="transmute"] .transmute::after,.stage[data-mode="remember"] .remember::after{opacity:.92;transform:translateY(-50%) scale(1)}
.hotspot:focus-visible{outline:1px solid rgba(242,167,135,.38);outline-offset:1px}
.integrate{left:78.1%;top:28.2%;width:16.3%;height:5.2%}.heal{left:78.1%;top:33.5%;width:16.3%;height:5.2%}.amplify{left:78.1%;top:38.7%;width:16.3%;height:5.2%}.transmute{left:78.1%;top:43.8%;width:16.3%;height:5.2%}.remember{left:78.1%;top:49%;width:16.3%;height:5.2%}
.readout{position:absolute;z-index:7;pointer-events:none;color:#e8c0a8;text-shadow:0 0 8px rgba(255,108,72,.48);font-size:clamp(6px,1.25vw,12px);letter-spacing:.05em;background:#070303;padding:.12em .24em .14em;line-height:1.15}
.readout small{font-size:.56em;color:#916f62;letter-spacing:.12em}.bpm{left:6.2%;top:75.9%}.coherence{left:80.7%;top:67.2%}
.system-status{position:fixed;z-index:20;left:max(10px,env(safe-area-inset-left));bottom:max(10px,env(safe-area-inset-bottom));display:flex;align-items:center;gap:8px;max-width:calc(100vw - 20px);padding:7px 9px;border:1px solid rgba(221,172,143,.13);background:rgba(0,0,0,.68);backdrop-filter:blur(10px);color:#7f665c;font-size:8px;line-height:1.2;letter-spacing:.105em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.system-status strong,.system-status b{color:#d7b39e;font-weight:500}.signal-dot{flex:0 0 auto;width:5px;height:5px;border-radius:50%;background:#d96f52;box-shadow:0 0 9px rgba(231,113,82,.7)}
.heart-page[data-static="true"] .fx,.heart-page[data-static="true"] .vignette,.heart-page[data-static="true"] .hotspot,.heart-page[data-static="true"] .system-status{display:none}
@media(max-width:620px){.heart-page{padding:0}.stage{width:100vw;max-width:none}.system-status{font-size:7px;bottom:max(7px,env(safe-area-inset-bottom));left:max(7px,env(safe-area-inset-left));max-width:calc(100vw - 14px);padding:6px 7px}.status-detail{display:none}.ambient{inset:-16%;width:132%;height:132%;filter:blur(30px) saturate(.7) brightness(.18)}}
@media(max-height:620px) and (orientation:landscape){.stage{width:min(92vw,94svh)}.system-status{font-size:7px}.status-detail{display:none}}
@media(prefers-reduced-motion:reduce){.stage{transition:none!important;transform:none!important}.ambient{filter:blur(34px) saturate(.7) brightness(.2)}.signal-dot{box-shadow:none}.hotspot::after{transition:none}}
</style>