---
import KodexThresholdGpuRecovery from '../../../../components/kodex/threshold-recovery/KodexThresholdGpuRecovery.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="color-scheme" content="dark" />
    <title>KODEX−∞ · THRESHOLD Closure Candidate</title>
    <meta
      name="description"
      content="Internal KODEX−∞ THRESHOLD closure candidate. Voluntary entry, truthful telemetry, recovered native WebGL renderer."
    />
  </head>

  <body>
    <main class="threshold" data-threshold-root aria-labelledby="threshold-title">
      <KodexThresholdGpuRecovery class="threshold__renderer" />

      <div class="threshold__scan" aria-hidden="true"></div>
      <div class="threshold__vignette" aria-hidden="true"></div>
      <div class="threshold__grid" aria-hidden="true"></div>
      <div class="threshold__rings" aria-hidden="true"></div>

      <header class="threshold__topbar">
        <div class="brand" aria-label="KODEX minus infinity">
          <strong>KODEX−∞</strong>
          <span class="brand__signal"><i></i> SIGNAL · LATENT</span>
        </div>
        <div class="topmeta" aria-label="Threshold scene metadata">
          <span>00 / 07</span>
          <span class="accent">THRESHOLD</span>
          <span data-renderer>RENDERER / INITIALIZING</span>
        </div>
      </header>

      <aside class="threshold__rail threshold__rail--left" aria-label="Threshold system index">
        <span>NODE 00</span>
        <span>STATE <b data-state>DORMANT</b></span>
        <span>ENTRY <b>VOLUNTARY</b></span>
        <span>SOURCE <b>AUTHORED GPU</b></span>
        <span>MEMORY <b>NONE / PRE-ENTRY</b></span>
      </aside>

      <aside class="threshold__rail threshold__rail--right" aria-label="Threshold truth ledger">
        <div class="target">
          <i aria-hidden="true"></i>
          <strong>THRESHOLD</strong>
          <span>A / −∞</span>
        </div>
        <dl>
          <div><dt>IDENTITY CLAIM</dt><dd>NONE</dd></div>
          <div><dt>POINTER</dt><dd>MODULATES</dd></div>
          <div><dt>DWELL</dt><dd>STABILIZES</dd></div>
          <div><dt>CROSSING</dt><dd>EXPLICIT ONLY</dd></div>
          <div><dt>PUBLIC ROUTE</dt><dd>UNCHANGED</dd></div>
        </dl>
      </aside>

      <section class="threshold__hero">
        <p class="threshold__kicker">VISUAL SYSTEM V2.0 · BUILT FOR ARCHIVES THAT REMEMBER</p>
        <h1 id="threshold-title">THE GATE IS<br />A LIVING<br />AGREEMENT.</h1>
        <p class="threshold__question">WILL YOU ENTER A SYSTEM THAT REMEMBERS TRANSFORMATION?</p>
        <p class="threshold__lede">
          Presence changes the membrane. It does not identify you. The aperture can become aware and open, but crossing remains your explicit choice.
        </p>
      </section>

      <section class="threshold__entry" aria-label="Voluntary entry control">
        <a class="entry" href="/kodex/lab/visible-assembly/">
          <span class="entry__index">00</span>
          <strong>ENTER THE SYSTEM</strong>
          <span class="entry__arrow" aria-hidden="true">→</span>
          <small>ENTER VOLUNTARILY</small>
        </a>
      </section>

      <section class="threshold__journey" aria-label="Journey progress">
        <div class="journey__labels"><span>PREVIOUS / ORIGIN</span><strong>00 / 07</strong><span>NEXT / PROLOGUE</span></div>
        <div class="journey__line" aria-hidden="true">
          <i class="active"></i><i></i><i></i><i></i><i></i><i></i><i></i>
        </div>
      </section>

      <footer class="threshold__footer">
        <div class="footer__cell footer__cell--brand">
          <strong>KODEX−∞</strong>
          <span>THRESHOLD / CLOSURE CANDIDATE</span>
        </div>
        <div class="footer__cell footer__cell--log">
          <b>SYSTEM LOG //</b>
          <span data-log>WAITING FOR SIGNAL · ENTRY NOT COMMITTED</span>
        </div>
        <div class="footer__cell">
          <b>STATE</b>
          <span data-footer-state>DORMANT</span>
        </div>
        <div class="footer__cell">
          <b>PROVENANCE</b>
          <span>RECOVERED KODEX WEBGL / NOINDEX</span>
        </div>
      </footer>

      <p class="sr-only" aria-live="polite" data-live>Threshold renderer initializing.</p>
    </main>

    <script>
      const root = document.querySelector<HTMLElement>('[data-threshold-root]');
      if (root) {
        const stateNode = root.querySelector<HTMLElement>('[data-state]');
        const footerState = root.querySelector<HTMLElement>('[data-footer-state]');
        const rendererNode = root.querySelector<HTMLElement>('[data-renderer]');
        const logNode = root.querySelector<HTMLElement>('[data-log]');
        const liveNode = root.querySelector<HTMLElement>('[data-live]');

        const copy = {
          DORMANT: 'WAITING FOR SIGNAL · ENTRY NOT COMMITTED',
          AWARE: 'PRESENCE MODULATES FIELD · IDENTITY UNKNOWN',
          OPEN: 'APERTURE STABLE · EXPLICIT CHOICE REQUIRED',
        } as const;

        root.addEventListener('kdx:threshold-recovery-state', (event) => {
          const detail = (event as CustomEvent<{ state: keyof typeof copy; renderer: string }>).detail;
          if (!detail) return;
          root.dataset.visualState = detail.state;
          if (stateNode) stateNode.textContent = detail.state;
          if (footerState) footerState.textContent = detail.state;
          if (rendererNode) rendererNode.textContent = `RENDERER / ${detail.renderer}`;
          if (logNode) logNode.textContent = copy[detail.state] ?? copy.DORMANT;
          if (liveNode) liveNode.textContent = `Threshold visual state ${detail.state}. Crossing remains an explicit action.`;
        });
      }
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html), :global(body) {
    margin: 0;
    width: 100%;
    height: 100%;
    background: #020203;
  }
  :global(body) {
    overflow: hidden;
    color: #f1f0ed;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  :global(a) { color: inherit; }

  :root {
    --black: #020203;
    --panel: rgb(3 3 5 / .58);
    --line: rgb(255 255 255 / .12);
    --line-strong: rgb(255 51 64 / .52);
    --red: #ff3141;
    --red-soft: #c52334;
    --white: #f1f0ed;
    --muted: rgb(241 240 237 / .49);
    --muted-2: rgb(241 240 237 / .28);
  }

  .threshold {
    position: relative;
    width: 100vw;
    height: 100svh;
    min-height: 40rem;
    overflow: hidden;
    isolation: isolate;
    background: var(--black);
  }

  .threshold__renderer { z-index: 0; }

  .threshold__scan,
  .threshold__vignette,
  .threshold__grid,
  .threshold__rings {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .threshold__scan {
    z-index: 1;
    opacity: .26;
    background: repeating-linear-gradient(0deg, rgb(255 255 255 / .035) 0 1px, transparent 1px 4px);
    mix-blend-mode: screen;
  }

  .threshold__grid {
    z-index: 1;
    opacity: .3;
    background-image:
      linear-gradient(rgb(255 255 255 / .035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / .035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(circle at 52% 46%, black, transparent 73%);
  }

  .threshold__vignette {
    z-index: 2;
    background:
      linear-gradient(90deg, rgb(0 0 0 / .82) 0 23%, transparent 39% 67%, rgb(0 0 0 / .64) 100%),
      linear-gradient(0deg, rgb(0 0 0 / .86) 0 18%, transparent 37% 77%, rgb(0 0 0 / .42));
  }

  .threshold__rings {
    z-index: 2;
    left: 52%;
    top: 47%;
    width: min(72vw, 72vh);
    height: min(72vw, 72vh);
    inset: auto;
    transform: translate(-50%, -50%);
    border: 1px solid rgb(255 49 65 / .19);
    border-radius: 50%;
    box-shadow:
      0 0 0 9vw rgb(255 49 65 / .018),
      0 0 0 18vw rgb(255 49 65 / .012);
  }
  .threshold__rings::before,
  .threshold__rings::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    border: 1px dashed rgb(255 49 65 / .13);
  }
  .threshold__rings::before { inset: 16%; }
  .threshold__rings::after { inset: 35%; border-style: solid; }

  .threshold__topbar {
    position: absolute;
    z-index: 20;
    top: 0;
    left: 0;
    right: 0;
    min-height: 4.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: max(.8rem, env(safe-area-inset-top)) max(1.1rem, env(safe-area-inset-right)) .8rem max(1.1rem, env(safe-area-inset-left));
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, rgb(0 0 0 / .82), rgb(0 0 0 / .35));
    backdrop-filter: blur(9px);
  }

  .brand { display: flex; align-items: center; gap: clamp(1rem, 2.8vw, 3rem); }
  .brand strong {
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(1.4rem, 2.2vw, 2.2rem);
    line-height: 1;
    letter-spacing: -.055em;
  }
  .brand__signal,
  .topmeta {
    color: var(--muted);
    font-size: .62rem;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .brand__signal { display: flex; align-items: center; gap: .65rem; }
  .brand__signal i {
    width: .45rem;
    height: .45rem;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 1.2rem var(--red);
  }
  .topmeta { display: flex; gap: clamp(.75rem, 2vw, 2rem); align-items: center; }
  .accent { color: var(--red); }

  .threshold__rail {
    position: absolute;
    z-index: 15;
    top: 5.4rem;
    bottom: 9.2rem;
    width: clamp(2.5rem, 4vw, 3.6rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    color: var(--muted-2);
    font-size: .52rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }
  .threshold__rail b { color: rgb(241 240 237 / .62); font-weight: 500; }
  .threshold__rail--left { left: 0; border-right: 1px solid var(--line); }
  .threshold__rail--right {
    right: 0;
    width: clamp(11rem, 15vw, 14rem);
    writing-mode: horizontal-tb;
    align-items: stretch;
    justify-content: flex-start;
    padding: 1rem .9rem;
    border-left: 1px solid var(--line);
    background: linear-gradient(90deg, transparent, rgb(0 0 0 / .46));
  }

  .target {
    position: relative;
    display: grid;
    justify-items: end;
    gap: .25rem;
    padding: .3rem 0 1.2rem;
    border-bottom: 1px solid var(--line);
  }
  .target i {
    width: 3.2rem;
    height: 3.2rem;
    border: 1px solid var(--red);
    border-radius: 50%;
    box-shadow: inset 0 0 0 .75rem rgb(255 49 65 / .04);
  }
  .target i::before,
  .target i::after {
    content: '';
    position: absolute;
    right: 1.6rem;
    top: 1.9rem;
    background: var(--red);
  }
  .target i::before { width: 5rem; height: 1px; transform: translateX(50%); }
  .target i::after { width: 1px; height: 5rem; transform: translateY(-50%); }
  .target strong { color: var(--red); font-size: .63rem; letter-spacing: .14em; }
  .target span { color: var(--muted); font-size: .55rem; }

  .threshold__rail--right dl { margin: 1rem 0 0; }
  .threshold__rail--right dl div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: .75rem;
    padding: .55rem 0;
    border-bottom: 1px solid rgb(255 255 255 / .065);
  }
  .threshold__rail--right dt,
  .threshold__rail--right dd { margin: 0; }
  .threshold__rail--right dd { color: rgb(241 240 237 / .68); text-align: right; }

  .threshold__hero {
    position: absolute;
    z-index: 12;
    left: clamp(4.2rem, 8vw, 8rem);
    bottom: clamp(11rem, 19vh, 14rem);
    width: min(40rem, 39vw);
  }
  .threshold__kicker {
    margin: 0 0 1rem;
    color: var(--red);
    font-size: .57rem;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  .threshold h1 {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(3.25rem, 6.2vw, 7.5rem);
    font-weight: 800;
    line-height: .79;
    letter-spacing: -.07em;
    text-transform: uppercase;
    text-wrap: balance;
    text-shadow: 0 0 2rem rgb(0 0 0 / .75);
  }
  .threshold__question {
    max-width: 43ch;
    margin: 1.25rem 0 0;
    color: rgb(241 240 237 / .88);
    font-size: clamp(.62rem, .7vw, .72rem);
    line-height: 1.55;
    letter-spacing: .13em;
  }
  .threshold__lede {
    max-width: 48ch;
    margin: .85rem 0 0;
    color: var(--muted);
    font-size: clamp(.66rem, .78vw, .82rem);
    line-height: 1.6;
  }

  .threshold__entry {
    position: absolute;
    z-index: 22;
    left: 50%;
    bottom: 7.1rem;
    width: min(40rem, 48vw);
    transform: translateX(-50%);
  }
  .entry {
    min-height: 4.6rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: 1fr auto;
    align-items: center;
    gap: .1rem 1rem;
    padding: .8rem 1.25rem;
    border: 1px solid var(--red);
    border-radius: .65rem;
    background: linear-gradient(90deg, rgb(25 2 8 / .82), rgb(3 3 5 / .86), rgb(25 2 8 / .76));
    box-shadow: 0 0 1.8rem rgb(255 49 65 / .12), inset 0 0 1.5rem rgb(255 49 65 / .035);
    text-decoration: none;
    backdrop-filter: blur(12px);
    transition: border-color .2s ease, background .2s ease, transform .2s ease;
  }
  .entry:hover,
  .entry:focus-visible {
    outline: none;
    border-color: #fff;
    background: rgb(36 5 13 / .88);
    transform: translateY(-1px);
  }
  .entry__index { grid-row: 1 / 3; color: var(--red); font-size: .7rem; }
  .entry strong {
    justify-self: center;
    color: var(--red);
    font-size: clamp(1rem, 1.6vw, 1.45rem);
    letter-spacing: .2em;
    font-weight: 500;
  }
  .entry__arrow { grid-row: 1 / 3; color: var(--red); font-size: 1.6rem; }
  .entry small {
    grid-column: 2;
    justify-self: center;
    color: var(--muted);
    font-size: .5rem;
    letter-spacing: .18em;
  }

  .threshold__journey {
    position: absolute;
    z-index: 21;
    left: max(4.4rem, 6vw);
    right: max(12rem, 17vw);
    bottom: 3.15rem;
    padding: .5rem 0;
  }
  .journey__labels {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    color: var(--muted);
    font-size: .55rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .journey__labels strong { color: var(--white); font-size: .8rem; }
  .journey__labels span:last-child { text-align: right; color: rgb(255 49 65 / .82); }
  .journey__line {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    align-items: center;
    margin-top: .65rem;
    height: 1px;
    background: rgb(255 255 255 / .16);
  }
  .journey__line i {
    justify-self: center;
    width: .55rem;
    height: .55rem;
    border: 1px solid rgb(255 255 255 / .23);
    border-radius: 50%;
    background: #020203;
  }
  .journey__line i.active { border-color: var(--red); background: var(--red); box-shadow: 0 0 1rem var(--red); }

  .threshold__footer {
    position: absolute;
    z-index: 25;
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 2.6rem;
    display: grid;
    grid-template-columns: 1.1fr 2.3fr 1fr 1.7fr;
    border-top: 1px solid var(--line);
    background: rgb(0 0 0 / .76);
    backdrop-filter: blur(10px);
  }
  .footer__cell {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .15rem;
    padding: .45rem .75rem;
    border-right: 1px solid var(--line);
    color: var(--muted);
    font-size: .48rem;
    line-height: 1.25;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .footer__cell:last-child { border-right: 0; }
  .footer__cell b,
  .footer__cell strong { color: var(--white); font-weight: 600; }
  .footer__cell--log span { color: rgb(255 49 65 / .78); }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .threshold { min-height: 0; }
    .threshold__topbar {
      min-height: 4rem;
      padding-inline: .85rem;
    }
    .brand { width: 100%; justify-content: space-between; }
    .brand strong { font-size: 1.65rem; }
    .brand__signal { font-size: .51rem; }
    .topmeta { display: none; }

    .threshold__vignette {
      background:
        linear-gradient(0deg, rgb(0 0 0 / .93) 0 38%, transparent 64% 100%),
        radial-gradient(circle at 50% 34%, transparent 0 25%, rgb(0 0 0 / .12) 47%, rgb(0 0 0 / .5));
    }
    .threshold__grid { opacity: .22; background-size: 36px 36px; }
    .threshold__rings {
      left: 50%;
      top: 34%;
      width: 76vw;
      height: 76vw;
    }

    .threshold__rail--left { display: none; }
    .threshold__rail--right {
      top: 4.2rem;
      bottom: auto;
      left: .85rem;
      right: .85rem;
      width: auto;
      height: 2rem;
      padding: 0;
      border: 0;
      background: none;
    }
    .target {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: .65rem;
      padding: 0;
      border: 0;
    }
    .target i { width: 1.65rem; height: 1.65rem; }
    .target i::before,
    .target i::after { display: none; }
    .target strong { font-size: .52rem; }
    .target span { font-size: .48rem; }
    .threshold__rail--right dl { display: none; }

    .threshold__hero {
      left: 1rem;
      right: 1rem;
      bottom: 10.9rem;
      width: auto;
    }
    .threshold__kicker { margin-bottom: .6rem; font-size: .47rem; }
    .threshold h1 {
      max-width: 9ch;
      font-size: clamp(2.8rem, 13.5vw, 4.7rem);
      line-height: .82;
    }
    .threshold__question {
      max-width: 38ch;
      margin-top: .75rem;
      font-size: .55rem;
    }
    .threshold__lede {
      max-width: 41ch;
      margin-top: .55rem;
      font-size: .62rem;
      line-height: 1.45;
    }

    .threshold__entry {
      left: 1rem;
      right: 1rem;
      bottom: 5.35rem;
      width: auto;
      transform: none;
    }
    .entry {
      min-height: 3.85rem;
      border-radius: .5rem;
      padding: .65rem .85rem;
    }
    .entry strong { font-size: .92rem; letter-spacing: .16em; }
    .entry__arrow { font-size: 1.25rem; }

    .threshold__journey {
      left: 1rem;
      right: 1rem;
      bottom: 2.65rem;
      padding: .25rem 0;
    }
    .journey__labels { font-size: .46rem; }
    .journey__labels strong { font-size: .67rem; }
    .journey__line { margin-top: .42rem; }

    .threshold__footer {
      min-height: 2.3rem;
      grid-template-columns: 1fr 1.4fr;
    }
    .footer__cell { font-size: .41rem; padding: .35rem .5rem; }
    .footer__cell:nth-child(3),
    .footer__cell:nth-child(4) { display: none; }
  }

  @media (max-width: 430px) and (max-height: 880px) {
    .threshold__hero { bottom: 10.25rem; }
    .threshold h1 { font-size: clamp(2.55rem, 12.7vw, 4rem); }
    .threshold__lede { display: none; }
    .threshold__question { margin-top: .65rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand__signal i,
    .journey__line i.active { box-shadow: none; }
    .entry { transition: none; }
  }
</style>
