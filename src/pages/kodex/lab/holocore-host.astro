---
import Base from '../../../layouts/Base.astro';
import KodexHoloCoreRendererHost from '../../../components/kodex/holocore/KodexHoloCoreRendererHost.astro';
---

<Base title="KODEX−∞ · HoloCore Renderer Host" description="Internal KODEX lab proving one bounded HoloCore chamber can host multiple renderer technologies without assigning them canonically to nodes." robots="noindex, nofollow" kodexFonts={true} noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}>
  <main class="host-page" aria-labelledby="host-title">
    <header class="host-page__header">
      <div><p>KODEX−∞ // SYSTEMS LAB // RENDERER HOST V0</p><h1 id="host-title">ONE CHAMBER</h1></div>
      <div class="host-page__contract"><span>CONCEPT</span><strong>+</strong><span>RENDERER PLAN</span><strong>→</strong><span>HOLOCORE</span></div>
    </header>

    <aside class="host-page__left"><span>H-01</span><p>THE CONCEPT DOES NOT HAVE TO SHARE THE SAME MATERIALITY.</p></aside>
    <section class="host-page__core" aria-label="Unified HoloCore renderer host"><KodexHoloCoreRendererHost /></section>
    <aside class="host-page__right"><p>ASCII</p><p>RASTER</p><p>WEBGL</p><hr/><p>ARTWORK</p><small>GATED</small></aside>

    <footer class="host-page__footer" aria-label="Renderer host lab modes">
      <a href="?renderer=ascii-field&specimen=signal-core">01 ASCII · SIGNAL CORE</a>
      <a href="?renderer=raster2d-lowres">02 LOW-RES RASTER</a>
      <a href="?renderer=webgl-shader">03 WEBGL SOURCE</a>
      <strong>LAB SELECTION ≠ CANONICAL NODE ASSIGNMENT</strong>
    </footer>
  </main>
</Base>

<style is:global>html:has(.host-page),body:has(.host-page){margin:0;width:100%;min-height:100%;overflow:hidden;background:#020204}</style>
<style>
  .host-page{box-sizing:border-box;width:100%;height:100dvh;display:grid;grid-template-columns:clamp(48px,6vw,78px) minmax(0,1fr) clamp(64px,8vw,110px);grid-template-rows:clamp(74px,10vh,102px) minmax(0,1fr) clamp(58px,8vh,80px);grid-template-areas:"header header header" "left core right" "footer footer footer";padding:10px;overflow:hidden;background:#020204;color:#eeeaf2;font-family:'Share Tech Mono',ui-monospace,monospace}
  .host-page__header{grid-area:header;display:flex;align-items:center;justify-content:space-between;gap:20px;min-width:0;padding:0 clamp(10px,2vw,24px);border:1px solid rgba(255,255,255,.09)}.host-page__header p{margin:0;font-size:8px;letter-spacing:.16em;color:rgba(230,224,238,.45)}.host-page h1{margin:5px 0 0;font-family:'Cormorant Garamond','Times New Roman',serif;font-size:clamp(32px,5vw,66px);font-weight:400;line-height:.86;letter-spacing:.09em}.host-page__contract{display:flex;align-items:center;gap:10px;font-size:7px;letter-spacing:.11em;color:rgba(230,224,238,.42)}.host-page__contract strong{font-size:14px;color:#d9c9ff;font-weight:400}
  .host-page__left,.host-page__right{min-height:0;overflow:hidden;padding:10px 6px;font-size:7px;line-height:1.4;letter-spacing:.1em;color:rgba(230,224,238,.44)}.host-page__left{grid-area:left;border-right:1px solid rgba(255,255,255,.08)}.host-page__right{grid-area:right;border-left:1px solid rgba(255,255,255,.08);display:flex;flex-direction:column;justify-content:center;gap:12px}.host-page__left p{writing-mode:vertical-rl;transform:rotate(180deg);margin:18px auto 0}.host-page__left span{color:#d9c9ff}.host-page__right p,.host-page__right small{margin:0}.host-page__right hr{width:100%;border:0;border-top:1px solid rgba(255,255,255,.08)}.host-page__right small{color:#8d8698}
  .host-page__core{grid-area:core;min-width:0;min-height:0;padding:clamp(7px,1.1vw,14px)}
  .host-page__footer{grid-area:footer;display:grid;grid-template-columns:repeat(3,auto) minmax(0,1fr);align-items:center;gap:clamp(8px,1.8vw,24px);padding:0 clamp(8px,2vw,24px);border:1px solid rgba(255,255,255,.09)}.host-page__footer a,.host-page__footer strong{font-size:7px;line-height:1.2;letter-spacing:.1em}.host-page__footer a{color:rgba(214,200,232,.7);text-decoration:none}.host-page__footer a:hover,.host-page__footer a:focus-visible{color:#fff;text-decoration:underline;outline:none}.host-page__footer strong{justify-self:end;text-align:right;color:rgba(230,224,238,.42);font-weight:500}
  @media(max-width:700px){.host-page{grid-template-columns:32px minmax(0,1fr) 38px;grid-template-rows:70px minmax(0,1fr) 56px;padding:6px}.host-page__header{padding:0 7px}.host-page__contract{display:none}.host-page h1{font-size:clamp(28px,9vw,40px)}.host-page__left,.host-page__right{padding:7px 3px;font-size:5px}.host-page__core{padding:5px}.host-page__footer{grid-template-columns:repeat(3,1fr);gap:2px;padding:0 3px}.host-page__footer a{font-size:5px;text-align:center}.host-page__footer strong{display:none}}
</style>
