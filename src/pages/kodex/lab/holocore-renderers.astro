---
import Base from '../../../layouts/Base.astro';
import KodexHoloCoreRendererLab from '../../../components/kodex/holocore/KodexHoloCoreRendererLab.astro';
---

<Base
  title="KODEX−∞ · HoloCore Renderer Adapters"
  description="Internal KODEX lab proving a native low-resolution raster renderer with optional existing CRT WebGL surface."
  robots="noindex, nofollow"
  kodexFonts={true}
  noNav={true}
  noFooter={true}
  noOverlays={true}
  noQuote={true}
  noThemes={true}
  noKai={true}
  noCart={true}
  noImmersive={true}
>
  <main class="renderer-page" aria-labelledby="renderer-title">
    <header class="renderer-page__header">
      <div>
        <p>KODEX−∞ // SYSTEMS LAB // RENDERER ADAPTER V0</p>
        <h1 id="renderer-title">LOW-RES SIGNAL</h1>
      </div>
      <dl>
        <div><dt>CONTENT</dt><dd>RASTER2D · 320×240</dd></div>
        <div><dt>CADENCE</dt><dd>15 VISUAL FPS</dd></div>
        <div><dt>SURFACE</dt><dd>EXISTING KODEX CRT / WEBGL2</dd></div>
        <div><dt>FALLBACK</dt><dd>PIXELATED SOURCE CANVAS</dd></div>
      </dl>
    </header>

    <aside class="renderer-page__left" aria-label="renderer thesis">
      <span>R-01</span>
      <p>DO NOT PIXELATE THE FINAL IMAGE.</p>
      <p>RENDER LOW FIRST.</p>
    </aside>

    <section class="renderer-page__core" aria-label="Low-resolution HoloCore renderer proof">
      <KodexHoloCoreRendererLab />
    </section>

    <aside class="renderer-page__right" aria-label="renderer contract">
      <p>CONTENT RENDERER</p>
      <strong>≠</strong>
      <p>SURFACE PIPELINE</p>
      <hr />
      <p>REFERENCE LAW</p>
      <strong>≠</strong>
      <p>SOURCE COPY</p>
    </aside>

    <footer class="renderer-page__footer">
      <span>01 LOW-RES BUFFER</span>
      <span>02 LIMITED PALETTE</span>
      <span>03 VISUAL CADENCE</span>
      <span>04 CRT SURFACE</span>
      <strong>RASTER/EARLY-COMPUTER FAMILY · SYNTHETIC KODEX PROOF</strong>
    </footer>
  </main>
</Base>

<style is:global>
  html:has(.renderer-page),
  body:has(.renderer-page) {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow: hidden;
    background: #020204;
  }
</style>

<style>
  .renderer-page {
    box-sizing: border-box;
    width: 100%;
    height: 100dvh;
    display: grid;
    grid-template-columns: clamp(52px, 7vw, 86px) minmax(0, 1fr) clamp(74px, 9vw, 122px);
    grid-template-rows: clamp(78px, 11vh, 112px) minmax(0, 1fr) clamp(58px, 8vh, 82px);
    grid-template-areas:
      "header header header"
      "left core right"
      "footer footer footer";
    padding: 10px;
    overflow: hidden;
    background: #020204;
    color: #eeeaf2;
    font-family: 'Share Tech Mono', ui-monospace, monospace;
  }

  .renderer-page__header {
    grid-area: header;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-width: 0;
    padding: 0 clamp(10px, 2vw, 24px);
    border: 1px solid rgba(125,233,255,.16);
  }
  .renderer-page__header p { margin: 0; font-size: 8px; letter-spacing: .16em; color: rgba(230,224,238,.45); }
  .renderer-page h1 {
    margin: 5px 0 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-size: clamp(32px, 5vw, 68px);
    font-weight: 400;
    line-height: .86;
    letter-spacing: .09em;
  }
  .renderer-page__header dl { display: grid; grid-template-columns: auto auto; gap: 4px 14px; margin: 0; font-size: 7px; letter-spacing: .08em; }
  .renderer-page__header dl div { display: contents; }
  .renderer-page__header dt { color: rgba(230,224,238,.34); }
  .renderer-page__header dd { margin: 0; color: rgba(125,233,255,.72); }

  .renderer-page__left,
  .renderer-page__right {
    min-height: 0;
    overflow: hidden;
    padding: 10px 7px;
    color: rgba(230,224,238,.44);
    font-size: 7px;
    line-height: 1.4;
    letter-spacing: .1em;
  }
  .renderer-page__left { grid-area: left; border-right: 1px solid rgba(125,233,255,.14); }
  .renderer-page__right { grid-area: right; border-left: 1px solid rgba(125,233,255,.14); display: flex; flex-direction: column; justify-content: center; gap: 8px; }
  .renderer-page__left p { writing-mode: vertical-rl; transform: rotate(180deg); margin: 18px auto 0; }
  .renderer-page__left span { color: #7de9ff; }
  .renderer-page__right p { margin: 0; }
  .renderer-page__right strong { color: #7de9ff; font-size: 12px; font-weight: 400; }
  .renderer-page__right hr { width: 100%; border: 0; border-top: 1px solid rgba(255,255,255,.08); }

  .renderer-page__core { grid-area: core; min-width: 0; min-height: 0; padding: clamp(7px, 1.2vw, 15px); }

  .renderer-page__footer {
    grid-area: footer;
    display: grid;
    grid-template-columns: repeat(4, auto) minmax(0, 1fr);
    align-items: center;
    gap: clamp(8px, 1.7vw, 22px);
    padding: 0 clamp(8px, 2vw, 24px);
    border: 1px solid rgba(125,233,255,.16);
    font-size: 7px;
    line-height: 1.2;
    letter-spacing: .1em;
    color: rgba(230,224,238,.46);
  }
  .renderer-page__footer strong { justify-self: end; text-align: right; color: rgba(125,233,255,.66); font-weight: 500; }

  @media (max-width: 700px) {
    .renderer-page {
      grid-template-columns: 34px minmax(0, 1fr) 42px;
      grid-template-rows: 74px minmax(0, 1fr) 56px;
      padding: 6px;
    }
    .renderer-page__header { padding: 0 7px; }
    .renderer-page__header dl { display: none; }
    .renderer-page h1 { font-size: clamp(28px, 9vw, 42px); }
    .renderer-page__left,
    .renderer-page__right { padding: 7px 3px; font-size: 5px; }
    .renderer-page__right strong { font-size: 9px; }
    .renderer-page__core { padding: 5px; }
    .renderer-page__footer { grid-template-columns: repeat(4, 1fr); gap: 2px; padding: 0 3px; font-size: 5px; text-align: center; }
    .renderer-page__footer strong { display: none; }
  }
</style>
