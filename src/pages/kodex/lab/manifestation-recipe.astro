---
import Base from '../../../layouts/Base.astro';
---

<Base
  title="KODEX Lab — Manifestation Recipe P0.4"
  description="Internal deterministic bridge from generative geometry and route memory into the existing KodexWorld compositor."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="kdx-mrecipe" data-kdx-manifestation-recipe data-ready="false">
    <canvas class="kdx-mrecipe__world" data-world aria-label="KODEX manifestation recipe WebGL proof"></canvas>
    <div class="kdx-mrecipe__veil" aria-hidden="true"></div>

    <header class="kdx-mrecipe__header">
      <div>
        <p>KODEX−∞ / P0.4 / EXISTING RUNTIME BRIDGE</p>
        <h1>MANIFESTATION RECIPE</h1>
      </div>
      <dl>
        <div><dt>STATE</dt><dd data-state>DORMANT</dd></div>
        <div><dt>PLAN</dt><dd data-plan-id>COMPILING</dd></div>
        <div><dt>MEMORY</dt><dd data-memory-id>—</dd></div>
        <div><dt>FPS</dt><dd data-fps>0</dd></div>
        <div><dt>PASSES</dt><dd data-passes>0</dd></div>
        <div><dt>TIER</dt><dd data-tier>HIGH</dd></div>
      </dl>
    </header>

    <section class="kdx-mrecipe__center" data-interaction-field>
      <div class="kdx-mrecipe__reticle" aria-hidden="true">
        <i></i><i></i><i></i>
      </div>
      <div class="kdx-mrecipe__center-copy">
        <span>GEOMETRY</span>
        <strong data-geometry>CIRCLE_SPHERE + NESTED_SCALE + SPIRAL_HELIX</strong>
        <small>DWELL TO OPEN · MOVE TO DISTURB FIELD</small>
      </div>
    </section>

    <aside class="kdx-mrecipe__panel" aria-label="Manifestation recipe controls">
      <section>
        <p>SOURCE CONTRACT</p>
        <strong>OCN-MND-GRY-002</strong>
        <dl class="kdx-mrecipe__compact">
          <div><dt>ACTIVATION</dt><dd>APERTURE_BREATH</dd></div>
          <div><dt>PIXELS</dt><dd data-source-pixel-status>CHECKING</dd></div>
          <div><dt>RUNTIME SOURCE</dt><dd>PROCEDURAL_NEUTRAL_FALLBACK</dd></div>
        </dl>
        <p class="kdx-mrecipe__boundary">Protected Ocín source bytes are not rendered here. The existing source-integrity contract is shown and obeyed; the live field is a neutral procedural substrate until an approved derivative exists.</p>
      </section>

      <section>
        <p>OPERATOR CROSSWALK</p>
        <dl class="kdx-mrecipe__compact">
          <div><dt>RADIAL_SYMMETRY</dt><dd data-mirror-runtime>mirror.frag</dd></div>
          <div><dt>DISTORT</dt><dd>distort.frag</dd></div>
          <div><dt>COLOR</dt><dd>color.frag</dd></div>
          <div><dt>FEEDBACK</dt><dd>ping-pong</dd></div>
        </dl>
      </section>

      <section class="kdx-mrecipe__sliders">
        <p>LIVE PARAMETERS</p>
        <label>SEGMENTS <output data-segments-out>6</output><input data-segments type="range" min="2" max="16" step="1" value="6" /></label>
        <label>SYMMETRY MIX <output data-mix-out>.88</output><input data-mix type="range" min="0" max="1" step=".01" value=".88" /></label>
        <label>DISTORT <output data-distort-out>.08</output><input data-distort type="range" min="0" max=".3" step=".01" value=".08" /></label>
        <label>FEEDBACK <output data-feedback-out>.91</output><input data-feedback type="range" min=".80" max=".97" step=".005" value=".91" /></label>
      </section>

      <section>
        <p>MEMORY INPUT</p>
        <div class="kdx-mrecipe__buttons">
          <button type="button" data-memory-preset="SEED">SEED</button>
          <button type="button" data-memory-preset="ORBIT">ORBIT</button>
          <button type="button" data-memory-preset="WEAVE">WEAVE</button>
        </div>
        <dl class="kdx-mrecipe__compact">
          <div><dt>TOPOLOGY</dt><dd data-memory-topology>SEED_POINT</dd></div>
          <div><dt>REVISIT RATIO</dt><dd data-revisit-ratio>0</dd></div>
          <div><dt>BRANCH FACTOR</dt><dd data-branch-factor>0</dd></div>
          <div><dt>DEPTH BAND</dt><dd data-depth-band>0</dd></div>
        </dl>
      </section>

      <section>
        <p>EXISTING KODEXWORLD PHASES</p>
        <div class="kdx-mrecipe__buttons kdx-mrecipe__buttons--states">
          <button type="button" data-state-button="DORMANT">DORMANT</button>
          <button type="button" data-state-button="AWARE">AWARE</button>
          <button type="button" data-state-button="OPEN">OPEN</button>
          <button type="button" data-state-button="RETURN">RETURN</button>
        </div>
      </section>
    </aside>

    <footer class="kdx-mrecipe__footer">
      <span>MEANING → GEOMETRY → RECIPE → KODEXWORLD → MEMORY → RETURN</span>
      <span>NO NEW RENDERER · NO NEW MEMORY · NO NEW ROUTE ENGINE</span>
      <span data-status>INITIALIZING</span>
    </footer>
  </main>
</Base>

<script>
  import { KodexWorld } from '../../../kodex/engine/kodexWorld.js';
  import {
    KDX_MANIFESTATION_RECIPE_DEMOS,
    compileManifestationRecipe,
  } from '../../../lib/kodex/grammar/manifestation-recipe.js';
  import {
    createMicroUniverseState,
    enterMicroUniverseNode,
  } from '../../../lib/kodex/micro-universe.js';
  import { buildGeometricMemorySignature } from '../../../lib/kodex/geometric-memory-signature.js';

  const root = document.querySelector('[data-kdx-manifestation-recipe]');
  const canvas = root?.querySelector('[data-world]');

  if (root && canvas instanceof HTMLCanvasElement) {
    const $ = (selector) => root.querySelector(selector);
    const setText = (selector, value) => { const el = $(selector); if (el) el.textContent = String(value); };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const baseRecipe = KDX_MANIFESTATION_RECIPE_DEMOS.COSMOLOGY_RADIAL_001;
    const memorySequences = {
      SEED: [],
      ORBIT: ['SCI-PATTERN', 'SCI-COSMOS', 'SCI-BIOLOGY'],
      WEAVE: ['SCI-PATTERN', 'SCI-COSMOS', 'SCI-BIOLOGY', 'ART-FORM'],
    };
    let currentLabel = 'DORMANT';
    let currentPlan = null;
    let currentMemory = null;
    let dwellTimer = 0;
    let returnTimer = 0;

    const world = new KodexWorld(canvas, {
      maxDpr: 1.5,
      renderTier: reduced ? 'STATIC' : 'HIGH',
      onTelemetry(telemetry) {
        setText('[data-fps]', telemetry.fps ?? 0);
        setText('[data-passes]', telemetry.passes ?? 0);
        setText('[data-tier]', reduced ? 'STATIC / REDUCED' : telemetry.renderTier || 'HIGH');
        window.__KDX_MANIFESTATION_LAB__ = {
          ...(window.__KDX_MANIFESTATION_LAB__ || {}),
          telemetry,
          ready: true,
        };
      },
    });

    const makeNeutralSource = () => {
      const source = document.createElement('canvas');
      source.width = 128;
      source.height = 128;
      const ctx = source.getContext('2d');
      ctx.fillStyle = '#090909';
      ctx.fillRect(0, 0, 128, 128);
      ctx.strokeStyle = '#bdbdb4';
      ctx.lineWidth = 1;
      ctx.globalAlpha = 0.72;
      for (let r = 12; r <= 58; r += 8) {
        ctx.beginPath();
        ctx.arc(64, 64, r, 0, Math.PI * 2);
        ctx.stroke();
      }
      ctx.globalAlpha = 0.28;
      for (let i = 0; i < 12; i += 1) {
        const a = (i / 12) * Math.PI * 2;
        ctx.beginPath();
        ctx.moveTo(64, 64);
        ctx.lineTo(64 + Math.cos(a) * 62, 64 + Math.sin(a) * 62);
        ctx.stroke();
      }
      return source.toDataURL('image/png');
    };

    const buildMemory = (key) => {
      const sequence = memorySequences[key] || [];
      let state = createMicroUniverseState({ routeSignature: `KDX-MANIFESTATION-${key}` });
      for (const nodeId of sequence) state = enterMicroUniverseNode(state, nodeId, 'CONTINUITY');
      return buildGeometricMemorySignature(state);
    };

    const renderPlanTrace = () => {
      if (!currentPlan) return;
      setText('[data-plan-id]', currentPlan.plan_id);
      setText('[data-memory-id]', currentPlan.memory_influence.source_signature_id || 'NONE');
      setText('[data-memory-topology]', currentPlan.memory_influence.source_topology || 'NONE');
      setText('[data-revisit-ratio]', currentPlan.memory_influence.revisit_ratio ?? 0);
      setText('[data-branch-factor]', currentPlan.memory_influence.branching_factor ?? 0);
      setText('[data-depth-band]', currentPlan.memory_influence.depth_band ?? 0);
      setText('[data-source-pixel-status]', currentPlan.source.source_pixel_status);
      setText('[data-geometry]', currentPlan.geometry_ids.join(' + '));
      const radial = currentPlan.operators.find((operator) => operator.id === 'RADIAL_SYMMETRY');
      if (radial) {
        const segments = $('[data-segments]');
        const mix = $('[data-mix]');
        segments.value = String(radial.params.segments);
        mix.value = String(radial.params.mix);
        setText('[data-segments-out]', radial.params.segments);
        setText('[data-mix-out]', radial.params.mix.toFixed(2));
      }
      window.__KDX_MANIFESTATION_LAB__ = {
        ...(window.__KDX_MANIFESTATION_LAB__ || {}),
        plan: currentPlan,
        memory: currentMemory,
        ready: true,
      };
    };

    const applyRecipe = (memoryKey = 'SEED') => {
      currentMemory = buildMemory(memoryKey);
      currentPlan = compileManifestationRecipe(
        { ...baseRecipe, render_tier: reduced ? 'STATIC' : 'HIGH' },
        { memorySignature: currentMemory },
      );
      world.applyPlan(currentPlan);
      currentLabel = 'DORMANT';
      setText('[data-state]', currentLabel);
      renderPlanTrace();
      if (reduced) world.renderOnce();
    };

    const setState = (label) => {
      if (!currentPlan) return;
      const phase = currentPlan.state_mapping[label];
      if (!phase) return;
      currentLabel = label;
      world.setState(phase);
      setText('[data-state]', label);
      root.dataset.state = label;
      if (reduced) world.renderOnce();
    };

    const bindRange = (selector, outputSelector, effectName, paramName, onValue) => {
      const input = $(selector);
      input?.addEventListener('input', () => {
        const value = Number(input.value);
        setText(outputSelector, onValue ? onValue(value) : value);
        if (effectName === 'feedback') {
          world.recipeDecay = value;
          setState(currentLabel);
        } else {
          world.setParam(effectName, paramName, value);
          if (world.recipeEffects?.[effectName]) world.recipeEffects[effectName].params[paramName] = value;
          if (reduced) world.renderOnce();
        }
      });
    };

    bindRange('[data-segments]', '[data-segments-out]', 'mirror', 'u_seg', (v) => String(Math.round(v)));
    bindRange('[data-mix]', '[data-mix-out]', 'mirror', 'u_mix', (v) => v.toFixed(2));
    bindRange('[data-distort]', '[data-distort-out]', 'distort', 'u_amt', (v) => v.toFixed(2));
    bindRange('[data-feedback]', '[data-feedback-out]', 'feedback', 'decay', (v) => v.toFixed(3));

    root.querySelectorAll('[data-state-button]').forEach((button) => {
      button.addEventListener('click', () => setState(button.getAttribute('data-state-button')));
    });

    root.querySelectorAll('[data-memory-preset]').forEach((button) => {
      button.addEventListener('click', () => applyRecipe(button.getAttribute('data-memory-preset')));
    });

    const field = $('[data-interaction-field]');
    const enter = () => {
      clearTimeout(returnTimer);
      clearTimeout(dwellTimer);
      if (currentLabel === 'DORMANT' || currentLabel === 'RETURN') setState('AWARE');
      dwellTimer = window.setTimeout(() => setState('OPEN'), currentPlan?.interaction?.dwell_ms || 1100);
    };
    const leave = () => {
      clearTimeout(dwellTimer);
      setState('RETURN');
      returnTimer = window.setTimeout(() => setState('DORMANT'), reduced ? 0 : 900);
    };
    field?.addEventListener('pointerenter', enter, { passive: true });
    field?.addEventListener('pointerleave', leave, { passive: true });
    field?.addEventListener('touchstart', enter, { passive: true });

    try {
      await world.loadArtwork(makeNeutralSource());
      applyRecipe('SEED');
      world.start();
      root.dataset.ready = 'true';
      setText('[data-status]', currentPlan.source_pixel_blocked ? 'LIVE ENGINE · PROTECTED PIXELS WITHHELD' : 'LIVE ENGINE');
      window.__KDX_MANIFESTATION_LAB__ = {
        ...(window.__KDX_MANIFESTATION_LAB__ || {}),
        world,
        ready: true,
      };
    } catch (error) {
      root.dataset.ready = 'error';
      setText('[data-status]', `ERROR: ${error?.message || error}`);
      console.error(error);
    }
  }
</script>

<style>
  :global(body) { margin:0; overflow:hidden; background:#050606; color:#eeeDE6; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; }
  .kdx-mrecipe { position:relative; width:100vw; height:100dvh; overflow:hidden; background:#030404; }
  .kdx-mrecipe__world,.kdx-mrecipe__veil { position:absolute; inset:0; width:100%; height:100%; }
  .kdx-mrecipe__world { display:block; }
  .kdx-mrecipe__veil { pointer-events:none; background:radial-gradient(circle at 50% 48%,transparent 0 22%,rgba(3,4,4,.08) 52%,rgba(3,4,4,.7) 100%); }
  .kdx-mrecipe__header { position:absolute; z-index:3; top:0; left:0; right:0; display:flex; justify-content:space-between; gap:24px; padding:18px 22px; border-bottom:1px solid rgba(230,235,225,.16); background:linear-gradient(180deg,rgba(3,4,4,.84),rgba(3,4,4,.18)); pointer-events:none; }
  .kdx-mrecipe p { margin:0; font-size:8px; letter-spacing:.14em; opacity:.56; }
  .kdx-mrecipe h1 { margin:5px 0 0; font-size:clamp(15px,2vw,26px); letter-spacing:.12em; font-weight:560; }
  .kdx-mrecipe__header dl { display:grid; grid-template-columns:repeat(6,minmax(70px,auto)); gap:16px; margin:0; }
  .kdx-mrecipe dt { font-size:7px; letter-spacing:.12em; opacity:.42; }
  .kdx-mrecipe dd { margin:4px 0 0; max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:9px; }
  .kdx-mrecipe__center { position:absolute; z-index:2; inset:13vh min(29vw,420px) 9vh 0; display:grid; place-items:center; touch-action:none; }
  .kdx-mrecipe__reticle { width:min(54vmin,560px); aspect-ratio:1; border:1px solid rgba(235,238,228,.18); border-radius:50%; display:grid; place-items:center; pointer-events:none; }
  .kdx-mrecipe__reticle i { position:absolute; display:block; border:1px solid rgba(235,238,228,.12); border-radius:50%; }
  .kdx-mrecipe__reticle i:nth-child(1){width:36vmin;height:36vmin}.kdx-mrecipe__reticle i:nth-child(2){width:22vmin;height:22vmin}.kdx-mrecipe__reticle i:nth-child(3){width:7vmin;height:7vmin;border-color:rgba(235,238,228,.4)}
  .kdx-mrecipe__center-copy { position:absolute; bottom:6%; left:50%; transform:translateX(-50%); width:min(650px,80%); text-align:center; pointer-events:none; }
  .kdx-mrecipe__center-copy span,.kdx-mrecipe__center-copy small { display:block; font-size:7px; letter-spacing:.15em; opacity:.48; }
  .kdx-mrecipe__center-copy strong { display:block; margin:6px 0; font-size:9px; font-weight:500; letter-spacing:.08em; }
  .kdx-mrecipe__panel { position:absolute; z-index:4; top:84px; right:14px; bottom:44px; width:min(350px,34vw); overflow:auto; padding:12px; border:1px solid rgba(230,235,225,.18); background:rgba(4,5,5,.82); backdrop-filter:blur(12px); }
  .kdx-mrecipe__panel section { padding:12px 6px 14px; border-bottom:1px solid rgba(230,235,225,.11); }
  .kdx-mrecipe__panel section:last-child { border-bottom:0; }
  .kdx-mrecipe__panel strong { display:block; margin:7px 0 10px; font-size:12px; font-weight:600; }
  .kdx-mrecipe__compact { display:grid; gap:6px; margin:9px 0 0; }
  .kdx-mrecipe__compact div { display:flex; justify-content:space-between; gap:12px; }
  .kdx-mrecipe__compact dd { text-align:right; max-width:190px; white-space:normal; font-size:8px; }
  .kdx-mrecipe__boundary { margin-top:10px!important; padding:8px; border-left:2px solid rgba(236,212,126,.65); color:#e8dcae; line-height:1.45; opacity:.82!important; }
  .kdx-mrecipe__sliders label { display:grid; grid-template-columns:1fr auto; gap:4px 12px; margin-top:10px; font-size:8px; letter-spacing:.08em; }
  .kdx-mrecipe__sliders input { grid-column:1/-1; width:100%; accent-color:#d9ddd5; }
  .kdx-mrecipe__sliders output { opacity:.64; }
  .kdx-mrecipe__buttons { display:flex; flex-wrap:wrap; gap:5px; margin-top:8px; }
  .kdx-mrecipe button { appearance:none; border:1px solid rgba(235,238,228,.22); background:rgba(0,0,0,.32); color:inherit; padding:7px 9px; font:8px ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.09em; cursor:pointer; }
  .kdx-mrecipe button:hover,.kdx-mrecipe button:focus-visible { background:#e7e9e2; color:#060707; outline:none; }
  .kdx-mrecipe__buttons--states { display:grid; grid-template-columns:1fr 1fr; }
  .kdx-mrecipe__footer { position:absolute; z-index:5; left:0; right:0; bottom:0; min-height:34px; display:flex; align-items:center; justify-content:space-between; gap:14px; padding:7px 14px; border-top:1px solid rgba(230,235,225,.15); background:rgba(3,4,4,.84); font-size:7px; letter-spacing:.1em; color:rgba(235,238,228,.56); }

  @media (max-width:760px) {
    .kdx-mrecipe__header { padding:10px 11px; gap:8px; }
    .kdx-mrecipe__header dl { grid-template-columns:repeat(3,minmax(54px,1fr)); gap:6px 8px; }
    .kdx-mrecipe__header dl div:nth-child(2),.kdx-mrecipe__header dl div:nth-child(3),.kdx-mrecipe__header dl div:nth-child(5) { display:none; }
    .kdx-mrecipe h1 { font-size:12px; }
    .kdx-mrecipe__center { inset:10vh 0 40vh; }
    .kdx-mrecipe__reticle { width:68vmin; }
    .kdx-mrecipe__panel { top:auto; left:8px; right:8px; bottom:40px; width:auto; height:36vh; padding:7px; display:grid; grid-auto-flow:column; grid-auto-columns:minmax(220px,72vw); overflow-x:auto; overflow-y:hidden; scroll-snap-type:x proximity; }
    .kdx-mrecipe__panel section { overflow:auto; border-right:1px solid rgba(230,235,225,.11); border-bottom:0; scroll-snap-align:start; padding:9px; }
    .kdx-mrecipe__footer { font-size:6px; }
    .kdx-mrecipe__footer span:nth-child(2) { display:none; }
  }

  @media (prefers-reduced-motion:reduce) {
    .kdx-mrecipe__veil { background:radial-gradient(circle at 50% 48%,transparent 0 24%,rgba(3,4,4,.16) 55%,rgba(3,4,4,.78) 100%); }
  }
</style>
