---
import KodexEffectCanvas from '../../../../components/kodex/effects/KodexEffectCanvas.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>KODEX−∞ Visible Assembly 01</title>
    <meta
      name="description"
      content="Internal noindex KODEX−∞ end-to-end journey assembly for KOD-47 QA."
    />
  </head>
  <body>
    <main
      class="kdx-va"
      data-kdx-visible-assembly
      data-stage="THRESHOLD"
      data-motion="full"
      aria-labelledby="kdx-va-title"
    >
      <header class="kdx-va__chrome">
        <div>
          <span>KODEX−∞</span>
          <span>VISIBLE ASSEMBLY 01</span>
          <span>INTERNAL / NOINDEX</span>
        </div>
        <div class="kdx-va__chrome-actions">
          <span>STATE <strong data-stage-label>THRESHOLD</strong></span>
          <button type="button" class="kdx-va__micro" data-motion-toggle>MOTION: FULL</button>
          <button type="button" class="kdx-va__micro" data-reset>RESET</button>
        </div>
      </header>

      <section class="kdx-va__scene kdx-va__scene--threshold" data-scene="THRESHOLD" aria-labelledby="kdx-va-title">
        <KodexEffectCanvas
          effectId="KDX-FX-002"
          class="kdx-va__field"
          alt="Computational lattice used as an atmospheric Threshold field."
          animate={false}
          interactive={false}
        />
        <div class="kdx-va__scan" aria-hidden="true"></div>
        <div class="kdx-va__scene-copy">
          <p class="kdx-va__eyebrow">A / −∞ / COMMON ORIGIN</p>
          <h1 id="kdx-va-title">The archive begins when you commit a relation.</h1>
          <p class="kdx-va__lede">
            Pointer movement changes atmosphere only. A deliberate choice writes semantic memory.
          </p>
          <div class="kdx-va__choice-grid" role="group" aria-label="Choose the first meaningful action">
            <button type="button" class="kdx-va__action" data-choice="OBSERVE">
              <span>01</span>
              <strong>OBSERVE</strong>
              <small>Make current relations explicit.</small>
            </button>
            <button type="button" class="kdx-va__action" data-choice="REMEMBER">
              <span>02</span>
              <strong>REMEMBER</strong>
              <small>Carry sequence as an active trace.</small>
            </button>
          </div>
        </div>
      </section>

      <section class="kdx-va__scene kdx-va__scene--archive" data-scene="ARCHIVE" aria-labelledby="archive-title" hidden>
        <KodexEffectCanvas
          effectId="KDX-FX-005"
          class="kdx-va__field"
          alt="Memory Decay Mesh used as an Archive background treatment."
          animate={false}
          interactive={false}
        />
        <div class="kdx-va__scan" aria-hidden="true"></div>
        <div class="kdx-va__archive-layout">
          <div class="kdx-va__scene-copy">
            <p class="kdx-va__eyebrow">ARCHIVE / EVIDENCE / PROVENANCE</p>
            <h2 id="archive-title">A source is not a decoration.</h2>
            <p class="kdx-va__lede" data-choice-copy>
              Your first choice is now part of the route.
            </p>
          </div>

          <article class="kdx-va__source" aria-labelledby="source-title">
            <div class="kdx-va__source-head">
              <span>BRIDGE 1 / VERIFIED RECORD</span>
              <span>REFERENCE ONLY</span>
            </div>
            <h3 id="source-title">PROTO-OBSERVE-001</h3>
            <dl>
              <div><dt>SOURCE ID</dt><dd>SRC-KDX-CORPUS-002</dd></div>
              <div><dt>NODE</dt><dd>NODE-KDX-CORPUS-002</dd></div>
              <div><dt>CREATOR</dt><dd>KODEX−∞ / Nicolás Ortega / Ocín</dd></div>
              <div><dt>EPISTEMIC</dt><dd>VERIFIED</dd></div>
              <div><dt>RIGHTS</dt><dd>REFERENCE_ONLY</dd></div>
              <div><dt>CULTURAL</dt><dd>STANDARD</dd></div>
              <div><dt>ROLES</dt><dd>THRESHOLD · ARCHIVE · REVEAL · TRACE · COMPARE</dd></div>
            </dl>
            <p class="kdx-va__source-path">
              Canonical record: <code>data/bridges/bridge-1-v0/sources.json</code>
            </p>
            <button type="button" class="kdx-va__action kdx-va__action--wide" data-open-evidence>
              <span>03</span>
              <strong>OPEN SOURCE RELATION</strong>
              <small>Commit this provenance access to the semantic route.</small>
            </button>
          </article>

          <div class="kdx-va__next" data-after-evidence hidden>
            <div class="kdx-va__next-copy">
              <strong>SOURCE RELATION COMMITTED</strong>
              <span>Heart is now available, but never required.</span>
            </div>
            <div class="kdx-va__next-actions">
              <button type="button" class="kdx-va__action" data-enter-heart>
                <span>M</span><strong>ENTER HEART / 0</strong><small>Optional detour. Preserve the Archive anchor.</small>
              </button>
              <button type="button" class="kdx-va__action" data-enter-return>
                <span>Y</span><strong>RETURN / +∞</strong><small>Converge from the route you actually made.</small>
              </button>
            </div>
          </div>
        </div>
      </section>

      <section class="kdx-va__scene kdx-va__scene--heart" data-scene="HEART" aria-labelledby="heart-title" hidden>
        <div class="kdx-va__heart-field" aria-hidden="true">
          <span class="kdx-va__heart-ring kdx-va__heart-ring--a"></span>
          <span class="kdx-va__heart-ring kdx-va__heart-ring--b"></span>
          <span class="kdx-va__heart-core"></span>
        </div>
        <div class="kdx-va__scene-copy kdx-va__scene-copy--center">
          <p class="kdx-va__eyebrow">M / HEART / 0 / OPTIONAL DISTRIBUTED DEPTH</p>
          <h2 id="heart-title">Nothing was ranked. Nothing was measured.</h2>
          <p class="kdx-va__lede">
            The system remembers the exact Archive anchor, source focus and choice that preceded this detour.
          </p>
          <div class="kdx-va__anchor" aria-live="polite">
            <span>RETURN ANCHOR</span>
            <strong data-anchor-focus>SRC-KDX-CORPUS-002</strong>
            <small data-anchor-state>ARCHIVE / OBSERVE</small>
          </div>
          <button type="button" class="kdx-va__action kdx-va__action--center" data-leave-heart>
            <span>↩</span><strong>RESTORE PRIOR ANCHOR</strong><small>Return to the exact semantic position before Heart.</small>
          </button>
        </div>
      </section>

      <section class="kdx-va__scene kdx-va__scene--return" data-scene="RETURN" aria-labelledby="return-title" hidden>
        <KodexEffectCanvas
          effectId="KDX-FX-006"
          class="kdx-va__field"
          alt="−∞ Dissolution used as a non-factual Return field."
          animate={false}
          interactive={false}
        />
        <div class="kdx-va__return-wash" aria-hidden="true"></div>
        <div class="kdx-va__scene-copy kdx-va__scene-copy--center kdx-va__scene-copy--return">
          <p class="kdx-va__eyebrow">Y / RETURN / +∞ / TRACE-DERIVED CONVERGENCE</p>
          <h2 id="return-title">The archive returns a trace, not a score.</h2>
          <p class="kdx-va__lede">
            This signature is deterministic from the privacy-minimized semantic event trace. It is not biometric, psychological or spiritual telemetry.
          </p>
          <output class="kdx-va__signature" data-return-signature aria-live="polite">KDX-R-00000000</output>
          <div class="kdx-va__return-meta">
            <span>FIRST ACTION <strong data-return-choice>—</strong></span>
            <span>HEART VISITS <strong data-heart-visits>0</strong></span>
            <span>SEMANTIC EVENTS <strong data-trace-count>0</strong></span>
          </div>
          <button type="button" class="kdx-va__action kdx-va__action--center" data-reenter>
            <span>↺</span><strong>RE-ENTER ARCHIVE</strong><small>Preserve the Return artifact and continue the living record.</small>
          </button>
        </div>
      </section>

      <footer class="kdx-va__footer" aria-live="polite">
        <span data-route-status>A → awaiting committed action</span>
        <span data-memory-status>MEMORY / 1 semantic event</span>
      </footer>
    </main>

    <script>
      import { createKodexInputController } from '../../../../lib/kodex/runtime/normalized-input';
      import {
        ARCHIVE_EVIDENCE,
        commitAssemblyChoice,
        completeReturn,
        createVisibleAssemblyState,
        enterHeart,
        leaveHeart,
        openArchiveEvidence,
        reenterArchive,
        restoreVisibleAssembly,
        serializeVisibleAssembly,
        setAssemblyMotion,
        type AssemblyChoice,
        type AssemblyMotion,
        type SerializedVisibleAssemblyState,
        type VisibleAssemblyState,
      } from '../../../../lib/kodex/runtime/visible-assembly';

      const STORAGE_KEY = 'kdx-visible-assembly-v1';
      const root = document.querySelector<HTMLElement>('[data-kdx-visible-assembly]');

      if (root) {
        const scenes = [...root.querySelectorAll<HTMLElement>('[data-scene]')];
        const stageLabel = root.querySelector<HTMLElement>('[data-stage-label]');
        const choiceCopy = root.querySelector<HTMLElement>('[data-choice-copy]');
        const afterEvidence = root.querySelector<HTMLElement>('[data-after-evidence]');
        const evidenceButton = root.querySelector<HTMLButtonElement>('[data-open-evidence]');
        const anchorFocus = root.querySelector<HTMLElement>('[data-anchor-focus]');
        const anchorState = root.querySelector<HTMLElement>('[data-anchor-state]');
        const signature = root.querySelector<HTMLOutputElement>('[data-return-signature]');
        const returnChoice = root.querySelector<HTMLElement>('[data-return-choice]');
        const heartVisits = root.querySelector<HTMLElement>('[data-heart-visits]');
        const traceCount = root.querySelector<HTMLElement>('[data-trace-count]');
        const routeStatus = root.querySelector<HTMLElement>('[data-route-status]');
        const memoryStatus = root.querySelector<HTMLElement>('[data-memory-status]');
        const motionToggle = root.querySelector<HTMLButtonElement>('[data-motion-toggle]');

        let state: VisibleAssemblyState = createVisibleAssemblyState();

        const readStored = (): VisibleAssemblyState | null => {
          try {
            const raw = localStorage.getItem(STORAGE_KEY);
            return raw
              ? restoreVisibleAssembly(JSON.parse(raw) as SerializedVisibleAssemblyState)
              : null;
          } catch {
            return null;
          }
        };

        const fromHistory = history.state?.kdxVisibleAssembly as SerializedVisibleAssemblyState | undefined;
        if (fromHistory) state = restoreVisibleAssembly(fromHistory);
        else {
          const stored = readStored();
          if (stored) state = stored;
          else if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            state = setAssemblyMotion(state, 'REDUCED');
          }
        }

        const motionForInput = (motion: AssemblyMotion) => motion.toLowerCase() as 'full' | 'reduced' | 'off';

        const input = createKodexInputController(root, {
          damping: 0.08,
          onFrame: (snapshot) => {
            if (state.motion === 'OFF') return;
            root.style.setProperty('--px', String(snapshot.pointer.x));
            root.style.setProperty('--py', String(snapshot.pointer.y));
          },
        });

        const routeText = () => {
          const choice = state.choice ?? '…';
          const heart = state.heartEntered ? ' → M → A′' : '';
          const terminal = state.stage === 'RETURN' ? ' → Y' : '';
          return `A → ${choice} → ARCHIVE${heart}${terminal}`;
        };

        const render = () => {
          root.dataset.stage = state.stage;
          root.dataset.motion = state.motion.toLowerCase();
          if (stageLabel) stageLabel.textContent = state.stage;
          if (motionToggle) motionToggle.textContent = `MOTION: ${state.motion}`;
          input.setMotionMode(motionForInput(state.motion));

          scenes.forEach((scene) => {
            const active = scene.dataset.scene === state.stage;
            scene.hidden = !active;
            scene.setAttribute('aria-hidden', String(!active));
          });

          if (choiceCopy) {
            choiceCopy.textContent = state.choice === 'OBSERVE'
              ? 'OBSERVE is committed. The Archive now foregrounds explicit relations and evidence.'
              : state.choice === 'REMEMBER'
                ? 'REMEMBER is committed. The Archive now foregrounds sequence and carried trace.'
                : 'Your first choice is now part of the route.';
          }

          if (evidenceButton) {
            evidenceButton.disabled = state.archiveOpened;
            const strong = evidenceButton.querySelector('strong');
            if (strong) strong.textContent = state.archiveOpened ? 'SOURCE RELATION OPEN' : 'OPEN SOURCE RELATION';
          }
          if (afterEvidence) afterEvidence.hidden = !state.archiveOpened;

          const anchor = state.journey.returnAnchor;
          if (anchorFocus) anchorFocus.textContent = anchor?.focus ?? ARCHIVE_EVIDENCE.sourceId;
          if (anchorState) anchorState.textContent = `${anchor?.world ?? 'ARCHIVE'} / ${anchor?.localState ?? state.choice ?? 'UNSET'}`;

          if (signature) signature.value = state.returnSignature ?? 'KDX-R-00000000';
          if (returnChoice) returnChoice.textContent = state.choice ?? '—';
          if (heartVisits) heartVisits.textContent = String(state.journey.heart.visitCount);
          if (traceCount) traceCount.textContent = String(state.journey.trace.length);
          if (routeStatus) routeStatus.textContent = routeText();
          if (memoryStatus) memoryStatus.textContent = `MEMORY / ${state.journey.trace.length} semantic events`;
        };

        const persist = (mode: 'push' | 'replace' = 'push') => {
          const serialized = serializeVisibleAssembly(state);
          localStorage.setItem(STORAGE_KEY, JSON.stringify(serialized));
          const nextHistory = { ...(history.state ?? {}), kdxVisibleAssembly: serialized };
          if (mode === 'replace') history.replaceState(nextHistory, '');
          else history.pushState(nextHistory, '');
        };

        root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((button) => {
          button.addEventListener('click', () => {
            state = commitAssemblyChoice(state, button.dataset.choice as AssemblyChoice);
            persist();
            render();
          });
        });

        evidenceButton?.addEventListener('click', () => {
          state = openArchiveEvidence(state);
          persist();
          render();
        });

        root.querySelector<HTMLButtonElement>('[data-enter-heart]')?.addEventListener('click', () => {
          state = enterHeart(state);
          persist();
          render();
        });

        root.querySelector<HTMLButtonElement>('[data-leave-heart]')?.addEventListener('click', () => {
          state = leaveHeart(state);
          persist();
          render();
        });

        root.querySelector<HTMLButtonElement>('[data-enter-return]')?.addEventListener('click', () => {
          state = completeReturn(state);
          persist();
          render();
        });

        root.querySelector<HTMLButtonElement>('[data-reenter]')?.addEventListener('click', () => {
          state = reenterArchive(state);
          persist();
          render();
        });

        motionToggle?.addEventListener('click', () => {
          const modes: AssemblyMotion[] = ['FULL', 'REDUCED', 'OFF'];
          const index = modes.indexOf(state.motion);
          state = setAssemblyMotion(state, modes[(index + 1) % modes.length] ?? 'FULL');
          persist();
          render();
        });

        root.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', () => {
          localStorage.removeItem(STORAGE_KEY);
          state = createVisibleAssemblyState();
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            state = setAssemblyMotion(state, 'REDUCED');
          }
          persist('replace');
          render();
        });

        addEventListener('popstate', (event) => {
          const snapshot = event.state?.kdxVisibleAssembly as SerializedVisibleAssemblyState | undefined;
          if (!snapshot) return;
          state = restoreVisibleAssembly(snapshot);
          localStorage.setItem(STORAGE_KEY, JSON.stringify(serializeVisibleAssembly(state)));
          render();
        });

        persist('replace');
        render();
        addEventListener('pagehide', () => input.destroy(), { once: true });
      }
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #030303; color-scheme: dark; }
  :global(body) { margin: 0; overflow: hidden; background: #030303; color: #eee9df; }
  :global(button) { font: inherit; }

  .kdx-va {
    --px: 0;
    --py: 0;
    --bone: #eee9df;
    --dim: rgb(238 233 223 / 0.52);
    --line: rgb(238 233 223 / 0.22);
    --violet: #9b72ff;
    --cyan: #65d9e8;
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
    background: #030303;
    color: var(--bone);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .kdx-va__chrome,
  .kdx-va__footer {
    position: absolute;
    z-index: 20;
    inset-inline: max(0.8rem, env(safe-area-inset-left)) max(0.8rem, env(safe-area-inset-right));
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--dim);
    font-size: clamp(0.58rem, 1.2vw, 0.72rem);
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .kdx-va__chrome { top: max(0.7rem, env(safe-area-inset-top)); align-items: flex-start; }
  .kdx-va__footer { bottom: max(0.65rem, env(safe-area-inset-bottom)); align-items: flex-end; }
  .kdx-va__chrome > div { display: flex; flex-wrap: wrap; gap: 0.35rem 0.8rem; }
  .kdx-va__chrome-actions { justify-content: flex-end; }
  .kdx-va__chrome strong { color: var(--bone); font-weight: 500; }

  .kdx-va__micro {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--dim);
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }
  .kdx-va__micro:hover,
  .kdx-va__micro:focus-visible { color: var(--bone); }

  .kdx-va__scene {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: clamp(4.5rem, 10vh, 7rem) clamp(1rem, 5vw, 5rem) clamp(3rem, 7vh, 5rem);
    overflow: hidden;
  }
  .kdx-va__scene[hidden] { display: none; }

  .kdx-va__field,
  .kdx-va__scan,
  .kdx-va__return-wash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .kdx-va__field { opacity: 0.42; filter: contrast(1.12) saturate(0.8); }
  .kdx-va__scan {
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent 49.8%, rgb(255 255 255 / 0.14) 50%, transparent 50.2%),
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.018) 0 1px, transparent 1px 5px);
    transform: translate(calc(var(--px) * 8px), calc(var(--py) * 5px));
  }

  .kdx-va__scene-copy { position: relative; z-index: 5; width: min(62rem, 100%); }
  .kdx-va__scene-copy--center { text-align: center; display: grid; justify-items: center; }
  .kdx-va__eyebrow { margin: 0 0 1rem; color: var(--dim); font-size: 0.68rem; letter-spacing: 0.14em; }
  .kdx-va h1,
  .kdx-va h2 {
    margin: 0;
    max-width: 16ch;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(2.5rem, 8vw, 7.8rem);
    font-weight: 400;
    line-height: 0.86;
    letter-spacing: -0.065em;
  }
  .kdx-va h2 { font-size: clamp(2.2rem, 7vw, 6.5rem); }
  .kdx-va__scene-copy--center h2 { margin-inline: auto; }
  .kdx-va__lede { max-width: 52ch; margin: 1.4rem 0 0; color: var(--dim); font-size: clamp(0.78rem, 1.4vw, 1rem); line-height: 1.55; }
  .kdx-va__scene-copy--center .kdx-va__lede { margin-inline: auto; }

  .kdx-va__choice-grid,
  .kdx-va__next-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: clamp(1.4rem, 5vh, 3.6rem);
  }

  .kdx-va__action {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    min-width: 0;
    padding: clamp(0.8rem, 2vw, 1.2rem);
    border: 1px solid var(--line);
    background: rgb(3 3 3 / 0.72);
    color: var(--bone);
    text-align: left;
    cursor: pointer;
    backdrop-filter: blur(12px);
  }
  .kdx-va__action > span { grid-row: 1 / 3; color: var(--violet); font-size: 0.7rem; letter-spacing: 0.1em; }
  .kdx-va__action strong { font-size: clamp(0.8rem, 1.5vw, 1rem); font-weight: 500; letter-spacing: 0.05em; }
  .kdx-va__action small { color: var(--dim); line-height: 1.35; }
  .kdx-va__action:hover,
  .kdx-va__action:focus-visible { border-color: var(--bone); outline: none; background: rgb(238 233 223 / 0.07); }
  .kdx-va__action:disabled { cursor: default; opacity: 0.5; }
  .kdx-va__action--wide { width: 100%; margin-top: 1rem; }
  .kdx-va__action--center { width: min(30rem, 100%); margin-top: 1.5rem; }

  .kdx-va__archive-layout {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 34rem);
    gap: clamp(1rem, 4vw, 4rem);
    align-items: center;
    width: min(86rem, 100%);
    max-height: 78svh;
  }
  .kdx-va__archive-layout h2 { max-width: 10ch; }
  .kdx-va__source {
    max-height: 72svh;
    overflow: auto;
    padding: clamp(0.9rem, 2vw, 1.35rem);
    border: 1px solid var(--line);
    background: rgb(3 3 3 / 0.82);
    backdrop-filter: blur(14px);
  }
  .kdx-va__source-head { display: flex; justify-content: space-between; gap: 1rem; color: var(--dim); font-size: 0.62rem; letter-spacing: 0.08em; }
  .kdx-va__source h3 { margin: 1rem 0; font-size: clamp(1.4rem, 4vw, 2.6rem); font-weight: 500; }
  .kdx-va__source dl { margin: 0; border-top: 1px solid var(--line); }
  .kdx-va__source dl div { display: grid; grid-template-columns: 7rem 1fr; gap: 0.75rem; padding: 0.42rem 0; border-bottom: 1px solid var(--line); }
  .kdx-va__source dt { color: var(--dim); font-size: 0.62rem; }
  .kdx-va__source dd { margin: 0; overflow-wrap: anywhere; font-size: 0.7rem; }
  .kdx-va__source-path { color: var(--dim); font-size: 0.64rem; line-height: 1.4; }
  .kdx-va__source-path code { color: var(--bone); overflow-wrap: anywhere; }

  .kdx-va__next { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(12rem, 0.6fr) 1fr; gap: 1rem; align-items: end; }
  .kdx-va__next[hidden] { display: none; }
  .kdx-va__next-copy { display: grid; gap: 0.3rem; color: var(--dim); font-size: 0.7rem; }
  .kdx-va__next-copy strong { color: var(--cyan); font-weight: 500; }
  .kdx-va__next-actions { margin-top: 0; }

  .kdx-va__heart-field { position: absolute; inset: 0; display: grid; place-items: center; background: radial-gradient(circle, rgb(110 255 164 / 0.08), transparent 38%), #020503; }
  .kdx-va__heart-ring,
  .kdx-va__heart-core { position: absolute; border-radius: 50%; }
  .kdx-va__heart-ring { border: 1px solid rgb(130 255 176 / 0.22); }
  .kdx-va__heart-ring--a { width: min(66vw, 66vh); aspect-ratio: 1; }
  .kdx-va__heart-ring--b { width: min(42vw, 42vh); aspect-ratio: 1; border-style: dashed; }
  .kdx-va__heart-core { width: min(9rem, 24vw); aspect-ratio: 1; background: radial-gradient(circle, rgb(228 255 237 / 0.72), rgb(72 192 118 / 0.12) 34%, transparent 72%); filter: blur(1px); }
