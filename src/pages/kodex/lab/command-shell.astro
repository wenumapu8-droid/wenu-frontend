---
import Base from '../../../layouts/Base.astro';
import { scenes } from '../../../lib/kodexScenes.js';

const operatorByCode = {
  THRESHOLD: 'APERTURE',
  PROLOGUE: 'SCAN',
  DESCENT: 'VORTEX',
  ARCHIVE: 'STRATA',
  MACHINE: 'ASSEMBLY',
  COSMOLOGY: 'ORBIT',
  RETURN: 'RECALL',
};

const initial = scenes[0];
---

<Base
  title="KODEX Lab — Command Shell + Title Engine"
  description="Internal noindex proof for keyboard-first KODEX shell behavior and scene-specific kinetic title operators."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <main class="kdx-shell" data-kdx-shell data-theme="VOID" data-scene="THRESHOLD" data-operator="APERTURE">
    <div class="kdx-shell__grid" aria-hidden="true"></div>
    <div class="kdx-shell__scan" aria-hidden="true"></div>

    <header class="kdx-shell__topbar">
      <a href="/kodex/" class="kdx-shell__brand" aria-label="KODEX home">KODEX−∞</a>
      <div class="kdx-shell__status" aria-label="system status">
        <span>SYS <b>ACTIVE</b></span>
        <span>SCENE <b data-status-scene>{initial.index}</b></span>
        <span>OP <b data-status-operator>APERTURE</b></span>
        <span>MODE <b data-status-theme>VOID</b></span>
      </div>
      <button class="kdx-shell__cmd" type="button" data-command-open aria-haspopup="dialog" aria-expanded="false">
        <span>COMMANDS</span><kbd>⌘K</kbd>
      </button>
    </header>

    <nav class="kdx-shell__rail" aria-label="KODEX scene operator preview">
      <div class="kdx-shell__railhead">SCENES / 07</div>
      {scenes.map((scene) => (
        <button
          class={`kdx-shell__scene${scene.i === 0 ? ' is-active' : ''}`}
          type="button"
          data-scene-button
          data-idx={scene.index}
          data-code={scene.code}
          data-subtitle={scene.subtitle}
          data-href={scene.href}
          data-accent={scene.accentHex}
          data-operator={operatorByCode[scene.code]}
        >
          <span>{scene.index}</span>
          <strong>{scene.code}</strong>
          <small>{operatorByCode[scene.code]}</small>
        </button>
      ))}
    </nav>

    <section class="kdx-shell__stage" aria-live="polite">
      <p class="kdx-shell__eyebrow" data-eyebrow>00 / THRESHOLD / APERTURE</p>
      <div class="kdx-title" data-title-wrap data-operator="APERTURE">
        <span class="kdx-title__ghost" aria-hidden="true" data-title-ghost>THRESHOLD</span>
        <h1 data-title data-title-text="THRESHOLD">THRESHOLD</h1>
        <span class="kdx-title__orbit" aria-hidden="true"></span>
      </div>
      <p class="kdx-shell__subtitle" data-subtitle>{initial.subtitle}</p>
      <p class="kdx-shell__lede">TYPE IS MATTER · TITLE IS STATE · NAVIGATION IS INSTRUMENT</p>
      <div class="kdx-shell__actions">
        <button type="button" data-next-operator>NEXT OPERATOR <kbd>↓</kbd></button>
        <a href={initial.href} data-live-link>OPEN LIVE SCENE <kbd>O</kbd></a>
      </div>
    </section>

    <aside class="kdx-shell__telemetry" aria-label="KODEX title engine telemetry">
      <div class="kdx-shell__panelhead">TITLE ENGINE</div>
      <dl>
        <div><dt>SCENE</dt><dd data-panel-scene>{initial.code}</dd></div>
        <div><dt>OPERATOR</dt><dd data-panel-operator>APERTURE</dd></div>
        <div><dt>STATE</dt><dd data-panel-state>DORMANT</dd></div>
        <div><dt>MOTION</dt><dd data-panel-motion>FULL</dd></div>
        <div><dt>INPUT</dt><dd>KEYBOARD / POINTER / TOUCH</dd></div>
        <div><dt>ROUTER</dt><dd>EXISTING KODEX</dd></div>
      </dl>
      <div class="kdx-shell__themes" aria-label="visual modes">
        <span>DISPLAY MODE</span>
        {['VOID','PHOSPHOR','AMBER','PAPER','SIGNAL'].map((theme) => (
          <button type="button" class={theme === 'VOID' ? 'is-active' : ''} data-theme-button={theme}>{theme}</button>
        ))}
      </div>
      <p class="kdx-shell__boundary">LAB ONLY · NO NEW ROUTER · NO NEW MEMORY STORE · NO COPIED THIRD-PARTY TYPE ENGINE</p>
    </aside>

    <footer class="kdx-shell__footer">
      <span><kbd>↑/↓</kbd> SCENE</span>
      <span><kbd>0–6</kbd> DIRECT</span>
      <span><kbd>⌘/CTRL K</kbd> COMMANDS</span>
      <span><kbd>T</kbd> THEME</span>
      <span><kbd>O</kbd> OPEN</span>
      <span><kbd>ESC</kbd> CLOSE</span>
    </footer>

    <aside class="kdx-command" data-command hidden aria-hidden="true" aria-modal="true" role="dialog" aria-labelledby="kdx-command-title">
      <div class="kdx-command__box">
        <header>
          <span>KDX://COMMAND</span>
          <h2 id="kdx-command-title">SYSTEM INDEX</h2>
          <button type="button" data-command-close aria-label="Close command palette">ESC</button>
        </header>
        <p class="kdx-command__hint">Choose a scene to preview its title operator. Enter selects; O opens the canonical route.</p>
        <div class="kdx-command__list" role="listbox" aria-label="scenes">
          {scenes.map((scene) => (
            <button
              type="button"
              role="option"
              data-command-scene
              data-idx={scene.index}
              data-code={scene.code}
            >
              <span>{scene.index}</span>
              <strong>{scene.code}</strong>
              <em>{operatorByCode[scene.code]}</em>
              <small>{scene.subtitle}</small>
            </button>
          ))}
        </div>
      </div>
    </aside>
  </main>
</Base>

<script>
  const root = document.querySelector('[data-kdx-shell]');
  if (root) {
    const sceneButtons = [...root.querySelectorAll('[data-scene-button]')];
    const command = root.querySelector('[data-command]');
    const commandOpen = root.querySelector('[data-command-open]');
    const commandItems = [...root.querySelectorAll('[data-command-scene]')];
    const themeButtons = [...root.querySelectorAll('[data-theme-button]')];
    const themes = themeButtons.map((button) => button.getAttribute('data-theme-button'));
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let sceneIndex = 0;
    let commandIndex = 0;
    let lastFocus = null;

    const q = (selector) => root.querySelector(selector);
    const setText = (selector, value) => { const el = q(selector); if (el) el.textContent = value; };

    const pulseState = () => {
      setText('[data-panel-state]', 'AWARE');
      root.dataset.state = 'AWARE';
      clearTimeout(root.__kdxStateTimer);
      root.__kdxStateTimer = window.setTimeout(() => {
        setText('[data-panel-state]', 'OPEN');
        root.dataset.state = 'OPEN';
      }, reduced ? 0 : 420);
    };

    const selectScene = (nextIndex, { focus = false } = {}) => {
      sceneIndex = (nextIndex + sceneButtons.length) % sceneButtons.length;
      const button = sceneButtons[sceneIndex];
      sceneButtons.forEach((item, index) => item.classList.toggle('is-active', index === sceneIndex));

      const code = button.dataset.code;
      const idx = button.dataset.idx;
      const subtitle = button.dataset.subtitle;
      const operator = button.dataset.operator;
      const accent = button.dataset.accent;
      const href = button.dataset.href;

      root.dataset.scene = code;
      root.dataset.operator = operator;
      root.style.setProperty('--kdx-active', accent);
      setText('[data-status-scene]', idx);
      setText('[data-status-operator]', operator);
      setText('[data-panel-scene]', code);
      setText('[data-panel-operator]', operator);
      setText('[data-eyebrow]', `${idx} / ${code} / ${operator}`);
      setText('[data-subtitle]', subtitle);
      setText('[data-title]', code);
      setText('[data-title-ghost]', code);
      const title = q('[data-title]');
      if (title) title.setAttribute('data-title-text', code);
      const titleWrap = q('[data-title-wrap]');
      if (titleWrap) titleWrap.setAttribute('data-operator', operator);
      const live = q('[data-live-link]');
      if (live) live.setAttribute('href', href);
      commandItems.forEach((item, index) => {
        item.setAttribute('aria-selected', index === sceneIndex ? 'true' : 'false');
      });
      pulseState();
      if (focus) button.focus();
    };

    const setTheme = (theme) => {
      if (!themes.includes(theme)) return;
      root.dataset.theme = theme;
      setText('[data-status-theme]', theme);
      themeButtons.forEach((button) => button.classList.toggle('is-active', button.dataset.themeButton === theme));
    };

    const cycleTheme = () => {
      const current = themes.indexOf(root.dataset.theme);
      setTheme(themes[(current + 1) % themes.length]);
    };

    const openCommand = () => {
      if (!command) return;
      lastFocus = document.activeElement;
      command.hidden = false;
      command.setAttribute('aria-hidden', 'false');
      commandOpen?.setAttribute('aria-expanded', 'true');
      commandIndex = sceneIndex;
      requestAnimationFrame(() => {
        command.setAttribute('data-open', '');
        commandItems[commandIndex]?.focus();
      });
    };

    const closeCommand = () => {
      if (!command) return;
      command.removeAttribute('data-open');
      command.setAttribute('aria-hidden', 'true');
      commandOpen?.setAttribute('aria-expanded', 'false');
      window.setTimeout(() => { command.hidden = true; }, reduced ? 0 : 160);
      lastFocus?.focus?.();
    };

    const moveCommand = (delta) => {
      commandIndex = (commandIndex + delta + commandItems.length) % commandItems.length;
      commandItems[commandIndex]?.focus();
    };

    sceneButtons.forEach((button, index) => button.addEventListener('click', () => selectScene(index)));
    themeButtons.forEach((button) => button.addEventListener('click', () => setTheme(button.dataset.themeButton)));
    q('[data-next-operator]')?.addEventListener('click', () => selectScene(sceneIndex + 1));
    commandOpen?.addEventListener('click', openCommand);
    q('[data-command-close]')?.addEventListener('click', closeCommand);
    commandItems.forEach((item, index) => item.addEventListener('click', () => {
      selectScene(index);
      closeCommand();
    }));

    addEventListener('keydown', (event) => {
      const commandVisible = command && !command.hidden;
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        commandVisible ? closeCommand() : openCommand();
        return;
      }
      if (commandVisible) {
        if (event.key === 'Escape') { event.preventDefault(); closeCommand(); return; }
        if (event.key === 'ArrowDown') { event.preventDefault(); moveCommand(1); return; }
        if (event.key === 'ArrowUp') { event.preventDefault(); moveCommand(-1); return; }
        if (event.key === 'Enter') { event.preventDefault(); selectScene(commandIndex); closeCommand(); return; }
        return;
      }
      if (event.key === 'ArrowDown') { event.preventDefault(); selectScene(sceneIndex + 1, { focus: true }); return; }
      if (event.key === 'ArrowUp') { event.preventDefault(); selectScene(sceneIndex - 1, { focus: true }); return; }
      if (/^[0-6]$/.test(event.key)) { event.preventDefault(); selectScene(Number(event.key), { focus: true }); return; }
      if (event.key.toLowerCase() === 't') { event.preventDefault(); cycleTheme(); return; }
      if (event.key.toLowerCase() === 'o') {
        const href = q('[data-live-link]')?.getAttribute('href');
        if (href) location.href = href;
      }
    });

    setText('[data-panel-motion]', reduced ? 'REDUCED' : 'FULL');
    selectScene(0);
  }
</script>

<style>
  :global(html), :global(body) { margin:0; min-height:100%; background:#070809; }
  :global(body) { overflow:hidden; }
  :global(*) { box-sizing:border-box; }

  .kdx-shell {
    --kdx-active:#FF3B33;
    --bg:#070809;
    --fg:#ecece7;
    --muted:#777b7c;
    --line:rgba(236,236,231,.16);
    --panel:rgba(8,9,10,.84);
    position:relative;
    width:100vw;
    height:100dvh;
    overflow:hidden;
    background:var(--bg);
    color:var(--fg);
    font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
    isolation:isolate;
  }
  .kdx-shell[data-theme="PHOSPHOR"] { --bg:#020703; --fg:#90ff9a; --muted:#3a9850; --line:rgba(144,255,154,.2); --panel:rgba(2,7,3,.88); --kdx-active:#90ff9a; }
  .kdx-shell[data-theme="AMBER"] { --bg:#0a0601; --fg:#ffca68; --muted:#9b7438; --line:rgba(255,202,104,.2); --panel:rgba(10,6,1,.88); --kdx-active:#ffae38; }
  .kdx-shell[data-theme="PAPER"] { --bg:#e7e3d7; --fg:#11110f; --muted:#6d6a61; --line:rgba(17,17,15,.18); --panel:rgba(231,227,215,.9); --kdx-active:#11110f; }
  .kdx-shell[data-theme="SIGNAL"] { --bg:#030508; --fg:#e9fbff; --muted:#5f7a83; --line:rgba(0,240,255,.2); --panel:rgba(3,5,8,.9); --kdx-active:#00f0ff; }

  .kdx-shell__grid { position:absolute; inset:0; z-index:-3; background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px); background-size:48px 48px; opacity:.24; mask-image:radial-gradient(circle at 52% 50%,black,transparent 82%); }
  .kdx-shell__scan { position:absolute; inset:0; z-index:20; pointer-events:none; opacity:.12; background:repeating-linear-gradient(0deg,transparent 0 3px,rgba(255,255,255,.08) 3px 4px); mix-blend-mode:soft-light; }

  .kdx-shell__topbar { position:absolute; inset:0 0 auto; height:58px; border-bottom:1px solid var(--line); display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:20px; padding:0 18px; background:var(--panel); backdrop-filter:blur(14px); z-index:12; }
  .kdx-shell__brand { color:var(--fg); text-decoration:none; font-family:'Archivo','Space Grotesk',sans-serif; font-weight:800; letter-spacing:.08em; }
  .kdx-shell__status { display:flex; justify-content:center; gap:clamp(10px,3vw,34px); min-width:0; font-size:9px; letter-spacing:.16em; color:var(--muted); }
  .kdx-shell__status b { color:var(--fg); font-weight:500; }
  .kdx-shell__cmd { border:1px solid var(--line); background:transparent; color:var(--fg); padding:7px 9px; display:flex; align-items:center; gap:10px; font:inherit; font-size:9px; letter-spacing:.13em; cursor:pointer; }
  kbd { border:1px solid var(--line); padding:2px 5px; font:inherit; font-size:.9em; color:var(--muted); background:color-mix(in srgb,var(--bg) 78%,transparent); }

  .kdx-shell__rail { position:absolute; top:58px; bottom:32px; left:0; width:224px; border-right:1px solid var(--line); background:var(--panel); z-index:8; display:flex; flex-direction:column; }
  .kdx-shell__railhead,.kdx-shell__panelhead { padding:12px 14px; border-bottom:1px solid var(--line); font-size:9px; letter-spacing:.2em; color:var(--muted); }
  .kdx-shell__scene { appearance:none; border:0; border-bottom:1px solid var(--line); background:transparent; color:var(--fg); display:grid; grid-template-columns:34px 1fr auto; align-items:center; gap:10px; min-height:58px; padding:8px 12px; text-align:left; font:inherit; cursor:pointer; position:relative; }
  .kdx-shell__scene::before { content:''; position:absolute; inset:0 auto 0 0; width:2px; background:var(--kdx-active); transform:scaleY(0); transition:transform .18s ease; }
  .kdx-shell__scene span { color:var(--muted); font-size:10px; }
  .kdx-shell__scene strong { font-family:'Archivo','Space Grotesk',sans-serif; font-size:13px; letter-spacing:.08em; }
  .kdx-shell__scene small { color:var(--muted); font-size:8px; letter-spacing:.12em; }
  .kdx-shell__scene:hover,.kdx-shell__scene:focus-visible,.kdx-shell__scene.is-active { background:color-mix(in srgb,var(--fg) 5%,transparent); outline:none; }
  .kdx-shell__scene.is-active::before { transform:scaleY(1); }
  .kdx-shell__scene.is-active strong { color:var(--kdx-active); }

  .kdx-shell__stage { position:absolute; top:58px; bottom:32px; left:224px; right:292px; display:flex; flex-direction:column; justify-content:center; padding:clamp(26px,5vw,72px); overflow:hidden; }
  .kdx-shell__eyebrow { margin:0 0 18px; color:var(--kdx-active); font-size:10px; letter-spacing:.2em; }
  .kdx-shell__subtitle { margin:18px 0 0; max-width:50ch; font-family:'Space Grotesk',sans-serif; text-transform:uppercase; letter-spacing:.08em; font-size:clamp(12px,1.4vw,16px); color:var(--muted); }
  .kdx-shell__lede { margin:8px 0 0; font-size:9px; letter-spacing:.18em; color:var(--muted); }
  .kdx-shell__actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:28px; }
  .kdx-shell__actions button,.kdx-shell__actions a { border:1px solid var(--line); background:transparent; color:var(--fg); text-decoration:none; padding:9px 11px; font:inherit; font-size:9px; letter-spacing:.12em; cursor:pointer; }
  .kdx-shell__actions button:hover,.kdx-shell__actions a:hover { border-color:var(--kdx-active); color:var(--kdx-active); }

  .kdx-title { position:relative; width:min(100%,980px); min-height:clamp(120px,28vw,340px); display:flex; align-items:center; isolation:isolate; }
  .kdx-title h1 { position:relative; z-index:3; margin:0; font-family:'Archivo','Space Grotesk',sans-serif; font-size:clamp(3.4rem,10vw,10.8rem); line-height:.75; letter-spacing:-.07em; font-weight:900; color:var(--fg); transform-origin:left center; max-width:100%; text-wrap:balance; }
  .kdx-title__ghost { position:absolute; z-index:1; inset:auto 0 5%; font-family:'Archivo','Space Grotesk',sans-serif; font-size:clamp(3.4rem,10vw,10.8rem); line-height:.75; letter-spacing:-.07em; font-weight:900; color:transparent; -webkit-text-stroke:1px color-mix(in srgb,var(--kdx-active) 42%,transparent); opacity:.55; pointer-events:none; }
  .kdx-title__orbit { position:absolute; z-index:0; left:50%; top:50%; width:min(44vw,430px); aspect-ratio:1; border:1px solid color-mix(in srgb,var(--kdx-active) 44%,transparent); border-radius:50%; transform:translate(-50%,-50%) scale(.78); opacity:0; }

  .kdx-title[data-operator="APERTURE"] h1 { animation:kdx-aperture 3.6s cubic-bezier(.2,.8,.2,1) infinite alternate; }
  .kdx-title[data-operator="SCAN"] h1 { animation:kdx-scan 2.8s steps(8,end) infinite; }
  .kdx-title[data-operator="VORTEX"] h1 { animation:kdx-vortex 4.4s ease-in-out infinite alternate; }
  .kdx-title[data-operator="STRATA"] h1 { text-shadow:0 .09em 0 color-mix(in srgb,var(--kdx-active) 30%,transparent),0 .18em 0 color-mix(in srgb,var(--kdx-active) 18%,transparent); animation:kdx-strata 3.8s ease-in-out infinite alternate; }
  .kdx-title[data-operator="ASSEMBLY"] h1 { animation:kdx-assembly 2.2s steps(6,end) infinite alternate; }
  .kdx-title[data-operator="ORBIT"] .kdx-title__orbit { opacity:.85; animation:kdx-orbit 8s linear infinite; box-shadow:0 0 80px color-mix(in srgb,var(--kdx-active) 12%,transparent); }
  .kdx-title[data-operator="ORBIT"] h1 { animation:kdx-orbit-type 4s ease-in-out infinite alternate; }
  .kdx-title[data-operator="RECALL"] h1 { animation:kdx-recall 5s ease-in-out infinite; }

  @keyframes kdx-aperture { from { clip-path:inset(47% 0 47% 0); letter-spacing:.06em; transform:scaleX(.88); } to { clip-path:inset(0); letter-spacing:-.07em; transform:scaleX(1); } }
  @keyframes kdx-scan { 0%,100% { transform:translateY(0); filter:none; } 45% { transform:translateY(-3px); filter:contrast(1.25); } 48% { transform:translateY(4px); } 52% { transform:translateY(0); } }
  @keyframes kdx-vortex { from { transform:perspective(700px) rotateY(-9deg) skewY(-2deg) scaleX(.86); letter-spacing:-.02em; } to { transform:perspective(700px) rotateY(7deg) skewY(1deg) scaleX(1.05); letter-spacing:-.09em; } }
  @keyframes kdx-strata { from { transform:translateY(-8px); text-shadow:0 .04em 0 color-mix(in srgb,var(--kdx-active) 22%,transparent),0 .08em 0 color-mix(in srgb,var(--kdx-active) 10%,transparent); } to { transform:translateY(8px); text-shadow:0 .14em 0 color-mix(in srgb,var(--kdx-active) 42%,transparent),0 .28em 0 color-mix(in srgb,var(--kdx-active) 20%,transparent); } }
  @keyframes kdx-assembly { 0% { letter-spacing:.12em; transform:scaleX(.75); } 50% { letter-spacing:-.02em; transform:scaleX(.94); } 100% { letter-spacing:-.07em; transform:scaleX(1); } }
  @keyframes kdx-orbit { to { transform:translate(-50%,-50%) scale(.78) rotate(360deg); } }
  @keyframes kdx-orbit-type { from { letter-spacing:-.04em; transform:scale(.95); } to { letter-spacing:-.09em; transform:scale(1.03); } }
  @keyframes kdx-recall { 0%,18%,100% { opacity:1; filter:blur(0); transform:translateX(0); } 36% { opacity:.28; filter:blur(4px); transform:translateX(-.08em); } 52% { opacity:.82; filter:blur(.6px); transform:translateX(.03em); } }

  .kdx-shell__telemetry { position:absolute; top:58px; bottom:32px; right:0; width:292px; border-left:1px solid var(--line); background:var(--panel); z-index:8; }
  .kdx-shell__telemetry dl { margin:0; padding:8px 14px; }
  .kdx-shell__telemetry dl div { display:grid; grid-template-columns:92px 1fr; gap:8px; padding:8px 0; border-bottom:1px solid var(--line); }
  .kdx-shell__telemetry dt { font-size:8px; letter-spacing:.16em; color:var(--muted); }
  .kdx-shell__telemetry dd { margin:0; font-size:9px; color:var(--fg); overflow-wrap:anywhere; }
  .kdx-shell__themes { padding:14px; display:grid; grid-template-columns:1fr 1fr; gap:6px; }
  .kdx-shell__themes > span { grid-column:1/-1; margin-bottom:4px; font-size:8px; letter-spacing:.16em; color:var(--muted); }
  .kdx-shell__themes button { border:1px solid var(--line); background:transparent; color:var(--muted); padding:7px 8px; font:inherit; font-size:8px; cursor:pointer; }
  .kdx-shell__themes button.is-active { color:var(--kdx-active); border-color:var(--kdx-active); }
  .kdx-shell__boundary { position:absolute; left:14px; right:14px; bottom:14px; margin:0; color:var(--muted); font-size:8px; line-height:1.5; letter-spacing:.08em; }

  .kdx-shell__footer { position:absolute; inset:auto 0 0; height:32px; z-index:12; border-top:1px solid var(--line); background:var(--panel); display:flex; align-items:center; justify-content:center; gap:clamp(8px,2vw,24px); padding:0 12px; color:var(--muted); font-size:8px; letter-spacing:.08em; white-space:nowrap; }

  .kdx-command { position:fixed; inset:0; z-index:40; display:grid; place-items:center; padding:22px; background:color-mix(in srgb,var(--bg) 88%,transparent); backdrop-filter:blur(18px); opacity:0; transition:opacity .16s ease; }
  .kdx-command[hidden] { display:none; }
