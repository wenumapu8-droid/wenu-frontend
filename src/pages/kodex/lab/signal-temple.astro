---
import KodexTemple from "../../../components/kodex/temple/KodexTemple.astro";
import { signalTempleRecipe } from "../../../kodex/temple/signalTemple";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#030208" />
    <title>KODEX−∞ Signal Temple Lab</title>
  </head>
  <body>
    <main>
      <KodexTemple recipe={signalTempleRecipe} debugControls={true} />
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { margin: 0; background: #030208; }
  :global(body) { margin: 0; min-height: 100svh; overflow: hidden; background: #030208; }
  :global(main) { min-height: 100svh; }
</style>
