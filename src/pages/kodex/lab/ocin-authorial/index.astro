---
import OcinWorkFrame from '../../../../components/kodex/ocin/OcinWorkFrame.astro';
import { OCIN_GENESIS_REVIEW_V0 } from '../../../../lib/kodex/ocin/authorial-corpus-v0';

const works = OCIN_GENESIS_REVIEW_V0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ocín Authorial Publishing Lab — KODEX−∞</title>
    <meta
      name="description"
      content="Internal noindex KODEX−∞ authorial publishing lab. Private source artwork is withheld until reviewed derivatives are approved."
    />
  </head>
  <body>
    <main class="ocin-lab" aria-labelledby="ocin-lab-title">
      <header class="ocin-lab__header">
        <div class="ocin-lab__kicker">
          <span>KODEX−∞</span>
          <span>OCÍN AUTHORIAL LAB / V0</span>
          <span>INTERNAL / NOINDEX</span>
        </div>
        <div class="ocin-lab__intro">
          <p>ARTWORK → REGISTRY → SERIES / PROJECT → WORK PAGE / CASE STUDY → KODEX ACTIVATION</p>
          <h1 id="ocin-lab-title">The artwork is the source.<br />The system learns how to behave around it.</h1>
          <p>
            This route proves the publishing architecture without exposing private Drive bytes. Individual artworks and
            design projects follow different editorial contracts; approved derivatives plug into the same provenance chain.
          </p>
        </div>
        <nav class="ocin-lab__index" aria-label="Ocín review corpus">
          {works.map((work, index) => (
            <a href={`#${work.id}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{work.title}</strong>
              <small>{work.sceneRoles.join(' / ')}</small>
            </a>
          ))}
        </nav>
      </header>

      <section class="ocin-lab__project-index" aria-labelledby="project-index-title">
        <div>
          <p>PROJECT REGISTRY / 01</p>
          <h2 id="project-index-title">Design projects are systems, not loose images.</h2>
        </div>
        <a href="/kodex/lab/ocin-authorial/projects/mushroom-elixir/">
          <span>OCN-PRJ-001</span>
          <strong>MUSHROOM ELIXIR</strong>
          <small>CASE STUDY STRUCTURE READY · FACTS / PUBLIC DERIVATIVES PENDING →</small>
        </a>
      </section>

      <section class="ocin-lab__works" aria-label="Authorial work frames">
        {works.map((work, index) => (
          <div id={work.id} class="ocin-lab__work-anchor">
            <OcinWorkFrame work={work} selected={index === 0} />
          </div>
        ))}
      </section>

      <footer class="ocin-lab__footer">
        <p>10 / 10 GENESIS REVIEW SLOTS · 01 DESIGN PROJECT · CREATOR PUBLIC APPROVAL PENDING</p>
        <p>PRIVATE SOURCE URLS: 0 · PUBLIC DERIVATIVES: 0 · DEPLOYMENT: NOT REQUESTED</p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    background: #050505;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: #050505; }
  body { margin: 0; background: #050505; color: #f5f2e9; }
  a { color: inherit; }

  .ocin-lab {
    width: min(100%, 1800px);
    margin: 0 auto;
    padding: clamp(.7rem, 1.5vw, 1.25rem);
  }

  .ocin-lab__header {
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: clamp(2rem, 7vw, 7rem);
    padding: clamp(.5rem, 1.5vw, 1.5rem);
    border: 1px solid rgba(245, 242, 233, .16);
  }

  .ocin-lab__kicker,
  .ocin-lab__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .65rem 1.5rem;
    color: rgba(245, 242, 233, .58);
    font: 500 .68rem/1.3 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: .09em;
  }

  .ocin-lab__intro { align-self: center; max-width: 1280px; }
  .ocin-lab__intro > p:first-child { margin: 0 0 1rem; color: rgba(245, 242, 233, .52); font: .68rem/1.3 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: .1em; }
  .ocin-lab__intro h1 { margin: 0; max-width: 18ch; font-size: clamp(3rem, 10vw, 10rem); font-weight: 500; line-height: .82; letter-spacing: -.07em; }
  .ocin-lab__intro > p:last-child { max-width: 64ch; margin: 2rem 0 0; color: rgba(245, 242, 233, .7); font-size: clamp(.9rem, 1.4vw, 1.12rem); line-height: 1.55; }

  .ocin-lab__index { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); border-top: 1px solid rgba(245, 242, 233, .16); }
  .ocin-lab__index a { min-height: 7.5rem; display: grid; align-content: space-between; gap: .6rem; padding: .85rem; text-decoration: none; border-right: 1px solid rgba(245, 242, 233, .12); border-bottom: 1px solid rgba(245, 242, 233, .12); }
  .ocin-lab__index span,
  .ocin-lab__index small { color: rgba(245, 242, 233, .5); font: .64rem/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .ocin-lab__index strong { max-width: 20ch; font-size: 1rem; line-height: 1.05; }
  .ocin-lab__index a:hover,
  .ocin-lab__index a:focus-visible { background: #f5f2e9; color: #090909; outline: none; }
  .ocin-lab__index a:hover span,
  .ocin-lab__index a:hover small,
  .ocin-lab__index a:focus-visible span,
  .ocin-lab__index a:focus-visible small { color: rgba(9, 9, 9, .58); }

  .ocin-lab__project-index { margin-top: clamp(1rem, 2vw, 2rem); display: grid; gap: 1rem; padding: clamp(1rem, 3vw, 3rem); border: 1px solid rgba(245,242,233,.16); }
  .ocin-lab__project-index p { margin: 0 0 .75rem; color: rgba(245,242,233,.5); font: .64rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.1em; }
  .ocin-lab__project-index h2 { margin: 0; max-width: 14ch; font: 600 clamp(2.4rem, 7vw, 7rem)/.86 system-ui,sans-serif; letter-spacing:-.06em; }
  .ocin-lab__project-index > a { min-height: 16rem; display: grid; align-content: space-between; padding: 1rem; text-decoration: none; border: 1px solid rgba(245,242,233,.16); background: #0b0b0b; }
  .ocin-lab__project-index > a span,
  .ocin-lab__project-index > a small { color: rgba(245,242,233,.52); font: .66rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.08em; }
  .ocin-lab__project-index > a strong { font: 600 clamp(2rem, 6vw, 6rem)/.85 system-ui,sans-serif; letter-spacing:-.06em; }
  .ocin-lab__project-index > a:hover,
  .ocin-lab__project-index > a:focus-visible { background:#f5f2e9; color:#090909; outline:none; }
  .ocin-lab__project-index > a:hover span,
  .ocin-lab__project-index > a:hover small { color:rgba(9,9,9,.55); }

  .ocin-lab__works { display: grid; gap: clamp(1rem, 2vw, 2rem); margin-top: clamp(1rem, 2vw, 2rem); }
  .ocin-lab__work-anchor { scroll-margin-top: 1rem; }
  .ocin-lab__footer { padding: 1rem .25rem .25rem; border-top: 1px solid rgba(245, 242, 233, .16); margin-top: 1rem; }
  .ocin-lab__footer p { margin: 0; }

  @media (min-width: 900px) { .ocin-lab__project-index { grid-template-columns: .7fr 1.3fr; align-items: stretch; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
