  body { margin:0; padding:clamp(.7rem,1.5vw,1.25rem); background:#050505; color:#f2efe5; }
  a { color:inherit; }
  .project-nav { width:min(100%,1800px); margin:0 auto .8rem; display:flex; flex-wrap:wrap; justify-content:space-between; gap:.75rem; padding:.25rem; font:500 .66rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.08em; color:rgba(242,239,229,.58); }
  .project-nav a { text-decoration:none; }
  .project-nav a:hover,.project-nav a:focus-visible { color:#fff; }
  main { width:min(100%,1800px); margin:0 auto; }
</style>
