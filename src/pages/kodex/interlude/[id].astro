---
import Base from "../../../layouts/Base.astro";
import KodexChrome from "../../../components/KodexChrome.astro";
import KodexRecuerda from "../../../components/kodex/KodexRecuerda.astro";
import KodexDebug from "../../../components/kodex/debug/KodexDebug.astro";
import KodexTransition from "../../../components/kodex/transition/KodexTransition.astro";
import KodexQuietFrame from "../../../components/kodex/interludes/KodexQuietFrame.astro";
import { quietFrames } from "../../../lib/kodex/quietFrames";
import "../../../styles/kodex.css";
/* Sólo la CAPA DE CROMO del contrato de plancha. El interludio tiene su propia
   composición -- `KodexQuietFrame`, que no es un `kx-os-stage` -- y el contrato
   de escena no le sirve ni se le aplica. Pero sus superposiciones venían del
   cromo compartido, no de su marco: medido, "‹ PREVIOUS" contra "⌘K" al 100%
   en teléfono y en landscape. Eso sí es del sistema y sí se arregla acá. */
import "../../../styles/kodex-plate.css";
import { plateId, KDX_PLATE_CONTRACT_VERSION } from "../../../lib/kodex/plancha/plate-contract";
import "../../../styles/kodex-quiet-frames.css";

export function getStaticPaths() {
  return Object.keys(quietFrames).filter((id) => id !== "threshold-prologue").map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const frame = quietFrames[id as keyof typeof quietFrames] ?? quietFrames["archive-machine"];
const prevUrl = id === "cosmology-return" ? "/kodex/folio/v/" : "/kodex/folio/iii/";
const idx = id === "cosmology-return" ? 6 : 4;
---

<Base
  title={`${frame.label} — KODEX−∞`}
  description="A quiet editorial interlude inside the KODEX archive."
  robots="noindex, nofollow"
  ogImage={frame.image ?? "/img/kodex/brand/KODEX_Master_Seal_transparent.png"}
  kodexFonts={true}
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div
    class="kx kx--deck kx-os-scene kx-os-scene--quiet"
    data-kx
    data-stage-idx={idx}
    data-stage-name="QUIET FRAME"
    data-stage-col="232,228,220"
    data-prev-url={prevUrl}
    data-next-url={frame.href}
    data-next-label={frame.command}
    data-kdx-tool="respirar"
    data-kdx-shell={KDX_PLATE_CONTRACT_VERSION}
    data-kdx-plate={plateId(id as string, 'interlude')}
  >
    <KodexTransition />
    <KodexDebug />
    <KodexChrome segs={7} />

    <div class="kx-deck" data-deck>
      <section class="kx-slide kx-slide--quiet kx-active" id={frame.id}>
        <KodexQuietFrame {...frame} />
      </section>
    </div>
  </div>
  <KodexRecuerda registraVista />

  <script>
    /* El motor no corria en los interludios y por eso el corredor se cortaba a
       la mitad. La barra dibuja su boton NEXT desde el cromo compartido, pero
       sin `initKx()` nadie le engancha el listener: el boton se veia, se podia
       clickear, y no pasaba nada — medido, ni despues de diez segundos y sin un
       solo error de JS.
       Con la cadena de `data-next-url` completa y correcta, MACHINE, COSMOLOGY
       y RETURN quedaban inalcanzables caminando. Tres de las siete escenas.
       Las paginas de folio ya lo hacian asi; los interludios se quedaron sin el. */
    import { initKx } from '../../../scripts/kodex-engine.js';
    initKx();
  </script>
</Base>
