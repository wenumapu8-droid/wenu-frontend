---
/**
 * KODEX-∞ · DISPOSITIVO RITUAL · página móvil
 *
 * Segunda página real del KODEX. Como la del descenso, sale de la propia
 * lámina: el panel «08. MOBILE TILE» de t01-06 es esta pantalla, y el organismo
 * es el mismo canvas del héroe, que ya nació procedural y con estados.
 *
 * Por eso esta página costó una tarde y no una lámina entera: cuando el héroe
 * se construye como código en vez de trazarse, la página sale casi gratis. La
 * lámina trazada no puede dar esto — un SVG de 85.000 paths no carga, no
 * responde y no cambia de estado.
 *
 * Los cuatro estados son los que la lámina documenta en su panel 02:
 *   CHARGE   toma ruido ambiente, carga la celosía del núcleo
 *   ALIGN    busca el enganche de patrón, alinea los glifos
 *   RESONATE amplifica la señal, cascada de resonancia
 *   EMIT     libera el campo codificado, el patrón echa raíz
 *
 * La telemetría no es el texto del póster: la resonancia y la carga salen del
 * reloj del organismo. Eso además cumple la regla de canon que prohíbe
 * presentar cifras generadas como estado real del sistema — acá lo son.
 */
const ESTADOS = [
  { id: "CHARGE",   glosa: "Toma ruido ambiente. Carga la celosía del núcleo." },
  { id: "ALIGN",    glosa: "Busca el enganche de patrón. Alinea los glifos." },
  { id: "RESONATE", glosa: "Amplifica la señal. Cascada de resonancia." },
  { id: "EMIT",     glosa: "Libera el campo codificado. El patrón echa raíz." },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <title>KODEX−∞ · Dispositivo Ritual</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <main class="rt" data-estado="CHARGE">
      <canvas class="rt__cv" aria-hidden="true"></canvas>

      <header class="rt__marca">
        <span class="rt__wm">KODEX−∞</span>
        <span class="rt__sub">ARTEFACT CORE</span>
      </header>

      <nav class="rt__riel" aria-label="Estados del dispositivo">
        {ESTADOS.map((e, i) => (
          <button class="rt__sello" type="button" data-estado={e.id} aria-pressed={i === 0 ? "true" : "false"}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10.2" />
              {i === 0 && <><circle cx="12" cy="12" r="4" /><path d="M12 2v4M12 18v4M2 12h4M18 12h4" /></>}
              {i === 1 && <><path d="M12 3.5v17M3.5 12h17" /><path d="M6.4 6.4 17.6 17.6M17.6 6.4 6.4 17.6" opacity="0.5" /></>}
              {i === 2 && Array.from({ length: 3 }, (_, k) => <circle cx="12" cy="12" r={3.4 + k * 3} />)}
              {i === 3 && <><path d="M12 12 12 2.2M12 12l8.5 4.9M12 12 3.5 16.9" /><circle cx="12" cy="12" r="2.6" /></>}
            </svg>
            <span class="rt__vu">{e.id}</span>
          </button>
        ))}
      </nav>

      <p class="rt__glosa" aria-live="polite" data-glosa>{ESTADOS[0].glosa}</p>

      <footer class="rt__barra">
        <div class="rt__dato">
          <span class="rt__k">RESONANCE</span>
          <span class="rt__v" data-res>0.00</span>
        </div>
        <div class="rt__dato rt__dato--carga">
          <span class="rt__k">CORE CHARGE</span>
          <span class="rt__fila">
            <span class="rt__v" data-carga>0%</span>
            <span class="rt__medidor"><i data-fill></i></span>
          </span>
        </div>
        <span class="rt__estado" data-nombre>CHARGE</span>
      </footer>

      <p class="rt__pista">Tocá un sello para cambiar de estado</p>
    </main>

    <style is:global>
      :root { color-scheme: dark; }
      html, body { margin: 0; padding: 0; height: 100%; background: #000; overscroll-behavior: none; }
      body { font: 11px/1.4 ui-monospace, "SF Mono", Menlo, monospace; -webkit-font-smoothing: antialiased; }
    </style>

    <style>
      .rt {
        --acc: #5ad4e8;          /* cian del dispositivo */
        --viol: #a06cff;
        --dim: #5c7f88;
        --linea: color-mix(in srgb, var(--acc) 40%, transparent);
        position: fixed; inset: 0; overflow: hidden; color: #dbe8ec;
        padding: env(safe-area-inset-top) env(safe-area-inset-right)
                 env(safe-area-inset-bottom) env(safe-area-inset-left);
        touch-action: none;
      }
      .rt__cv { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

      .rt__marca {
        position: absolute; top: calc(env(safe-area-inset-top) + 12px); left: 12px;
        padding: 5px 10px 6px; background: #000; border: 1px solid var(--linea); line-height: 1;
      }
      .rt__wm { display: block; font-size: 19px; font-weight: 800; letter-spacing: -0.01em; }
      .rt__sub { display: block; margin-top: 3px; font-size: 7px; letter-spacing: 0.2em; color: var(--acc); }

      .rt__riel {
        position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
        display: grid; gap: 6px;
      }
      .rt__sello {
        width: 44px; height: 44px; display: grid; place-items: center;
        background: #000; border: 1px solid var(--linea); color: var(--dim);
        cursor: pointer; padding: 0;
      }
      .rt__sello svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 0.8; }
      .rt__sello[aria-pressed="true"] { color: var(--acc); border-color: var(--acc); }
      .rt__sello:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
      .rt__vu { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

      .rt__glosa {
        position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
        max-width: 42vw; margin: 0; color: var(--dim); font-size: 10px;
      }

      .rt__barra {
        position: absolute; left: 0; right: 0; bottom: env(safe-area-inset-bottom);
        display: flex; align-items: flex-end; gap: 14px;
        padding: 6px 12px 8px; background: linear-gradient(to top, #000 62%, transparent);
      }
      .rt__dato--carga { flex: 1; }
      .rt__k { display: block; font-size: 7px; letter-spacing: 0.16em; color: var(--dim); }
      .rt__v { font-size: 19px; line-height: 1.1; color: var(--acc); font-variant-numeric: tabular-nums; }
      .rt__fila { display: flex; align-items: center; gap: 8px; }
      .rt__medidor {
        position: relative; flex: 1; height: 14px;
        border: 1px solid var(--linea); overflow: hidden;
      }
      .rt__medidor i {
        position: absolute; inset: 1px auto 1px 1px; width: 0%;
        background-image: repeating-linear-gradient(90deg, var(--acc) 0 1.5px, transparent 1.5px 3.4px);
      }
      .rt__estado {
        font-size: 9px; letter-spacing: 0.2em; color: var(--viol);
        padding-bottom: 3px;
      }
      .rt__pista {
        position: absolute; left: 0; right: 0; bottom: calc(env(safe-area-inset-bottom) + 58px);
        margin: 0; text-align: center; font-size: 8px; letter-spacing: 0.14em;
        color: var(--dim); pointer-events: none;
        animation: rt-ir 1s ease 6s forwards;
      }
      @keyframes rt-ir { to { opacity: 0; } }
      @media (prefers-reduced-motion: reduce) { .rt__pista { animation: none; } }
    </style>

    <script>
      /**
       * El dispositivo. Anillos toroidales, tubo, cristal y órbitas — todo
       * paramétrico, como en la lámina. Lo único que cambia respecto del héroe
       * de t01-06 es que acá los estados los maneja el dedo y no un reloj.
       */
      const raiz = document.querySelector(".rt");
      const cv = raiz.querySelector(".rt__cv");
      const ctx = cv.getContext("2d");

      const ESTADOS = ["CHARGE", "ALIGN", "RESONATE", "EMIT"];
      const GLOSA = {
        CHARGE: "Toma ruido ambiente. Carga la celosía del núcleo.",
        ALIGN: "Busca el enganche de patrón. Alinea los glifos.",
        RESONATE: "Amplifica la señal. Cascada de resonancia.",
        EMIT: "Libera el campo codificado. El patrón echa raíz.",
      };
      /* Cada estado mueve tres cosas: cuánta luz tiene el núcleo, cuán rápido
         giran las órbitas, y cuánto se abre el campo hacia afuera. */
      const P = {
        CHARGE:   { luz: 0.30, giro: 0.10, campo: 0.35, res: 1.4 },
        ALIGN:    { luz: 0.55, giro: 0.28, campo: 0.60, res: 3.9 },
        RESONATE: { luz: 0.90, giro: 0.62, campo: 0.88, res: 7.8 },
        EMIT:     { luz: 1.00, giro: 0.34, campo: 1.00, res: 5.2 },
      };

      let estado = "CHARGE";
      let W = 0, H = 0, DPR = 1, fase = 0, carga = 0;
      const suave = { luz: 0.30, giro: 0.10, campo: 0.35 };

      function medir() {
        DPR = Math.min(2, window.devicePixelRatio || 1);
        W = raiz.clientWidth; H = raiz.clientHeight;
        cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      }
      medir();
      addEventListener("resize", medir, { passive: true });

      const anillo = (cx, cy, rx, ry, a, gr) => {
        ctx.strokeStyle = `rgba(90,212,232,${a.toFixed(3)})`;
        ctx.lineWidth = gr;
        ctx.beginPath();
        ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
        ctx.stroke();
      };

      function pintar(t) {
        const cx = W / 2, cy = H / 2;
        const R = Math.min(W, H) * 0.30;
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
        ctx.fillStyle = "#000"; ctx.fillRect(0, 0, W, H);
        ctx.globalCompositeOperation = "lighter";

        // Órbitas: el campo. Se abren y aceleran con el estado.
        const n = 13;
        for (let i = 0; i < n; i++) {
          const f = i / (n - 1);
          const rot = t * suave.giro * (i % 2 ? 1 : -1) * (0.4 + f);
          const rx = R * (0.55 + f * 1.5) * (0.6 + suave.campo * 0.7);
          const ry = rx * (0.16 + Math.abs(Math.sin(rot)) * 0.5);
          anillo(cx, cy, rx, ry, 0.05 + suave.campo * 0.16 * (1 - f * 0.6), 0.7);
        }

        // Cuerpo: coronas arriba y abajo, tubo al centro.
        for (const s of [-1, 1]) {
          for (let k = 0; k < 4; k++) {
            const y = cy + s * (R * 0.72 + k * R * 0.10);
            anillo(cx, y, R * (0.62 - k * 0.05), R * (0.13 - k * 0.012), 0.30 + suave.luz * 0.35, 1.1);
          }
        }
        ctx.strokeStyle = `rgba(90,212,232,${(0.16 + suave.luz * 0.2).toFixed(3)})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(cx - R * 0.5, cy - R * 0.7); ctx.lineTo(cx - R * 0.5, cy + R * 0.7);
        ctx.moveTo(cx + R * 0.5, cy - R * 0.7); ctx.lineTo(cx + R * 0.5, cy + R * 0.7);
        ctx.stroke();

        // Cristal: el corazón. Rombo de lados cóncavos.
        const cr = R * (0.20 + suave.luz * 0.06);
        const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, cr * 2.6);
        g.addColorStop(0, `rgba(220,190,255,${(0.5 * suave.luz).toFixed(3)})`);
        g.addColorStop(0.4, `rgba(160,108,255,${(0.24 * suave.luz).toFixed(3)})`);
        g.addColorStop(1, "rgba(160,108,255,0)");
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(cx, cy, cr * 2.6, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = `rgba(214,186,255,${(0.5 + suave.luz * 0.45).toFixed(3)})`;
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(cx, cy - cr);
        ctx.quadraticCurveTo(cx + cr * 0.34, cy, cx, cy + cr);
        ctx.quadraticCurveTo(cx - cr * 0.34, cy, cx, cy - cr);
        ctx.stroke();

        ctx.globalCompositeOperation = "source-over";
      }

      function hud() {
        const p = P[estado];
        raiz.querySelector("[data-res]").textContent = (p.res * (0.85 + 0.3 * Math.abs(Math.sin(fase * 2)))).toFixed(2);
        raiz.querySelector("[data-carga]").textContent = Math.round(carga * 100) + "%";
        raiz.querySelector("[data-fill]").style.width = (carga * 100).toFixed(1) + "%";
        raiz.querySelector("[data-nombre]").textContent = estado;
      }

      const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
      let t0 = performance.now(), ultimo = t0;
      function bucle(ts) {
        const dt = Math.min(0.05, (ts - ultimo) / 1000);
        ultimo = ts;
        fase = (ts - t0) / 1000;
        const p = P[estado];
        // Los parámetros se interpolan: cambiar de estado es una transición,
        // no un corte. Es el mismo criterio que en la página del descenso.
        for (const k of ["luz", "giro", "campo"]) {
          suave[k] += (p[k] - suave[k]) * Math.min(1, dt * 1.8);
        }
        carga += ((p.luz) - carga) * Math.min(1, dt * 1.2);
        pintar(fase);
        hud();
        requestAnimationFrame(bucle);
      }
      if (quieto) { pintar(0); hud(); } else { requestAnimationFrame(bucle); }

      function ir(nuevo) {
        if (!P[nuevo]) return;
        estado = nuevo;
        raiz.dataset.estado = nuevo;
        raiz.querySelector("[data-glosa]").textContent = GLOSA[nuevo];
        for (const b of raiz.querySelectorAll(".rt__sello")) {
          b.setAttribute("aria-pressed", String(b.dataset.estado === nuevo));
        }
      }
      for (const b of raiz.querySelectorAll(".rt__sello")) {
        b.addEventListener("click", () => ir(b.dataset.estado));
      }
      addEventListener("keydown", (e) => {
        const i = ESTADOS.indexOf(estado);
        if (e.key === "ArrowDown" || e.key === "ArrowRight") ir(ESTADOS[Math.min(3, i + 1)]);
        if (e.key === "ArrowUp" || e.key === "ArrowLeft") ir(ESTADOS[Math.max(0, i - 1)]);
      });
    </script>
  </body>
</html>
