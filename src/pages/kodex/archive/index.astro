---
/**
 * KODEX−∞ · THE ARCHIVE — el hub que faltaba
 *
 * `/kodex/archive/` estaba enlazado desde 40 páginas (el overlay INDEX, el menú
 * de world, los folios, lab/heart) y era un 404 — y encima el 404 que se servía
 * era el de la tienda Wenu Mapu, rompiendo el universo. Hallazgo #1 de la
 * auditoría del 16/08.
 *
 * Este hub NO inventa contenido: ensambla las puertas que ya existen. "The
 * archive does not store. It remembers" — pero primero hay que poder entrar.
 */
import Base from '../../../layouts/Base.astro';

const salas = [
  { href: '/kodex/strata/', n: 'STRATA', d: 'six layers of the system · choose your descent', tag: 'INDEX' },
  { href: '/kodex/lamina/', n: 'THE PLATES', d: '27 plates, measured against their references', tag: 'CODEX' },
  { href: '/kodex/archive/conjuncion/', n: 'CONJUNCIÓN', d: 'reading chamber · Portal III', tag: 'CHAPTER' },
  { href: '/kodex/works/', n: 'WORKS REGISTRY', d: 'the collection, specimen by specimen', tag: 'REGISTRY' },
  { href: '/kodex/world/', n: 'THE WORLD', d: 'the map of everything that breathes', tag: 'MAP' },
  { href: '/kodex/libro/', n: 'THE BOOK', d: 'the codex in long form', tag: 'VOLUME' },
  { href: '/kodex/editions/', n: 'EDITIONS', d: 'prints and physical signals', tag: 'MATTER' },
];
---

<Base
  title="The Archive — KODEX−∞"
  description="Living memory of KODEX−∞: plates, chambers, registry and world."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true} noKai={true} noCart={true} noImmersive={true}
>
  <div class="kxa">
    <header class="kxa-cab">
      <a class="kxa-marca" href="/kodex/">KODEX<span>−∞</span></a>
      <a class="kxa-volver" href="/kodex/">← SURFACE</a>
    </header>

    <main class="kxa-cuerpo">
      <p class="kxa-ojo">◉ LIVING MEMORY</p>
      <h1 class="kxa-titulo">THE ARCHIVE</h1>
      <p class="kxa-lema">THE ARCHIVE DOES NOT STORE. IT REMEMBERS.</p>

      <nav class="kxa-salas" aria-label="archive chambers">
        {salas.map((s) => (
          <a class="kxa-sala" href={s.href}>
            <span class="kxa-tag">{s.tag}</span>
            <strong>{s.n}</strong>
            <span class="kxa-d">{s.d}</span>
            <span class="kxa-cta">ENTER →</span>
          </a>
        ))}
      </nav>
    </main>

    <footer class="kxa-pie">
      <span>KDX://ARCHIVE</span>
      <span>EVERY CHAMBER REMEMBERS YOUR PASSAGE</span>
    </footer>
  </div>
</Base>

<style>
  .kxa{ min-height:100vh; min-height:100dvh; display:flex; flex-direction:column;
    background:#0a0a0a; color:#f0ede8; font-family:'IBM Plex Mono',ui-monospace,monospace; }
  .kxa-cab{ display:flex; justify-content:space-between; align-items:center;
    padding:clamp(14px,2.4vh,22px) clamp(18px,3.4vw,44px); border-bottom:1px solid rgba(240,237,232,.1); }
  .kxa-marca{ color:#f0ede8; text-decoration:none; letter-spacing:.18em; font-size:14px; }
  .kxa-marca span{ color:#ff2733; }
  .kxa-volver{ color:rgba(240,237,232,.55); text-decoration:none; font-size:11px; letter-spacing:.2em; min-height:44px; display:inline-flex; align-items:center; }
  .kxa-volver:hover{ color:#f0ede8; }
  .kxa-cuerpo{ flex:1; width:min(92vw,880px); margin:0 auto; padding:clamp(28px,6vh,64px) 0; }
  .kxa-ojo{ margin:0 0 10px; font-size:11px; letter-spacing:.26em; color:#ff2733; }
  .kxa-titulo{ margin:0 0 10px; font-family:'Barlow Condensed','Inter Tight',system-ui,sans-serif;
    font-weight:800; font-size:clamp(40px,7vw,72px); letter-spacing:.02em; }
  .kxa-lema{ margin:0 0 clamp(24px,4vh,40px); font-size:12px; letter-spacing:.18em; color:rgba(240,237,232,.55); }
  .kxa-salas{ display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:12px; }
  .kxa-sala{ display:flex; flex-direction:column; gap:6px; padding:18px; min-height:44px;
    text-decoration:none; color:#f0ede8; border:1px solid rgba(240,237,232,.16);
    transition:border-color .2s ease, background .2s ease; }
  .kxa-sala:hover{ border-color:#ff2733; background:rgba(255,39,51,.05); }
  .kxa-tag{ font-size:9.5px; letter-spacing:.24em; color:rgba(240,237,232,.4); }
  .kxa-sala strong{ font-size:15px; letter-spacing:.14em; }
  .kxa-d{ font-size:11px; letter-spacing:.04em; color:rgba(240,237,232,.55); line-height:1.5; }
  .kxa-cta{ margin-top:auto; font-size:10px; letter-spacing:.2em; color:#ff2733; }
  .kxa-pie{ display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap;
    padding:12px clamp(18px,3.4vw,44px); border-top:1px solid rgba(240,237,232,.1);
    font-size:9.5px; letter-spacing:.16em; color:rgba(240,237,232,.4); }
</style>
