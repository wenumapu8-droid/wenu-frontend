---
/**
 * KODEX-∞ · CHAMBER HEART
 * TELAR · 2026-08-30
 *
 * SPECIAL CHAMBER, no escena del corredor. Decision de autoridad del
 * 2026-08-29: el corredor principal son SIETE escenas, 00-06.
 * HEART / OBSERVER / SILENCE viven FUERA del numerador, con IDs KDX-CH-*.
 * El "/10" de las laminas Hi-Fi fue exploracion generada y no es arquitectura.
 *
 * POR QUE ESTA PAGINA EXISTE
 * La logica de esta chamber ya estaba construida en
 * `src/lib/kodex/escenas/heart.ts` -- estados, copy canonico, eventos,
 * reduced-motion y fallback -- y no tenia NI UNA ruta. El patron de siempre
 * en este proyecto: se produce mas de lo que se integra. Esto es cableado,
 * no construccion: no se inventa nada, se le da puerta a lo que ya existe.
 *
 * Monta el MISMO chasis que las escenas del corredor. Una gramatica, varios
 * mundos: que sea especial no significa que sea otro sistema.
 */
import KodexShell from '../../../../layouts/KodexShell.astro';
import AtlasScreenChassis from '../../../../components/kodex/screen/AtlasScreenChassis.astro';
import { HEART, HEART_NODE_ID } from '../../../../lib/kodex/escenas/heart';

/* Fila de Atlas derivada de la definicion REAL de la chamber. Ningun campo
   se inventa: lo que la definicion no declara va como HUECO. */
const row = {
  id: 'KDX-CH-HEART',
  title: 'HEART - The Chamber That Orients',
  sourceUrl: '',
  concept: 'Nodo de orientacion e integracion del recorrido',
  secondary: '',
  zone: 'SPECIAL CHAMBER',
  scene: 'FUERA DEL CORREDOR 00-06',
  nodeIds: [HEART_NODE_ID],
  symbols: [],
  geometry: 'HUECO',
  palette: 'HUECO',
  composition: 'HUECO',
  motion: HEART.reducedMotion,
  interaction: 'HUECO',
  sound: 'HUECO',
  copy: HEART.copy.orientation,
  epistemicLayer: 'CANON / SCENE DEFINITION',
  provenance: 'src/lib/kodex/escenas/heart.ts - definicion canonica ya existente',
  status: 'CHAMBER / WIRED',
  nextAction: 'cablear el organismo y los estados propios de la chamber',
  svgAssets: [],
  pngAssets: [],
  codeModule: '',
  notes: 'Special chamber cableada desde su definicion canonica.',
};

/* Los estados PROPIOS de la chamber, de su definicion. No son los del
   corredor: cada chamber tiene su ciclo y su mapeo canonico declarado. */
const estados = HEART.states;
---

<KodexShell
  title="KODEX - CHAMBER HEART"
  description="KODEX special chamber: HEART. Fuera del corredor principal 00-06."
>
  <AtlasScreenChassis
    row={row}
    slug="chamber-heart"
    accent="#FF3833"
    signalBase="LATENT"
    unit="CHAMBER HEART"
    authority={{
      atlas: 'DECISION LOG 2026-08-29 / SPECIAL CHAMBER, fuera de 00-06',
      visual: 'HIFI_TARGETS_2026_08_29 / VISUAL_REFERENCE ONLY',
      content: 'src/lib/kodex/escenas/heart.ts / definicion canonica',
      rights: 'OCIN RIGHTS GATE BLOQUEADO / 0 DE 25 PUBLIC APPROVED / NO OBRA MONTADA',
    }}
    sceneContract={{
      id: 'KDX-CH-HEART',
      file: 'HUECO - las chambers no tienen contrato todavia',
      route: '/kodex/chamber/heart/',
      visualTarget: 'HIFI_TARGETS_2026_08_29 / VISUAL_REFERENCE / MOCK TELEMETRY ONLY',
      copyAuthority: 'src/lib/kodex/escenas/heart.ts',
      rightsGate: 'AUTHORITIES.yaml / OCIN_MASTER_ART_REGISTRY_V08 gate: publicly_approved_count=0',
      stateSource: 'HEART.states - ciclo propio de la chamber',
      status: 'WIRED',
    }}
  />

  <section class="kdx-chamber__ciclo" aria-label="ciclo propio de la chamber">
    <p class="kdx-chamber__rot">CHAMBER CYCLE · heart</p>
    <ol class="kdx-chamber__pasos">
      {estados.map((e) => (
        <li><span>{e.toUpperCase()}</span><em>HEART.canonical[e]</em></li>
      ))}
    </ol>
    <p class="kdx-chamber__nota">
      Ciclo propio, distinto del corredor. El mapeo a los estados canonicos
      esta declarado en la definicion de la chamber, no inferido aca.
    </p>
  </section>
</KodexShell>

<style>
  .kdx-chamber__ciclo {
    max-width: 60rem;
    margin: 2.5rem auto 4rem;
    padding: 0 1.2rem;
    font-family: var(--kdx-mono, ui-monospace, monospace);
  }
  .kdx-chamber__rot {
    margin: 0 0 0.8rem;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #FF3833;
  }
  .kdx-chamber__pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.6rem;
    border-top: 1px solid color-mix(in srgb, #FF3833 22%, transparent);
    padding-top: 0.8rem;
  }
  .kdx-chamber__pasos li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.6rem;
  }
  .kdx-chamber__pasos span { letter-spacing: 0.16em; color: var(--kdx-bone, #f0ede8); }
  .kdx-chamber__pasos em {
    font-style: normal;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--kdx-bone, #f0ede8) 45%, transparent);
  }
  .kdx-chamber__nota {
    margin: 1rem 0 0;
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    line-height: 1.7;
    max-width: 52ch;
    color: color-mix(in srgb, var(--kdx-bone, #f0ede8) 50%, transparent);
  }
</style>
