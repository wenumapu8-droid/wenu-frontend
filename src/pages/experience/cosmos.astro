---
import Base from '../../layouts/Base.astro';

const piece = '/img/experience/cosmos-piece.jpg';
---

<Base
  title="Living Cosmos — Wenu Mapu"
  description="An interactive demo: real Wenu Mapu pieces floating in a living, reactive cosmos."
  noNav={true}
  noFooter={true}
  noOverlays={true}
>
  <main class="cx" id="cx">
    <canvas class="cx__stars" id="cx-stars" aria-hidden="true"></canvas>
    <div class="cx__nebula" aria-hidden="true"></div>

    <section class="cx__stage">
      <div class="cx__copy">
        <p class="cx__eyebrow">Living Cosmos · Interactive</p>
        <h1 class="cx__title">Forged on earth,<br />worn by the sky.</h1>
        <p class="cx__ritual">Mapu ka Wenu — land and sky, held in brass.</p>
        <a class="cx__cta" href="/shop">Enter the collection</a>
      </div>

      <div class="cx__piece-wrap" id="cx-piece">
        <div class="cx__glow" aria-hidden="true"></div>
        <img
          class="cx__piece"
          src={piece}
          alt="Wenu Mapu — brass ear weights, hand-cast, macro detail"
          width="1600"
          height="1060"
          decoding="async"
        />
        <div class="cx__glare" aria-hidden="true"></div>
      </div>
    </section>

    <p class="cx__hint" id="cx-hint">Move your cursor · the cosmos follows</p>
  </main>

  <style>
    .cx {
      position: relative;
      min-height: 100svh;
      overflow: hidden;
      background:
        radial-gradient(120% 90% at 50% -10%, #131017 0%, #0a0810 45%, var(--obsidian, #080706) 100%);
      display: grid;
      place-items: center;
      isolation: isolate;
    }

    .cx__stars {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      display: block;
    }

    /* Soft brand nebulae — pure CSS, drifts slowly */
    .cx__nebula {
      position: absolute;
      inset: -10%;
      z-index: 0;
      pointer-events: none;
      background:
        radial-gradient(35% 40% at 22% 30%, rgba(196, 147, 90, 0.16), transparent 70%),
        radial-gradient(30% 35% at 78% 68%, rgba(138, 106, 67, 0.14), transparent 70%),
        radial-gradient(45% 50% at 60% 18%, rgba(120, 120, 160, 0.10), transparent 72%);
      filter: blur(8px);
      animation: cx-drift 36s ease-in-out infinite alternate;
    }

    @keyframes cx-drift {
      from { transform: translate3d(-1.5%, -1%, 0) scale(1.02); }
      to   { transform: translate3d(2%, 1.5%, 0) scale(1.06); }
    }

    .cx__stage {
      position: relative;
      z-index: 2;
      width: min(1200px, 92vw);
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      align-items: center;
      gap: clamp(1rem, 4vw, 4rem);
      padding: 6vh 0;
    }

    .cx__copy { max-width: 30ch; }

    .cx__eyebrow {
      font-family: var(--font-sans, sans-serif);
      text-transform: uppercase;
      letter-spacing: 0.32em;
      font-size: 0.72rem;
      color: var(--silver, #A8A39A);
      margin: 0 0 1.4rem;
    }

    .cx__title {
      font-family: var(--font-display, Georgia, serif);
      font-weight: 400;
      font-size: clamp(2.4rem, 5.4vw, 4.4rem);
      line-height: 1.04;
      letter-spacing: -0.01em;
      color: var(--bone, #F2EDE4);
      margin: 0 0 1.6rem;
      text-shadow: 0 0 40px rgba(242, 237, 228, 0.12);
    }

    .cx__ritual {
      font-family: var(--font-serif, Georgia, serif);
      font-style: italic;
      font-size: clamp(1.05rem, 2vw, 1.35rem);
      color: var(--sand, #D6C1A3);
      margin: 0 0 2.2rem;
      opacity: 0.92;
    }

    .cx__cta {
      display: inline-block;
      font-family: var(--font-sans, sans-serif);
      text-transform: uppercase;
      letter-spacing: 0.18em;
      font-size: 0.78rem;
      color: var(--bone, #F2EDE4);
      text-decoration: none;
      padding: 0.95em 1.8em;
      border: 1px solid rgba(196, 147, 90, 0.55);
      border-radius: 2px;
      background: linear-gradient(180deg, rgba(196,147,90,0.10), rgba(196,147,90,0.02));
      transition: border-color 0.4s ease, box-shadow 0.4s ease, transform 0.2s ease;
    }
    .cx__cta:hover {
      border-color: var(--ember, #C4935A);
      box-shadow: 0 0 28px rgba(196, 147, 90, 0.35);
      transform: translateY(-1px);
    }

    /* ---- Floating piece ---- */
    .cx__piece-wrap {
      position: relative;
      display: grid;
      place-items: center;
      perspective: 1000px;
      will-change: transform;
      transform: translate3d(0, 0, 0);
      transition: transform 0.5s cubic-bezier(.22,.61,.36,1);
    }

    .cx__glow {
      position: absolute;
      width: 78%;
      aspect-ratio: 1;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(196,147,90,0.42) 0%, rgba(196,147,90,0.10) 38%, transparent 68%);
      filter: blur(18px);
      z-index: 0;
      animation: cx-pulse 6s ease-in-out infinite;
    }

    @keyframes cx-pulse {
      0%, 100% { opacity: 0.7; transform: scale(0.98); }
      50%      { opacity: 1;   transform: scale(1.06); }
    }

    .cx__piece {
      position: relative;
      z-index: 1;
      width: 100%;
      height: auto;
      /* Macro sits on near-black → screen + radial mask let the brass emerge
         from the dark, dissolving the photo's rectangle and table reflection */
      mix-blend-mode: screen;
      -webkit-mask-image: radial-gradient(ellipse 58% 42% at 50% 44%, #000 52%, transparent 76%);
      mask-image: radial-gradient(ellipse 58% 42% at 50% 44%, #000 52%, transparent 76%);
      filter: drop-shadow(0 0 26px rgba(196, 147, 90, 0.28)) contrast(1.05) saturate(1.05);
      animation: cx-float 7s ease-in-out infinite;
      transform-style: preserve-3d;
    }

    @keyframes cx-float {
      0%, 100% { transform: scale(1.12) translateY(-1.1%) rotateZ(-0.4deg); }
      50%      { transform: scale(1.12) translateY(1.4%) rotateZ(0.4deg); }
    }

    .cx__glare {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      mix-blend-mode: screen;
      opacity: 0;
      background: radial-gradient(
        220px 220px at var(--gx, 50%) var(--gy, 40%),
        rgba(255, 246, 230, 0.5),
        transparent 60%
      );
      transition: opacity 0.4s ease;
    }
    .cx__piece-wrap:hover .cx__glare { opacity: 0.8; }

    .cx__hint {
      position: absolute;
      bottom: 4vh;
      left: 50%;
      transform: translateX(-50%);
      z-index: 3;
      font-family: var(--font-sans, sans-serif);
      text-transform: uppercase;
      letter-spacing: 0.26em;
      font-size: 0.62rem;
      color: rgba(168, 163, 154, 0.65);
      margin: 0;
      animation: cx-hint 4s ease-in-out infinite;
    }

    @keyframes cx-hint {
      0%, 100% { opacity: 0.35; }
      50%      { opacity: 0.8; }
    }

    @media (max-width: 860px) {
      .cx__stage {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 2rem;
      }
      .cx__copy { max-width: none; margin: 0 auto; order: 2; }
      .cx__piece-wrap { order: 1; max-width: 78vw; margin: 0 auto; }
    }

    @media (prefers-reduced-motion: reduce) {
      .cx__nebula,
      .cx__glow,
      .cx__piece,
      .cx__hint { animation: none; }
      .cx__piece-wrap { transition: none; }
    }
  </style>

  <script>
    type Star = { x: number; y: number; z: number; r: number; a: number; tw: number; warm: boolean };

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const root = document.getElementById('cx') as HTMLElement | null;
    const canvas = document.getElementById('cx-stars') as HTMLCanvasElement | null;
    const pieceWrap = document.getElementById('cx-piece') as HTMLElement | null;
    const glare = pieceWrap?.querySelector('.cx__glare') as HTMLElement | null;

    if (canvas && root) {
      const ctx = canvas.getContext('2d', { alpha: true })!;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      let w = 0, h = 0, stars: Star[] = [];
      const pointer = { x: 0, y: 0, tx: 0, ty: 0 };

      function resize() {
        w = root!.clientWidth;
        h = root!.clientHeight;
        canvas!.width = Math.floor(w * dpr);
        canvas!.height = Math.floor(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const density = Math.min(1, w / 1400);
        const count = Math.floor((w * h) / 6500 * density);
        stars = Array.from({ length: count }, () => {
          const z = 0.25 + Math.random() * 0.75;
          return {
            x: Math.random() * w,
            y: Math.random() * h,
            z,
            r: z * (Math.random() * 1.1 + 0.3),
            a: Math.random() * 0.5 + 0.35,
            tw: Math.random() * Math.PI * 2,
            warm: Math.random() < 0.14,
          };
        });
      }

      function frame(t: number) {
        ctx.clearRect(0, 0, w, h);
        pointer.x += (pointer.tx - pointer.x) * 0.05;
        pointer.y += (pointer.ty - pointer.y) * 0.05;
        const time = t * 0.001;
        for (const s of stars) {
          if (!reduce) {
            s.y += s.z * 0.12;
            if (s.y > h + 2) s.y = -2;
          }
          const px = s.x + pointer.x * s.z * 38;
          const py = s.y + pointer.y * s.z * 38;
          const tw = reduce ? 1 : 0.6 + 0.4 * Math.sin(time * 1.5 + s.tw);
          ctx.beginPath();
          ctx.arc(px, py, s.r, 0, Math.PI * 2);
          ctx.fillStyle = s.warm
            ? `rgba(214, 168, 110, ${s.a * tw})`
            : `rgba(242, 237, 228, ${s.a * tw})`;
          ctx.shadowBlur = s.r * 3;
          ctx.shadowColor = s.warm ? 'rgba(196,147,90,0.8)' : 'rgba(242,237,228,0.7)';
          ctx.fill();
        }
        ctx.shadowBlur = 0;
        if (!reduce) requestAnimationFrame(frame);
      }

      // Parallax: cursor tilts the piece opposite to stars for depth
      function onMove(cx: number, cy: number) {
        const nx = (cx / w) * 2 - 1;
        const ny = (cy / h) * 2 - 1;
        pointer.tx = nx;
        pointer.ty = ny;
        if (pieceWrap && !reduce) {
          pieceWrap.style.transform =
            `translate3d(${nx * -16}px, ${ny * -12}px, 0) rotateY(${nx * 7}deg) rotateX(${ny * -7}deg)`;
        }
      }

      window.addEventListener('pointermove', (e) => {
        onMove(e.clientX, e.clientY);
        if (glare) {
          const rect = pieceWrap!.getBoundingClientRect();
          glare.style.setProperty('--gx', `${((e.clientX - rect.left) / rect.width) * 100}%`);
          glare.style.setProperty('--gy', `${((e.clientY - rect.top) / rect.height) * 100}%`);
        }
      }, { passive: true });

      window.addEventListener('resize', resize);
      new ResizeObserver(resize).observe(root!);
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden && !reduce) requestAnimationFrame(frame);
      });

      resize();
      requestAnimationFrame(frame);
    }
  </script>
</Base>
