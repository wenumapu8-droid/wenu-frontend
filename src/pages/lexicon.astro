<Base
  title="Lexicon — the words, the materials, the symbols | Wenu Mapu"
  description="A working dictionary of the house: documented Mapudungun and Mapuche cosmological terms with their sources, the trade vocabulary of body jewelry, and the honest history of the symbols we are asked about — including the svastika."
  ogImage="/img/brand/meteorite-collection.webp"
  jsonLd={[lexiconLd, breadcrumbLd]}
>
  <article class="lex">

    <header class="lex__head">
      <p class="eyebrow">Léxico · Lexicon</p>
      <h1 class="lex__title">The words we use, and what they cost</h1>
      <p class="lex__lede">
        A dictionary is a promise. It says: here is what we mean, checkable, in
        the open — so that nothing has to hide inside a product description.
      </p>
      <p class="lex__lede">
        Three registers live on this page, and we keep them apart on purpose.
        Documented Mapuche culture, with sources named. The plain trade language
        of the craft. And the history of the symbols people ask us about — the
        difficult ones included, told straight.
      </p>
    </header>

    <nav class="lex__toc" aria-label="Lexicon sections">
      <ul>
        {groups.map(g => (
          <li>
            <a href={`#${g.id}`}>
              <span class="lex__toc-n">{g.n}</span>
              <span class="lex__toc-t">{g.title}</span>
            </a>
          </li>
        ))}
        <li>
          <a href="#sources">
            <span class="lex__toc-n">04</span>
            <span class="lex__toc-t">Sources</span>
          </a>
        </li>
      </ul>
    </nav>

    <section class="lex__note" aria-label="How to read this lexicon">
      <h2 class="lex__note-title">How to read this</h2>
      <p>
        We separate three kinds of statement, always, everywhere on this site.
      </p>
      <ul class="lex__note-list">
        <li>
          <strong>Documented.</strong> Recorded by named scholars and Mapuche
          speakers, in books you can find and read. It is cited. It is not ours.
        </li>
        <li>
          <strong>Folklore and popular tradition.</strong> Widely told, variable
          by territory, without a single authority. We name it as such.
        </li>
        <li>
          <strong>Wenu Mapu.</strong> Our own design, our own poetry, our own
          invention. It is the house speaking, and it carries no cultural
          authority whatsoever.
        </li>
      </ul>
      <p class="lex__note-foot">
        This page is open to correction. If you are Mapuche and something here is
        wrong, write to <a href="mailto:marimari@wenumapuonline.com">marimari@wenumapuonline.com</a> — we will listen, and we will fix it.
      </p>
    </section>

    {groups.map(g => (
      <section class="lex__group" id={g.id} aria-labelledby={`${g.id}-title`}>
        <header class="lex__group-head">
          <p class="lex__group-n">{g.n}</p>
          <p class="eyebrow">{g.kicker}</p>
          <h2 class="lex__group-title" id={`${g.id}-title`}>{g.title}</h2>
          <p class="lex__group-lede">{g.lede}</p>
        </header>

        <dl class="lex__list">
          {g.entries.map(e => (
            <div class="lex__entry">
              <dt class="lex__dt">
                <span class="lex__term" lang={e.arn ? 'arn' : undefined}>{e.term}</span>
                {e.say && <span class="lex__say">[ {e.say} ]</span>}
              </dt>
              <dd class="lex__dd">
                <p class="lex__gloss">{e.gloss}</p>
                {e.body.map(p => <p class="lex__body">{p}</p>)}
                {e.src && <p class="lex__src"><span class="lex__src-label">Source</span> {e.src}</p>}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}

    <section class="lex__group lex__group--sources" id="sources" aria-labelledby="sources-title">
      <header class="lex__group-head">
        <p class="lex__group-n">04</p>
        <p class="eyebrow">Provenance</p>
        <h2 class="lex__group-title" id="sources-title">Sources</h2>
        <p class="lex__group-lede">
          Every cultural and historical claim on this page comes from the works
          below. We are readers, not authorities. Where a source contradicts us,
          the source wins.
        </p>
      </header>
      <ol class="lex__sources">
        {sources.map(s => <li>{s}</li>)}
      </ol>
      <p class="lex__cta">
        <a href="/canon">The book that named us →</a>
      </p>
    </section>

  </article>

  <style>
    .lex {
      max-width: var(--max-w-narrow);
      margin: 0 auto;
      padding: var(--space-7) var(--gutter) var(--space-8);
    }

    /* ── Head ── */
    .lex__head { margin-bottom: var(--space-6); }
    .lex__title {
      font-family: var(--font-display);
      font-weight: var(--fw-regular);
      font-size: var(--fs-h1);
      line-height: 1.08;
      letter-spacing: -0.01em;
      color: var(--fg);
      margin: var(--space-3) 0 var(--space-4);
      max-width: 16ch;
    }
    .lex__lede {
      font-family: var(--font-serif);
      font-weight: var(--fw-thin);
      font-size: var(--fs-body-lg);
      line-height: 1.65;
      color: var(--fg-soft);
      margin: 0 0 var(--space-3);
      max-width: 58ch;
    }

    /* ── Table of contents ── */
    .lex__toc {
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: var(--space-4) 0;
      margin-bottom: var(--space-6);
    }
    .lex__toc ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: var(--space-2);
    }
    .lex__toc a {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      text-decoration: none;
      color: var(--fg-soft);
      transition: color var(--t-fast);
      padding: var(--space-1) 0;
    }
    .lex__toc a:hover,
    .lex__toc a:focus-visible { color: var(--accent); }
    .lex__toc-n {
      font-family: var(--font-mono);
      font-size: var(--fs-tiny);
      letter-spacing: var(--letter-spacing-archive);
      color: var(--accent);
      flex: 0 0 auto;
    }
    .lex__toc-t {
      font-family: var(--font-sans);
      font-size: var(--fs-body);
    }

    /* ── The honesty note ── */
    .lex__note {
      border-left: 1px solid var(--accent-dim);
      padding: var(--space-1) 0 var(--space-1) var(--space-4);
      margin-bottom: var(--space-7);
    }
    .lex__note-title {
      font-family: var(--font-sans);
      font-size: var(--fs-eyebrow);
      font-weight: var(--fw-medium);
      letter-spacing: var(--letter-spacing-ritual);
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 var(--space-3);
    }
    .lex__note p {
      font-family: var(--font-sans);
      font-size: var(--fs-small);
      line-height: 1.7;
      color: var(--fg-soft);
      margin: 0 0 var(--space-3);
      max-width: 62ch;
    }
    .lex__note-list {
      list-style: none;
      margin: 0 0 var(--space-3);
      padding: 0;
      display: grid;
      gap: var(--space-2);
    }
    .lex__note-list li {
      font-family: var(--font-sans);
      font-size: var(--fs-small);
      line-height: 1.7;
      color: var(--fg-soft);
      max-width: 62ch;
    }
    .lex__note-list strong { color: var(--fg); font-weight: var(--fw-medium); }
    .lex__note-foot a { color: var(--accent); }

    /* ── Groups ── */
    .lex__group {
      border-top: 1px solid var(--line);
      padding-top: var(--space-6);
      margin-bottom: var(--space-7);
      scroll-margin-top: var(--space-6);
    }
    .lex__group-head { margin-bottom: var(--space-6); }
    .lex__group-n {
      font-family: var(--font-mono);
      font-size: var(--fs-tiny);
      letter-spacing: var(--letter-spacing-archive);
      color: var(--fg-mute);
      margin: 0 0 var(--space-2);
    }
    .lex__group-title {
      font-family: var(--font-display);
      font-weight: var(--fw-regular);
      font-size: var(--fs-h2);
      line-height: 1.12;
      color: var(--fg);
      margin: var(--space-2) 0 var(--space-3);
    }
    .lex__group-lede {
      font-family: var(--font-serif);
      font-weight: var(--fw-thin);
      font-size: var(--fs-body-lg);
      line-height: 1.65;
      color: var(--fg-soft);
      margin: 0;
      max-width: 58ch;
    }

    /* ── Entries ── */
    .lex__list { margin: 0; padding: 0; }
    .lex__entry {
      border-top: 1px solid var(--line-soft);
      padding: var(--space-5) 0;
    }
    .lex__entry:first-child { border-top: 0; padding-top: 0; }

    .lex__dt {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-2) var(--space-3);
      margin: 0 0 var(--space-3);
    }
    .lex__term {
      font-family: var(--font-display);
      font-size: var(--fs-h3);
      line-height: 1.2;
      color: var(--fg);
    }
    .lex__say {
      font-family: var(--font-mono);
      font-size: var(--fs-tiny);
      letter-spacing: 0.06em;
      color: var(--fg-mute);
      white-space: nowrap;
    }

    .lex__dd { margin: 0; }
    .lex__gloss {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: var(--fs-body-lg);
      line-height: 1.5;
      color: var(--accent);
      margin: 0 0 var(--space-3);
      max-width: 52ch;
    }
    .lex__body {
      font-family: var(--font-sans);
      font-size: var(--fs-body);
      line-height: 1.75;
      color: var(--fg-soft);
      margin: 0 0 var(--space-3);
      max-width: 64ch;
    }
    .lex__body:last-of-type { margin-bottom: 0; }
    .lex__src {
      font-family: var(--font-mono);
      font-size: var(--fs-tiny);
      line-height: 1.7;
      letter-spacing: 0.03em;
      color: var(--fg-mute);
      margin: var(--space-3) 0 0;
      max-width: 64ch;
    }
    .lex__src-label {
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: var(--letter-spacing-archive);
      margin-right: var(--space-2);
    }

    /* ── Sources ── */
    .lex__sources {
      list-style: none;
      counter-reset: src;
      margin: 0;
      padding: 0;
      display: grid;
      gap: var(--space-3);
    }
    .lex__sources li {
      counter-increment: src;
      position: relative;
      padding-left: 2.5rem;
      font-family: var(--font-sans);
      font-size: var(--fs-small);
      line-height: 1.7;
      color: var(--fg-soft);
      max-width: 64ch;
    }
    .lex__sources li::before {
      content: counter(src, decimal-leading-zero);
      position: absolute;
      left: 0;
      top: 0.15em;
      font-family: var(--font-mono);
      font-size: var(--fs-tiny);
      color: var(--accent);
    }
    .lex__cta { margin: var(--space-6) 0 0; }
    .lex__cta a {
      font-family: var(--font-sans);
      font-size: var(--fs-small);
      letter-spacing: var(--letter-spacing-archive);
      text-transform: uppercase;
      color: var(--accent);
      text-decoration: none;
      border-bottom: 1px solid var(--accent-dim);
      padding-bottom: 2px;
      transition: color var(--t-fast);
    }
    .lex__cta a:hover { color: var(--fg); }

    /* ── Desktop: table of contents goes two-up ── */
    @media (min-width: 720px) {
      .lex__toc ul {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-2) var(--space-5);
      }
    }
  </style>
</Base>
