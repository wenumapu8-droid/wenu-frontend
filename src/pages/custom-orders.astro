---
import Base from '../layouts/Base.astro';
import EmbossedSeal from '../components/EmbossedSeal.astro';
import CustomOrderForm from '../components/forms/CustomOrderForm.astro';
import en from '../i18n/en.json';

const c = en.custom;
---
<Base
  title="Commissions — Custom forged jewelry | Wenu Mapu"
  description="Hand-forged custom rings, amulets, piercing tops, hangers and ear weights in sterling silver and 14k gold. 6-month lead time. Forged in Truckee, California."
  ogImage="/img/products/ritual-ring-950.webp"
>
  <!-- ── HERO ── -->
  <section class="custom-hero">
    <div class="custom-hero__copy">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="custom-hero__title">{c.title}</h1>
      <p class="custom-hero__intro">{c.intro}</p>
      <div class="custom-hero__cta">
        <a href="#start" class="btn btn--solid">{c.form.heading} <span aria-hidden="true">↓</span></a>
        <a href="#process" class="btn btn--ghost">See the process</a>
      </div>
    </div>
    <div class="custom-hero__media" aria-hidden="true">
      <picture>
        <source srcset="/img/products/ritual-ring-950.avif" type="image/avif" />
        <img src="/img/products/ritual-ring-950.webp" alt="" width="950" height="950" loading="eager" fetchpriority="high" />
      </picture>
      <div class="custom-hero__media-veil"></div>
      <div class="custom-hero__seal">
        <EmbossedSeal text="COMMISSIONS · BY HAND · 925 · 14K" size={140} />
      </div>
    </div>
  </section>

  <!-- ── SCOPE ── -->
  <section class="custom-scope" aria-labelledby="custom-scope-title">
    <div class="container">
      <h2 id="custom-scope-title" class="custom-section__title">{c.scope.heading}</h2>
      <ul class="custom-scope__grid">
        {c.scope.items.map(item => (
          <li class="custom-scope__item">
            <h3 class="custom-scope__title">{item.title}</h3>
            <p class="custom-scope__body">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── MATERIALS ── -->
  <section class="custom-materials" aria-labelledby="custom-materials-title">
    <div class="container">
      <p class="eyebrow">Materials</p>
      <h2 id="custom-materials-title" class="custom-section__title">{c.materials.heading}</h2>
      <p class="custom-section__intro">{c.materials.intro}</p>
      <div class="custom-materials__grid">
        {c.materials.items.map((m, i) => (
          <div class="custom-materials__card">
            <span class="custom-materials__index">0{i + 1}</span>
            <h3 class="custom-materials__name">{m.title}</h3>
            <p class="custom-materials__body">{m.body}</p>
            <p class="custom-materials__tag">{m.tag}</p>
          </div>
        ))}
      </div>
      <p class="custom-section__note">{c.materials.note}</p>
    </div>
  </section>

  <!-- ── PROCESS ── -->
  <section id="process" class="custom-process" aria-labelledby="custom-process-title">
    <div class="container">
      <p class="eyebrow">Process</p>
      <h2 id="custom-process-title" class="custom-section__title">{c.process.heading}</h2>
      <p class="custom-section__intro">{c.process.intro}</p>
      <ol class="custom-process__list">
        {c.process.steps.map(step => (
          <li class="custom-process__step">
            <span class="custom-process__num">{step.n}</span>
            <div class="custom-process__body">
              <div class="custom-process__head">
                <h3 class="custom-process__name">{step.title}</h3>
                <span class="custom-process__duration">{step.duration}</span>
              </div>
              <p class="custom-process__text">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── PAYMENT SCHEDULE / CUOTAS ── -->
  <section id="payment" class="custom-payment" aria-labelledby="custom-payment-title">
    <div class="container">
      <p class="eyebrow">Payment · 6 months · 4 installments</p>
      <h2 id="custom-payment-title" class="custom-section__title">Pay across the journey, not all at once.</h2>
      <p class="custom-section__intro">
        A commission is a slow piece — 6 months from brief to delivery. Payment follows the work, in four moments. Each installment unlocks the next phase of the forging. No interest, no fees, no third-party financing.
      </p>

      <div class="commission-timeline">
        <div class="commission-timeline__step">
          <div class="commission-timeline__phase">Month 0</div>
          <div class="commission-timeline__pct">30%</div>
          <h3 class="commission-timeline__title">Brief signed</h3>
          <p class="commission-timeline__body">Initial deposit. Locks the slot, covers material sourcing, design sketch, and the first conversations.</p>
        </div>
        <div class="commission-timeline__step">
          <div class="commission-timeline__phase">Month 2</div>
          <div class="commission-timeline__pct">30%</div>
          <h3 class="commission-timeline__title">Forge begins</h3>
          <p class="commission-timeline__body">Design approved. Materials sourced (meteorite, vacamuerta wood, gold/silver). Photos and short video of the piece taking shape.</p>
        </div>
        <div class="commission-timeline__step">
          <div class="commission-timeline__phase">Month 4</div>
          <div class="commission-timeline__pct">30%</div>
          <h3 class="commission-timeline__title">Polishing & finishing</h3>
          <p class="commission-timeline__body">Final pulido, hand-finishing, oxidation if required. WIP photo. The piece is almost itself.</p>
        </div>
        <div class="commission-timeline__step commission-timeline__step--final">
          <div class="commission-timeline__phase">Month 6</div>
          <div class="commission-timeline__pct">10%</div>
          <h3 class="commission-timeline__title">Delivery</h3>
          <p class="commission-timeline__body">Final fit (in-person if local, video call otherwise). Piece ships with certificate of authenticity and lifetime workshop repair on manufacturing defects.</p>
        </div>
      </div>

      <div class="commission-payment-methods">
        <p class="eyebrow">Accepted</p>
        <ul>
          <li>Stripe payment links (sent by email per installment) · cards, Apple Pay, Google Pay</li>
          <li>PayPal · for international clients</li>
          <li>Zelle / Venmo · for US clients (in lieu of card fees)</li>
          <li>Bank transfer (SWIFT) · for amounts over $3,000</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── TERMS ── -->
  <section class="custom-terms" aria-labelledby="custom-terms-title">
    <div class="container custom-terms__inner">
      <div class="custom-terms__head">
        <p class="eyebrow">Terms</p>
        <h2 id="custom-terms-title" class="custom-section__title">{c.terms.heading}</h2>
      </div>
      <ul class="custom-terms__list">
        {c.terms.items.map(t => {
          const m = /^\*\*(.+?)\*\*:\s*(.+)$/.exec(t);
          if (m) return (
            <li class="custom-terms__row">
              <span class="custom-terms__key">{m[1]}</span>
              <span class="custom-terms__val">{m[2]}</span>
            </li>
          );
          return <li class="custom-terms__row"><span class="custom-terms__val">{t}</span></li>;
        })}
      </ul>
    </div>
  </section>

  <!-- ── INQUIRY ── -->
  <section id="start" class="custom-form" aria-labelledby="custom-form-title">
    <div class="container custom-form__inner">
      <div class="custom-form__copy">
        <p class="eyebrow">Start your commission</p>
        <h2 id="custom-form-title" class="custom-section__title">{c.form.heading}</h2>
        <p class="custom-form__intro">{c.form.intro}</p>
      </div>
      <CustomOrderForm />
    </div>
  </section>
</Base>

<style>
  .custom-payment {
    background: var(--charcoal);
    padding: var(--space-7) 0;
    border-top: var(--border-thin);
    border-bottom: var(--border-thin);
  }
  .commission-timeline {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .commission-timeline__step {
    background: var(--obsidian);
    border: var(--border-thin);
    padding: var(--space-5);
    position: relative;
  }
  .commission-timeline__step--final {
    border-color: var(--ember);
  }
  .commission-timeline__phase {
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--bronze);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }
  .commission-timeline__pct {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--ember);
    margin-bottom: var(--space-3);
  }
  .commission-timeline__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--bone);
    text-transform: uppercase;
    margin: 0 0 var(--space-2);
  }
  .commission-timeline__body {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--fg-soft);
    font-weight: var(--fw-thin);
    margin: 0;
  }
  .commission-payment-methods {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px dotted rgba(168,163,154,0.3);
  }
  .commission-payment-methods ul {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: grid;
    gap: var(--space-2);
    max-width: 64ch;
  }
  .commission-payment-methods li {
    font-family: var(--font-serif);
    color: var(--fg-soft);
    line-height: 1.6;
    font-weight: var(--fw-thin);
    padding-left: var(--space-3);
    position: relative;
  }
  .commission-payment-methods li::before {
    content: '◆';
    position: absolute;
    left: 0;
    color: var(--ember);
    font-size: 0.7em;
    top: 0.5em;
  }
</style>
