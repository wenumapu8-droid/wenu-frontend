---
import Base from '../layouts/Base.astro';
import EmbossedSeal from '../components/EmbossedSeal.astro';
import CustomOrderForm from '../components/forms/CustomOrderForm.astro';
import en from '../i18n/en.json';

const c = en.custom;
---
<Base
  title="Commissions — Custom forged jewelry | Wenu Mapu"
  description="Hand-forged custom rings, amulets, piercing tops, hangers and ear weights in sterling silver and 14k gold. 6-month lead time. Forged in Truckee, California."
  ogImage="/img/products/ritual-ring-950.webp"
>
  <!-- ── HERO ── -->
  <section class="custom-hero">
    <div class="custom-hero__copy">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="custom-hero__title">{c.title}</h1>
      <p class="custom-hero__intro">{c.intro}</p>
      <div class="custom-hero__cta">
        <a href="#start" class="btn btn--solid">{c.form.heading} <span aria-hidden="true">↓</span></a>
        <a href="#process" class="btn btn--ghost">See the process</a>
      </div>
    </div>
    <div class="custom-hero__media" aria-hidden="true">
      <picture>
        <source srcset="/img/products/ritual-ring-950.avif" type="image/avif" />
        <img src="/img/products/ritual-ring-950.webp" alt="" loading="eager" decoding="async" />
      </picture>
      <div class="custom-hero__media-veil"></div>
      <div class="custom-hero__seal">
        <EmbossedSeal text="COMMISSIONS · BY HAND · 925 · 14K" size={140} />
      </div>
    </div>
  </section>

  <!-- ── SCOPE ── -->
  <section class="custom-scope" aria-labelledby="custom-scope-title">
    <div class="container">
      <h2 id="custom-scope-title" class="custom-section__title">{c.scope.heading}</h2>
      <ul class="custom-scope__grid">
        {c.scope.items.map(item => (
          <li class="custom-scope__item">
            <h3 class="custom-scope__title">{item.title}</h3>
            <p class="custom-scope__body">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── MATERIALS ── -->
  <section class="custom-materials" aria-labelledby="custom-materials-title">
    <div class="container">
      <p class="eyebrow">Materials</p>
      <h2 id="custom-materials-title" class="custom-section__title">{c.materials.heading}</h2>
      <p class="custom-section__intro">{c.materials.intro}</p>
      <div class="custom-materials__grid">
        {c.materials.items.map((m, i) => (
          <div class="custom-materials__card">
            <span class="custom-materials__index">0{i + 1}</span>
            <h3 class="custom-materials__name">{m.title}</h3>
            <p class="custom-materials__body">{m.body}</p>
            <p class="custom-materials__tag">{m.tag}</p>
          </div>
        ))}
      </div>
      <p class="custom-section__note">{c.materials.note}</p>
    </div>
  </section>

  <!-- ── PROCESS ── -->
  <section id="process" class="custom-process" aria-labelledby="custom-process-title">
    <div class="container">
      <p class="eyebrow">Process</p>
      <h2 id="custom-process-title" class="custom-section__title">{c.process.heading}</h2>
      <p class="custom-section__intro">{c.process.intro}</p>
      <ol class="custom-process__list">
        {c.process.steps.map(step => (
          <li class="custom-process__step">
            <span class="custom-process__num">{step.n}</span>
            <div class="custom-process__body">
              <div class="custom-process__head">
                <h3 class="custom-process__name">{step.title}</h3>
                <span class="custom-process__duration">{step.duration}</span>
              </div>
              <p class="custom-process__text">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── TERMS ── -->
  <section class="custom-terms" aria-labelledby="custom-terms-title">
    <div class="container custom-terms__inner">
      <div class="custom-terms__head">
        <p class="eyebrow">Terms</p>
        <h2 id="custom-terms-title" class="custom-section__title">{c.terms.heading}</h2>
      </div>
      <ul class="custom-terms__list">
        {c.terms.items.map(t => {
          const m = /^\*\*(.+?)\*\*:\s*(.+)$/.exec(t);
          if (m) return (
            <li class="custom-terms__row">
              <span class="custom-terms__key">{m[1]}</span>
              <span class="custom-terms__val">{m[2]}</span>
            </li>
          );
          return <li class="custom-terms__row"><span class="custom-terms__val">{t}</span></li>;
        })}
      </ul>
    </div>
  </section>

  <!-- ── INQUIRY ── -->
  <section id="start" class="custom-form" aria-labelledby="custom-form-title">
    <div class="container custom-form__inner">
      <div class="custom-form__copy">
        <p class="eyebrow">Start your commission</p>
        <h2 id="custom-form-title" class="custom-section__title">{c.form.heading}</h2>
        <p class="custom-form__intro">{c.form.intro}</p>
      </div>
      <CustomOrderForm />
    </div>
  </section>
</Base>
