---
import Base from '../layouts/Base.astro';
import CollectionView from '../components/CollectionView.astro';
import { LIMITED_OBJECTS } from '../data/editorial-collections';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wenumapuonline.com/' },
    { '@type': 'ListItem', position: 2, name: 'Limited Objects', item: 'https://wenumapuonline.com/limited-objects' },
  ],
};
---
<Base
  title="Limited Objects — one-of-one | Wenu Mapu"
  description={LIMITED_OBJECTS.intro.slice(0, 160)}
  ogImage={LIMITED_OBJECTS.webp}
  jsonLd={[breadcrumbLd]}
>
  <CollectionView collection={LIMITED_OBJECTS} />
</Base>
