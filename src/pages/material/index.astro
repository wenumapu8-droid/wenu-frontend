---
import Base from '../../layouts/Base.astro';
import PatternBand from '../../components/PatternBand.astro';
import en from '../../i18n/en.json';

const H = en.landing.material_hub;

const cards = [
  {
    key: 'sterling-silver',
    name: 'Sterling Silver 950',
    sub: 'Pure, durable, and alive with light.',
    img: '/img/products/ritual-ring-950.webp',
    avif: '/img/products/ritual-ring-950.avif',
  },
  {
    key: '14k-gold',
    name: '14k Gold',
    sub: 'Heirloom-grade. Warm. Made to outlast the wearer.',
    img: '/img/materials/14k-gold-hanger.webp',
    avif: '/img/materials/14k-gold-hanger.avif',
  },
  {
    key: 'titanium',
    name: 'Implant-grade Titanium',
    sub: 'Hypoallergenic, durable, lightweight. ASTM F-136.',
    img: '/img/categories/piercing.png',
  },
  {
    key: 'vacamuerta',
    name: 'Vacamuerta Meteorite',
    sub: "Cosmic fragments from Chile's Atacama Desert. 4.5 billion years old.",
    img: '/img/brand/meteorite-collection.webp',
    avif: '/img/brand/meteorite-collection.avif',
  },
  {
    key: 'walnut-wood',
    name: 'Walnut & Tropical Wood',
    sub: 'Sustainably sourced, warm, and grounded.',
    img: '/img/materials/walnut-wood.webp',
    avif: '/img/materials/walnut-wood.avif',
  },
  {
    key: 'brass-bronze',
    name: 'Brass & Bronze',
    sub: 'Ceremonial metals chosen for weight, patina and presence.',
    img: '/img/categories/ear-weights-archive.webp',
    avif: '/img/categories/ear-weights-archive.avif',
  },
];

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: H.title,
  description: H.intro,
  url: 'https://wenumapuonline.com/material/',
  isPartOf: { '@type': 'WebSite', name: 'Wenu Mapu', url: 'https://wenumapuonline.com' },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wenumapuonline.com/' },
    { '@type': 'ListItem', position: 2, name: 'Materials', item: 'https://wenumapuonline.com/material/' },
  ],
};
---
<Base
  title="Materials — Six material families | Wenu Mapu"
  description="The six material families behind every Wenu Mapu piece. Sterling silver, 14k gold, titanium, Atacama meteorite, walnut, brass."
  ogImage="/img/categories/amulets.webp"
  jsonLd={[collectionLd, breadcrumbLd]}
>
  <div class="cat-masthead cat-masthead--titled">
    <picture>
      <source type="image/avif" srcset="/img/banners/atmospheric/misty-ridge.avif" />
      <img src="/img/banners/atmospheric/misty-ridge.webp" alt="" width="1600" height="900" loading="eager" decoding="async" fetchpriority="high" />
    </picture>
    <div class="cat-masthead__label">
      <p class="cat-masthead__title">{H.title}</p>
      <p class="cat-masthead__eyebrow">{H.eyebrow}</p>
    </div>
  </div>

  <section class="section section--mega">
    <div class="container">
      <p class="eyebrow">{H.eyebrow}</p>
      <h1 class="page-title">{H.title}</h1>
      <p class="lede">{H.intro}</p>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>

      <div class="landing__copy">
        <p>{H.lede}</p>
      </div>

      <div class="landing__rail" aria-label="Six material families">
        <div class="featured-v2__rail">
          {cards.map(card => (
            <div class="featured-v2__cell">
              <a href={`/material/${card.key}/`} class="archive-card">
                <div class="archive-card__img-wrap">
                  <picture>
                    {card.avif && <source srcset={card.avif} type="image/avif" />}
                    <img src={card.img} alt="" loading="lazy" decoding="async" />
                  </picture>
                </div>
                <div class="archive-card__body">
                  <h2 class="archive-card__title">{card.name}</h2>
                  <p class="archive-card__sub">{card.sub}</p>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
