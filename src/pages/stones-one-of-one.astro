---
import Base from '../layouts/Base.astro';
import CollectionView from '../components/CollectionView.astro';
import { STONES_ONE_OF_ONE } from '../data/editorial-collections';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wenumapuonline.com/' },
    { '@type': 'ListItem', position: 2, name: 'Stones & One of One', item: 'https://wenumapuonline.com/stones-one-of-one' },
  ],
};
---
<Base
  title="Stones & One of One — stone & singular pieces | Wenu Mapu"
  description={STONES_ONE_OF_ONE.intro.slice(0, 160)}
  ogImage={STONES_ONE_OF_ONE.webp}
  jsonLd={[breadcrumbLd]}
>
  <CollectionView collection={STONES_ONE_OF_ONE} />
</Base>
