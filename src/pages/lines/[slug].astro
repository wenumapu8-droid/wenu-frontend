---
import Base from '../../layouts/Base.astro';

/* /lines/<slug> — landing por cada una de las 6 líneas cosmológicas canónicas.
   Spec: ~/Obsidian/WenuAgent/brand/01-identity/spec-coleccion-6-lineas-canonicas.md

   ESTADO 2026-06-03: estructura sin productos asignados. El copy editorial
   completo (150-300 palabras por línea) llega cuando Ocin fotografíe los
   capítulos correspondientes del libro Wenumapu (Canio & Pozo, 2015).
   Los slugs son canónicos y deben coincidir con CosmicLinesRail.            */

type LineGlyph = 'sun' | 'moon' | 'star' | 'constellation' | 'path' | 'dream';

interface LineData {
  slug: string;
  name: string;
  english: string;
  chapter: string;
  pages: string;
  glyph: LineGlyph;
  quote: string;
  cite: string;
  body: string[];
}

const lines: LineData[] = [
  {
    slug: 'antu',
    name: 'ANTÜ',
    english: 'the sun · the father',
    chapter: 'Capítulo 4',
    pages: 'pp. 106–118',
    glyph: 'sun',
    quote: 'Antü organiza los momentos del día. Padre que produce calor, permite la vida y la sabiduría.',
    cite: 'Canio & Pozo · Wenumapu, 2015',
    body: [
      'Antü es la primera línea — el sol como organizador del cosmos diurno. En la cosmovisión documentada por Canio y Pozo, Antü no es solo astro: es padre, es calor, es el principio que ordena el trabajo, la luz y la sabiduría.',
      'Las piezas de la línea Antü se forjan en oro 14k, gold-finish y metales cálidos. Energía de mediodía — statement, presencia, autoridad solar.',
    ],
  },
  {
    slug: 'kuyen',
    name: 'KÜYEN',
    english: 'the moon · the cycle',
    chapter: 'Capítulo 1',
    pages: 'pp. 40–63',
    glyph: 'moon',
    quote: 'Küyen organiza los trabajos cotidianos. Influencia en materias climáticas y en la perspectiva religiosa espiritual.',
    cite: 'Canio & Pozo · Wenumapu, 2015',
    body: [
      'Küyen es la segunda línea — la luna como organizadora del ciclo. Las piezas que aprendiste a llevar todos los días: lo cíclico, lo que vuelve, lo nocturno.',
      'Plata sterling, white gold, piedra luna. Energía de noche — sutil, persistente, lunar.',
    ],
  },
  {
    slug: 'wunelfe',
    name: 'WÜÑELFE',
    english: 'the first light',
    chapter: 'Capítulo 2',
    pages: 'pp. 64–71',
    glyph: 'star',
    quote: 'Wüñelfe — el lucero del amanecer, el reloj de los antiguos, el padre de todas las estrellas. Presente en rogativas familiares y ceremonias comunitarias.',
    cite: 'Canio & Pozo · Wenumapu, 2015',
    body: [
      'Wüñelfe es la tercera línea — el lucero del amanecer, la primera luz. Statement piece único, una pieza, una marca.',
      'Cualquier metal con una piedra protagónica: diamante, esmeralda, ónix, ópalo, amatista. La pieza que llevás cuando no necesitás muchas.',
    ],
  },
  {
    slug: 'wanlen',
    name: 'WANLEN',
    english: 'the constellation',
    chapter: 'Capítulo 3',
    pages: 'pp. 72–105',
    glyph: 'constellation',
    quote: 'Wanlen — totalidad de estrellas visibles. Las constelaciones organizan el cielo.',
    cite: 'Canio & Pozo · Wenumapu, 2015',
    body: [
      'Wanlen es la cuarta línea — la constelación. Lo que el oído dice cuando deja de hablar solo. Sets curados, múltiples piercings que conversan.',
      'Sub-líneas según constelaciones del libro: Mañke (Cóndor), Püñonchoike (Avestruz), Trarinmansun (Bueyes), Luwan (Guanaco), Naw (Papas Conglomeradas).',
      'Mix de metales — oro, plata, bronce en un mismo set. Cada pieza es una estrella; juntas dibujan algo más grande.',
    ],
  },
  {
    slug: 'rupu',
    name: 'RÜPÜ',
    english: 'the path',
    chapter: 'Capítulo 3 + contratapa',
    pages: '',
    glyph: 'path',
    quote: 'Rüpü — el camino del cielo, la Vía Láctea, el sendero por el cual las almas se desplazan al dejar la tierra.',
    cite: 'Canio & Pozo · Wenumapu, 2015',
    body: [
      'Rüpü es la quinta línea — el camino de los que se fueron. Memorial jewelry: piezas commemorativas para llevar a alguien que ya cruzó el cielo.',
      'Plata oxidada, grabado a mano, pieza única con nombre o coordenadas. Slow commerce — pedido a 6–8 semanas, hecho a la medida del recuerdo.',
    ],
  },
  {
    slug: 'pewma',
    name: 'PEWMA',
    english: 'the dream',
    chapter: 'Capítulo 7',
    pages: 'pp. 144–150',
    glyph: 'dream',
    quote: 'Pewma — el cielo también se conoce por medio de los sueños. Wüñelfe entrega el don de las lawentuchefe. Mensajes enviados por el Padre del Cielo.',
    cite: 'Canio & Pozo · Wenumapu, 2015',
    body: [
      'Pewma es la sexta línea — el sueño. Piezas que el cuerpo no recuerda llevar: sleeper hoops, retainers cómodos, titanium ultra-liviano para piercings nuevos.',
      'Implant-grade titanium, PTFE flexible, bioflex. Bone, plata, soft pearl. Lo que llevás cuando el cuerpo descansa.',
    ],
  },
];

export async function getStaticPaths() {
  // Mantener en sync con CosmicLinesRail. La lista vive duplicada a propósito —
  // este archivo se puede ejecutar standalone sin importar componentes Astro.
  const slugs = ['antu', 'kuyen', 'wunelfe', 'wanlen', 'rupu', 'pewma'];
  return slugs.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const line = lines.find(l => l.slug === slug);
if (!line) throw new Error(`Unknown line slug: ${slug}`);

// Prev / next navigation cyclic
const idx = lines.findIndex(l => l.slug === slug);
const prev = lines[(idx - 1 + lines.length) % lines.length];
const next = lines[(idx + 1) % lines.length];
---

<Base
  title={`${line.name} — ${line.english} · Wenu Mapu`}
  description={`${line.name} · ${line.english}. Línea cosmológica de Wenu Mapu basada en el ${line.chapter} de Wenumapu (Canio & Pozo, 2015).`}
>
  <article class="line-page">
    <header class="line-page__hero">
      <span class="line-page__glyph" aria-hidden="true">
        {line.glyph === 'sun' && (
          <svg viewBox="0 0 64 64" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
            <circle cx="32" cy="32" r="10" />
            <line x1="32" y1="6"  x2="32" y2="16" />
            <line x1="32" y1="48" x2="32" y2="58" />
            <line x1="6"  y1="32" x2="16" y2="32" />
            <line x1="48" y1="32" x2="58" y2="32" />
            <line x1="14" y1="14" x2="20" y2="20" />
            <line x1="44" y1="44" x2="50" y2="50" />
            <line x1="14" y1="50" x2="20" y2="44" />
            <line x1="44" y1="20" x2="50" y2="14" />
          </svg>
        )}
        {line.glyph === 'moon' && (
          <svg viewBox="0 0 64 64" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M42 10 a24 24 0 1 0 0 44 a18 18 0 1 1 0 -44 Z" />
          </svg>
        )}
        {line.glyph === 'star' && (
          <svg viewBox="0 0 64 64" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round">
            <path d="M32 6 L36 26 L56 32 L36 38 L32 58 L28 38 L8 32 L28 26 Z" />
          </svg>
        )}
        {line.glyph === 'constellation' && (
          <svg viewBox="0 0 64 64" width="56" height="56" fill="none" stroke="currentColor" stroke-width="0.8">
            <line x1="12" y1="18" x2="28" y2="26" />
            <line x1="28" y1="26" x2="48" y2="16" />
            <line x1="28" y1="26" x2="34" y2="46" />
            <line x1="34" y1="46" x2="52" y2="48" />
            <circle cx="12" cy="18" r="2" fill="currentColor" />
            <circle cx="28" cy="26" r="2.8" fill="currentColor" />
            <circle cx="48" cy="16" r="2" fill="currentColor" />
            <circle cx="34" cy="46" r="2.4" fill="currentColor" />
            <circle cx="52" cy="48" r="1.8" fill="currentColor" />
          </svg>
        )}
        {line.glyph === 'path' && (
          <svg viewBox="0 0 64 64" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
            <line x1="8" y1="52" x2="56" y2="12" stroke-dasharray="2 3" />
            <circle cx="14" cy="48" r="1.6" fill="currentColor" />
            <circle cx="24" cy="40" r="1.3" fill="currentColor" />
            <circle cx="34" cy="32" r="1.6" fill="currentColor" />
            <circle cx="44" cy="24" r="1.3" fill="currentColor" />
            <circle cx="52" cy="16" r="2"   fill="currentColor" />
          </svg>
        )}
        {line.glyph === 'dream' && (
          <svg viewBox="0 0 64 64" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M42 14 a22 22 0 1 0 0 38 a16 16 0 1 1 0 -38 Z" />
            <path d="M48 22 L50 26 L54 26 L50.8 28.6 L52 33 L48 30 L44 33 L45.2 28.6 L42 26 L46 26 Z" />
          </svg>
        )}
      </span>
      <h1 class="line-page__name">{line.name}</h1>
      <p class="line-page__english">{line.english}</p>
      <blockquote class="line-page__quote">{line.quote}</blockquote>
      <p class="line-page__cite">{line.cite} · {line.chapter}{line.pages ? `, ${line.pages}` : ''}</p>
    </header>

    <div class="line-page__body">
      {line.body.map(p => <p>{p}</p>)}

      <div class="line-page__placeholder">
        Pieces · Coming when the line is curated from the catalog.
        <br />
        <small style="opacity:0.7;letter-spacing:0.12em;">products will be tagged with cosmic_line in NocoDB · then synced to WC</small>
      </div>
    </div>

    <nav class="line-page__nav" aria-label="Cosmic lines navigation">
      <a href={`/lines/${prev.slug}`}>← {prev.name}</a>
      <span class="line-page__nav-center">{idx + 1} / {lines.length}</span>
      <a href={`/lines/${next.slug}`}>{next.name} →</a>
    </nav>
  </article>
</Base>
