---
import Base from '../../layouts/Base.astro';
import PatternBand from '../../components/PatternBand.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('journal'))
  .filter(e => e.data.series === 'apprentice')
  .sort((a, b) => (a.data.page ?? 0) - (b.data.page ?? 0));

const fmt = (d: unknown) =>
  new Date(d as string).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
const cleanTitle = (t: string) => t.replace(/^Page\s*\d+\s*—\s*/i, '');

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wenumapuonline.com/' },
    { '@type': 'ListItem', position: 2, name: 'Journal', item: 'https://wenumapuonline.com/journal/' },
    { '@type': 'ListItem', position: 3, name: "The Apprentice's Path", item: 'https://wenumapuonline.com/journal/apprentice' },
  ],
};
---
<Base
  title="The Apprentice's Path — a maker's diary | Wenu Mapu"
  description="The honest record of a maker still learning — the eternal apprentice. What the fire teaches, what gets ruined, what is understood too late."
  jsonLd={[breadcrumbLd]}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Diario de aprendiz</p>
      <h1 class="page-title">The Apprentice's Path</h1>
      <p class="lede apath__lede">The honest record of a maker still learning — the eternal apprentice. What the fire teaches, what gets ruined, what is understood too late. Different hands, different lands — the same sky.</p>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>

      <ol class="apath__list">
        {entries.map(e => (
          <li>
            <a href={`/journal/${e.id}`} class="apath__item">
              <span class="apath__media">
                <img src={e.data.ogImage} alt="" width="600" height="400" loading="lazy" decoding="async" />
              </span>
              <span class="apath__meta">
                <span class="apath__page">Page {e.data.page}{e.data.draft ? ' · draft' : ''}</span>
                <span class="apath__title">{cleanTitle(e.data.title)}</span>
                <span class="apath__date">{fmt(e.data.date)}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>

      {entries.length === 0 && (
        <p class="apath__lede">The first page is being written.</p>
      )}

      <div class="apath__cta">
        <p class="apath__cta-line">New pages arrive rarely. Join the first circle to receive them.</p>
        <a href="/#newsletter-signup" class="btn btn--ghost">Join the first circle <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .apath__lede { max-width: 60ch; }
  .apath__list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .apath__list > li { border-top: 1px solid var(--line); }
  .apath__list > li:last-child { border-bottom: 1px solid var(--line); }
  .apath__item {
    display: grid;
    grid-template-columns: clamp(96px, 18vw, 180px) 1fr;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) 0;
    text-decoration: none;
    color: inherit;
  }
  .apath__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bg-alt);
    border: var(--border-thin);
  }
  .apath__media img {
    width: 100%; height: 100%; object-fit: cover;
    filter: saturate(0.9) contrast(1.04);
    transition: transform var(--t-slow);
  }
  .apath__item:hover .apath__media img { transform: scale(1.04); }
  .apath__meta { display: flex; flex-direction: column; gap: var(--space-1); }
  .apath__page {
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    letter-spacing: var(--letter-spacing-ritual);
    text-transform: uppercase;
    color: var(--ember);
  }
  .apath__title {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h3);
    line-height: 1.15;
    color: var(--bone);
    transition: color var(--t-fast);
  }
  .apath__item:hover .apath__title { color: var(--ember); }
  .apath__date {
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--silver);
  }
  .apath__cta {
    margin-top: var(--space-7);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }
  .apath__cta-line {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-style: italic;
    font-size: var(--fs-body-lg);
    color: var(--fg-soft);
    margin: 0;
    max-width: 46ch;
  }
</style>
