---
// GALLERY — Nicolás Ortega · photography (separate from KODEX).
// Series rescued from Behance: Santiago, Emanes (act3) Pichilemu, Princesa Yuyo.
import Base from '../layouts/Base.astro';

const series = [
  {
    id: 'santiago', name: 'Santiago', place: 'Chile',
    note: 'The city read as texture, light and geometry.',
    photos: ['santiago-01', 'santiago-02'],
  },
  {
    id: 'emanes', name: 'Emanes', place: 'act 3 · Pichilemu',
    note: 'Ritual, body and landscape on the Chilean coast.',
    photos: Array.from({ length: 10 }, (_, k) => 'emanes-' + String(k + 1).padStart(2, '0')),
  },
  {
    id: 'yuyo', name: 'Princesa Yuyo', place: '',
    note: 'Photography folded into symmetry — bloom and mirror.',
    photos: ['yuyo-01', 'yuyo-02', 'yuyo-03'],
  },
];
---

<Base
  title="Gallery — Nicolás Ortega · Photography"
  description="Photography by Nicolás Ortega (Wenu Mapu). Series: Santiago, Emanes Pichilemu, Princesa Yuyo."
  robots="noindex, nofollow"
  noNav={true} noFooter={true} noOverlays={true} noQuote={true} noThemes={true}
>
  <div class="gx" data-gx>
    <header class="gx-head">
      <a class="gx-word" href="/">WENU MAPU</a>
      <nav class="gx-nav"><a href="/kodex">KODEX−∞</a></nav>
    </header>

    <section class="gx-intro">
      <p class="gx-over" data-reveal>PHOTOGRAPHY · NICOLÁS ORTEGA</p>
      <h1 class="gx-title" data-reveal>Gallery</h1>
      <p class="gx-lede" data-reveal>Light, body and territory. Series carried from the field into the frame.</p>
    </section>

    {series.map((s) => (
      <section class="gx-series" id={s.id}>
        <div class="gx-series__head" data-reveal>
          <h2 class="gx-series__name">{s.name}</h2>
          {s.place && <span class="gx-series__place">{s.place}</span>}
          <p class="gx-series__note">{s.note}</p>
        </div>
        <div class="gx-grid">
          {s.photos.map((p, i) => (
            <figure class="gx-photo" data-reveal>
              <img src={`/img/gallery/${p}.webp`} loading="lazy" alt={`${s.name} — photograph ${i + 1} by Nicolás Ortega`} />
            </figure>
          ))}
        </div>
      </section>
    ))}

    <footer class="gx-foot">
      <p data-reveal>Wenu Mapu · Truckee, CA</p>
    </footer>
  </div>

  <style>
    .gx {
      --ink:#f2efe9; --gray:#8f8f8f; --dim:#585858; --line:#1c1c1c;
      background:#0a0a0a; color:var(--ink);
      font-family:'Instrument Sans',system-ui,sans-serif; min-height:100vh;
    }
    .gx :where(a){ color:inherit; text-decoration:none; }
    .gx-head{ position:sticky; top:0; z-index:20; display:flex; align-items:center; justify-content:space-between;
      padding:18px clamp(18px,5vw,52px); background:linear-gradient(#0a0a0a 60%,transparent); }
    .gx-word{ font-family:'Instrument Serif',serif; font-size:20px; letter-spacing:.04em; }
    .gx-nav a{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.18em; color:var(--gray); transition:.3s; }
    .gx-nav a:hover{ color:var(--ink); }

    .gx-intro{ text-align:center; padding:clamp(40px,10vh,120px) 20px clamp(30px,6vh,60px); }
    .gx-over{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.3em; color:var(--gray); margin:0; }
    .gx-title{ font-family:'Instrument Serif',serif; font-weight:400; font-size:clamp(3rem,9vw,6.5rem); margin:14px 0 0; }
    .gx-lede{ max-width:40ch; margin:20px auto 0; font-size:15px; line-height:1.6; color:var(--gray); }

    .gx-series{ max-width:1200px; margin:0 auto; padding:clamp(30px,7vh,80px) clamp(18px,5vw,52px); }
    .gx-series__head{ border-top:1px solid var(--line); padding-top:22px; margin-bottom:clamp(22px,4vh,40px); }
    .gx-series__name{ font-family:'Instrument Serif',serif; font-weight:400; font-size:clamp(1.8rem,5vw,3rem); margin:0; display:inline; }
    .gx-series__place{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.16em; color:var(--gold,#c9a84c); margin-left:14px; }
    .gx-series__note{ font-size:14px; color:var(--gray); margin:12px 0 0; max-width:44ch; }

    /* masonry via CSS columns */
    .gx-grid{ column-count:2; column-gap:clamp(10px,1.6vw,18px); }
    .gx-photo{ break-inside:avoid; margin:0 0 clamp(10px,1.6vw,18px); background:#050505; overflow:hidden; }
    .gx-photo img{ width:100%; height:auto; display:block; opacity:.92; transition:opacity .5s, transform .6s; }
    .gx-photo:hover img{ opacity:1; transform:scale(1.02); }
    @media (min-width:1000px){ #emanes .gx-grid{ column-count:3; } }
    @media (max-width:620px){ .gx-grid{ column-count:1; } }

    .gx-foot{ text-align:center; padding:clamp(50px,10vh,120px) 20px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.2em; color:var(--dim); }

    [data-reveal]{ opacity:0; transform:translateY(16px); transition:opacity .9s ease, transform .9s ease; }
    [data-reveal].gx-in{ opacity:1; transform:none; }
    @media (prefers-reduced-motion:reduce){ [data-reveal]{ transition:opacity .01s; transform:none; } .gx-photo:hover img{ transform:none; } }
  </style>

  <script>
    (() => {
      const root = document.querySelector('[data-gx]'); if (!root) return;
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting){ e.target.classList.add('gx-in'); io.unobserve(e.target); } }), { threshold: 0.12 });
      root.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    })();
  </script>
</Base>
