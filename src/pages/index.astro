---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import EmbossedSeal from '../components/EmbossedSeal.astro';
import { getProducts } from '../lib/woo';
import en from '../i18n/en.json';
import map from '../i18n/mapudungun.json';

const products = await getProducts(6);
const featured = products.slice(0, 3);
---

<Base
  title="Wenu Mapu — Body jewelry forged in Truckee, California"
  description="Forged in Truckee. Worn as signal. Body jewelry forged by hand. No middlemen. No borrowed shelves."
>

  <!-- ── HERO: DARK COSMIC RITUAL ── -->
  <div class="hero-wrap">
    <section class="hero">

      <!-- Top-right: EmbossedSeal ritual mark -->
      <div style="position:absolute;top:var(--space-6);right:var(--gutter);opacity:0.55;">
        <EmbossedSeal text="WENU · MAPU · TRUCKEE · 2026" size={148} />
      </div>

      <!-- Top-left: four-direction mark + coordinates -->
      <div style="position:absolute;top:var(--space-6);left:var(--gutter);display:flex;align-items:center;gap:var(--space-3);">
        <span class="sacred-mark"></span>
        <span style="font-family:var(--font-sans);font-size:var(--fs-tiny);letter-spacing:var(--letter-spacing-ritual);text-transform:uppercase;color:var(--bronze);opacity:0.7;">
          39°19′N · 120°11′W
        </span>
      </div>

      <!-- Eyebrow -->
      <p class="hero__eyebrow">
        <span class="sacred-mark" style="width:16px;height:16px;"></span>
        {en.hero.eyebrow}
      </p>

      <!-- Mega title -->
      <h1 class="hero__title">Forged in Truckee.<br/>Worn as signal.</h1>

      <!-- Ritual italic line -->
      <p class="hero__ritual">{map.phrases.pewmangen} — I dreamt this.</p>

      <!-- Sub tagline -->
      <p class="hero__sub">Body jewelry made by hand · No middlemen · No borrowed shelves</p>

      <!-- CTAs -->
      <div class="hero__cta">
        <a href="/shop" class="btn btn--solid">Enter the catalogue</a>
        <a href="/local" class="btn">Local pickup · Truckee</a>
      </div>

    </section>
  </div>

  <!-- ── CONSTELLATION DIVIDER ── -->
  <div class="container" style="padding-top:var(--space-5);padding-bottom:var(--space-5);">
    <div class="constellation-divider">
      <span class="constellation-divider__label">KÜRÜF · FRAGMENTS FROM THE ARCHIVE</span>
    </div>
  </div>

  <!-- ── FEATURED PRODUCTS — ARCHIVE OBJECTS ── -->
  {featured.length > 0 && (
    <section class="section--tight" style="padding-top:0;">
      <div class="container">
        <div class="archive-grid">
          {featured.map((p, i) => (
            <ProductCard product={p} archive={true} fragmentIndex={i + 1} />
          ))}
        </div>
        <div style="margin-top:var(--space-4);display:flex;justify-content:flex-end;">
          <a href="/shop" class="btn btn--ghost">All fragments →</a>
        </div>
      </div>
    </section>
  )}

  <!-- ── CONSTELLATION DIVIDER 2 ── -->
  <div class="container" style="padding-top:var(--space-5);padding-bottom:var(--space-5);">
    <div class="constellation-divider">
      <span class="constellation-divider__label">NEWEN · MATERIAL &amp; METHOD</span>
    </div>
  </div>

  <!-- ── WHAT WE ARE — LIGHT SECTION ── -->
  <section class="section light" style="background: var(--bg);">
    <div class="container">
      <div class="grid-asym-2">
        <div>
          <p class="eyebrow">{en.what_we_are.eyebrow}</p>
          <h2 style="margin-top:var(--space-3);color:var(--fg);">{en.what_we_are.title}</h2>
        </div>
        <div>
          <p style="margin-bottom:var(--space-4);color:var(--fg);">{en.what_we_are.p1}</p>
          <p class="italic" style="margin-bottom:var(--space-5);color:var(--fg-soft);">{en.what_we_are.p2}</p>
          <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;">
            <a href="/shop" class="btn">{en.what_we_are.cta_primary}</a>
            <a href="/local" class="btn btn--ghost">{en.what_we_are.cta_secondary}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── VALUES GRID ── -->
  <section class="section--tight" style="border-top: var(--border-thin);">
    <div class="container">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:0;border-top:var(--border-accent);border-left:var(--border-accent);">
        {[
          { icon: '◆', ...en.values.noble },
          { icon: '◇', ...en.values.craft },
          { icon: '◈', ...en.values.ship },
          { icon: '◉', ...en.values.pickup },
        ].map((item: any) => (
          <div style="border-right:var(--border-accent);border-bottom:var(--border-accent);padding:var(--space-4);">
            <p class="text-bronze display" style="font-size:1.8rem;margin-bottom:var(--space-3);line-height:1;opacity:0.7;">{item.icon}</p>
            <h3 style="font-size:1.1rem;margin-bottom:var(--space-2);color:var(--fg);">{item.title}</h3>
            <p style="color:var(--fg-mute);font-size:var(--fs-small);line-height:1.55;max-width:none;">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── RITUAL CTA — COSMIC DARK ── -->
  <section class="section--mega" style="background:var(--charcoal);border-top:var(--border-accent);text-align:center;">
    <div class="container-narrow">

      <div style="display:flex;align-items:center;justify-content:center;gap:var(--space-3);margin-bottom:var(--space-5);">
        <span class="sacred-mark" style="width:20px;height:20px;"></span>
        <p class="eyebrow" style="margin:0;">{map.phrases.welcome}</p>
        <span class="sacred-mark" style="width:20px;height:20px;"></span>
      </div>

      <p class="mega" style="color:var(--bone);margin-bottom:var(--space-4);">
        Fragment.<br/>Worn.<br/>Signal.
      </p>

      <div class="constellation-divider" style="margin:0 auto var(--space-5);max-width:400px;">
        <span class="constellation-divider__label">TRUCKEE, CALIFORNIA</span>
      </div>

      <p class="italic" style="font-family:var(--font-serif);color:var(--silver);margin:0 auto var(--space-5);max-width:44ch;font-size:clamp(1rem,1.3vw,1.2rem);">
        Each piece leaves Truckee with a quiet intention.<br/>No middlemen. No borrowed shelves.
      </p>

      <a href="/shop" class="btn btn--solid" style="font-size:var(--fs-eyebrow);">Enter the catalogue</a>

    </div>
  </section>

</Base>
