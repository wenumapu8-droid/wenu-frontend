---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryStrip from '../components/CategoryStrip.astro';
import Newsletter from '../components/Newsletter.astro';
import PatternBand from '../components/PatternBand.astro';
import PowerAnimalsOracle from '../components/PowerAnimalsOracle.astro';
// ManifestoKultrunSection FUSED into EmberCore on the home (Ocin 2026-07-06) — the two
// kültrún sections ("The burning centre" + "Meli Witran Mapu · four lands, one drum")
// were near-duplicates; EmberCore now carries BOTH the ember fire + HUD + touch-to-ignite
// AND the four-lands "touch a land to turn the drum" interaction. This import + its usage
// below are kept (commented) so the standalone section can be reinstated at /manifesto or
// reverted here. Regla no-borrar: the component file stays in src/components/.
// import ManifestoKultrunSection from '../components/ManifestoKultrunSection.astro';
import MarqueeDrag from '../components/MarqueeDrag.astro';
import SignalBand from '../components/SignalBand.astro';
import FrequencyBand from '../components/FrequencyBand.astro';
import EmberCore from '../components/EmberCore.astro';
// PrefooterQuote moved to /canon (academic source page) — per Ocin 2026-06-07.
import HeroCarousel from '../components/HeroCarousel.astro';
import MandalaPortal from '../components/MandalaPortal.astro';
import CosmicLinesRail from '../components/CosmicLinesRail.astro';
// CollectionCarousel (abstract collection graphics) retired from the home
// 2026-07-05 per Ocin — replaced by PiercingBanner + MiniCatalog (real content).
// Component file kept in src/components/ for reuse; import archived below.
// import CollectionCarousel from '../components/CollectionCarousel.astro';
// PiercingBanner standalone section retired from the home 2026-07-07 per Ocin —
// duplicate of the hero carousel's piercing slide. Component kept for reuse.
// import PiercingBanner from '../components/PiercingBanner.astro';
import DesignYourEarBanner from '../components/DesignYourEarBanner.astro';
// MiniCatalog (horizontal snap rail) retired from the home 2026-07-05 per Ocin —
// replaced by CatalogDeck (stacked, swipeable deck of pieces à la MP "Sugerencias").
// Component file kept in src/components/ for reuse; import left for easy revert.
import MiniCatalog from '../components/MiniCatalog.astro';
import CatalogDeck from '../components/CatalogDeck.astro';
import FeaturedShowcase from '../components/FeaturedShowcase.astro';
import { getProducts } from '../lib/woo';
import { collections } from '../data/collections';
import { getCollection } from 'astro:content';
import en from '../i18n/en.json';

const products = await getProducts();

// Home "Portals" showcase — surface the strongest collections by real catalog
// depth (NocoDB counts: origin 69, neo 27, organic 24, ornamental 11,
// india 10, atacama 7). The thin lines (araucanía/maya, 1 each) are kept off
// the home grid but remain reachable at /collection. Banners carry their own
// baked title art, so the cards render the artwork frame-only (no HTML title).
const HOME_COLLECTION_ORDER = ['origin', 'neo', 'organic', 'ornamental', 'india', 'atacama'];
const homeCollections = HOME_COLLECTION_ORDER
  .map(slug => collections.find(c => c.slug === slug))
  .filter((c): c is (typeof collections)[number] => Boolean(c));

// Power-animal poster series (maestro "animales de poder"). Baked-text brand
// posters — displayed whole as a guardian gallery, museum-label captions below.
const POWER_ANIMALS = ['puma', 'condor', 'serpiente', 'zorro', 'ballena', 'pudu'] as const;

// Featured surface should never show "NO IMAGE" placeholders to first-time
// visitors — filter products with no main image before slicing.
const withImage = products.filter(p => p.images.length > 0 && p.images[0].src);

// Also exclude products whose primary image is a known placeholder
// (AI-generated mockups from the legacy import, untitled exports, etc.).
// Real product macros live under /wp-content/uploads/.../wm-<sku>-... or
// any non-placeholder slug. This keeps the Featured rail consistent with
// the brand's macro photography standard.
const PLACEHOLDER_IMG = /chatgpt-image|sin-?titulo|sin-?t[íi]tulo|placeholder|untitled/i;
const curated = withImage.filter(p => !PLACEHOLDER_IMG.test(p.images[0].src));
// Lead with the crown jewels — the exclusive, one-of-one pieces that carry the
// brand (meteorite, Nico's wire-wrap, Alai Wakan, Galo). These were buried; the
// home Featured rail now opens with them. Falls back to curatedStrong if a slug
// isn't resolvable. Order = display order (rail shows the first 4).
const FEATURED_SLUGS = [
  'jimmy-atacama-meteorite-ring-19mm-casting',
  'ancient-picoyo-pendant-with-silver-inlays',
  'alai-wakan-articulated-triangle-hanger-bronze-alpaca-jump-link',
  'labradorite-wire-wrapped-pendant-gold-silver-mont-shasta',
  'ritual-ring-vacamuerta-n-3-sterling-silver-atacama-meteorite',
  'galo-escultor-bronze-ant-miniature-sculpture-1-casting-mexico',
];
const WEAK_CATEGORY = /uncategorized/i;

function hasWeakCategory(p: typeof products[number]) {
  return p.categories.some(c => WEAK_CATEGORY.test(c.slug) || WEAK_CATEGORY.test(c.name));
}

function deriveBadge(p: typeof products[number], idx: number): string | null {
  const q = p.stock_quantity;
  if (typeof q === 'number' && q > 0 && q <= 3) return 'LIMITED';
  if (idx < 2) return 'NEW';
  return null;
}

const curatedStrong = curated.filter(p => !hasWeakCategory(p));
const preferredFeatured = FEATURED_SLUGS
  .map(slug => curatedStrong.find(p => p.slug === slug))
  .filter((p): p is typeof products[number] => Boolean(p));
const featuredSource = preferredFeatured.length >= 4 ? preferredFeatured : curatedStrong.slice(0, 4);
const featured = featuredSource.slice(0, 4).map((p, i) => ({
  product: p,
  badge: deriveBadge(p, i),
}));

// ── HOME VITRINE (Ocin 2026-07-05) ──────────────────────────────────────────
// The home felt empty of real product photography. After recovering 203 photos,
// many pieces now have real galleries. Surface a richer real-products vitrine:
// lead with the crown jewels, then fill with the strongest-gallery curated
// pieces that carry real macro photos (not placeholders), deduped, 8 total.
const richGallery = (p: typeof products[number]) => (p.images?.length ?? 0) >= 2;
const showcaseSeen = new Set<string>();
const showcaseProducts = [
  ...preferredFeatured,
  ...curatedStrong.filter(richGallery),
  ...curatedStrong,
]
  .filter(p => (showcaseSeen.has(p.slug) ? false : (showcaseSeen.add(p.slug), true)))
  .slice(0, 8);

// ── CATALOGUE DECK (Ocin 2026-07-05) ────────────────────────────────────────
// Stacked, swipeable DECK of real catalogue pieces — the MP "Sugerencias" MECHANISM
// (peeked stack, swipe the top card to bring the next) rendered in the Wenu world.
// Real WooCommerce pieces with real macro photos, deduped, each links to its PDP;
// the deck leads to /shop. Mix crown jewels + strong-gallery curated pieces so the
// deck reads as a genuine escaparate (12 max — the deck loops over the selection).
// `miniCatalog` (same source) still feeds the retired MiniCatalog if reverted.
const miniSeen = new Set<string>();
const catalogDeck = [
  ...preferredFeatured,
  ...curatedStrong.filter(richGallery),
  ...curatedStrong,
]
  .filter(p => (miniSeen.has(p.slug) ? false : (miniSeen.add(p.slug), true)))
  .slice(0, 12);
const miniCatalog = catalogDeck.slice(0, 10);

// ── "JUST LANDED" — newest published pieces (real photo, sorted by date) ─────
// WooCommerce ships date_created on the product JSON; sort desc for the true
// newest. Fall back to catalog order if timestamps are absent. Feeds the home
// New-arrivals strip AND the Nav "New arrivals" preview.
const newest = [...curated]
  .sort((a, b) => {
    const da = a.date_created_gmt || a.date_created || '';
    const db = b.date_created_gmt || b.date_created || '';
    return db.localeCompare(da);
  })
  .slice(0, 8);

// ── EXPLORE-BY tiles (north 2026-06-23: one idea per screen, 2-up) ──
const findImg = (slug: string) => products.find(p => p.slug === slug)?.images?.[0]?.src ?? null;
const cat = (n: string) => ({ avif: `/img/banners/category/${n}.avif`, webp: `/img/banners/category/${n}.webp` });
const explorePiercing = [
  { label: 'Septum',     href: '/piercing-jewelry', ...cat('septum') },
  { label: 'Plugs',      href: '/piercing-jewelry', ...cat('plug') },
  { label: 'Tunnels',    href: '/piercing-jewelry', ...cat('tunnel') },
  { label: 'Rings',      href: '/piercing-jewelry', ...cat('ring') },
  { label: 'Hangers',    href: '/piercing-jewelry', ...cat('hanger') },
  { label: 'Ear cuffs',  href: '/piercing-jewelry', ...cat('ear-cuff') },
  { label: 'Earrings',   href: '/piercing-jewelry', ...cat('earring') },
  { label: 'Necklaces',  href: '/piercing-jewelry', ...cat('necklace') },
  { label: 'Bracelets',  href: '/piercing-jewelry', ...cat('bracelet') },
];
const coll = (n: string) => ({ avif: `/img/banners/collection/${n}.avif`, webp: `/img/banners/collection/${n}.webp` });
const exploreStone = [
  { label: 'Meteorite',          href: '/collection/atacama',    ...coll('atacama') },
  { label: 'Wood & bone',        href: '/collection/organic',    ...coll('organic') },
  { label: 'Fossil',             href: '/collection/fossil',     ...coll('fossil') },
  { label: 'Brass · solar',      href: '/collection/solar',      ...coll('solar') },
  { label: 'Ornamental',         href: '/collection/ornamental', ...coll('ornamental') },
  { label: 'Araucanía',          href: '/collection/araucania',  ...coll('araucania') },
  { label: 'Stone · one of one', href: '/stones-one-of-one',     ...coll('neo') },
];

// Latest 3 journal entries (image + title + date).
const journalEntries = (await getCollection('journal'))
  .filter(e => !e.data.draft)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
  .slice(0, 3);
const fmtJournalDate = (d: unknown) =>
  new Date(d as string).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });

// ── SIGNAL BAND · inline category filter (Ocin 2026-07-06) ──────────────────
// The "Forged on earth, worn by the sky" band chips now FILTER INLINE: tapping a
// chip swaps the featured piece to a representative of THAT category, in-page, no
// navigation. Build a representative product per chip at build time from the real
// WooCommerce catalog (getHeroImage skips ruler/placeholder shots so the swap
// always shows a real macro). Each chip maps to real WC category slugs (verified
// against getCategories() — same set CategoryStrip uses). Tap the piece → its PDP;
// "Enter the collection →" is the only CTA that navigates (to the filtered /shop).
const signalChips = [
  { key: 'piercing', label: 'Piercing',          href: '/shop?cat=piercing-en',     match: /piercing|septum|nostril|labret|helix|tragus|conch|daith|industrial|flat|eyebrow|nipple|lip|tongue/i },
  { key: 'hangers',  label: 'Hangers · Weights', href: '/shop?cat=hangers-weights', match: /hanger|weight|pendiente|peso/i },
  { key: 'ear',      label: 'Ear jewelry',       href: '/shop?cat=earrings',        match: /earring|ear-jewel|aros?\b|cuff|stud/i },
  { key: 'rings',    label: 'Rings',             href: '/shop?cat=ring',            match: /\bring\b|anillo/i },
  { key: 'plugs',    label: 'Plugs',             href: '/shop?cat=plug',            match: /plug|tunnel|tunel|expansi|stretch|tapon/i },
];
// Prefer a curated piece with a real macro photo in the matching category; fall
// back to any product in that category, then to a strong curated piece so a chip
// is never empty. Dedupe so two chips don't surface the identical piece when the
// catalog is thin.
const signalUsed = new Set<string>();
function pickForChip(match: RegExp) {
  const inCat = (p: typeof products[number]) =>
    p.categories.some(c => match.test(c.slug) || match.test(c.name));
  const pools = [
    curatedStrong.filter(p => richGallery(p) && inCat(p)),
    curatedStrong.filter(inCat),
    curated.filter(inCat),
    curatedStrong.filter(richGallery),
    curatedStrong,
  ];
  for (const pool of pools) {
    const pick = pool.find(p => !signalUsed.has(p.slug));
    if (pick) { signalUsed.add(pick.slug); return pick; }
  }
  return null;
}
const signalCategories = signalChips
  .map(c => ({ ...c, product: pickForChip(c.match) }))
  .filter((c): c is typeof c & { product: NonNullable<typeof c['product']> } => Boolean(c.product));

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://wenumapuonline.com/#organization',
  name: 'Wenu Mapu',
  url: 'https://wenumapuonline.com',
  logo: 'https://wenumapuonline.com/logos/wenu-mapu-square.png',
  description: 'Ancestral-cosmic body jewelry forged by hand in Truckee, California. Implant-grade titanium, sterling silver, 14k gold.',
  email: 'marimari@wenumapuonline.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Truckee',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  founder: {
    '@id': 'https://wenumapuonline.com/#person-nicolas-ortega',
  },
  sameAs: [
    'https://instagram.com/wenu__mapu',
    'https://tiktok.com/@wenumapu',
    'https://pinterest.com/wenumapu',
    'https://www.behance.net/wenumapu',
  ],
};

// Person schema — connects Nicolás Ortega across platforms (Google identity graph).
// sameAs is the authoritative signal for entity resolution.
// hasCredential is the SEO signal that gets him recognized as a certified piercer
// in Google Knowledge Panel (canonical source: Obsidian credenciales-y-cv.md).
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://wenumapuonline.com/#person-nicolas-ortega',
  name: 'Nicolás Ortega García',
  givenName: 'Nicolás',
  familyName: 'Ortega García',
  alternateName: ['Nicolás Ortega', 'Ocin', 'Nico'],
  jobTitle: 'Designer · Founder · Professional Piercer',
  worksFor: { '@id': 'https://wenumapuonline.com/#organization' },
  url: 'https://wenumapuonline.com/about',
  sameAs: [
    'https://www.linkedin.com/in/nicolas-ortega-790538279/',
    'https://www.behance.net/wenumapu',
    'https://www.instagram.com/0cin8/',
    'https://www.instagram.com/wenu__mapu/',
    'https://www.tiktok.com/@wenumapu',
  ],
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'APP Core Essentials Vol. 4',
      credentialCategory: 'certificate',
      recognizedBy: { '@type': 'Organization', name: 'Association of Professional Piercers' },
      dateCreated: '2025-12',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Bloodborne Pathogens Certification (OSHA-compliant)',
      credentialCategory: 'certificate',
      recognizedBy: { '@type': 'Organization', name: 'American Heart Association' },
      validFrom: '2023-01-01',
      expires: '2027-12-31',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'First Aid · CPR · AED',
      credentialCategory: 'certificate',
      recognizedBy: { '@type': 'Organization', name: 'American Heart Association' },
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Continuing Education · Professional Piercers Collective',
      credentialCategory: 'certificate',
      recognizedBy: { '@type': 'Organization', name: 'Professional Piercers Collective' },
      dateCreated: '2025-11',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Industrial Design',
      credentialCategory: 'degree',
      recognizedBy: { '@type': 'CollegeOrUniversity', name: 'Duoc UC', address: { '@type': 'PostalAddress', addressLocality: 'Santiago', addressCountry: 'CL' } },
      dateCreated: '2020-08',
    },
  ],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Wenu Mapu',
  url: 'https://wenumapuonline.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://wenumapuonline.com/shop?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

// HERO 2026-06-03: rediseñado al lenguaje visual de la tapa del libro Wenumapu
// (spec brand/02-visual-system/spec-hero-rediseno-tapa-libro.md). El rotator
// anterior (4 banners full-bleed) queda archivado en git history. El kultrún
// ornamentado se mantiene como momento editorial profundo más abajo en
// ManifestoKultrunSection.
---

<Base
  title="Wenu Mapu — Adornment for the sacred body"
  description="Ancestral-cosmic body jewelry forged by hand in Truckee, California. Implant-grade titanium, sterling silver, 14k gold. Custom commissions accepted."
  jsonLd={[orgLd, personLd, websiteLd]}
>

  <!-- ── HERO — carrusel rotativo (cosmos · cuerpo · paisajes · pieza) ── -->
  <div class="hero-with-portal-seal">
    <HeroCarousel ctaHref="/shop" ctaLabel="Shop the pieces" />
    <!-- Spinning mandala seal in the bottom-right of the hero. Unified portal
         component: text rotates around; the mandala in the centre spins on
         its own axis. Click → /experience/. Wrapped in an index-scoped div so the
         absolute positioning applies (the component root carries its OWN Astro
         scope hash, so a class passed to it can't be targeted by this page's
         scoped <style> — the seal would otherwise fall back to in-flow and spill
         below the hero into the next band). -->
    <div class="hero-portal-seal-position">
      <MandalaPortal variant="seal" />
    </div>
  </div>
  <style>
    .hero-with-portal-seal { position: relative; }
    .hero-portal-seal-position {
      position: absolute;
      right: clamp(20px, 4vw, 56px);
      bottom: clamp(20px, 4vw, 56px);
      z-index: 4;
    }
  </style>

  {/* ── EXPLORE BY PIERCING ── 2-up · one idea per screen (north 2026-06-23).
       Moved to sit DIRECTLY under the hero carousel (Ocin 2026-07-07): the two
       Explore-by sections (piercing → collection) are now the FIRST thing after the
       hero slides, above Design-your-ear / SignalBand / New arrivals / CatalogDeck.
       Their shared <style> block stays lower in the page (CSS is page-global). ── */}
  <section class="explore" aria-labelledby="explore-piercing-title">
    <div class="container explore__head">
      <p class="eyebrow">Shop by piercing</p>
      <h2 id="explore-piercing-title" class="explore__title">Explore by piercing</h2>
      <a href="/piercing-jewelry" class="explore__viewall">View all <span aria-hidden="true">→</span></a>
    </div>
    <div class="explore__marquee" data-explore-marquee>
      <div class="explore__track">
        {[...explorePiercing, ...explorePiercing].map((t, i) => (
          <a href={t.href} class="explore__tile" aria-label={t.label} aria-hidden={i >= explorePiercing.length ? 'true' : undefined} tabindex={i >= explorePiercing.length ? -1 : undefined}>
            <picture>
              <source type="image/avif" srcset={t.avif} />
              <img src={t.webp} alt={`Wenu Mapu — ${t.label}`} width="1200" height="900" loading="lazy" decoding="async" style="object-position: 22% center;" />
            </picture>
            <span class="explore__veil" aria-hidden="true"></span>
            <span class="explore__label">{t.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── EXPLORE BY STONE & MATERIAL ── 2-up ── */}
  <section class="explore explore--collections" aria-labelledby="explore-stone-title">
    <div class="container explore__head">
      <p class="eyebrow">Shop by collection</p>
      <h2 id="explore-stone-title" class="explore__title">Explore by collection</h2>
      <a href="/collection/" class="explore__viewall">View all <span aria-hidden="true">→</span></a>
    </div>
    <div class="explore__marquee explore__marquee--rev" data-explore-marquee>
      <div class="explore__track">
        {[...exploreStone, ...exploreStone].map((t, i) => (
          <a href={t.href} class="explore__tile" aria-label={t.label} aria-hidden={i >= exploreStone.length ? 'true' : undefined} tabindex={i >= exploreStone.length ? -1 : undefined}>
            <picture>
              <source type="image/avif" srcset={t.avif} />
              <img src={t.webp} alt={`Wenu Mapu — ${t.label}`} width="1200" height="900" loading="lazy" decoding="async" />
            </picture>
            <span class="explore__veil" aria-hidden="true"></span>
            <span class="explore__label">{t.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── PIERCING BANNER ── standalone service banner RETIRED from the home
       (Ocin 2026-07-07). The piercing story now lives as a slide inside the
       HeroCarousel, so this standalone section was a duplicate. Component file
       kept in src/components/PiercingBanner.astro for reuse (no-borrar rule);
       only the home render is removed. Reversible: uncomment <PiercingBanner />.
       <PiercingBanner /> */}

  {/* ── DESIGN YOUR EAR ── dedicated invitation to co-design a curated ear
       (Ocin 2026-07-06). Promotes the /constelaciones experience from a buried
       ghost button into a real, meaningful banner: Ocin's own annotated ear-map
       as a live "planning canvas", the opportunity spelled out (bespoke
       constellation, plotted on your anatomy, piercer-evaluated), CTA straight to
       /constelaciones. Image + CSS only, both themes, mobile-first. Reversible:
       delete this line + its import. ── */}
  <DesignYourEarBanner />

  {/* ── SIGNAL / TRANSMISSION BAND ── moved ABOVE Ngen/CatalogDeck (Ocin 2026-07-06).
       "Forged on earth, worn by the sky" with category chips that now FILTER INLINE:
       tapping a chip swaps the featured piece to a representative of that category in
       the same page (no navigation); tap the piece → its PDP; "Enter the collection →"
       is the CTA that navigates to the filtered /shop. Real pieces + subtle entrance
       glitch, fed the crown jewels + per-chip representatives built at build time. ── */}
  <SignalBand products={showcaseProducts} categories={signalCategories} />

  {/* ── JUST LANDED ── the newest published pieces, real photos, sorted by date.
       Reordered 2026-07-07 (Ocin): sits directly under the SignalBand and directly
       above the CatalogDeck → SignalBand → New arrivals → Ngen/CatalogDeck. ── */}
  {newest.length > 0 && (
    <FeaturedShowcase
      products={newest}
      eyebrow="We foliltun · Just landed"
      title="New arrivals"
      ctaHref="/new-arrivals"
      ctaLabel="See all new arrivals"
    />
  )}

  {/* ── CATALOGUE DECK (Ngen) ── moved directly BELOW New arrivals (Ocin 2026-07-07).
       Stacked, swipeable deck of real pieces — the MP "Sugerencias" MECHANISM. Real
       WooCommerce pieces, macro photo + name + price, tap → PDP; the deck loops and
       leads to /shop. ── */}
  <CatalogDeck products={catalogDeck} />

  <style>
    .explore { padding: var(--section-y) 0; }
    /* Two explore marquees run back-to-back (piercing → collection). Collapse the
       second's top padding so the seam between them matches one-section rhythm. */
    .explore + .explore { padding-top: 0; }
    .explore__head {
      display: flex; align-items: baseline; justify-content: space-between;
      flex-wrap: wrap; gap: var(--space-2) var(--space-4);
      margin-bottom: var(--space-5);
    }
    .explore__head .eyebrow { flex-basis: 100%; }
    .explore__title {
      font-family: var(--font-display); font-weight: var(--fw-regular);
      font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.05;
      color: var(--bone); margin: var(--space-1) 0 0;
    }
    .explore__viewall {
      font-family: var(--font-sans); font-size: var(--fs-eyebrow);
      letter-spacing: var(--letter-spacing-ritual); text-transform: uppercase;
      color: var(--ember); text-decoration: none; white-space: nowrap;
      transition: color var(--t-fast);
    }
    .explore__viewall:hover { color: var(--bone); }
    /* Auto-scrolling category band (marquee). Track holds the list twice and
       shifts -50% so the loop is seamless. Hover/focus pause; reduced-motion
       stops it and lets the user scroll by hand. */
    .explore__marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    }
    .explore__track {
      display: flex; gap: var(--space-3); width: max-content;
      animation: explore-scroll 72s linear infinite;
      will-change: transform;
    }
    .explore__marquee--rev .explore__track { animation-direction: reverse; }
    /* Collection banners already carry their NAME + tagline baked in → hide the
       duplicate code label, and use a landscape card so the baked title shows in
       full (not side-cropped like the 4:5 piercing tiles). */
    .explore__marquee--rev .explore__label { display: none; }
    .explore__marquee--rev .explore__veil { display: none; }
    .explore__marquee--rev .explore__tile {
      flex-basis: clamp(300px, 40vw, 480px);
      aspect-ratio: 16 / 9;
      /* The collection banners are near-black at the edges and carry no label/veil
         (their title is baked in) → on the obsidian page they bled into the
         background and the whole band read as "not there". A hairline gives each
         banner an edge without touching the artwork. */
      border: 1px solid var(--line-soft);
    }
    .explore__marquee--rev .explore__tile img { object-position: center; }
    .explore__collection-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(var(--space-2), 1.8vw, var(--space-4));
    }
    .explore__tile--collection {
      min-width: 0;
      aspect-ratio: 16 / 9;
    }
    .explore__tile--collection .explore__label,
    .explore__tile--collection .explore__veil {
      display: none;
    }
    .explore__tile--collection img {
      object-position: center;
    }
    .explore__marquee:hover .explore__track,
    .explore__marquee:focus-within .explore__track { animation-play-state: paused; }
    @keyframes explore-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .explore__tile {
      position: relative; display: block; flex: 0 0 clamp(210px, 24vw, 300px);
      aspect-ratio: 4 / 5; overflow: hidden;
      background: var(--obsidian); text-decoration: none;
    }
    @media (prefers-reduced-motion: reduce) {
      /* No motion allowed → the band becomes a plain, hand-scrollable row.
         The duplicated set only exists to make the loop seamless, so hide it
         here (it stays aria-hidden either way) and drop the edge mask so the
         first tile isn't clipped. THIS is the only place the duplicates should
         be hidden — hiding them while the marquee animates leaves the reverse
         band with nothing to show. */
      .explore__marquee {
        overflow-x: auto;
        -webkit-mask-image: none; mask-image: none;
        scrollbar-width: none;
      }
      .explore__marquee::-webkit-scrollbar { display: none; }
      .explore__track { animation: none; }
      .explore__tile[aria-hidden="true"] { display: none; }
    }
    .explore__tile img {
      width: 100%; height: 100%; object-fit: cover;
      filter: saturate(0.92) contrast(1.04); transition: transform var(--t-slow);
    }
    .explore__tile:hover img { transform: scale(1.04); }
    .explore__veil {
      position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(180deg, var(--scrim-0) 45%, var(--scrim-strong) 100%);
    }
    .explore__label {
      position: absolute; left: var(--space-4); bottom: var(--space-4); z-index: 1;
      font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 2.2rem);
      /* fixed light — sits on a dark category photo, so white in every theme. */
      color: var(--brand-bone); text-shadow: 0 2px 18px var(--scrim-strong), 0 0 2px rgba(0,0,0,0.6);
    }
    @media (max-width: 600px) {
      /* MOBILE = the SAME live marquee as desktop (Ocin 2026-07-13: "la banda no
         se mueve, y la de colección no está").

         An earlier patch here turned both bands into a static swipe row
         (`animation: none` + hiding the aria-hidden duplicates). It killed the
         motion, and it left the COLLECTION band — which runs in reverse — with a
         half-empty / invisible row, because the reverse loop leans on the
         duplicated set to have anything under the viewport at rest. That patch was
         chasing "cut / empty" tiles whose real cause was a horizontal DOCUMENT
         overflow (`repeat(N, 1fr)` grids, since fixed with `minmax(0, 1fr)` in
         FeaturedShowcase + jbar) — not the marquee. So the patch is gone.

         The marquee keeps `overflow: hidden` from the base rule → it clips its own
         track and can never push the page sideways. MarqueeDrag bails on <=600px,
         so mobile is driven by the pure-CSS `explore-scroll` keyframe. Sizing only
         below. */
      /* Gap as MARGIN, not flex `gap`: the keyframe shifts the track -50%, and with
         a flex gap that lands half-a-gap short of one full copy → a visible jump
         each loop. With the gap baked into each tile's box, 50% of the track is
         EXACTLY one copy → seamless. (Desktop is JS-measured, so it doesn't care.) */
      .explore__track { gap: 0; }
      .explore__tile {
        flex-basis: clamp(150px, 52vw, 210px);
        aspect-ratio: 3 / 4;
        margin-right: var(--space-2);
      }
      .explore__marquee--rev .explore__tile {
        flex-basis: clamp(240px, 78vw, 330px);
        aspect-ratio: 16 / 9;
      }
      .explore__collection-grid {
        grid-template-columns: 1fr;
        gap: var(--space-3);
      }
      .explore__tile--collection {
        flex-basis: auto;
        width: 100%;
      }
    }
    @media (min-width: 601px) and (max-width: 980px) {
      .explore__collection-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>

