---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import EmbossedSeal from '../components/EmbossedSeal.astro';
import CategoryStrip from '../components/CategoryStrip.astro';
import CardinalGrid from '../components/CardinalGrid.astro';
import Newsletter from '../components/Newsletter.astro';
import PatternBand from '../components/PatternBand.astro';
import { getProducts } from '../lib/woo';
import en from '../i18n/en.json';
import map from '../i18n/mapudungun.json';

const products = await getProducts(50);

// Featured surface should never show "NO IMAGE" placeholders to first-time
// visitors — filter products with no main image before slicing.
const withImage = products.filter(p => p.images.length > 0 && p.images[0].src);

function deriveBadge(p: typeof products[number], idx: number): string | null {
  const q = p.stock_quantity;
  if (typeof q === 'number' && q > 0 && q <= 3) return 'LIMITED';
  if (idx < 2) return 'NEW';
  return null;
}

const featured = withImage.slice(0, 6).map((p, i) => ({
  product: p,
  badge: deriveBadge(p, i),
}));

const featuredCount = featured.length;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Wenu Mapu',
  url: 'https://wenumapuonline.com',
  logo: 'https://wenumapuonline.com/logos/wenu-mapu-square.png',
  description: 'Ancestral-cosmic body jewelry forged by hand in Truckee, California. Implant-grade titanium, sterling silver, 14k gold.',
  email: 'marimari@wenumapuonline.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Truckee',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  sameAs: [
    'https://instagram.com/wenu__mapu',
    'https://tiktok.com/@wenumapu',
    'https://pinterest.com/wenumapu',
  ],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Wenu Mapu',
  url: 'https://wenumapuonline.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://wenumapuonline.com/shop?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<Base
  title="Wenu Mapu — Adornment for the sacred body"
  description="Ancestral-cosmic body jewelry forged by hand in Truckee, California. Implant-grade titanium, sterling silver, 14k gold. Custom commissions accepted."
  jsonLd={[orgLd, websiteLd]}
  preloadImage={{
    avif: '/img/hero/hero-portrait-1200w.avif',
    webp: '/img/hero/hero-portrait-1200w.webp',
    alt: 'Model wearing Wenu Mapu ritual body jewelry',
  }}
>

  <!-- ── HERO V2 — RITUAL PORTRAIT ── -->
  <section class="hero-v2" aria-label="Wenu Mapu — adornment for the sacred body">
    <div class="hero-v2__copy">
      <div class="hero-v2__mark" aria-hidden="true">
        <span class="sacred-mark" style="width:18px;height:18px;"></span>
      </div>
      <h1 class="hero-v2__headline">{en.hero.headline}</h1>
      <p class="hero-v2__sub">{en.hero.sub_short}</p>
      <div class="hero-v2__cta">
        <a href="/shop" class="btn btn--solid">{en.hero.cta_primary} <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-v2__coords" aria-hidden="true">
        <span>39°19′N · 120°11′W</span>
        <span class="hero-v2__coord-sep"></span>
        <span>{en.hero.eyebrow}</span>
      </div>
    </div>
    <div class="hero-v2__media">
      <picture>
        <source
          type="image/avif"
          srcset="/img/hero/hero-portrait-600w.avif 600w, /img/hero/hero-portrait-900w.avif 900w, /img/hero/hero-portrait-1200w.avif 1200w, /img/hero/hero-portrait-1800w.avif 1800w"
          sizes="(max-width: 900px) 100vw, 50vw"
        />
        <source
          type="image/webp"
          srcset="/img/hero/hero-portrait-600w.webp 600w, /img/hero/hero-portrait-900w.webp 900w, /img/hero/hero-portrait-1200w.webp 1200w, /img/hero/hero-portrait-1800w.webp 1800w"
          sizes="(max-width: 900px) 100vw, 50vw"
        />
        <img
          src="/img/hero/hero-portrait-1200w.webp"
          srcset="/img/hero/hero-portrait-600w.webp 600w, /img/hero/hero-portrait-900w.webp 900w, /img/hero/hero-portrait-1200w.webp 1200w, /img/hero/hero-portrait-1800w.webp 1800w"
          sizes="(max-width: 900px) 100vw, 50vw"
          alt="Model wearing Wenu Mapu ritual body jewelry"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          width="1200"
          height="1500"
        />
      </picture>
      <div class="hero-v2__media-veil" aria-hidden="true"></div>
      <div class="hero-v2__media-seal" aria-hidden="true">
        <EmbossedSeal text="WENU · MAPU · TRUCKEE · 2026" size={120} />
      </div>
    </div>
  </section>

  <!-- ── CATEGORY STRIP ── -->
  <CategoryStrip />

  <!-- ── PATTERN DIVIDER ── -->
  <div class="section-divider">
    <PatternBand variant="hairline" tone="bronze" />
  </div>

  <!-- ── FEATURED PIECES ── -->
  {featured.length > 0 && (
    <section class="featured-v2" aria-labelledby="featured-title">
      <div class="container featured-v2__head">
        <div>
          <p class="eyebrow">{en.featured.eyebrow}</p>
          <h2 id="featured-title" class="featured-v2__title">{en.featured.title}</h2>
        </div>
        <a href="/shop" class="btn btn--ghost featured-v2__link">{en.featured.view_all} →</a>
      </div>
      <div class="featured-v2__rail" data-rail data-fade-in-stagger>
        {featured.map(({ product, badge }) => (
          <div class="featured-v2__cell">
            <ProductCard product={product} badge={badge} />
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ── SACRED TERRITORY + CARDINALS ── -->
  <section class="sacred" aria-labelledby="sacred-title">
    <div class="sacred__inner">
      <div class="sacred__copy">
        <p class="eyebrow">{en.sacred.eyebrow}</p>
        <h2 id="sacred-title" class="sacred__title">{en.sacred.title}</h2>
        <p class="sacred__p">{en.sacred.p1}</p>
        <p class="sacred__p">{en.sacred.p2}</p>
        <p class="sacred__p sacred__p--accent">{en.sacred.p3}</p>
      </div>
      <CardinalGrid />
    </div>
  </section>

  <!-- ── PATTERN DIVIDER 2 ── -->
  <div class="section-divider">
    <PatternBand variant="hairline" tone="bronze" />
  </div>

  <!-- ── TRUCKEE SHOWCASE ── -->
  <section class="truckee" aria-labelledby="truckee-title">
    <div class="truckee__media">
      <picture>
        <source srcset="/img/truckee/showcase.avif" type="image/avif" />
        <img src="/img/truckee/showcase.webp" alt="Truckee landscape — Sierra Nevada" loading="lazy" decoding="async" />
      </picture>
      <div class="truckee__media-veil" aria-hidden="true"></div>
    </div>
    <div class="truckee__copy">
      <p class="eyebrow">{en.showcase.eyebrow}</p>
      <h2 id="truckee-title" class="truckee__title">{en.showcase.title}</h2>
      <p class="truckee__body">{en.showcase.body}</p>
      <a href="/local" class="btn btn--solid truckee__cta">{en.showcase.cta} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- ── COMMISSIONS TEASER ── -->
  <section class="commissions-teaser" aria-labelledby="commissions-teaser-title">
    <div class="commissions-teaser__inner">
      <div class="commissions-teaser__copy">
        <p class="eyebrow">{en.custom.teaser.eyebrow}</p>
        <h2 id="commissions-teaser-title" class="commissions-teaser__title">{en.custom.teaser.title}</h2>
        <p class="commissions-teaser__body">{en.custom.teaser.body}</p>
        <a href="/custom-orders" class="btn btn--solid commissions-teaser__cta">{en.custom.teaser.cta} →</a>
      </div>
      <div class="commissions-teaser__media" aria-hidden="true">
        <picture>
          <source srcset="/img/products/ritual-ring-950.avif" type="image/avif" />
          <img src="/img/products/ritual-ring-950.webp" alt="" loading="lazy" decoding="async" />
        </picture>
        <span class="commissions-teaser__media-veil"></span>
      </div>
    </div>
  </section>

  <!-- ── USPS GRID ── -->
  <section class="usps" aria-label="Why Wenu Mapu">
    <div class="usps__inner" data-fade-in-stagger>
      {[
        { ...en.values.titanium,  glyph: 'titanium' },
        { ...en.values.materials, glyph: 'materials' },
        { ...en.values.design,    glyph: 'design' },
        { ...en.values.quality,   glyph: 'quality' },
      ].map(item => (
        <div class="usps__item">
          <span class="usps__glyph" aria-hidden="true">
            {item.glyph === 'titanium' && (
              <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="16" r="9"/>
                <path d="M16 7 L16 25 M7 16 L25 16"/>
                <circle cx="16" cy="16" r="2.2" fill="currentColor"/>
              </svg>
            )}
            {item.glyph === 'materials' && (
              <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4 L26 12 L22 26 L10 26 L6 12 Z"/>
                <path d="M16 4 L16 26 M6 12 L26 12"/>
              </svg>
            )}
            {item.glyph === 'design' && (
              <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4 L28 16 L16 28 L4 16 Z"/>
                <path d="M16 10 L22 16 L16 22 L10 16 Z"/>
                <circle cx="16" cy="16" r="1.5" fill="currentColor"/>
              </svg>
            )}
            {item.glyph === 'quality' && (
              <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="16" r="11"/>
                <circle cx="16" cy="16" r="6"/>
                <path d="M16 5 L16 27 M5 16 L27 16" opacity="0.5"/>
              </svg>
            )}
          </span>
          <h3 class="usps__title">{item.title}</h3>
          <p class="usps__body">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── PATTERN DIVIDER 3 ── -->
  <div class="section-divider">
    <PatternBand variant="hairline" tone="bronze" />
  </div>

  <!-- ── NEWSLETTER ── -->
  <Newsletter />

</Base>
