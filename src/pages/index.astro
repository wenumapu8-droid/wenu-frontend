---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryStrip from '../components/CategoryStrip.astro';
import Newsletter from '../components/Newsletter.astro';
import PatternBand from '../components/PatternBand.astro';
import PowerAnimalsOracle from '../components/PowerAnimalsOracle.astro';
import ManifestoKultrunSection from '../components/ManifestoKultrunSection.astro';
// PrefooterQuote moved to /canon (academic source page) — per Ocin 2026-06-07.
import HeroCarousel from '../components/HeroCarousel.astro';
import CosmicLinesRail from '../components/CosmicLinesRail.astro';
import { getProducts } from '../lib/woo';
import { collections } from '../data/collections';
import en from '../i18n/en.json';

const products = await getProducts();

// Home "Portals" showcase — surface the strongest collections by real catalog
// depth (NocoDB counts: origin 69, neo 27, organic 24, ornamental 11,
// india 10, atacama 7). The thin lines (araucanía/maya, 1 each) are kept off
// the home grid but remain reachable at /collection. Banners carry their own
// baked title art, so the cards render the artwork frame-only (no HTML title).
const HOME_COLLECTION_ORDER = ['origin', 'neo', 'organic', 'ornamental', 'india', 'atacama'];
const homeCollections = HOME_COLLECTION_ORDER
  .map(slug => collections.find(c => c.slug === slug))
  .filter((c): c is (typeof collections)[number] => Boolean(c));

// Power-animal poster series (maestro "animales de poder"). Baked-text brand
// posters — displayed whole as a guardian gallery, museum-label captions below.
const POWER_ANIMALS = ['puma', 'condor', 'serpiente', 'zorro', 'ballena', 'pudu'] as const;

// Featured surface should never show "NO IMAGE" placeholders to first-time
// visitors — filter products with no main image before slicing.
const withImage = products.filter(p => p.images.length > 0 && p.images[0].src);

// Also exclude products whose primary image is a known placeholder
// (AI-generated mockups from the legacy import, untitled exports, etc.).
// Real product macros live under /wp-content/uploads/.../wm-<sku>-... or
// any non-placeholder slug. This keeps the Featured rail consistent with
// the brand's macro photography standard.
const PLACEHOLDER_IMG = /chatgpt-image|sin-?titulo|sin-?t[íi]tulo|placeholder|untitled/i;
const curated = withImage.filter(p => !PLACEHOLDER_IMG.test(p.images[0].src));
const FEATURED_SLUGS = [
  'drop-con-amatista-2',
  'carved-ethnic-ring',
  'gold-titanium-marquise-onyx-piercing',
  'ornamental-wood-ear-weights',
];
const WEAK_CATEGORY = /uncategorized/i;

function hasWeakCategory(p: typeof products[number]) {
  return p.categories.some(c => WEAK_CATEGORY.test(c.slug) || WEAK_CATEGORY.test(c.name));
}

function deriveBadge(p: typeof products[number], idx: number): string | null {
  const q = p.stock_quantity;
  if (typeof q === 'number' && q > 0 && q <= 3) return 'LIMITED';
  if (idx < 2) return 'NEW';
  return null;
}

const curatedStrong = curated.filter(p => !hasWeakCategory(p));
const preferredFeatured = FEATURED_SLUGS
  .map(slug => curatedStrong.find(p => p.slug === slug))
  .filter((p): p is typeof products[number] => Boolean(p));
const featuredSource = preferredFeatured.length >= 4 ? preferredFeatured : curatedStrong.slice(0, 4);
const featured = featuredSource.slice(0, 4).map((p, i) => ({
  product: p,
  badge: deriveBadge(p, i),
}));

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://wenumapuonline.com/#organization',
  name: 'Wenu Mapu',
  url: 'https://wenumapuonline.com',
  logo: 'https://wenumapuonline.com/logos/wenu-mapu-square.png',
  description: 'Ancestral-cosmic body jewelry forged by hand in Truckee, California. Implant-grade titanium, sterling silver, 14k gold.',
  email: 'marimari@wenumapuonline.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Truckee',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  founder: {
    '@id': 'https://wenumapuonline.com/#person-nicolas-ortega',
  },
  sameAs: [
    'https://instagram.com/wenu__mapu',
    'https://tiktok.com/@wenumapu',
    'https://pinterest.com/wenumapu',
    'https://www.behance.net/wenumapu',
  ],
};

// Person schema — connects Nicolás Ortega across platforms (Google identity graph).
// sameAs is the authoritative signal for entity resolution.
// hasCredential is the SEO signal that gets him recognized as a certified piercer
// in Google Knowledge Panel (canonical source: Obsidian credenciales-y-cv.md).
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://wenumapuonline.com/#person-nicolas-ortega',
  name: 'Rodrigo Nicolás Ortega García',
  givenName: 'Rodrigo Nicolás',
  familyName: 'Ortega García',
  alternateName: ['Nicolás Ortega', 'Ocin', 'Nico'],
  jobTitle: 'Designer · Founder · Professional Piercer',
  worksFor: { '@id': 'https://wenumapuonline.com/#organization' },
  url: 'https://wenumapuonline.com/about',
  sameAs: [
    'https://www.linkedin.com/in/nicolas-ortega-790538279/',
    'https://www.behance.net/wenumapu',
    'https://www.instagram.com/0cin8/',
    'https://www.instagram.com/wenu__mapu/',
    'https://www.tiktok.com/@wenumapu',
  ],
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'APP Core Essentials Vol. 4',
      credentialCategory: 'certificate',
      recognizedBy: { '@type': 'Organization', name: 'Association of Professional Piercers' },
      dateCreated: '2025-12',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Bloodborne Pathogens Certification (OSHA-compliant)',
      credentialCategory: 'certificate',
      recognizedBy: { '@type': 'Organization', name: 'American Heart Association' },
      validFrom: '2023-01-01',
      expires: '2027-12-31',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'First Aid · CPR · AED',
      credentialCategory: 'certificate',
      recognizedBy: { '@type': 'Organization', name: 'American Heart Association' },
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Continuing Education · Professional Piercers Collective',
      credentialCategory: 'certificate',
      recognizedBy: { '@type': 'Organization', name: 'Professional Piercers Collective' },
      dateCreated: '2025-11',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Industrial Design',
      credentialCategory: 'degree',
      recognizedBy: { '@type': 'CollegeOrUniversity', name: 'Duoc UC', address: { '@type': 'PostalAddress', addressLocality: 'Santiago', addressCountry: 'CL' } },
      dateCreated: '2020-08',
    },
  ],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Wenu Mapu',
  url: 'https://wenumapuonline.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://wenumapuonline.com/shop?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

// HERO 2026-06-03: rediseñado al lenguaje visual de la tapa del libro Wenumapu
// (spec brand/02-visual-system/spec-hero-rediseno-tapa-libro.md). El rotator
// anterior (4 banners full-bleed) queda archivado en git history. El kultrún
// ornamentado se mantiene como momento editorial profundo más abajo en
// ManifestoKultrunSection.
---

<Base
  title="Wenu Mapu — Adornment for the sacred body"
  description="Ancestral-cosmic body jewelry forged by hand in Truckee, California. Implant-grade titanium, sterling silver, 14k gold. Custom commissions accepted."
  jsonLd={[orgLd, personLd, websiteLd]}
>

  <!-- ── HERO — carrusel rotativo (cosmos · cuerpo · paisajes · pieza) ── -->
  <div class="hero-with-portal-seal">
    <HeroCarousel ctaHref="/shop" ctaLabel="Enter the shop" />
    <!-- Spinning seal in the bottom-right of the hero. Text rotates around;
         the mandala in the centre spins on its own axis. Click → /experience/. -->
    <a href="/experience/" class="portal-seal" aria-label="Enter the cosmic dimensional portal" title="Enter the dimensional portal — a map of Mapuche cosmovision">
      <svg class="portal-seal__text" viewBox="0 0 200 200" aria-hidden="true">
        <defs>
          <path id="portal-seal-textpath" d="M 100,100 m -84,0 a 84,84 0 1,1 168,0 a 84,84 0 1,1 -168,0" fill="none"/>
        </defs>
        <circle cx="100" cy="100" r="92" fill="none" stroke="rgba(245,234,216,0.5)" stroke-width="0.7"/>
        <circle cx="100" cy="100" r="68" fill="none" stroke="rgba(245,234,216,0.25)" stroke-width="0.4"/>
        <text font-size="9.5" letter-spacing="3.5" fill="rgba(245,234,216,0.92)" style="font-family: var(--font-sans, 'Instrument Sans', sans-serif);">
          <textPath href="#portal-seal-textpath" startOffset="0%">WENU · MAPU · COSMIC PORTAL · ENTER · WENU · MAPU · COSMIC PORTAL · ENTER · </textPath>
        </text>
      </svg>
      <img class="portal-seal__mandala" src="/img/portal-mandala-white.png" alt="" loading="lazy" decoding="async"/>
    </a>
  </div>
  <style>
    .hero-with-portal-seal { position: relative; }
    .portal-seal {
      position: absolute;
      right: clamp(20px, 4vw, 56px);
      bottom: clamp(20px, 4vw, 56px);
      z-index: 4;
      display: block;
      width: clamp(96px, 11vw, 140px);
      height: clamp(96px, 11vw, 140px);
      text-decoration: none;
      color: inherit;
      cursor: pointer;
      transition: filter 0.5s ease, transform 0.5s ease;
    }
    .portal-seal__text {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      animation: portal-seal-text-spin 28s linear infinite;
      pointer-events: none;
    }
    .portal-seal__mandala {
      position: absolute;
      top: 50%; left: 50%;
      width: 56%;
      height: 56%;
      object-fit: contain;
      transform: translate(-50%, -50%);
      animation: portal-seal-mandala-spin 50s linear infinite, portal-seal-glow 4.5s ease-in-out infinite;
      pointer-events: none;
    }
    .portal-seal:hover { filter: brightness(1.12); transform: scale(1.04); }
    .portal-seal:hover .portal-seal__text { animation-duration: 12s; }
    .portal-seal:hover .portal-seal__mandala { animation-duration: 16s, 1.6s; }
    .portal-seal:focus-visible {
      outline: 1px solid rgba(245,234,216,0.6);
      outline-offset: 8px;
      border-radius: 50%;
    }
    @keyframes portal-seal-text-spin   { from { transform: rotate(0deg);                            } to { transform: rotate(360deg);                            } }
    @keyframes portal-seal-mandala-spin { from { transform: translate(-50%, -50%) rotate(0deg);   } to { transform: translate(-50%, -50%) rotate(360deg);   } }
    @keyframes portal-seal-glow {
      0%, 100% { filter: drop-shadow(0 0 6px rgba(255,255,255,0.4))  drop-shadow(0 0 12px rgba(255,255,255,0.15)); }
      50%      { filter: drop-shadow(0 0 14px rgba(255,255,255,0.85)) drop-shadow(0 0 28px rgba(255,255,255,0.32)) drop-shadow(0 0 50px rgba(240,192,96,0.10)); }
    }
    /* Mobile: smaller + keep visible but less prominent */
    @media (max-width: 720px) {
      .portal-seal { width: 84px; height: 84px; right: 14px; bottom: 14px; }
    }
    /* Honour OS reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .portal-seal__text,
      .portal-seal__mandala,
      .portal-seal:hover .portal-seal__text,
      .portal-seal:hover .portal-seal__mandala { animation: none !important; }
    }
  </style>

  <!-- ── COSMIC LINES RAIL — 6 arquetipos cosmológicos del libro ── -->
  <CosmicLinesRail />

  <!-- ── PROOF BEAT ── verified operational facts only -->
  <section class="proof" aria-label="Trust signals">
    <div class="proof__inner">
      <span class="eyebrow proof__lead">DIRECT · APPOINTMENT · DISPATCH</span>
      <ul class="proof__list" role="list">
        <li>Handmade in Truckee · California</li>
        <li>Private appointments · Truckee / North Lake Tahoe</li>
        <li>Free local delivery · Truckee area</li>
        <li>USPS Priority across the US</li>
      </ul>
      <span class="proof__cite">— direct retail only. No showroom. No middleman.</span>
    </div>
  </section>

  <!-- ── CATEGORY STRIP ── -->
  <CategoryStrip />

  <!-- ── PATTERN DIVIDER ── -->
  <div class="section-divider">
    <PatternBand variant="hairline" tone="bronze" />
  </div>

  <!-- ── FEATURED PIECES ── -->
  {featured.length > 0 && (
    <section class="featured-v2" aria-labelledby="featured-title">
      <div class="container featured-v2__head">
        <div>
          <p class="eyebrow">{en.featured.eyebrow}</p>
          <h2 id="featured-title" class="featured-v2__title">{en.featured.title}</h2>
        </div>
        <a href="/shop" class="btn btn--ghost featured-v2__link">{en.featured.view_all} →</a>
      </div>
      <div class="featured-v2__rail" data-rail data-fade-in-stagger>
        {featured.map(({ product, badge }) => (
          <div class="featured-v2__cell">
            <ProductCard product={product} badge={badge} />
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ── ANCESTRAL MANIFESTO + KULTRÚN ── kultrún sacred map as visual center
       (after Featured pieces: producto primero, manifiesto como momento editorial). -->
  <ManifestoKultrunSection />

  {/* Sonia Montecino academic quote was here — moved to /canon (academic source page)
      on 2026-06-07 per Ocin. Lives there alongside book context, ISBN, voices list. */}

  <!-- ── PORTALS / COLLECTIONS SHOWCASE ── -->
  <section class="portals" aria-labelledby="portals-title">
    <div class="container portals__head">
      <p class="eyebrow">PORTALS · COLLECTIONS</p>
      <h2 id="portals-title" class="portals__title">Enter a portal.</h2>
      <p class="portals__lede" lang="arn" title="Wenu Mapu — the world above">Each collection is a doorway — a landscape, a sky, a lineage. Step through and the pieces gather around you.</p>
    </div>
    <div class="container portals__grid" data-fade-in-stagger>
      {homeCollections.map(c => (
        <a href={`/collection/${c.slug}`} class="portal-card" aria-label={`${c.title} collection`}>
          <picture>
            <source type="image/avif" srcset={`/img/banners/collection/${c.slug}.avif`} />
            <img
              src={`/img/banners/collection/${c.slug}.webp`}
              alt={`Wenu Mapu — ${c.title} collection`}
              loading="lazy"
              decoding="async"
              width="1600"
              height="900"
            />
          </picture>
          <span class="portal-card__frame" aria-hidden="true"></span>
          <span class="portal-card__enter" aria-hidden="true">Enter <span class="portal-card__arrow">→</span></span>
        </a>
      ))}
    </div>
    <div class="container portals__foot">
      <a href="/collection" class="btn btn--ghost">All collections <span aria-hidden="true">→</span></a>
    </div>
  </section>

  {/*
    EDITORIAL BAND — 2026-05-22 reactivada con foto macro real WM-HAN-001 Witral Vilu.
    Reemplaza el asset AI archivado en ~/Obsidian/WenuAgent/90-Archivo/lifestyle-AI-2026-05-22/.
    Cumple BRAND-DNA D8: foto real propia, tier-1 macro curada.
  */}
  <section class="editorial-band" aria-label="Wenu Mapu — Witral Vilu, paired bronze serpents">
    <picture>
      <source
        type="image/avif"
        srcset="/img/hero/wm-han-001-medium.avif 1600w, /img/hero/wm-han-001-large.avif 2400w, /img/hero/wm-han-001-xlarge.avif 3200w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/img/hero/wm-han-001-medium.webp 1600w, /img/hero/wm-han-001-large.webp 2400w, /img/hero/wm-han-001-xlarge.webp 3200w"
        sizes="100vw"
      />
      <img
        src="/img/hero/wm-han-001-large.webp"
        alt="Witral Vilu — two paired bronze serpent ear weights, hand-cast, on midnight blue ground"
        loading="lazy"
        decoding="async"
        width="2400"
        height="1590"
      />
    </picture>
    <div class="editorial-band__veil" aria-hidden="true"></div>
    <p class="editorial-band__caption eyebrow">Witral Vilu · Paired Serpents · Bronze</p>
  </section>

  {/* 2026-05-29: ManifestoKultrunSection movido más arriba (entre Featured y Portals),
      Oracle bajado a justo antes de USPS (después de Commissions) — per UX audit:
      ver Obsidian: 30-Auditorias/2026-05-29-ux-audit-jerarquia-comercial.md */}

  <!-- ── COSMIC THRESHOLD ── full-bleed sidereal portal between guardians + studio -->
  <section class="threshold" aria-label="Wenu Mapu — the world above">
    <picture>
      <source
        type="image/avif"
        srcset="/img/banners/cosmic/threshold-mandala-900w.avif 900w, /img/banners/cosmic/threshold-mandala-1200w.avif 1200w, /img/banners/cosmic/threshold-mandala-1600w.avif 1600w, /img/banners/cosmic/threshold-mandala-1920w.avif 1920w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/img/banners/cosmic/threshold-mandala-900w.webp 900w, /img/banners/cosmic/threshold-mandala-1200w.webp 1200w, /img/banners/cosmic/threshold-mandala-1600w.webp 1600w, /img/banners/cosmic/threshold-mandala-1920w.webp 1920w"
        sizes="100vw"
      />
      <img
        src="/img/banners/cosmic/threshold-mandala-1600w.webp"
        alt=""
        loading="lazy"
        decoding="async"
        width="1672"
        height="941"
      />
    </picture>
    <div class="threshold__veil" aria-hidden="true"></div>
    <div class="container threshold__copy">
      <p class="threshold__arn eyebrow" lang="arn">{en.threshold.arn}</p>
      <p class="threshold__title">{en.threshold.title}</p>
      <p class="threshold__line">{en.threshold.line}</p>
    </div>
  </section>

  <!-- ── TRUCKEE SHOWCASE ── -->
  <section class="truckee" aria-labelledby="truckee-title">
    <div class="truckee__media">
      <picture>
        <source srcset="/img/truckee/showcase.avif" type="image/avif" />
        <img src="/img/truckee/showcase.webp" alt="Truckee landscape — Sierra Nevada" width="1200" height="384" loading="lazy" decoding="async" />
      </picture>
      <div class="truckee__media-veil" aria-hidden="true"></div>
    </div>
    <div class="truckee__copy">
      <p class="eyebrow">{en.showcase.eyebrow}</p>
      <h2 id="truckee-title" class="truckee__title">{en.showcase.title}</h2>
      <p class="truckee__body">{en.showcase.body}</p>
      <a href="/local" class="btn btn--ghost truckee__cta">{en.showcase.cta} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- ── COMMISSIONS TEASER ── -->
  <section class="commissions-teaser" aria-labelledby="commissions-teaser-title">
    <div class="commissions-teaser__inner">
      <div class="commissions-teaser__copy">
        <p class="eyebrow">{en.custom.teaser.eyebrow}</p>
        <h2 id="commissions-teaser-title" class="commissions-teaser__title">{en.custom.teaser.title}</h2>
        <p class="commissions-teaser__body">{en.custom.teaser.body}</p>
        <a href="/custom-orders" class="btn btn--ghost commissions-teaser__cta">{en.custom.teaser.cta} →</a>
      </div>
      <div class="commissions-teaser__media" aria-hidden="true">
        <picture>
          <source srcset="/img/products/ritual-ring-950.avif" type="image/avif" />
          <img src="/img/products/ritual-ring-950.webp" alt="" width="950" height="950" loading="lazy" decoding="async" />
        </picture>
        <span class="commissions-teaser__media-veil"></span>
      </div>
    </div>
  </section>

  <!-- ── POWER ANIMALS / ANIMALES DE PODER ── interactive oracle
       (después de Commissions: engagement + recomendación de pieza, no roba protagonismo al producto). -->
  <PowerAnimalsOracle />

  <!-- ── USPS GRID ── -->
  <section class="usps" aria-label="Why Wenu Mapu">
    <div class="usps__inner" data-fade-in-stagger>
      {[
        { ...en.values.noble,  glyph: 'titanium' },
        { ...en.values.craft,  glyph: 'materials' },
        { ...en.values.ship,   glyph: 'design' },
        { ...en.values.pickup, glyph: 'quality' },
      ].map(item => (
        <div class="usps__item">
          <span class="usps__glyph" aria-hidden="true">
            {item.glyph === 'titanium' && (
              <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="16" r="9"/>
                <path d="M16 7 L16 25 M7 16 L25 16"/>
                <circle cx="16" cy="16" r="2.2" fill="currentColor"/>
              </svg>
            )}
            {item.glyph === 'materials' && (
              <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4 L26 12 L22 26 L10 26 L6 12 Z"/>
                <path d="M16 4 L16 26 M6 12 L26 12"/>
              </svg>
            )}
            {item.glyph === 'design' && (
              <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4 L28 16 L16 28 L4 16 Z"/>
                <path d="M16 10 L22 16 L16 22 L10 16 Z"/>
                <circle cx="16" cy="16" r="1.5" fill="currentColor"/>
              </svg>
            )}
            {item.glyph === 'quality' && (
              <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="16" r="11"/>
                <circle cx="16" cy="16" r="6"/>
                <path d="M16 5 L16 27 M5 16 L27 16" opacity="0.5"/>
              </svg>
            )}
          </span>
          <h3 class="usps__title">{item.title}</h3>
          <p class="usps__body">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── PATTERN DIVIDER 3 ── -->
  <div class="section-divider">
    <PatternBand variant="hairline" tone="bronze" />
  </div>

  <!-- ── NEWSLETTER ── -->
  <Newsletter />

</Base>

