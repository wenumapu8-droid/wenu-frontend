---
import Base from '../layouts/Base.astro';
import EmbossedSeal from '../components/EmbossedSeal.astro';
import en from '../i18n/en.json';
import map from '../i18n/mapudungun.json';
---

<Base
  title="Contact — Wenu Mapu"
  description="Contact Wenu Mapu. Email, Instagram, WhatsApp. We respond within 48 business hours."
>
  <section class="section">
    <div class="container">
      <div class="grid-asym-2">
        <div>
          <p class="eyebrow">{en.contact.eyebrow}</p>
          <h1 style="margin: var(--space-3) 0;">{en.contact.title}</h1>
          <div class="divider-h"></div>
          <p class="italic text-soft" style="margin-bottom: var(--space-5);">
            {en.contact.intro}
          </p>
          <p class="text-accent italic">{map.phrases.the_path}</p>
          <div style="color: var(--accent); margin-top: var(--space-5);">
            <EmbossedSeal text="RÜPÜ · CONNECT · 2026" size={140} />
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0; border-top: var(--border-thin);">
          <div style="border-bottom: var(--border-thin); padding: var(--space-4) 0;">
            <p class="eyebrow text-accent" style="margin-bottom: var(--space-2);">{en.contact.email.label}</p>
            <a href="mailto:contact@wenumapuonline.com" class="display" style="font-size: 1.4rem;">contact@wenumapuonline.com</a>
            <p class="text-soft" style="font-size: var(--fs-small); margin-top: var(--space-2);">{en.contact.email.body}</p>
          </div>
          <div style="border-bottom: var(--border-thin); padding: var(--space-4) 0;">
            <p class="eyebrow text-accent" style="margin-bottom: var(--space-2);">{en.contact.instagram.label}</p>
            <a href="https://instagram.com/wenu__mapu" target="_blank" rel="noopener" class="display" style="font-size: 1.4rem;">@wenu__mapu</a>
            <p class="text-soft" style="font-size: var(--fs-small); margin-top: var(--space-2);">{en.contact.instagram.body}</p>
          </div>
          <div style="border-bottom: var(--border-thin); padding: var(--space-4) 0;">
            <p class="eyebrow text-accent" style="margin-bottom: var(--space-2);">{en.contact.whatsapp.label}</p>
            <p class="display" style="font-size: 1.4rem;">{en.contact.whatsapp.value}</p>
            <p class="text-soft" style="font-size: var(--fs-small); margin-top: var(--space-2);">{en.contact.whatsapp.body}</p>
          </div>
          <div style="border-bottom: var(--border-thin); padding: var(--space-4) 0;">
            <p class="eyebrow text-accent" style="margin-bottom: var(--space-2);">{en.contact.store.label}</p>
            <a href="https://www.wenumapuonline.com" target="_blank" rel="noopener" class="display" style="font-size: 1.4rem;">wenumapuonline.com</a>
            <p class="text-soft" style="font-size: var(--fs-small); margin-top: var(--space-2);">{en.contact.store.body}</p>
          </div>
          <div style="display: flex; gap: var(--space-3); flex-wrap: wrap; padding-top: var(--space-4);">
            <a href="/shop" class="btn">See catalogue</a>
            <a href="/local" class="btn">Pickup info</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
