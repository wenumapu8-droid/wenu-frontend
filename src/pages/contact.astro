---
import Base from '../layouts/Base.astro';
import EmbossedSeal from '../components/EmbossedSeal.astro';
import en from '../i18n/en.json';
import map from '../i18n/mapudungun.json';
import { STORE_BASE_URL } from '../lib/config';

const channels = [
  {
    label: en.contact.email.label,
    value: en.contact.email.value,
    href: `mailto:${en.contact.email.value}`,
    body: en.contact.email.body,
    glyph: 'mail',
  },
  {
    label: en.contact.phone.label,
    value: en.contact.phone.value,
    href: 'tel:+14085006211',
    body: en.contact.phone.body,
    glyph: 'phone',
  },
  {
    label: en.contact.instagram.label,
    value: en.contact.instagram.value,
    href: 'https://instagram.com/wenu__mapu',
    external: true,
    body: en.contact.instagram.body,
    glyph: 'ig',
  },
  {
    label: en.contact.store.label,
    value: en.contact.store.value,
    href: STORE_BASE_URL,
    external: true,
    body: en.contact.store.body,
    glyph: 'store',
  },
];

// LocalBusiness JSON-LD — drives Google Local Pack for "Truckee jewelry,"
// "Tahoe body jewelry," etc. NO street address (appointment locations are
// private; only published after booking). Service area lists city scope.
const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'Jeweler',
  name: 'Wenu Mapu',
  url: 'https://wenumapuonline.com',
  email: 'marimari@wenumapuonline.com',
  telephone: '+1-408-500-6211',
  image: 'https://wenumapuonline.com/img/hero/hero-portrait-1200w.webp',
  description: "Hand-forged ritual body jewelry from Truckee, California. Implant-grade titanium, sterling silver, 14k gold, Atacama meteorite. Private appointments and free local delivery in the Truckee / North Lake Tahoe area.",
  areaServed: [
    { '@type': 'City', name: 'Truckee', addressRegion: 'CA', addressCountry: 'US' },
    { '@type': 'City', name: 'Kings Beach', addressRegion: 'CA', addressCountry: 'US' },
    { '@type': 'City', name: 'Tahoe Vista', addressRegion: 'CA', addressCountry: 'US' },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Truckee',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  sameAs: [
    'https://instagram.com/wenu__mapu',
    'https://tiktok.com/@wenumapu',
    'https://pinterest.com/wenumapu',
    'https://www.behance.net/wenumapu',
  ],
};
---
<Base
  title="Contact — Wenu Mapu"
  description="Reach Wenu Mapu by email, phone, Instagram, or the online store. We respond within 48 business hours."
  jsonLd={localBusinessLd}
>
  <section class="section section--mega contact-page">
    <div class="container contact-page__inner">
      <header class="contact-page__head">
        <p class="eyebrow">{en.contact.eyebrow}</p>
        <h1 class="page-title">{en.contact.title}</h1>
        <p class="lede">{en.contact.intro}</p>
        <p class="contact-page__ritual">{map.phrases.the_path}</p>
        <div class="contact-page__seal" aria-hidden="true">
          <EmbossedSeal text="RÜPÜ · CONNECT · 2026" size={140} />
        </div>
      </header>

      <ul class="contact-channels">
        {channels.map(c => (
          <li class="contact-channels__row">
            <span class="contact-channels__glyph" aria-hidden="true">
              {c.glyph === 'mail' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="1"/>
                  <path d="M3 7 L12 13 L21 7"/>
                </svg>
              )}
              {c.glyph === 'ig' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="4"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/>
                </svg>
              )}
              {c.glyph === 'phone' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>
                </svg>
              )}
              {c.glyph === 'store' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8 L5 4 L19 4 L21 8"/>
                  <path d="M3 8 L21 8 L21 20 L3 20 Z"/>
                  <path d="M9 20 L9 13 L15 13 L15 20"/>
                </svg>
              )}
            </span>
            <div class="contact-channels__copy">
              <p class="contact-channels__label">{c.label}</p>
              {c.href
                ? <a href={c.href} class="contact-channels__value" {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}>{c.value}</a>
                : <p class="contact-channels__value">{c.value}</p>
              }
              <p class="contact-channels__body">{c.body}</p>
            </div>
          </li>
        ))}
      </ul>

      <section class="contact-departments" aria-labelledby="departments-title">
        <p class="eyebrow" id="departments-title">{en.contact.departments_eyebrow}</p>
        <p class="contact-departments__intro">{en.contact.departments_intro}</p>
        <ul class="contact-channels">
          {en.contact.departments.map(d => (
            <li class="contact-channels__row">
              <span class="contact-channels__glyph" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="1"/>
                  <path d="M3 7 L12 13 L21 7"/>
                </svg>
              </span>
              <div class="contact-channels__copy">
                <p class="contact-channels__label">{d.label}</p>
                <a href={`mailto:${d.value}`} class="contact-channels__value">{d.value}</a>
                <p class="contact-channels__body">{d.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <ul class="contact-channels" aria-label="Appointment and delivery details">
        <li class="contact-channels__row">
          <span class="contact-channels__glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 2v4M16 2v4M3 10h18"/>
              <rect x="3" y="4" width="18" height="18" rx="2"/>
            </svg>
          </span>
          <div class="contact-channels__copy">
            <p class="contact-channels__label">Appointments</p>
            <p class="contact-channels__body">{en.contact.appointments_line}</p>
            <p class="contact-channels__body">{en.contact.local_delivery_line}</p>
            <p class="contact-channels__body">{en.contact.view_by_appointment_line}</p>
          </div>
        </li>
      </ul>

      <div class="contact-page__cta">
        <a href="/shop" class="btn btn--solid">See catalogue</a>
        <a href="/local" class="btn btn--ghost">Pickup in Truckee</a>
        <a href="/custom-orders" class="btn btn--ghost">Commission a piece</a>
      </div>
    </div>
  </section>
</Base>
