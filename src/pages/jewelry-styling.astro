---
import Base from '../layouts/Base.astro';
import PatternBand from '../components/PatternBand.astro';
import en from '../i18n/en.json';

const S = en.styling;
---
<Base
  title="Jewelry Curation by Appointment — Wenu Mapu"
  description="Selected body jewelry curated to your story and placement. Free curation by request. Truckee / North Lake Tahoe area."
  ogImage="/img/categories/amulets.webp"
>
  <section class="section section--mega">
    <div class="container">
      <p class="eyebrow">{S.eyebrow}</p>
      <h1 class="page-title">{S.title}</h1>
      <p class="lede">{S.intro}</p>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>

      <div class="landing__copy">
        <p>{S.p1}</p>
        <p>{S.p2}</p>
      </div>

      <h2 class="sizing__heading">{S.what_heading}</h2>
      <ul>
        {S.what_items.map(item => <li>{item}</li>)}
      </ul>

      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>

      <h2 class="sizing__heading">{S.how_heading}</h2>
      <ol class="custom-process__list">
        {S.how_steps.map(step => (
          <li class="custom-process__step">
            <span class="custom-process__num">{step.n}</span>
            <div class="custom-process__body">
              <div class="custom-process__head">
                <h3 class="custom-process__name">{step.title}</h3>
              </div>
              <p class="custom-process__text">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>

      <h2 class="sizing__heading">{S.cost_heading}</h2>
      <p>{S.cost_body}</p>

      <div class="landing__cta">
        <a href={S.primary_target} class="btn btn--solid">{S.cta_primary} →</a>
        <a href={S.secondary_target} class="btn btn--ghost">{S.cta_secondary}</a>
      </div>
    </div>
  </section>
</Base>
