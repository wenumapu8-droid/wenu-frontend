---
import Base from '../layouts/Base.astro';
import CollectionView from '../components/CollectionView.astro';
import { NEW_ARRIVALS } from '../data/editorial-collections';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wenumapuonline.com/' },
    { '@type': 'ListItem', position: 2, name: 'New Arrivals', item: 'https://wenumapuonline.com/new-arrivals' },
  ],
};
---
<Base
  title="New Arrivals — the newest pieces | Wenu Mapu"
  description={NEW_ARRIVALS.intro.slice(0, 160)}
  ogImage={NEW_ARRIVALS.webp}
  jsonLd={[breadcrumbLd]}
>
  <CollectionView collection={NEW_ARRIVALS} />
</Base>
