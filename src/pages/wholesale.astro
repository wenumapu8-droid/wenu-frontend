---
import Base from '../layouts/Base.astro';
import PatternBand from '../components/PatternBand.astro';

const wholesaleLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Wholesale — Currently unavailable',
  description:
    'Wenu Mapu is not opening wholesale at this time. The brand is focusing on direct retail, private appointments, and careful stock growth.',
  url: 'https://wenumapuonline.com/wholesale/',
  isPartOf: { '@type': 'WebSite', name: 'Wenu Mapu', url: 'https://wenumapuonline.com' },
};
---

<Base
  title="Wholesale — Currently unavailable"
  description="Wenu Mapu is not opening wholesale at this time. The brand is focusing on direct retail, private appointments, and careful stock growth."
  robots="noindex, nofollow"
  ogImage="/img/brand/meteorite-final.webp"
  jsonLd={wholesaleLd}
>
  <div class="cat-masthead cat-masthead--titled">
    <picture>
      <source type="image/avif" srcset="/img/banners/atmospheric/eclipse-distant.avif" />
      <img src="/img/banners/atmospheric/eclipse-distant.webp" alt="" width="1600" height="686" loading="eager" decoding="async" fetchpriority="high" />
    </picture>
    <div class="cat-masthead__label">
      <p class="cat-masthead__title">Wholesale</p>
      <p class="cat-masthead__eyebrow">Currently Unavailable</p>
    </div>
  </div>

  <section class="section section--mega">
    <div class="container" style="max-width: 860px;">
      <p class="eyebrow">WHOLESALE · CURRENTLY UNAVAILABLE</p>
      <h1 class="page-title" style="max-width: 14ch;">Wholesale is not open right now.</h1>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>
      <p class="lede" style="max-width: 60ch;">
        Wenu Mapu is keeping the brand focused on direct retail, private appointments, and sustainable stock growth before opening any wholesale lane.
      </p>
    </div>
  </section>

  <section class="section" style="background: var(--bg-alt);">
    <div class="container" style="max-width: 860px;">
      <p class="eyebrow">STATUS</p>
      <h2 style="font-family: var(--font-display); font-weight: normal; font-size: clamp(1.6rem, 3vw, 2.4rem); margin: var(--space-3) 0 var(--space-4); max-width: 20ch;">
        Small-batch capacity comes first.
      </h2>
      <p style="max-width: 60ch; font-size: var(--fs-body);">
        Every piece is made or finished with a slow, hands-on process. Until production depth and stock capacity are stronger, Wenu Mapu is not offering wholesale terms, studio accounts, or sample-kit outreach.
      </p>
      <p style="max-width: 60ch; font-size: var(--fs-body); margin-top: var(--space-4);">
        When that lane is ready, it will reopen with a clear application process and a tighter partner fit.
      </p>
    </div>
  </section>

  <section class="section section--mega">
    <div class="container" style="max-width: 860px;">
      <p class="eyebrow">IN THE MEANTIME</p>
      <h2 style="font-family: var(--font-display); font-weight: normal; font-size: clamp(1.8rem, 3.5vw, 2.8rem); margin: var(--space-3) 0 var(--space-4); max-width: 18ch;">
        Retail, private appointments, and direct contact stay open.
      </h2>
      <div style="display: grid; grid-template-columns: minmax(160px, 220px) 1fr; gap: var(--space-3) var(--space-5); max-width: 60ch;">
        <div class="eyebrow" style="margin: 0;">EMAIL</div>
        <div><a href="mailto:marimari@wenumapuonline.com">marimari@wenumapuonline.com</a></div>

        <div class="eyebrow" style="margin: 0;">PHONE</div>
        <div>+1 (408) 500-6211</div>

        <div class="eyebrow" style="margin: 0;">LOCAL</div>
        <div>Private appointments and free local delivery in Truckee / North Lake Tahoe.</div>
      </div>
    </div>
  </section>
</Base>
