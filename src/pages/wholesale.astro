---
import Base from '../layouts/Base.astro';
import PatternBand from '../components/PatternBand.astro';
import EmbossedSeal from '../components/EmbossedSeal.astro';

const wholesaleLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Wholesale — Wenu Mapu',
  description: 'Wholesale program for premium piercing studios. Solid 950 silver, 14k gold, implant-grade titanium and Atacama meteorite — hand-forged in Chile.',
  url: 'https://wenumapuonline.com/wholesale/',
  isPartOf: { '@type': 'WebSite', name: 'Wenu Mapu', url: 'https://wenumapuonline.com' },
};
---

<Base
  title="Wholesale — Wenu Mapu"
  description="Wholesale program for premium piercing studios. Solid 950 silver, 14k gold, implant-grade titanium and Atacama meteorite — hand-forged in Chile. 50% off MSRP."
  ogImage="/img/brand/meteorite-final.webp"
  jsonLd={wholesaleLd}
>
  <!-- Hero -->
  <section class="section section--mega">
    <div class="container" style="max-width: 880px;">
      <p class="eyebrow">WHOLESALE · FOR PREMIUM STUDIOS</p>
      <h1 class="page-title" style="max-width: 18ch;">For piercers who curate what touches the body.</h1>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>
      <p class="lede" style="max-width: 60ch;">
        Wenu Mapu opens a small wholesale program in 2026 — three to five premium US studios this year.
        Solid 950 silver, 14k gold, implant-grade titanium (ASTM F-136), and a material no other studio is carrying:
        vacamuerta meteorite, sourced from Chile's Atacama Desert, set into cast silver. Hand-forged in Chile,
        finished and shipped from Truckee, California.
      </p>
    </div>
  </section>

  <!-- The Lane -->
  <section class="section" style="background: var(--bg-alt);">
    <div class="container" style="max-width: 880px;">
      <p class="eyebrow">01 · THE LANE</p>
      <h2 style="font-family: var(--font-display); font-weight: normal; font-size: clamp(1.6rem, 3vw, 2.4rem); margin: var(--space-3) 0 var(--space-4); max-width: 22ch;">
        The hand-carved-organic-into-cast-precious-metal lane.
      </h2>
      <p style="max-width: 60ch; font-size: var(--fs-body);">
        The segment Maya Jewelry left empty when they closed in December still has no obvious successor.
        Our work sits inside it without crowding anyone else on your bench (BVLA, Anatometal, BJO).
      </p>
      <p style="max-width: 60ch; font-size: var(--fs-body); margin-top: var(--space-4);">
        The aesthetic is mapuche symbolism — kultrún quadrants, choike, ngïrü, vilu —
        interpreted as design vocabulary, not folklore. The pieces speak in geometry and material, never costume.
      </p>
    </div>
  </section>

  <!-- Terms -->
  <section class="section">
    <div class="container" style="max-width: 880px;">
      <p class="eyebrow">02 · TERMS</p>
      <h2 style="font-family: var(--font-display); font-weight: normal; font-size: clamp(1.6rem, 3vw, 2.4rem); margin: var(--space-3) 0 var(--space-5); max-width: 22ch;">
        How we work with partners.
      </h2>

      <dl style="display: grid; grid-template-columns: minmax(140px, 200px) 1fr; gap: var(--space-3) var(--space-5); max-width: 60ch;">
        <dt class="eyebrow" style="margin: 0;">DISCOUNT</dt>
        <dd style="margin: 0;"><strong>50% off MSRP</strong> — flat across the catalog.</dd>

        <dt class="eyebrow" style="margin: 0;">OPENING ORDER</dt>
        <dd style="margin: 0;"><strong>8 pieces or $600</strong> — whichever is higher. Curated to your bench.</dd>

        <dt class="eyebrow" style="margin: 0;">REORDER</dt>
        <dd style="margin: 0;"><strong>4 pieces or $300</strong> — combined with custom commissions allowed.</dd>

        <dt class="eyebrow" style="margin: 0;">PAYMENT</dt>
        <dd style="margin: 0;"><strong>Pre-pay first three orders</strong> — Net 30 thereafter.</dd>

        <dt class="eyebrow" style="margin: 0;">SHIPPING</dt>
        <dd style="margin: 0;"><strong>USPS Priority</strong> — from Truckee, CA. 1–3 days domestic, 7–14 international.</dd>

        <dt class="eyebrow" style="margin: 0;">LEAD TIME</dt>
        <dd style="margin: 0;"><strong>2–5 business days</strong> — from order confirmation to dispatch.</dd>

        <dt class="eyebrow" style="margin: 0;">RETURNS</dt>
        <dd style="margin: 0;"><strong>30 days on stock pieces</strong> — custom and one-of-one non-refundable.</dd>

        <dt class="eyebrow" style="margin: 0;">EXCLUSIVITY</dt>
        <dd style="margin: 0;"><strong>None in Year One</strong> — geographic exclusivity reviewed in Year Two.</dd>
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--mega" style="background: var(--bg-deep); color: var(--fg-light);">
    <div class="container" style="text-align: center; max-width: 720px;">
      <EmbossedSeal text="WENU · MAPU · WHOLESALE · 2026" size={120} />
      <h2 style="font-family: var(--font-display); font-weight: normal; font-size: clamp(2rem, 4vw, 3rem); margin: var(--space-5) 0 var(--space-3); color: var(--bg);">
        Reply with your studio address.
      </h2>
      <p style="font-style: italic; font-size: var(--fs-body); margin-bottom: var(--space-5); color: var(--bg-alt);">
        We send a sample kit within five business days.
      </p>
      <p style="font-family: var(--font-mono, monospace); font-size: var(--fs-small); letter-spacing: 0.05em; margin: var(--space-3) 0; color: var(--bg);">
        <a href="mailto:wholesale@wenumapuonline.com" style="color: inherit; text-decoration: underline;">wholesale@wenumapuonline.com</a>
      </p>
      <p style="font-family: var(--font-mono, monospace); font-size: var(--fs-small); letter-spacing: 0.05em; color: var(--bg-alt);">
        +1 (408) 500-6211 · Mary Mari, Founder &amp; Maker
      </p>
      <div style="margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid rgba(255,255,255,0.15);">
        <p style="font-style: italic; font-size: var(--fs-small); color: var(--bg-alt); margin: 0;">
          Truckee, California · Made by hand in Chile
        </p>
      </div>
    </div>
  </section>
</Base>
