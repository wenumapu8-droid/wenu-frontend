---
import Base from '../layouts/Base.astro';
import PatternBand from '../components/PatternBand.astro';
import en from '../i18n/en.json';

const a = en.about;
---
<Base
  title="About — Wenu Mapu"
  description="Wenu Mapu — a small jewelry workshop in Truckee, California. Hand-forged body jewelry in titanium, silver, gold, wood and stone. By appointment and worldwide shipping."
  ogImage="/img/hero/hero-model-old.webp"
>
  <section class="section section--mega">
    <div class="container">
      <p class="eyebrow">{a.eyebrow}</p>
      <h1 class="page-title">{a.title}</h1>
      <p class="lede">{a.intro}</p>
      <div class="page-divider"><PatternBand variant="hairline" tone="bronze" /></div>
    </div>
  </section>

  <!-- Essence band — brand statement over a cosmic field (portal P07). Reuses
       the .threshold pattern (proven legible: copy in lower third + scrim). -->
  <section class="threshold" aria-label="Brand essence">
    <picture>
      <source
        type="image/avif"
        srcset="/img/banners/cosmic/cosmos-field-900w.avif 900w, /img/banners/cosmic/cosmos-field-1200w.avif 1200w, /img/banners/cosmic/cosmos-field-1600w.avif 1600w, /img/banners/cosmic/cosmos-field-1920w.avif 1920w"
        sizes="100vw"
      />
      <img
        src="/img/banners/cosmic/cosmos-field-1200w.webp"
        srcset="/img/banners/cosmic/cosmos-field-900w.webp 900w, /img/banners/cosmic/cosmos-field-1200w.webp 1200w, /img/banners/cosmic/cosmos-field-1600w.webp 1600w, /img/banners/cosmic/cosmos-field-1920w.webp 1920w"
        sizes="100vw"
        alt=""
        width="1672"
        height="941"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="threshold__veil"></div>
    <div class="container threshold__copy">
      <p class="eyebrow threshold__arn">{a.essence.eyebrow}</p>
      <h2 class="threshold__title">{a.essence.title}</h2>
      <p class="threshold__line">{a.essence.line}</p>
    </div>
  </section>

  <!-- Values -->
  <section id="values" class="section about-block">
    <div class="container about-block__grid">
      <div class="about-block__head">
        <p class="eyebrow">Our values</p>
        <h2 class="about-block__title">{a.values.heading}</h2>
      </div>
      <ul class="about-materials__list">
        {a.values.items.map(item => (
          <li class="about-materials__item">
            <h3 class="about-materials__title">{item.title}</h3>
            <p class="about-materials__body">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Story -->
  <section id="story" class="section about-block">
    <div class="container about-block__grid">
      <div class="about-block__head">
        <p class="eyebrow">01 · Story</p>
        <h2 class="about-block__title">{a.story.heading}</h2>
      </div>
      <div class="about-block__body">
        <figure class="archive-card__img-wrap" style="margin: 0 0 var(--space-5); max-width: 520px;">
          <picture>
            <source srcset="/img/brand/about-archive.avif" type="image/avif" />
            <img src="/img/brand/about-archive.webp" alt="" loading="lazy" decoding="async" width="1200" height="1200" />
          </picture>
        </figure>
        <p>{a.story.p1}</p>
        <p>{a.story.p2}</p>
        <p class="italic text-soft">{a.story.p3}</p>
      </div>
    </div>
  </section>

  <!-- Materials -->
  <section id="materials" class="section about-block about-block--alt">
    <div class="container about-block__grid">
      <div class="about-block__head">
        <p class="eyebrow">02 · Materials</p>
        <h2 class="about-block__title">{a.materials.heading}</h2>
      </div>
      <ul class="about-materials__list">
        {a.materials.items.map(item => (
          <li class="about-materials__item">
            <h3 class="about-materials__title">{item.title}</h3>
            <p class="about-materials__body">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Artistry -->
  <section id="artistry" class="section about-block">
    <div class="container about-block__grid">
      <div class="about-block__head">
        <p class="eyebrow">03 · Artistry</p>
        <h2 class="about-block__title">{a.artistry.heading}</h2>
      </div>
      <div class="about-block__body">
        <p>{a.artistry.p1}</p>
        <p class="italic text-soft">{a.artistry.p2}</p>
        <p style="margin-top: var(--space-4);">
          <a href="/custom-orders" class="btn btn--ghost">Commissions →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Presence -->
  <section id="stockists" class="section about-block about-block--alt">
    <div class="container about-block__grid">
      <div class="about-block__head">
        <p class="eyebrow">04 · Presence</p>
        <h2 class="about-block__title">{a.stockists.heading}</h2>
      </div>
      <div class="about-block__body">
        <p>{a.stockists.intro}</p>
        <ul class="about-stockists__list">
          {a.stockists.list.map(s => <li>{s}</li>)}
        </ul>
        <p style="margin-top: var(--space-4);">
          <a href="/local" class="btn btn--ghost">Private appointments →</a>
        </p>
      </div>
    </div>
  </section>
</Base>
