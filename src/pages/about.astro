---
import Base from '../layouts/Base.astro';
import en from '../i18n/en.json';
---
<Base title="About — Wenu Mapu" description="Wenu Mapu — a small jewelry studio in Truckee, California, forging body jewelry by hand from titanium, silver, wood and stone.">
  <section class="section section--mega">
    <p class="eyebrow">{en.about.eyebrow}</p>
    <h1 class="page-title">{en.about.title}</h1>
    <p class="lede">{en.about.intro}</p>
    <p class="muted" style="margin-top: var(--space-5);">{en.about.soon}</p>
  </section>
</Base>
