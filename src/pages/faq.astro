---
import Base from '../layouts/Base.astro';
import en from '../i18n/en.json';

const f = en.faq;
---
<Base
  title="FAQ — Wenu Mapu"
  description="Common questions about Wenu Mapu body jewelry, materials, shipping, custom commissions and care."
>
  <section class="section section--mega">
    <div class="container faq">
      <p class="eyebrow">{f.eyebrow}</p>
      <h1 class="page-title">{f.title}</h1>
      <p class="lede">{f.intro}</p>

      <ul class="faq__list">
        {f.items.map((item, i) => (
          <li class="faq__item">
            <details>
              <summary>
                <span class="faq__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="faq__q">{item.q}</span>
                <span class="faq__chev" aria-hidden="true">+</span>
              </summary>
              <p class="faq__a">{item.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
