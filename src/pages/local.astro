---
import Base from '../layouts/Base.astro';
import en from '../i18n/en.json';
import EmbossedSeal from '../components/EmbossedSeal.astro';
const steps = en.pickup.steps as Record<string, {title: string; body: string}>;
---

<Base
  title="Local Pickup in Truckee — Wenu Mapu"
  description="Pick up your order at the workshop in Truckee, California. Free, by appointment. North Lake Tahoe and Reno also available."
>
  <section class="section">
    <div class="container">
      <div class="grid-asym-2">
        <div>
          <p class="eyebrow">{en.pickup.eyebrow}</p>
          <h1 style="margin: var(--space-3) 0;">{en.pickup.title}</h1>
          <div class="divider-h"></div>
          <p class="italic text-soft" style="margin-bottom: var(--space-5);">
            {en.pickup.intro}
          </p>
          <div style="color: var(--accent); margin-top: var(--space-5);">
            <EmbossedSeal text="TRAFÜN · TRUCKEE · CA" size={140} />
          </div>
        </div>

        <div>
          <div style="display: flex; flex-direction: column; gap: 0; border-top: var(--border-thin);">
            {['1','2','3','4','5'].map(n => (
              <div style="display: grid; grid-template-columns: 80px 1fr; gap: var(--space-4); padding: var(--space-4) 0; border-bottom: var(--border-thin); align-items: start;">
                <span class="display text-accent" style="font-size: 2.5rem; line-height: 1;">{n.padStart(2, '0')}</span>
                <div>
                  <h3 style="font-size: 1.3rem; margin-bottom: var(--space-2);">{steps[n].title}</h3>
                  <p class="text-soft" style="font-size: var(--fs-small);">{steps[n].body}</p>
                </div>
              </div>
            ))}
          </div>

          <div style="background: var(--bg-alt); border-left: 4px solid var(--accent); padding: var(--space-4); margin: var(--space-5) 0;">
            <p class="italic text-soft">{en.pickup.note}</p>
          </div>

          <div style="display: flex; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-5);">
            <a href="/shop" class="btn btn--solid">See catalogue</a>
            <a href="/contact" class="btn">Coordinate by email</a>
          </div>

          <div style="border-top: var(--border-thin); padding-top: var(--space-4);">
            <p class="eyebrow text-soft" style="margin-bottom: var(--space-3);">{en.pickup.coverage}</p>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: var(--space-2);">
              {en.pickup.locations.map(loc => (
                <li style="font-family: var(--font-serif); font-size: var(--fs-body);">
                  <span class="text-accent" style="margin-right: var(--space-2);">◆</span>{loc}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
