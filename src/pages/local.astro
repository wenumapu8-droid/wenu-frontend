---
import Base from '../layouts/Base.astro';
import EmbossedSeal from '../components/EmbossedSeal.astro';
import en from '../i18n/en.json';

const steps = en.pickup.steps as Record<string, { title: string; body: string }>;
const stepKeys = ['1', '2', '3', '4', '5'];
---
<Base
  title="Local Pickup in Truckee — Wenu Mapu"
  description="Pick up your order at the workshop in Truckee, California. Free, by appointment. North Lake Tahoe and Reno also covered."
>
  <section class="section section--mega local-page">
    <div class="container local-page__inner">
      <header class="local-page__head">
        <p class="eyebrow">{en.pickup.eyebrow}</p>
        <h1 class="page-title">{en.pickup.title}</h1>
        <p class="lede">{en.pickup.intro}</p>
        <div class="local-page__seal" aria-hidden="true">
          <EmbossedSeal text="TRAFÜN · TRUCKEE · CA" size={140} />
        </div>
      </header>

      <ol class="local-steps">
        {stepKeys.map(n => (
          <li class="local-steps__item">
            <span class="local-steps__num">{n.padStart(2, '0')}</span>
            <div class="local-steps__copy">
              <h3 class="local-steps__title">{steps[n].title}</h3>
              <p class="local-steps__body">{steps[n].body}</p>
            </div>
          </li>
        ))}
      </ol>

      <aside class="local-note">
        <p>{en.pickup.note}</p>
      </aside>

      <div class="local-coverage">
        <p class="eyebrow">{en.pickup.coverage}</p>
        <ul class="local-coverage__list">
          {en.pickup.locations.map(loc => (
            <li>
              <span class="local-coverage__dot" aria-hidden="true"></span>
              <span>{loc}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="local-page__cta">
        <a href="/shop" class="btn btn--solid">See catalogue</a>
        <a href="/contact" class="btn btn--ghost">Coordinate by email</a>
      </div>
    </div>
  </section>
</Base>
