---
import Base from '../../layouts/Base.astro';
import '../../styles/portfolio.css';
---

<Base
  title="OCÍN — Creative Technologist · Nicolás Ortega"
  description="Nicolás Ortega / Ocín — Creative Technologist building visual systems, interactive experiences and AI-native prototypes."
  robots="noindex, nofollow"
  noNav={true}
  noFooter={true}
  noOverlays={true}
  noQuote={true}
  noThemes={true}
  noKai={true}
  noCart={true}
  noImmersive={true}
>
  <div class="pf">
    <header class="pf-nav">
      <div class="pf-shell pf-nav__inner">
        <a class="pf-wordmark" href="/portfolio">
          OCÍN <small>Creative Technologist</small>
        </a>
        <nav class="pf-nav__links" aria-label="Portfolio">
          <a href="#work">Work</a>
          <a href="#about">About</a>
          <a href="mailto:ocinkey8@gmail.com">Contact</a>
        </nav>
      </div>
    </header>

    <section class="pf-shell pf-hero" aria-labelledby="portfolio-title">
      <div data-pf-reveal>
        <p class="pf-kicker">Design × Technology × AI × Product</p>
        <h1 id="portfolio-title" class="pf-title">
          I build systems for worlds.
          <em>Visual systems, interactive experiences and AI-native prototypes.</em>
        </h1>
        <p class="pf-lede">
          I’m Nicolás Ortega / Ocín, a multidisciplinary Creative Technologist with a background in
          industrial design, founder-led product work, visual systems and emerging technology.
          My strongest skill is turning ambiguous ideas into coherent systems that can be seen,
          tested and developed further.
        </p>
        <div class="pf-actions">
          <a class="pf-btn pf-btn--primary" href="#work">Selected work</a>
          <a class="pf-btn" href="mailto:ocinkey8@gmail.com">Contact</a>
          <a class="pf-btn" href="https://www.behance.net/wenumapu" target="_blank" rel="noreferrer">Behance</a>
        </div>
      </div>

      <div class="pf-hero__visual" aria-hidden="true" data-pf-reveal>
        <div class="pf-orbit">
          <div class="pf-orbit__core"></div>
          <span class="pf-orbit__tag pf-meta">Concept → Grammar → Prototype → System</span>
        </div>
      </div>
    </section>

    <section id="work" class="pf-section">
      <div class="pf-shell">
        <div class="pf-section__head" data-pf-reveal>
          <p class="pf-label">Selected work / 2026</p>
          <div>
            <h2>Concept becomes credible when it has rules, behavior and evidence.</h2>
            <p class="pf-section__intro">
              These projects show two sides of the same practice: KODEX-∞ explores speculative,
              interactive systems; Wënü Mäpü proves how that thinking survives contact with product,
              commerce and real operational constraints.
            </p>
          </div>
        </div>

        <div class="pf-projects">
          <article class="pf-project" data-pf-reveal>
            <div class="pf-project__copy">
              <p class="pf-project__index pf-meta">01 / Experimental system</p>
              <div>
                <h3>KODEX-∞</h3>
                <p class="pf-project__desc">
                  A modular visual and interactive system exploring worldbuilding, generative design,
                  responsive interfaces and procedural behavior as one coherent language.
                </p>
                <div class="pf-project__skills">
                  <span class="pf-chip">Creative Technology</span>
                  <span class="pf-chip">Visual Systems</span>
                  <span class="pf-chip">Interaction</span>
                  <span class="pf-chip">AI Direction</span>
                </div>
                <a class="pf-project__link" href="/portfolio/kodex">View case study</a>
              </div>
            </div>
            <div class="pf-project__media">
              <img src="/img/kodex/brand/kodex-00-threshold.png" alt="KODEX-∞ threshold interface" loading="lazy" />
            </div>
          </article>

          <article class="pf-project" data-pf-reveal>
            <div class="pf-project__copy">
              <p class="pf-project__index pf-meta">02 / Founder-led commercial system</p>
              <div>
                <h3>Wënü Mäpü</h3>
                <p class="pf-project__desc">
                  An independent body-jewelry brand built across physical product, identity,
                  photography, e-commerce, merchandising, storytelling and customer experience.
                </p>
                <div class="pf-project__skills">
                  <span class="pf-chip">Creative Direction</span>
                  <span class="pf-chip">Product</span>
                  <span class="pf-chip">E-commerce</span>
                  <span class="pf-chip">Photography</span>
                </div>
                <a class="pf-project__link" href="/portfolio/wenu-mapu">View case study</a>
              </div>
            </div>
            <div class="pf-project__media">
              <img src="/img/hero/hero-body-eclipse.webp" alt="Wënü Mäpü body jewelry campaign" loading="lazy" />
            </div>
          </article>

          <article class="pf-project" data-pf-reveal>
            <div class="pf-project__copy">
              <p class="pf-project__index pf-meta">03 / Physical + spatial work</p>
              <div>
                <h3>Stage & Sculpture</h3>
                <p class="pf-project__desc">
                  Earlier physical work includes festival/stage identity and sculptural fabrication —
                  evidence of an industrial-design practice that moves between screen, structure and matter.
                </p>
                <div class="pf-project__skills">
                  <span class="pf-chip">Spatial Design</span>
                  <span class="pf-chip">3D Thinking</span>
                  <span class="pf-chip">Fabrication</span>
                  <span class="pf-chip">Visual Identity</span>
                </div>
                <a class="pf-project__link" href="/projects">Explore projects</a>
              </div>
            </div>
            <div class="pf-project__media">
              <img src="/img/physical/quinto-01.webp" alt="Quinto Fuego stage design" loading="lazy" />
            </div>
          </article>

          <article class="pf-project" data-pf-reveal>
            <div class="pf-project__copy">
              <p class="pf-project__index pf-meta">04 / Visual craft</p>
              <div>
                <h3>Photography</h3>
                <p class="pf-project__desc">
                  Product and editorial photography focused on material detail, jewelry, metal,
                  stone and small objects — used across commerce, brand systems and independent work.
                </p>
                <div class="pf-project__skills">
                  <span class="pf-chip">Product Photography</span>
                  <span class="pf-chip">Art Direction</span>
                  <span class="pf-chip">Material</span>
                  <span class="pf-chip">Editorial</span>
                </div>
                <a class="pf-project__link" href="/gallery">View selected photography</a>
              </div>
            </div>
            <div class="pf-project__media">
              <img src="/img/brand/meteorite-final.webp" alt="Wënü Mäpü material and jewelry photography" loading="lazy" />
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="pf-section">
      <div class="pf-shell">
        <div class="pf-section__head" data-pf-reveal>
          <p class="pf-label">Capabilities</p>
          <div>
            <h2>A bridge between disciplines.</h2>
            <p class="pf-section__intro">
              I’m not trying to replace a specialist engineer, designer or director. My value is connecting
              those disciplines early enough that an idea becomes a testable system instead of a disconnected handoff.
            </p>
          </div>
        </div>

        <div class="pf-capabilities">
          <article class="pf-capability" data-pf-reveal>
            <p class="pf-meta">01</p>
            <h3>Creative Technology</h3>
            <p>Interactive concepts, rapid prototypes, responsive behavior and emerging-interface exploration.</p>
          </article>
          <article class="pf-capability" data-pf-reveal>
            <p class="pf-meta">02</p>
            <h3>Visual Systems</h3>
            <p>Rules for typography, symbols, composition, motion and cross-format coherence.</p>
          </article>
          <article class="pf-capability" data-pf-reveal>
            <p class="pf-meta">03</p>
            <h3>AI-Native Workflows</h3>
            <p>Human-directed exploration, evaluation criteria and assisted production — not output for output’s sake.</p>
          </article>
          <article class="pf-capability" data-pf-reveal>
            <p class="pf-meta">04</p>
            <h3>Product + Experience</h3>
            <p>Founder-level thinking across physical product, digital experience, commerce and customer constraints.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="about" class="pf-section">
      <div class="pf-shell pf-about">
        <p class="pf-about__statement" data-pf-reveal>
          Ambiguity → grammar → prototype → test → system.
        </p>
        <div class="pf-about__copy" data-pf-reveal>
          <p>
            My background in industrial design shapes how I work. I don’t treat visuals as isolated outputs:
            I look for the underlying system — what the idea means, how it behaves, what constraints it has
            and how another person could continue it.
          </p>
          <p>
            A large part of my creative-technology practice has been self-directed. That has made me unusually
            comfortable moving from concept to visual direction, product thinking, prototypes and documentation.
            I’m strongest in conceptual direction and visual systems, and I’m actively deepening the engineering
            side through creative coding and interactive prototypes.
          </p>
          <p>
            I’m currently interested in Creative Technologist, Interactive Designer, Experience Designer and
            AI-creative roles where designers, technologists and engineers build together.
          </p>
        </div>
      </div>
    </section>

    <section class="pf-section pf-contact">
      <div class="pf-shell" data-pf-reveal>
        <p class="pf-kicker">Open to selected roles + collaborations</p>
        <h2>Let’s build something that has rules, not just a look.</h2>
        <p>
          Based in California. Open to remote, hybrid and relocation opportunities across creative technology,
          interactive design and AI-native creative work.
        </p>
        <div class="pf-actions" style="justify-content:center">
          <a class="pf-btn pf-btn--primary" href="mailto:ocinkey8@gmail.com">ocinkey8@gmail.com</a>
          <a class="pf-btn" href="https://www.behance.net/wenumapu" target="_blank" rel="noreferrer">Behance</a>
        </div>
      </div>
    </section>

    <footer class="pf-shell pf-footer">
      <span class="pf-meta">Nicolás Ortega / Ocín</span>
      <span class="pf-meta">Creative Technologist · California</span>
    </footer>
  </div>

  <script>
    (() => {
      const items = document.querySelectorAll('[data-pf-reveal]');
      if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      }, { threshold: 0.08, rootMargin: '0px 0px -48px 0px' });
      items.forEach((el) => observer.observe(el));
    })();
  </script>
</Base>
