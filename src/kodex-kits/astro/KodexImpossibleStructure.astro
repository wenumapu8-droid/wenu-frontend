---
import "./kodex-impossible.css";

interface Props {
  title?: string;
  description?: string;
  shaderBase?: string;
}

const {
  title = "THE STRUCTURE REMEMBERS TWO DIRECTIONS.",
  description = "An impossible architecture generated in real time.",
  shaderBase = "/assets/kodex/shaders",
} = Astro.props;
---

<section
  class="kdx-impossible"
  data-kdx-impossible
  data-shader-base={shaderBase}
  data-state="0"
>
  <canvas class="kdx-impossible__canvas" aria-hidden="true"></canvas>
  <div class="kdx-fallback" aria-hidden="true"></div>

  <div class="kdx-shell">
    <header class="kdx-header">
      <div class="kdx-logo">KODEX−∞</div>
      <div class="kdx-header__right">
        <span class="kdx-dot"></span>
        <span>STRUCTURE · LIVE</span>
        <span>KDX_02</span>
      </div>
    </header>

    <div class="kdx-main">
      <div class="kdx-copy">
        <p class="kdx-kicker">02 / 08 · NON-EUCLIDEAN PROTOCOL</p>
        <h2 class="kdx-title">{title}</h2>
        <p class="kdx-description">{description}</p>

        <div class="kdx-actions">
          <button class="kdx-cta" type="button" data-kdx-activate>
            ENTER CONTRADICTION →
          </button>
          <button
            class="kdx-mic"
            type="button"
            data-kdx-mic
            aria-label="Activate microphone response"
            aria-pressed="false"
          >
            MIC
          </button>
        </div>
      </div>

      <div aria-hidden="true"></div>

      <aside class="kdx-rail">
        <div>State<strong data-kdx-state>DORMANT</strong></div>
        <div>Class<strong>IMPOSSIBLE</strong></div>
        <div>Axis<strong>DUAL</strong></div>
        <div>FPS<strong data-kdx-fps>—</strong></div>
      </aside>
    </div>

    <footer class="kdx-footer">
      <span>PREVIOUS</span>
      <span class="kdx-progress" aria-hidden="true"></span>
      <span class="kdx-footer__index">02 / 08 · INDEX</span>
    </footer>
  </div>
</section>

<script>
  import { mountKodexImpossibleStructure } from "./kodex-impossible-client";

  document.querySelectorAll<HTMLElement>("[data-kdx-impossible]").forEach((element) => {
    mountKodexImpossibleStructure(element);
  });
</script>
