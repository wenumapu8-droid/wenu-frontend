---
/**
 * AtelierGallery — Recent piercing work, screenshots from @wenu_mapu Instagram.
 *
 * Cada item es una foto real del trabajo de Ocin en Lucky 7 Tattoo & Piercing.
 * Click → abre el perfil de Instagram (o el post específico si está documentado).
 *
 * Assets esperados en /public/img/piercing/atelier/*.webp (o .jpg).
 * Si una foto no existe todavía, el card se renderiza con un placeholder elegante.
 *
 * Para agregar nuevas fotos:
 *   1. Captura limpia del Instagram (long-press → guardar imagen, sin el UI del IG).
 *   2. Optimiza a webp ≤200KB (sips o squoosh.app).
 *   3. Copia a /public/img/piercing/atelier/<fecha>-<tecnica>.webp
 *   4. Agrega al array `items` abajo.
 */
interface AtelierItem {
  img: string;          // path bajo /public, ej '/img/piercing/atelier/2026-02-20-daith.webp'
  alt: string;          // alt descriptivo, no decorativo
  technique: string;    // ej "Daith"
  caption: string;      // 1 línea breve, lo que se hizo
  dateISO: string;      // YYYY-MM-DD
  igUrl?: string;       // si está, link al post puntual; si no, perfil
}

/**
 * NOTA: el orden de los `igUrl` aquí asume que mapean 1:1 al orden de los
 * screenshots que mandó Ocin (daith primero → high nostril último). Si alguno
 * está mal asignado, swap el `igUrl` entre cards — el resto del código no toca.
 * Hay 3 URLs adicionales que Ocin mandó (sin screenshot todavía), agregadas
 * como cards extra con "Photo pending" hasta que lleguen las imágenes.
 */
// NOTE (2026-06-05): photos pulled from @wenu__mapu Instagram posts and hosted
// locally as webp. Technique labels are best-guess from the image; owner should
// confirm/correct each. Captions kept short and on-voice (no over-claims).
const items: AtelierItem[] = [
  {
    img: '/img/piercing/work/septum-01.webp',
    alt: 'Septum piercing with a fine silver ring, placed by hand',
    technique: 'Septum',
    caption: 'Septum · placed by hand.',
    dateISO: '2026-06-22',
  },
  {
    img: '/img/piercing/work/tragus-01.webp',
    alt: 'Tragus piercing with a gold teardrop gem, healed',
    technique: 'Tragus',
    caption: 'Tragus · healed.',
    dateISO: '2026-06-22',
  },
  {
    img: '/img/piercing/atelier/2026-02-20-daith.webp',
    alt: 'Healed nostril piercing with a fine ring, on a smiling client',
    technique: 'Nostril',
    caption: 'Nostril ring — settled, healed, happy.',
    dateISO: '2026-02-20',
    igUrl: 'https://www.instagram.com/p/DXkg4yvEtmE/',
  },
  {
    img: '/img/piercing/atelier/2026-03-03-septum-labret.webp',
    alt: 'Curated ear — tragus piercing with opal end and a red-gem lobe',
    technique: 'Tragus + Lobe',
    caption: 'Tragus with opal end · lobe upgrade.',
    dateISO: '2026-03-03',
    igUrl: 'https://www.instagram.com/p/DWdJ7dslIoG/',
  },
  {
    img: '/img/piercing/atelier/2026-03-15-flat-rook.webp',
    alt: 'Curated ear with helix and flat piercings, healed',
    technique: 'Ear curation',
    caption: 'Helix and flat — a cleaner curation.',
    dateISO: '2026-03-15',
    igUrl: 'https://www.instagram.com/p/DV6yo-gki0c/',
  },
  {
    img: '/img/piercing/atelier/2026-03-28-tragus.webp',
    alt: 'Septum ring and a lip labret, healed',
    technique: 'Septum + Lip',
    caption: 'Septum and lip — placed by hand.',
    dateISO: '2026-03-28',
    igUrl: 'https://www.instagram.com/p/DVcYinjD7iT/',
  },
  {
    img: '/img/piercing/atelier/2026-04-25-high-nostril.webp',
    alt: 'Curated ear — rook and lobe piercings',
    technique: 'Ear curation',
    caption: 'Rook and lobe work — thank you for your trust.',
    dateISO: '2026-04-25',
    igUrl: 'https://www.instagram.com/p/DU_anGykSYF/',
  },
];

const IG_PROFILE = 'https://www.instagram.com/wenu__mapu/';

// Format date as "20 Feb 2026" — brand voice editorial
const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-US', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<section class="atelier" aria-labelledby="atelier-title">
  <div class="container atelier__head">
    <p class="eyebrow">Atelier · By private appointment</p>
    <h2 id="atelier-title" class="atelier__title">Recent work.</h2>
    <p class="atelier__lede">
      Each piercing is placed by hand, with sterile technique and implant-grade
      adornment. A small selection of recent appointments —
      <a href={IG_PROFILE} target="_blank" rel="noopener noreferrer" class="atelier__ig">
        see more on Instagram <span aria-hidden="true">↗</span>
      </a>
    </p>
  </div>

  <ul class="container atelier__grid" data-fade-in-stagger>
    {items.map(it => {
      const href = it.igUrl || IG_PROFILE;
      return (
        <li class="atelier-card">
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="atelier-card__link"
            aria-label={`${it.technique} — ${fmtDate(it.dateISO)} · view on Instagram`}
          >
            <div class="atelier-card__img-wrap">
              <img
                src={it.img}
                alt={it.alt}
                loading="lazy"
                decoding="async"
                width="800"
                height="800"
                onerror="this.style.opacity='0';this.closest('.atelier-card__img-wrap').classList.add('is-missing');"
              />
              <span class="atelier-card__missing" aria-hidden="true">
                <svg viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="0.8">
                  <circle cx="16" cy="16" r="12" opacity="0.5"/>
                  <line x1="16" y1="6" x2="16" y2="26" opacity="0.4"/>
                  <line x1="6" y1="16" x2="26" y2="16" opacity="0.4"/>
                </svg>
                <span>Photo pending</span>
              </span>
            </div>
            <div class="atelier-card__caption">
              <p class="atelier-card__technique">{it.technique}</p>
              <p class="atelier-card__line">{it.caption}</p>
              <p class="atelier-card__meta">
                <span>{fmtDate(it.dateISO)}</span>
                <span aria-hidden="true">·</span>
                <span class="atelier-card__ig-tag">@wenu__mapu</span>
              </p>
            </div>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .atelier {
    background: var(--obsidian);
    padding: clamp(72px, 9vw, 128px) 0;
    border-top: var(--border-thin);
  }

  .atelier__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--space-6);
  }

  .atelier__title {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.05;
    color: var(--bone);
    margin: var(--space-3) 0 var(--space-4);
  }

  .atelier__lede {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-style: italic;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.6;
    color: var(--fg-soft);
    margin: 0;
  }

  .atelier__ig {
    font-style: normal;
    color: var(--ember);
    border-bottom: 1px solid rgba(196, 147, 90, 0.45);
    padding-bottom: 1px;
    text-decoration: none;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .atelier__ig:hover,
  .atelier__ig:focus-visible {
    color: var(--bone);
    border-bottom-color: var(--bone);
  }

  .atelier__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0;
    border-top: var(--border-thin);
    border-left: var(--border-thin);
  }

  .atelier-card {
    border-right: var(--border-thin);
    border-bottom: var(--border-thin);
    background: var(--bg-alt);
  }

  .atelier-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: background var(--t-base), transform var(--t-base);
  }
  .atelier-card__link:hover,
  .atelier-card__link:focus-visible {
    background: var(--bg-lift);
    outline: none;
  }

  .atelier-card__img-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--bg-lift);
  }
  .atelier-card__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(8%) contrast(1.05);
    transition: transform var(--t-slow), filter var(--t-slow);
  }
  .atelier-card__link:hover .atelier-card__img-wrap img,
  .atelier-card__link:focus-visible .atelier-card__img-wrap img {
    transform: scale(1.04);
    filter: grayscale(0%) contrast(1.05) brightness(1.05);
  }

  /* Missing photo placeholder (visible when <img> fails to load) */
  .atelier-card__missing {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: var(--bronze);
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    letter-spacing: var(--letter-spacing-ritual);
    text-transform: uppercase;
  }
  .atelier-card__img-wrap.is-missing .atelier-card__missing {
    display: flex;
  }

  .atelier-card__caption {
    padding: var(--space-3) var(--space-4) var(--space-4);
    border-top: var(--border-accent);
  }

  .atelier-card__technique {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: 1.15rem;
    line-height: 1.15;
    color: var(--bone);
    margin: 0 0 var(--space-1);
  }

  .atelier-card__line {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-style: italic;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--fg-soft);
    margin: 0 0 var(--space-2);
  }

  .atelier-card__meta {
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    letter-spacing: var(--letter-spacing-ritual);
    text-transform: uppercase;
    color: var(--silver);
    margin: 0;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .atelier-card__ig-tag {
    color: var(--ember);
  }

  @media (max-width: 600px) {
    .atelier__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
