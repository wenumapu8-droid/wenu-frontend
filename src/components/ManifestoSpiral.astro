---
// ManifestoSpiral.astro — the DNA-helix cosmos journey (from a dream, 2026-07).
// Opening of /manifesto. Earth at the top; scrolling down travels out through
// the scales — atom · seed · cell · THE SOURCE · planets · sun · galaxy — and
// pours into a black hole at the bottom. Two strands: gold (organic/DNA) +
// cyan (cybernetic/informatic). Self-contained: inline SVG + inline script.
// Scroll reveals each station; honors prefers-reduced-motion.
---
<section id="manifesto-spiral" aria-labelledby="ms-lede">
  <p class="sr-only">
    A visual manifesto: a DNA double-helix descends from Earth at the top, out
    through scales — atom, seed, cell, the Source, planets, sun, galaxy — and
    pours into a black hole at the bottom. Gold and cyan strands, organic and
    cybernetic, on obsidian.
  </p>

  <div class="ms-intro">
    <p class="ms-eyebrow">THE SPIRAL · LA ESPIRAL</p>
    <p id="ms-lede" class="ms-lede">From the earth, out through the source, into the cosmos.</p>
    <span class="ms-hint" aria-hidden="true">scroll ↓</span>
  </div>

  <div id="ms-wrap">
    <svg id="ms-svg" viewBox="0 0 380 1560" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ms-lede" preserveAspectRatio="xMidYMid meet">
      <defs>
        <linearGradient id="ms-bg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#0b0a0c"/>
          <stop offset="50%" stop-color="#08080b"/>
          <stop offset="80%" stop-color="#0a0818"/>
          <stop offset="100%" stop-color="#0a0616"/>
        </linearGradient>
        <radialGradient id="ms-earthGlow" cx="50%" cy="0%" r="70%">
          <stop offset="0%" stop-color="#2b6f6a" stop-opacity="0.5"/>
          <stop offset="42%" stop-color="#1a4a52" stop-opacity="0.24"/>
          <stop offset="100%" stop-color="#07070c" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="ms-earthBody" cx="42%" cy="34%" r="75%">
          <stop offset="0%" stop-color="#3f8f8a"/>
          <stop offset="55%" stop-color="#1d5560"/>
          <stop offset="100%" stop-color="#0a2833"/>
        </radialGradient>
        <radialGradient id="ms-srcGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#fff6dd" stop-opacity="1"/>
          <stop offset="22%" stop-color="#f0d98a" stop-opacity="0.9"/>
          <stop offset="55%" stop-color="#c9a84c" stop-opacity="0.32"/>
          <stop offset="100%" stop-color="#c9a84c" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="ms-sunGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ffe6a6"/>
          <stop offset="45%" stop-color="#e8a13c" stop-opacity="0.8"/>
          <stop offset="100%" stop-color="#e8a13c" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="ms-holeDisk" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#000" stop-opacity="0"/>
          <stop offset="46%" stop-color="#000" stop-opacity="0"/>
          <stop offset="54%" stop-color="#ffd98a"/>
          <stop offset="64%" stop-color="#e06a2a" stop-opacity="0.85"/>
          <stop offset="82%" stop-color="#8a4be0" stop-opacity="0.5"/>
          <stop offset="100%" stop-color="#8a4be0" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="ms-holeCore" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#000"/>
          <stop offset="70%" stop-color="#050308"/>
          <stop offset="100%" stop-color="#0a0616" stop-opacity="0"/>
        </radialGradient>
        <filter id="ms-soft" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="3.2"/></filter>
        <filter id="ms-softer" x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="7"/></filter>
      </defs>

      <rect x="0" y="0" width="380" height="1560" fill="url(#ms-bg)"/>
      <rect x="0" y="0" width="380" height="520" fill="url(#ms-earthGlow)"/>
      <g id="ms-stars"></g>
      <g id="ms-holeAura"></g>
      <g id="ms-helix"></g>
      <g id="ms-rungs"></g>
      <g id="ms-stations"></g>
    </svg>
  </div>

  <p class="ms-close">The body is sacred territory. We adorn it with what fell from the sky.</p>
</section>

<style is:global>
  #manifesto-spiral{ background:#07070c; padding:0 0 var(--space-6); }
  #manifesto-spiral .sr-only{ position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); border:0; }
  #manifesto-spiral .ms-intro{ text-align:center; padding:var(--space-6) var(--space-4) var(--space-3); }
  #manifesto-spiral .ms-eyebrow{ color:var(--ember); font-family:var(--font-mono, monospace); font-size:0.72rem; letter-spacing:0.32em; }
  #manifesto-spiral .ms-lede{ color:var(--bone); font-family:var(--font-serif); font-style:italic; font-size:clamp(1.2rem,2.6vw,1.7rem); line-height:1.4; margin:var(--space-3) auto 0; max-width:24ch; }
  #manifesto-spiral .ms-hint{ display:inline-block; margin-top:var(--space-4); color:var(--sand); font-family:var(--font-mono,monospace); font-size:0.7rem; letter-spacing:0.28em; text-transform:uppercase; animation:ms-bob 2.4s ease-in-out infinite; }
  #manifesto-spiral #ms-wrap{ width:100%; max-width:560px; margin:0 auto; line-height:0; }
  #manifesto-spiral #ms-svg{ width:100%; height:auto; display:block; }
  #manifesto-spiral #ms-svg text{ font-family:'Georgia','Times New Roman',serif; }
  #manifesto-spiral .ms-en{ fill:var(--bone); font-size:15px; letter-spacing:.5px; }
  #manifesto-spiral .ms-es{ fill:var(--ember); font-size:10px; letter-spacing:2px; font-family:'Courier New',monospace; }
  #manifesto-spiral .ms-close{ text-align:center; color:var(--silver); font-family:var(--font-serif); font-style:italic; font-size:clamp(1.05rem,2vw,1.35rem); line-height:1.5; max-width:32ch; margin:var(--space-5) auto 0; padding:0 var(--space-4); }
  #manifesto-spiral .ms-reveal{ opacity:0; transition:opacity 1.1s ease; }
  #manifesto-spiral .ms-reveal.in{ opacity:1; }

  @keyframes ms-spin{ to{ transform:rotate(360deg); } }
  @keyframes ms-spinrev{ to{ transform:rotate(-360deg); } }
  @keyframes ms-pulse{ 0%,100%{ transform:scale(1); opacity:.9; } 50%{ transform:scale(1.08); opacity:1; } }
  @keyframes ms-tw{ 0%,100%{ opacity:.2; } 50%{ opacity:.95; } }
  @keyframes ms-flow{ to{ stroke-dashoffset:-1600; } }
  @keyframes ms-bob{ 0%,100%{ transform:translateY(0); opacity:.7; } 50%{ transform:translateY(5px); opacity:1; } }
  #manifesto-spiral .ms-slow{ animation:ms-spin 70s linear infinite; transform-box:fill-box; transform-origin:center; }
  #manifesto-spiral .ms-med{ animation:ms-spin 34s linear infinite; transform-box:fill-box; transform-origin:center; }
  #manifesto-spiral .ms-rev{ animation:ms-spinrev 46s linear infinite; transform-box:fill-box; transform-origin:center; }
  #manifesto-spiral .ms-pulse{ animation:ms-pulse 5.5s ease-in-out infinite; transform-box:fill-box; transform-origin:center; }
  #manifesto-spiral .ms-fl{ stroke-dasharray:5 34; animation:ms-flow 14s linear infinite; }

  @media (prefers-reduced-motion: reduce){
    #manifesto-spiral .ms-slow,#manifesto-spiral .ms-med,#manifesto-spiral .ms-rev,
    #manifesto-spiral .ms-pulse,#manifesto-spiral .ms-fl,#manifesto-spiral .ms-hint{ animation:none !important; }
    #manifesto-spiral .ms-reveal{ opacity:1; transition:none; }
  }
</style>

<script is:inline>
(function(){
  function build(){
    var NS="http://www.w3.org/2000/svg";
    if(!document.getElementById("ms-svg")) return;
    function el(n,a){var e=document.createElementNS(NS,n);if(a)for(var k in a)e.setAttribute(k,a[k]);return e;}
    function add(p,n,a){var e=el(n,a);document.getElementById(p).appendChild(e);return e;}

    var cx=190, yTop=150, yBot=1490, k=0.0225;
    // t=1 at Earth (top, wide), t=0 at the black hole (bottom, narrow funnel)
    function amp(y){ var t=(yBot-y)/(yBot-yTop); return 12+62*Math.pow(Math.max(0,t),0.72); }

    // stars
    for(var i=0;i<150;i++){
      var sx=((i*67)%372)+4, sy=((i*151)%1490)+30, r=(i%11===0)?1.6:(i%3===0?1.0:0.6);
      var s=el("circle",{cx:sx,cy:sy,r:r,fill:(i%9===0?"#f0d98a":"#f0ede8"),opacity:0.5});
      s.style.animation="ms-tw "+(2.2+((i*7)%40)/10)+"s ease-in-out infinite";
      s.style.animationDelay=(((i*13)%50)/10)+"s";
      document.getElementById("ms-stars").appendChild(s);
    }

    // helix strands
    var P1=[],P2=[],TH=[];
    for(var y=yTop;y<=yBot;y+=3){ var th=(y-yTop)*k, a=amp(y); P1.push([cx+a*Math.sin(th),y]); P2.push([cx-a*Math.sin(th),y]); TH.push(th); }
    function dstr(p){var s="M"+p[0][0].toFixed(1)+" "+p[0][1].toFixed(1);for(var i=1;i<p.length;i++)s+=" L"+p[i][0].toFixed(1)+" "+p[i][1].toFixed(1);return s;}
    var d1=dstr(P1), d2=dstr(P2);
    add("ms-helix","path",{d:d1,fill:"none",stroke:"#c9a84c","stroke-width":7,opacity:0.16,filter:"url(#ms-soft)"});
    add("ms-helix","path",{d:d2,fill:"none",stroke:"#64e0d0","stroke-width":7,opacity:0.14,filter:"url(#ms-soft)"});
    add("ms-helix","path",{d:d1,fill:"none",stroke:"#e8c766","stroke-width":2.2,opacity:0.92,"stroke-linecap":"round"});
    add("ms-helix","path",{d:d2,fill:"none",stroke:"#7fe9db","stroke-width":2.2,opacity:0.85,"stroke-linecap":"round"});
    var fA=add("ms-helix","path",{d:d1,fill:"none",stroke:"#fff6dd","stroke-width":2.6,opacity:0.9,"stroke-linecap":"round"}); fA.setAttribute("class","ms-fl");
    var fB=add("ms-helix","path",{d:d2,fill:"none",stroke:"#d7fff8","stroke-width":2.6,opacity:0.8,"stroke-linecap":"round"}); fB.setAttribute("class","ms-fl"); fB.style.animationDelay="-7s";

    // rungs
    for(var j=2;j<P1.length-2;j+=6){
      var depth=Math.abs(Math.sin(TH[j])), op=(0.16+0.42*depth).toFixed(2), a1=P1[j], b1=P2[j];
      add("ms-rungs","line",{x1:a1[0].toFixed(1),y1:a1[1].toFixed(1),x2:b1[0].toFixed(1),y2:b1[1].toFixed(1),stroke:"#f0ede8","stroke-width":(0.6+0.9*depth).toFixed(2),opacity:op});
      add("ms-rungs","circle",{cx:((a1[0]+b1[0])/2).toFixed(1),cy:((a1[1]+b1[1])/2).toFixed(1),r:(0.8+0.8*depth).toFixed(2),fill:"#c9a84c",opacity:op});
      add("ms-rungs","circle",{cx:a1[0].toFixed(1),cy:a1[1].toFixed(1),r:1.6,fill:"#f0d98a",opacity:0.9});
      add("ms-rungs","circle",{cx:b1[0].toFixed(1),cy:b1[1].toFixed(1),r:1.6,fill:"#9ff0e4",opacity:0.85});
    }

    var reveals=[];
    function station(y,builder,en,es,side){
      var wrap=el("g",{class:"ms-reveal"});
      var g=el("g",{transform:"translate("+cx+","+y+")"}); builder(g); wrap.appendChild(g);
      var lx=(side==="L")?cx-92:cx+92, anchor=(side==="L")?"start":"end";
      var t1=el("text",{x:lx,y:y-4,"text-anchor":anchor,"class":"ms-en"}); t1.textContent=en; wrap.appendChild(t1);
      var t2=el("text",{x:lx,y:y+15,"text-anchor":anchor,"class":"ms-es"}); t2.textContent=es; wrap.appendChild(t2);
      var cA=(side==="L")?cx-30:cx+30, cB=(side==="L")?cx-84:cx+84;
      wrap.appendChild(el("line",{x1:cA,y1:y,x2:cB,y2:y,stroke:"#c9a84c","stroke-width":0.6,opacity:0.4}));
      document.getElementById("ms-stations").appendChild(wrap); reveals.push(wrap);
    }

    // EARTH (top)
    station(190,function(g){
      g.appendChild(el("circle",{r:120,fill:"url(#ms-earthGlow)"}));
      g.appendChild(el("circle",{r:64,fill:"url(#ms-earthBody)"}));
      for(var jj=-2;jj<=2;jj++){ var w=Math.sqrt(Math.max(0,64*64-(jj*20)*(jj*20))); g.appendChild(el("path",{d:"M "+(-w)+" "+(jj*20)+" A 84 84 0 0 1 "+w+" "+(jj*20),fill:"none",stroke:"#8fd6cf","stroke-width":0.8,opacity:0.35})); }
      g.appendChild(el("circle",{r:64,fill:"none",stroke:"#bfeee7","stroke-width":1,opacity:0.5}));
    },"Earth","LA TIERRA","R");
    // ATOM
    station(360,function(g){
      var o=el("g"); o.setAttribute("class","ms-med");
      for(var a=0;a<3;a++) o.appendChild(el("ellipse",{rx:30,ry:11,fill:"none",stroke:"#7fe9db","stroke-width":1.1,opacity:0.8,transform:"rotate("+(a*60)+")"}));
      g.appendChild(o); g.appendChild(el("circle",{r:5,fill:"#fff6dd"})); g.appendChild(el("circle",{r:9,fill:"none",stroke:"#f0d98a","stroke-width":0.8,opacity:0.6}));
    },"Atom","EL ÁTOMO","L");
    // SEED
    station(510,function(g){
      g.appendChild(el("path",{d:"M0 -34 C 22 -12 22 12 0 34 C -22 12 -22 -12 0 -34 Z",fill:"none",stroke:"#e8c766","stroke-width":1.4,opacity:0.9}));
      g.appendChild(el("path",{d:"M0 -26 C 12 -8 12 10 0 26",fill:"none",stroke:"#9ff0e4","stroke-width":1,opacity:0.7}));
      g.appendChild(el("line",{x1:0,y1:-30,x2:0,y2:30,stroke:"#c9a84c","stroke-width":0.6,opacity:0.5}));
      g.appendChild(el("circle",{r:2.4,fill:"#fff6dd"}));
    },"Seed","LA SEMILLA","R");
    // CELL / DNA
    station(650,function(g){
      g.appendChild(el("circle",{r:34,fill:"none",stroke:"#7fe9db","stroke-width":1.2,opacity:0.6}));
      var m=el("g"); m.setAttribute("class","ms-slow");
      for(var t=-24;t<=24;t+=4){ var xx=14*Math.sin(t*0.32); m.appendChild(el("circle",{cx:xx.toFixed(1),cy:t,r:1.5,fill:"#f0d98a",opacity:0.9})); m.appendChild(el("circle",{cx:(-xx).toFixed(1),cy:t,r:1.5,fill:"#9ff0e4",opacity:0.85})); }
      g.appendChild(m); g.appendChild(el("circle",{r:6,fill:"#c9a84c",opacity:0.5}));
    },"Cell · DNA","LA CÉLULA","L");
    // THE SOURCE
    station(810,function(g){
      g.appendChild(el("circle",{r:120,fill:"url(#ms-srcGlow)",filter:"url(#ms-softer)"}));
      var rays=el("g"); rays.setAttribute("class","ms-slow");
      for(var r=0;r<24;r++) rays.appendChild(el("line",{x1:0,y1:0,x2:0,y2:-70,stroke:"#f0d98a","stroke-width":(r%2?0.6:1.4),opacity:0.55,transform:"rotate("+(r*15)+")"}));
      g.appendChild(rays);
      var ring=el("g"); ring.setAttribute("class","ms-rev");
      ring.appendChild(el("circle",{r:42,fill:"none",stroke:"#fff6dd","stroke-width":1,opacity:0.7}));
      for(var p=0;p<12;p++) ring.appendChild(el("circle",{cx:(42*Math.cos(p*Math.PI/6)).toFixed(1),cy:(42*Math.sin(p*Math.PI/6)).toFixed(1),r:2,fill:"#fff6dd",opacity:0.9}));
      g.appendChild(ring); g.appendChild(el("circle",{r:26,fill:"none",stroke:"#c9a84c","stroke-width":1.2,opacity:0.8}));
      var core=el("circle",{r:13,fill:"#fff6dd"}); core.setAttribute("class","ms-pulse"); g.appendChild(core); g.appendChild(el("circle",{r:5,fill:"#c9a84c"}));
    },"The Source","LA FUENTE","R");
    // PLANETS
    station(970,function(g){
      var arc=[[-46,6,7,"#8fa9d6"],[-16,-8,5,"#d6a36a"],[16,7,9,"#c98a5a"],[48,-4,6,"#9fd6c9"]];
      g.appendChild(el("path",{d:"M -60 10 Q 0 -22 60 6",fill:"none",stroke:"#c9a84c","stroke-width":0.6,opacity:0.35}));
      arc.forEach(function(p){ g.appendChild(el("circle",{cx:p[0],cy:p[1],r:p[2],fill:p[3],opacity:0.92})); g.appendChild(el("circle",{cx:p[0],cy:p[1],r:p[2]+2,fill:"none",stroke:"#f0ede8","stroke-width":0.4,opacity:0.4})); });
    },"Planets","LOS PLANETAS","L");
    // SUN
    station(1130,function(g){
      g.appendChild(el("circle",{r:70,fill:"url(#ms-sunGlow)",filter:"url(#ms-soft)"}));
      var cor=el("g"); cor.setAttribute("class","ms-med");
      for(var s=0;s<20;s++) cor.appendChild(el("line",{x1:0,y1:-26,x2:0,y2:-40,stroke:"#ffe6a6","stroke-width":1.4,opacity:0.7,transform:"rotate("+(s*18)+")"}));
      g.appendChild(cor); g.appendChild(el("circle",{r:24,fill:"#ffdf9a"})); g.appendChild(el("circle",{r:24,fill:"none",stroke:"#fff6dd","stroke-width":1,opacity:0.8}));
    },"Sun","EL SOL","R");
    // GALAXY
    station(1300,function(g){
      var sp=el("g"); sp.setAttribute("class","ms-slow");
      for(var arm=0;arm<2;arm++) for(var t=0;t<40;t++){ var ang=t*0.32+arm*Math.PI, rr=2+t*1.15; sp.appendChild(el("circle",{cx:(rr*Math.cos(ang)).toFixed(1),cy:(rr*Math.sin(ang)*0.5).toFixed(1),r:(t<6?1.8:1.1),fill:(t%5===0?"#f0d98a":"#bcd0f0"),opacity:(0.9-t*0.014).toFixed(2)})); }
      g.appendChild(sp); g.appendChild(el("circle",{r:6,fill:"#fff6dd"}));
    },"Galaxy","LA GALAXIA","L");
    // BLACK HOLE (bottom)
    document.getElementById("ms-holeAura").appendChild(el("circle",{cx:cx,cy:1470,r:150,fill:"url(#ms-holeDisk)",opacity:0.55,filter:"url(#ms-softer)"}));
    station(1470,function(g){
      var disk=el("g"); disk.setAttribute("class","ms-med");
      disk.appendChild(el("ellipse",{rx:96,ry:26,fill:"none",stroke:"url(#ms-holeDisk)","stroke-width":18,opacity:0.9}));
      disk.appendChild(el("ellipse",{rx:70,ry:18,fill:"none",stroke:"#ffd98a","stroke-width":2,opacity:0.7}));
      g.appendChild(disk);
      g.appendChild(el("circle",{r:44,fill:"url(#ms-holeDisk)"}));
      g.appendChild(el("circle",{r:34,fill:"url(#ms-holeCore)"}));
      g.appendChild(el("circle",{r:30,fill:"#000"}));
      g.appendChild(el("circle",{r:31,fill:"none",stroke:"#ffe6a6","stroke-width":1.6,opacity:0.95}));
    },"Black Hole","EL AGUJERO NEGRO","R");

    // scroll reveal
    function onScroll(){
      var vh=window.innerHeight||800;
      for(var i=0;i<reveals.length;i++){
        var w=reveals[i]; if(w.classList.contains("in")) continue;
        var r=w.getBoundingClientRect();
        if(r.top < vh*0.85 && r.bottom > 0) w.classList.add("in");
      }
    }
    var ticking=false;
    window.addEventListener("scroll",function(){ if(!ticking){ ticking=true; requestAnimationFrame(function(){ onScroll(); ticking=false; }); } },{passive:true});
    window.addEventListener("resize",onScroll,{passive:true});
    onScroll();
  }
  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",build);
  else build();
})();
</script>
