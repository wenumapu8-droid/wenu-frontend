---
/** KODEX−∞ · PROLOGUE · observation eye organism.
 * Reference-driven port of the measured Golden Scene eye. The organism consumes
 * the observation state; it does not own navigation or personal meaning.
 */
interface Props { class?: string }
const { class: className } = Astro.props;
---
<canvas class:list={["kdx-ojo", className]} data-kdx-organismo-ojo aria-hidden="true"></canvas>
<style>
  .kdx-ojo { position:absolute; inset:0; width:100%; height:100%; display:block; }
</style>
<style is:global>
  /* Native PROLOGUE is a world, not a poster inserted into the legacy plate.
     Keep the existing route/state/runtime, but let the native observation
     organism own the viewport and subordinate duplicated cockpit chrome. */
  .kx-os-scene--prologue:has([data-kdx-observacion]),
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-deck,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-slide,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage {
    width:100vw !important;
    min-width:100vw !important;
    height:100dvh !important;
    min-height:100dvh !important;
    max-height:100dvh !important;
    overflow:hidden !important;
  }
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage {
    position:fixed !important;
    inset:0 !important;
    display:block !important;
    transform:none !important;
  }
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage__art {
    position:fixed !important;
    inset:0 !important;
    z-index:20 !important;
    width:100vw !important;
    height:100dvh !important;
    max-width:none !important;
    max-height:none !important;
    margin:0 !important;
    border:0 !important;
    background:transparent !important;
    box-shadow:none !important;
    overflow:visible !important;
    transform:none !important;
  }
  .kx-os-scene--prologue:has([data-kdx-observacion]) [data-kdx-observacion] {
    position:fixed !important;
    inset:0 !important;
    width:100vw !important;
    height:100dvh !important;
    max-width:none !important;
    max-height:none !important;
    transform:none !important;
  }
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage__copy,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage__field,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage__livefield,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage__eje,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage__tira,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage__strip,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-registration,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage__rail-top,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage__ascii,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage__crt,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage__crt-source,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-barcode,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage__art > .kx-corner,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-os-stage__art > figcaption,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-astro,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-timeline,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-deckbar,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-readout,
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-status__keys {
    display:none !important;
  }
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-status {
    z-index:40 !important;
    border:0 !important;
    background:transparent !important;
    pointer-events:none !important;
  }
  .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-word {
    opacity:.58;
    pointer-events:auto !important;
  }
  @media(max-width:899px){
    .kx-os-scene--prologue:has([data-kdx-observacion]) .kx-word{opacity:.44}
  }
</style>
<script>
  const cv = document.querySelector<HTMLCanvasElement>('[data-kdx-organismo-ojo]');
  const raiz = cv?.closest<HTMLElement>('[data-kdx-observacion]');
  if (cv && raiz) {
    const ctx = cv.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let W=1,H=1,dpr=1,t=0;
    const perfil: Array<[number,number]> = [[0,0],[9,.04],[23,.08],[33,.83],[44,.55],[56,.21],[67,.40],[72,1],[77,.72],[96,.44],[120,.20],[135,.075],[143,.30],[159,.26],[168,.30],[189,.24],[214,.22],[225,.20],[245,.09],[300,.07],[360,.045]];
    const lum=(r:number)=>{ for(let i=1;i<perfil.length;i++){ if(r<=perfil[i][0]){const [r0,v0]=perfil[i-1], [r1,v1]=perfil[i]; const q=(r-r0)/(r1-r0||1); return v0+(v1-v0)*q;}} return 0; };
    const seed=(i:number)=>{const x=Math.sin(i*12.9898+78.233)*43758.5453; return x-Math.floor(x);};
    const fil=Array.from({length:34},(_,i)=>{const l=seed(i+100),w=seed(i+200);return{ang:(i/34)*Math.PI*2+(seed(i)-.5)*(Math.PI/34),largo:.16+l*l*l*.84,peso:.12+w*w*.88,fase:seed(i+300)*Math.PI*2};});
    const crestas=[143,159,168,189,214,225];
    const chroma:Record<string,[number,number,number]>={DORMANT:[120,96,150],IDLE:[138,112,168],AWARE:[176,108,255],LOCK:[186,96,255],TRACK:[96,226,255],INSPECT:[168,120,240],DESCEND:[214,168,255]};
    const stateReach:Record<string,number>={DORMANT:96,IDLE:108,AWARE:178,LOCK:300,TRACK:338,INSPECT:318,DESCEND:360};
    let color:[number,number,number]=[120,96,150];
    let est={estado:'DORMANT',presencia:0,foco:0,objetivo:{x:0,y:0},energia:0,locks:0};
    raiz.addEventListener('kdx:pulso',(e)=>{est=(e as CustomEvent).detail;});
    const resize=()=>{const r=cv.getBoundingClientRect(); dpr=Math.min(2,devicePixelRatio||1); W=Math.max(1,Math.round(r.width));H=Math.max(1,Math.round(r.height));cv.width=W*dpr;cv.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);};
    resize(); addEventListener('resize',resize,{passive:true}); if('ResizeObserver'in window)new ResizeObserver(resize).observe(cv);
    const draw=()=>{
      if(!reduce.matches)t++;
      ctx.clearRect(0,0,W,H); ctx.globalCompositeOperation='lighter';
      const R=Math.min(W,H)*.46, k=R/360;
      const follow=est.foco*.16, cx=W/2+est.objetivo.x*R*follow, cy=H/2+est.objetivo.y*R*follow;
      const target=chroma[est.estado]||chroma.DORMANT; for(let i=0;i<3;i++)color[i]+=(target[i]-color[i])*.07;
      const C=`${Math.round(color[0])},${Math.round(color[1])},${Math.round(color[2])}`;
      const vigor=.06+est.presencia*.94;
      // The governed Observation Eye is the PROLOGUE organism, not a cursor-sized
      // decoration. Presence still grows the field continuously, while semantic
      // states establish a minimum visible reach so LOCK/TRACK/INSPECT have an
      // immediate organism-scale consequence even before the eased presence
      // accumulator catches up.
      const alcance=Math.max(stateReach[est.estado]||96,96+(360-96)*Math.min(1,est.presencia*1.15));
      // Central masses + measured data-ring crests. Outside the core, arcs are
      // intentionally broken so the field keeps the angular voids of the plate.
      for(let r=7;r<=Math.min(245,alcance);r+=1.8){
        const crest=crestas.some(c=>Math.abs(r-c)<2.5); if(r>=136&&!crest)continue;
        let a=lum(r); if(r>=68&&r<=77)a*=.45+vigor*.9; if(r>77)a*=.38+vigor*.62; if(a<.008)continue;
        const rr=r*k; ctx.lineWidth=Math.max(.45,k*(r<78?1.25:.7)); ctx.strokeStyle=`rgba(${C},${Math.min(.72,a*.42)})`; ctx.beginPath();
        if(r<136){ctx.arc(cx,cy,rr,0,Math.PI*2);}else{const cut=seed(Math.round(r)*13)*Math.PI*2,span=.65+seed(Math.round(r)*17)*1.75;ctx.arc(cx,cy,rr,cut,cut+span);ctx.arc(cx,cy,rr,cut+Math.PI,cut+Math.PI+span*.55);}ctx.stroke();
      }
      // Filaments are sparse, deterministic and unequal. State opens their
      // reach; TRACK subtly bends/brightens toward the current target.
      for(let i=0;i<fil.length;i++){
        const f=fil[i], reach=Math.min(alcance/360,f.largo), inner=.19, outer=Math.max(inner+.02,reach); if(outer<=inner+.021)continue;
        const wobble=reduce.matches?0:Math.sin(t*.012+f.fase)*.012*(1-est.foco*.65); const ang=f.ang+wobble;
        const x0=cx+Math.cos(ang)*R*inner,y0=cy+Math.sin(ang)*R*inner,x1=cx+Math.cos(ang)*R*outer,y1=cy+Math.sin(ang)*R*outer;
        ctx.strokeStyle=`rgba(${C},${(.055+.22*f.peso)*(.28+vigor*.72)})`;ctx.lineWidth=.45+1.15*f.peso;ctx.beginPath();ctx.moveTo(x0,y0);ctx.lineTo(x1,y1);ctx.stroke();
      }
      // Pupil / limbus. Focus contracts the aperture; this is visible causality.
      const pupil=(22-est.foco*11)*k; ctx.globalCompositeOperation='source-over';ctx.fillStyle='rgba(2,1,6,.96)';ctx.beginPath();ctx.arc(cx,cy,pupil,0,Math.PI*2);ctx.fill();
      ctx.strokeStyle=`rgba(${C},${.22+.46*vigor})`;ctx.lineWidth=1.1;ctx.beginPath();ctx.arc(cx,cy,72*k,0,Math.PI*2);ctx.stroke();
      requestAnimationFrame(draw);
    }; requestAnimationFrame(draw);
  }
</script>