---
/** KODEX−∞ · PROLOGUE · native Golden Scene.
 * Desktop is spatial/simultaneous; mobile is temporal/progressive. The governed
 * Observation Eye board is a specification, never a pixel skin.
 */
import OjoDeObservacion from './OjoDeObservacion.astro';
---
<section class="kx-prologue" data-kdx-observacion data-kdx-type="PROLOGUE / DORMANT" tabindex="0" role="application" aria-label="Prologue observation field. Move or touch to wake the system; hold or press Enter to lock; descend through the pupil after lock.">
  <div class="kx-prologue__campo"><OjoDeObservacion/><canvas class="kx-prologue__senal" data-kdx-senal aria-hidden="true"></canvas></div>
  <div class="kx-prologue__type" aria-live="polite"><span>KDX.TYPE</span><b data-kdx-type-label>PROLOGUE / DORMANT</b></div>
  <h1 class="kx-prologue__titulo"><span>01 · SCAN PROTOCOL</span><strong>{'OBSERVATION'.split('').map((c,i)=><b style={`--i:${i}`}>{c}</b>)}<i></i>{'EYE'.split('').map((c,i)=><b style={`--i:${i+11}`}>{c}</b>)}</strong></h1>
  <output class="kx-prologue__estado" data-kdx-estado>DORMANT</output>
  <ul class="kx-prologue__fragmentos" aria-hidden="true"><li>HALFTONE</li><li>NEON ENERGY</li><li>PIXEL SORT</li><li>GLITCH MAP</li><li>SCANLINE</li><li>BITMAP NOISE</li></ul>
  <canvas class="kx-prologue__wave" data-kdx-wave aria-hidden="true"></canvas>
  <button class="kx-prologue__puerta" data-kdx-puerta type="button" aria-label="Descend"><span>DESCEND</span></button>
  <button class="kx-prologue__inspect" data-kdx-inspector-btn type="button" aria-expanded="false">◎ INSPECT SIGNAL</button>
  <aside class="kx-prologue__inspector" data-kdx-inspector hidden>
    <dl><div><dt>AZIMUTH</dt><dd data-kdx-az>180.00°</dd></div><div><dt>ELEVATION</dt><dd data-kdx-el>+00.00°</dd></div><div><dt>SIGNAL STR</dt><dd data-kdx-str>0%</dd></div><div><dt>SYNC</dt><dd data-kdx-sync>UNLOCKED</dd></div><div><dt>LOCKS</dt><dd data-kdx-locks>0</dd></div></dl>
    <p>VALUES ARE LOCAL INPUT DIAGNOSTICS · NO BIOMETRIC CLAIM</p>
  </aside>
  <div class="kx-prologue__descenso" data-kdx-descenso aria-hidden="true"></div>
</section>
<style>
  .kx-prologue{position:fixed;inset:0;z-index:1;width:100vw;height:100dvh;overflow:hidden;background:#05040a;--acento:#b27cff;touch-action:none;outline:none;color:#efe9ff}
  .kx-prologue:focus-visible{box-shadow:inset 0 0 0 2px var(--acento)}
  .kx-prologue__campo{position:absolute;inset:0}.kx-prologue__senal{position:absolute;inset:0;width:100%;height:100%;opacity:.18;pointer-events:none}
  .kx-prologue__type{position:absolute;top:max(4.4rem,calc(env(safe-area-inset-top) + 3.8rem));left:4vw;z-index:4;display:flex;gap:.8rem;font:500 10px/1 ui-monospace,monospace;letter-spacing:.16em;color:#827991}.kx-prologue__type b{color:var(--acento);font-weight:500}
  .kx-prologue__titulo{position:absolute;z-index:3;left:4vw;bottom:14vh;margin:0;pointer-events:none}.kx-prologue__titulo>span{display:block;margin-bottom:.65rem;font:500 10px/1 ui-monospace,monospace;letter-spacing:.34em;color:color-mix(in srgb,var(--acento) 70%,#fff);opacity:.15;transition:.45s}.kx-prologue__titulo strong{display:flex;flex-wrap:wrap;max-width:48vw;font:700 clamp(2rem,4.4vw,3.7rem)/.98 "Instrument Sans",system-ui,sans-serif}.kx-prologue__titulo strong i{width:.5em}.kx-prologue__titulo strong b{font-weight:inherit;opacity:.13;filter:blur(6px);transform:translateY(calc(var(--i)*.5px - 7px)) scale(.95);transition:opacity .5s,filter .5s,transform .5s;transition-delay:calc(var(--i)*22ms)}
  .kx-prologue[data-kdx-obs="AWARE"] .kx-prologue__titulo>span,.kx-prologue[data-kdx-obs="LOCK"] .kx-prologue__titulo>span,.kx-prologue[data-kdx-obs="TRACK"] .kx-prologue__titulo>span{opacity:1}.kx-prologue[data-kdx-obs="AWARE"] .kx-prologue__titulo strong b{opacity:.62;filter:blur(2px);transform:none}.kx-prologue[data-kdx-obs="LOCK"] .kx-prologue__titulo strong b,.kx-prologue[data-kdx-obs="TRACK"] .kx-prologue__titulo strong b{opacity:1;filter:none;transform:none}.kx-prologue[data-kdx-obs="TRACK"] .kx-prologue__titulo strong{letter-spacing:calc(.01em + var(--kx-track,0)*.015em)}.kx-prologue[data-kdx-obs="INSPECT"] .kx-prologue__titulo{opacity:.42}.kx-prologue[data-kdx-obs="DESCEND"] .kx-prologue__titulo{opacity:0;transform:scale(1.08);transition:.45s}
  .kx-prologue__estado{position:absolute;left:4vw;bottom:9.5vh;z-index:3;font:500 10px/1 ui-monospace,monospace;letter-spacing:.3em;color:var(--acento);opacity:.45}.kx-prologue[data-kdx-obs="LOCK"] .kx-prologue__estado,.kx-prologue[data-kdx-obs="TRACK"] .kx-prologue__estado{opacity:1}
  .kx-prologue__fragmentos{position:absolute;inset:0;z-index:2;list-style:none;margin:0;padding:0;pointer-events:none}.kx-prologue__fragmentos li{position:absolute;padding:.28rem .5rem;border:1px solid rgba(178,124,255,.28);background:rgba(5,4,10,.65);font:500 8px/1 ui-monospace,monospace;letter-spacing:.18em;color:#d6c1ff;opacity:0;transform:scale(.9);transition:.35s}.kx-prologue__fragmentos li:nth-child(1){top:18%;left:8%}.kx-prologue__fragmentos li:nth-child(2){top:27%;right:8%}.kx-prologue__fragmentos li:nth-child(3){top:56%;left:7%}.kx-prologue__fragmentos li:nth-child(4){top:64%;right:9%}.kx-prologue__fragmentos li:nth-child(5){top:39%;left:11%}.kx-prologue__fragmentos li:nth-child(6){top:47%;right:11%}.kx-prologue[data-kdx-obs="LOCK"] .kx-prologue__fragmentos li,.kx-prologue[data-kdx-obs="TRACK"] .kx-prologue__fragmentos li,.kx-prologue[data-kdx-obs="INSPECT"] .kx-prologue__fragmentos li{opacity:1;transform:none}
  .kx-prologue__wave{position:absolute;left:0;right:0;bottom:3vh;width:100%;height:80px;z-index:2;opacity:.25}.kx-prologue[data-kdx-obs="AWARE"] .kx-prologue__wave{opacity:.55}.kx-prologue[data-kdx-obs="LOCK"] .kx-prologue__wave,.kx-prologue[data-kdx-obs="TRACK"] .kx-prologue__wave{opacity:.9}
  .kx-prologue__inspect{position:absolute;right:4vw;bottom:14vh;z-index:5;min-height:44px;padding:0 1rem;border:1px solid rgba(178,124,255,.35);border-radius:999px;background:rgba(5,4,10,.72);color:#cdb4ff;font:500 10px/1 ui-monospace,monospace;letter-spacing:.16em;cursor:pointer}.kx-prologue__inspect:focus-visible,.kx-prologue__puerta:focus-visible{outline:2px solid var(--acento);outline-offset:3px}
  .kx-prologue__inspector{position:absolute;right:4vw;bottom:21vh;z-index:6;width:min(90vw,420px);padding:.85rem 1rem;border:1px solid rgba(178,124,255,.3);background:rgba(5,4,10,.94);font:500 9px/1.5 ui-monospace,monospace}.kx-prologue__inspector dl{margin:0;display:grid;gap:.25rem}.kx-prologue__inspector dl>div{display:flex;justify-content:space-between}.kx-prologue__inspector dt{color:#80758f}.kx-prologue__inspector dd{margin:0;color:#d7c4ff}.kx-prologue__inspector p{margin:.7rem 0 0;color:#70657f;font-size:8px;letter-spacing:.12em}
  .kx-prologue__puerta{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:7;width:clamp(92px,16vmin,150px);height:clamp(92px,16vmin,150px);border-radius:50%;border:1px solid transparent;background:transparent;color:#e4d5ff;font:500 9px/1 ui-monospace,monospace;letter-spacing:.25em;opacity:0;pointer-events:none;cursor:pointer;transition:.35s}.kx-prologue[data-kdx-abierto] .kx-prologue__puerta,.kx-prologue[data-kdx-obs="LOCK"] .kx-prologue__puerta,.kx-prologue[data-kdx-obs="TRACK"] .kx-prologue__puerta,.kx-prologue[data-kdx-obs="INSPECT"] .kx-prologue__puerta{opacity:1;pointer-events:auto;border-color:rgba(178,124,255,.45)}
  .kx-prologue__descenso{position:fixed;left:50%;top:50%;width:12px;height:12px;margin:-6px;border-radius:50%;background:#05040a;box-shadow:0 0 0 1px rgba(178,124,255,.85),0 0 60px 12px rgba(178,124,255,.35);transform:scale(0);opacity:0;pointer-events:none;z-index:9}.kx-prologue[data-kdx-descendiendo] .kx-prologue__descenso{opacity:1;transform:scale(320);transition:transform .72s cubic-bezier(.62,.02,.86,.4),opacity .1s}
  @media(max-width:899px){.kx-prologue__type{left:5vw}.kx-prologue__titulo{left:6vw;right:6vw;bottom:19vh}.kx-prologue__titulo strong{max-width:100%;font-size:clamp(1.55rem,8.6vw,2.7rem)}.kx-prologue__estado{left:6vw;bottom:14.5vh}.kx-prologue__inspect{right:5vw;bottom:8vh}.kx-prologue__inspector{right:5vw;bottom:15vh}.kx-prologue__fragmentos li{font-size:7px}.kx-prologue__fragmentos li:nth-child(1){top:14%;left:5%}.kx-prologue__fragmentos li:nth-child(2){top:22%;right:4%}.kx-prologue__fragmentos li:nth-child(3){top:39%;left:4%}.kx-prologue__fragmentos li:nth-child(4){top:48%;right:4%}.kx-prologue__fragmentos li:nth-child(5){top:31%;left:7%}.kx-prologue__fragmentos li:nth-child(6){top:56%;right:6%}.kx-prologue__wave{bottom:15vh;height:58px}}
  @media(prefers-reduced-motion:reduce){.kx-prologue *{transition-duration:1ms!important}.kx-prologue[data-kdx-descendiendo] .kx-prologue__descenso{transform:scale(320);transition:opacity .15s!important}}
</style>
<script>
  import { crearObservacion } from '../../../lib/kodex/prologue/observacion';
  import { record } from '../../../kodex/return/memory.js';
  const raiz=document.querySelector<HTMLElement>('[data-kdx-observacion]');
  if(raiz){
    const obs=crearObservacion(raiz); const estado=raiz.querySelector<HTMLElement>('[data-kdx-estado]'), type=raiz.querySelector<HTMLElement>('[data-kdx-type-label]'), az=raiz.querySelector<HTMLElement>('[data-kdx-az]'), el=raiz.querySelector<HTMLElement>('[data-kdx-el]'), str=raiz.querySelector<HTMLElement>('[data-kdx-str]'), sync=raiz.querySelector<HTMLElement>('[data-kdx-sync]'), locks=raiz.querySelector<HTMLElement>('[data-kdx-locks]');
    const wave=raiz.querySelector<HTMLCanvasElement>('[data-kdx-wave]'), wctx=wave?.getContext('2d')||null;
    const drawWave=(p:any)=>{if(!wave||!wctx)return;const r=wave.getBoundingClientRect(),d=Math.min(2,devicePixelRatio||1);wave.width=Math.max(1,Math.round(r.width*d));wave.height=Math.max(1,Math.round(r.height*d));wctx.setTransform(d,0,0,d,0,0);wctx.clearRect(0,0,r.width,r.height);wctx.strokeStyle=p.estado==='TRACK'?'rgba(96,226,255,.72)':'rgba(178,124,255,.58)';wctx.lineWidth=1;wctx.beginPath();for(let x=0;x<=r.width;x+=4){const q=x/r.width,amp=(5+p.energia*20)*(p.estado==='LOCK'?.38:1),y=r.height/2+Math.sin(q*42+p.objetivo.x*5)*amp+Math.sin(q*119)*amp*.2;x? wctx.lineTo(x,y):wctx.moveTo(x,y)}wctx.stroke();};
    obs.escuchar((p)=>{estado&&(estado.textContent=p.estado);type&&(type.textContent=`PROLOGUE / ${p.estado}`);raiz.dataset.kdxType=`PROLOGUE / ${p.estado}`;raiz.style.setProperty('--kx-track',String(p.energia));az&&(az.textContent=`${(180+p.objetivo.x*180).toFixed(2)}°`);el&&(el.textContent=`${p.objetivo.y>=0?'+':''}${(p.objetivo.y*90).toFixed(2)}°`);str&&(str.textContent=`${Math.round(p.presencia*100)}%`);sync&&(sync.textContent=['LOCK','TRACK','INSPECT','DESCEND'].includes(p.estado)?'LOCKED':'UNLOCKED');locks&&(locks.textContent=String(p.locks));drawWave(p);});
    const btn=raiz.querySelector<HTMLButtonElement>('[data-kdx-inspector-btn]'),panel=raiz.querySelector<HTMLElement>('[data-kdx-inspector]');btn?.addEventListener('click',(e)=>{e.stopPropagation();const opening=panel?.hasAttribute('hidden');if(opening){obs.inspeccionar();panel?.removeAttribute('hidden')}else{obs.cerrarInspeccion();panel?.setAttribute('hidden','')}btn.setAttribute('aria-expanded',String(!!opening));btn.textContent=opening?'◎ HIDE SIGNAL':'◎ INSPECT SIGNAL'});
    const puerta=raiz.querySelector<HTMLButtonElement>('[data-kdx-puerta]');puerta?.addEventListener('click',(e)=>{e.preventDefault();e.stopPropagation();const host=document.querySelector<HTMLElement>('[data-next-url]');const destino=host?.dataset.nextUrl||'/kodex/folio/ii/';obs.descender();raiz.setAttribute('data-kdx-descendiendo','');try{record({type:'view',work:location.pathname});record({type:'effect',effect:'prologue:descend'})}catch{}setTimeout(()=>{location.href=destino},matchMedia('(prefers-reduced-motion: reduce)').matches?170:690)});
  }
</script>
