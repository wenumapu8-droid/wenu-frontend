---
// KODEX−∞ · COMMISSION A SYSTEM overlay (§7).
// Palanca de dinero #1 de KODEX. Copy autoritativo del brief:
// "Work with KODEX to build bespoke generative systems …"
// V1: envío por `mailto:` a marimari@ con subject/body pre-armado.
// Upgrade planeado: POST a `${PUBLIC_API_URL}/kodex/commission` cuando el
// backend (wenu-platform) exponga el handler.
---
<aside class="kdx-commission" data-kdx-commission hidden aria-hidden="true"
  aria-modal="true" role="dialog" aria-labelledby="kdx-commission-title">
  <div class="kdx-commission__inner">
    <header class="kdx-commission__head">
      <span class="kdx-commission__eyebrow">◆ KODEX · COMMISSION</span>
      <h2 class="kdx-commission__title" id="kdx-commission-title">Commission a System</h2>
      <button class="kdx-commission__close" data-kdx-commission-close type="button" aria-label="close">CLOSE ✕</button>
    </header>

    <p class="kdx-commission__lede">
      Work with KODEX to build bespoke generative systems — visual identities,
      art direction, music &amp; festival visuals, immersive microsites, WebAR
      and interactive experiences.
    </p>
    <p class="kdx-commission__attrib">
      Conceived and art-directed by Ocin / Wenu Mapu.
    </p>

    <form class="kdx-commission__form" data-kdx-commission-form novalidate>
      <div class="kdx-field">
        <label for="kdx-c-type">Project type</label>
        <select id="kdx-c-type" name="type" required>
          <option value="">— select —</option>
          <option>Visual identity / brand system</option>
          <option>Art direction · campaign</option>
          <option>Music / festival visuals</option>
          <option>Immersive microsite</option>
          <option>WebAR / interactive experience</option>
          <option>Generative system (bespoke)</option>
          <option>Other · describe below</option>
        </select>
      </div>

      <div class="kdx-field">
        <label for="kdx-c-industry">Industry</label>
        <input id="kdx-c-industry" name="industry" type="text" placeholder="music, fashion, gallery, brand…" />
      </div>

      <div class="kdx-field kdx-field--wide">
        <label for="kdx-c-goal">Objective</label>
        <textarea id="kdx-c-goal" name="goal" rows="3" required placeholder="What should this system do, feel, or unlock?"></textarea>
      </div>

      <div class="kdx-field">
        <label for="kdx-c-budget">Budget (USD)</label>
        <select id="kdx-c-budget" name="budget">
          <option value="">— select —</option>
          <option>&lt; 3,000</option>
          <option>3,000 – 8,000</option>
          <option>8,000 – 20,000</option>
          <option>20,000 – 50,000</option>
          <option>&gt; 50,000</option>
          <option>Not sure yet</option>
        </select>
      </div>

      <div class="kdx-field">
        <label for="kdx-c-timeline">Timeline</label>
        <select id="kdx-c-timeline" name="timeline">
          <option value="">— select —</option>
          <option>ASAP (&lt; 2 weeks)</option>
          <option>1 – 4 weeks</option>
          <option>1 – 3 months</option>
          <option>3 – 6 months</option>
          <option>Flexible</option>
        </select>
      </div>

      <div class="kdx-field">
        <label>Use</label>
        <div class="kdx-radios">
          <label><input type="radio" name="use" value="commercial" checked /> Commercial</label>
          <label><input type="radio" name="use" value="artistic" /> Artistic</label>
          <label><input type="radio" name="use" value="both" /> Both</label>
        </div>
      </div>

      <div class="kdx-field">
        <label for="kdx-c-name">Your name</label>
        <input id="kdx-c-name" name="name" type="text" required />
      </div>

      <div class="kdx-field">
        <label for="kdx-c-email">Email</label>
        <input id="kdx-c-email" name="email" type="email" required />
      </div>

      <div class="kdx-field kdx-field--wide">
        <label for="kdx-c-refs">References (links, optional)</label>
        <textarea id="kdx-c-refs" name="refs" rows="2" placeholder="urls of references, mood, prior work…"></textarea>
      </div>

      <button type="submit" class="kdx-commission__submit">REQUEST A SYSTEM →</button>

      <p class="kdx-commission__note" data-kdx-commission-note hidden></p>
    </form>
  </div>
</aside>

<style is:global>
  .kdx-commission{
    position:fixed; inset:0; z-index:181;
    background:rgba(10,10,10,.975); backdrop-filter:blur(14px);
    display:grid; place-items:start center;
    opacity:0; pointer-events:none; transition:opacity .28s ease;
    overflow-y:auto; padding:clamp(24px,5vh,52px) clamp(16px,4vw,48px);
    color:var(--kdx-dust-white,#EDEDED);
    font-family:'Inter Tight','Instrument Sans',system-ui,sans-serif;
  }
  .kdx-commission[hidden]{ display:none; }
  .kdx-commission[data-open]{ opacity:1; pointer-events:auto; }
  .kdx-commission__inner{ width:min(720px, 100%); }
  .kdx-commission__head{ display:flex; align-items:baseline; gap:14px; flex-wrap:wrap;
    padding-bottom:clamp(14px,2.4vh,22px); border-bottom:1px solid var(--kdx-line,rgba(237,237,237,.15)); }
  .kdx-commission__eyebrow{ font-family:'IBM Plex Mono',ui-monospace,monospace; font-size:11px; letter-spacing:.24em; color:var(--kdx-acid,#B7FF00); }
  .kdx-commission__title{ font-family:'Archivo','Inter Tight',system-ui,sans-serif; font-stretch:125%; font-weight:700;
    letter-spacing:.02em; text-transform:uppercase; font-size:clamp(1.4rem,3.5vw,2.1rem); margin:0 auto 0 4px; }
  .kdx-commission__close{ font-family:'IBM Plex Mono',ui-monospace,monospace; font-size:11px; letter-spacing:.2em;
    background:transparent; border:1px solid var(--kdx-line,rgba(237,237,237,.15)); color:var(--kdx-muted,#88888A);
    padding:6px 12px; cursor:pointer; transition:color .2s,border-color .2s; }
  .kdx-commission__close:hover, .kdx-commission__close:focus-visible{ color:var(--kdx-dust-white,#EDEDED); border-color:var(--kdx-dust-white,#EDEDED); outline:none; }

  .kdx-commission__lede{ font-size:15px; line-height:1.6; color:var(--kdx-dust-white,#EDEDED); margin:22px 0 6px; max-width:60ch; }
  .kdx-commission__attrib{ font-family:'IBM Plex Mono',ui-monospace,monospace; font-size:11px; letter-spacing:.16em; color:var(--kdx-muted,#88888A); margin:0 0 24px; }

  .kdx-commission__form{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .kdx-field{ display:flex; flex-direction:column; gap:6px; min-width:0; }
  .kdx-field--wide{ grid-column:1 / -1; }
  .kdx-field label{ font-family:'IBM Plex Mono',ui-monospace,monospace; font-size:10.5px; letter-spacing:.2em;
    text-transform:uppercase; color:var(--kdx-muted,#88888A); }
  .kdx-field input, .kdx-field select, .kdx-field textarea{
    font-family:'Inter Tight',system-ui,sans-serif; font-size:14px;
    background:var(--kdx-surface,#111113); color:var(--kdx-dust-white,#EDEDED);
    border:1px solid var(--kdx-line,rgba(237,237,237,.15)); padding:10px 12px; border-radius:0;
    transition:border-color .2s; outline:none; }
  .kdx-field input:focus, .kdx-field select:focus, .kdx-field textarea:focus{
    border-color:var(--kdx-acid,#B7FF00); }
  .kdx-field textarea{ resize:vertical; min-height:60px; font-family:inherit; }
  .kdx-radios{ display:flex; gap:16px; padding:8px 0; }
  .kdx-radios label{ display:inline-flex; align-items:center; gap:6px; font-family:'Inter Tight',system-ui,sans-serif;
    font-size:13px; letter-spacing:0; text-transform:none; color:var(--kdx-dust-white,#EDEDED); cursor:pointer; }

  .kdx-commission__submit{ grid-column:1 / -1;
    font-family:'IBM Plex Mono',ui-monospace,monospace; font-size:12px; letter-spacing:.22em;
    background:var(--kdx-acid,#B7FF00); color:var(--kdx-black,#0A0A0A); border:0; padding:14px 22px;
    cursor:pointer; transition:transform .15s, background .15s; margin-top:8px; }
  .kdx-commission__submit:hover, .kdx-commission__submit:focus-visible{ background:var(--kdx-dust-white,#EDEDED); outline:none; transform:translateY(-1px); }
  .kdx-commission__note{ grid-column:1 / -1; font-family:'IBM Plex Mono',ui-monospace,monospace; font-size:11px; color:var(--kdx-muted,#88888A); margin:8px 0 0; }
  .kdx-commission__note.is-ok{ color:var(--kdx-acid,#B7FF00); }
  .kdx-commission__note.is-err{ color:var(--kdx-red,#FF3B33); }

  @media (max-width:640px){
    .kdx-commission__form{ grid-template-columns:1fr; }
  }
</style>

<script is:inline>
  (() => {
    const overlay = document.querySelector('[data-kdx-commission]');
    if (!overlay) return;
    const form = overlay.querySelector('[data-kdx-commission-form]');
    const note = overlay.querySelector('[data-kdx-commission-note]');
    let lastFocus = null;
    const focusable = () => overlay.querySelectorAll('a[href],button:not([disabled]),input,select,textarea');
    const open = () => {
      lastFocus = document.activeElement;
      overlay.hidden = false;
      requestAnimationFrame(() => overlay.setAttribute('data-open', ''));
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      const first = focusable()[0]; if (first) first.focus();
      try { window.kdx && window.kdx('commission_open'); } catch (_) {}
    };
    const close = () => {
      overlay.removeAttribute('data-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => { overlay.hidden = true; }, 300);
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    };
    document.querySelectorAll('[data-kdx-commission-open]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); open(); }));
    overlay.querySelector('[data-kdx-commission-close]')?.addEventListener('click', close);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
    addEventListener('keydown', (e) => {
      if (overlay.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (e.key === 'Tab') {
        const els = [...focusable()]; if (!els.length) return;
        const first = els[0], last = els[els.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const get = (k) => (data.get(k) || '').toString().trim();
      const name = get('name'), email = get('email'), goal = get('goal');
      if (!name || !email || !goal) {
        note.hidden = false; note.className = 'kdx-commission__note is-err';
        note.textContent = 'Name, email and objective are required.';
        return;
      }
      const subject = `KODEX Commission · ${get('type') || 'Project'} · ${name}`;
      const body = [
        `Project type: ${get('type')}`,
        `Industry: ${get('industry')}`,
        `Objective: ${goal}`,
        `Budget: ${get('budget')}`,
        `Timeline: ${get('timeline')}`,
        `Use: ${get('use')}`,
        `Name: ${name}`,
        `Email: ${email}`,
        `References: ${get('refs')}`,
        '',
        '— sent from wenumapuonline.com/kodex (Commission overlay)'
      ].join('\n');
      const url = 'mailto:marimari@wenumapuonline.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      window.location.href = url;
      note.hidden = false; note.className = 'kdx-commission__note is-ok';
      note.textContent = 'Opening your email client — hit send to reach Ocin.';
      try { window.kdx && window.kdx('commission_submit', { type: get('type'), budget: get('budget') }); } catch (_) {}
    });
  })();
</script>
