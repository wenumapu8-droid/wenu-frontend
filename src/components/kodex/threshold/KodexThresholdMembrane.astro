---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<figure
  class:list={['kdx-threshold-membrane', className]}
  data-kdx-threshold-membrane
  aria-label="Abstract KODEX Threshold membrane. Pointer or touch proximity changes only the visual field; entry remains an explicit semantic action."
>
  <canvas aria-hidden="true"></canvas>
  <div class="kdx-threshold-membrane__grain" aria-hidden="true"></div>
  <div class="kdx-threshold-membrane__vignette" aria-hidden="true"></div>
</figure>

<script>
  const clamp = (value: number, min = 0, max = 1) => Math.max(min, Math.min(max, value));
  const lerp = (a: number, b: number, amount: number) => a + (b - a) * amount;

  function initThresholdMembrane(root: HTMLElement) {
    if (root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    const canvas = root.querySelector<HTMLCanvasElement>('canvas');
    if (!canvas) return;
    const context = canvas.getContext('2d', { alpha: false });
    if (!context) return;

    const sceneRoot = root.closest<HTMLElement>('[data-kdx-visible-assembly]');
    const reducedQuery = matchMedia('(prefers-reduced-motion: reduce)');

    let width = 1;
    let height = 1;
    let dpr = 1;
    let pointerX = 0.5;
    let pointerY = 0.5;
    let targetX = 0.5;
    let targetY = 0.5;
    let proximity = 0;
    let dwell = 0;
    let time = 0;
    let frame = 0;
    let lastFrame = 0;
    let disposed = false;

    const mode = () => {
      const requested = sceneRoot?.dataset.motion?.toUpperCase();
      if (requested === 'OFF') return 'OFF';
      if (requested === 'REDUCED' || reducedQuery.matches) return 'REDUCED';
      return 'FULL';
    };

    const resize = () => {
      const rect = root.getBoundingClientRect();
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      dpr = Math.min(devicePixelRatio || 1, 1.6);
      canvas.width = Math.max(1, Math.round(width * dpr));
      canvas.height = Math.max(1, Math.round(height * dpr));
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    };

    const focalPoint = () => {
      const compact = width < 900;
      return {
        x: width * (compact ? 0.5 : 0.6),
        y: height * (compact ? 0.32 : 0.46),
      };
    };

    const LOBES = [
      { angle: 0.0, length: 1.0, width: 0.34 },
      { angle: 2.4, length: 0.82, width: 0.3 },
      { angle: 4.6, length: 0.92, width: 0.36 },
      { angle: 1.2, length: 0.7, width: 0.26 },
      { angle: 3.6, length: 0.78, width: 0.28 },
    ];

    const CAVITIES = [];
    for (let index = 0; index < 26; index += 1) {
      const angle = index * 2.399963 + ((index * 7) % 5) * 0.07;
      const radial = 0.28 + (((index * 37) % 47) / 100) * 0.46;
      const size = 0.05 + (((index * 17) % 23) / 300) * 0.16;
      CAVITIES.push({ angle, radial, size });
    }

    const pointerAngleOf = () => Math.atan2((pointerY - 0.5) * height, (pointerX - 0.5) * width);

    const shellPoints = (
      cx: number,
      cy: number,
      base: number,
      layer: number,
      breathing: number,
      startIndex: number,
      endIndex: number,
      steps: number,
    ) => {
      const pointerAngle = pointerAngleOf();
      const points: Array<[number, number]> = [];
      for (let index = startIndex; index <= endIndex; index += 1) {
        const angle = (index / steps) * Math.PI * 2;
        let radius = base;
        for (const lobe of LOBES) {
          const delta = angle - lobe.angle;
          radius += base * Math.exp(-delta * delta * 7) * lobe.length * 0.3;
        }
        radius *= 1
          + Math.sin(angle * 3 + layer * 1.3 + breathing) * 0.05
          + Math.sin(angle * 7 - layer + breathing * 1.7) * 0.025
          + Math.sin(angle * 13 + layer * 0.7 + breathing * 0.5) * 0.012;
        radius *= 1 + Math.cos(angle - pointerAngle) * proximity * 0.07;
        points.push([cx + Math.cos(angle) * radius, cy + Math.sin(angle) * radius * 0.92]);
      }
      return points;
    };

    const tracePoints = (points: Array<[number, number]>, close = true) => {
      context.beginPath();
      for (let index = 0; index < points.length; index += 1) {
        const [x, y] = points[index];
        if (index === 0) context.moveTo(x, y);
        else context.lineTo(x, y);
      }
      if (close) context.closePath();
    };

    const drawShell = (cx: number, cy: number, base: number, layer: number, alpha: number, breathing: number) => {
      context.save();
      context.globalCompositeOperation = 'screen';
      tracePoints(shellPoints(cx, cy, base, layer, breathing, 0, 180, 180));
      context.fillStyle = layer % 2 === 0 ? 'rgb(20 18 28 / 0.96)' : 'rgb(8 7 13 / 0.97)';
      context.globalAlpha = alpha;
      context.fill();
      context.restore();
    };

    const drawMineralRim = (cx: number, cy: number, base: number, alpha: number, breathing: number) => {
      const points = shellPoints(cx, cy, base, 0, breathing, 0, 180, 180);
      context.save();
      context.globalCompositeOperation = 'screen';
      tracePoints(points);
      context.strokeStyle = `rgb(214 202 232 / ${alpha})`;
      context.lineWidth = 1.1;
      context.stroke();

      const specStart = Math.floor(180 * 0.42);
      const specEnd = Math.floor(180 * 0.62);
      const spec = shellPoints(cx, cy, base, 0, breathing, specStart, specEnd, 180);
      tracePoints(spec, false);
      context.strokeStyle = `rgb(240 232 252 / ${Math.min(0.9, alpha * 2.4)})`;
      context.lineWidth = 1.8;
      context.stroke();
      context.restore();
    };

    const drawCavity = (cx: number, cy: number, base: number, cavity: { angle: number; radial: number; size: number }, breathing: number) => {
      const pointerAngle = pointerAngleOf();
      const pull = Math.cos(cavity.angle - pointerAngle) * proximity * 0.08;
      const r = base * (cavity.radial + pull);
      const x = cx + Math.cos(cavity.angle) * r;
      const y = cy + Math.sin(cavity.angle) * r * 0.92;
      const s = base * cavity.size;
      context.save();
      context.globalCompositeOperation = 'screen';
      const gradient = context.createRadialGradient(x, y, 0, x, y, s * 4.5);
      gradient.addColorStop(0, `rgb(170 130 255 / ${0.1 + proximity * 0.1})`);
      gradient.addColorStop(0.4, `rgb(100 60 180 / ${0.08 + dwell * 0.1})`);
      gradient.addColorStop(1, 'rgb(40 22 70 / 0)');
      context.fillStyle = gradient;
      context.beginPath();
      context.arc(x, y, s * 4.5, 0, Math.PI * 2);
      context.fill();
      context.globalCompositeOperation = 'source-over';
      context.fillStyle = 'rgb(4 4 8 / 0.9)';
      context.beginPath();
      context.arc(x, y, s * 1.15, 0, Math.PI * 2);
      context.fill();
      context.globalCompositeOperation = 'screen';
      context.strokeStyle = `rgb(235 225 250 / ${0.12 + dwell * 0.18})`;
      context.lineWidth = 1;
      context.beginPath();
      context.arc(x, y, s * 1.4, -Math.PI / 2, Math.PI / 3);
      context.stroke();
      context.restore();
    };

    const drawGlyphTexture = (cx: number, cy: number, base: number, breathing: number) => {
      context.save();
      context.globalCompositeOperation = 'screen';
      context.textAlign = 'center';
      context.textBaseline = 'middle';
      const labels = [
        { text: 'THRESHOLD', angle: 0.5, radial: 0.5, rot: 0.12, alpha: 0.1 },
        { text: 'A / −∞', angle: 2.6, radial: 0.62, rot: -0.2, alpha: 0.12 },
        { text: 'IDENTITY CLAIM: NONE', angle: 4.1, radial: 0.55, rot: 0.3, alpha: 0.07 },
      ];
      for (const label of labels) {
        const x = cx + Math.cos(label.angle) * base * label.radial;
        const y = cy + Math.sin(label.angle) * base * label.radial * 0.92;
        context.save();
        context.translate(x, y);
        context.rotate(label.rot + breathing * 0.02);
        context.font = `${Math.max(7, base * 0.045)}px ui-monospace, SFMono-Regular, Menlo, monospace`;
        context.fillStyle = `rgb(240 238 232 / ${label.alpha})`;
        context.fillText(label.text, 0, 0);
        context.restore();
      }
      for (let index = 0; index < 14; index += 1) {
        const angle = index * 2.399963 + 1.3;
        const radial = 0.34 + ((index * 11) % 23) / 90;
        const x = cx + Math.cos(angle) * base * radial;
        const y = cy + Math.sin(angle) * base * radial * 0.92;
        const s = base * (0.004 + ((index * 13) % 5) * 0.0015);
        context.strokeStyle = `rgb(214 202 232 / ${0.05 + proximity * 0.05})`;
        context.lineWidth = 0.7;
        context.beginPath();
        context.moveTo(x - s * 3, y);
        context.lineTo(x + s * 3, y);
        context.stroke();
      }
      context.restore();
    };

    function draw() {
      const { x: cx, y: cy } = focalPoint();
      const shortSide = Math.min(width, height);
      const base = shortSide * (width < 900 ? 0.42 : 0.34);
      const discrete = mode() === 'REDUCED' || mode() === 'OFF';
      const level = proximity > 0.6 ? 2 : proximity > 0.2 ? 1 : 0;
      const opening = discrete
        ? clamp(0.22 + level * 0.25, 0.18, 0.8)
        : clamp(0.22 + proximity * 0.36 + dwell * 0.24, 0.18, 0.8);
      const breathing = discrete ? 0 : Math.sin(time * 1.4) * 0.5 + Math.sin(time * 0.9 + 1.7) * 0.5;

      context.save();
      context.globalCompositeOperation = 'source-over';
      context.fillStyle = '#020203';
      context.fillRect(0, 0, width, height);

      const atmosphere = context.createRadialGradient(cx, cy, base * 0.06, cx, cy, base * 1.85);
      atmosphere.addColorStop(0, `rgb(180 144 255 / ${0.05 + opening * 0.05})`);
      atmosphere.addColorStop(0.35, `rgb(99 57 175 / ${0.05 + proximity * 0.04})`);
      atmosphere.addColorStop(1, 'rgb(0 0 0 / 0)');
      context.fillStyle = atmosphere;
      context.fillRect(0, 0, width, height);
      context.restore();

      drawShell(cx, cy, base * 1.06, 0, 0.34, breathing);
      drawShell(cx, cy, base * 0.84, 1, 0.5, breathing);
      drawShell(cx, cy, base * 0.62, 2, 0.62, breathing);

      for (const cavity of CAVITIES) drawCavity(cx, cy, base, cavity, breathing);

      drawGlyphTexture(cx, cy, base, breathing);
      drawMineralRim(cx, cy, base * 1.06, 0.16 + proximity * 0.1, breathing);

      context.save();
      context.globalCompositeOperation = 'source-over';
      const apertureRadius = base * (0.15 + opening * 0.23);
      const aperture = context.createRadialGradient(cx, cy, 0, cx, cy, apertureRadius);
      aperture.addColorStop(0, 'rgb(0 0 0 / 1)');
      aperture.addColorStop(0.62, 'rgb(1 1 3 / 0.98)');
      aperture.addColorStop(0.84, `rgb(41 20 69 / ${0.54 - dwell * 0.14})`);
      aperture.addColorStop(1, 'rgb(124 84 194 / 0)');
      context.fillStyle = aperture;
      context.beginPath();
      context.arc(cx, cy, apertureRadius * 1.5, 0, Math.PI * 2);
      context.fill();
      context.restore();

      context.save();
      context.globalCompositeOperation = 'screen';
      context.strokeStyle = `rgb(214 202 232 / ${0.14 + dwell * 0.22})`;
      context.lineWidth = 0.8;
      context.setLineDash([2, 8]);
      context.beginPath();
      context.arc(cx, cy, base * (0.28 + opening * 0.18), 0, Math.PI * 2);
      context.stroke();
      context.restore();
    }

    const updatePointer = (clientX: number, clientY: number) => {
      const rect = root.getBoundingClientRect();
      targetX = clamp((clientX - rect.left) / Math.max(1, rect.width));
      targetY = clamp((clientY - rect.top) / Math.max(1, rect.height));
      const focal = focalPoint();
      const dx = clientX - rect.left - focal.x;
      const dy = clientY - rect.top - focal.y;
      const distance = Math.hypot(dx, dy);
      const influenceRadius = Math.min(width, height) * 0.52;
      proximity = clamp(1 - distance / influenceRadius);
      if (mode() !== 'FULL') draw();
    };

    const onPointerMove = (event: PointerEvent) => updatePointer(event.clientX, event.clientY);
    const onPointerLeave = () => {
      targetX = 0.5;
      targetY = 0.5;
      proximity *= 0.55;
      if (mode() !== 'FULL') draw();
    };

    const tick = (now: number) => {
      if (disposed) return;
      const currentMode = mode();
      if (!document.hidden && currentMode === 'FULL' && now - lastFrame >= 32) {
        pointerX = lerp(pointerX, targetX, 0.075);
        pointerY = lerp(pointerY, targetY, 0.075);
        dwell = proximity > 0.58 ? clamp(dwell + 0.008) : clamp(dwell - 0.014);
        time += 0.018;
        draw();
        lastFrame = now;
      }
      frame = requestAnimationFrame(tick);
    };

    const onVisibility = () => {
      if (!document.hidden) draw();
    };
    const onMotionChange = () => draw();

    root.addEventListener('pointermove', onPointerMove, { passive: true });
    root.addEventListener('pointerleave', onPointerLeave, { passive: true });
    document.addEventListener('visibilitychange', onVisibility);
    reducedQuery.addEventListener?.('change', onMotionChange);

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(root);
    resize();
    frame = requestAnimationFrame(tick);

    const destroy = () => {
      disposed = true;
      cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      root.removeEventListener('pointermove', onPointerMove);
      root.removeEventListener('pointerleave', onPointerLeave);
      document.removeEventListener('visibilitychange', onVisibility);
      reducedQuery.removeEventListener?.('change', onMotionChange);
    };

    addEventListener('pagehide', destroy, { once: true });
  }

  const initAll = () => {
    document.querySelectorAll<HTMLElement>('[data-kdx-threshold-membrane]').forEach(initThresholdMembrane);
  };

  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>

<style>
  .kdx-threshold-membrane {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #020203;
    contain: layout paint style;
  }

  .kdx-threshold-membrane canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .kdx-threshold-membrane__grain,
  .kdx-threshold-membrane__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .kdx-threshold-membrane__grain {
    opacity: 0.055;
    mix-blend-mode: soft-light;
    background-image:
      repeating-linear-gradient(0deg, transparent 0 2px, rgb(255 255 255 / 0.14) 3px, transparent 4px),
      radial-gradient(circle at 20% 30%, rgb(255 255 255 / 0.08) 0 1px, transparent 1px);
    background-size: auto, 5px 5px;
  }

  .kdx-threshold-membrane__vignette {
    background: radial-gradient(circle at 60% 46%, transparent 0 22%, rgb(0 0 0 / 0.12) 43%, rgb(0 0 0 / 0.78) 100%);
  }

  @media (max-width: 900px) {
    .kdx-threshold-membrane__vignette {
      background: radial-gradient(circle at 50% 32%, transparent 0 18%, rgb(0 0 0 / 0.12) 42%, rgb(0 0 0 / 0.8) 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kdx-threshold-membrane__grain { opacity: 0.04; }
  }
</style>
