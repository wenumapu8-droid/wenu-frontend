---
interface Props {
  label?: string;
  description?: string;
}

const {
  label = "DNA ASCENT · recorrido del código vivo",
  description = "Dos hebras luminosas ascienden alrededor de un eje vertical. El puntero altera la perspectiva; activar intensifica la señal.",
} = Astro.props;
---

<section
  class="kdx-dna"
  data-dna-ascent
  data-ready="false"
  tabindex="0"
  role="button"
  aria-label={label}
  aria-description={description}
  aria-pressed="false"
>
  <img
    class="kdx-dna__fallback"
    src="/img/kodex/organisms/dna-ascent-fallback.svg"
    alt=""
    aria-hidden="true"
  />
  <canvas class="kdx-dna__canvas" aria-hidden="true"></canvas>

  <div class="kdx-dna__chrome" aria-hidden="true">
    <div class="kdx-dna__topline">
      <span>KODEX−∞ / LAB</span>
      <span>AXIS // Z</span>
      <span data-dna-state>DORMANT</span>
    </div>
    <div class="kdx-dna__axis">
      <span>ASCENT</span>
      <span>−∞</span>
      <span>0</span>
      <span>+∞</span>
    </div>
    <div class="kdx-dna__readout">
      <span>SIGNAL</span>
      <span data-dna-signal>0.42</span>
      <span>MODE</span>
      <span data-dna-motion>FULL</span>
    </div>
  </div>

  <p class="kdx-dna__instruction">
    MOVE / TOUCH TO SHIFT DEPTH · CLICK / TAP / ENTER TO ENGAGE
  </p>
</section>

<script>
  import "./dna-ascent-client";
</script>

<style>
  .kdx-dna {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: min(78vh, 58rem);
    overflow: hidden;
    border: 1px solid rgb(223 217 255 / 0.26);
    outline: none;
    background: #020203;
    color: #e9e5f2;
    cursor: crosshair;
  }

  .kdx-dna:focus-visible {
    box-shadow: inset 0 0 0 2px rgb(148 118 255 / 0.9);
  }

  .kdx-dna__fallback,
  .kdx-dna__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .kdx-dna__fallback {
    object-fit: cover;
    opacity: 1;
    transition: opacity 180ms linear;
  }

  .kdx-dna[data-ready="true"] .kdx-dna__fallback {
    opacity: 0;
  }

  .kdx-dna__canvas {
    display: block;
    opacity: 0;
    transition: opacity 180ms linear;
  }

  .kdx-dna[data-ready="true"] .kdx-dna__canvas {
    opacity: 1;
  }

  .kdx-dna__chrome {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    font: 500 0.64rem/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgb(232 226 255 / 0.68);
  }

  .kdx-dna__topline,
  .kdx-dna__readout {
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .kdx-dna__topline { top: 0.75rem; }
  .kdx-dna__readout { bottom: 0.75rem; }

  .kdx-dna__axis {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    display: grid;
    gap: 1rem;
    transform: translateY(-50%);
    text-align: right;
    color: rgb(134 213 255 / 0.64);
  }

  .kdx-dna__instruction {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 2.2rem;
    width: min(90%, 44rem);
    margin: 0;
    transform: translateX(-50%);
    text-align: center;
    font: 500 0.58rem/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.13em;
    color: rgb(232 226 255 / 0.52);
    pointer-events: none;
  }

  @media (max-width: 700px) {
    .kdx-dna { min-height: 68dvh; }
    .kdx-dna__topline { gap: 0.3rem; font-size: 0.54rem; }
    .kdx-dna__axis { font-size: 0.54rem; }
    .kdx-dna__readout { font-size: 0.54rem; }
    .kdx-dna__instruction { bottom: 2rem; font-size: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kdx-dna__fallback,
    .kdx-dna__canvas { transition: none; }
  }
</style>
