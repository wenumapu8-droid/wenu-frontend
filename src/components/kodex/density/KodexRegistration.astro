---
/**
 * KODEX-∞ · REGISTRATION
 *
 * Las cruces de registro del marco exterior. En imprenta sirven para alinear
 * las planchas de color; en los boards del KODEX cumplen la misma función que
 * el barcode y el checksum -- dicen que esto es material de archivo, salido de
 * un proceso, no una pantalla decorada.
 *
 * Van en las cuatro esquinas del marco y son fondo: nunca capturan el puntero
 * ni entran en el orden de lectura.
 */
import KodexGlyph from "../KodexGlyph.astro";

interface Props {
  accent?: string;
  /** Tamaño de la cruz en px. */
  size?: number;
  class?: string;
}

const { accent = "var(--kdx-red, #FF2733)", size = 26, class: className = "" } = Astro.props;
const esquinas = ["tl", "tr", "bl", "br"] as const;
---

<div
  class:list={["kdx-reg", className]}
  style={`--kdx-reg-accent:${accent};--kdx-reg-size:${size}px`}
  aria-hidden="true"
>
  {esquinas.map((c) => (
    <span class={`kdx-reg__mark kdx-reg__mark--${c}`}>
      <KodexGlyph name="crosshair" size={size} motion="none" />
    </span>
  ))}
</div>

<style>
  .kdx-reg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
    color: var(--kdx-reg-accent);
    opacity: 0.34;
  }

  .kdx-reg__mark {
    position: absolute;
    display: block;
    width: var(--kdx-reg-size);
    height: var(--kdx-reg-size);
  }

  /* Sobre el borde, mitad adentro y mitad afuera: una cruz de registro que cae
     entera dentro del marco se lee como icono, no como marca de proceso. */
  .kdx-reg__mark--tl { top: 0; left: 0; transform: translate(-50%, -50%); }
  .kdx-reg__mark--tr { top: 0; right: 0; transform: translate(50%, -50%); }
  .kdx-reg__mark--bl { bottom: 0; left: 0; transform: translate(-50%, 50%); }
  .kdx-reg__mark--br { bottom: 0; right: 0; transform: translate(50%, 50%); }
</style>
