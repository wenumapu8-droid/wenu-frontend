---
/** KODEX-∞ · REGISTRATION + bounded current-lineage PROLOGUE mount.
 * Registration remains shared. PROLOGUE alone mounts the proven native scene;
 * ii–vi keep the existing stage unchanged.
 */
import KodexGlyph from "../KodexGlyph.astro";
import EscenaPrologue from "../prologue/EscenaPrologue.astro";

interface Props { accent?: string; size?: number; class?: string; }
const { accent = "var(--kdx-red, #FF2733)", size = 26, class: className = "" } = Astro.props;
const esquinas = ["tl", "tr", "bl", "br"] as const;
const isPrologue = accent.includes('kdx-violet') || accent.includes('#8B5CF6');
---

{isPrologue && <EscenaPrologue />}

<div class:list={["kdx-reg", className]} style={`--kdx-reg-accent:${accent};--kdx-reg-size:${size}px`} aria-hidden="true">
  {esquinas.map((c) => <span class={`kdx-reg__mark kdx-reg__mark--${c}`}><KodexGlyph name="crosshair" size={size} motion="none" /></span>)}
</div>

<style>
  .kdx-reg { position:absolute; inset:0; pointer-events:none; z-index:3; color:var(--kdx-reg-accent); opacity:.34; }
  .kdx-reg__mark { position:absolute; display:block; width:var(--kdx-reg-size); height:var(--kdx-reg-size); }
  .kdx-reg__mark--tl { top:0; left:0; transform:translate(-50%,-50%); }
  .kdx-reg__mark--tr { top:0; right:0; transform:translate(50%,-50%); }
  .kdx-reg__mark--bl { bottom:0; left:0; transform:translate(-50%,50%); }
  .kdx-reg__mark--br { bottom:0; right:0; transform:translate(50%,50%); }
</style>

<style is:global>
  /* Native PROLOGUE owns the viewport. Suppress only the generic folio-i
     payload; shell chrome/transition/history remain current-lineage authority. */
  .kx-os-scene--prologue .kx-os-stage > .kdx-reg,
  .kx-os-scene--prologue .kx-os-stage__field,
  .kx-os-scene--prologue .kx-os-stage__eje,
  .kx-os-scene--prologue .kx-os-stage__tira,
  .kx-os-scene--prologue .kx-os-stage__strip,
  .kx-os-scene--prologue .kx-os-stage__copy,
  .kx-os-scene--prologue .kx-os-stage__art,
  .kx-os-scene--prologue .kx-os-barcode { display:none !important; }
</style>
