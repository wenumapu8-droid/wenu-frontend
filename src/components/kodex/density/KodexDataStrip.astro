---
/**
 * KODEX-∞ · DATA STRIP
 *
 * Columna de metadatos con su propio marco, del tipo que en los boards de
 * referencia ocupa los costados: pares clave/valor, un medidor, y formas
 * concéntricas como gráfica.
 *
 * Existe por el mismo motivo que el rail: el brief pide llenar el espacio de
 * SISTEMA, y los boards no dejan aire muerto. La diferencia entre el sitio
 * actual y las referencias no es el anchor -- es todo esto alrededor.
 *
 * Los valores llegan desde la escena. Nada se inventa acá dentro.
 */
interface Props {
  title: string;
  rows: Array<{ k: string; v: string }>;
  accent?: string;
  /** 0..1 — dibuja una barra de nivel bajo los datos. */
  meter?: number;
  meterLabel?: string;
  /** Forma concéntrica de cierre: anillos, cuadrados o triángulos. */
  figure?: "rings" | "squares" | "triangles" | "none";
  class?: string;
}

const {
  title,
  rows,
  accent = "var(--kdx-scene-accent, var(--kdx-red, #FF2733))",
  meter,
  meterLabel = "INTEGRITY",
  figure = "rings",
  class: className = "",
} = Astro.props;

const pct = typeof meter === "number" ? Math.round(Math.min(1, Math.max(0, meter)) * 100) : null;
---

<aside
  class:list={["kdx-strip", className]}
  style={`--strip-accent:${accent};`}
  aria-label={title}
>
  <p class="kdx-strip__title">{title}</p>

  <dl class="kdx-strip__rows">
    {rows.map(({ k, v }) => (
      <div class="kdx-strip__row">
        <dt>{k}</dt>
        <dd>{v}</dd>
      </div>
    ))}
  </dl>

  {pct !== null && (
    <div class="kdx-strip__meter">
      <div class="kdx-strip__meter-head">
        <span>{meterLabel}</span>
        <span class="kdx-strip__meter-val">{pct}%</span>
      </div>
      {/* Barra segmentada, no continua: en los boards la lectura es de
          instrumento, y un degradado suave rompe ese código. */}
      <div class="kdx-strip__meter-bar" role="img" aria-label={`${meterLabel} ${pct}%`}>
        <span style={`width:${pct}%`}></span>
      </div>
    </div>
  )}

  {figure !== "none" && (
    <div class="kdx-strip__figure" aria-hidden="true">
      {figure === "rings" && (
        <svg viewBox="0 0 60 60" focusable="false">
          <circle cx="30" cy="30" r="27" /><circle cx="30" cy="30" r="20" />
          <circle cx="30" cy="30" r="13" /><circle cx="30" cy="30" r="6" />
        </svg>
      )}
      {figure === "squares" && (
        <svg viewBox="0 0 60 60" focusable="false">
          <rect x="4" y="4" width="52" height="52" /><rect x="12" y="12" width="36" height="36" />
          <rect x="20" y="20" width="20" height="20" /><rect x="27" y="27" width="6" height="6" />
        </svg>
      )}
      {figure === "triangles" && (
        <svg viewBox="0 0 60 60" focusable="false">
          <path d="M30 5 L56 52 H4 Z" /><path d="M30 17 L47 47 H13 Z" />
          <path d="M30 28 L39 44 H21 Z" />
        </svg>
      )}
    </div>
  )}
</aside>

<style>
  .kdx-strip {
    border: 1px solid color-mix(in srgb, var(--strip-accent) 20%, transparent);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--strip-accent) 5%, transparent), transparent 60%),
      var(--kdx-near-black, #111113);
    padding: 14px 14px 12px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    clip-path: polygon(
      0 0, calc(100% - 10px) 0, 100% 10px,
      100% 100%, 10px 100%, 0 calc(100% - 10px)
    );
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .kdx-strip__title {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--strip-accent);
    font-weight: 600;
  }

  .kdx-strip__rows { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .kdx-strip__row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--kdx-line, rgba(230, 230, 230, 0.1));
    padding-bottom: 5px;
  }
  .kdx-strip__row dt { color: var(--kdx-muted, #88888a); margin: 0; }
  .kdx-strip__row dd {
    margin: 0;
    color: var(--kdx-off-white, #e6e6e6);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .kdx-strip__meter-head {
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--kdx-muted, #88888a);
    margin-bottom: 5px;
  }
  .kdx-strip__meter-val { color: var(--strip-accent); font-variant-numeric: tabular-nums; }
  .kdx-strip__meter-bar {
    height: 8px;
    border: 1px solid color-mix(in srgb, var(--strip-accent) 28%, transparent);
    padding: 1px;
  }
  .kdx-strip__meter-bar span {
    display: block;
    height: 100%;
    background: repeating-linear-gradient(
      90deg,
      var(--strip-accent) 0 2px,
      transparent 2px 4px
    );
  }

  .kdx-strip__figure { display: flex; justify-content: center; padding-top: 2px; }
  .kdx-strip__figure svg {
    width: 54px;
    height: 54px;
    fill: none;
    stroke: color-mix(in srgb, var(--strip-accent) 45%, transparent);
    stroke-width: 1;
  }
</style>
