---
/**
 * KODEX-∞ · ORIGIN VECTOR
 *
 * El bloque de coordenadas del costado derecho del board: RA, DEC, SIG, MOD,
 * y bajo eso la frase de sistema y el identificador con barcode.
 *
 * En la referencia de THRESHOLD este bloque es lo que convierte un marco en un
 * registro: la pieza no solo se ve, está ubicada. Sin él el artefacto parece
 * ilustración; con él parece catalogado.
 */
interface Props {
  ra?: string;
  dec?: string;
  sig?: string;
  mod?: string;
  /** Las dos o tres líneas de sistema bajo las coordenadas. */
  lines?: string[];
  /** Identificador de archivo, al pie del bloque. */
  id?: string;
  accent?: string;
  class?: string;
}

const {
  ra = "RA 23h00m",
  dec = "DEC +89° 06′ 18″",
  sig = "SIG 0.1 – 0.77Hz",
  mod = "MOD SPECTRAL",
  lines = ["PATTERN REVEALS", "STRUCTURE.", "STRUCTURE REVEALS", "TRUTH."],
  id = "KDX-0001-ANC-2026",
  accent = "var(--kdx-scene-accent, var(--kdx-red, #FF2733))",
  class: className = "",
} = Astro.props;
---

<aside
  class:list={["kdx-origin", className]}
  style={`--origin-accent:${accent};`}
  aria-label="origin vector"
>
  <p class="kdx-origin__title">ORIGIN VECTOR</p>
  <dl class="kdx-origin__coords">
    <div><dt>RA</dt><dd data-kdx-ra>{ra.replace(/^RA\s*/, "")}</dd></div>
    <div><dt>DEC</dt><dd data-kdx-dec>{dec.replace(/^DEC\s*/, "")}</dd></div>
    <div><dt>SIG</dt><dd>{sig.replace(/^SIG\s*/, "")}</dd></div>
    <div><dt>MOD</dt><dd>{mod.replace(/^MOD\s*/, "")}</dd></div>
  </dl>

  {lines.length > 0 && (
    <p class="kdx-origin__lines">
      {lines.map((l, i) => <span>{l}{i < lines.length - 1 && <br />}</span>)}
    </p>
  )}

  <div class="kdx-origin__id">
    <span class="kdx-origin__barcode" aria-hidden="true"></span>
    <span>{id}</span>
  </div>
</aside>

<style>
  .kdx-origin {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--kdx-muted, #88888a);
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 190px;
  }

  .kdx-origin__title {
    margin: 0;
    color: var(--origin-accent);
    letter-spacing: 0.2em;
    font-weight: 600;
  }

  .kdx-origin__coords { margin: 0; display: flex; flex-direction: column; gap: 3px; }
  .kdx-origin__coords > div { display: flex; gap: 8px; }
  .kdx-origin__coords dt { margin: 0; opacity: 0.6; min-width: 30px; }
  .kdx-origin__coords dd {
    margin: 0;
    color: var(--kdx-off-white, #e6e6e6);
    font-variant-numeric: tabular-nums;
  }

  .kdx-origin__lines {
    margin: 0;
    line-height: 1.7;
    color: var(--kdx-off-white, #e6e6e6);
    opacity: 0.8;
  }

  .kdx-origin__id { display: flex; flex-direction: column; gap: 5px; opacity: 0.75; }

  /* Barcode con gradiente en vez de imagen: se repite en cada lámina y no
     merece una petición de red ni un SVG largo. */
  .kdx-origin__barcode {
    width: 100%;
    height: 14px;
    background: repeating-linear-gradient(
      90deg,
      var(--kdx-muted, #88888a) 0 1px,
      transparent 1px 3px,
      var(--kdx-muted, #88888a) 3px 4px,
      transparent 4px 6px,
      var(--kdx-muted, #88888a) 6px 8px,
      transparent 8px 9px
    );
    opacity: 0.6;
  }

  @media (max-width: 900px) {
    .kdx-origin { max-width: none; flex-direction: row; flex-wrap: wrap; gap: 8px 20px; }
    .kdx-origin__lines { display: none; }
  }
</style>
