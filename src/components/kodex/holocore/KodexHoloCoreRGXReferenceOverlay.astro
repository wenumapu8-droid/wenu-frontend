---
import { resolveHoloCoreRGXProfile } from '../../../kodex/holocore/reference-profiles/rgx-family.js';

interface Props { conceptId: string; }
const { conceptId } = Astro.props;
const profile = resolveHoloCoreRGXProfile(conceptId);
const supported = new Set(['heart-chamber', 'skull-archive', 'signal-seed', 'living-organism']);
---

{supported.has(conceptId) && (
  <div
    class="kdx-rgx-ref-overlay"
    data-rgx-reference-overlay={conceptId}
    style={`--ref:${profile.accent}`}
    aria-hidden="true"
  >
    {conceptId === 'heart-chamber' && (
      <svg viewBox="0 0 100 100" role="presentation" data-ref-topology="anatomical-heart">
        <circle class="ref-measure" cx="52" cy="53" r="32" />
        <circle class="ref-measure ref-measure--inner" cx="52" cy="53" r="24" />
        <path class="ref-primary" d="M49 82 C42 78 38 70 35 61 C31 50 29 39 34 33 C38 28 44 29 48 34 C50 28 53 23 59 22 C64 21 68 24 70 29 C75 27 80 30 82 35 C84 41 81 47 76 51 C72 55 71 61 68 68 C65 77 59 83 49 82 Z" />
        <path class="ref-structure" d="M49 35 C47 45 47 58 51 74" />
        <path class="ref-structure" d="M55 31 C59 43 62 55 60 70" />
        <path class="ref-primary" d="M57 28 C55 20 59 14 66 14 C73 14 77 18 78 23 C78 27 76 31 72 34" />
        <path class="ref-primary" d="M63 23 C62 16 65 11 69 8" />
        <path class="ref-primary" d="M69 23 C69 16 73 12 77 10" />
        <path class="ref-primary" d="M74 28 C76 21 82 18 86 18" />
        <path class="ref-structure" d="M43 34 C39 27 36 22 34 17" />
        <path class="ref-structure" d="M39 39 C34 34 29 31 25 30" />
        <g class="ref-network">
          <circle cx="52" cy="55" r="2.2" class="ref-node ref-node--core" />
          <circle cx="43" cy="42" r="1.1" class="ref-node" />
          <circle cx="61" cy="41" r="1.1" class="ref-node" />
          <circle cx="40" cy="56" r="1" class="ref-node" />
          <circle cx="63" cy="57" r="1" class="ref-node" />
          <circle cx="46" cy="68" r="1" class="ref-node" />
          <circle cx="57" cy="70" r="1" class="ref-node" />
          <line x1="52" y1="55" x2="43" y2="42" />
          <line x1="52" y1="55" x2="61" y2="41" />
          <line x1="52" y1="55" x2="40" y2="56" />
          <line x1="52" y1="55" x2="63" y2="57" />
          <line x1="52" y1="55" x2="46" y2="68" />
          <line x1="52" y1="55" x2="57" y2="70" />
          <line x1="43" y1="42" x2="61" y2="41" />
          <line x1="40" y1="56" x2="46" y2="68" />
          <line x1="63" y1="57" x2="57" y2="70" />
        </g>
        <path class="ref-filament" d="M42 76 C40 84 38 89 37 96" />
        <path class="ref-filament" d="M48 81 C47 88 47 92 46 98" />
        <path class="ref-filament" d="M55 81 C56 88 57 93 58 98" />
      </svg>
    )}

    {conceptId === 'skull-archive' && (
      <svg viewBox="0 0 100 100" role="presentation" data-ref-topology="forensic-cranium">
        <circle class="ref-measure" cx="50" cy="50" r="38" />
        <circle class="ref-measure ref-measure--inner" cx="50" cy="50" r="31" />
        <path class="ref-primary" d="M50 16 C34 16 24 27 22 42 C20 54 24 63 31 69 L34 80 C38 88 44 91 50 91 C56 91 62 88 66 80 L69 69 C76 63 80 54 78 42 C76 27 66 16 50 16 Z" />
        <ellipse class="ref-primary" cx="38.5" cy="48" rx="8" ry="7" />
        <ellipse class="ref-primary" cx="61.5" cy="48" rx="8" ry="7" />
        <path class="ref-primary" d="M50 51 L45.5 64 L50 67 L54.5 64 Z" />
        <path class="ref-structure" d="M33 68 C38 72 42 73 50 73 C58 73 62 72 67 68" />
        <path class="ref-primary" d="M35 75 L37 84 L43 88 L57 88 L63 84 L65 75" />
        <g class="ref-teeth">
          <line x1="40" y1="76" x2="40" y2="86" /><line x1="44" y1="75" x2="44" y2="88" />
          <line x1="48" y1="75" x2="48" y2="89" /><line x1="52" y1="75" x2="52" y2="89" />
          <line x1="56" y1="75" x2="56" y2="88" /><line x1="60" y1="76" x2="60" y2="86" />
          <line x1="37" y1="80" x2="63" y2="80" />
        </g>
        <g class="ref-circuit">
          <path d="M51 18 L51 32 L57 37 L57 49 L54 54" />
          <path d="M47 20 L47 34 L42 39 L42 48" />
          <path d="M55 25 L63 25 L67 31" />
          <circle cx="47" cy="34" r="1" /><circle cx="57" cy="37" r="1" /><circle cx="67" cy="31" r="1" />
        </g>
        <g class="ref-fracture">
          <path d="M39 19 L43 27 L40 34 L46 39" />
          <path d="M67 23 L62 29 L65 36 L60 41" />
        </g>
        <line class="ref-axis" x1="8" y1="50" x2="92" y2="50" />
        <line class="ref-axis" x1="50" y1="8" x2="50" y2="94" />
      </svg>
    )}

    {conceptId === 'signal-seed' && (
      <svg viewBox="0 0 100 100" role="presentation" data-ref-topology="signal-seed-compartments">
        <g transform="rotate(18 50 50)">
          <ellipse class="ref-primary" cx="50" cy="50" rx="25" ry="39" />
          <ellipse class="ref-structure" cx="50" cy="50" rx="21" ry="35" />
          <path class="ref-primary" d="M41 18 C48 25 55 25 62 20" />
          <ellipse class="ref-chamber" cx="44" cy="34" rx="8" ry="7" />
          <ellipse class="ref-chamber" cx="58" cy="31" rx="7" ry="8" />
          <ellipse class="ref-chamber" cx="48" cy="49" rx="11" ry="10" />
          <ellipse class="ref-chamber" cx="61" cy="52" rx="7" ry="11" />
          <ellipse class="ref-chamber" cx="42" cy="66" rx="9" ry="12" />
          <ellipse class="ref-chamber" cx="57" cy="70" rx="8" ry="10" />
          <g class="ref-lattice">
            <line x1="34" y1="25" x2="66" y2="76" /><line x1="30" y1="39" x2="68" y2="64" />
            <line x1="31" y1="59" x2="65" y2="28" /><line x1="38" y1="80" x2="62" y2="18" />
            <line x1="27" y1="49" x2="72" y2="48" />
          </g>
          <g class="ref-network">
            <circle cx="44" cy="34" r="1.2" class="ref-node" /><circle cx="58" cy="31" r="1.2" class="ref-node" />
            <circle cx="48" cy="49" r="1.6" class="ref-node ref-node--core" /><circle cx="61" cy="52" r="1.2" class="ref-node" />
            <circle cx="42" cy="66" r="1.2" class="ref-node" /><circle cx="57" cy="70" r="1.2" class="ref-node" />
          </g>
        </g>
      </svg>
    )}

    {conceptId === 'living-organism' && (
      <svg viewBox="0 0 100 100" role="presentation" data-ref-topology="bilateral-organic-node">
        <circle class="ref-measure" cx="50" cy="50" r="35" />
        <path class="ref-primary" d="M50 18 C38 20 30 31 29 45 C28 59 34 70 43 77 C46 79 48 81 50 84 C52 81 54 79 57 77 C66 70 72 59 71 45 C70 31 62 20 50 18 Z" />
        <path class="ref-structure" d="M50 23 C44 30 41 39 41 50 C41 61 44 70 50 78" />
        <path class="ref-structure" d="M50 23 C56 30 59 39 59 50 C59 61 56 70 50 78" />
        <ellipse class="ref-chamber" cx="50" cy="50" rx="13" ry="18" />
        <circle class="ref-node ref-node--core" cx="50" cy="50" r="3.2" />
        <g class="ref-network">
          <circle cx="39" cy="37" r="1" class="ref-node" /><circle cx="61" cy="37" r="1" class="ref-node" />
          <circle cx="35" cy="51" r="1" class="ref-node" /><circle cx="65" cy="51" r="1" class="ref-node" />
          <circle cx="41" cy="66" r="1" class="ref-node" /><circle cx="59" cy="66" r="1" class="ref-node" />
          <line x1="50" y1="50" x2="39" y2="37" /><line x1="50" y1="50" x2="61" y2="37" />
          <line x1="50" y1="50" x2="35" y2="51" /><line x1="50" y1="50" x2="65" y2="51" />
          <line x1="50" y1="50" x2="41" y2="66" /><line x1="50" y1="50" x2="59" y2="66" />
        </g>
        <g class="ref-filaments">
          <path d="M48 20 C46 13 42 9 38 4" /><path d="M51 19 C51 12 50 8 50 2" /><path d="M53 20 C56 13 60 9 65 5" />
          <path d="M46 79 C43 86 39 91 35 97" /><path d="M50 83 C50 89 50 94 50 99" /><path d="M54 79 C58 86 62 91 67 96" />
          <path d="M31 42 C23 39 18 35 14 30" /><path d="M69 42 C77 39 82 35 86 30" />
          <path d="M31 60 C24 64 20 69 16 74" /><path d="M69 60 C76 64 81 69 85 74" />
        </g>
      </svg>
    )}
  </div>
)}

<style>
  .kdx-rgx-ref-overlay {
    position: absolute;
    z-index: 6;
    left: 50%;
    top: 50%;
    width: min(62vw, 68dvh);
    aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%);
    pointer-events: none;
    color: color-mix(in srgb, var(--ref) 76%, white 24%);
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--ref) 22%, transparent));
  }
  .kdx-rgx-ref-overlay svg { display:block; width:100%; height:100%; overflow:visible; }
  .ref-primary, .ref-structure, .ref-measure, .ref-axis, .ref-chamber,
  .ref-network line, .ref-teeth line, .ref-circuit path, .ref-fracture path,
  .ref-filament, .ref-filaments path, .ref-lattice line {
    fill: none;
    stroke: currentColor;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ref-primary { stroke-width: .55; opacity: .92; }
  .ref-structure { stroke-width: .28; opacity: .56; }
  .ref-measure { fill:none; stroke:currentColor; stroke-width:.16; opacity:.18; stroke-dasharray:1.2 1.8; }
  .ref-measure--inner { opacity:.1; }
  .ref-axis { stroke-width:.12; opacity:.14; stroke-dasharray:.8 1.6; }
  .ref-chamber { stroke-width:.3; opacity:.62; }
  .ref-node { fill: currentColor; stroke: currentColor; opacity:.78; }
  .ref-node--core { opacity:1; filter:drop-shadow(0 0 3px currentColor); }
  .ref-network line { stroke-width:.18; opacity:.4; }
  .ref-teeth line { stroke-width:.22; opacity:.58; }
  .ref-circuit path { stroke-width:.24; opacity:.74; }
  .ref-circuit circle { fill: currentColor; opacity:.7; }
  .ref-fracture path { stroke-width:.2; opacity:.48; }
  .ref-filament, .ref-filaments path { stroke-width:.22; opacity:.52; }
  .ref-lattice line { stroke-width:.2; opacity:.42; }

  @media (max-width:700px) {
    .kdx-rgx-ref-overlay { width:min(88vw, 58dvh); }
  }
  @media (prefers-reduced-motion:reduce) {
    .kdx-rgx-ref-overlay { filter:none; }
  }
</style>
