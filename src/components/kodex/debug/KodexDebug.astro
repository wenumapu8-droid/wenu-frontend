---
/**
 * KODEX-∞ · SONDA
 *
 * El overlay `?debug=1` que la Receta Madre pide en el Sprint 1, junto a los
 * tokens, la máquina de estados y el multipass.
 *
 * No es un panel de estadísticas: es la respuesta a "¿por qué se ve así?".
 * Casi todo lo que falló en este proyecto falló en silencio -- tipografías que
 * no cargaban, una obra que el recorte borraba, un artefacto dibujándose
 * quinientos píxeles fuera de la pantalla con todo su estado en "ready". Nada
 * de eso tira un error. Esto lo hace visible.
 *
 * Sólo se monta con `?debug=1` en la URL: no pesa ni un byte de más para el
 * visitante.
 */
---

<div class="kdx-probe" data-kdx-probe hidden aria-hidden="true">
  <table class="kdx-probe__t"><tbody data-kdx-probe-body></tbody></table>
</div>

<script>
  import "./kodex-debug-client.ts";
</script>

<style>
  .kdx-probe {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 9500;
    padding: 8px 10px;
    background: rgba(4, 4, 6, 0.92);
    border: 1px solid rgba(255, 56, 51, 0.34);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 10px;
    line-height: 1.55;
    color: #cfcfcf;
    pointer-events: none;
    max-width: 320px;
  }
  .kdx-probe[hidden] { display: none; }
  .kdx-probe__t { border-collapse: collapse; }
  /* Las filas las crea JavaScript, no la plantilla. Astro aplica los estilos
     con ambito por un atributo que agrega en tiempo de build, y un elemento
     creado con createElement no lo lleva: sin :global estas reglas no lo
     alcanzan y las columnas salen pegadas. */
  .kdx-probe__t :global(th) {
    text-align: left;
    padding-right: 12px;
    font-weight: 400;
    color: rgba(207, 207, 207, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }
  /* Los valores cambian por cuadro: sin cifras de ancho fijo la tabla entera
     tiembla en cada tic y se vuelve ilegible justo cuando hay que leerla. */
  .kdx-probe__t :global(td) { color: #e8e5df; font-variant-numeric: tabular-nums; }
  .kdx-probe__t :global(td[data-mal]) { color: #ff3833; }
</style>
