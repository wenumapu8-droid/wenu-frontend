---
/**
 * KODEX-∞ · RIEL DE INSTRUMENTO
 * TELAR A03+A04+A05+A07+A08 · 2026-08-29
 *
 * Los boards dibujan el MISMO aparato en las cinco escenas gobernadas.
 * Solo cambian el organismo del centro, el texto y los numeros. Esto es
 * ese aparato, construido UNA vez, montado por las siete.
 *
 * Sin esto las escenas se leen como poster con botones -- que es
 * literalmente lo que eran: un fondo, un titulo y un boton.
 *
 * REGLA DE DATO (Decision Log 2026-08-29):
 *   · dato REAL      -> data-fuente="REAL", se lee del runtime
 *   · sin fuente     -> data-fuente="HUECO", se ve como hueco, en gris
 *   · paridad visual -> data-fuente="MOCK", telemetria decorativa MARCADA
 * Ningun numero aparece sin declarar de donde viene. Un readout que no
 * lee nada es poster; uno que miente es peor.
 */
interface Props {
  lado: 'izq' | 'der';
  nodo?: string;
  estadoBase?: string;
  senal?: string;
  acceso?: string;
  bpm?: number;
  respiracion?: number;
  profundidad?: string;
  accent?: string;
  class?: string;
}
const {
  lado,
  nodo = '01',
  estadoBase = 'DORMANT',
  senal = 'LATENT',
  acceso = 'OBSERVER',
  bpm = 62,
  respiracion = 5.4,
  profundidad = '—',
  accent = 'var(--kdx-scene-accent, var(--kdx-red, #FF3833))',
  class: className = '',
} = Astro.props;
---

<aside
  class:list={['kdx-riel', `kdx-riel--${lado}`, className]}
  style={`--riel-accent:${accent};`}
  aria-label={lado === 'izq' ? 'estado del nodo' : 'telemetria del sistema'}
>
  {lado === 'izq' && (
    <>
      <section class="kdx-riel__blq">
        <p class="kdx-riel__tit">NODE {nodo}</p>
        <dl class="kdx-riel__pares">
          <div><dt>STATE</dt><dd data-fuente="REAL" data-kdx-riel-estado><b class="kdx-val">{estadoBase}</b><i class="kdx-medidor" style="--n:0" aria-hidden="true"></i></dd></div>
          <div><dt>SIGNAL</dt><dd data-fuente="REAL" data-kdx-riel-senal><b class="kdx-val">{senal}</b><i class="kdx-medidor" style="--n:0" aria-hidden="true"></i></dd></div>
          <div><dt>ACCESS TYPE</dt><dd data-fuente="REAL"><b class="kdx-val">{acceso}</b><i class="kdx-medidor" style="--n:0.5" aria-hidden="true"></i></dd></div>
          <div><dt>INTEGRITY</dt><dd data-fuente="HUECO"><b class="kdx-val">—</b><i class="kdx-medidor kdx-medidor--hueco" style="--n:0" aria-hidden="true"></i></dd></div>
          <div><dt>COHERENCE</dt><dd data-fuente="REAL" data-kdx-riel-coh><b class="kdx-val">0.000</b><i class="kdx-medidor" style="--n:0" aria-hidden="true"></i></dd></div>
        </dl>
      </section>

      <section class="kdx-riel__blq">
        <p class="kdx-riel__tit">PULSE</p>
        <p class="kdx-riel__grande" data-fuente="MOCK">{bpm} <span>BPM</span></p>
        <canvas class="kdx-riel__onda" data-onda="pulso" width="360" height="54" aria-hidden="true"></canvas>
      </section>

      <section class="kdx-riel__blq">
        <p class="kdx-riel__tit">BREATH INDEX</p>
        <p class="kdx-riel__grande" data-fuente="MOCK">{respiracion} <span>/ MIN</span></p>
        <canvas class="kdx-riel__onda" data-onda="respiracion" width="360" height="54" aria-hidden="true"></canvas>
      </section>
    </>
  )}

  {lado === 'der' && (
    <>
      <section class="kdx-riel__blq">
        <p class="kdx-riel__tit">SYSTEM TELEMETRY</p>
        <dl class="kdx-riel__pares">
          <div><dt>NODE LOAD</dt><dd data-fuente="REAL" data-kdx-tel-carga><b class="kdx-val">—</b><i class="kdx-medidor" style="--n:0" aria-hidden="true"></i></dd></div>
          <div><dt>MEMORY STREAM</dt><dd data-fuente="REAL" data-kdx-tel-mem><b class="kdx-val">—</b><i class="kdx-medidor" style="--n:0" aria-hidden="true"></i></dd></div>
          <div><dt>ARCHIVE DEPTH</dt><dd data-fuente="REAL"><b class="kdx-val">{profundidad}</b><i class="kdx-medidor" style="--n:0.4" aria-hidden="true"></i></dd></div>
          <div><dt>THRESHOLD LOCK</dt><dd data-fuente="REAL" data-kdx-tel-lock><b class="kdx-val">WAITING</b><i class="kdx-medidor" style="--n:0" aria-hidden="true"></i></dd></div>
          <div><dt>ENTROPY RATE</dt><dd data-fuente="HUECO">—</dd></div>
        </dl>
      </section>

      <section class="kdx-riel__blq">
        <p class="kdx-riel__tit">VERITY CHECK</p>
        <dl class="kdx-riel__pares">
          <div><dt>STATUS</dt><dd data-fuente="REAL" data-kdx-verity><b class="kdx-val">CHECKING</b><i class="kdx-medidor" style="--n:0" aria-hidden="true"></i></dd></div>
        </dl>
        <p class="kdx-riel__nota" data-kdx-verity-nota>—</p>
      </section>
    </>
  )}
</aside>

<style>
  .kdx-riel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-family: var(--kdx-mono, ui-monospace, monospace);
    font-size: 0.62rem;
    color: color-mix(in srgb, var(--kdx-bone, #f0ede8) 62%, transparent);
    align-self: start;
    min-width: 0;
  }
  .kdx-riel__tit {
    margin: 0 0 0.45rem;
    font-size: 0.53rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--riel-accent) 72%, transparent);
  }
  .kdx-riel__pares { margin: 0; display: flex; flex-direction: column; gap: 0.15rem; }
  .kdx-riel__pares > div { display: flex; justify-content: space-between; gap: 0.7rem; }
  .kdx-riel__pares dt { letter-spacing: 0.1em; }
  /* ══ EL INSTRUMENTO SE MIRA, NO SE LEE · 2026-09-03 ═══════════════════
   *
   * Ocín, textual, sobre esta pantalla:
   *   "no se debería sentir como un PPT o páginas con solo los textos,
   *    la idea siempre fue que fuera todo visual, iconos y gráficas y
   *    dinámico. Si auditas y parece quién quiere ser millonario, eso no
   *    es, y estás fallando."
   *
   * Tenía razón y el número lo confirma: 129 textos en una pantalla de
   * 390×844, y 22 de ellos eran este riel -- once filas de ETIQUETA: VALOR.
   * Eso es una tabla, y una tabla se lee. Un instrumento se MIRA.
   *
   * El valor ya no se imprime: se dibuja. Seis segmentos, y la posición
   * del relleno ES el dato. El texto sigue existiendo para el lector de
   * pantalla —un ciego necesita el valor, no el gráfico— pero deja de
   * ocupar la pantalla.
   *
   * No borré ni un dato. Cambié el medio: mismo dato, misma fuente, misma
   * honestidad. Un HUECO se sigue viendo como hueco, ahora en forma de
   * segmentos vacíos en vez de una raya. */
  .kdx-val {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .kdx-medidor {
    --n: 0;
    display: block;
    width: 3.6rem;
    height: 0.42rem;
    /* Seis segmentos dibujados con un solo gradiente: sin seis elementos
       en el DOM por cada fila. Once filas × seis nodos habrían sido 66
       nodos nuevos para resolver un problema de exceso. */
    background:
      repeating-linear-gradient(
        to right,
        currentColor 0 calc((100% - 5 * 2px) / 6),
        transparent 0 calc((100% - 5 * 2px) / 6 + 2px)
      );
    color: color-mix(in srgb, var(--riel-accent) 22%, transparent);
    position: relative;
  }
  /* El relleno: la misma retícula, en color vivo, recortada a --n. */
  .kdx-medidor::after {
    content: '';
    position: absolute;
    inset: 0;
    background: inherit;
    color: var(--riel-accent);
    clip-path: inset(0 calc(100% - var(--n) * 100%) 0 0);
    transition: clip-path 620ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .kdx-medidor::after { transition: none; }
  }
  /* El hueco no se rellena nunca y además se ve más apagado que un cero
     real: un cero medido y un dato ausente NO se ven igual. */
  .kdx-medidor--hueco {
    color: color-mix(in srgb, var(--kdx-bone, #f0ede8) 10%, transparent);
  }
  .kdx-medidor--hueco::after { display: none; }
  /* VERITY es binario, no una escala: un punto, no una barra. */
  .kdx-medidor--punto {
    width: 0.42rem;
    border-radius: 50%;
    background: currentColor;
    color: var(--kdx-ok, #5f9e6e);
  }
  .kdx-medidor--punto::after { display: none; }
  .kdx-medidor--punto[data-mal] { color: var(--kdx-red, #FF3833); }

  .kdx-riel__pares dd {
    margin: 0;
    color: var(--kdx-bone, #f0ede8);
    font-variant-numeric: tabular-nums;
    display: flex;
    align-items: center;
  }
  /* El hueco NO se lee como dato. Esa es la diferencia entre declararlo
     y esconderlo: se ve que falta. */
  .kdx-riel__pares dd[data-fuente='HUECO'] {
    color: color-mix(in srgb, currentColor 40%, transparent);
  }
  /* Telemetria decorativa: marcada con un punto, no disfrazada de medicion. */
  [data-fuente='MOCK']::after {
    content: '·';
    margin-left: 0.35rem;
    color: color-mix(in srgb, var(--riel-accent) 55%, transparent);
  }
  .kdx-riel__grande {
    margin: 0;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--riel-accent);
    font-variant-numeric: tabular-nums;
  }
  .kdx-riel__grande span { font-size: 0.58rem; color: color-mix(in srgb, currentColor 60%, transparent); }
  .kdx-riel__onda { display: block; width: 100%; height: 1.6rem; margin-top: 0.35rem; }
  .kdx-riel__nota { margin: 0.35rem 0 0; font-size: 0.52rem; letter-spacing: 0.08em; }

  @media (max-width: 900px) {
    /* Mobile es composicion TEMPORAL: los rieles se vuelven una franja
       horizontal bajo el organismo, no dos columnas que ahogan el texto. */
    .kdx-riel {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.9rem 1.6rem;
      font-size: 0.56rem;
    }
    .kdx-riel__blq { flex: 1 1 8rem; }
    .kdx-riel__onda { height: 1.1rem; }
  }
</style>

<script>
  import { estadoEscena, type Estado } from '../../../lib/kodex/estado';

  /* Nombres del board para el riel. Los mismos cinco del carril: el riel
     no inventa vocabulario propio. */
  const RITUAL: Record<Estado, string> = {
    idle: 'DORMANT', aware: 'AWARE', locked: 'OPEN',
    active: 'CROSSED', transitionOut: 'REMEMBERED',
  };
  /* Coherencia: intensidad real de la maquina, no un numero decorativo. */
  const COH: Record<Estado, number> = {
    idle: 0.0, aware: 0.34, locked: 0.62, active: 1, transitionOut: 0.5,
  };

  const vistos = new WeakSet<HTMLElement>();

  function ondas() {
    document.querySelectorAll<HTMLCanvasElement>('canvas[data-onda]').forEach((cv) => {
      if (vistos.has(cv)) return;
      vistos.add(cv);
      const ctx = cv.getContext('2d');
      if (!ctx) return;
      const w = cv.width, h = cv.height;
      const resp = cv.dataset.onda === 'respiracion';
      ctx.clearRect(0, 0, w, h);
      ctx.strokeStyle = getComputedStyle(cv).getPropertyValue('--riel-accent')?.trim() || '#7d6a31';
      ctx.globalAlpha = 0.55;
      ctx.lineWidth = 1.3;
      ctx.beginPath();
      for (let x = 0; x < w; x++) {
        let y: number;
        if (resp) {
          y = h / 2 - Math.sin((x / w) * Math.PI * 3) * (h * 0.3);
        } else {
          const p = (x % (w / 4)) / (w / 4);
          y = h / 2 - (p > 0.42 && p < 0.5
            ? h * 0.38 * Math.sin(((p - 0.42) / 0.08) * Math.PI)
            : Math.sin(p * Math.PI * 2) * (h * 0.06));
        }
        x ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.stroke();
    });
  }

  /* pintar() reemplaza a `el.textContent = x`.
   *
   * Escribe el valor donde sigue haciendo falta —el lector de pantalla— y
   * lo TRADUCE a posición de relleno, que es donde ahora se ve. Un solo
   * lugar hace las dos cosas para que no se puedan desincronizar: si
   * alguien cambia el dato y se olvida del gráfico, el gráfico miente. */
  const CADENA = ['DORMANT', 'AWARE', 'FOCUS', 'OPEN', 'CROSSED', 'REMEMBERED'];
  function pintar(el: HTMLElement | null, valor: string, n?: number) {
    if (!el) return;
    const txt = el.querySelector<HTMLElement>('.kdx-val');
    const med = el.querySelector<HTMLElement>('.kdx-medidor');
    if (txt) txt.textContent = valor;
    if (!med) return;
    let f = n;
    if (f === undefined) {
      /* Si el valor pertenece a la cadena canónica, su POSICIÓN en la
         cadena es el dato. Si es un número, el número. Si no es ninguna
         de las dos, no invento una escala: dejo el medidor donde está. */
      const i = CADENA.indexOf(valor.toUpperCase());
      if (i >= 0) f = (i + 1) / CADENA.length;
      else if (/^[\d.]+$/.test(valor)) f = Math.max(0, Math.min(1, parseFloat(valor)));
      else return;
    }
    med.style.setProperty('--n', String(Math.max(0, Math.min(1, f))));
  }

  function enganchar() {
    ondas();

    const carga = document.querySelector<HTMLElement>('[data-kdx-tel-carga]');
    const mem = document.querySelector<HTMLElement>('[data-kdx-tel-mem]');
    const lock = document.querySelector<HTMLElement>('[data-kdx-tel-lock]');
    const ver = document.querySelector<HTMLElement>('[data-kdx-verity]');
    const nota = document.querySelector<HTMLElement>('[data-kdx-verity-nota]');
    const est = document.querySelector<HTMLElement>('[data-kdx-riel-estado]');
    const coh = document.querySelector<HTMLElement>('[data-kdx-riel-coh]');

    /* VERITY CHECK mide algo de verdad: que la escena tenga motor vivo y
       que el carril este enganchado. Si falla, lo dice. Un OK que siempre
       dice OK no verifica nada. */
    if (ver) {
      const hayMotor = typeof estadoEscena === 'function';
      const hayCarril = !!document.querySelector('[data-kdx-carril]');
      const ok = hayMotor && hayCarril;
      pintar(ver, ok ? 'OK' : 'DEGRADED', ok ? 1 : 0);
      /* VERITY es binario: punto, no barra. Y el color lo dice antes que
         cualquier palabra -- que es exactamente el punto de graficar. */
      const p = ver.querySelector<HTMLElement>('.kdx-medidor');
      if (p) { p.classList.add('kdx-medidor--punto'); p.toggleAttribute('data-mal', !ok); }
      if (nota) nota.textContent = ok ? 'ENGINE + RAIL BOUND' : (hayMotor ? 'RAIL NOT BOUND' : 'NO ENGINE');
    }

    pintar(mem, 'OPEN', 1);
    if (carga) {
      /* Carga real del documento: nodos del arbol de la escena. */
      const n = document.querySelectorAll('[data-kx] *').length || document.body.querySelectorAll('*').length;
      const c = Math.min(1, n / 4000);
      pintar(carga, c.toFixed(2), c);
    }

    estadoEscena().suscribir((e: Estado) => {
      pintar(est, RITUAL[e]);
      pintar(coh, COH[e].toFixed(3), COH[e]);
      /* El cerrojo tiene tres posiciones, no seis: media escala por paso. */
      const lk = e === 'idle' ? 'WAITING' : e === 'active' ? 'LOCKED' : 'ARMING';
      pintar(lock, lk, lk === 'LOCKED' ? 1 : lk === 'ARMING' ? 0.5 : 0.15);
    });
  }

  enganchar();
  document.addEventListener('astro:page-load', enganchar);
</script>
