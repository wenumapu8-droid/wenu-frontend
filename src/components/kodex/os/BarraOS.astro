---
/**
 * KODEX−∞ · BARRA DE SISTEMA — el cromo que convierte el sitio en instrumento
 *
 * MECANISMO TOMADO DE cyberspace.online, no su identidad:
 * navegación con teclado primero, paleta de comandos con ⌘K, pista visible de
 * atajos al pie, y modos de visualización. Nada de su marca, tipografía,
 * colores ni copy — sólo la forma de operar.
 *
 * REFERENCE → MECHANISM → KODEX CONTRACT → IMPLEMENTATION:
 *   cyberspace  →  keyboard-first command interface
 *               →  Command Shell: ⌘K · 0-6 · T · I · ESC
 *               →  este componente, en TODAS las páginas del códice
 *
 * Vive en el cromo (no en un lab) porque un sistema operativo se opera desde
 * cualquier pantalla: ésa es la diferencia entre una web y un instrumento.
 *
 * No abre motor nuevo: navega con `location.href` sobre las rutas que ya
 * declara `kodexScenes.js`, y el modo de visualización es un `data-` en el
 * documento que el CSS lee. Cero routers paralelos.
 */
import { scenes } from '../../../lib/kodexScenes.js';

const camaras = [
  { href: '/kodex/strata/', n: 'STRATA', k: 'six layers' },
  { href: '/kodex/lamina/', n: 'PLATES', k: '36 plates' },
  { href: '/kodex/archive/', n: 'ARCHIVE', k: 'living memory' },
  { href: '/kodex/lab/heart/', n: 'HEART', k: 'orientation' },
  { href: '/kodex/lab/altar/', n: 'ALTAR', k: 'offering' },
  { href: '/kodex/lab/temple/', n: 'TEMPLE', k: 'state' },
  { href: '/kodex/lab/semantic-wheel/', n: 'RELATION WHEEL', k: 'instrument' },
  { href: '/kodex/lab/signal-vortex/', n: 'SIGNAL VORTEX', k: 'field' },
  { href: '/kodex/works/', n: 'WORKS', k: 'collection' },
  { href: '/kodex/return/', n: 'RETURN', k: 'signature' },
];
---

<div class="kdx-os" data-kdx-os>
  {/* pista de atajos, siempre visible — como el pie de cyberspace */}
  <div class="kdx-os__hint" data-kdx-os-hint>
    <button type="button" data-kdx-os-open><kbd>⌘K</kbd> COMMANDS</button>
    <span><kbd>0–6</kbd> SCENE</span>
    <span><kbd>I</kbd> INDEX</span>
    <span><kbd>T</kbd> MODE <b data-kdx-os-mode>VOID</b></span>
  </div>

  {/* la paleta */}
  <div class="kdx-os__palette" data-kdx-os-palette hidden role="dialog" aria-modal="true" aria-label="KODEX command palette">
    <div class="kdx-os__panel">
      <div class="kdx-os__field">
        <span aria-hidden="true">›</span>
        <input type="text" data-kdx-os-input placeholder="SCENE · CHAMBER · MODE" aria-label="command" autocomplete="off" spellcheck="false" />
        <kbd>ESC</kbd>
      </div>
      <ul class="kdx-os__list" data-kdx-os-list role="listbox">
        {scenes.map((s) => (
          <li role="option" data-cmd data-href={s.href} data-kind="SCENE" data-key={s.index}>
            <b>{s.index}</b><span>{s.code}</span><small>{s.subtitle}</small><em>SCENE</em>
          </li>
        ))}
        {camaras.map((c) => (
          <li role="option" data-cmd data-href={c.href} data-kind="CHAMBER">
            <b>◈</b><span>{c.n}</span><small>{c.k}</small><em>CHAMBER</em>
          </li>
        ))}
        {['VOID', 'PHOSPHOR', 'AMBER', 'PAPER', 'SIGNAL'].map((m) => (
          <li role="option" data-cmd data-mode={m} data-kind="MODE">
            <b>▦</b><span>{m}</span><small>display mode</small><em>MODE</em>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style is:global>
  /* ── LA FRANJA DE ATAJOS NO EXISTE EN PANTALLA TÁCTIL ───────────────────
     El creador: "los comandos tapan la experiencia y no sirven en móvil
     porque nadie va a teclear con teclado".

     Tiene razón dos veces. Es inútil —⌘K, 0–6, I, T son teclas y en un
     teléfono no hay teclado— y además ocupa la franja inferior, que es
     justamente por la que se venían peleando la barra del mazo, la boca del
     descenso y el CTA de la escena. Sacarla no sólo quita ruido: libera el
     borde que estaba sobrecargado.

     Los atajos SIGUEN funcionando donde hay teclado. Lo que desaparece es el
     cartel que los anuncia donde no sirven. Y la paleta de comandos sigue
     alcanzable en escritorio con ⌘K.

     `hover:none` o `pointer:coarse` es la pregunta correcta —¿hay un puntero
     fino?— y no el ancho de pantalla: un teléfono en apaisado sigue siendo un
     teléfono. */
  @media (hover:none), (pointer:coarse){
    .kdx-os__hint{ display:none !important; }
  }
  .kdx-os__hint{
    position:fixed; left:0; right:0; bottom:0; z-index:150;
    display:flex; gap:18px; align-items:center; flex-wrap:wrap;
    padding:9px clamp(12px,3vw,26px);
    background:rgba(6,6,8,.86); backdrop-filter:blur(8px);
    border-top:1px solid rgba(237,237,237,.12);
    font-family:'JetBrains Mono','IBM Plex Mono',ui-monospace,monospace;
    font-size:10px; letter-spacing:.16em; color:rgba(237,237,237,.5);
  }
  .kdx-os__hint button{ font:inherit; letter-spacing:.16em; color:rgba(237,237,237,.72);
    background:transparent; border:0; cursor:pointer; padding:8px 0; min-height:44px;
    display:inline-flex; align-items:center; gap:8px; }
  .kdx-os__hint button:hover{ color:#fff; }
  .kdx-os__hint span{ display:inline-flex; align-items:center; gap:7px; }
  .kdx-os__hint b{ color:var(--kdx-cyan,#00F0FF); font-weight:400; }
  .kdx-os kbd{ font:inherit; font-size:9.5px; padding:3px 6px; border:1px solid rgba(237,237,237,.24);
    color:rgba(237,237,237,.8); border-radius:2px; }
  @media (max-width:560px){ .kdx-os__hint span:nth-child(3){ display:none; } }

  .kdx-os__palette{ position:fixed; inset:0; z-index:220; display:grid; place-items:start center;
    padding:12vh 16px 16px; background:rgba(6,6,8,.9); backdrop-filter:blur(10px); }
  .kdx-os__palette[hidden]{ display:none; }
  .kdx-os__panel{ width:min(680px,96vw); border:1px solid rgba(237,237,237,.18); background:#0a0a0c;
    font-family:'JetBrains Mono','IBM Plex Mono',ui-monospace,monospace; }
  .kdx-os__field{ display:flex; align-items:center; gap:10px; padding:14px 16px;
    border-bottom:1px solid rgba(237,237,237,.14); color:var(--kdx-cyan,#00F0FF); }
  .kdx-os__field input{ flex:1; background:transparent; border:0; outline:0; color:#ededed;
    font:inherit; font-size:14px; letter-spacing:.1em; }
  .kdx-os__list{ list-style:none; margin:0; padding:0; max-height:52vh; overflow-y:auto; }
  .kdx-os__list li{ display:grid; grid-template-columns:34px 1fr auto; gap:10px; align-items:baseline;
    padding:11px 16px; min-height:44px; cursor:pointer; border-bottom:1px solid rgba(237,237,237,.05); }
  .kdx-os__list li[data-on]{ background:rgba(0,240,255,.07); }
  .kdx-os__list li b{ color:var(--kdx-cyan,#00F0FF); font-weight:400; font-size:12px; }
  .kdx-os__list li span{ color:#ededed; font-size:12.5px; letter-spacing:.14em; }
  .kdx-os__list li small{ display:block; color:rgba(237,237,237,.42); font-size:10px; letter-spacing:.06em; margin-top:2px; }
  .kdx-os__list li em{ font-style:normal; color:rgba(237,237,237,.32); font-size:9px; letter-spacing:.2em; }
  .kdx-os__list li[hidden]{ display:none; }

  /* MODOS DE VISUALIZACIÓN — no son siete temas compitiendo: son formas de
     VER el mismo sistema, como los modos de un instrumento. */
  html[data-kdx-mode="PHOSPHOR"]{ filter:hue-rotate(86deg) saturate(1.5); }
  html[data-kdx-mode="AMBER"]{ filter:sepia(.62) saturate(1.7) hue-rotate(-14deg); }
  html[data-kdx-mode="PAPER"]{ filter:invert(1) hue-rotate(180deg) contrast(.88); }
  html[data-kdx-mode="SIGNAL"]{ filter:contrast(1.22) saturate(1.35); }
</style>

<script is:inline>
  (() => {
    const raiz = document.querySelector('[data-kdx-os]');
    if (!raiz) return;
    const pal = raiz.querySelector('[data-kdx-os-palette]');
    const inp = raiz.querySelector('[data-kdx-os-input]');
    const items = [...raiz.querySelectorAll('[data-cmd]')];
    const modo = raiz.querySelector('[data-kdx-os-mode]');
    let i = 0;

    const visibles = () => items.filter((e) => !e.hidden);
    const marcar = () => {
      const v = visibles();
      items.forEach((e) => e.removeAttribute('data-on'));
      if (v[i]) { v[i].setAttribute('data-on', ''); v[i].scrollIntoView({ block: 'nearest' }); }
    };
    const abrir = () => { pal.hidden = false; inp.value = ''; items.forEach((e) => (e.hidden = false)); i = 0; marcar(); inp.focus(); };
    const cerrar = () => { pal.hidden = true; inp.blur(); };
    const ponerModo = (m) => {
      document.documentElement.dataset.kdxMode = m;
      if (modo) modo.textContent = m;
      try { localStorage.setItem('kdx-mode', m); } catch (_) {}
    };
    const ejecutar = (el) => {
      if (!el) return;
      if (el.dataset.mode) { ponerModo(el.dataset.mode); cerrar(); return; }
      if (el.dataset.href) location.href = el.dataset.href;
    };

    try { const g = localStorage.getItem('kdx-mode'); if (g) ponerModo(g); } catch (_) {}

    raiz.querySelector('[data-kdx-os-open]')?.addEventListener('click', abrir);
    raiz.querySelector('[data-kdx-os-close]')?.addEventListener('click', cerrar);
    pal.addEventListener('click', (e) => { if (e.target === pal) cerrar(); });
    items.forEach((el) => el.addEventListener('click', () => ejecutar(el)));

    inp.addEventListener('input', () => {
      const q = inp.value.trim().toLowerCase();
      items.forEach((e) => { e.hidden = q ? !e.textContent.toLowerCase().includes(q) : false; });
      i = 0; marcar();
    });

    addEventListener('keydown', (e) => {
      const escribiendo = /^(INPUT|TEXTAREA)$/.test(document.activeElement?.tagName || '');
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); pal.hidden ? abrir() : cerrar(); return; }
      if (!pal.hidden) {
        if (e.key === 'Escape') { e.preventDefault(); cerrar(); }
        else if (e.key === 'ArrowDown') { e.preventDefault(); i = Math.min(i + 1, visibles().length - 1); marcar(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); i = Math.max(i - 1, 0); marcar(); }
        else if (e.key === 'Enter') { e.preventDefault(); ejecutar(visibles()[i]); }
        return;
      }
      if (escribiendo || e.metaKey || e.ctrlKey || e.altKey) return;
      /* atajos globales: el sitio se opera sin mouse */
      if (/^[0-6]$/.test(e.key)) {
        const s = items.find((el) => el.dataset.kind === 'SCENE' && el.dataset.key === '0' + e.key);
        if (s) { e.preventDefault(); ejecutar(s); }
      } else if (e.key.toLowerCase() === 't') {
        const M = ['VOID', 'PHOSPHOR', 'AMBER', 'PAPER', 'SIGNAL'];
        ponerModo(M[(M.indexOf(document.documentElement.dataset.kdxMode || 'VOID') + 1) % M.length]);
      } else if (e.key.toLowerCase() === 'i') {
        document.querySelector('[data-kdx-index-open]')?.click();
      }
    });
  })();
</script>

<style is:global>
  /* ── LA FRANJA DE ABAJO ES DE UNO SOLO ────────────────────────────────────
     Medido a 390×844 en la página de llegada: `nav.kx-deckbar` en y=776 con 44
     de alto, y `.kdx-os__hint` en y=781 con 63. Encimadas. De ahí salían los
     seis peores solapamientos de esa página: COMMANDS sobre ESCRITURA al 100%,
     NEXT › sobre VOID al 94%, ‹ PREVIOUS sobre 0–6 al 57%.

     Dos superficies reclamando el mismo borde. La barra de pistas del OS es del
     sistema y está en todas partes; la del mazo es de la escena. Cede la del
     mazo, que es la local — la misma regla que ya se aplicó cuando la barra de
     KDX.LIFE chocaba con NEXT PLATE en las láminas.

     Va en hoja global y no scoped porque `.kx-deckbar` no es de este componente
     y un <style> con scope de Astro nunca la alcanzaría. */
  .kx-deckbar{
    bottom: calc(66px + env(safe-area-inset-bottom, 0px)) !important;
  }
  /* Sin la franja de atajos, la barra del mazo recupera el borde: la reserva
     de 66px existía sólo para no chocar con ella. */
  @media (hover:none), (pointer:coarse){
    .kx-deckbar{ bottom: calc(10px + env(safe-area-inset-bottom, 0px)) !important; }
  }
  /* Y la línea de tiempo, que vive pegada al borde, pasa por debajo de las dos. */
  .kx-timeline{ z-index: 1; }
</style>
