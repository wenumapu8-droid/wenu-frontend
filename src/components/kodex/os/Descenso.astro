---
/**
 * KODEX−∞ · DESCENSO — la placa de bifurcación
 *
 * EL PEDIDO, textual: "hasta ahora uno va hacia el lado y necesitamos que vaya
 * hacia dentro, y que las 7 escenas se ramifiquen y encontremos más y más en
 * cada una hasta encontrar al medio el corazón".
 *
 * Esto es la JUNCTION PLATE de §20 del documento de navegación profunda:
 * propósito agencia, densidad baja-a-media, 2–5 candidatos, y el evento de
 * memoria se registra CON las alternativas visibles al momento de decidir —
 * porque lo que no elegiste también es parte de tu ruta.
 *
 * NADA SE BORRA: el pasillo lateral de las siete escenas sigue intacto y sigue
 * andando. Esto se monta ENCIMA como una segunda salida. Quien no quiera bajar,
 * sigue de largo como siempre.
 *
 * MÓVIL PRIMERO, porque el creador acaba de decir que en móvil estaba roto: se
 * compone a 100dvh sin scroll, las puertas son bloques de dedo, y la espiral se
 * dibuja en canvas para no cargar el DOM con cientos de nodos.
 */
interface Props {
  /** la escena por cuya boca se entra: i … vi */
  escena: string;
  /** rótulo de la escena, ya en inglés como el resto del sitio */
  etiqueta?: string;
}
const { escena, etiqueta = '' } = Astro.props;
---

<button class="kdx-boca" type="button" data-kdx-abrir-descenso
  data-kdx-escena={escena} data-kdx-etiqueta={etiqueta}
  aria-haspopup="dialog" aria-controls="kdx-descenso">
  <span class="kdx-boca__g" aria-hidden="true">◎</span>
  <span class="kdx-boca__t">DESCEND INTO {etiqueta || 'THIS SCENE'}</span>
  <span class="kdx-boca__d">↓</span>
</button>

<!-- La PLACA ya no vive acá. La construye `descenso-ui.ts` en tiempo de
     ejecución, para que la misma placa se pueda abrir desde una escena o desde
     una lámina. Antes había dos interfaces para el mismo motor. -->

<script>
  import { montarDescenso } from '../../../lib/kodex/descenso-ui';
  montarDescenso();
</script>
