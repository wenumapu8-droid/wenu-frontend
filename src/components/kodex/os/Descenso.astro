---
/**
 * KODEX−∞ · DESCENSO — la placa de bifurcación
 *
 * EL PEDIDO, textual: "hasta ahora uno va hacia el lado y necesitamos que vaya
 * hacia dentro, y que las 7 escenas se ramifiquen y encontremos más y más en
 * cada una hasta encontrar al medio el corazón".
 *
 * Esto es la JUNCTION PLATE de §20 del documento de navegación profunda:
 * propósito agencia, densidad baja-a-media, 2–5 candidatos, y el evento de
 * memoria se registra CON las alternativas visibles al momento de decidir —
 * porque lo que no elegiste también es parte de tu ruta.
 *
 * NADA SE BORRA: el pasillo lateral de las siete escenas sigue intacto y sigue
 * andando. Esto se monta ENCIMA como una segunda salida. Quien no quiera bajar,
 * sigue de largo como siempre.
 *
 * MÓVIL PRIMERO, porque el creador acaba de decir que en móvil estaba roto: se
 * compone a 100dvh sin scroll, las puertas son bloques de dedo, y la espiral se
 * dibuja en canvas para no cargar el DOM con cientos de nodos.
 */
interface Props {
  /** la escena por cuya boca se entra: i … vi */
  escena: string;
  /** rótulo de la escena, ya en inglés como el resto del sitio */
  etiqueta?: string;
}
const { escena, etiqueta = '' } = Astro.props;
---

<button class="kdx-boca" type="button" data-kdx-abrir-descenso
  aria-haspopup="dialog" aria-controls="kdx-descenso">
  <span class="kdx-boca__g" aria-hidden="true">◎</span>
  <span class="kdx-boca__t">DESCEND INTO {etiqueta || 'THIS SCENE'}</span>
  <span class="kdx-boca__d">↓</span>
</button>

<div class="kdx-desc" id="kdx-descenso" role="dialog" aria-modal="true"
  aria-label="Descent" hidden data-escena={escena}>

  <canvas class="kdx-desc__espiral" aria-hidden="true"></canvas>

  <header class="kdx-desc__cab">
    <button class="kdx-desc__salir" type="button" data-kdx-cerrar-descenso>← ASCEND</button>
    <p class="kdx-desc__medida">
      <span data-kdx-hondura>DEPTH 0</span>
      <span aria-hidden="true">·</span>
      <span data-kdx-firma>ROUTE 0000</span>
    </p>
  </header>

  <main class="kdx-desc__centro">
    <p class="kdx-desc__ojo" data-kdx-ojo>THE SCENE OPENS</p>
    <h2 class="kdx-desc__aqui" data-kdx-aqui>CHOOSE YOUR DESCENT</h2>
    <p class="kdx-desc__pie-t" data-kdx-sub>Three ways in. None of them is the same for two people.</p>

    <ul class="kdx-desc__puertas" data-kdx-puertas role="list"></ul>

    <p class="kdx-desc__nota" data-kdx-nota></p>
  </main>

  <footer class="kdx-desc__pie">
    <span data-kdx-rastro>NO TRACE YET</span>
    <a class="kdx-desc__corazon" href="/kodex/lab/heart/" hidden data-kdx-corazon>◉ THE HEART →</a>
  </footer>
</div>

<style>
  /* La boca: la segunda salida de la escena. Convive con el "NEXT →" lateral
     que ya existía — una va hacia el lado, esta va hacia dentro. */
  .kdx-boca{
    position:fixed; left:50%; bottom:calc(58px + env(safe-area-inset-bottom,0px));
    transform:translateX(-50%); z-index:8;
    display:inline-flex; align-items:center; gap:10px;
    min-height:48px; padding:12px 20px;
    background:rgba(6,6,8,.72); backdrop-filter:blur(6px);
    border:1px solid rgba(240,237,232,.2); color:rgba(240,237,232,.82);
    font:11px/1 var(--lam-mono, ui-monospace, monospace); letter-spacing:.2em;
    cursor:pointer; max-width:92vw;
  }
  .kdx-boca:hover,.kdx-boca:focus-visible{ color:#fff; border-color:#ff2733; }
  .kdx-boca__g{ color:#ff2733; font-size:13px; }
  .kdx-boca__t{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .kdx-boca__d{ opacity:.55; }
  /* la boca late despacio: señala que hay algo debajo sin gritarlo */
  @media (prefers-reduced-motion:no-preference){
    .kdx-boca__g{ animation:kdx-latir 3.8s ease-in-out infinite; }
    @keyframes kdx-latir{ 0%,100%{opacity:.55;transform:scale(1)} 50%{opacity:1;transform:scale(1.22)} }
  }
  html[data-kdx-frozen] .kdx-boca{ display:none; }

  /* ── la placa de descenso: 100dvh compuesto, sin scroll de documento ──── */
  /* La placa se monta dentro de páginas que ya traen su propia cascada, y
     medido en pantalla el texto salía en serif: algo más específico ganaba.
     Por eso la familia se declara en la placa Y en cada hoja de texto, en vez
     de confiar en que herede. Se vio en la captura, no en el código. */
  .kdx-desc{
    position:fixed; inset:0; z-index:60;
    display:grid; grid-template-rows:auto 1fr auto;
    background:#050507; color:#f0ede8;
    font-family:'IBM Plex Mono',ui-monospace,monospace;
    overflow:hidden;
  }
  .kdx-desc :where(p,span,button,a,li,h2){ font-family:inherit; }
  .kdx-desc[hidden]{ display:none; }
  .kdx-desc__espiral{ position:absolute; inset:0; width:100%; height:100%; opacity:.5; pointer-events:none; }

  .kdx-desc__cab{ position:relative; z-index:2; display:flex; justify-content:space-between;
    align-items:center; gap:12px; padding:12px clamp(14px,4vw,32px);
    padding-top:calc(12px + env(safe-area-inset-top,0px));
    border-bottom:1px solid rgba(240,237,232,.1); }
  .kdx-desc__salir{ background:none; border:1px solid rgba(240,237,232,.18);
    color:rgba(240,237,232,.7); font:10.5px/1 inherit; letter-spacing:.2em;
    min-height:44px; padding:0 14px; cursor:pointer; }
  .kdx-desc__salir:hover{ color:#fff; border-color:rgba(240,237,232,.5); }
  .kdx-desc__medida{ margin:0; display:flex; gap:8px; font-size:10px; letter-spacing:.18em;
    color:rgba(240,237,232,.45); font-variant-numeric:tabular-nums; }

  .kdx-desc__centro{ position:relative; z-index:2; display:flex; flex-direction:column;
    justify-content:center; gap:clamp(10px,2vh,18px);
    width:min(96vw,760px); margin:0 auto; padding:clamp(16px,3vh,28px) clamp(14px,4vw,24px);
    min-height:0; }
  .kdx-desc__ojo{ margin:0; font-size:10px; letter-spacing:.28em; color:#ff2733; }
  .kdx-desc__aqui{ margin:0; font-family:'Barlow Condensed','Inter Tight',system-ui,sans-serif !important;
    font-weight:800; font-size:clamp(26px,7vw,46px); line-height:1.02; letter-spacing:.01em;
    text-wrap:balance; }
  .kdx-desc__pie-t{ margin:0; font-size:11px; line-height:1.6; letter-spacing:.04em;
    color:rgba(240,237,232,.5); max-width:52ch; }

  /* Las tres puertas. En móvil van apiladas y son bloques de dedo; en pantalla
     ancha se abren en tres columnas — la misma decisión, otra respiración. */
  .kdx-desc__puertas{ list-style:none; margin:0; padding:0; display:grid; gap:8px;
    grid-template-columns:1fr; align-content:start; }
  @media (min-width:720px){ .kdx-desc__puertas{ grid-template-columns:repeat(3,1fr); gap:10px; } }

  /* Medido 51px de alto cuando la declaración decía 76: el grid comprimía la
     fila. `align-content:start` en la lista deja que cada puerta ocupe lo suyo. */
  .kdx-desc__nota{ margin:0; font-size:10px; line-height:1.6; letter-spacing:.06em;
    color:rgba(240,237,232,.34); }

  .kdx-desc__pie{ position:relative; z-index:2; display:flex; justify-content:space-between;
    align-items:center; gap:10px; padding:10px clamp(14px,4vw,32px);
    /* La barra del OS vive fija abajo con su franja de pistas; sin este colchón
       el pie del descenso quedaba tapado y el enlace al corazón era invisible. */
    padding-bottom:calc(46px + env(safe-area-inset-bottom,0px));
    border-top:1px solid rgba(240,237,232,.1);
    font-size:9.5px; letter-spacing:.16em; color:rgba(240,237,232,.4); }
  .kdx-desc__corazon{ color:#ff2733; text-decoration:none; letter-spacing:.2em;
    min-height:44px; display:inline-flex; align-items:center; padding:0 12px;
    border:1px solid rgba(255,39,51,.5); font-size:11px; }
  .kdx-desc__corazon:hover{ background:rgba(255,39,51,.12); color:#fff; }
  .kdx-desc__corazon[hidden]{ display:none; }

  /* Muy angosto: el subtítulo cede antes que las puertas. */
  @media (max-height:640px){ .kdx-desc__pie-t{ display:none; } }
</style>

<style is:global>
  /* ── por qué is:global ──────────────────────────────────────────────────
     Las tres puertas las crea `descenso-ui.ts` en tiempo de ejecución, así que
     nunca llevan el atributo de scope que Astro le estampa al markup de este
     archivo. Dentro del <style> scoped estas reglas NO se aplicaban: en la
     captura el texto salía corrido, centrado y sin borde. Se vio mirando la
     pantalla — el build no dice nada de esto. */
  .kdx-p{
    display:flex; flex-direction:column; gap:6px; align-items:flex-start;
    width:100%; min-height:76px; box-sizing:border-box; padding:14px 16px;
    text-align:left; cursor:pointer;
    background:rgba(240,237,232,.02); border:1px solid rgba(240,237,232,.16);
    color:#f0ede8; font:11px/1.4 'IBM Plex Mono',ui-monospace,monospace;
    transition:border-color .22s ease, background .22s ease, transform .22s ease;
  }
  .kdx-p:hover,.kdx-p:focus-visible{
    border-color:var(--kdx-p-color,#ff2733);
    background:rgba(255,39,51,.06); transform:translateY(-2px);
  }
  .kdx-p__papel{
    display:inline-flex; align-items:center; gap:6px;
    font-size:9px; letter-spacing:.24em; color:var(--kdx-p-color,#ff2733);
  }
  /* El glifo gira, y gira MÁS RÁPIDO cuanto más hondo estás: la aceleración no
     es un efecto, es el dato de profundidad hecho movimiento. Al tocar la
     puerta se acelera cuatro veces — la puerta responde antes de abrirse. */
  .kdx-p__glifo{ display:inline-block; }
  @media (prefers-reduced-motion:no-preference){
    .kdx-p__glifo{ animation:kdx-girar var(--kdx-giro,9s) linear infinite; }
    .kdx-p:hover .kdx-p__glifo,.kdx-p:focus-visible .kdx-p__glifo{
      animation-duration:calc(var(--kdx-giro,9s) / 4);
    }
    @keyframes kdx-girar{ to{ transform:rotate(360deg); } }
  }
  .kdx-p__t{ font-size:14px; letter-spacing:.06em; line-height:1.3; }
  .kdx-p__t--anon{ color:rgba(240,237,232,.6); font-style:italic; }
  .kdx-p__meta{
    display:flex; flex-wrap:wrap; gap:4px 10px;
    font-size:9px; letter-spacing:.14em; color:rgba(240,237,232,.42);
  }
  /* El estatus epistémico va SIEMPRE visible: regla de canon, nada se resuelve
     en silencio. Lo especulativo no se esconde, se rotula. */
  .kdx-p__est{ padding:2px 6px; border:1px solid currentColor; }
  .kdx-p__est[data-e="SPECULATIVE"]{ color:#c98b4c; }
  .kdx-p__est[data-e="INFERRED"]{ color:#8ba0c9; }
  .kdx-p__est[data-e="NEEDS_CONFIRMATION"]{ color:#c9c04c; }
</style>

<script>
  import { montarDescenso } from '../../../lib/kodex/descenso-ui';
  montarDescenso();
</script>
