---
/**
 * KODEX−∞ · TÍTULO CINÉTICO — "TYPE IS MATTER"
 *
 * MECANISMO TOMADO DE spacetypegenerator (Morisawa), no su identidad:
 * un texto entra a un sistema de parámetros y sale como composición
 * tipográfica cinética. Nada de sus presets, fuentes, marca ni visuales.
 *
 * REFERENCE → MECHANISM → KODEX CONTRACT → IMPLEMENTATION:
 *   space type generator → semantic input → parameters → kinetic type
 *                        → TITLE ENGINE: un OPERADOR por escena
 *                        → este componente, sobre el título REAL de la escena
 *
 * Los siete operadores son de KODEX, no nombres copiados, y cada uno dice algo
 * de su escena — el título deja de ser una etiqueta y pasa a ser estado:
 *
 *   APERTURE  el umbral se abre     · las letras se separan desde el centro
 *   SCAN      el prólogo observa    · un barrido las recorre una por una
 *   VORTEX    el descenso gira      · caen y rotan hacia dentro
 *   STRATA    el archivo se apila   · entran por capas desplazadas
 *   ASSEMBLY  la máquina ensambla   · se montan desde piezas
 *   ORBIT     la cosmología rota    · describen un arco
 *   RECALL    el retorno recuerda   · reaparecen como desde la memoria
 *
 * REDUCED MOTION: no se apaga, se vuelve estado — las letras llegan a su sitio
 * sin recorrido. El título sigue comunicando su operador por el trazo.
 */
interface Props {
  texto: string;
  /** id del <h1>. Necesario cuando una seccion lo referencia por
   *  aria-labelledby, como hace el umbral. */
  id?: string;
  operador?: 'APERTURE' | 'SCAN' | 'VORTEX' | 'STRATA' | 'ASSEMBLY' | 'ORBIT' | 'RECALL';
  etiqueta?: string;
  clase?: string;
}
const { texto, operador = 'APERTURE', etiqueta, clase = '', id } = Astro.props;
/* Las letras se agrupan POR PALABRA. Sueltas, el flex parte las palabras a la
   mitad ("TO HOLD W / HAT RISES") — se vio en la primera captura. El índice `k`
   sigue siendo global para que la ola de la animación cruce el título entero. */
const palabras = texto.split(' ');
const total = [...texto].length;
let cursor = 0;
const grupos = palabras.map((w) => {
  const g = { texto: w, desde: cursor };
  cursor += w.length + 1;
  return g;
});
---

<div class={`kdx-tt ${clase}`} data-kdx-titulo data-op={operador}>
  {etiqueta && <p class="kdx-tt__op">{etiqueta} · <b>{operador}</b></p>}
  <h1 class="kdx-tt__h" id={id} aria-label={texto}>
    {grupos.map((g) => (
      <span class="kdx-tt__w" aria-hidden="true">
        {[...g.texto].map((ch, j) => {
          const k = g.desde + j;
          return <span class="kdx-tt__l" style={`--k:${k};--n:${total};--mid:${(k - (total - 1) / 2).toFixed(2)}`}>{ch}</span>;
        })}
      </span>
    ))}
  </h1>
</div>

<style is:global>
  .kdx-tt{ position:relative; }
  .kdx-tt__op{ margin:0 0 .5em; font-family:'JetBrains Mono','IBM Plex Mono',ui-monospace,monospace;
    font-size:10px; letter-spacing:.28em; color:rgba(237,237,237,.42); }
  .kdx-tt__op b{ color:var(--kdx-scene-accent,var(--kdx-cyan,#00F0FF)); font-weight:400; }
  .kdx-tt__h{ margin:0; display:flex; flex-wrap:wrap; gap:0 .28em; line-height:.92; }
  /* la palabra es la unidad indivisible: adentro no se corta nunca */
  .kdx-tt__w{ display:inline-flex; white-space:nowrap; }
  .kdx-tt__l{ display:inline-block; will-change:transform,opacity;
    animation:kdx-tt-in .9s cubic-bezier(.16,.84,.24,1) both;
    animation-delay:calc(var(--k) * 42ms); }

  /* APERTURE — se abren desde el centro: el umbral separándose */
  .kdx-tt[data-op="APERTURE"] .kdx-tt__l{ animation-name:kdx-op-aperture; }
  @keyframes kdx-op-aperture{ from{ opacity:0; transform:translateX(calc(var(--mid) * -14px)) scaleX(.7); letter-spacing:-.06em }
    to{ opacity:1; transform:none } }

  /* SCAN — un barrido las revela en orden, como el haz de un sensor */
  .kdx-tt[data-op="SCAN"] .kdx-tt__l{ animation-name:kdx-op-scan; animation-delay:calc(var(--k) * 62ms); }
  @keyframes kdx-op-scan{ 0%{ opacity:0; filter:blur(5px) } 40%{ opacity:1; filter:blur(0) }
    55%{ opacity:.45 } 100%{ opacity:1; filter:none } }

  /* VORTEX — caen girando hacia dentro */
  .kdx-tt[data-op="VORTEX"] .kdx-tt__l{ animation-name:kdx-op-vortex; }
  @keyframes kdx-op-vortex{ from{ opacity:0; transform:translateY(-46px) rotate(calc(var(--mid) * 9deg)) scale(.72) }
    to{ opacity:1; transform:none } }

  /* STRATA — entran por capas, desplazadas: el archivo apilándose */
  .kdx-tt[data-op="STRATA"] .kdx-tt__l{ animation-name:kdx-op-strata;
    animation-delay:calc(var(--k) * 30ms + (var(--k) * 17ms)); }
  @keyframes kdx-op-strata{ from{ opacity:0; transform:translateY(26px) }
    60%{ opacity:1; transform:translateY(-3px) } to{ opacity:1; transform:none } }

  /* ASSEMBLY — se montan desde piezas separadas */
  .kdx-tt[data-op="ASSEMBLY"] .kdx-tt__l{ animation-name:kdx-op-assembly; }
  @keyframes kdx-op-assembly{ from{ opacity:0; transform:translate(calc(var(--mid) * 7px), 18px) scale(1.3) }
    70%{ opacity:1; transform:translate(0,-2px) scale(.98) } to{ opacity:1; transform:none } }

  /* ORBIT — describen un arco antes de asentar */
  .kdx-tt[data-op="ORBIT"] .kdx-tt__l{ animation-name:kdx-op-orbit; animation-duration:1.1s; }
  @keyframes kdx-op-orbit{ from{ opacity:0; transform:translate(calc(var(--mid) * 12px), calc(var(--mid) * var(--mid) * 1.6px)) rotate(calc(var(--mid) * -6deg)) }
    to{ opacity:1; transform:none } }

  /* RECALL — reaparecen desde la memoria, no desde afuera */
  .kdx-tt[data-op="RECALL"] .kdx-tt__l{ animation-name:kdx-op-recall; animation-duration:1.3s; }
  @keyframes kdx-op-recall{ 0%{ opacity:0; filter:blur(9px); transform:scale(1.08) }
    45%{ opacity:.3; filter:blur(3px) } 100%{ opacity:1; filter:none; transform:none } }

  /* El movimiento reducido no apaga el título: lo entrega ya asentado. */
  @media (prefers-reduced-motion:reduce){
    .kdx-tt__l{ animation:none !important; opacity:1 !important; transform:none !important; filter:none !important; }
  }
</style>
