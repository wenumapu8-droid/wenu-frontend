---
/**
 * KODEX−∞ · CAMPO DE LA PORTADA
 *
 * Este es el prototipo que el creador aprobó y pidió tres veces:
 * `kodex-threshold-live.html`. No es "inspirado en": es su shader, portado
 * entero al sitio -- el warp radial del portal, el mandala, y encima el
 * tratamiento que le da el look de código: pixelado por bloques, dither Bayer
 * sobre la luminancia, scanlines, aberración cromática, grano y viñeta.
 *
 * Su frase: "este es la portada, la entrada, por favor, me gusta mucho".
 *
 * QUÉ CAMBIA RESPECTO DEL PROTOTIPO
 * Nada del shader. Lo que cambia es dónde vive: en el prototipo ocupaba la
 * página entera como demo; acá es el fondo del velo del umbral, y encima va la
 * tipografía viva. El campo respira detrás de la palabra, que es como se ve en
 * su captura.
 *
 * EL AUDIO NO SE MONTA ACÁ. El umbral ya tiene su propia decisión de sonido --
 * las dos puertas, TAP TO ENTER y CONTINUE IN SILENCE -- y arrancar un drone
 * antes de que el visitante elija sería exactamente lo que el manifiesto
 * prohíbe: el sistema decidiendo por él. El campo expone `window.__kdxCampo`
 * para que quien maneje el sonido le pase la energía cuando corresponda.
 */
interface Props {
  /** 0 a 1. Cuánta intensidad tiene el campo. El umbral entra bajo. */
  estado?: number;
  class?: string;
}
const { estado = 0.15, class: klass = '' } = Astro.props;
---

<canvas
  class:list={['kdx-campo', klass]}
  data-kdx-campo
  data-kdx-campo-estado={estado}
  aria-hidden="true"
></canvas>

<style is:global>
  .kdx-campo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    pointer-events: none;
  }
  /* Sin WebGL el canvas queda vacío y transparente: detrás sigue estando el
     fondo del velo, así que la escena nunca se queda en blanco. */
</style>

<script>
  /* Port fiel del prototipo. Los comentarios del creador sobre su propio
     shader se conservan donde estaban. */
  const VERT = `#version 300 es
in vec2 p; out vec2 v_uv; void main(){ v_uv=p*0.5+0.5; gl_Position=vec4(p,0.,1.); }`;

  const FRAG = `#version 300 es
precision highp float;
in vec2 v_uv; out vec4 o;
uniform vec2 u_res; uniform float u_time; uniform float u_seed;
uniform vec2 u_pointer; uniform float u_bass; uniform float u_state;
uniform float u_px; uniform float u_exp;

float hash21(vec2 p){ p=fract(p*vec2(234.34,435.345)); p+=dot(p,p+34.23); return fract(p.x*p.y); }
float bayer(vec2 c){
  int x=int(mod(c.x,4.)), y=int(mod(c.y,4.));
  int i=x+y*4;
  float m[16]=float[16](0.,8.,2.,10.,12.,4.,14.,6.,3.,11.,1.,9.,15.,7.,13.,5.);
  return m[i]/16.-0.5;
}
float mandala(vec2 c){
  float r=length(c); float a=atan(c.y,c.x);
  float rings=smoothstep(.02,.0,abs(fract(r*6.0-u_time*0.02)-0.5)-0.42);
  float spokes=smoothstep(.55,1.,abs(sin(a*12.0)));
  float petals=smoothstep(.35,.0,abs(r-0.34-0.05*sin(a*8.0+u_time*0.1)));
  float cross=smoothstep(.012,.0,abs(c.x))+smoothstep(.012,.0,abs(c.y));
  float core=smoothstep(.10,.06,r);
  float m=max(max(rings*0.7, petals), max(spokes*smoothstep(.5,.15,r), core));
  m=max(m, cross*smoothstep(.5,.0,r)*0.6);
  return clamp(m,0.,1.);
}
void main(){
  vec2 res=u_res;
  vec2 frag=gl_FragCoord.xy;
  vec2 blk=floor(frag/u_px)*u_px + u_px*0.5;
  vec2 uv=blk/res;
  /* LA CÁMARA, NO LA OBRA.
     El original hacía  c.x *= res.x/res.y  -- bien en apaisado, pero en
     vertical achica el eje corto: el radio nunca llega a 1, la viñeta no cierra
     y la pantalla queda inundada de rojo. Medido en 390x844: un muro.
     Se normaliza por el lado CORTO. La figura conserva su proporción -- sigue
     siendo circular, no se estira -- y el encuadre se extiende por el lado
     largo, que es donde debe oscurecer. Regla del creador: si no cabe, se
     mueve la cámara. */
  vec2 c=(uv-0.5)*(res/max(1.,min(res.x,res.y)));

  float radius=length(c); float angle=atan(c.y,c.x);
  float breathe=sin(u_time*mix(.12,.28,u_state))*mix(.02,.08,u_state);
  float bassPulse=u_bass*mix(.05,.20,u_state);
  float polarWarp=mix(.06,.24,u_state)*sin(angle*4.+u_time*.18+u_seed*6.283);
  float pointerPull=dot(c,u_pointer)*0.12;
  float wr=radius*(1.-breathe-bassPulse)+polarWarp*0.5;
  float wa=angle+pointerPull+sin(radius*11.-u_time*.22)*.06;
  vec2 sUv=vec2(cos(wa),sin(wa))*wr;

  float mask=mandala(sUv);
  float ring=smoothstep(.72,.18,radius);
  float halo=exp(-8.*abs(radius-0.22-bassPulse*0.5));
  float grain=(hash21(frag+u_seed*100.)-0.5)*0.05;

  vec3 base=mix(vec3(.02,.008,.008), vec3(.85,.09,.10), mask);
  base+=vec3(1.,.26,.14)*halo*(0.35+0.5*u_state)*(0.6+u_bass);
  base*=ring; base+=grain;

  float lum=dot(base,vec3(.299,.587,.114));
  float d=bayer(frag/u_px);
  float q=step(0.5, fract(lum*5.0 + d));
  base*= (0.72+0.42*q);

  float scan=0.82+0.18*sin(frag.y*0.9 + u_time*2.0);
  base*=scan;

  base.r*=1.04; base.b+=mask*0.08+halo*0.06;
  base*=smoothstep(1.15,.25,length(c));

  /* EXPOSICIÓN. El shader es el del creador y no se toca su estructura; lo que
     se ajusta es cuánta luz entra, que es una decisión de cámara. Su captura de
     referencia es casi negra con el rojo apenas insinuado, y a exposición plena
     el campo salía encendido y le comía la palabra. */
  base*=u_exp;

  o=vec4(base,1.);
}`;

  const REDUCIDO = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function montar() {
    for (const cv of document.querySelectorAll<HTMLCanvasElement>('[data-kdx-campo]')) {
      if (cv.dataset.kdxCampoMontado) continue;
      cv.dataset.kdxCampoMontado = '1';

      const gl = cv.getContext('webgl2', { antialias: false, alpha: true });
      if (!gl) continue;   // sin WebGL2 el velo se ve como antes y nadie queda afuera

      const sh = (t: number, src: string) => {
        const x = gl.createShader(t)!; gl.shaderSource(x, src); gl.compileShader(x);
        if (!gl.getShaderParameter(x, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(x));
        return x;
      };
      const prog = gl.createProgram()!;
      gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
      gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
      gl.linkProgram(prog); gl.useProgram(prog);

      const buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

      const U = (n: string) => gl.getUniformLocation(prog, n);
      const uRes=U('u_res'), uTime=U('u_time'), uSeed=U('u_seed'),
            uPtr=U('u_pointer'), uBass=U('u_bass'), uState=U('u_state'), uPx=U('u_px'), uExp=U('u_exp');
      gl.uniform1f(uSeed, Math.random());

      /* El tamaño de bloque decide cuán "código" se ve. En el prototipo era
         fijo; acá baja en pantallas chicas para que el mandala no se coma su
         propio detalle en 390px de ancho. */
      const DPR = Math.min(window.devicePixelRatio || 1, 2);
      let W = 0, H = 0;
      const medir = () => {
        W = cv.clientWidth; H = cv.clientHeight;
        cv.width = Math.max(1, Math.round(W * DPR));
        cv.height = Math.max(1, Math.round(H * DPR));
        gl.viewport(0, 0, cv.width, cv.height);
      };
      medir();
      addEventListener('resize', medir, { passive: true });

      let ptr: [number, number] = [0, 0];
      addEventListener('pointermove', (e) => {
        ptr = [(e.clientX / innerWidth - 0.5) * 2, (0.5 - e.clientY / innerHeight) * 2];
      }, { passive: true });

      const estadoBase = Number(cv.dataset.kdxCampoEstado || '0.15');

      /* KDX-MOTION-REF-003, MOTION:
           AWARE      → tiny phase displacement
           LOCKED     → symmetry stabilizes
           OBSERVING  → controlled breathing / resonance
         Eso es la máquina de escena que ya existe -- idle → aware → locked →
         active -- y no una segunda. El portal no inventa su intensidad: la
         lee. Escuchar el estado es lo que hace que el campo RESPONDA al
         visitante en vez de latir solo. */
      const PORESTADO: Record<string, number> = {
        idle: 0.10, aware: 0.24, locked: 0.46, active: 0.72, transitionOut: 0.9,
      };
      /* `data-kdx-state` en el <html> lo escribe `src/lib/kodex/estado.ts`
         desde hace tiempo. No se inventa un atributo nuevo: se lee el que ya
         está. Ensamblar, no construir otra vez. */
      const leerEstado = () => PORESTADO[document.documentElement.dataset.kdxState || ''];
      /* `__kdxCampo` es el enchufe para el sonido: quien monte el audio le pasa
         la energía del analizador y el campo late con el drone. Mientras nadie
         lo enchufe, late solo. */
      const puente = ((window as any).__kdxCampo ||= { bass: 0, estado: estadoBase, exposicion: 0.52 });

      let t0 = performance.now(), raf = 0, visible = true;
      let estadoActual = estadoBase;
      const io = new IntersectionObserver((e) => { visible = e[0].isIntersecting; }, { threshold: 0 });
      io.observe(cv);

      const cuadro = () => {
        raf = requestAnimationFrame(cuadro);
        if (!visible || document.hidden || !cv.isConnected) return;
        const t = (performance.now() - t0) / 1000;
        /* KDX-MOTION-REF-003, REDUCED MOTION, textual: "Use static optical
           composition with LOWER SPATIAL FREQUENCY and no phase movement to
           reduce discomfort." Congelar el tiempo no alcanza: un patrón de
           interferencia fino y quieto sigue siendo incómodo. Se agranda el
           bloque, que es exactamente bajar la frecuencia espacial. */
        const base = Math.max(2, Math.min(5, Math.round(Math.min(cv.width, cv.height) / 260)));
        const px = REDUCIDO ? base * 3 : base;
        gl.uniform2f(uRes, cv.width, cv.height);
        gl.uniform1f(uTime, REDUCIDO ? 0 : t);
        gl.uniform2f(uPtr, ptr[0], ptr[1]);
        gl.uniform1f(uBass, puente.bass || 0);
        /* Suave: el estado se persigue, no se salta. Un corte en la intensidad
           del campo se ve como un parpadeo, y el canon prohíbe el destello. */
        const objetivo = leerEstado() ?? puente.estado ?? estadoBase;
        estadoActual += (objetivo - estadoActual) * 0.035;
        gl.uniform1f(uState, estadoActual);
        gl.uniform1f(uPx, px * DPR);
        gl.uniform1f(uExp, puente.exposicion ?? 0.52);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      };
      cuadro();

      /* Con el router de vistas el canvas puede morir en un intercambio: se
         corta el bucle para no dejar una GPU dibujando algo que ya no existe. */
      document.addEventListener('astro:before-swap', () => {
        if (!cv.isConnected) { cancelAnimationFrame(raf); io.disconnect(); }
      });
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', montar, { once: true });
  else montar();
  document.addEventListener('astro:page-load', montar);
</script>
