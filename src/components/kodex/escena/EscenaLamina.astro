---
/**
 * KODEX−∞ · LA LÁMINA COMPLETA COMO ESCENA — DESKTOP ESPACIAL / MÓVIL TEMPORAL
 *
 * VEREDICTO DEL CREADOR (2026-08-25): «PROLOGUE MOBILE = REJECT / P0.
 * Mobile no puede ser desktop reducido al 23%». La versión anterior metía la
 * plancha entera encogida en un viewport alto: el ojo quedaba microscópico, la
 * escena flotaba como una estampilla entre zonas muertas, y los botones pesaban
 * más que la obra. Esa vía queda cerrada.
 *
 * LA CORRECCIÓN NO ES REDIBUJAR LA LÁMINA PARA TELÉFONO.
 *
 * La plancha ya contiene toda su inteligencia visual, medida panel por panel.
 * Lo que cambia es la CÁMARA:
 *
 *   DESKTOP  — espacial: la plancha entera, todo simultáneo, como cartel.
 *   MÓVIL    — temporal: la pantalla se posa sobre UN panel a la vez, a escala
 *              legible (nunca por debajo de 1:1 si cabe), y se avanza por
 *              gesto. El ojo domina el primer frame; lo denso —logs, waveforms,
 *              pseudocódigo— espera detrás de la interacción.
 *
 * Así el móvil no es una miniatura del desktop ni una escena nueva: es el mismo
 * sistema visual recorrido en el tiempo en vez de en el espacio. Es exactamente
 * lo que `kit/movil.ts` ya había concluido midiendo: «la plancha no está rota,
 * está siendo encogida».
 *
 * El shell queda SIEMPRE por encima y clickeable: la versión anterior tapaba la
 * barra PREVIOUS/DESCEND/INDEX con la plancha y los taps no llegaban — P0
 * funcional, no sólo estético.
 */
import "../../../styles/kodex-lamina.css";

const W = 1672, H = 941;

export interface Parada {
  /** identificador corto, va al indicador de avance */
  id: string;
  /** rótulo humano del panel */
  label: string;
  /** caja MEDIDA en coordenadas del póster */
  x: number; y: number; w: number; h: number;
  /** true = llena la pantalla recortando el excedente (para organismos
      radialmente simétricos, donde recortar los lados no quita información).
      Por defecto la parada entra ENTERA, que es lo correcto para paneles de
      texto: ahí recortar sí perdería contenido. */
  cover?: boolean;
}

interface Props {
  lamina: string;
  /** recorrido móvil: un panel por parada, en orden de lectura */
  paradas: Parada[];
  class?: string;
}
const { lamina, paradas, class: className } = Astro.props;
---

<div class:list={["kx-escena-lamina", className]}
     data-escena-lamina={lamina}
     data-paradas={JSON.stringify(paradas)}>
  <div class="kdx-lam-fit" data-kdx-fit>
    <div class="kdx-lam" style={`width:${W}px;height:${H}px`} data-lamina={lamina}>
      <slot />
    </div>
  </div>

  {/* Recorrido móvil. En desktop no existe: display:none, cero coste. */}
  <nav class="kx-recorrido" data-kx-recorrido aria-label="Recorrido de la escena">
    <button class="kx-recorrido__btn" data-kx-parada="prev" type="button" aria-label="Panel anterior">‹</button>
    <ol class="kx-recorrido__puntos" data-kx-puntos></ol>
    <button class="kx-recorrido__btn" data-kx-parada="next" type="button" aria-label="Panel siguiente">›</button>
  </nav>
  <p class="kx-recorrido__rotulo" data-kx-rotulo aria-live="polite"></p>
</div>

<style>
  .kx-escena-lamina {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #000;
    /* EL SHELL MANDA ARRIBA. La plancha no puede tragarse los taps de
       PREVIOUS/DESCEND/INDEX: eso fue un P0 funcional reportado desde el
       teléfono. Se restituyen los eventos sólo en el lienzo. */
    pointer-events: none;
    z-index: 0;
  }
  .kx-escena-lamina .kdx-lam-fit {
    --s: 1; --tx: 0px; --ty: 0px;
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: auto;
  }
  .kx-escena-lamina .kdx-lam-fit > :global(.kdx-lam) {
    position: absolute;
    left: 0; top: 0;
    transform-origin: 0 0;
    transform: translate(var(--tx), var(--ty)) scale(var(--s));
    /* La cámara se mueve; no salta. */
    transition: transform 620ms cubic-bezier(.22,.61,.36,1);
  }

  .kx-recorrido, .kx-recorrido__rotulo { display: none; }

  @media (max-width: 767px) {
    .kx-recorrido {
      position: absolute;
      left: 0; right: 0;
      bottom: max(4.5rem, env(safe-area-inset-bottom, 0px) + 4rem);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .75rem;
      pointer-events: auto;
      z-index: 3;
    }
    .kx-recorrido__btn {
      width: 44px; height: 44px;
      display: grid; place-items: center;
      background: color-mix(in srgb, #000 62%, transparent);
      border: 1px solid color-mix(in srgb, var(--acc, #8B5CF6) 45%, transparent);
      color: var(--acc, #8B5CF6);
      font: 1rem/1 ui-monospace, monospace;
      border-radius: 999px;
      cursor: pointer;
    }
    .kx-recorrido__btn[disabled] { opacity: .28; }
    .kx-recorrido__puntos {
      display: flex; gap: .45rem; margin: 0; padding: 0; list-style: none;
    }
    .kx-recorrido__puntos li {
      width: 7px; height: 7px; border-radius: 999px;
      background: color-mix(in srgb, var(--acc, #8B5CF6) 26%, transparent);
      transition: background 220ms, transform 220ms;
    }
    .kx-recorrido__puntos li[data-activo] {
      background: var(--acc, #8B5CF6);
      transform: scale(1.5);
    }
    .kx-recorrido__rotulo {
      position: absolute;
      left: 0; right: 0;
      bottom: max(7.5rem, env(safe-area-inset-bottom, 0px) + 7rem);
      display: block;
      margin: 0;
      text-align: center;
      font: 500 .62rem/1.2 ui-monospace, monospace;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: color-mix(in srgb, var(--acc, #8B5CF6) 78%, #fff);
      pointer-events: none;
      z-index: 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kx-escena-lamina .kdx-lam-fit > :global(.kdx-lam) { transition: none; }
    .kx-recorrido__puntos li { transition: none; }
  }
</style>

<script>
  const sinks: Array<(t?: number) => void> = [];
  (window as any).__kdxRegisterFreeze = (fn: (t?: number) => void) => sinks.push(fn);
  (window as any).__kdxFreeze = (t = 0) => {
    for (const fn of sinks) fn(t);
    document.documentElement.dataset.kdxFrozen = "1";
  };

  const host = document.querySelector<HTMLElement>("[data-escena-lamina]");
  const fit = host?.querySelector<HTMLElement>("[data-kdx-fit]");

  if (host && fit) {
    type Parada = { id: string; label: string; x: number; y: number; w: number; h: number; cover?: boolean };
    let paradas: Parada[] = [];
    try { paradas = JSON.parse(host.dataset.paradas || "[]"); } catch { paradas = []; }

    const esMovil = () => matchMedia("(max-width: 767px)").matches;
    let i = 0;

    const puntos = host.querySelector<HTMLElement>("[data-kx-puntos]");
    const rotulo = host.querySelector<HTMLElement>("[data-kx-rotulo]");
    const bPrev = host.querySelector<HTMLButtonElement>('[data-kx-parada="prev"]');
    const bNext = host.querySelector<HTMLButtonElement>('[data-kx-parada="next"]');

    if (puntos && paradas.length) {
      puntos.innerHTML = paradas.map(() => "<li></li>").join("");
    }

    const pintarIndice = () => {
      puntos?.querySelectorAll("li").forEach((li, n) => {
        if (n === i) li.setAttribute("data-activo", ""); else li.removeAttribute("data-activo");
      });
      if (rotulo && paradas[i]) rotulo.textContent = `${String(i + 1).padStart(2, "0")} / ${String(paradas.length).padStart(2, "0")} · ${paradas[i].label}`;
      if (bPrev) bPrev.disabled = i === 0;
      if (bNext) bNext.disabled = i === paradas.length - 1;
    };

    const encuadrar = () => {
      const r = host.getBoundingClientRect();
      const vw = r.width || innerWidth;
      const vh = r.height || innerHeight;

      if (!esMovil() || !paradas.length) {
        /* DESKTOP — espacial: la plancha entera, nunca ampliada sobre 1:1. */
        const s = Math.min(1, vw / 1672, vh / 941);
        fit.style.setProperty("--s", String(s));
        fit.style.setProperty("--tx", ((vw - 1672 * s) / 2).toFixed(2) + "px");
        fit.style.setProperty("--ty", ((vh - 941 * s) / 2).toFixed(2) + "px");
        fit.style.clipPath = "none";
        return;
      }

      /* MÓVIL — temporal: la cámara se posa sobre UNA parada y RECORTA a ella.
         El recorte no es cosmético: sin él los paneles vecinos —logs, shader,
         waveforms— sangran por los bordes, y el creador pidió expresamente que
         lo denso espere detrás de la interacción. Con clip-path la parada es
         lo único que existe en pantalla; el resto de la plancha sigue montado
         y vivo, simplemente fuera de cuadro.
         Se permite ampliar por encima de 1:1 porque el objetivo es
         LEGIBILIDAD, no fidelidad de tamaño. */
      const p = paradas[i];
      const margenX = 14;
      const reservaSup = 56;                 // wordmark del shell
      const reservaInf = 168;                // recorrido + barra PREVIOUS/DESCEND/INDEX
      const alturaUtil = Math.max(200, vh - reservaSup - reservaInf);

      /* CONTAIN por defecto; COVER para el organismo que abre la escena.
         El creador pidió que el ojo se sienta «enorme, casi pantalla completa»,
         y contener un panel cuadrado en una pantalla alta dejaba bandas negras
         arriba y abajo — la estampilla otra vez, más grande. Al ser radialmente
         simétrico, recortarle los lados no le quita información: gana presencia.
         Los paneles de texto siguen entrando enteros, porque ahí recortar sí
         perdería contenido. */
      const s = p.cover
        ? Math.max((vw - margenX * 2) / p.w, alturaUtil / p.h)
        : Math.min((vw - margenX * 2) / p.w, alturaUtil / p.h);

      const anchoP = p.w * s, altoP = p.h * s;
      const izq = (vw - anchoP) / 2;
      const arr = reservaSup + (alturaUtil - altoP) / 2;

      fit.style.setProperty("--s", String(s));
      fit.style.setProperty("--tx", (izq - p.x * s).toFixed(2) + "px");
      fit.style.setProperty("--ty", (arr - p.y * s).toFixed(2) + "px");
      /* Con cover la parada excede la pantalla: el recorte se limita al area
         util, nunca a numeros negativos que anularian el clip. */
      const cT = Math.max(0, arr), cL = Math.max(0, izq);
      const cR = Math.max(0, vw - izq - anchoP), cB = Math.max(0, vh - arr - altoP);
      fit.style.clipPath = `inset(${cT.toFixed(1)}px ${cR.toFixed(1)}px ${cB.toFixed(1)}px ${cL.toFixed(1)}px)`;
    };

    const ir = (n: number) => {
      i = Math.max(0, Math.min(paradas.length - 1, n));
      encuadrar(); pintarIndice();
    };

    bPrev?.addEventListener("click", () => ir(i - 1));
    bNext?.addEventListener("click", () => ir(i + 1));

    /* Gesto: deslizar avanza el recorrido. Sólo horizontal, para no pelear con
       el scroll del shell ni con el descenso vertical del corredor. */
    let x0 = 0, y0 = 0;
    fit.addEventListener("touchstart", (e) => {
      x0 = e.changedTouches[0].clientX; y0 = e.changedTouches[0].clientY;
    }, { passive: true });
    fit.addEventListener("touchend", (e) => {
      if (!esMovil()) return;
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.6) ir(i + (dx < 0 ? 1 : -1));
    }, { passive: true });

    addEventListener("keydown", (e) => {
      if (!esMovil()) return;
      if (e.key === "ArrowRight") ir(i + 1);
      if (e.key === "ArrowLeft") ir(i - 1);
    });

    encuadrar(); pintarIndice();
    addEventListener("resize", () => { encuadrar(); pintarIndice(); }, { passive: true });
    if ("ResizeObserver" in window) new ResizeObserver(encuadrar).observe(host);
  }
</script>
