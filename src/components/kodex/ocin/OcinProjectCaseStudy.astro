---
import type { OcinProjectRecord } from '../../../lib/kodex/ocin/authorial-projects-v0';

interface Props { project: OcinProjectRecord }
const { project } = Astro.props;
---

<article class="ocin-project" aria-labelledby={`${project.id}-title`}>
  <header class="ocin-project__cover">
    <div class="ocin-project__rail">
      <span>{project.id}</span>
      <span>{project.caseStudyStatus}</span>
      <span>PUBLIC APPROVAL: {project.publicApproval ? 'YES' : 'PENDING'}</span>
    </div>
    <div class="ocin-project__cover-copy">
      <p>DESIGN PROJECT / CASE STUDY LAB</p>
      <h1 id={`${project.id}-title`}>{project.title}</h1>
      <p>{project.projectClass} <small>[{project.projectClassState}]</small></p>
    </div>
  </header>

  <section class="ocin-project__section ocin-project__facts" aria-labelledby="project-facts">
    <div><p class="ocin-project__number">01</p><h2 id="project-facts">CONTEXT GATE</h2></div>
    <dl>
      {project.facts.map((fact) => (
        <div data-state={fact.state}>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
          <small>{fact.state}</small>
        </div>
      ))}
    </dl>
    <p class="ocin-project__note">Unknown project facts remain visibly gated. The case study structure can exist before factual copy is approved.</p>
  </section>

  <section class="ocin-project__section" aria-labelledby="system-seed">
    <div><p class="ocin-project__number">02</p><h2 id="system-seed">SYSTEM SEED</h2></div>
    <div class="ocin-project__evidence">
      {project.verifiedVisualEvidence.map((item) => <p>{item}</p>)}
    </div>
  </section>

  <section class="ocin-project__section" aria-labelledby="asset-architecture">
    <div><p class="ocin-project__number">03</p><h2 id="asset-architecture">ASSET ARCHITECTURE</h2></div>
    <div class="ocin-project__groups">
      {project.assetGroups.map((group) => (
        <article>
          <header><span>{group.key}</span><strong>{group.count}</strong></header>
          <h3>{group.role}</h3>
          <p>{group.evidence}</p>
          <footer>{group.relation} · {group.publicDefault}</footer>
        </article>
      ))}
    </div>
  </section>

  <section class="ocin-project__section ocin-project__application" aria-labelledby="applications">
    <div><p class="ocin-project__number">04</p><h2 id="applications">APPLICATIONS</h2></div>
    <div class="ocin-project__source-gate">
      <p>APPROVED PROJECT DERIVATIVES REQUIRED</p>
      <strong>31 LINKED SOURCE / PROCESS ASSETS KNOWN</strong>
      <small>Private Drive bytes stay outside runtime until representative assets and public-use rights are approved.</small>
    </div>
  </section>

  <section class="ocin-project__section" aria-labelledby="kodex-relation">
    <div><p class="ocin-project__number">05</p><h2 id="kodex-relation">KODEX RELATION</h2></div>
    <p class="ocin-project__statement">{project.kodexRelation}</p>
  </section>
</article>

<style>
  .ocin-project { --fg:#f2efe5; --bg:#0a0a0a; --line:rgba(242,239,229,.17); color:var(--fg); background:var(--bg); border:1px solid var(--line); }
  .ocin-project__cover { min-height:88svh; display:grid; grid-template-rows:auto 1fr; padding:clamp(1rem,3vw,3rem); }
  .ocin-project__rail { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.75rem; color:rgba(242,239,229,.55); font:500 .66rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.08em; }
  .ocin-project__cover-copy { align-self:center; }
  .ocin-project__cover-copy > p { font:500 .72rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.12em; color:rgba(242,239,229,.56); }
  .ocin-project__cover h1 { margin:.5rem 0 1rem; max-width:12ch; font:600 clamp(4rem,16vw,14rem)/.75 system-ui,sans-serif; letter-spacing:-.075em; }
  .ocin-project__cover small { color:rgba(242,239,229,.45); }
  .ocin-project__section { display:grid; gap:clamp(2rem,5vw,5rem); padding:clamp(1rem,3vw,3rem); border-top:1px solid var(--line); }
  .ocin-project__section > div:first-child { display:flex; align-items:baseline; gap:1rem; }
  .ocin-project__section h2 { margin:0; font:600 clamp(1.2rem,2.8vw,2.3rem)/1 system-ui,sans-serif; letter-spacing:-.04em; }
  .ocin-project__number { margin:0; color:rgba(242,239,229,.4); font:.66rem/1 ui-monospace,SFMono-Regular,Menlo,monospace; }
  .ocin-project__facts dl { margin:0; display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); border-top:1px solid var(--line); border-left:1px solid var(--line); }
  .ocin-project__facts dl div { min-height:9rem; display:grid; align-content:space-between; padding:1rem; border-right:1px solid var(--line); border-bottom:1px solid var(--line); }
  .ocin-project__facts dt,.ocin-project__facts small,.ocin-project__groups footer { font:.65rem/1.3 ui-monospace,SFMono-Regular,Menlo,monospace; color:rgba(242,239,229,.48); letter-spacing:.07em; }
  .ocin-project__facts dd { margin:0; font:600 1.15rem/1.05 system-ui,sans-serif; }
  .ocin-project__facts [data-state='NEEDS_CONFIRMATION'] { background:repeating-linear-gradient(-45deg,transparent,transparent 10px,rgba(242,239,229,.025) 10px,rgba(242,239,229,.025) 20px); }
  .ocin-project__note,.ocin-project__statement { max-width:70ch; margin:0; color:rgba(242,239,229,.7); line-height:1.55; }
  .ocin-project__evidence { display:grid; gap:0; border-top:1px solid var(--line); }
  .ocin-project__evidence p { margin:0; padding:1rem 0; max-width:72ch; border-bottom:1px solid var(--line); line-height:1.5; }
  .ocin-project__groups { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); border-top:1px solid var(--line); border-left:1px solid var(--line); }
  .ocin-project__groups article { min-height:19rem; display:grid; grid-template-rows:auto auto 1fr auto; gap:1rem; padding:1rem; border-right:1px solid var(--line); border-bottom:1px solid var(--line); }
  .ocin-project__groups header { display:flex; justify-content:space-between; font:.66rem/1 ui-monospace,SFMono-Regular,Menlo,monospace; color:rgba(242,239,229,.52); }
  .ocin-project__groups header strong { font-size:2.8rem; color:var(--fg); }
  .ocin-project__groups h3 { margin:0; max-width:12ch; font-size:1.35rem; }
  .ocin-project__groups p { color:rgba(242,239,229,.68); line-height:1.5; }
  .ocin-project__source-gate { min-height:55svh; display:grid; place-content:center; gap:.5rem; text-align:center; border:1px solid var(--line); background:radial-gradient(circle at center,rgba(242,239,229,.055),transparent 52%); }
  .ocin-project__source-gate p,.ocin-project__source-gate small { margin:0; color:rgba(242,239,229,.48); font:.66rem/1.35 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.08em; }
  .ocin-project__source-gate strong { max-width:20ch; margin:auto; font:600 clamp(1.6rem,5vw,4.8rem)/.9 system-ui,sans-serif; letter-spacing:-.05em; }
  @media(min-width:900px){ .ocin-project__section { grid-template-columns:minmax(220px,.35fr) 1fr; } .ocin-project__section > .ocin-project__note,.ocin-project__section > .ocin-project__statement { grid-column:2; } }
  @media(prefers-reduced-motion:reduce){ .ocin-project *{animation:none!important;transition:none!important;} }
</style>
