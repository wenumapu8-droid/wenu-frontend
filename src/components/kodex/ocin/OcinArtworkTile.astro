---
import type { OcinCollageAsset } from '../../../lib/kodex/ocin/collage-pages-v1';
import { resolveOcinAsset } from '../../../lib/kodex/ocin/collage-pages-v1';

interface Props {
  asset: OcinCollageAsset;
  reviewMode?: boolean;
  hero?: boolean;
  index?: number;
  eager?: boolean;
}

const {
  asset,
  reviewMode = false,
  hero = false,
  index,
  eager = false,
} = Astro.props;

const src = resolveOcinAsset(asset, reviewMode);
const ratio = `${asset.width} / ${asset.height}`;
---

<figure
  class:list={['ocin-art-tile', { 'ocin-art-tile--hero': hero }]}
  data-ocin-art={asset.id}
  data-asset-mode={reviewMode ? 'review' : 'production'}
>
  <div class="ocin-art-tile__stage" style={`--ocin-art-ratio:${ratio}`}>
    {src ? (
      <img
        src={src}
        width={asset.width}
        height={asset.height}
        alt={asset.alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        referrerpolicy="no-referrer"
      />
    ) : (
      <div class="ocin-art-tile__asset-gate" role="img" aria-label={`${asset.title}. Production asset pending secure vendoring.`}>
        <span>ORIGINAL / ASSET GATE</span>
        <strong>{asset.id}</strong>
        <small>PUBLIC BYTE NOT VENDORED</small>
      </div>
    )}
  </div>

  <figcaption>
    <div>
      <span>{asset.id}</span>
      {typeof index === 'number' && <span>[ {String(index).padStart(2, '0')} ]</span>}
    </div>
    <strong>{asset.title}</strong>
    <small>{asset.role}</small>
  </figcaption>
</figure>

<style>
  .ocin-art-tile {
    margin: 0;
    min-width: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    background: var(--ocx-panel, #0a0a0a);
    border: 1px solid var(--ocx-line, rgba(245,242,233,.18));
    overflow: hidden;
  }

  .ocin-art-tile__stage {
    min-height: 0;
    display: grid;
    place-items: center;
    padding: clamp(.4rem, 1vw, .8rem);
    background: #080808;
    overflow: hidden;
  }

  .ocin-art-tile__stage img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    filter: none !important;
    mix-blend-mode: normal !important;
    transform: none !important;
    clip-path: none !important;
    opacity: 1 !important;
  }

  .ocin-art-tile__asset-gate {
    width: min(78%, 34rem);
    aspect-ratio: 1;
    display: grid;
    place-content: center;
    gap: .55rem;
    padding: 1rem;
    text-align: center;
    border: 1px solid var(--ocx-line, rgba(245,242,233,.18));
    color: var(--ocx-dim, rgba(245,242,233,.58));
    background:
      linear-gradient(45deg, transparent 49.5%, rgba(184,255,36,.14) 50%, transparent 50.5%),
      linear-gradient(-45deg, transparent 49.5%, rgba(184,255,36,.14) 50%, transparent 50.5%);
  }

  .ocin-art-tile__asset-gate span,
  .ocin-art-tile__asset-gate small,
  .ocin-art-tile figcaption {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    text-transform: uppercase;
    letter-spacing: .07em;
  }

  .ocin-art-tile__asset-gate span,
  .ocin-art-tile__asset-gate small { font-size: .62rem; }
  .ocin-art-tile__asset-gate strong { color: var(--ocx-accent, #b8ff24); font-size: clamp(1rem, 3vw, 2rem); }

  .ocin-art-tile figcaption {
    min-height: 5.25rem;
    display: grid;
    align-content: center;
    gap: .22rem;
    padding: .7rem .8rem;
    border-top: 1px solid var(--ocx-line, rgba(245,242,233,.18));
    color: var(--ocx-fg, #f3f0e8);
    font-size: .62rem;
    line-height: 1.25;
  }

  .ocin-art-tile figcaption > div {
    display: flex;
    justify-content: space-between;
    gap: .7rem;
    color: var(--ocx-dim, rgba(245,242,233,.58));
  }

  .ocin-art-tile figcaption strong {
    font-size: .7rem;
    font-weight: 500;
  }

  .ocin-art-tile figcaption small { color: var(--ocx-dim, rgba(245,242,233,.58)); }

  .ocin-art-tile--hero .ocin-art-tile__stage { padding: clamp(.55rem, 1.2vw, 1rem); }
  .ocin-art-tile--hero figcaption { min-height: 4.5rem; }
</style>
