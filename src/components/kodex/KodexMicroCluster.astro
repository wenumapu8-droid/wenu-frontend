---
import KodexGlyph from './KodexGlyph.astro';
import type { KodexMicrographicName } from '../../lib/kodex/micrographics';

type Item = {
  glyph: KodexMicrographicName;
  label?: string;
  value?: string;
  motion?: 'auto' | 'none' | 'tick' | 'spin-slow' | 'spin-reverse' | 'pulse' | 'scan' | 'lock' | 'reveal' | 'flow' | 'blink' | 'drift' | 'breathe' | 'open';
};

type Props = {
  title?: string;
  code?: string;
  status?: string;
  items: Item[];
  tone?: 'red' | 'orange' | 'cyan' | 'green' | 'violet' | 'magenta' | 'white';
};

const {
  title = 'ARCHIVE_LOG',
  code = 'KDX://NODE/001',
  status = 'ACTIVE',
  items,
  tone = 'violet',
} = Astro.props;
---

<section class={`kdx-micro-cluster kdx-tone-${tone}`} aria-label={title}>
  <header class="kdx-micro-cluster__head">
    <span>{title}</span>
    <span>{status}</span>
  </header>

  <div class="kdx-micro-cluster__grid">
    {items.map((item, index) => (
      <article class="kdx-micro-node">
        <KodexGlyph name={item.glyph} size="clamp(2rem, 5vw, 4.5rem)" motion={item.motion ?? 'auto'} />
        <div>
          <small>{String(index + 1).padStart(2, '0')}</small>
          <strong>{item.label ?? item.glyph}</strong>
          {item.value && <span>{item.value}</span>}
        </div>
      </article>
    ))}
  </div>

  <footer class="kdx-micro-cluster__foot">
    <span>{code}</span>
    <span data-fuente="PENDING SOURCE">CHECKSUM · PENDING SOURCE</span>
  </footer>
</section>
