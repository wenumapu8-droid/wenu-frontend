---
const { model, title, summary, domain, caseId } = Astro.props;
const composition = model.slots?.find((slot) => slot.required)?.element || null;
const compositionId = composition?.element_id || 'NONE';
const motionIds = (model.motion || []).map((entry) => entry.element_id);
const isKnowledge = model.plate_type === 'KNOWLEDGE_PLATE';
const isJunction = model.plate_type === 'JUNCTION_PLATE';
const isActivator = model.plate_type === 'ACTIVATOR_PLATE';
const isArtwork = isActivator && model.primary_payload?.payload_type === 'ARTWORK';
const isField = isActivator && model.primary_payload?.payload_type === 'FIELD';
const routes = model.route_slate || [];
const provenance = model.provenance_refs || [];
const hasMotion = motionIds.length > 0;
---

<article
  class:list={['kdx-plate-renderer', `kdx-plate--${model.plate_type.toLowerCase()}`, `kdx-composition--${compositionId.toLowerCase()}`]}
  data-kdx-plate-renderer
  data-plate-id={model.plate_id}
  data-plate-type={model.plate_type}
  data-case-id={caseId}
  data-domain={domain}
  data-element-id={compositionId}
  data-motion={motionIds.join(',')}
  data-artwork-kind={isArtwork ? 'ARTWORK' : isField ? 'FIELD' : 'NONE'}
  tabindex="-1"
  aria-labelledby={`kdx-title-${caseId}`}
>
  <div class="kdx-plate__grid" aria-hidden="true"></div>
  <div class="kdx-plate__noise" aria-hidden="true"></div>

  <header class="kdx-plate__chrome">
    <div class="kdx-plate__identity">
      <span>KODEX−∞ / GOLDEN PLATE</span>
      <strong>{caseId}</strong>
    </div>
    <dl class="kdx-plate__telemetry">
      <div><dt>TYPE</dt><dd>{model.plate_type.replace('_PLATE','')}</dd></div>
      <div><dt>DOMAIN</dt><dd>{domain.toUpperCase()}</dd></div>
      <div><dt>SCENE</dt><dd>{model.scene_state}</dd></div>
      <div><dt>COMPOSITION</dt><dd>{compositionId.replace('KDX_','')}</dd></div>
    </dl>
  </header>

  <section class="kdx-plate__body">
    <aside class="kdx-plate__index" aria-label="plate contract">
      <span class="kdx-plate__marker">{model.communication_mode}</span>
      <p>{model.semantic_node}</p>
      <p>{model.primary_payload?.payload_type}</p>
      <p>{hasMotion ? motionIds.join(' / ') : 'STATIC'}</p>
    </aside>

    <div class="kdx-plate__main">
      <div class="kdx-plate__copy">
        <p class="kdx-plate__eyebrow">{model.macro_signal}</p>
        <h1 id={`kdx-title-${caseId}`}>{title}</h1>
        <p class="kdx-plate__summary">{summary}</p>
      </div>

      {isKnowledge && (
        <section class="kdx-knowledge" aria-label="knowledge payload">
          <div class="kdx-knowledge__object" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
            <i></i>
          </div>
          <div class="kdx-knowledge__rail">
            <p>PRIMARY PAYLOAD</p>
            <strong>{model.primary_payload?.payload_ref}</strong>
            <small>One idea. One dominant signal. Registered composition only.</small>
          </div>
        </section>
      )}

      {isJunction && (
        <section class="kdx-junction" aria-label="route choices">
          <div class="kdx-junction__core" aria-hidden="true"><span></span><i></i></div>
          <div class="kdx-junction__routes">
            {routes.map((route, index) => (
              <button type="button" class="kdx-route" data-route-role={route.role} data-route-target={route.target_node}>
                <small>{String(index + 1).padStart(2,'0')} · {route.role}</small>
                <strong>{route.target_node}</strong>
                <span>AVAILABLE DIRECTION ↗</span>
              </button>
            ))}
          </div>
        </section>
      )}

      {isArtwork && (
        <section class="kdx-activator" aria-label="protected artwork activator">
          <div class="kdx-artwork-shell" data-artwork-shell>
            <div class="kdx-artwork-shell__protected" role="img" aria-label={`Protected Ocín artwork ${model.artwork?.artwork_id}. Original source bytes withheld pending explicit approval.`}>
              <span class="kdx-artwork-shell__aperture"></span>
              <p>PROTECTED AUTHORIAL WORK</p>
              <strong>{model.artwork?.artwork_id}</strong>
              <small>FULL VIEW / CONTAIN / SOURCE WITHHELD</small>
            </div>
          </div>
          <div class="kdx-activator__contract">
            <p>ARTWORK INTEGRITY CONTRACT</p>
            <dl>
              <div><dt>OBJECT FIT</dt><dd>{model.artwork?.object_fit}</dd></div>
              <div><dt>CROP</dt><dd>{model.artwork?.crop_allowed ? 'ALLOWED' : 'PROHIBITED'}</dd></div>
              <div><dt>RECOLOR</dt><dd>{model.artwork?.recolor_allowed ? 'ALLOWED' : 'PROHIBITED'}</dd></div>
              <div><dt>DISTORT</dt><dd>{model.artwork?.distort_allowed ? 'ALLOWED' : 'PROHIBITED'}</dd></div>
            </dl>
            <button type="button" class="kdx-activate" data-activate>ACTIVATE ENVIRONMENT</button>
          </div>
        </section>
      )}

      {isField && (
        <section class="kdx-field" aria-label="living field activator">
          <div class="kdx-field__visual" aria-hidden="true">
            <span></span><span></span><span></span><i></i>
          </div>
          <div class="kdx-field__contract">
            <p>LIVING FIELD</p>
            <strong>{model.activation_profile?.activation_id}</strong>
            <small>Environment only. No artwork contract is fabricated.</small>
            <button type="button" class="kdx-activate" data-activate>ACTIVATE FIELD</button>
          </div>
        </section>
      )}
    </div>

    <aside class="kdx-plate__provenance" aria-label="provenance">
      <p>PROVENANCE</p>
      {provenance.slice(0,3).map((ref) => <code>{ref}</code>)}
      <div class="kdx-plate__truth">
        <span>RENDER</span><strong data-render-status>DOM ACTIVE</strong>
        <span>BROWSER QA</span><strong>RUNNING CANDIDATE</strong>
      </div>
    </aside>
  </section>

  <footer class="kdx-plate__footer">
    <p>100DVH · NO PAGE SCROLL · KEYBOARD · REDUCED MOTION · REGISTERED IDS ONLY</p>
    <span>{model.plate_id}</span>
  </footer>
</article>

<script>
  const plates = document.querySelectorAll('[data-kdx-plate-renderer]');
  for (const plate of plates) {
    if (!(plate instanceof HTMLElement)) continue;
    requestAnimationFrame(() => plate.focus({ preventScroll: true }));
    const activate = plate.querySelector('[data-activate]');
    activate?.addEventListener('click', () => {
      const active = plate.dataset.activated === 'true';
      plate.dataset.activated = active ? 'false' : 'true';
      if (activate instanceof HTMLButtonElement) activate.textContent = active ? 'ACTIVATE ENVIRONMENT' : 'ENVIRONMENT ACTIVE';
    });
  }
</script>

<style>
  :global(html), :global(body) { margin:0; width:100%; min-height:100%; background:#050505; color:#f2f0e8; }
  :global(body) { overflow:hidden; }
  .kdx-plate-renderer { --line:rgba(242,240,232,.18); --soft:rgba(242,240,232,.56); position:relative; box-sizing:border-box; width:100%; height:100dvh; min-height:100dvh; overflow:hidden; background:#050505; color:#f2f0e8; font-family:"IBM Plex Mono","Courier New",monospace; outline:none; isolation:isolate; }
  .kdx-plate-renderer:focus-visible { box-shadow:inset 0 0 0 2px rgba(242,240,232,.7); }
  .kdx-plate__grid { position:absolute; inset:0; z-index:-3; background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px); background-size:clamp(44px,5vw,82px) clamp(44px,5vw,82px); opacity:.18; mask-image:linear-gradient(to bottom,transparent 0,#000 18%,#000 82%,transparent 100%); }
  .kdx-plate__noise { position:absolute; inset:0; z-index:-2; opacity:.06; background:repeating-linear-gradient(0deg,transparent 0 2px,#fff 2px 3px); mix-blend-mode:screen; pointer-events:none; }
  .kdx-plate__chrome,.kdx-plate__footer { position:absolute; left:0; right:0; display:flex; align-items:center; justify-content:space-between; gap:24px; padding:14px 18px; border-color:var(--line); border-style:solid; z-index:5; background:rgba(5,5,5,.86); backdrop-filter:blur(10px); }
  .kdx-plate__chrome { top:0; border-width:0 0 1px; }
  .kdx-plate__footer { bottom:0; border-width:1px 0 0; font-size:9px; letter-spacing:.12em; color:var(--soft); }
  .kdx-plate__identity span,.kdx-plate__identity strong { display:block; }
  .kdx-plate__identity span { font-size:9px; letter-spacing:.18em; color:var(--soft); }
  .kdx-plate__identity strong { margin-top:3px; font-size:12px; letter-spacing:.08em; }
  .kdx-plate__telemetry { display:grid; grid-template-columns:repeat(4,minmax(90px,1fr)); gap:16px; margin:0; }
  .kdx-plate__telemetry div { min-width:0; }
  .kdx-plate__telemetry dt { font-size:8px; color:var(--soft); letter-spacing:.14em; }
  .kdx-plate__telemetry dd { margin:3px 0 0; font-size:9px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .kdx-plate__body { position:absolute; inset:66px 0 45px; display:grid; grid-template-columns:minmax(96px,10vw) minmax(0,1fr) minmax(150px,17vw); }
  .kdx-plate__index,.kdx-plate__provenance { padding:20px 14px; border-color:var(--line); border-style:solid; color:var(--soft); font-size:9px; overflow:hidden; }
  .kdx-plate__index { border-width:0 1px 0 0; }
  .kdx-plate__provenance { border-width:0 0 0 1px; display:flex; flex-direction:column; gap:12px; }
  .kdx-plate__index p { writing-mode:vertical-rl; margin:18px auto; letter-spacing:.14em; }
  .kdx-plate__marker { display:block; text-align:center; color:#f2f0e8; font-size:8px; }
  .kdx-plate__provenance code { font-size:8px; overflow-wrap:anywhere; line-height:1.5; }
  .kdx-plate__truth { margin-top:auto; display:grid; grid-template-columns:1fr; gap:3px; }
  .kdx-plate__truth span { margin-top:8px; font-size:7px; }
  .kdx-plate__truth strong { font-size:8px; color:#f2f0e8; }
  .kdx-plate__main { min-width:0; min-height:0; display:grid; grid-template-columns:minmax(220px,.72fr) minmax(0,1.5fr); gap:clamp(18px,3vw,54px); padding:clamp(22px,4vw,58px); align-items:center; }
  .kdx-plate__copy { align-self:center; max-width:560px; }
  .kdx-plate__eyebrow { margin:0 0 14px; font-size:9px; letter-spacing:.16em; color:var(--soft); text-transform:uppercase; }
  .kdx-plate__copy h1 { margin:0; font-family:Arial,Helvetica,sans-serif; font-size:clamp(34px,5.5vw,92px); font-weight:700; line-height:.88; letter-spacing:-.055em; text-transform:uppercase; }
  .kdx-plate__summary { max-width:48ch; margin:20px 0 0; font-family:Arial,Helvetica,sans-serif; font-size:clamp(13px,1.2vw,18px); line-height:1.35; color:var(--soft); }
  .kdx-knowledge,.kdx-junction,.kdx-activator,.kdx-field { min-width:0; min-height:0; height:min(58vh,620px); border:1px solid var(--line); position:relative; overflow:hidden; background:rgba(255,255,255,.015); }
  .kdx-knowledge { display:grid; grid-template-columns:1fr minmax(150px,.35fr); }
  .kdx-knowledge__object { position:relative; display:grid; place-items:center; }
  .kdx-knowledge__object > span { position:absolute; width:clamp(75px,10vw,150px); aspect-ratio:1; border:1px solid rgba(242,240,232,.5); border-radius:50%; }
  .kdx-knowledge__object > span:nth-child(2){transform:translate(42%,-12%) scale(.58)} .kdx-knowledge__object > span:nth-child(3){transform:translate(-35%,28%) scale(.34)} .kdx-knowledge__object > span:nth-child(4){transform:translate(14%,44%) scale(.18)}
  .kdx-knowledge__object i { width:46%; aspect-ratio:1; border:1px dashed var(--line); transform:rotate(45deg); }
  .kdx-knowledge__rail { border-left:1px solid var(--line); padding:16px; display:flex; flex-direction:column; justify-content:flex-end; gap:8px; }
  .kdx-knowledge__rail p,.kdx-knowledge__rail small { font-size:8px; color:var(--soft); }
  .kdx-knowledge__rail strong { font-size:11px; overflow-wrap:anywhere; }
  .kdx-junction { display:grid; grid-template-columns:.75fr 1.25fr; }
  .kdx-junction__core { position:relative; display:grid; place-items:center; border-right:1px solid var(--line); }
  .kdx-junction__core span { width:55%; aspect-ratio:1; border:1px solid #f2f0e8; border-radius:50%; box-shadow:0 0 0 20px rgba(242,240,232,.025),0 0 0 55px rgba(242,240,232,.015); }
  .kdx-junction__core i { position:absolute; width:1px; height:80%; background:var(--line); transform:rotate(35deg); }
  .kdx-junction__routes { display:grid; grid-template-rows:repeat(4,1fr); }
  .kdx-route { appearance:none; border:0; border-bottom:1px solid var(--line); background:transparent; color:inherit; text-align:left; padding:12px 16px; display:grid; grid-template-columns:1fr auto; grid-template-rows:auto auto; gap:4px 12px; cursor:pointer; }
  .kdx-route:last-child { border-bottom:0; }
  .kdx-route:hover,.kdx-route:focus-visible { background:#f2f0e8; color:#050505; outline:none; }
  .kdx-route small { font-size:7px; letter-spacing:.12em; } .kdx-route strong { grid-row:2; font-size:12px; } .kdx-route span { grid-column:2; grid-row:1/3; align-self:center; font-size:7px; }
  .kdx-activator { display:grid; grid-template-columns:1.3fr .7fr; }
  .kdx-artwork-shell { padding:clamp(20px,3vw,46px); display:grid; place-items:center; border-right:1px solid var(--line); }
  .kdx-artwork-shell__protected { width:min(100%,420px); height:min(100%,500px); aspect-ratio:4/5; border:1px solid rgba(242,240,232,.48); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; position:relative; text-align:center; background:radial-gradient(circle at 50% 46%,rgba(242,240,232,.08),transparent 42%); }
  .kdx-artwork-shell__protected p,.kdx-artwork-shell__protected small { font-size:8px; letter-spacing:.13em; color:var(--soft); }
  .kdx-artwork-shell__protected strong { font-size:12px; }
  .kdx-artwork-shell__aperture { width:38%; aspect-ratio:1; border:1px solid rgba(242,240,232,.65); border-radius:50%; box-shadow:0 0 0 14px rgba(242,240,232,.025); }
  .kdx-activator__contract,.kdx-field__contract { padding:18px; display:flex; flex-direction:column; justify-content:flex-end; gap:12px; }
  .kdx-activator__contract>p,.kdx-field__contract>p { font-size:8px; letter-spacing:.12em; color:var(--soft); }
  .kdx-activator__contract dl { margin:0; display:grid; gap:7px; }.kdx-activator__contract dl div{display:flex;justify-content:space-between;gap:8px;border-top:1px solid var(--line);padding-top:6px}.kdx-activator__contract dt,.kdx-activator__contract dd{font-size:8px;margin:0}.kdx-activator__contract dt{color:var(--soft)}
  .kdx-activate { margin-top:8px; border:1px solid rgba(242,240,232,.6); background:transparent; color:inherit; padding:11px 12px; font:inherit; font-size:9px; cursor:pointer; }
  .kdx-activate:hover,.kdx-activate:focus-visible { background:#f2f0e8;color:#050505;outline:none; }
  .kdx-field { display:grid; grid-template-columns:1.2fr .8fr; }
  .kdx-field__visual { position:relative; display:grid; place-items:center; border-right:1px solid var(--line); overflow:hidden; }
  .kdx-field__visual span { position:absolute; width:24%; aspect-ratio:1; border:1px solid rgba(242,240,232,.4); border-radius:50%; }
  .kdx-field__visual span:nth-child(2){width:45%}.kdx-field__visual span:nth-child(3){width:70%;border-style:dashed}.kdx-field__visual i{width:1px;height:75%;background:var(--line);transform:rotate(45deg)}
  [data-activated="true"] .kdx-artwork-shell__aperture,[data-activated="true"] .kdx-field__visual span { animation:kdx-pulse 2.4s ease-in-out infinite; }
  [data-motion*="MOTION_01"] .kdx-knowledge__object,[data-motion*="MOTION_01"] .kdx-artwork-shell__aperture { animation:kdx-breathe 4.8s ease-in-out infinite; }
  [data-motion*="MOTION_02"] .kdx-junction__core i,[data-motion*="MOTION_02"] .kdx-field__visual i { animation:kdx-orbit 12s linear infinite; transform-origin:center; }
  @keyframes kdx-pulse { 50%{transform:scale(1.045);opacity:.72} }
  @keyframes kdx-breathe { 50%{transform:scale(.985);opacity:.78} }
  @keyframes kdx-orbit { to{transform:rotate(405deg)} }
  @media (max-width:760px) {
    .kdx-plate__chrome { padding:10px 12px; }.kdx-plate__telemetry{grid-template-columns:repeat(2,minmax(80px,1fr));gap:7px 12px}.kdx-plate__telemetry div:nth-child(3),.kdx-plate__telemetry div:nth-child(4){display:none}
    .kdx-plate__body { inset:58px 0 40px; grid-template-columns:1fr; }.kdx-plate__index,.kdx-plate__provenance{display:none}.kdx-plate__main{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr);gap:14px;padding:18px 14px 14px;align-items:stretch}.kdx-plate__copy h1{font-size:clamp(34px,12vw,62px)}.kdx-plate__summary{font-size:12px;margin-top:10px}.kdx-plate__eyebrow{margin-bottom:8px}
    .kdx-knowledge,.kdx-junction,.kdx-activator,.kdx-field{height:auto;min-height:0}.kdx-knowledge{grid-template-columns:1fr}.kdx-knowledge__rail{display:none}.kdx-junction{grid-template-columns:.55fr 1.45fr}.kdx-route{padding:8px 9px}.kdx-route span{display:none}.kdx-activator,.kdx-field{grid-template-columns:1fr}.kdx-artwork-shell,.kdx-field__visual{border-right:0;border-bottom:1px solid var(--line);min-height:0;padding:12px}.kdx-artwork-shell__protected{height:100%;max-height:34vh;aspect-ratio:4/3}.kdx-activator__contract,.kdx-field__contract{padding:10px;gap:7px}.kdx-activator__contract dl{display:none}.kdx-activate{padding:8px}.kdx-plate__footer{padding:8px 10px}.kdx-plate__footer span{display:none}
  }
  @media (prefers-reduced-motion: reduce) { *,*::before,*::after { animation-duration:.00001ms !important; animation-iteration-count:1 !important; transition-duration:.00001ms !important; scroll-behavior:auto !important; } }
</style>
