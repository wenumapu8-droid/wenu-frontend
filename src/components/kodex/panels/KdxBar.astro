---
/**
 * KODEX−∞ · BARRA DE INSTRUMENTOS
 *
 * Medida sobre el poster OBSERVATION EYE: 33px de alto, celdas de 105px
 * iguales separadas por verticales de 1px. Aparece dos veces por hoja --
 * arriba dice QUE hoja es, abajo dice QUE SISTEMA la emite.
 *
 * Cada celda es microetiqueta sobre valor. Ninguna celda puede llevar un
 * valor que el sistema no pueda respaldar: si no hay dato, la celda dice
 * lo que realmente hay, o no existe.
 */
export interface BarCell {
  k: string;
  v: string;
  /** Solo una celda por barra puede gastar el acento. */
  accent?: boolean;
  wide?: boolean;
  /** Gancho para que el runtime escriba un valor medido. */
  hook?: string;
}

interface Props {
  cells: BarCell[];
  class?: string;
  label?: string;
}

const { cells, class: className = '', label = 'system bar' } = Astro.props;
---

<div class:list={['kdxp-bar', className]} role="group" aria-label={label}>
  {cells.map((c) => (
    <div class:list={['kdxp-bar__cell', c.accent && 'kdxp-bar__cell--accent', c.wide && 'kdxp-bar__cell--wide']}>
      <span class="kdxp-bar__k">{c.k}</span>
      <span class="kdxp-bar__v" data-kdxp-hook={c.hook}>{c.v}</span>
    </div>
  ))}
</div>
