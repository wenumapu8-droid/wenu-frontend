---
/**
 * KODEX−∞ · PANEL
 *
 * El primitivo del sistema de laminas. En los posters NADA flota: cada zona
 * es un rectangulo con borde de 1px y una cabecera con numero.
 *
 * La numeracion corre en orden de lectura sobre la hoja COMPLETA -- columna
 * izquierda de arriba abajo, despues el centro, despues la derecha, despues
 * la banda de abajo -- y no reinicia por columna. Eso es lo que prueba que es
 * un documento y no una coleccion de widgets.
 */
interface Props {
  /** Numero de la hoja. Dos digitos, con cero. */
  n: string;
  /** Nombre de la zona. */
  label: string;
  /** Etiqueta secundaria a la derecha de la cabecera. */
  aside?: string;
  /** El panel dominante lleva marcas de esquina. Solo uno por hoja. */
  focus?: boolean;
  /** Cuerpo sin padding: para el portal, los mosaicos a sangre. */
  flush?: boolean;
  /** Vacio deliberado. La ausencia es un estado valido y no se rellena. */
  sparse?: boolean;
  class?: string;
  style?: string;
  id?: string;
}

const {
  n,
  label,
  aside,
  focus = false,
  flush = false,
  sparse = false,
  class: className = '',
  style,
  id,
} = Astro.props;
---

<section
  class:list={['kdxp-panel', focus && 'kdxp-panel--focus', sparse && 'kdxp-panel--sparse', className]}
  style={style}
  id={id}
  aria-label={`${n}. ${label}`}
>
  <header class="kdxp-panel__head">
    <span class="kdxp-panel__n">{n}.</span>
    <span class="kdxp-panel__name">{label}</span>
    {aside && <span class="kdxp-panel__aside">/ {aside}</span>}
  </header>
  <div class:list={['kdxp-panel__body', flush && 'kdxp-panel__body--flush']}>
    <slot />
  </div>
</section>
