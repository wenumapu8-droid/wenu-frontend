---
import { THRESHOLD_PORTAL_CONFIG } from '../../../kodex/threshold-portal/config.js';

interface Props {
  seed?: number;
  state?: string;
}

const {
  seed = THRESHOLD_PORTAL_CONFIG.defaultSeed,
  state = 'DORMANT',
} = Astro.props;
---

<section class="kdx-threshold" data-kdx-threshold data-state={state}>
  <canvas class="kdx-threshold__canvas" data-kdx-canvas aria-hidden="true"></canvas>

  <div class="kdx-threshold__ui">
    <header class="kdx-threshold__header">
      <h1 class="kdx-logo">KODEX−∞</h1>
      <div class="kdx-header-meta">
        <span class="kdx-chip">◉ THRESHOLD PORTAL</span>
        <button class="kdx-index" type="button" data-kodex-index>INDEX</button>
      </div>
    </header>

    <div class="kdx-threshold__content">
      <p class="kdx-kicker">00 · THRESHOLD / ENTRANCE PROTOCOL</p>
      <h2 class="kdx-title">THE SYSTEM<br />AWAITS.</h2>
      <p class="kdx-copy">
        {THRESHOLD_PORTAL_CONFIG.artworkLabel} — seed {seed}
      </p>

      <div class="kdx-actions">
        <button class="kdx-primary" type="button" data-kdx-primary>
          ENTER THE SYSTEM →
        </button>
      </div>

      <div class="kdx-data-row">
        <span class="kdx-micro-chip">PORTAL <b>KDX-TP-001</b></span>
        <span class="kdx-micro-chip">SEED <b data-kdx-seed>{seed}</b></span>
        <span class="kdx-micro-chip" data-kdx-state>STATE <b>{state}</b></span>
        <span class="kdx-micro-chip">ELAPSED <b data-kdx-elapsed>0s</b></span>
      </div>
    </div>

    <footer class="kdx-observe__footer">
      <div class="kdx-barcode" aria-hidden="true"></div>
      <nav class="kdx-progress" aria-label="KODEX scene progress">
        <span>00 / 07</span>
        <span class="kdx-progress__nodes" aria-hidden="true">
          <i class="kdx-progress__node is-active"></i>
          <i class="kdx-progress__node"></i>
          <i class="kdx-progress__node"></i>
          <i class="kdx-progress__node"></i>
          <i class="kdx-progress__node"></i>
          <i class="kdx-progress__node"></i>
          <i class="kdx-progress__node"></i>
        </span>
        <button type="button" data-kodex-next>NEXT →</button>
      </nav>
      <span class="kdx-footer-status">KDX://THRESHOLD/001</span>
    </footer>
  </div>

  <aside class="kdx-threshold__controls" data-kdx-controls>
    <label>STATE <select data-ctl-state>
      <option value="DORMANT" selected>DORMANT</option>
      <option value="AWARE">AWARE</option>
      <option value="OPEN">OPEN</option>
    </select></label>
    <label>SEED <input type="number" data-ctl-seed value={seed} step="0.001" /></label>
    <label>MOTION <select data-ctl-motion>
      <option value="live">live</option>
      <option value="paused">paused</option>
      <option value="reduced">reduced</option>
      <option value="low-power">low-power</option>
    </select></label>
    <label>QUALITY <select data-ctl-quality>
      <option value="HIGH">high</option>
      <option value="MEDIUM" selected>medium</option>
      <option value="LOW">low</option>
    </select></label>
    <label>BASS <input type="range" data-ctl-bass min="0" max="1" step="0.01" value="0" /></label>
    <button data-ctl-capture>📸 CAPTURE</button>
  </aside>

  <output class="kdx-debug" data-kdx-debug></output>
</section>

<style>
  .kdx-threshold {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 100dvh;
    overflow: hidden;
    isolation: isolate;
    background: radial-gradient(circle at 50% 50%, rgba(80, 10, 16, 0.15), #050409);
  }

  .kdx-threshold__canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .kdx-threshold__content {
    max-width: 640px;
    padding-left: clamp(0px, 1vw, 22px);
  }

  .kdx-threshold__controls {
    position: fixed;
    right: 18px;
    bottom: 88px;
    z-index: 30;
    display: grid;
    gap: 6px;
    padding: 12px;
    border: 1px solid rgba(255, 60, 60, 0.2);
    background: rgba(5, 4, 9, 0.82);
    backdrop-filter: blur(8px);
    font: 11px/1.4 ui-monospace, monospace;
    color: #d0c8d8;
    min-width: 180px;
  }

  .kdx-threshold__controls label {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 8px;
    align-items: center;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #a090a8;
  }

  .kdx-threshold__controls select,
  .kdx-threshold__controls input {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255, 60, 60, 0.15);
    color: #e0d0e8;
    padding: 2px 6px;
    font: inherit;
  }

  .kdx-threshold__controls button {
    margin-top: 4px;
    padding: 6px;
    border: 1px solid rgba(255, 60, 60, 0.25);
    background: rgba(120, 20, 24, 0.2);
    color: #f0d8d8;
    cursor: pointer;
    font: inherit;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .kdx-threshold__controls button:hover {
    background: rgba(160, 30, 36, 0.3);
  }

  .kdx-data-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
    transition: box-shadow 0.4s, border-color 0.4s;
    box-shadow: 0 0 calc(4px + var(--portal-state, 0) * 8px) rgba(200, 40, 30, calc(0.08 + var(--portal-state, 0) * 0.12));
  }

  .kdx-kicker {
    transition: opacity 0.3s, color 0.6s;
    opacity: 0.6;
  }

  [data-state="DORMANT"] .kdx-kicker,
  [data-state="AWARE"] .kdx-kicker {
    opacity: 1;
  }
  [data-state="AWARE"] .kdx-kicker { color: #f0a890; }
  [data-state="OPEN"] .kdx-kicker { color: #f06040; }

  .kdx-title {
    transition: color 0.8s, text-shadow 0.8s;
  }

  [data-state="DORMANT"] .kdx-title {
    color: #a090a8;
  }
  [data-state="AWARE"] .kdx-title {
    color: #e0b0a0;
    text-shadow: 0 0 20px rgba(200, 60, 40, 0.25);
  }
  [data-state="OPEN"] .kdx-title {
    color: #f0d0c0;
    text-shadow:
      0 0 30px rgba(220, 50, 30, 0.4),
      0 0 60px rgba(180, 30, 20, 0.2);
  }

  .kdx-threshold__header {
    transition: opacity 0.5s;
  }

  [data-state="OPEN"] .kdx-threshold__header .kdx-chip {
    background: rgba(200, 40, 24, 0.2);
    border-color: rgba(220, 60, 40, 0.4);
    color: #f0b0a0;
  }

  .kdx-progress__node {
    transition: opacity 0.5s, transform 0.5s;
    opacity: 0.2;
    transform: scale(0.85);
  }
  .kdx-progress__node.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .kdx-progress__node.is-active:nth-child(1) { transition-delay: 0s; }
  .kdx-progress__node.is-active:nth-child(2) { transition-delay: 0.08s; }
  .kdx-progress__node.is-active:nth-child(3) { transition-delay: 0.16s; }
  .kdx-progress__node.is-active:nth-child(4) { transition-delay: 0.24s; }
  .kdx-progress__node.is-active:nth-child(5) { transition-delay: 0.32s; }
  .kdx-progress__node.is-active:nth-child(6) { transition-delay: 0.40s; }
  .kdx-progress__node.is-active:nth-child(7) { transition-delay: 0.48s; }

  .kdx-primary {
    transition: background 0.4s, border-color 0.4s, box-shadow 0.4s, color 0.4s;
    background: rgba(140, 24, 20, 0.15);
    border: 1px solid rgba(200, 60, 40, 0.3);
    color: #e0b0a0;
  }

  [data-state="DORMANT"] .kdx-primary {
    background: rgba(140, 24, 20, 0.15);
    border-color: rgba(200, 60, 40, 0.3);
    box-shadow: none;
  }
  [data-state="AWARE"] .kdx-primary {
    background: rgba(160, 30, 24, 0.25);
    border-color: rgba(220, 80, 50, 0.5);
    box-shadow: 0 0 16px rgba(200, 50, 30, 0.15);
  }
  [data-state="OPEN"] .kdx-primary {
    background: rgba(180, 36, 28, 0.35);
    border-color: rgba(240, 100, 60, 0.6);
    box-shadow: 0 0 24px rgba(220, 50, 30, 0.3);
    color: #f0d0c0;
  }

  .kdx-primary:hover {
    background: rgba(180, 36, 28, 0.35) !important;
    border-color: rgba(240, 100, 60, 0.6) !important;
  }

  .kdx-micro-chip:has([data-kdx-elapsed]) {
    color: rgba(200, 180, 160, 0.6);
  }

  .kdx-footer-status {
    transition: color 0.6s;
  }
  [data-state="OPEN"] .kdx-footer-status {
    color: #e07050;
  }
  [data-state="AWARE"] .kdx-footer-status {
    color: #c0a090;
  }

  .kdx-threshold[data-state="OPEN"] .kdx-barcode::after {
    animation: scroll-barcode 6s linear infinite;
  }

  @keyframes scroll-barcode {
    0% { background-position: 0 0; }
    100% { background-position: 0 -40px; }
  }

  @media (max-width: 760px) {
    .kdx-threshold__controls {
      display: none;
    }
  }
</style>

<script>
  import { mountKodexThresholdPortal } from './kodex-threshold-portal-client';
  mountKodexThresholdPortal();
</script>
