---
import './kodex-observe-v2.css';
import KodexGlyph from '../KodexGlyph.astro';

interface Props {
  sceneIndex?: number;
  sceneTotal?: number;
}

const {
  sceneIndex = 1,
  sceneTotal = 7,
} = Astro.props;
---

<section class="kdx-observe-v2" data-kdx-observe-v2 data-state="idle" data-profile="balanced" data-checksum="latent" data-webgl="pending">
  <div class="kdx-observe-v2__grid" data-kdx-grid>
    <header class="kdx-observe-v2__header">
      <a class="kdx-observe-v2__logo" href="/kodex/">KODEX−∞</a>
      <div class="kdx-observe-v2__status-row">
        <span class="kdx-chip kdx-chip--live" data-kdx-status-chip data-kdx-epistemic="state">STATUS · IDLE · STATE</span>
        <span class="kdx-chip" data-kdx-profile-chip data-kdx-epistemic="measured">PROFILE · BALANCED · MEASURED</span>
        <span class="kdx-chip" data-kdx-checksum-chip data-kdx-epistemic="atmosphere">CHECKSUM · LATENT · ATMOSPHERE</span>
        <button class="kdx-chip kdx-chip--button" type="button" data-kdx-index>INDEX</button>
      </div>
    </header>

    <aside class="kdx-observe-v2__left-rail" aria-label="authentication marks">
      <span>KX-OBS-001</span>
      <span>ARCHIVE / AR-118</span>
      <span>FIELD / ND-01</span>
      <span data-kdx-epistemic="atmosphere">LATENCY <em data-kdx-latency-inline>42MS</em> · ATMOSPHERE</span>
    </aside>

    <div class="kdx-observe-v2__scene-code" data-kdx-scene-code>
      <span>SCENE 01 / OBSERVE V2</span>
      <span>KDX://ARCHIVE/RELATIONAL-FIELD</span>
    </div>

    <div class="kdx-observe-v2__hero-block">
      <p class="kdx-observe-v2__kicker">INSTRUMENT / ARCHIVE / OBSERVER</p>
      <h1 class="kdx-observe-v2__headline">
        <span>THE ARCHIVE</span>
        <span>WATCHES.</span>
      </h1>
      <p class="kdx-observe-v2__lede" data-kdx-protocol-copy>
        Dormant relay. Minimal grid. Low particle field.
      </p>
      <div class="kdx-observe-v2__actions">
        <button class="kdx-observe-v2__cta" type="button" data-kdx-primary>INITIATE OBSERVATION</button>
        <button class="kdx-observe-v2__secondary" type="button" data-kdx-protocol>READ THE PROTOCOL</button>
      </div>
      <div class="kdx-observe-v2__microcopy" data-kdx-hidden-message>
        MEMORY DOES NOT REMAIN STILL · SIGNAL BEFORE NOISE
      </div>
    </div>

    <div class="kdx-observe-v2__visual-shell" aria-label="Observation field">
      <canvas class="kdx-observe-v2__canvas" data-kdx-canvas aria-hidden="true"></canvas>

      <div class="kdx-observe-v2__fallback-field" data-kdx-fallback>
        <div class="kdx-observe-v2__field-glow"></div>
        <div class="kdx-observe-v2__reticle-frame">
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="kdx-observe-v2__headline-shadow"><span>OBSERVES.</span></div>
        <div class="kdx-observe-v2__ghost-copy" aria-hidden="true">
          <span>THE ARCHIVE WATCHES.</span>
          <span>SEÑAL RECIBIDA.</span>
          <span data-kdx-dossier-copy>Archive waiting for relational input.</span>
        </div>
        <div class="kdx-observe-v2__signal-tag" data-kdx-signal-tag data-kdx-epistemic="atmosphere">MODE IDLE · CORE LOW · RADAR OFF · ATMOSPHERE</div>

        <div class="kdx-observe-v2__phenomenon-core">
          <div class="kdx-observe-v2__core-ring"></div>
          <div class="kdx-observe-v2__core-ring kdx-observe-v2__core-ring--inner"></div>
          <div class="kdx-observe-v2__core-eye"></div>
          <div class="kdx-observe-v2__core-pupil"></div>
          <div class="kdx-observe-v2__core-pulse"></div>
        </div>

        <div class="kdx-observe-v2__glyph-layer kdx-observe-v2__glyph-layer--radar">
          <KodexGlyph name="radar" size="clamp(11rem, 26vw, 21rem)" tone="cyan" label="Observation radar" class="kdx-observe-v2__glyph kdx-observe-v2__glyph--radar" />
        </div>
        <div class="kdx-observe-v2__glyph-layer kdx-observe-v2__glyph-layer--orbit">
          <KodexGlyph name="orbit" size="clamp(15rem, 34vw, 29rem)" tone="violet" label="Orbit field" class="kdx-observe-v2__glyph kdx-observe-v2__glyph--orbit" />
        </div>
        <div class="kdx-observe-v2__glyph-layer kdx-observe-v2__glyph-layer--crosshair">
          <KodexGlyph name="crosshair" size="clamp(12rem, 28vw, 22rem)" tone="white" label="Crosshair" class="kdx-observe-v2__glyph kdx-observe-v2__glyph--crosshair" />
        </div>
        <div class="kdx-observe-v2__glyph-layer kdx-observe-v2__glyph-layer--nodes">
          <KodexGlyph name="nodeRing" size="clamp(14rem, 32vw, 25rem)" tone="cyan" label="Node ring" class="kdx-observe-v2__glyph kdx-observe-v2__glyph--node-ring" />
        </div>
        <div class="kdx-observe-v2__glyph-layer kdx-observe-v2__glyph-layer--gate">
          <KodexGlyph name="signalGate" size="clamp(9rem, 18vw, 15rem)" tone="violet" label="Signal gate" class="kdx-observe-v2__glyph kdx-observe-v2__glyph--gate" />
        </div>
        <div class="kdx-observe-v2__glyph-layer kdx-observe-v2__glyph-layer--checksum">
          <KodexGlyph name="checksumGrid" size="clamp(5rem, 9vw, 8rem)" tone="green" label="Checksum grid" class="kdx-observe-v2__glyph kdx-observe-v2__glyph--checksum" />
        </div>
        <div class="kdx-observe-v2__glyph-layer kdx-observe-v2__glyph-layer--scanbar">
          <KodexGlyph name="scanBar" size="clamp(7rem, 14vw, 11rem)" tone="orange" label="Scan bar" class="kdx-observe-v2__glyph kdx-observe-v2__glyph--scanbar" />
        </div>
        <div class="kdx-observe-v2__glyph-layer kdx-observe-v2__glyph-layer--waveform">
          <KodexGlyph name="waveform" size="clamp(10rem, 22vw, 16rem)" tone="cyan" label="Waveform" class="kdx-observe-v2__glyph kdx-observe-v2__glyph--waveform" />
        </div>

        <div class="kdx-observe-v2__node-cloud" data-kdx-node-cloud>
          {Array.from({ length: 8 }).map((_, index) => (
            <span class="kdx-observe-v2__node" data-kdx-node style={`--node-index:${index};`} />
          ))}
        </div>
      </div>
    </div>

    <aside class="kdx-observe-v2__data-stack" aria-label="technical dossier">
      <section class="kdx-data-block kdx-data-block--legend" data-kdx-legend>
        <div class="kdx-data-block__label">READOUT PROVENANCE</div>
        <ul class="kdx-legend">
          <li class="kdx-legend__item" data-kdx-epistemic="measured">
            <span class="kdx-mark kdx-mark--measured">MEASURED</span>
            <span class="kdx-legend__gloss">timed in this browser: frame rate, frame time, dropped frames, render path.</span>
          </li>
          <li class="kdx-legend__item" data-kdx-epistemic="state">
            <span class="kdx-mark kdx-mark--state">STATE</span>
            <span class="kdx-legend__gloss">the interface's own current mode. True, but not a measurement of anything outside it.</span>
          </li>
          <li class="kdx-legend__item" data-kdx-epistemic="atmosphere">
            <span class="kdx-mark kdx-mark--atmosphere">ATMOSPHERE</span>
            <span class="kdx-legend__gloss">composed from the interface mode to set a mood. It measures nothing and detects nothing.</span>
          </li>
        </ul>
      </section>

      <section class="kdx-data-block kdx-data-block--primary">
        <div class="kdx-data-block__label">DOSSIER / FIELD FILE</div>
        <div class="kdx-data-block__rows">
          <div class="kdx-data-row"><span>CASE</span><strong>KX-OBS-001</strong><span class="kdx-mark kdx-mark--fixed">FIXED</span></div>
          <div class="kdx-data-row" data-kdx-epistemic="atmosphere"><span>SOURCE</span><strong data-kdx-source-readout>UNKNOWN</strong><span class="kdx-mark kdx-mark--atmosphere">ATMOSPHERE</span></div>
          <div class="kdx-data-row" data-kdx-epistemic="atmosphere"><span>ACQUISITION</span><strong data-kdx-acquisition-readout>PASSIVE LISTEN</strong><span class="kdx-mark kdx-mark--atmosphere">ATMOSPHERE</span></div>
          <div class="kdx-data-row" data-kdx-epistemic="atmosphere"><span>CONFIDENCE</span><strong data-kdx-confidence-readout>LOW</strong><span class="kdx-mark kdx-mark--atmosphere">ATMOSPHERE</span></div>
          <div class="kdx-data-row" data-kdx-epistemic="measured"><span>SAMPLE WINDOW</span><strong data-kdx-window-readout>0.0S</strong><span class="kdx-mark kdx-mark--measured">MEASURED</span></div>
        </div>
        <div class="kdx-data-block__value" data-kdx-dossier-copy-block>Archive waiting for relational input.</div>
      </section>
      <section class="kdx-data-block kdx-data-block--pair">
        <div data-kdx-epistemic="atmosphere">
          <div class="kdx-data-block__label">SIGNAL</div>
          <div class="kdx-data-block__value" data-kdx-signal-readout>24%</div>
          <span class="kdx-mark kdx-mark--atmosphere">ATMOSPHERE</span>
        </div>
        <div data-kdx-epistemic="atmosphere">
          <div class="kdx-data-block__label">FOCUS</div>
          <div class="kdx-data-block__value" data-kdx-focus-readout>12%</div>
          <span class="kdx-mark kdx-mark--atmosphere">ATMOSPHERE</span>
        </div>
      </section>
      <section class="kdx-data-block kdx-data-block--pair">
        <div data-kdx-epistemic="atmosphere">
          <div class="kdx-data-block__label">ANOMALY</div>
          <div class="kdx-data-block__value" data-kdx-anomaly-readout>08%</div>
          <span class="kdx-mark kdx-mark--atmosphere">ATMOSPHERE</span>
        </div>
        <div data-kdx-epistemic="atmosphere">
          <div class="kdx-data-block__label">NODES</div>
          <div class="kdx-data-block__value" data-kdx-node-readout>02</div>
          <span class="kdx-mark kdx-mark--atmosphere">ATMOSPHERE</span>
        </div>
      </section>
      <section class="kdx-data-block kdx-data-block--pair">
        <div data-kdx-epistemic="atmosphere">
          <div class="kdx-data-block__label">LATENCY</div>
          <div class="kdx-data-block__value" data-kdx-latency-readout>42MS</div>
          <span class="kdx-mark kdx-mark--atmosphere">ATMOSPHERE</span>
        </div>
        <div data-kdx-epistemic="atmosphere">
          <div class="kdx-data-block__label">CHECKSUM</div>
          <div class="kdx-data-block__value" data-kdx-checksum-readout>LATENT</div>
          <span class="kdx-mark kdx-mark--atmosphere">ATMOSPHERE</span>
        </div>
      </section>
      <section class="kdx-data-block kdx-data-block--pair">
        <div data-kdx-epistemic="measured">
          <div class="kdx-data-block__label">FRAME RATE</div>
          <div class="kdx-data-block__value" data-kdx-fps-readout>—</div>
          <span class="kdx-mark kdx-mark--measured">MEASURED</span>
        </div>
        <div data-kdx-epistemic="measured">
          <div class="kdx-data-block__label">FRAME TIME</div>
          <div class="kdx-data-block__value" data-kdx-frametime-readout>—</div>
          <span class="kdx-mark kdx-mark--measured">MEASURED</span>
        </div>
      </section>
    </aside>

    <aside class="kdx-observe-v2__right-rail" aria-label="signal indicators">
      <span data-kdx-right-rail-a data-kdx-epistemic="atmosphere">SOURCE · UNKNOWN · ATMOSPHERE</span>
      <span data-kdx-right-rail-b data-kdx-epistemic="state">MODE · IDLE · STATE</span>
      <span data-kdx-right-rail-c data-kdx-epistemic="atmosphere">FIELD · DORMANT · ATMOSPHERE</span>
      <span data-kdx-right-rail-d data-kdx-epistemic="measured">RENDER · PENDING · MEASURED</span>
    </aside>

    <section class="kdx-observe-v2__meta-row">
      <div class="kdx-observe-v2__barcode-group">
        <div class="kdx-observe-v2__barcode" data-kdx-barcode></div>
        <div class="kdx-observe-v2__barcode-copy">
          <span>KX-OBS-001</span>
          <span data-kdx-epistemic="atmosphere"><em data-kdx-checksum-foot>LATENT</em> · ATMOSPHERE</span>
        </div>
      </div>
      <div class="kdx-observe-v2__wave-cluster" data-kdx-epistemic="atmosphere">
        <div class="kdx-observe-v2__waveform-bars" data-kdx-waveform aria-hidden="true">
          {Array.from({ length: 24 }).map(() => <i></i>)}
        </div>
        <div class="kdx-observe-v2__signal-bars" data-kdx-signal-bars aria-hidden="true">
          {Array.from({ length: 12 }).map(() => <i></i>)}
        </div>
        <span class="kdx-mark kdx-mark--atmosphere">ATMOSPHERE · THESE BARS PLOT NOTHING</span>
      </div>
      <div class="kdx-observe-v2__meta-copy">
        <span data-kdx-state-copy>ARCHIVO LATENTE. NÚCLEO EN REPOSO.</span>
        <span data-kdx-epistemic="atmosphere"><em data-kdx-telemetry-copy>CORE LOW · RADAR OFF · CHECKSUM LATENT</em> · ATMOSPHERE</span>
      </div>
    </section>

    <footer class="kdx-observe-v2__footer">
      <div class="kdx-observe-v2__progress">
        <span>{String(sceneIndex).padStart(2, '0')} / {String(sceneTotal).padStart(2, '0')}</span>
        <span class="kdx-observe-v2__progress-nodes" aria-hidden="true">
          {Array.from({ length: sceneTotal }, (_, index) => (
            <i class:list={['kdx-observe-v2__progress-node', { 'is-active': index + 1 === sceneIndex }]}></i>
          ))}
        </span>
      </div>
      <nav class="kdx-observe-v2__nav" aria-label="KODEX lab navigation">
        <button type="button" data-kdx-prev>ARCHIVE BACK</button>
        <button type="button" data-kdx-next>ADVANCE FIELD</button>
      </nav>
      <div class="kdx-observe-v2__footer-data" data-kdx-metric-chip data-kdx-epistemic="measured">WEBGL PENDING · MEASURED</div>
    </footer>
  </div>

  <aside class="kdx-observe-v2__debug" data-kdx-debug hidden>
    <strong>KODEX LAB / OBSERVE V2</strong>
    <pre data-kdx-debug-text></pre>
  </aside>
</section>

<script>
  import { mountKodexObserveV2Scenes } from './kodex-observe-v2-client';
  mountKodexObserveV2Scenes();
</script>
