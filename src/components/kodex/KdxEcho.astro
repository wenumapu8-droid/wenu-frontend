---
/** KDX.ECHO · narrative voice. ORACLE remains a separate application. */
---
<aside class="kdx-echo" data-kdx-echo aria-label="ECHO · voz narrativa de KODEX">
  <div class="kdx-echo__caption" data-echo-caption aria-live="polite" aria-atomic="true" hidden></div>
  <div class="kdx-echo__panel" role="group" aria-label="Controles de narración">
    <span class="kdx-echo__mark" aria-hidden="true">◉</span>
    <button type="button" data-echo-toggle aria-pressed="false">ECHO · OFF</button>
    <button type="button" data-echo-pause disabled>PAUSA</button>
    <button type="button" data-echo-cc aria-pressed="true">CC · ON</button>
    <label><span class="kdx-echo__sr">Modo de narración</span>
      <select data-echo-mode aria-label="Modo de narración">
        <option value="ambient">PRESENCIA</option>
        <option value="guide">MONÓLOGO</option>
        <option value="read">LECTURA</option>
      </select>
    </label>
    <label><span class="kdx-echo__sr">Idioma</span>
      <select data-echo-lang aria-label="Idioma de narración"><option value="es">ES</option><option value="en">EN</option></select>
    </label>
    <button type="button" data-echo-replay aria-label="Repetir narración del módulo actual">↺</button>
    <label class="kdx-echo__preview"><input type="checkbox" data-echo-preview/> PREVIEW TTS</label>
    <small data-echo-status role="status">ECHO DESACTIVADA</small>
  </div>
</aside>
<script>
  import { mountEcho } from '../../lib/kodex/echo/runtime.mjs';
  mountEcho();
</script>
<style>
  .kdx-echo{position:fixed;z-index:9000;bottom:max(82px,calc(env(safe-area-inset-bottom) + 72px));left:50%;transform:translateX(-50%);width:min(95vw,720px);pointer-events:none;font-family:var(--font-mono,'IBM Plex Mono',monospace);color:#f0ece5}
  .kdx-echo__panel{pointer-events:auto;display:flex;gap:6px;justify-content:center;align-items:center;flex-wrap:wrap;padding:8px 10px;border:1px solid #9ccfca66;border-radius:8px;background:#090d12ed;box-shadow:0 5px 35px #000b;backdrop-filter:blur(12px)}
  .kdx-echo__panel button,.kdx-echo__panel select{font:inherit;color:#e1eeea;border:1px solid #ffffff35;border-radius:4px;background:#111d23;min-height:34px;padding:4px 8px;cursor:pointer;font-size:10px;letter-spacing:.04em}
  .kdx-echo__panel button[aria-pressed="true"]{border-color:#70c8bd;color:#b2f7e8}
  .kdx-echo__panel button:disabled{opacity:.42;cursor:not-allowed}
  .kdx-echo__mark{color:#8dfbd5;filter:drop-shadow(0 0 calc(var(--kdx-echo-level,0) * 22px) #8dfbd5)}
  .kdx-echo__preview{display:flex;gap:3px;align-items:center;font-size:9px;white-space:nowrap}
  .kdx-echo__panel small{font-size:9px;color:#9bc4bd;white-space:nowrap}
  .kdx-echo__caption{pointer-events:none;background:#070b10e8;border:1px solid #ffffff24;border-radius:7px;max-width:680px;margin:0 auto 8px;padding:12px 18px;text-align:center;line-height:1.6;font-size:clamp(13px,2vw,16px);text-shadow:0 1px 4px #000}
  .kdx-echo__caption[hidden]{display:none}
  .kdx-echo__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  .kdx-echo button:focus-visible,.kdx-echo select:focus-visible,.kdx-echo input:focus-visible{outline:2px solid #a2eeea;outline-offset:3px}
  @media(max-width:600px){.kdx-echo{bottom:max(68px,calc(env(safe-area-inset-bottom) + 58px))}.kdx-echo__panel{gap:4px;padding:5px}.kdx-echo__panel button,.kdx-echo__panel select{font-size:9px;min-height:40px;padding:4px 6px}.kdx-echo__panel small{display:none}.kdx-echo__preview{font-size:8px}}
  @media(prefers-reduced-motion:reduce){.kdx-echo *{transition:none!important;animation:none!important}}
  @media print{.kdx-echo{display:none}}
</style>
