---
export interface Props {
  accent?: string;
  response?: number;
  id?: string;
}

const { accent = '#A6FF00', response = 0.72, id = 'tree-canvas' } = Astro.props;
---

<div class="kdx-tree-wrap" data-kdx-tree-wrap style={`--kdx-accent: ${accent};`} id={id}>
  <canvas class="kdx-tree-canvas" data-kdx-tree-canvas aria-hidden="true"></canvas>
  <div class="kdx-tree-phenomenon" aria-hidden="true">
    <div class="kdx-tree-halo"></div>
    <div class="kdx-tree-infinity">∞</div>
    <div class="kdx-tree-trunk"></div>
    <div class="kdx-tree-canopy"></div>
    <div class="kdx-tree-roots"></div>
  </div>
</div>

<script is:inline>
  (() => {
    const scripts = document.querySelectorAll('[data-kdx-tree-wrap]:not(.kdx-initialized)');
    scripts.forEach(root => {
      root.classList.add('kdx-initialized');
      const canvas = root.querySelector('[data-kdx-tree-canvas]');
      if (!canvas) return;
      
      const ctx = canvas.getContext('2d', { alpha: true });
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const pointer = { x: 0.5, y: 0.5, active: 0 };
      const accent = getComputedStyle(root).getPropertyValue('--kdx-accent').trim() || '#A6FF00';
      const hexToRgb = (hex) => {
        const raw = hex.replace('#', '').trim();
        const full = raw.length === 3 ? raw.split('').map((x) => x + x).join('') : raw;
        const num = Number.parseInt(full, 16);
        return {
          r: (num >> 16) & 255,
          g: (num >> 8) & 255,
          b: num & 255
        };
      };
      const rgb = hexToRgb(accent);
      const rgba = (alpha) => `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, ${alpha})`;
      let width = 0;
      let height = 0;
      let dpr = 1;
      let raf = 0;

      const resize = () => {
        const rect = root.getBoundingClientRect();
        dpr = Math.min(devicePixelRatio || 1, innerWidth < 700 ? 1.35 : 1.8);
        width = Math.max(1, Math.floor(rect.width));
        height = Math.max(1, Math.floor(rect.height));
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const move = (event) => {
        const rect = root.getBoundingClientRect();
        const point = event.touches?.[0] ?? event;
        pointer.x = Math.max(0, Math.min(1, (point.clientX - rect.left) / rect.width));
        pointer.y = Math.max(0, Math.min(1, (point.clientY - rect.top) / rect.height));
        pointer.active = 1;
        root.dataset.kdxState = 'aware';
      };

      const line = (points, alpha, weight) => {
        ctx.beginPath();
        points.forEach((p, index) => index ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y));
        ctx.strokeStyle = rgba(alpha);
        ctx.globalAlpha = 1;
        ctx.lineWidth = weight;
        ctx.stroke();
        ctx.globalAlpha = 1;
      };

      const branch = (x, y, length, angle, depth, time, invert = false) => {
        if (depth <= 0 || length < 5) return;
        const sway = Math.sin(time * 0.0014 + depth * 1.7 + pointer.x * 2.4) * 0.15;
        const x2 = x + Math.cos(angle + sway) * length;
        const y2 = y + Math.sin(angle + sway) * length * (invert ? 0.86 : 1);
        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x2, y2);
        ctx.strokeStyle = accent;
        ctx.globalAlpha = 0.06 + depth * 0.022;
        ctx.lineWidth = Math.max(0.55, depth * 0.42);
        ctx.stroke();
        ctx.globalAlpha = 1;
        const split = 0.48 + pointer.active * 0.08;
        branch(x2, y2, length * (0.72 - depth * 0.012), angle - split, depth - 1, time, invert);
        branch(x2, y2, length * (0.68 - depth * 0.012), angle + split, depth - 1, time, invert);
        if (depth % 2 === 0) branch(x2, y2, length * 0.42, angle + Math.sin(time * 0.0008 + depth) * 0.7, depth - 2, time, invert);
      };

      const draw = (time) => {
        const cx = width * 0.5;
        const cy = height * (innerWidth < 700 ? 0.42 : 0.48);
        const pulse = reduce ? 0.45 : (Math.sin(time * 0.0018) + 1) * 0.5;
        const response = parseFloat(root.dataset.response || '0.72');

        ctx.clearRect(0, 0, width, height);
        
        const gradient = ctx.createRadialGradient(cx, cy, 0, cx, cy, Math.min(width, height) * 0.44);
        gradient.addColorStop(0, accent);
        gradient.addColorStop(0.18, 'rgba(166,255,0,0.16)');
        gradient.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.globalAlpha = 0.18 + pulse * 0.08;
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, width, height);
        ctx.globalAlpha = 1;

        for (let i = 0; i < 5; i += 1) {
          ctx.beginPath();
          ctx.ellipse(cx, cy, 120 + i * 46 + pulse * 8, 42 + i * 18, i * 0.18 + time * 0.00012, 0, Math.PI * 2);
          ctx.strokeStyle = accent;
          ctx.globalAlpha = 0.06;
          ctx.lineWidth = 1;
          ctx.stroke();
        }
        ctx.globalAlpha = 1;

        branch(cx, cy + 18, Math.min(width, height) * 0.11, -Math.PI / 2, innerWidth < 700 ? 7 : 8, time, false);
        branch(cx, cy + 38, Math.min(width, height) * 0.1, Math.PI / 2, innerWidth < 700 ? 6 : 7, time + 900, true);

        ctx.beginPath();
        ctx.moveTo(cx, cy - height * 0.18);
        ctx.bezierCurveTo(cx - 34, cy - 30, cx - 18, cy + 78, cx, cy + height * 0.18);
        ctx.bezierCurveTo(cx + 18, cy + 78, cx + 34, cy - 30, cx, cy - height * 0.18);
        ctx.strokeStyle = accent;
        ctx.globalAlpha = 0.48;
        ctx.lineWidth = 2.2;
        ctx.stroke();
        ctx.globalAlpha = 1;

        ctx.font = `${Math.min(width, height) * 0.22}px Oxanium, sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.shadowColor = accent;
        ctx.shadowBlur = 30 + pulse * 20;
        ctx.fillStyle = 'rgba(232,229,223,0.92)';
        ctx.fillText('∞', cx, cy);
        ctx.shadowBlur = 0;

        const leaves = innerWidth < 700 ? 48 : 92;
        for (let i = 0; i < leaves; i += 1) {
          const a = i * 2.399 + time * 0.00016 * (reduce ? 0 : 1);
          const r = Math.sqrt(i / leaves) * Math.min(width, height) * 0.33;
          const x = cx + Math.cos(a) * r * (1.15 + pointer.x * response * 0.16);
          const y = cy - height * 0.16 + Math.sin(a) * r * 0.52;
          ctx.fillStyle = accent;
          ctx.globalAlpha = 0.16 + ((i % 7) / 7) * 0.28;
          ctx.fillRect(x, y, 1.3 + pulse * 1.4, 1.3 + pulse * 1.4);
        }
        ctx.globalAlpha = 1;

        const traces = innerWidth < 700 ? 14 : 22;
        for (let i = 0; i < traces; i += 1) {
          const t = i / traces;
          line([
            { x: cx, y: cy },
            { x: width * (0.1 + t * 0.8), y: height * (0.12 + ((i * 47) % 70) / 100) }
          ], 0.06 + pulse * 0.04, 0.8);
        }

        root.style.setProperty('--kdx-pulse', String(pulse));
        if (!reduce) raf = requestAnimationFrame(draw);
      };

      resize();
      addEventListener('resize', resize, { passive: true });
      root.addEventListener('pointermove', move, { passive: true });
      root.addEventListener('touchmove', move, { passive: true });
      root.addEventListener('pointerleave', () => { pointer.active = 0; root.dataset.kdxState = 'active'; });
      draw(0);
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting && !reduce) {
             cancelAnimationFrame(raf);
          } else if (entry.isIntersecting && !reduce) {
             raf = requestAnimationFrame(draw);
          }
        });
      });
      observer.observe(root);
      
      addEventListener('pagehide', () => cancelAnimationFrame(raf), { once: true });
    });
  })();
</script>

<style>
  .kdx-tree-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
  }
  .kdx-tree-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .kdx-tree-phenomenon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(54vw, 760px);
    height: min(74vh, 760px);
    transform: translate(-46%, -50%);
    pointer-events: none;
    z-index: 2;
  }
  .kdx-tree-halo {
    position: absolute;
    inset: 8%;
    border: 1px solid color-mix(in srgb, var(--kdx-accent) 38%, transparent);
    border-radius: 50%;
    box-shadow:
      0 0 44px color-mix(in srgb, var(--kdx-accent) 18%, transparent),
      inset 0 0 60px rgba(0,0,0,.82);
    animation: kdx-chamber-breathe 7s ease-in-out infinite;
  }
  .kdx-tree-infinity {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: "Oxanium", system-ui, sans-serif;
    font-size: min(23vw, 250px);
    color: rgba(232,229,223,.14);
    text-shadow: 0 0 36px color-mix(in srgb, var(--kdx-accent) 30%, transparent);
  }
  .kdx-tree-trunk,
  .kdx-tree-canopy,
  .kdx-tree-roots {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    border-color: var(--kdx-accent);
  }
  .kdx-tree-trunk {
    top: 28%;
    bottom: 24%;
    width: 2px;
    background: linear-gradient(transparent, var(--kdx-accent), transparent);
    box-shadow: 0 0 22px var(--kdx-accent);
  }
  .kdx-tree-canopy,
  .kdx-tree-roots {
    width: 58%;
    height: 24%;
    border: 1px solid color-mix(in srgb, var(--kdx-accent) 18%, transparent);
    opacity: .38;
  }
  .kdx-tree-canopy {
    top: 8%;
    border-bottom: 0;
    border-radius: 50% 50% 0 0;
  }
  .kdx-tree-roots {
    bottom: 8%;
    border-top: 0;
    border-radius: 0 0 50% 50%;
  }

  @keyframes kdx-chamber-breathe {
    0%, 100% { transform: scale(.985); opacity: .72; }
    50% { transform: scale(1.025); opacity: 1; }
  }
  
  @media (max-width: 900px) {
    .kdx-tree-phenomenon {
      top: 43%;
      width: 118vw;
      height: 58vh;
      transform: translate(-50%, -50%);
      opacity: .9;
    }
  }
</style>
