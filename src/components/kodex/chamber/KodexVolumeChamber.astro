---
import KodexTreeCanvas from './KodexTreeCanvas.astro';
type AccentName = 'gold' | 'red' | 'violet' | 'cyan' | 'acid' | 'magenta' | 'indigo' | 'bone';

type KodexNode = {
  id: string;
  slug: string;
  type: string;
  title: string;
  subtitle?: string;
  status: string;
  mode: string;
  accent: AccentName;
  summary: string;
  proposition: string;
  visualAnchor: { kind: string; label: string; role?: string };
  specimens?: Array<{ kind: string; label: string; role?: string }>;
  relationships: Array<{ id: string; label: string; type: string; href?: string }>;
  symbols: string[];
  protocols: Array<{ id: string; label: string; steps: string[] }>;
  sources: Array<{ label: string; type: string; path?: string }>;
  behavior: {
    engine: string;
    tempo: number;
    entropy: number;
    responsiveness: number;
    persistence: number;
    topology: string;
    states?: string[];
    verbs?: string[];
  };
  visibility: string;
  version: string;
  checksum: string;
  editorial?: { language: string; body: string };
  actions?: Array<{ label: string; href: string; primary?: boolean }>;
};

const { node } = Astro.props as { node: KodexNode };

const accentMap: Record<AccentName, string> = {
  gold: '#C9A84C',
  red: '#FF2E22',
  violet: '#B770FF',
  cyan: '#00D8FF',
  acid: '#A6FF00',
  magenta: '#FF00CF',
  indigo: '#2936FF',
  bone: '#E8E5DF',
};

const accent = accentMap[node.accent] ?? accentMap.acid;
const protocol = node.protocols[0];
const primary = node.actions?.find((a) => a.primary) ?? node.actions?.[0];
const secondary = node.actions?.filter((a) => a !== primary) ?? [];
const behaviorLabel = `${node.behavior.engine} / ${node.behavior.topology}`;
---

<section
  class={`kdx-chamber kdx-chamber--${node.mode}`}
  data-kdx-volume-chamber
  data-node={JSON.stringify(node)}
  style={`--kdx-accent:${accent}`}
>
  <KodexTreeCanvas accent={accent} response={node.behavior.responsiveness} id={`tree-canvas-${node.slug}`} />

  <section class="kdx-chamber__proposition">
    <p>{node.proposition}</p>
    <div class="kdx-chamber__actions">
      {primary && <a class="kdx-chamber__action kdx-chamber__action--primary" href={primary.href}>{primary.label}</a>}
      {secondary.map((action) => <a class="kdx-chamber__action" href={action.href}>{action.label}</a>)}
    </div>
  </section>

  <section class="kdx-chamber__relations" data-kdx-scrollable>
    <p>RELATION MAP</p>
    {node.relationships.map((rel) => (
      <a href={rel.href ?? '#'} style={`--rel:${accent}`}>
        <span>{rel.type}</span>
        <b>{rel.label}</b>
      </a>
    ))}
  </section>

  <section class="kdx-chamber__editorial" data-kdx-scrollable>
    <p>EDITORIAL LAYER · ES</p>
    <div>{node.editorial?.body}</div>
  </section>

  <section class="kdx-chamber__plate">
    <div class="kdx-chamber__plate-head">
      <span>TECHNICAL PLATE</span>
      <b>{behaviorLabel}</b>
    </div>
    <dl>
      <div><dt>TEMPO</dt><dd>{node.behavior.tempo.toFixed(2)}</dd></div>
      <div><dt>ENTROPY</dt><dd>{node.behavior.entropy.toFixed(2)}</dd></div>
      <div><dt>RESPONSE</dt><dd>{node.behavior.responsiveness.toFixed(2)}</dd></div>
      <div><dt>PERSIST</dt><dd>{node.behavior.persistence.toFixed(2)}</dd></div>
    </dl>
    {protocol && (
      <ol>
        {protocol.steps.map((step) => <li>{step}</li>)}
      </ol>
    )}
  </section>

  <footer class="kdx-chamber__bottom">
    <span>{node.symbols.join(' / ')}</span>
    <span>{node.sources.map((source) => source.type.toUpperCase()).join(' · ')}</span>
  </footer>
</section>



<style>
  .kdx-chamber {
    --kdx-panel: rgba(5, 5, 5, 0.74);
    position: relative;
    height: 100dvh;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--kdx-accent) 12%, transparent), transparent 38%),
      linear-gradient(180deg, #030303, #080807 46%, #000);
    color: #e8e5df;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
  }

  .kdx-chamber__canvas,
  .kdx-chamber__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .kdx-chamber__canvas { z-index: 1; }

  .kdx-chamber__grid {
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(rgba(232,229,223,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232,229,223,.035) 1px, transparent 1px),
      repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 4px);
    background-size: 54px 54px, 54px 54px, auto;
    mask-image: radial-gradient(circle at 50% 48%, black, transparent 78%);
    opacity: .72;
  }

  .kdx-chamber > :not(.kdx-chamber__canvas):not(.kdx-chamber__grid) {
    position: absolute;
    z-index: 3;
  }

  .kdx-chamber a { color: inherit; text-decoration: none; }

  .kdx-chamber__top,
  .kdx-chamber__bottom {
    left: clamp(14px, 3vw, 36px);
    right: clamp(14px, 3vw, 36px);
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    gap: clamp(12px, 2vw, 28px);
    align-items: center;
    color: rgba(232,229,223,.62);
    font-size: 9px;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .kdx-chamber__top {
    top: clamp(14px, 2vw, 24px);
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(232,229,223,.12);
  }

  .kdx-chamber__brand {
    font-family: "Oxanium", "Barlow Condensed", system-ui, sans-serif;
    font-size: clamp(18px, 2vw, 28px);
    font-weight: 800;
    color: #f3f0e8;
    letter-spacing: .04em;
  }

  .kdx-chamber__bottom {
    bottom: clamp(14px, 2vw, 24px);
    grid-template-columns: 1fr auto;
    padding-top: 12px;
    border-top: 1px solid rgba(232,229,223,.12);
  }

  .kdx-chamber__identity {
    left: clamp(18px, 4vw, 58px);
    top: clamp(86px, 13vh, 132px);
    max-width: min(44vw, 620px);
  }

  .kdx-chamber__over {
    margin: 0 0 8px;
    color: var(--kdx-accent);
    font-size: 10px;
    letter-spacing: .28em;
    text-transform: uppercase;
  }

  .kdx-chamber__identity h1 {
    margin: 0;
    max-width: 8ch;
    font-family: "Barlow Condensed", "Inter Tight", system-ui, sans-serif;
    font-size: clamp(5.8rem, 13vw, 14.5rem);
    font-weight: 900;
    line-height: .74;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .kdx-chamber__summary {
    max-width: 42ch;
    margin: 18px 0 0;
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: clamp(.92rem, 1.4vw, 1.18rem);
    line-height: 1.35;
    color: rgba(232,229,223,.68);
  }

  .kdx-chamber__phenomenon {
    left: 50%;
    top: 50%;
    width: min(54vw, 760px);
    height: min(74vh, 760px);
    transform: translate(-46%, -50%);
    pointer-events: none;
  }

  .kdx-chamber__halo {
    position: absolute;
    inset: 8%;
    border: 1px solid color-mix(in srgb, var(--kdx-accent) 38%, transparent);
    border-radius: 50%;
    box-shadow:
      0 0 44px color-mix(in srgb, var(--kdx-accent) 18%, transparent),
      inset 0 0 60px rgba(0,0,0,.82);
    animation: kdx-chamber-breathe 7s ease-in-out infinite;
  }

  .kdx-chamber__infinity {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: "Oxanium", system-ui, sans-serif;
    font-size: min(23vw, 250px);
    color: rgba(232,229,223,.14);
    text-shadow: 0 0 36px color-mix(in srgb, var(--kdx-accent) 30%, transparent);
  }

  .kdx-chamber__trunk,
  .kdx-chamber__canopy,
  .kdx-chamber__roots {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    border-color: var(--kdx-accent);
  }

  .kdx-chamber__trunk {
    top: 28%;
    bottom: 24%;
    width: 2px;
    background: linear-gradient(transparent, var(--kdx-accent), transparent);
    box-shadow: 0 0 22px var(--kdx-accent);
  }

  .kdx-chamber__canopy,
  .kdx-chamber__roots {
    width: 58%;
    height: 24%;
    border: 1px solid color-mix(in srgb, var(--kdx-accent) 18%, transparent);
    opacity: .38;
  }

  .kdx-chamber__canopy {
    top: 8%;
    border-bottom: 0;
    border-radius: 50% 50% 0 0;
  }

  .kdx-chamber__roots {
    bottom: 8%;
    border-top: 0;
    border-radius: 0 0 50% 50%;
  }

  .kdx-chamber__evidence {
    width: min(21vw, 270px);
    padding: 12px;
    border: 1px solid color-mix(in srgb, var(--kdx-accent) 28%, transparent);
    background: var(--kdx-panel);
    backdrop-filter: blur(10px);
  }

  .kdx-chamber__evidence--left {
    left: clamp(18px, 4vw, 58px);
    bottom: clamp(94px, 14vh, 148px);
  }

  .kdx-chamber__evidence--right {
    right: clamp(18px, 4vw, 58px);
    top: clamp(92px, 13vh, 138px);
  }

  .kdx-chamber__evidence p,
  .kdx-chamber__relations p,
  .kdx-chamber__editorial p {
    margin: 0 0 10px;
    color: var(--kdx-accent);
    font-size: 8px;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .kdx-chamber dl {
    display: grid;
    gap: 1px;
    margin: 0;
  }

  .kdx-chamber dl div {
    display: grid;
    grid-template-columns: minmax(70px, .55fr) 1fr;
    gap: 10px;
    min-width: 0;
    padding: 7px 0;
    border-bottom: 1px solid rgba(232,229,223,.1);
  }

  .kdx-chamber dt,
  .kdx-chamber dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 8px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .kdx-chamber dt { color: rgba(232,229,223,.42); }
  .kdx-chamber dd { color: rgba(232,229,223,.78); }

  .kdx-chamber__specimens {
    display: grid;
    gap: 10px;
  }

  .kdx-chamber__specimens figure {
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 10px;
    align-items: center;
    margin: 0;
  }

  .kdx-chamber__specimens span {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--kdx-accent) 42%, transparent);
    background:
      radial-gradient(circle, color-mix(in srgb, var(--kdx-accent) 25%, transparent), transparent 50%),
      repeating-linear-gradient(90deg, rgba(255,255,255,.12) 0 1px, transparent 1px 5px);
    color: var(--kdx-accent);
    font-size: 9px;
  }

  .kdx-chamber__specimens figcaption {
    color: rgba(232,229,223,.58);
    font-size: 8px;
    letter-spacing: .14em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .kdx-chamber__proposition {
    right: clamp(18px, 4vw, 58px);
    bottom: clamp(86px, 13vh, 142px);
    width: min(36vw, 470px);
  }

  .kdx-chamber__proposition p {
    margin: 0;
    font-family: "Libre Baskerville", "Cormorant Garamond", serif;
    font-size: clamp(1.1rem, 2vw, 1.72rem);
    line-height: 1.34;
    color: #f1eee7;
    text-wrap: balance;
  }

  .kdx-chamber__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .kdx-chamber__action {
    min-height: 38px;
    display: inline-grid;
    place-items: center;
    padding: 0 14px;
    border: 1px solid color-mix(in srgb, var(--kdx-accent) 40%, transparent);
    background: rgba(0,0,0,.62);
    font-size: 9px;
    letter-spacing: .16em;
  }

  .kdx-chamber__action--primary,
  .kdx-chamber__action:hover {
    background: var(--kdx-accent);
    color: #030303;
  }

  .kdx-chamber__relations,
  .kdx-chamber__editorial,
  .kdx-chamber__plate {
    border: 1px solid rgba(232,229,223,.12);
    background: rgba(0,0,0,.64);
    backdrop-filter: blur(12px);
  }

  .kdx-chamber__relations {
    left: clamp(18px, 4vw, 58px);
    bottom: clamp(226px, 34vh, 360px);
    width: min(24vw, 320px);
    max-height: 24vh;
    overflow: auto;
    padding: 12px;
  }

  .kdx-chamber__relations a {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(232,229,223,.1);
    font-size: 8px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .kdx-chamber__relations span { color: var(--kdx-accent); }
  .kdx-chamber__relations b { color: rgba(232,229,223,.72); font-weight: 500; }

  .kdx-chamber__editorial {
    right: clamp(18px, 4vw, 58px);
    top: clamp(292px, 42vh, 390px);
    width: min(31vw, 430px);
    max-height: 18vh;
    overflow: auto;
    padding: 13px 15px;
  }

  .kdx-chamber__editorial div {
    font-family: "Inter Tight", system-ui, sans-serif;
    font-size: .92rem;
    line-height: 1.5;
    color: rgba(232,229,223,.72);
  }

  .kdx-chamber__plate {
    left: 50%;
    bottom: clamp(58px, 8vh, 80px);
    width: min(42vw, 620px);
    transform: translateX(-50%);
    padding: 12px;
  }

  .kdx-chamber__plate-head {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(232,229,223,.12);
    color: var(--kdx-accent);
    font-size: 8px;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .kdx-chamber__plate dl {
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 10px;
  }

  .kdx-chamber__plate dl div {
    grid-template-columns: 1fr;
    gap: 4px;
  }

  .kdx-chamber__plate ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px 14px;
    margin: 12px 0 0;
    padding-left: 18px;
    color: rgba(232,229,223,.58);
    font-size: 8px;
    letter-spacing: .08em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  @keyframes kdx-chamber-breathe {
    0%, 100% { transform: scale(.985); opacity: .72; }
    50% { transform: scale(1.025); opacity: 1; }
  }

  @media (max-width: 900px) {
    .kdx-chamber {
      overflow: hidden;
    }

    .kdx-chamber__top {
      grid-template-columns: 1fr auto;
      gap: 8px;
      font-size: 7px;
    }

    .kdx-chamber__top span:nth-of-type(2),
    .kdx-chamber__top span:nth-of-type(3) {
      display: none;
    }

    .kdx-chamber__identity {
      top: 58px;
      left: 16px;
      right: 16px;
      max-width: none;
    }

    .kdx-chamber__identity h1 {
      max-width: 8.8ch;
      font-size: clamp(4.2rem, 22vw, 6.4rem);
    }

    .kdx-chamber__summary {
      max-width: 31ch;
      margin-top: 10px;
      font-size: .86rem;
    }

    .kdx-chamber__phenomenon {
      top: 43%;
      width: 118vw;
      height: 58vh;
      transform: translate(-50%, -50%);
      opacity: .9;
    }

    .kdx-chamber__evidence--left {
      left: 14px;
      right: auto;
      bottom: 202px;
      width: min(44vw, 174px);
      padding: 9px;
    }

    .kdx-chamber__evidence--right {
      right: 14px;
      top: 48%;
      width: min(43vw, 168px);
      padding: 9px;
    }

    .kdx-chamber__evidence p { font-size: 6.5px; margin-bottom: 6px; }
    .kdx-chamber dl div { grid-template-columns: 1fr; gap: 2px; padding: 4px 0; }
    .kdx-chamber dt,
    .kdx-chamber dd,
    .kdx-chamber__specimens figcaption { font-size: 6.5px; letter-spacing: .08em; }
    .kdx-chamber__specimens { gap: 6px; }
    .kdx-chamber__specimens figure { grid-template-columns: 36px 1fr; gap: 7px; }

    .kdx-chamber__relations,
    .kdx-chamber__editorial {
      display: none;
    }

    .kdx-chamber__proposition {
      left: 14px;
      right: 14px;
      bottom: 114px;
      width: auto;
    }

    .kdx-chamber__proposition p {
      max-width: 30ch;
      font-size: .92rem;
      line-height: 1.33;
    }

    .kdx-chamber__actions {
      margin-top: 10px;
    }

    .kdx-chamber__action {
      min-height: 32px;
      padding: 0 10px;
      font-size: 7px;
    }

    .kdx-chamber__plate {
      left: 14px;
      right: 14px;
      bottom: 42px;
      width: auto;
      transform: none;
      padding: 9px;
    }

    .kdx-chamber__plate-head {
      font-size: 6.5px;
      padding-bottom: 6px;
    }

    .kdx-chamber__plate dl {
      grid-template-columns: repeat(4, 1fr);
      gap: 5px;
      margin-top: 7px;
    }

    .kdx-chamber__plate ol {
      display: none;
    }

    .kdx-chamber__bottom {
      display: none;
    }
  }

  @media (max-width: 430px) {
    .kdx-chamber__evidence--left,
    .kdx-chamber__evidence--right {
      display: none;
    }

    .kdx-chamber__identity h1 {
      font-size: clamp(3.8rem, 21vw, 5.8rem);
    }

    .kdx-chamber__summary {
      max-width: 28ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kdx-chamber *,
    .kdx-chamber *::before,
    .kdx-chamber *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
