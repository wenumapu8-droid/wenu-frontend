---
/**
 * KODEX-∞ · MUSEO
 *
 * ARCHIVE no abre como una base de datos. La primera lectura es espacial:
 * el espécimen dominante vive en la escena y este componente muestra un campo
 * acotado de relaciones. El índice completo queda disponible detrás de una
 * acción explícita, sin perder búsqueda ni acceso a los 513+ volúmenes.
 *
 * Fuente de diseño: 08E ARCHIVE — specimen/record → lineage/relations;
 * índice largo detrás de profundidad explícita. No crea una genealogía nueva:
 * cada nodo usa únicamente metadatos ya resueltos del volumen.
 */
import type { VolumenResuelto } from "../../../lib/kodex/volumenes";

interface Props {
  volumenes: VolumenResuelto[];
  class?: string;
}
const { volumenes, class: className = "" } = Astro.props;

/** Celda sin obra: el organismo se dibuja con canvas, barato y distinto. */
const semillaDe = (s: string) => [...s].reduce((a, c) => (a * 31 + c.charCodeAt(0)) % 9973, 7);

/**
 * El campo inicial es deliberadamente acotado. No intenta representar todo el
 * grafo ni inferir relaciones ausentes: expone una muestra determinista de
 * registros reales para orientar la siguiente elección.
 */
const relationNodes = volumenes.slice(0, 9);
---

<section class:list={["kdx-museo", className]} data-kdx-museo>
  <div class="kdx-museo__relation" aria-labelledby="kdx-archive-relations">
    <header class="kdx-museo__relation-head">
      <p id="kdx-archive-relations">RELATION FIELD</p>
      <span>{String(relationNodes.length).padStart(2, "0")} / {volumenes.length}</span>
    </header>

    <ol class="kdx-museo__constellation" aria-label="Related archive volumes">
      {relationNodes.map((v, i) => (
        <li class="kdx-museo__node" style={`--c:${v.color};--node:${i + 1}`}>
          <a href={`/kodex/vol/${v.slug}/`}>
            <span class="kdx-museo__node-mark" aria-hidden="true"></span>
            <span class="kdx-museo__node-copy">
              <b>{v.titulo_es}</b>
              <small>{v.estratoTitulo} · {v.tipo}</small>
            </span>
          </a>
        </li>
      ))}
    </ol>

    <span class="kdx-museo__trace kdx-museo__trace--a" aria-hidden="true"></span>
    <span class="kdx-museo__trace kdx-museo__trace--b" aria-hidden="true"></span>
    <span class="kdx-museo__trace kdx-museo__trace--c" aria-hidden="true"></span>
  </div>

  <details class="kdx-museo__index">
    <summary>
      <span>OPEN FULL INDEX</span>
      <span>{volumenes.length} RECORDS</span>
    </summary>

    <div class="kdx-museo__index-body">
      <header class="kdx-museo__cab">
        <p class="kdx-museo__titulo">
          ÍNDICE DE VOLÚMENES
          <span data-kdx-museo-cuenta>{volumenes.length}</span>
        </p>
        <label class="kdx-museo__buscar">
          <span class="visually-hidden">buscar en el archivo</span>
          <input type="search" placeholder="BUSCAR · SEARCH" data-kdx-museo-buscar autocomplete="off" />
        </label>
      </header>

      <ol class="kdx-museo__grilla">
        {volumenes.map((v) => (
          <li
            class="kdx-museo__celda"
            style={`--c:${v.color}`}
            data-kdx-museo-item
            data-busca={`${v.titulo_es} ${v.titulo_en ?? ""} ${v.tipo} ${v.estratoTitulo} ${v.curaduria_es ?? ""}`.toLowerCase()}
          >
            <a href={`/kodex/vol/${v.slug}/`}>
              <span class="kdx-museo__lienzo" aria-hidden="true">
                {v.hero
                  ? <img src={v.hero.src} alt="" loading="lazy" decoding="async" />
                  : <canvas data-kdx-museo-organismo data-semilla={semillaDe(v.slug)} width="180" height="180"></canvas>}
              </span>
              <span class="kdx-museo__meta">
                <b>{v.titulo_es}</b>
                <small>{v.tipo} · {v.estratoNumero}</small>
              </span>
              <span class="kdx-museo__glifos" aria-hidden="true">{v.glifos}</span>
            </a>
          </li>
        ))}
      </ol>

      <p class="kdx-museo__vacio" data-kdx-museo-vacio hidden>SIN COINCIDENCIAS · NO MATCHES</p>
    </div>
  </details>
</section>

<script>
  import "./kodex-museo-client.ts";
</script>

<style>
  .kdx-museo {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 10px;
    min-height: 0;
    height: 100%;
  }

  .kdx-museo__relation {
    position: relative;
    min-height: 0;
    overflow: hidden;
    border: 1px solid rgba(232, 229, 222, 0.12);
    background:
      radial-gradient(circle at 50% 48%, color-mix(in srgb, var(--acc, #A7FF00) 8%, transparent), transparent 34%),
      linear-gradient(rgba(232, 229, 222, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232, 229, 222, 0.025) 1px, transparent 1px);
    background-size: auto, 28px 28px, 28px 28px;
  }

  .kdx-museo__relation-head {
    position: absolute;
    inset: 10px 12px auto 12px;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 8px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(232, 229, 222, 0.48);
  }
  .kdx-museo__relation-head p { margin: 0; }
  .kdx-museo__relation-head span { color: var(--acc, #A7FF00); font-variant-numeric: tabular-nums; }

  .kdx-museo__constellation {
    position: absolute;
    inset: 34px 18px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kdx-museo__node {
    position: absolute;
    z-index: 2;
    width: clamp(92px, 16vw, 150px);
  }
  .kdx-museo__node:nth-child(1) { left: 5%; top: 12%; }
  .kdx-museo__node:nth-child(2) { left: 39%; top: 4%; }
  .kdx-museo__node:nth-child(3) { right: 5%; top: 15%; }
  .kdx-museo__node:nth-child(4) { left: 15%; top: 43%; }
  .kdx-museo__node:nth-child(5) { left: 43%; top: 39%; }
  .kdx-museo__node:nth-child(6) { right: 11%; top: 47%; }
  .kdx-museo__node:nth-child(7) { left: 5%; bottom: 5%; }
  .kdx-museo__node:nth-child(8) { left: 42%; bottom: 2%; }
  .kdx-museo__node:nth-child(9) { right: 4%; bottom: 7%; }

  .kdx-museo__node a {
    display: grid;
    grid-template-columns: 13px minmax(0, 1fr);
    gap: 7px;
    align-items: start;
    color: inherit;
    text-decoration: none;
  }
  .kdx-museo__node a:focus-visible {
    outline: 1px solid var(--c, var(--acc, #A7FF00));
    outline-offset: 4px;
  }

  .kdx-museo__node-mark {
    position: relative;
    width: 11px;
    height: 11px;
    margin-top: 2px;
    border: 1px solid color-mix(in srgb, var(--c, var(--acc, #A7FF00)) 72%, #e8e5df);
    border-radius: 50%;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c, var(--acc, #A7FF00)) 8%, transparent);
  }
  .kdx-museo__node-mark::after {
    content: "";
    position: absolute;
    inset: 3px;
    border-radius: inherit;
    background: var(--c, var(--acc, #A7FF00));
  }

  .kdx-museo__node-copy {
    display: grid;
    gap: 2px;
    min-width: 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    text-transform: uppercase;
  }
  .kdx-museo__node-copy b {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 8.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: rgba(232, 229, 222, 0.88);
  }
  .kdx-museo__node-copy small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 6.5px;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c, var(--acc, #A7FF00)) 58%, #777);
  }

  .kdx-museo__trace {
    position: absolute;
    z-index: 1;
    left: 18%;
    top: 50%;
    width: 64%;
    height: 1px;
    transform-origin: 50% 50%;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--acc, #A7FF00) 28%, transparent), transparent);
    pointer-events: none;
  }
  .kdx-museo__trace--a { transform: rotate(14deg); }
  .kdx-museo__trace--b { transform: rotate(-18deg); }
  .kdx-museo__trace--c { transform: rotate(56deg); width: 44%; left: 28%; }

  .kdx-museo__index {
    position: relative;
    min-height: 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
  }
  .kdx-museo__index > summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    list-style: none;
    cursor: pointer;
    border-top: 1px solid rgba(232, 229, 222, 0.14);
    padding: 8px 2px 2px;
    font-size: 8px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(232, 229, 222, 0.54);
  }
  .kdx-museo__index > summary::-webkit-details-marker { display: none; }
  .kdx-museo__index > summary::before { content: "+"; color: var(--acc, #A7FF00); margin-right: 8px; }
  .kdx-museo__index[open] > summary::before { content: "−"; }
  .kdx-museo__index > summary:focus-visible { outline: 1px solid var(--acc, #A7FF00); outline-offset: 3px; }

  .kdx-museo__index-body {
    position: absolute;
    z-index: 8;
    left: 0;
    right: 0;
    bottom: calc(100% + 8px);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 10px;
    height: min(58vh, 520px);
    padding: 12px;
    border: 1px solid rgba(232, 229, 222, 0.18);
    background: rgba(5, 5, 7, 0.98);
    box-shadow: 0 -16px 48px rgba(0, 0, 0, 0.5);
  }

  .kdx-museo__cab {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(232, 229, 222, 0.5);
  }
  .kdx-museo__titulo { margin: 0; display: flex; gap: 10px; }
  .kdx-museo__titulo span { color: var(--acc, #FF3833); font-variant-numeric: tabular-nums; }

  .kdx-museo__buscar input {
    background: transparent; color: #e8e5df;
    border: 1px solid rgba(232, 229, 222, 0.18);
    padding: 6px 10px; width: min(200px, 34vw);
    font-family: inherit; font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  }
  .kdx-museo__buscar input:focus-visible { outline: 1px solid var(--acc, #FF3833); border-color: var(--acc, #FF3833); }

  .kdx-museo__grilla {
    margin: 0; padding: 0; list-style: none;
    display: grid; gap: 1px;
    grid-template-columns: repeat(auto-fill, minmax(clamp(96px, 11vw, 148px), 1fr));
    background: rgba(232, 229, 222, 0.08);
    border: 1px solid rgba(232, 229, 222, 0.08);
    overflow-y: auto;
    min-height: 0;
  }

  .kdx-museo__celda { background: #050507; }
  .kdx-museo__celda[hidden] { display: none; }
  .kdx-museo__celda a {
    position: relative; display: grid; gap: 0;
    text-decoration: none; color: inherit;
    transition: background 180ms ease;
  }
  .kdx-museo__celda a:hover,
  .kdx-museo__celda a:focus-visible {
    background: color-mix(in srgb, var(--c) 12%, transparent);
    outline: none;
  }
  .kdx-museo__celda a:hover .kdx-museo__lienzo::after,
  .kdx-museo__celda a:focus-visible .kdx-museo__lienzo::after { opacity: 0.34; }

  .kdx-museo__lienzo { position: relative; display: block; aspect-ratio: 1; overflow: hidden; }
  .kdx-museo__lienzo::after {
    content: ""; position: absolute; inset: 0; background: var(--c);
    mix-blend-mode: screen; opacity: 0.12; transition: opacity 200ms ease;
  }
  .kdx-museo__lienzo img,
  .kdx-museo__lienzo canvas {
    display: block; width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.25);
  }

  .kdx-museo__meta {
    display: grid; gap: 2px; padding: 6px 8px 8px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
  }
  .kdx-museo__meta b {
    font-size: 9.5px; font-weight: 500; letter-spacing: 0.08em;
    color: #e8e5df; text-transform: uppercase;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .kdx-museo__meta small {
    font-size: 8px; letter-spacing: 0.16em; text-transform: uppercase;
    color: color-mix(in srgb, var(--c) 66%, #8b8b8b);
  }

  .kdx-museo__glifos {
    position: absolute; top: 5px; right: 6px;
    font-size: 10px; letter-spacing: 0.14em; color: rgba(232, 229, 222, 0.42);
  }

  .kdx-museo__vacio {
    margin: 0; padding: 20px 0; text-align: center;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.22em; color: rgba(232, 229, 222, 0.4);
  }

  @media (max-width: 720px) {
    .kdx-museo__constellation {
      inset: 32px 8px 10px;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-content: center;
      gap: 12px 8px;
    }
    .kdx-museo__node,
    .kdx-museo__node:nth-child(n) {
      position: relative;
      inset: auto;
      width: auto;
    }
    .kdx-museo__node a { grid-template-columns: 10px minmax(0, 1fr); gap: 5px; }
    .kdx-museo__node-mark { width: 8px; height: 8px; }
    .kdx-museo__node-mark::after { inset: 2px; }
    .kdx-museo__node-copy b { font-size: 6.8px; }
    .kdx-museo__node-copy small { font-size: 5.6px; }
    .kdx-museo__trace { opacity: 0.45; }
    .kdx-museo__index-body {
      position: fixed;
      inset: 12vh 10px 12vh;
      height: auto;
      max-height: 76dvh;
    }
    .kdx-museo__cab { align-items: stretch; flex-direction: column; gap: 8px; }
    .kdx-museo__buscar input { width: 100%; }
    .kdx-museo__grilla { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .kdx-museo__celda a,
    .kdx-museo__lienzo::after { transition: none; }
  }

  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
</style>