---
// Isolated PROTOTIPO inside THRESHOLD; never changes scene navigation.
import '../../../styles/kodex-archetypes.css';
---
<div class="kdx-archetypes" data-kdx-archetypes hidden role="dialog" aria-modal="true" aria-labelledby="kdx-archetypes-title" aria-describedby="kdx-archetypes-description">
  <div class="kdx-archetypes__backdrop" aria-hidden="true"></div>
  <div class="kdx-archetypes__shell">
    <canvas class="kdx-archetypes__rain" data-kdx-rain aria-hidden="true"></canvas>
    <div class="kdx-archetypes__content">
      <header class="kdx-archetypes__header">
        <span class="kdx-archetypes__identifier">KODEX−∞ / THRESHOLD / EXP. 01</span>
        <span class="kdx-archetypes__prototype">PROTOTIPO</span>
        <button class="kdx-archetypes__close" data-kdx-archetype-close type="button" aria-label="Cerrar motor de arquetipos">✕</button>
      </header>
      <div class="kdx-archetypes__intro">
        <p class="kdx-archetypes__eyebrow">UN SISTEMA QUE OBSERVA ELECCIONES</p>
        <h2 id="kdx-archetypes-title">PATRONES<br />EN FORMACIÓN</h2>
        <p id="kdx-archetypes-description">Elige el glifo que más te atrae. KODEX reconoce relaciones entre tus decisiones, no mide tu conciencia ni define quién eres.</p>
      </div>
      <div class="kdx-archetypes__measure" aria-label="Estado del recorrido">
        <span data-kdx-progress>00 / 12</span>
        <div class="kdx-archetypes__track" aria-hidden="true"><span data-kdx-progress-bar></span></div>
        <span data-kdx-frequency>F −100.00</span>
      </div>
      <div class="kdx-archetypes__question" data-kdx-question-view>
        <p class="kdx-archetypes__prompt" data-kdx-question-prompt></p>
        <div class="kdx-archetypes__options">
          <button type="button" class="kdx-archetypes__option" data-kdx-answer="a" aria-label="Elegir glifo A">
            <span class="kdx-archetypes__option-index">A · 01</span>
            <span class="kdx-archetypes__glyph" data-kdx-glyph-a aria-hidden="true">◇</span>
            <span class="kdx-archetypes__option-label" data-kdx-label-a>FORMA A</span>
          </button>
          <button type="button" class="kdx-archetypes__option" data-kdx-answer="b" aria-label="Elegir glifo B">
            <span class="kdx-archetypes__option-index">B · 02</span>
            <span class="kdx-archetypes__glyph" data-kdx-glyph-b aria-hidden="true">◉</span>
            <span class="kdx-archetypes__option-label" data-kdx-label-b>FORMA B</span>
          </button>
        </div>
        <button type="button" class="kdx-archetypes__reject" data-kdx-reject>Ninguno me representa · Omitir pareja</button>
      </div>
      <section class="kdx-archetypes__map" data-kdx-map-view hidden aria-labelledby="kdx-archetypes-map-title">
        <p class="kdx-archetypes__eyebrow">ARCHIVO LOCAL / RESULTADO EXPLORATORIO</p>
        <h3 id="kdx-archetypes-map-title">TU MAPA</h3>
        <p class="kdx-archetypes__map-desc">Correspondencias de esta sesión, no un diagnóstico ni una identidad fija.</p>
        <div class="kdx-archetypes__top" data-kdx-top></div>
        <svg class="kdx-archetypes__constellation" data-kdx-constellation viewBox="0 0 600 200" role="img" aria-label="Constelación del orden de las doce decisiones"></svg>
        <ol class="kdx-archetypes__journey" data-kdx-journey aria-label="Recorrido de decisiones"></ol>
        <button type="button" class="kdx-archetypes__restart" data-kdx-restart>REINICIAR EXPLORACIÓN</button>
      </section>
      <footer class="kdx-archetypes__footer">
        <span data-kdx-save-status aria-live="polite">MEMORIA LOCAL</span>
        <span>F = PARÁMETRO ARTÍSTICO</span>
        <button type="button" data-kdx-delete class="kdx-archetypes__delete">BORRAR MI MEMORIA LOCAL</button>
      </footer>
      <p class="kdx-archetypes__sr" data-kdx-announcement role="status" aria-live="polite"></p>
    </div>
  </div>
</div>
<script>
  import { mountArchetypeThreshold } from '../../../scripts/kodex-archetypes-ui.js';
  mountArchetypeThreshold();
</script>
