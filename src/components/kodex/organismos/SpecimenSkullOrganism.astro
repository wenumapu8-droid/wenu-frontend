---
/**
 * KODEX-∞ · ORGANISM 05: SPECIMEN SKULL
 *
 * Biological dossier organism, thermal scanlines, bitmap threshold & ARIA contract.
 */
interface Props {
  state?: "SCAN" | "ANALYZE" | "CLASSIFY";
  class?: string;
}

const { state = "SCAN", class: className = "" } = Astro.props;
---

<div class={`kdx-organism-skull ${className}`.trim()} data-kdx-organism="specimen-skull" data-state={state} aria-label="Organismo Especimen Skull: Dossier biológico y escaneo bitmap">
  <div class="kdx-organism-skull__viewport" aria-hidden="true">
    <svg class="kdx-organism-skull__svg" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="200" cy="180" r="120" stroke="var(--kdx-red, #FF3833)" stroke-width="2" stroke-dasharray="8 4" />
      <path d="M140 180 Q200 120 260 180 Q200 240 140 180 Z" stroke="#00F7FF" stroke-width="1.5" />
      <circle cx="160" cy="180" r="18" fill="var(--kdx-red, #FF3833)" />
      <circle cx="240" cy="180" r="18" fill="#00F7FF" />
      <rect x="170" y="240" width="60" height="40" rx="4" stroke="#A6FF00" stroke-width="2" />
      <line x1="180" y1="240" x2="180" y2="280" stroke="#A6FF00" stroke-width="1" />
      <line x1="200" y1="240" x2="200" y2="280" stroke="#A6FF00" stroke-width="1" />
      <line x1="220" y1="240" x2="220" y2="280" stroke="#A6FF00" stroke-width="1" />
    </svg>
    <div class="kdx-organism-skull__grid"></div>
  </div>
  <div class="kdx-organism-skull__meta">
    <span class="kdx-organism-skull__tag">ORG_05 :: SPECIMEN_SKULL</span>
    <span class="kdx-organism-skull__status" data-kdx-state-chip>{state}</span>
  </div>
</div>

<style>
  .kdx-organism-skull {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1;
    background: #050507;
    border: 1px solid rgba(232, 229, 222, 0.15);
    overflow: hidden;
  }
  .kdx-organism-skull__viewport {
    position: relative;
    width: 80%;
    height: 80%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .kdx-organism-skull__svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 12px rgba(255, 56, 51, 0.4));
  }
  .kdx-organism-skull__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(232, 229, 222, 0.05) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(232, 229, 222, 0.05) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
  }
  .kdx-organism-skull__meta {
    position: absolute;
    bottom: 8px;
    left: 12px;
    right: 12px;
    display: flex;
    justify-content: space-between;
    font-family: "IBM Plex Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.15em;
    color: rgba(232, 229, 222, 0.6);
  }
  .kdx-organism-skull__status {
    color: var(--kdx-red, #FF3833);
    font-weight: bold;
  }
</style>
