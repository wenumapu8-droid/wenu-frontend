---
/**
 * KODEX-∞ · ORGANISM 06: RITUAL DEVICE
 *
 * Ceremonial artifact organism, glitch fracture, SVG heart-core pulse & ARIA contract.
 */
interface Props {
  state?: "IDLE" | "CHARGING" | "ACTIVATE";
  class?: string;
}

const { state = "IDLE", class: className = "" } = Astro.props;
---

<div class={`kdx-organism-ritual ${className}`.trim()} data-kdx-organism="ritual-device" data-state={state} aria-label="Organismo Ritual Device: Artefacto ceremonial tecno-ritual">
  <div class="kdx-organism-ritual__viewport" aria-hidden="true">
    <svg class="kdx-organism-ritual__svg" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
      <polygon points="200,40 340,320 60,320" stroke="#00F7FF" stroke-width="2" />
      <polygon points="200,360 60,80 340,80" stroke="#903CFF" stroke-width="1.5" stroke-dasharray="6 3" />
      <circle cx="200" cy="200" r="45" fill="var(--kdx-red, #FF3833)" opacity="0.85" />
      <circle cx="200" cy="200" r="70" stroke="#FF2CF0" stroke-width="2" />
    </svg>
  </div>
  <div class="kdx-organism-ritual__meta">
    <span class="kdx-organism-ritual__tag">ORG_06 :: RITUAL_DEVICE</span>
    <span class="kdx-organism-ritual__status">{state}</span>
  </div>
</div>

<style>
  .kdx-organism-ritual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1;
    background: #050507;
    border: 1px solid rgba(232, 229, 222, 0.15);
    overflow: hidden;
  }
  .kdx-organism-ritual__viewport {
    position: relative;
    width: 80%;
    height: 80%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .kdx-organism-ritual__svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 16px rgba(0, 247, 255, 0.5));
  }
  .kdx-organism-ritual__meta {
    position: absolute;
    bottom: 8px;
    left: 12px;
    right: 12px;
    display: flex;
    justify-content: space-between;
    font-family: "IBM Plex Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.15em;
    color: rgba(232, 229, 222, 0.6);
  }
  .kdx-organism-ritual__status {
    color: #00F7FF;
    font-weight: bold;
  }
</style>
