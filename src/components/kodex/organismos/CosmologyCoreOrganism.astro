---
/**
 * KODEX-∞ · ORGANISM 07: COSMOLOGY CORE
 *
 * Planetary orbits, concentric rotators, thermal map & ARIA contract.
 */
interface Props {
  state?: "IDLE" | "ORBITING" | "EXPAND";
  class?: string;
}

const { state = "ORBITING", class: className = "" } = Astro.props;
---

<div class={`kdx-organism-cosmology ${className}`.trim()} data-kdx-organism="cosmology-core" data-state={state} aria-label="Organismo Cosmology Core: Registro macro de relaciones planetarias y arquetipos">
  <div class="kdx-organism-cosmology__viewport" aria-hidden="true">
    <svg class="kdx-organism-cosmology__svg" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="200" cy="200" r="160" stroke="#903CFF" stroke-width="1.5" stroke-dasharray="10 5" />
      <circle cx="200" cy="200" r="110" stroke="#FF2CF0" stroke-width="2" />
      <circle cx="200" cy="200" r="60" stroke="#00F7FF" stroke-width="1.5" />
      <circle cx="200" cy="200" r="24" fill="#00F7FF" />
      <circle cx="200" cy="90" r="10" fill="#FF2CF0" />
      <circle cx="310" cy="200" r="14" fill="#903CFF" />
      <circle cx="140" cy="200" r="8" fill="var(--kdx-red, #FF3833)" />
    </svg>
  </div>
  <div class="kdx-organism-cosmology__meta">
    <span class="kdx-organism-cosmology__tag">ORG_07 :: COSMOLOGY_CORE</span>
    <span class="kdx-organism-cosmology__status">{state}</span>
  </div>
</div>

<style>
  .kdx-organism-cosmology {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1;
    background: #050507;
    border: 1px solid rgba(232, 229, 222, 0.15);
    overflow: hidden;
  }
  .kdx-organism-cosmology__viewport {
    position: relative;
    width: 80%;
    height: 80%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .kdx-organism-cosmology__svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 16px rgba(144, 60, 255, 0.5));
    animation: kdx-orbit-spin 24s linear infinite;
  }
  @keyframes kdx-orbit-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .kdx-organism-cosmology__svg { animation: none; }
  }
  .kdx-organism-cosmology__meta {
    position: absolute;
    bottom: 8px;
    left: 12px;
    right: 12px;
    display: flex;
    justify-content: space-between;
    font-family: "IBM Plex Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.15em;
    color: rgba(232, 229, 222, 0.6);
  }
  .kdx-organism-cosmology__status {
    color: #903CFF;
    font-weight: bold;
  }
</style>
