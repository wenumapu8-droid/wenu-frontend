---
import Base from '../../layouts/Base.astro';
import '../../styles/kodex.css';
import '../../styles/kodex-micrographics.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  theme?: 'dark-archive' | 'technical-plate';
  bodyClass?: string;
  noHeader?: boolean;
}

const { title, description, ogImage, theme = 'dark-archive', bodyClass = '', noHeader = true } = Astro.props;
---

<Base
  title={title}
  description={description}
  ogImage={ogImage || '/img/kodex/works/mandala-0cin-negativo.png'}
  kodexFonts={true}
  noNav={noHeader}
  noFooter={true}
  noOverlays={true}
  noQuote={true}
  noThemes={true}
  noKai={true}
  noCart={true}
  noImmersive={true}
>
  <div class={`kx kx--shell kx--theme-${theme} ${bodyClass}`} data-kdx-shell>
    <slot />
  </div>
</Base>

<style>
  .kx--shell {
    --kdx-bg: #020202;
    --kdx-fg: #E8E5DF;
    --kdx-accent: #A6FF00;
    
    background-color: var(--kdx-bg);
    color: var(--kdx-fg);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow-x: hidden;
  }
  
  .kx--theme-technical-plate {
    --kdx-bg: #E8E5DF;
    --kdx-fg: #020202;
    --kdx-accent: #FF2E22;
  }
</style>
