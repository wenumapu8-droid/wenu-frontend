---
/**
 * KODEX-∞ · RECUERDA · permanencia
 *
 * Registra que el visitante SE QUEDÓ, no que pasó.
 *
 * La primera versión de esto también grababa la vista del nodo, y estaba de
 * más: `src/scripts/kodex-engine.js` y `src/layouts/KodexShell.astro` ya
 * graban `{type:'view', work: location.pathname}` desde hace tiempo. Lo
 * descubrí midiendo — el recorrido salía duplicado, «threshold» y «/kodex/»
 * por la misma página— y quité mi parte. Queda anotado porque es la quinta vez
 * en este proyecto que construyo algo que ya existía, y el patrón es siempre
 * el mismo: escribir antes de auditar.
 *
 * Lo que sí faltaba, y nadie registraba: la PERMANENCIA. `memory.js` tiene un
 * evento `signal` que ninguna página emitía, y la Scene Bible lo pide por
 * nombre —«dwell threshold reached»—: pasar por una escena no es lo mismo que
 * quedarse en ella, y sólo lo segundo debería pesar en el espécimen.
 *
 * Uso:
 *   <KodexRecuerda />
 *   <KodexRecuerda umbralPermanencia={4000} />
 *
 * Los folios product-facing son la excepción documentada al default: viven en
 * `Base + KodexChrome`, no en `KodexShell`, así que deben registrar la vista
 * para que el recorrido no llegue vacío a RETURN. El default se deriva de la
 * ruta sólo para `/kodex/folio/*`; el guard DOM sigue evitando duplicados si
 * un folio migra al shell en el futuro.
 *
 * Lo que NO graba, y es deliberado: nada que identifique a la persona. El
 * contrato de privacidad de la Scene Bible es explícito — sin fingerprinting,
 * sin inferencia emocional, sin puntaje espiritual, sin inferencia de salud.
 * Acá sólo hay: por dónde pasaste y si te quedaste. Vive en tu navegador y no
 * sale de ahí.
 */
interface Props {
  /**
   * Milisegundos de permanencia antes de contar una señal. La Scene Bible
   * llama a esto «dwell threshold»: pasar no es lo mismo que quedarse, y sólo
   * lo segundo debería pesar en el espécimen.
   */
  umbralPermanencia?: number;
  /**
   * Graba también el paso por la página. Apagado por omisión salvo en los
   * folios product-facing, que no usan KodexShell. `KodexShell.astro` ya graba
   * la vista y el guard DOM de abajo impide doble escritura si ambos caminos
   * llegan a coexistir.
   *
   * También puede encenderse explícitamente donde el shell NO llega, como las
   * páginas de `vol/`.
   */
  registraVista?: boolean;
}
const defaultRegistraVista = Astro.url.pathname.startsWith('/kodex/folio/');
const { umbralPermanencia = 6000, registraVista = defaultRegistraVista } = Astro.props;
---

<span data-kdx-permanencia={umbralPermanencia} data-kdx-vista={registraVista ? "" : null} hidden></span>

<script>
  import { record } from "../../kodex/return/memory.js";

  const marca = document.querySelector("[data-kdx-permanencia]");
  if (marca) {
    /* Sólo donde el shell no graba. El guardia mira el DOM en vez de confiar
       en la prop: si alguna vez el shell aparece en una página que además pide
       `registraVista`, el recorrido no se duplica. */
    if (marca.hasAttribute("data-kdx-vista") && !document.querySelector(".kxm-nav")) {
      try { record({ type: "view", work: location.pathname }); } catch {}
    }

    /* La señal se cuenta una sola vez por carga, y sólo si la pestaña estuvo
       visible todo el tiempo. Sin esto, una pestaña abierta y olvidada en el
       fondo pesaría igual que una escena mirada de verdad. */
    const permanencia = Number(marca.getAttribute("data-kdx-permanencia")) || 6000;
    let visible = document.visibilityState === "visible";
    let contada = false;

    const reloj = setTimeout(() => {
      if (visible && !contada) {
        contada = true;
        record({ type: "signal" });
      }
    }, permanencia);

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState !== "visible") {
        visible = false;
        clearTimeout(reloj);
      }
    });
  }
</script>
