---
/**
 * KODEX−∞ · RECUERDA
 *
 * The RETURN specimen stores route/effect evidence only. Dwell is observable
 * as a semantic runtime event, but is not persisted or converted into a score.
 */
interface Props {
  umbralPermanencia?: number;
  registraVista?: boolean;
}
const { umbralPermanencia = 6000, registraVista = false } = Astro.props;
---

<span
  data-kdx-permanencia={umbralPermanencia}
  data-kdx-vista={registraVista ? "" : null}
  hidden
></span>

<script>
  import { record } from "../../kodex/return/memory.js";

  const marca = document.querySelector("[data-kdx-permanencia]");
  if (marca) {
    if (marca.hasAttribute("data-kdx-vista") && !document.querySelector(".kxm-nav")) {
      try { record({ type: "view", work: location.pathname }); } catch {}
    }

    const permanencia = Number(marca.getAttribute("data-kdx-permanencia")) || 6000;
    let contada = false;
    let visibleSince = document.visibilityState === "visible" ? performance.now() : null;
    let accumulated = 0;
    let timer = null;

    const emit = () => {
      if (contada) return;
      contada = true;
      window.dispatchEvent(new CustomEvent("kdx:scene-dwell", {
        detail: { path: location.pathname, dwellMs: permanencia },
      }));
    };

    const schedule = () => {
      if (contada || document.visibilityState !== "visible") return;
      const remaining = Math.max(0, permanencia - accumulated);
      visibleSince = performance.now();
      timer = window.setTimeout(emit, remaining);
    };

    const pause = () => {
      if (visibleSince != null) accumulated += performance.now() - visibleSince;
      visibleSince = null;
      if (timer != null) window.clearTimeout(timer);
      timer = null;
    };

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") schedule();
      else pause();
    });

    schedule();
  }
</script>
