---
const {
  scene = 'threshold',
  messages = [],
  label = 'hidden message band',
  class: className = '',
} = Astro.props;
---
<div class={`kdx-hidden-message ${className}`.trim()} data-kdx-hidden-message data-kdx-scene={scene} aria-label={label}>
  <span class="kdx-hidden-message__label">SIGNAL</span>
  <span class="kdx-hidden-message__text" data-kdx-message>{messages[0] || 'SIGNAL LATENT'}</span>
</div>
