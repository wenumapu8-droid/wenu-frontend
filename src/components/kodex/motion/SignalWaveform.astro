---
const {
  scene = 'threshold',
  class: className = '',
  width = 560,
  height = 92,
} = Astro.props;
---
<svg
  class={`kdx-signal-waveform ${className}`.trim()}
  data-kdx-waveform
  data-kdx-scene={scene}
  viewBox={`0 0 ${width} ${height}`}
  focusable="false"
  aria-hidden="true"
>
  <path class="kdx-signal-waveform__baseline" d={`M4 ${height / 2}H${width - 4}`}></path>
  <path class="kdx-signal-waveform__trace" data-kdx-waveform-trace d={`M4 ${height / 2}H${width - 4}`}></path>
</svg>
