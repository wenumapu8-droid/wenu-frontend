---
/**
 * KODEX-∞ · PLANO "craneo" · SPECIMEN SKULL
 *
 * Los paneles del expediente KX-7A19-SK01, en la grilla del póster.
 *
 * La conexión interna del archivo se dibuja como dato y no como nota: el
 * **Gate ID KX-7A19 es el mismo que el de THRESHOLD PORTAL** — el cráneo cruzó
 * ese umbral —, y el ∞ de la frente más el sello del árbol son los mismos que
 * recurren en THRESHOLD y en SIGNAL BLOOM. Por eso hay un panel de escenas
 * hermanas con el motivo del enlace escrito: sin el porqué, un enlace es sólo
 * un menú.
 */
import type { CapituloMotor } from '../../../lib/kodex/capitulos';
import {
  TRATAMIENTOS_SK, PROTOCOLOS_SK, ANATOMIA, LECTURAS_SK,
  NOTAS_SK, TAGS_SK, HERMANAS_SK, GATE_ID,
} from '../../../lib/kodex/capitulos';

interface Props { c: CapituloMotor }
const { c } = Astro.props;
---

<div class="kxs" data-kdx-capitulo-skull>
  {/* ── CABECERA ─────────────────────────────────────────────────────── */}
  <header class="kxs__cab">
    <div class="kxs__titulo">
      <h1>KODEX−∞ <span>/ {c.titulo}</span></h1>
      <p>{c.subtitulo_en} / {c.subtitulo_es}</p>
    </div>
    <p class="kxs__barra" aria-hidden="true"></p>
    <dl class="kxs__meta">
      <div><dt>DOC ID</dt><dd>{c.archiveId}</dd></div>
      <div><dt>GATE ID</dt><dd>{GATE_ID}</dd></div>
      <div><dt>DATE</dt><dd>{c.fecha}</dd></div>
      <div><dt>SYSTEM</dt><dd>{c.sysVer}</dd></div>
      <div><dt>STATUS</dt><dd data-kdx-sk-status>ACTIVE</dd></div>
    </dl>
    <p class="kxs__sello">{c.selloTexto}</p>
  </header>

  {/* ── 01 · SUBJECT CLASSIFICATION ──────────────────────────────────── */}
  <section class="kxs__p kxs__p--clas">
    <h2 class="kxs__rot">01. SUBJECT CLASSIFICATION</h2>
    <p class="kxs__sujeto">SUBJECT: <b>K-X-07</b></p>
    <dl class="kxs__pares">
      <div><dt>CLASS</dt><dd>{c.categoria}</dd></div>
      <div><dt>TYPE</dt><dd>{c.clase}</dd></div>
      <div><dt>ORIGIN</dt><dd>UNKNOWN</dd></div>
      <div><dt>ARCHIVE</dt><dd>{c.archivo}</dd></div>
    </dl>
    <p class="kxs__amenaza">{c.clearance}<em>THREAT LEVEL</em></p>
    <canvas class="kxs__arbol" data-kdx-sk-arbol width="90" height="90"></canvas>
    <p class="kxs__hazard">HAZARD · OMEGA-7</p>
  </section>

  {/* ── 02 · CRANIAL OVERVIEW · el hero ──────────────────────────────── */}
  <section class="kxs__p kxs__p--craneo">
    <h2 class="kxs__rot">
      02. CRANIAL OVERVIEW
      <b><i data-kdx-modo-rot>X-RAY</i> · <i data-kdx-proto-rot>SCAN</i></b>
    </h2>
    <div
      class="kxs__lienzo"
      data-kdx-skull
      data-rojo="#FF2A2A"
      data-cyan="#00C5FF"
      data-verde="#7FFF3C"
    >
      <canvas></canvas>
      {/* Si WebGL2 falta, el panel dice qué pasó en vez de quedarse negro. */}
      <p class="kxs__caido">CRANIAL SCAN · SIN WEBGL2</p>
    </div>
    <div class="kxs__lienzoPie">
      <span>VESSEL KX-7A19-SK01 · LIVE SCAN</span>
      <span>SIGNAL LOCK <b data-kdx-sk-lock>97.6%</b></span>
    </div>
  </section>

  {/* ── 03 · TREATMENT MODES ─────────────────────────────────────────── */}
  <section class="kxs__p kxs__p--modos">
    <h2 class="kxs__rot">03. TREATMENT MODES <b>/ LIVE VIEW</b></h2>
    <ul>
      {TRATAMIENTOS_SK.map((m) => (
        <li style={`--c:${m.color}`}>
          <button type="button" data-kdx-modo={m.n} aria-pressed={m.n === 'X-RAY' ? 'true' : 'false'}>
            <b>{m.n}</b>
            <span>{m.lee}</span>
          </button>
        </li>
      ))}
    </ul>
    <p class="kxs__nota">CINCO LECTURAS DEL MISMO CRÁNEO, NO CINCO DIBUJOS.</p>
  </section>

  {/* ── 04 · ANALYSIS / SIGNAL READOUTS ──────────────────────────────── */}
  <section class="kxs__p kxs__p--analisis">
    <h2 class="kxs__rot">04. ANALYSIS <b>/ SIGNAL READOUTS</b></h2>
    <p class="kxs__sub">BONE DENSITY MAP</p>
    <canvas data-kdx-sk-densidad width="280" height="40"></canvas>
    <p class="kxs__sub">SIGNAL SPECTRUM</p>
    <canvas data-kdx-sk-espectro width="280" height="40"></canvas>
    <dl class="kxs__pares">
      {LECTURAS_SK.map((l) => (
        <div>
          <dt>{l.k}</dt>
          <dd
            data-kdx-sk-lectura={l.vivo ? l.v : ''}
            data-amp={l.amp ?? 0}
            data-u={l.u}
            data-alto={l.v === 'HIGH' || l.v === 'C-4' ? 'si' : undefined}
          >{l.v}{l.u}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* ── ANATOMY OVERLAYS ─────────────────────────────────────────────── */}
  <section class="kxs__p kxs__p--anatomia">
    <h2 class="kxs__rot">ANATOMY OVERLAYS</h2>
    <ul>
      {ANATOMIA.map((a, i) => (
        <li>
          <canvas data-kdx-sk-nodo={i} width="70" height="80"></canvas>
          <b>{a.n}</b>
          <span data-kdx-sk-anat={a.v}>{a.v}%</span>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 05 · MOTION & SCAN PROTOCOLS ─────────────────────────────────── */}
  <section class="kxs__p kxs__p--proto">
    <h2 class="kxs__rot">05. MOTION & SCAN PROTOCOLS</h2>
    <ul>
      {PROTOCOLOS_SK.map((p) => (
        <li>
          <button type="button" data-kdx-proto={p.n} aria-pressed={p.n === 'SCAN' ? 'true' : 'false'}>
            <b>{p.n}</b>
            {p.lineas.map((l) => <em>{l}</em>)}
          </button>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 09 · NOTES / OBSERVATIONS ────────────────────────────────────── */}
  <section class="kxs__p kxs__p--notas">
    <h2 class="kxs__rot">09. NOTES / OBSERVATIONS</h2>
    <ul>
      {NOTAS_SK.map((n) => <li>&gt; {n}</li>)}
    </ul>
    <p class="kxs__aviso">DO NOT ENGAGE. OBSERVE ONLY.</p>
  </section>

  {/* ── 10 · ARCHIVE TAGS ────────────────────────────────────────────── */}
  <section class="kxs__p kxs__p--tags">
    <h2 class="kxs__rot">10. ARCHIVE TAGS</h2>
    <ul>
      {TAGS_SK.map((t) => <li># {t}</li>)}
    </ul>
  </section>

  {/* ── ESCENAS HERMANAS ─────────────────────────────────────────────── */}
  <section class="kxs__p kxs__p--hermanas">
    <h2 class="kxs__rot">CROSS-REFERENCE <b>/ ARCHIVO</b></h2>
    <ul>
      {HERMANAS_SK.map((h) => (
        <li>
          <a href={h.url}>
            <b>{h.titulo}</b>
            {/* El motivo del enlace, escrito. Sin el porqué esto es un menú. */}
            <span>{h.razon}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ── PIE ──────────────────────────────────────────────────────────── */}
  <footer class="kxs__pie">
    <b>KODEX−∞</b>
    <p class="kxs__barra" aria-hidden="true"></p>
    <span>VISUAL DEVELOPMENT BOARD</span>
    <span class="kxs__lemaPie">BUILT FOR ARCHIVES THAT REMEMBER.</span>
    <span>PATTERN. PROTECT. PERPETUATE.</span>
    <a href="/kodex/folio/iii/">ÍNDICE ›</a>
  </footer>
</div>

<script>
  import '../../../components/kodex/capitulo/skull-client.ts';
  import '../../../components/kodex/capitulo/skull-paneles.ts';
</script>

<style>
  .kxs {
    position: relative;
    /* Altura definida: es una lámina. Con `min-height` el contenido la estira
       y el pie se va del pliegue — ya pasó dos veces en este proyecto. */
    height: 100dvh;
    overflow: hidden;
    display: grid;
    gap: 1px;
    padding: clamp(7px, 0.9vw, 13px) clamp(7px, 0.9vw, 13px) 28px;
    box-sizing: border-box;
    grid-template-columns: minmax(175px, 15%) minmax(120px, 11%) minmax(0, 1fr) minmax(0, 0.92fr);
    grid-template-rows: auto minmax(0, 1.25fr) minmax(0, 0.85fr) minmax(0, 0.7fr) auto;
    grid-template-areas:
      "cab       cab        cab      cab"
      "clas      anatomia   craneo   modos"
      "clas      proto      craneo   analisis"
      "hermanas  notas      notas    tags"
      "pie       pie        pie      pie";
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    color: #e8e5df;
    background: #05050a;
    isolation: isolate;
  }

  :global(.kx--cap .kx-deckbar), :global(.kx--cap .kx-astro) { display: none; }

  .kxs__p {
    position: relative; z-index: 1;
    border: 1px solid color-mix(in srgb, var(--acc) 18%, transparent);
    background: rgba(5, 5, 10, 0.8);
    padding: 6px 8px 8px;
    display: grid; gap: 5px; align-content: start;
    min-height: 0; overflow: auto; scrollbar-width: none;
  }
  .kxs__p::-webkit-scrollbar { display: none; }

  .kxs__rot {
    margin: 0; font-size: 7.5px; font-weight: 500; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--acc);
    display: flex; justify-content: space-between; gap: 6px;
    border-bottom: 1px solid color-mix(in srgb, var(--acc) 16%, transparent);
    padding-bottom: 3px;
  }
  .kxs__rot b { font-weight: 400; color: rgba(232, 229, 222, 0.36); }
  .kxs__rot i { font-style: normal; color: var(--apoyo); }
  .kxs__sub {
    margin: 0; font-size: 6.5px; letter-spacing: 0.16em;
    text-transform: uppercase; color: rgba(232, 229, 222, 0.38);
  }
  .kxs__nota { margin: 0; font-size: 6px; letter-spacing: 0.12em; color: var(--apoyo); opacity: 0.65; }

  /* ── Cabecera ────────────────────────────────────────────────────────── */
  .kxs__cab {
    grid-area: cab; position: relative; z-index: 1;
    display: flex; align-items: center; gap: clamp(8px, 1.4vw, 22px);
    border: 1px solid color-mix(in srgb, var(--acc) 26%, transparent);
    background: rgba(5, 5, 10, 0.88); padding: 5px 10px; flex-wrap: wrap;
  }
  .kxs__titulo { flex: 1 1 240px; min-width: 0; }
  .kxs__titulo h1 {
    margin: 0; font-family: "Archivo Black", "Anton", ui-sans-serif, sans-serif;
    font-size: clamp(14px, 2vw, 26px); line-height: 1.04;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .kxs__titulo h1 span { color: var(--acc); }
  .kxs__titulo p {
    margin: 2px 0 0; font-size: 8px; letter-spacing: 0.22em;
    text-transform: uppercase; color: rgba(232, 229, 222, 0.45);
  }
  .kxs__meta { display: flex; gap: clamp(7px, 1.2vw, 18px); margin: 0; flex-wrap: wrap; }
  .kxs__meta dt { font-size: 6px; letter-spacing: 0.16em; color: rgba(232, 229, 222, 0.32); }
  .kxs__meta dd { margin: 0; font-size: 8.5px; color: var(--acc); font-variant-numeric: tabular-nums; }
  .kxs__sello {
    margin: 0; font-size: 6.5px; letter-spacing: 0.12em; padding: 3px 6px;
    border: 1px solid; max-width: 172px; line-height: 1.5;
    color: #FF8A5B; border-color: rgba(255, 138, 91, 0.5);
    background-image: repeating-linear-gradient(45deg, rgba(255,138,91,0.12) 0 4px, transparent 4px 8px);
  }
  .kxs__barra {
    margin: 0; height: 20px; flex: 0 0 clamp(60px, 7vw, 120px); opacity: 0.5; color: #e8e5df;
    background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 5px, currentColor 5px 6px, transparent 6px 10px);
  }

  /* ── 01 Clasificación ────────────────────────────────────────────────── */
  .kxs__p--clas { grid-area: clas; }
  .kxs__sujeto { margin: 0; font-size: 8px; letter-spacing: 0.14em; color: rgba(232,229,222,0.5); }
  .kxs__sujeto b {
    font-family: "Archivo Black", "Anton", sans-serif; font-size: 15px;
    color: #e8e5df; letter-spacing: 0.02em;
  }
  .kxs__pares { display: grid; gap: 0; margin: 0; }
  .kxs__pares div {
    display: flex; justify-content: space-between; gap: 8px; padding: 2px 0;
    border-bottom: 1px solid rgba(232, 229, 222, 0.06);
  }
  .kxs__pares dt { font-size: 6.8px; letter-spacing: 0.12em; color: rgba(232, 229, 222, 0.38); }
  .kxs__pares dd {
    margin: 0; font-size: 7.5px; color: #e8e5df; font-variant-numeric: tabular-nums;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .kxs__pares dd[data-alto] { color: var(--acc); }

  .kxs__amenaza {
    margin: 0; display: flex; align-items: baseline; gap: 6px;
    font-family: "Archivo Black", "Anton", sans-serif; font-size: 26px; color: var(--acc);
  }
  .kxs__amenaza em {
    font-family: inherit; font-style: normal; font-size: 5.5px;
    letter-spacing: 0.16em; color: rgba(232,229,222,0.4);
  }
  .kxs__arbol { width: 100%; height: auto; aspect-ratio: 1; max-width: 90px; justify-self: center; }
  .kxs__hazard {
    margin: 0; font-size: 7px; letter-spacing: 0.18em; color: var(--acc);
    border: 1px solid color-mix(in srgb, var(--acc) 40%, transparent);
    padding: 3px 6px; text-align: center;
  }

  /* ── 02 Cráneo · hero ────────────────────────────────────────────────── */
  .kxs__p--craneo {
    grid-area: craneo; overflow: hidden;
    grid-template-rows: auto minmax(0, 1fr) auto;
    /* Sin esto la fila `1fr` colapsa a la altura de su contenido — cero — y el
       hero dibuja en un lienzo vacío. Es el fallo recurrente del proyecto. */
    align-content: stretch;
  }
  .kxs__lienzo { position: relative; min-height: 0; background: #000; }
  .kxs__lienzo canvas { display: block; width: 100%; height: 100%; }
  .kxs__caido {
    position: absolute; inset: 0; margin: 0; display: none; place-items: center;
    font-size: 8px; letter-spacing: 0.2em; color: rgba(232, 229, 222, 0.5);
  }
  .kxs__lienzo[data-kdx-skull-error] canvas { display: none; }
  .kxs__lienzo[data-kdx-skull-error] .kxs__caido { display: grid; }
  .kxs__lienzoPie {
    display: flex; justify-content: space-between; gap: 10px;
    font-size: 6.5px; letter-spacing: 0.14em; color: rgba(232, 229, 222, 0.4);
  }
  .kxs__lienzoPie b { color: var(--acc); }

  /* ── 03 Modos ────────────────────────────────────────────────────────── */
  .kxs__p--modos { grid-area: modos; }
  .kxs__p--modos ul { display: grid; gap: 3px; margin: 0; padding: 0; list-style: none; }
  .kxs__p--modos button {
    width: 100%; display: grid; gap: 1px; padding: 5px 7px; cursor: pointer;
    background: transparent; color: inherit; text-align: left; font-family: inherit;
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
    transition: background 180ms ease, border-color 180ms ease;
  }
  .kxs__p--modos b {
    font-family: "Archivo Black", "Anton", sans-serif; font-size: 12px; color: var(--c);
  }
  .kxs__p--modos span { font-size: 6px; letter-spacing: 0.08em; color: rgba(232,229,222,0.42); }
  .kxs__p--modos button[aria-pressed="true"] {
    background: color-mix(in srgb, var(--c) 14%, transparent); border-color: var(--c);
  }
  .kxs__p--modos button:focus-visible { outline: 1px solid var(--c); outline-offset: -3px; }

  /* ── 04 Análisis ─────────────────────────────────────────────────────── */
  .kxs__p--analisis { grid-area: analisis; }
  .kxs__p--analisis canvas { width: 100%; height: auto; display: block; }

  /* ── Anatomía ────────────────────────────────────────────────────────── */
  .kxs__p--anatomia { grid-area: anatomia; }
  .kxs__p--anatomia ul {
    display: grid; grid-template-columns: 1fr 1fr; gap: 4px;
    margin: 0; padding: 0; list-style: none;
  }
  .kxs__p--anatomia li { display: grid; gap: 1px; justify-items: center; }
  .kxs__p--anatomia canvas {
    width: 100%; height: auto; aspect-ratio: 7 / 8;
    border: 1px solid rgba(232, 229, 222, 0.08);
  }
  .kxs__p--anatomia b { font-size: 6px; letter-spacing: 0.12em; color: rgba(232,229,222,0.55); }
  .kxs__p--anatomia span { font-size: 7px; color: var(--acc); font-variant-numeric: tabular-nums; }

  /* ── 05 Protocolos ───────────────────────────────────────────────────── */
  .kxs__p--proto { grid-area: proto; }
  .kxs__p--proto ul { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .kxs__p--proto button {
    width: 100%; display: grid; gap: 0; padding: 3px 5px; cursor: pointer;
    background: transparent; color: inherit; text-align: left; font-family: inherit;
    border: 1px solid rgba(232, 229, 222, 0.12);
  }
  .kxs__p--proto b { font-size: 8.5px; letter-spacing: 0.1em; color: var(--apoyo); }
  .kxs__p--proto em { font-style: normal; font-size: 5.6px; color: rgba(232,229,222,0.38); }
  .kxs__p--proto button[aria-pressed="true"] {
    background: color-mix(in srgb, var(--apoyo) 14%, transparent); border-color: var(--apoyo);
  }
  .kxs__p--proto button:focus-visible { outline: 1px solid var(--apoyo); outline-offset: -3px; }

  /* ── 09 Notas ────────────────────────────────────────────────────────── */
  .kxs__p--notas { grid-area: notas; }
  .kxs__p--notas ul { display: grid; gap: 3px; margin: 0; padding: 0; list-style: none; }
  .kxs__p--notas li { font-size: 7.5px; line-height: 1.5; color: rgba(232, 229, 222, 0.7); }
  .kxs__aviso {
    margin: 0; font-size: 9px; letter-spacing: 0.18em; color: var(--acc);
    font-family: "Archivo Black", "Anton", sans-serif;
  }

  /* ── 10 Tags ─────────────────────────────────────────────────────────── */
  .kxs__p--tags { grid-area: tags; }
  .kxs__p--tags ul {
    display: flex; flex-wrap: wrap; gap: 3px; margin: 0; padding: 0; list-style: none;
  }
  .kxs__p--tags li {
    font-size: 6.5px; letter-spacing: 0.1em; padding: 2px 6px;
    border: 1px solid rgba(232, 229, 222, 0.14); color: rgba(232, 229, 222, 0.6);
  }

  /* ── Hermanas ────────────────────────────────────────────────────────── */
  .kxs__p--hermanas { grid-area: hermanas; }
  .kxs__p--hermanas ul { display: grid; gap: 3px; margin: 0; padding: 0; list-style: none; }
  .kxs__p--hermanas a {
    display: grid; gap: 1px; padding: 4px 6px; text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--apoyo) 26%, transparent);
    transition: border-color 180ms ease, background 180ms ease;
  }
  .kxs__p--hermanas a:hover, .kxs__p--hermanas a:focus-visible {
    border-color: var(--apoyo);
    background: color-mix(in srgb, var(--apoyo) 12%, transparent);
    outline: none;
  }
  .kxs__p--hermanas b { font-size: 8px; letter-spacing: 0.12em; color: #e8e5df; }
  .kxs__p--hermanas span { font-size: 5.8px; letter-spacing: 0.1em; color: var(--apoyo); }

  /* ── Pie ─────────────────────────────────────────────────────────────── */
  .kxs__pie {
    grid-area: pie; position: relative; z-index: 1;
    display: flex; align-items: center; gap: clamp(8px, 1.6vw, 24px);
    border: 1px solid color-mix(in srgb, var(--acc) 18%, transparent);
    background: rgba(5, 5, 10, 0.88); padding: 3px 10px;
    font-size: 6.5px; letter-spacing: 0.16em; color: rgba(232, 229, 222, 0.4);
  }
  .kxs__pie b { font-family: "Archivo Black", "Anton", sans-serif; font-size: 11px; color: #e8e5df; letter-spacing: 0; }
  .kxs__pie .kxs__barra { height: 13px; flex: 0 0 clamp(50px, 6vw, 100px); }
  .kxs__lemaPie { margin: 0 auto; }
  .kxs__pie a { color: var(--acc); text-decoration: none; }
  .kxs__pie a:hover, .kxs__pie a:focus-visible { color: #e8e5df; outline: none; }

  /* ── Angosto ─────────────────────────────────────────────────────────── */
  @media (max-width: 1180px) {
    .kxs {
      min-height: 0; height: auto;
      grid-template-columns: 1fr; grid-template-rows: none;
      grid-template-areas:
        "cab" "craneo" "modos" "proto" "clas" "anatomia"
        "analisis" "notas" "tags" "hermanas" "pie";
    }
    .kxs__p { overflow: visible; }
    .kxs__p--craneo { min-height: 72vh; }
    .kxs__lemaPie { display: none; }
  }
</style>
