---
/**
 * KODEX-∞ · PLANO "arbol" · ARCHIVE TREE · el capítulo-madre
 *
 * Los paneles del plano XX-AT-0001-01, en su grilla.
 *
 * **Este capítulo es el hub y por eso su hero es navegable.** El sello del
 * árbol con el ∞ que aparece en THRESHOLD, en SIGNAL BLOOM y en la frente del
 * SPECIMEN SKULL es una instancia de ESTE árbol; todo apunta acá. Y *every leaf
 * is an archive* deja de ser una frase del póster para volverse navegación:
 * cada hoja marcada lleva a un volumen o a un capítulo, y las otras escenas
 * cuelgan de sus ramas.
 *
 * Único capítulo verde. El color marca al hub — si todos fueran verdes, no
 * distinguiría nada.
 */
import type { CapituloMotor } from '../../../lib/kodex/capitulos';
import {
  CRECIMIENTO, CONDUCTA, CAPAS_ARBOL, NODO_RAMA, VITALES_ARBOL,
  TIRAS_ARBOL, RAMAS_HUB, LEMA_GLIFOS,
} from '../../../lib/kodex/capitulos';
import { leerManifiesto, resolver } from '../../../lib/kodex/volumenes';

interface Props { c: CapituloMotor }
const { c } = Astro.props;

/**
 * Los destinos de las hojas.
 *
 * Salen del manifiesto REAL: el árbol no es un mapa decorativo de un archivo
 * imaginario, es el mapa del archivo que existe. Se toma una muestra
 * distribuida — una hoja por volumen sería ilegible con sesenta y uno.
 */
const vols = resolver(await leerManifiesto());
const paso = Math.max(1, Math.floor(vols.length / 14));
const hojas = vols.filter((_, i) => i % paso === 0).slice(0, 14)
  .map((v) => ({ titulo: v.titulo_es, url: `/kodex/vol/${v.slug}/`, tipo: 'volumen' }));
const destinos = [...RAMAS_HUB, ...hojas];
---

<div class="kxa" data-kdx-capitulo-arbol>
  {/* ── CABECERA ─────────────────────────────────────────────────────── */}
  <header class="kxa__cab">
    <div class="kxa__titulo">
      <h1>KODEX−∞ <span>/ {c.titulo}</span></h1>
      <p>{c.subtitulo_en} / {c.subtitulo_es}</p>
    </div>
    <p class="kxa__barra" aria-hidden="true"></p>
    <dl class="kxa__meta">
      <div><dt>SYS VER.</dt><dd>{c.sysVer}</dd></div>
      <div><dt>BUILD</dt><dd>{c.build}</dd></div>
      <div><dt>DATE</dt><dd>{c.fecha}</dd></div>
      <div><dt>SEED HASH</dt><dd>{c.seedHash}</dd></div>
    </dl>
    <p class="kxa__lema">PATTERN. PROTECT. PERPETUATE.<br /><b>DO NOT OBSERVE. PARTICIPATE.</b></p>
    <p class="kxa__sello">{c.selloTexto}</p>
  </header>

  {/* ── 01 · SPECIMEN DOSSIER ────────────────────────────────────────── */}
  <section class="kxa__p kxa__p--dossier">
    <h2 class="kxa__rot">01. SPECIMEN DOSSIER</h2>
    <canvas class="kxa__cabeza" data-kdx-cabeza width="150" height="150"></canvas>
    <p class="kxa__sujeto">SUBJECT: <b>{c.tanda.replace('-', ' ')}</b></p>
    <dl class="kxa__pares">
      <div><dt>ORIGIN</dt><dd>UNKNOWN</dd></div>
      <div><dt>CLASS</dt><dd>{c.clase}</dd></div>
      <div><dt>TYPE</dt><dd>{c.categoria}</dd></div>
      <div><dt>RANK</dt><dd>PRIME NODE</dd></div>
      <div><dt>STATUS</dt><dd data-kdx-arbol-status>ACTIVE</dd></div>
    </dl>
    <p class="kxa__amenaza">{c.clearance}<em>THREAT LVL</em></p>
    <p class="kxa__id">ID · {c.archiveId}</p>
    <p class="kxa__notas">
      NOTES: HOUSES PATTERNS, IMPRINTS AND SIGNALS ACROSS TIME. ROOTS TAP INTO
      THE UNSEEN. BRANCHES DISTRIBUTE MEMORY. <b>EVERY LEAF IS AN ARCHIVE.</b>
    </p>
  </section>

  {/* ── 02 · CORE DIAGRAM · el hero ──────────────────────────────────── */}
  <section class="kxa__p kxa__p--arbol">
    <h2 class="kxa__rot">
      02. ARCHIVE TREE // CORE DIAGRAM
      <b><i data-kdx-crecer-rot>SEED</i> · LIVE FEED</b>
    </h2>
    <div
      class="kxa__lienzo"
      data-kdx-arbol
      data-verde={c.acento}
      data-claro={c.apoyo}
      data-destinos={JSON.stringify(destinos)}
    >
      <canvas></canvas>
      <p class="kxa__rotulo" data-kdx-arbol-rotulo hidden></p>
    </div>
    <div class="kxa__lienzoPie">
      <span>SIGNAL STRENGTH</span>
      <span>STABILITY <b data-kdx-arbol-estab>87.6%</b></span>
      <span>FEED · <b>REALTIME</b></span>
    </div>
  </section>

  {/* ── 03 · GROWTH STATES ───────────────────────────────────────────── */}
  <section class="kxa__p kxa__p--crecer">
    <h2 class="kxa__rot">03. GROWTH STATES</h2>
    <ul>
      {CRECIMIENTO.map((g) => (
        <li>
          <button type="button" data-kdx-crecer={g.id} aria-pressed={g.id === 'SEED' ? 'true' : 'false'}>
            <span class="kxa__n">{g.n}</span>
            <b>{g.id}</b>
            <em>{g.verbo}</em>
            <canvas data-kdx-crecer-onda={g.id} width="120" height="26"></canvas>
            {g.lineas.map((l) => <i>{l}</i>)}
          </button>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 04 · SIGNAL & SPECTRUM ───────────────────────────────────────── */}
  <section class="kxa__p kxa__p--senal">
    <h2 class="kxa__rot">04. SIGNAL & SPECTRUM ANALYSIS</h2>
    <p class="kxa__sub">WAVEFORM</p>
    <canvas data-kdx-arbol-wave width="260" height="38"></canvas>
    <p class="kxa__sub">SPECTRUM</p>
    <canvas data-kdx-arbol-spec width="260" height="38"></canvas>
    <dl class="kxa__pares">
      <div><dt>SIGNAL QUALITY</dt><dd data-alto>HIGH</dd></div>
      <div><dt>INTERFERENCE</dt><dd>LOW</dd></div>
      {VITALES_ARBOL.map((v) => (
        <div><dt>{v.k}</dt><dd data-kdx-vital={v.v} data-amp={v.amp} data-u={v.u}>{v.v}{v.u}</dd></div>
      ))}
    </dl>
  </section>

  {/* ── 05 · BRANCH DETAIL // NODE CLUSTER ───────────────────────────── */}
  <section class="kxa__p kxa__p--nodo">
    <h2 class="kxa__rot">05. BRANCH DETAIL <b>/ NODE CLUSTER</b></h2>
    <canvas data-kdx-latiz width="230" height="130"></canvas>
    <dl class="kxa__pares">
      {NODO_RAMA.map(([k, v]) => (
        <div><dt>{k}</dt><dd data-alto={v === 'HIGH' || v === 'STABLE' ? 'si' : undefined}>{v}</dd></div>
      ))}
    </dl>
  </section>

  {/* ── 07 · MOTION NOTES & BEHAVIOR ─────────────────────────────────── */}
  <section class="kxa__p kxa__p--conducta">
    <h2 class="kxa__rot">07. MOTION NOTES & BEHAVIOR</h2>
    <ul>
      {CONDUCTA.map((m) => (
        <li>
          <b>{m.n}</b>
          {m.lineas.map((l) => <span>{l}</span>)}
          <em>{m.dur}</em>
          <i>{m.nota}</i>
        </li>
      ))}
    </ul>
    {/* Las duraciones del plano corren de verdad en el runtime del hero. */}
    <p class="kxa__nota">ESTAS DURACIONES CORREN EN EL PANEL 02.</p>
  </section>

  {/* ── 08 · CAPAS + RAMAS DEL HUB ───────────────────────────────────── */}
  <section class="kxa__p kxa__p--hub">
    <h2 class="kxa__rot">HUB <b>/ EVERY LEAF IS AN ARCHIVE</b></h2>
    <dl class="kxa__pares">
      {CAPAS_ARBOL.map((l) => (
        <div><dt>{l.n} · {l.zona}</dt><dd>{l.fn}</dd></div>
      ))}
    </dl>
    <ul class="kxa__ramas">
      {RAMAS_HUB.map((r) => (
        <li><a href={r.url}><b>{r.titulo}</b><span>{r.tipo}</span></a></li>
      ))}
    </ul>
    <p class="kxa__nota">LAS OTRAS ESCENAS CUELGAN DE ESTAS RAMAS.</p>
  </section>

  {/* ── 10 · ARCHIVE STRIPS ──────────────────────────────────────────── */}
  <section class="kxa__p kxa__p--tiras">
    <h2 class="kxa__rot">10. ARCHIVE STRIPS</h2>
    <ul>
      {TIRAS_ARBOL.map((t) => (
        <li>
          <div><b>{t.n}</b> <span>// {t.sub}</span></div>
          <p class="kxa__barra kxa__barra--tira" aria-hidden="true"></p>
          <code>{t.id}</code>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 11 · GLYPH LIBRARY ───────────────────────────────────────────── */}
  <section class="kxa__p kxa__p--glifos">
    <h2 class="kxa__rot">11. GLYPH LIBRARY</h2>
    <ul>
      {Array.from({ length: 20 }).map((_, i) => (
        <li><canvas data-kdx-arbol-glifo={i} width="46" height="46"></canvas></li>
      ))}
    </ul>
    <p class="kxa__nota">{LEMA_GLIFOS}</p>
  </section>

  {/* ── PIE ──────────────────────────────────────────────────────────── */}
  <footer class="kxa__pie">
    <b>KODEX−∞</b>
    <p class="kxa__barra" aria-hidden="true"></p>
    <span>VISUAL SYSTEM v2.0 // {c.tanda}</span>
    <span class="kxa__lemaPie">BUILT FOR ARCHIVES THAT REMEMBER.</span>
    <a href="/kodex/folio/iii/">ÍNDICE ›</a>
  </footer>
</div>

<script>
  import '../../../components/kodex/capitulo/arbol-client.ts';
  import '../../../components/kodex/capitulo/arbol-paneles.ts';
</script>

<style>
  .kxa {
    position: relative;
    /* Altura definida: es una lámina y tiene el tamaño que tiene. */
    height: 100dvh;
    overflow: hidden;
    display: grid;
    gap: 1px;
    padding: clamp(7px, 0.9vw, 13px) clamp(7px, 0.9vw, 13px) 28px;
    box-sizing: border-box;
    grid-template-columns: minmax(180px, 15.5%) minmax(0, 1.15fr) minmax(0, 0.82fr) minmax(150px, 13.5%);
    grid-template-rows: auto minmax(0, 1.1fr) minmax(0, 0.78fr) minmax(0, 0.72fr) auto;
    grid-template-areas:
      "cab       cab     cab       cab"
      "dossier   arbol   crecer    senal"
      "dossier   arbol   nodo      senal"
      "conducta  hub     tiras     glifos"
      "pie       pie     pie       pie";
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    color: #dfe8dc;
    background: #040704;
    isolation: isolate;
  }

  :global(.kx--cap .kx-deckbar), :global(.kx--cap .kx-astro) { display: none; }

  .kxa__p {
    position: relative; z-index: 1;
    border: 1px solid color-mix(in srgb, var(--acc) 18%, transparent);
    background: rgba(4, 7, 4, 0.82);
    padding: 6px 8px 8px;
    display: grid; gap: 5px; align-content: start;
    min-height: 0; overflow: auto; scrollbar-width: none;
  }
  .kxa__p::-webkit-scrollbar { display: none; }

  .kxa__rot {
    margin: 0; font-size: 7.5px; font-weight: 500; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--acc);
    display: flex; justify-content: space-between; gap: 6px;
    border-bottom: 1px solid color-mix(in srgb, var(--acc) 16%, transparent);
    padding-bottom: 3px;
  }
  .kxa__rot b { font-weight: 400; color: rgba(223, 232, 220, 0.38); }
  .kxa__rot i { font-style: normal; color: var(--apoyo); }
  .kxa__sub {
    margin: 0; font-size: 6.5px; letter-spacing: 0.16em;
    text-transform: uppercase; color: rgba(223, 232, 220, 0.38);
  }
  .kxa__nota { margin: 0; font-size: 6px; letter-spacing: 0.12em; color: var(--apoyo); opacity: 0.68; }

  /* ── Cabecera ────────────────────────────────────────────────────────── */
  .kxa__cab {
    grid-area: cab; position: relative; z-index: 1;
    display: flex; align-items: center; gap: clamp(8px, 1.4vw, 22px);
    border: 1px solid color-mix(in srgb, var(--acc) 26%, transparent);
    background: rgba(4, 7, 4, 0.9); padding: 5px 10px; flex-wrap: wrap;
  }
  .kxa__titulo { flex: 1 1 240px; min-width: 0; }
  .kxa__titulo h1 {
    margin: 0; font-family: "Archivo Black", "Anton", ui-sans-serif, sans-serif;
    font-size: clamp(14px, 2vw, 26px); line-height: 1.04;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .kxa__titulo h1 span { color: var(--acc); }
  .kxa__titulo p {
    margin: 2px 0 0; font-size: 8px; letter-spacing: 0.22em;
    text-transform: uppercase; color: rgba(223, 232, 220, 0.45);
  }
  .kxa__meta { display: flex; gap: clamp(7px, 1.2vw, 18px); margin: 0; flex-wrap: wrap; }
  .kxa__meta dt { font-size: 6px; letter-spacing: 0.16em; color: rgba(223, 232, 220, 0.32); }
  .kxa__meta dd { margin: 0; font-size: 8.5px; color: var(--acc); font-variant-numeric: tabular-nums; }
  .kxa__lema {
    margin: 0; font-size: 6px; letter-spacing: 0.14em; line-height: 1.7;
    color: rgba(223, 232, 220, 0.34);
  }
  /* El lema del hub va en acento: es la instrucción del capítulo-madre. */
  .kxa__lema b { color: var(--acc); font-weight: 500; letter-spacing: 0.18em; }
  .kxa__sello {
    margin: 0; font-size: 6.5px; letter-spacing: 0.12em; padding: 3px 6px;
    border: 1px solid; max-width: 168px; line-height: 1.5;
    color: #FF8A5B; border-color: rgba(255, 138, 91, 0.5);
    background-image: repeating-linear-gradient(45deg, rgba(255,138,91,0.12) 0 4px, transparent 4px 8px);
  }
  .kxa__barra {
    margin: 0; height: 20px; flex: 0 0 clamp(60px, 7vw, 120px); opacity: 0.45; color: #dfe8dc;
    background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 5px, currentColor 5px 6px, transparent 6px 10px);
  }
  .kxa__barra--tira { height: 12px; flex: none; width: 100%; opacity: 0.4; }

  /* ── 01 Dossier ──────────────────────────────────────────────────────── */
  .kxa__p--dossier { grid-area: dossier; }
  .kxa__cabeza { width: 100%; height: auto; aspect-ratio: 1; max-width: 150px; justify-self: center; }
  .kxa__sujeto { margin: 0; font-size: 7px; letter-spacing: 0.14em; color: rgba(223,232,220,0.5); }
  .kxa__sujeto b {
    font-family: "Archivo Black", "Anton", sans-serif; font-size: 13px;
    color: #dfe8dc; letter-spacing: 0.02em;
  }
  .kxa__pares { display: grid; gap: 0; margin: 0; }
  .kxa__pares div {
    display: flex; justify-content: space-between; gap: 8px; padding: 2px 0;
    border-bottom: 1px solid rgba(223, 232, 220, 0.06);
  }
  .kxa__pares dt { font-size: 6.6px; letter-spacing: 0.12em; color: rgba(223, 232, 220, 0.38); }
  .kxa__pares dd {
    margin: 0; font-size: 7.4px; color: #dfe8dc; font-variant-numeric: tabular-nums;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .kxa__pares dd[data-alto] { color: var(--acc); }
  .kxa__amenaza {
    margin: 0; display: flex; align-items: baseline; gap: 6px;
    font-family: "Archivo Black", "Anton", sans-serif; font-size: 22px; color: #FF2A2A;
  }
  .kxa__amenaza em {
    font-family: inherit; font-style: normal; font-size: 5.5px;
    letter-spacing: 0.16em; color: rgba(223,232,220,0.4);
  }
  .kxa__id { margin: 0; font-size: 6.4px; letter-spacing: 0.14em; color: rgba(223,232,220,0.34); }
  .kxa__notas { margin: 0; font-size: 6.2px; line-height: 1.6; color: rgba(223,232,220,0.44); }
  .kxa__notas b { color: var(--acc); }

  /* ── 02 Árbol · hero ─────────────────────────────────────────────────── */
  .kxa__p--arbol {
    grid-area: arbol; overflow: hidden;
    grid-template-rows: auto minmax(0, 1fr) auto;
    /* Sin esto la fila `1fr` colapsa a cero y el árbol dibuja en un lienzo
       vacío. Es el fallo recurrente del proyecto; queda declarado. */
    align-content: stretch;
  }
  .kxa__lienzo { position: relative; min-height: 0; }
  .kxa__lienzo canvas { display: block; width: 100%; height: 100%; }
  .kxa__rotulo {
    position: absolute; left: 8px; bottom: 8px; margin: 0;
    font-size: 8px; letter-spacing: 0.14em; text-transform: uppercase;
    color: #040704; background: var(--acc); padding: 3px 7px;
  }
  .kxa__lienzoPie {
    display: flex; justify-content: space-between; gap: 10px;
    font-size: 6.5px; letter-spacing: 0.14em; color: rgba(223, 232, 220, 0.4);
  }
  .kxa__lienzoPie b { color: var(--acc); }

  /* ── 03 Growth states ────────────────────────────────────────────────── */
  .kxa__p--crecer { grid-area: crecer; }
  .kxa__p--crecer ul {
    display: grid; grid-template-columns: 1fr 1fr; gap: 3px;
    margin: 0; padding: 0; list-style: none;
  }
  .kxa__p--crecer button {
    width: 100%; display: grid; gap: 1px; padding: 4px 6px; cursor: pointer;
    background: transparent; color: inherit; text-align: left; font-family: inherit;
    border: 1px solid color-mix(in srgb, var(--acc) 24%, transparent);
    transition: background 180ms ease, border-color 180ms ease;
  }
  .kxa__n { font-size: 5.6px; letter-spacing: 0.16em; color: rgba(223,232,220,0.32); }
  .kxa__p--crecer b {
    font-family: "Archivo Black", "Anton", sans-serif; font-size: 11px; color: var(--acc);
  }
  .kxa__p--crecer em { font-style: normal; font-size: 6px; letter-spacing: 0.14em; color: var(--apoyo); }
  .kxa__p--crecer canvas { width: 100%; height: auto; aspect-ratio: 120 / 26; }
  .kxa__p--crecer i { font-style: normal; font-size: 5.6px; color: rgba(223,232,220,0.38); }
  .kxa__p--crecer button[aria-pressed="true"] {
    background: color-mix(in srgb, var(--acc) 13%, transparent); border-color: var(--acc);
  }
  .kxa__p--crecer button:focus-visible { outline: 1px solid var(--acc); outline-offset: -3px; }

  /* ── 04 Señal ────────────────────────────────────────────────────────── */
  .kxa__p--senal { grid-area: senal; }
  .kxa__p--senal canvas { width: 100%; height: auto; display: block; }

  /* ── 05 Nodo ─────────────────────────────────────────────────────────── */
  .kxa__p--nodo { grid-area: nodo; }
  .kxa__p--nodo canvas {
    width: 100%; height: auto; aspect-ratio: 23 / 13;
    border: 1px solid rgba(223, 232, 220, 0.07);
  }

  /* ── 07 Conducta ─────────────────────────────────────────────────────── */
  .kxa__p--conducta { grid-area: conducta; }
  .kxa__p--conducta ul {
    display: grid; grid-template-columns: 1fr 1fr; gap: 5px;
    margin: 0; padding: 0; list-style: none;
  }
  .kxa__p--conducta li { display: grid; gap: 0; }
  .kxa__p--conducta b { font-size: 7.6px; letter-spacing: 0.14em; color: var(--acc); }
  .kxa__p--conducta span { font-size: 5.8px; color: rgba(223,232,220,0.4); }
  .kxa__p--conducta em {
    font-style: normal; font-size: 6.4px; letter-spacing: 0.1em; color: var(--apoyo); margin-top: 2px;
  }
  .kxa__p--conducta i { font-style: normal; font-size: 5.4px; letter-spacing: 0.12em; color: rgba(223,232,220,0.3); }

  /* ── Hub ─────────────────────────────────────────────────────────────── */
  .kxa__p--hub { grid-area: hub; }
  .kxa__ramas { display: flex; flex-wrap: wrap; gap: 3px; margin: 0; padding: 0; list-style: none; }
  .kxa__ramas a {
    display: grid; gap: 0; padding: 3px 7px; text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--acc) 26%, transparent);
    transition: border-color 180ms ease, background 180ms ease;
  }
  .kxa__ramas a:hover, .kxa__ramas a:focus-visible {
    border-color: var(--acc);
    background: color-mix(in srgb, var(--acc) 13%, transparent);
    outline: none;
  }
  .kxa__ramas b { font-size: 7.4px; letter-spacing: 0.1em; color: #dfe8dc; }
  .kxa__ramas span { font-size: 5.4px; letter-spacing: 0.12em; color: var(--apoyo); }

  /* ── 10 Tiras ────────────────────────────────────────────────────────── */
  .kxa__p--tiras { grid-area: tiras; }
  .kxa__p--tiras ul { display: grid; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .kxa__p--tiras li { display: grid; gap: 1px; }
  .kxa__p--tiras b { font-size: 6.4px; letter-spacing: 0.12em; color: var(--acc); }
  .kxa__p--tiras span { font-size: 5.6px; color: rgba(223,232,220,0.34); }
  .kxa__p--tiras code { font-family: inherit; font-size: 5.6px; color: rgba(223,232,220,0.5); }

  /* ── 11 Glifos ───────────────────────────────────────────────────────── */
  .kxa__p--glifos { grid-area: glifos; grid-template-rows: auto minmax(0, 1fr) auto; align-content: stretch; }
  .kxa__p--glifos ul {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 2px;
    margin: 0; padding: 0; list-style: none;
    /* Scrollea dentro de su pista: sin `min-height: 0` una grilla desborda su
       track en vez de encogerse y se dibuja encima de lo que sigue. */
    min-height: 0; overflow: auto; scrollbar-width: none;
  }
  .kxa__p--glifos ul::-webkit-scrollbar { display: none; }
  .kxa__p--glifos canvas { width: 100%; height: auto; aspect-ratio: 1; }

  /* ── Pie ─────────────────────────────────────────────────────────────── */
  .kxa__pie {
    grid-area: pie; position: relative; z-index: 1;
    display: flex; align-items: center; gap: clamp(8px, 1.6vw, 24px);
    border: 1px solid color-mix(in srgb, var(--acc) 18%, transparent);
    background: rgba(4, 7, 4, 0.9); padding: 3px 10px;
    font-size: 6.5px; letter-spacing: 0.16em; color: rgba(223, 232, 220, 0.4);
