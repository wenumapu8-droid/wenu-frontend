---
/**
 * KODEX-∞ · PLANO "ojo" · OBSERVATION EYE
 *
 * Los paneles del protocolo de escaneo KX∞-V2.0.
 *
 * Este capítulo es el nudo de la trama del archivo, y por eso su panel de
 * enlaces no es un menú: **el ojo mira al SPECIMEN SKULL** — su sujeto X-X-07
 * es el K-X-07 de aquél, misma clasificación C-4 —, es la ENTITY:WATCHER del
 * THRESHOLD, el visual-anchor de SIGNAL BLOOM, su arquetipo es THE WITNESS de
 * COSMOLOGY CORE y el ∞ de su pupila es el sello que ARCHIVE TREE lleva en el
 * tronco. Cada enlace va con su motivo escrito.
 *
 * Su tesis se dibuja porque es lo que la entidad afirma: *lo que observa
 * evoluciona*.
 */
import type { CapituloMotor } from '../../../lib/kodex/capitulos';
import {
  UNIFORMS_OJO, ESTADOS_OJO, CONDUCTA_OJO, TRATOS_OJO,
  OPTICA_OJO, ESPECTRO_OJO, LOGS_OJO, MIRA_OJO, TESIS_OJO,
} from '../../../lib/kodex/capitulos';

interface Props { c: CapituloMotor }
const { c } = Astro.props;

const LOGICA_OJO = [
  '// KODEX-∞ OBSERVATION EYE · KX∞-V2.0',
  'float r   = length(uv);',
  'float ang = atan(uv.y, uv.x);',
  '',
  'float iris = smoothstep(IRIS_INNER, IRIS_INNER + 0.05, r)',
  '           * (1.0 - smoothstep(irisR - 0.06, irisR, r));',
  'float scan = step(0.5, fract(gl_FragCoord.y * SCAN_DENSITY / res.y * 0.5));',
  'float glit = step(0.995, hash(vec2(band, floor(time * 14.0))));',
  'float puls = smoothstep(0.0, 1.0, 0.5 + 0.5 * sin(time * PULSE_SPEED));',
];
---

<div class="kxo" data-kdx-capitulo-ojo>
  {/* ── CABECERA ─────────────────────────────────────────────────────── */}
  <header class="kxo__cab">
    <div class="kxo__titulo">
      <h1>KODEX−∞ <span>/ {c.titulo}</span></h1>
      <p>{c.subtitulo_en} / {c.subtitulo_es}</p>
    </div>
    <p class="kxo__barra" aria-hidden="true"></p>
    <dl class="kxo__meta">
      <div><dt>SCENE</dt><dd>{c.tanda}</dd></div>
      <div><dt>BUILD</dt><dd>{c.sysVer}</dd></div>
      <div><dt>DATE</dt><dd>{c.fecha}</dd></div>
      <div><dt>REV</dt><dd>{c.build}</dd></div>
      <div><dt>ID</dt><dd>{c.archiveId}</dd></div>
    </dl>
    <p class="kxo__tesis">{TESIS_OJO}</p>
    <p class="kxo__sello">{c.selloTexto}</p>
  </header>

  {/* ── 01 · SCAN STATES ─────────────────────────────────────────────── */}
  <section class="kxo__p kxo__p--estados">
    <h2 class="kxo__rot">01. SCAN STATES</h2>
    <ul>
      {ESTADOS_OJO.map((e) => (
        <li style={`--c:${e.color}`}>
          <button type="button" data-kdx-ojo-estado={e.id} aria-pressed={e.id === 'LOCK' ? 'true' : 'false'}>
            <canvas data-kdx-ojo-mini={e.id} width="80" height="80"></canvas>
            <b>{e.id}</b>
            <em>{e.dato}</em>
            <span>{e.lee}</span>
          </button>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 02 · MOTION NOTES / EYE BEHAVIOR ─────────────────────────────── */}
  <section class="kxo__p kxo__p--conducta">
    <h2 class="kxo__rot">02. MOTION NOTES <b>/ EYE BEHAVIOR</b></h2>
    <ul>
      {CONDUCTA_OJO.map((m) => (
        <li>
          <b>{m.n}</b>
          <canvas data-kdx-ojo-onda={m.n} width="120" height="26"></canvas>
          {m.lineas.map((l) => <span>{l}</span>)}
        </li>
      ))}
    </ul>
  </section>

  {/* ── 04 · CORE INTERFACE · el hero ────────────────────────────────── */}
  <section class="kxo__p kxo__p--ojo">
    <h2 class="kxo__rot">04. OBSERVATION EYE <b>/ CORE INTERFACE · <i data-kdx-ojo-rot>LOCK</i></b></h2>
    <div class="kxo__cuerpo">
      <dl class="kxo__optica">
        {OPTICA_OJO.map((o) => (
          <div>
            <dt>{o.k}</dt>
            <dd data-kdx-optica={o.amp > 0 ? o.v : ''} data-amp={o.amp} data-u={o.u}>{o.v}{o.u}</dd>
          </div>
        ))}
        <div><dt>SUBJECT</dt><dd>UNKNOWN</dd></div>
        <div><dt>CLEARANCE</dt><dd data-rojo>{c.clearance}</dd></div>
      </dl>
      <div
        class="kxo__lienzo"
        data-kdx-ojo
        data-violeta="#A855F7"
        data-cyan="#22D3EE"
        data-rojo="#FF2A2A"
      >
        <canvas></canvas>
        <p class="kxo__caido">CORE INTERFACE · SIN WEBGL2</p>
      </div>
    </div>
    <div class="kxo__lienzoPie">
      <span>FEED · <b>LIVE</b></span>
      <span>OBSERVER · <b>{c.clase}</b></span>
    </div>
  </section>

  {/* ── 05 · EYE FRAGMENTS & TREATMENT CROPS ─────────────────────────── */}
  <section class="kxo__p kxo__p--tratos">
    <h2 class="kxo__rot">05. EYE FRAGMENTS <b>/ TREATMENT CROPS</b></h2>
    <ul>
      {TRATOS_OJO.map((n, i) => (
        <li>
          <canvas data-kdx-ojo-trato={i} width="90" height="70"></canvas>
          <span>{n}</span>
        </li>
      ))}
    </ul>
  </section>

  {/* ── 06 · WAVEFORMS / SPECTRAL ────────────────────────────────────── */}
  <section class="kxo__p kxo__p--senal">
    <h2 class="kxo__rot">06. SIGNAL WAVEFORMS <b>/ SPECTRAL</b></h2>
    <canvas data-kdx-ojo-wave width="240" height="34"></canvas>
    <canvas data-kdx-ojo-spec width="240" height="34"></canvas>
    <dl class="kxo__pares">
      {ESPECTRO_OJO.map(([k, v]) => (
        <div><dt>{k}</dt><dd data-alto={v === 'HIGH' ? 'si' : undefined}>{v}</dd></div>
      ))}
    </dl>
  </section>

  {/* ── 07 · OBSERVATION LOGS ────────────────────────────────────────── */}
  <section class="kxo__p kxo__p--logs">
    <h2 class="kxo__rot">07. OBSERVATION LOGS <b data-kdx-logs-n>STREAMING</b></h2>
    <ol data-kdx-logs>
      {LOGS_OJO.map((l) => (
        <li data-conf={l.conf}>
          <time>--:--:--</time>
          <b>{l.ev}</b>
          <span>{l.det}</span>
          <em>{l.conf}%</em>
        </li>
      ))}
    </ol>
  </section>

  {/* ── 08 · SHADER LOGIC ────────────────────────────────────────────── */}
  <section class="kxo__p kxo__p--logica">
    <h2 class="kxo__rot">08. SHADER LOGIC <b>/ PSEUDO-CODE</b></h2>
    <pre><code>{LOGICA_OJO.join('\n')}</code></pre>
    <dl class="kxo__pares">
      {UNIFORMS_OJO.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
    <p class="kxo__nota">ESTOS UNIFORMS CORREN EN EL PANEL 04.</p>
  </section>

  {/* ── LO QUE MIRA ──────────────────────────────────────────────────── */}
  <section class="kxo__p kxo__p--mira">
    <h2 class="kxo__rot">CROSS-REFERENCE <b>/ LO QUE MIRA</b></h2>
    <ul>
      {MIRA_OJO.map((m) => (
        <li>
          <a href={m.url}>
            <b>{m.titulo}</b>
            {/* El motivo del enlace: acá los porqués son la trama. */}
            <span>{m.razon}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ── PIE ──────────────────────────────────────────────────────────── */}
  <footer class="kxo__pie">
    <b>KODEX−∞</b>
    <p class="kxo__barra" aria-hidden="true"></p>
    <span>VISUAL SYSTEM v2.0</span>
    <span class="kxo__lemaPie">BUILT FOR ARCHIVES THAT REMEMBER.</span>
    <span>PATTERN. PROTECT. PERPETUATE.</span>
    <a href="/kodex/folio/iii/">ÍNDICE ›</a>
  </footer>
</div>

<script>
  import '../../../components/kodex/capitulo/ojo-client.ts';
  import '../../../components/kodex/capitulo/ojo-paneles.ts';
</script>

<style>
  .kxo {
    position: relative;
    height: 100dvh;
    overflow: hidden;
    display: grid;
    gap: 1px;
    padding: clamp(7px, 0.9vw, 13px) clamp(7px, 0.9vw, 13px) 28px;
    box-sizing: border-box;
    grid-template-columns: minmax(165px, 14%) minmax(0, 1.3fr) minmax(0, 0.8fr) minmax(150px, 13%);
    grid-template-rows: auto minmax(0, 1.15fr) minmax(0, 0.8fr) minmax(0, 0.75fr) auto;
    grid-template-areas:
      "cab       cab   cab      cab"
      "estados   ojo   tratos   senal"
      "conducta  ojo   logs     senal"
      "mira      ojo   logs     logica"
      "pie       pie   pie      pie";
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    color: #e6e0f0;
    background: #06040c;
    isolation: isolate;
  }

  :global(.kx--cap .kx-deckbar), :global(.kx--cap .kx-astro) { display: none; }

  .kxo__p {
    position: relative; z-index: 1;
    border: 1px solid color-mix(in srgb, var(--acc) 20%, transparent);
    background: rgba(6, 4, 12, 0.82);
    padding: 6px 8px 8px;
    display: grid; gap: 5px; align-content: start;
    min-height: 0; overflow: auto; scrollbar-width: none;
  }
  .kxo__p::-webkit-scrollbar { display: none; }

  .kxo__rot {
    margin: 0; font-size: 7.5px; font-weight: 500; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--acc);
    display: flex; justify-content: space-between; gap: 6px;
    border-bottom: 1px solid color-mix(in srgb, var(--acc) 16%, transparent);
    padding-bottom: 3px;
  }
  .kxo__rot b { font-weight: 400; color: rgba(230, 224, 240, 0.36); }
  .kxo__rot i { font-style: normal; color: var(--apoyo); }
  .kxo__nota { margin: 0; font-size: 6px; letter-spacing: 0.12em; color: var(--apoyo); opacity: 0.68; }

  /* ── Cabecera ────────────────────────────────────────────────────────── */
  .kxo__cab {
    grid-area: cab; position: relative; z-index: 1;
    display: flex; align-items: center; gap: clamp(8px, 1.4vw, 22px);
    border: 1px solid color-mix(in srgb, var(--acc) 26%, transparent);
    background: rgba(6, 4, 12, 0.9); padding: 5px 10px; flex-wrap: wrap;
  }
  .kxo__titulo { flex: 1 1 230px; min-width: 0; }
  .kxo__titulo h1 {
    margin: 0; font-family: "Archivo Black", "Anton", ui-sans-serif, sans-serif;
    font-size: clamp(14px, 2vw, 26px); line-height: 1.04;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .kxo__titulo h1 span { color: var(--acc); }
  .kxo__titulo p {
    margin: 2px 0 0; font-size: 8px; letter-spacing: 0.22em;
    text-transform: uppercase; color: rgba(230, 224, 240, 0.45);
  }
  .kxo__meta { display: flex; gap: clamp(7px, 1.2vw, 18px); margin: 0; flex-wrap: wrap; }
  .kxo__meta dt { font-size: 6px; letter-spacing: 0.16em; color: rgba(230, 224, 240, 0.32); }
  .kxo__meta dd { margin: 0; font-size: 8.5px; color: var(--acc); font-variant-numeric: tabular-nums; }
  /* La tesis del capítulo, en acento: es lo que la entidad afirma. */
  .kxo__tesis {
    margin: 0; font-size: 7.5px; letter-spacing: 0.2em; color: var(--apoyo);
    border-left: 1px solid color-mix(in srgb, var(--apoyo) 45%, transparent); padding-left: 8px;
  }
  .kxo__sello {
    margin: 0; font-size: 6.5px; letter-spacing: 0.12em; padding: 3px 6px;
    border: 1px solid; max-width: 165px; line-height: 1.5;
    color: #FF8A5B; border-color: rgba(255, 138, 91, 0.5);
    background-image: repeating-linear-gradient(45deg, rgba(255,138,91,0.12) 0 4px, transparent 4px 8px);
  }
  .kxo__barra {
    margin: 0; height: 20px; flex: 0 0 clamp(55px, 6vw, 110px); opacity: 0.45; color: #e6e0f0;
    background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 5px, currentColor 5px 6px, transparent 6px 10px);
  }

  /* ── 01 Estados ──────────────────────────────────────────────────────── */
  .kxo__p--estados { grid-area: estados; }
  .kxo__p--estados ul { display: grid; gap: 3px; margin: 0; padding: 0; list-style: none; }
  .kxo__p--estados button {
    width: 100%; display: grid; gap: 1px; padding: 4px 6px; cursor: pointer;
    background: transparent; color: inherit; text-align: left; font-family: inherit;
    grid-template-columns: 34px 1fr; align-items: center; column-gap: 6px;
    border: 1px solid color-mix(in srgb, var(--c) 32%, transparent);
    transition: background 180ms ease, border-color 180ms ease;
  }
  .kxo__p--estados canvas { grid-row: span 3; width: 100%; height: auto; aspect-ratio: 1; }
  .kxo__p--estados b {
    font-family: "Archivo Black", "Anton", sans-serif; font-size: 11px; color: var(--c);
  }
  .kxo__p--estados em { font-style: normal; font-size: 8px; color: #e6e0f0; font-variant-numeric: tabular-nums; }
  .kxo__p--estados span { font-size: 5.8px; letter-spacing: 0.1em; color: rgba(230,224,240,0.4); }
  .kxo__p--estados button[aria-pressed="true"] {
    background: color-mix(in srgb, var(--c) 15%, transparent); border-color: var(--c);
  }
  .kxo__p--estados button:focus-visible { outline: 1px solid var(--c); outline-offset: -3px; }

  /* ── 02 Conducta ─────────────────────────────────────────────────────── */
  .kxo__p--conducta { grid-area: conducta; }
  .kxo__p--conducta ul { display: grid; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .kxo__p--conducta b { font-size: 7.6px; letter-spacing: 0.14em; color: var(--acc); }
  .kxo__p--conducta canvas { width: 100%; height: auto; aspect-ratio: 120 / 26; }
  .kxo__p--conducta span { font-size: 5.8px; color: rgba(230,224,240,0.4); }

  /* ── 04 Ojo · hero ───────────────────────────────────────────────────── */
  .kxo__p--ojo {
    grid-area: ojo; overflow: hidden;
    grid-template-rows: auto minmax(0, 1fr) auto;
    /* Sin esto la fila `1fr` colapsa a cero y el hero dibuja en un lienzo
       vacío. Fallo recurrente del proyecto; queda declarado. */
    align-content: stretch;
  }
  .kxo__cuerpo { display: grid; grid-template-columns: minmax(92px, 15%) minmax(0, 1fr); gap: 8px; min-height: 0; }
  .kxo__optica { display: grid; gap: 0; margin: 0; align-content: start; }
  .kxo__optica div {
    display: grid; gap: 0; padding: 2px 0;
    border-bottom: 1px solid rgba(230, 224, 240, 0.06);
  }
  .kxo__optica dt { font-size: 6px; letter-spacing: 0.14em; color: rgba(230, 224, 240, 0.36); }
  .kxo__optica dd { margin: 0; font-size: 8px; color: var(--apoyo); font-variant-numeric: tabular-nums; }
  .kxo__optica dd[data-rojo] { color: #FF2A2A; }
  .kxo__lienzo { position: relative; min-height: 0; background: #000; }
  .kxo__lienzo canvas { display: block; width: 100%; height: 100%; }
  .kxo__caido {
    position: absolute; inset: 0; margin: 0; display: none; place-items: center;
    font-size: 8px; letter-spacing: 0.2em; color: rgba(230, 224, 240, 0.5);
  }
  .kxo__lienzo[data-kdx-ojo-error] canvas { display: none; }
  .kxo__lienzo[data-kdx-ojo-error] .kxo__caido { display: grid; }
  .kxo__lienzoPie {
    display: flex; justify-content: space-between; gap: 10px;
    font-size: 6.5px; letter-spacing: 0.14em; color: rgba(230, 224, 240, 0.4);
  }
  .kxo__lienzoPie b { color: var(--acc); }

  /* ── 05 Tratamientos ─────────────────────────────────────────────────── */
  .kxo__p--tratos { grid-area: tratos; }
  .kxo__p--tratos ul {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px;
    margin: 0; padding: 0; list-style: none;
  }
  .kxo__p--tratos li { display: grid; gap: 1px; }
  .kxo__p--tratos canvas {
    width: 100%; height: auto; aspect-ratio: 9 / 7;
    border: 1px solid rgba(230, 224, 240, 0.08);
  }
  .kxo__p--tratos span { font-size: 5.4px; letter-spacing: 0.1em; color: rgba(230,224,240,0.42); text-align: center; }

  /* ── 06 Señal ────────────────────────────────────────────────────────── */
  .kxo__p--senal { grid-area: senal; }
  .kxo__p--senal canvas { width: 100%; height: auto; display: block; }
  .kxo__pares { display: grid; gap: 0; margin: 0; }
  .kxo__pares div {
    display: flex; justify-content: space-between; gap: 8px; padding: 2px 0;
    border-bottom: 1px solid rgba(230, 224, 240, 0.06);
  }
  .kxo__pares dt { font-size: 6.6px; letter-spacing: 0.12em; color: rgba(230, 224, 240, 0.36); }
  .kxo__pares dd { margin: 0; font-size: 7.4px; color: #e6e0f0; font-variant-numeric: tabular-nums; }
  .kxo__pares dd[data-alto] { color: var(--acc); }

  /* ── 07 Logs ─────────────────────────────────────────────────────────── */
  .kxo__p--logs { grid-area: logs; }
  .kxo__p--logs ol { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .kxo__p--logs li {
    display: grid; grid-template-columns: auto 1fr auto; gap: 4px; align-items: baseline;
    padding: 2px 0; border-bottom: 1px solid rgba(230, 224, 240, 0.05);
  }
  .kxo__p--logs time { font-size: 6px; color: rgba(230,224,240,0.32); font-variant-numeric: tabular-nums; }
  .kxo__p--logs b { font-size: 6.6px; letter-spacing: 0.1em; color: var(--acc); }
  .kxo__p--logs span { grid-column: 2; font-size: 5.8px; color: rgba(230,224,240,0.38); }
  .kxo__p--logs em {
    grid-row: span 2; font-style: normal; font-size: 8px;
    color: var(--apoyo); font-variant-numeric: tabular-nums;
  }
  /* Confianza baja en rojo: una lectura dudosa tiene que verse dudosa. */
  .kxo__p--logs li[data-conf="65"] em, .kxo__p--logs li[data-conf="72"] em { color: #FF2A2A; }

  /* ── 08 Lógica ───────────────────────────────────────────────────────── */
  .kxo__p--logica { grid-area: logica; }
  .kxo__p--logica pre { margin: 0; }
  .kxo__p--logica code {
    font-family: inherit; font-size: 6.2px; line-height: 1.6; white-space: pre-wrap;
    color: rgba(230, 224, 240, 0.7);
  }

  /* ── Mira ────────────────────────────────────────────────────────────── */
  .kxo__p--mira { grid-area: mira; }
  .kxo__p--mira ul { display: grid; gap: 3px; margin: 0; padding: 0; list-style: none; }
  .kxo__p--mira a {
    display: grid; gap: 1px; padding: 3px 6px; text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--apoyo) 24%, transparent);
    transition: border-color 180ms ease, background 180ms ease;
  }
  .kxo__p--mira a:hover, .kxo__p--mira a:focus-visible {
    border-color: var(--apoyo);
    background: color-mix(in srgb, var(--apoyo) 12%, transparent);
    outline: none;
  }
  .kxo__p--mira b { font-size: 7.2px; letter-spacing: 0.1em; color: #e6e0f0; }
  .kxo__p--mira span { font-size: 5.2px; letter-spacing: 0.08em; color: var(--apoyo); }

  /* ── Pie ─────────────────────────────────────────────────────────────── */
  .kxo__pie {
    grid-area: pie; position: relative; z-index: 1;
    display: flex; align-items: center; gap: clamp(8px, 1.6vw, 24px);
    border: 1px solid color-mix(in srgb, var(--acc) 18%, transparent);
    background: rgba(6, 4, 12, 0.9); padding: 3px 10px;
    font-size: 6.5px; letter-spacing: 0.16em; color: rgba(230, 224, 240, 0.4);
  }
  .kxo__pie b { font-family: "Archivo Black", "Anton", sans-serif; font-size: 11px; color: #e6e0f0; letter-spacing: 0; }
  .kxo__pie .kxo__barra { height: 13px; flex: 0 0 clamp(50px, 6vw, 100px); }
  .kxo__lemaPie { margin: 0 auto; }
  .kxo__pie a { color: var(--acc); text-decoration: none; }
  .kxo__pie a:hover, .kxo__pie a:focus-visible { color: #e6e0f0; outline: none; }

  /* ── Angosto ─────────────────────────────────────────────────────────── */
  @media (max-width: 1180px) {
    .kxo {
      min-height: 0; height: auto;
      grid-template-columns: 1fr; grid-template-rows: none;
      grid-template-areas:
        "cab" "ojo" "estados" "conducta" "tratos" "senal"
        "logs" "logica" "mira" "pie";
    }
    .kxo__p { overflow: visible; }
    .kxo__p--ojo { min-height: 70vh; }
    .kxo__cuerpo { grid-template-columns: 1fr; }
    .kxo__lemaPie { display: none; }
  }
</style>
