---
/**
 * KODEX-∞ · EL EJE
 *
 *     −∞ ──── excavación ────▶ 0 ──── transmutación ────▶ +∞
 *      ▲                                                    │
 *      └──────────────────  retorno  ◀─────────────────────┘
 *
 * Es la fórmula maestra hecha visible. Y no es un adorno conceptual: es el
 * hilo que explica por qué existe cada pieza de este sitio.
 *
 * **−∞ no es el abismo. Es el archivo.** Profundidad sin límite conocido:
 * memoria, patrón, cuerpo, sombra, datos. La nota que lo fija lo aclara con
 * todas las letras — *no es maldad, es profundidad*. Y la tesis no es
 * desaparecer ahí, es **descender, encontrar patrón, y traer forma desde esa
 * profundidad**.
 *
 * El recorrido es una espiral, no una recta: el retorno no deja al sistema
 * donde empezó, lo deja un poco más abajo y con algo en la mano. Por eso
 * K₀ → K₁ → K₂ y por eso el archivo se expande — cada acceso, una nueva capa.
 *
 * Las cuatro fases que el visitante rota con el control del rail son
 * literalmente los cuatro operadores: ℰ excavación, 𝒯 transmutación,
 * ℳ manifestación, ℛ retorno. Cuando alguien las pasa, está ejecutando la
 * fórmula. El sitio no habla del sistema: es el sistema corriendo una vuelta.
 */
interface Props {
  /** En qué punto del eje está esta lámina. 0 = −∞, 0.5 = 0, 1 = +∞ */
  posicion?: number;
  accent?: string;
  class?: string;
}

const { posicion = 0, accent = "var(--kdx-red, #FF3833)", class: className = "" } = Astro.props;

const marcas = [
  { en: 0,    signo: "−∞", nombre: "ARCHIVO",       nota: "profundidad sin límite conocido" },
  { en: 0.5,  signo: "0",  nombre: "TRANSFORMACIÓN", nota: "el punto donde nada está fijado" },
  { en: 1,    signo: "+∞", nombre: "EXPANSIÓN",      nota: "una forma, muchas manifestaciones" },
];
---

<aside
  class:list={["kdx-eje", className]}
  style={`--kdx-eje-accent:${accent};--kdx-eje-pos:${posicion}`}
  aria-label="eje del sistema: menos infinito, cero, más infinito"
>
  <div class="kdx-eje__linea" aria-hidden="true">
    <span class="kdx-eje__aqui"></span>
  </div>
  <ol class="kdx-eje__marcas">
    {marcas.map((m) => (
      <li style={`--en:${m.en}`} data-activa={Math.abs(posicion - m.en) < 0.26 ? "" : undefined}>
        <b>{m.signo}</b>
        <span>{m.nombre}</span>
        <small>{m.nota}</small>
      </li>
    ))}
  </ol>
  <p class="kdx-eje__fase">
    <span data-kdx-archive-name>EXCAVATION · E00</span>
  </p>
</aside>

<style>
  .kdx-eje {
    display: grid;
    gap: 8px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(232, 229, 222, 0.5);
  }

  .kdx-eje__linea {
    position: relative;
    height: 1px;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--kdx-eje-accent) 55%, transparent),
      rgba(232, 229, 222, 0.22) 50%,
      color-mix(in srgb, var(--kdx-eje-accent) 55%, transparent)
    );
  }

  /* Dónde está parada esta lámina. Es la única marca que se mueve entre
     escenas: el resto del eje es el mismo siempre, porque el sistema es el
     mismo siempre. */
  .kdx-eje__aqui {
    position: absolute;
    top: 50%;
    left: calc(var(--kdx-eje-pos) * 100%);
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    background: var(--kdx-eje-accent);
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--kdx-eje-accent) 60%, transparent);
    transform: rotate(45deg);
  }

  .kdx-eje__marcas {
    position: relative;
    /* Alto MÍNIMO, no fijo.
       Decía `height:34px` y cada marca apila tres líneas -- signo, nombre y
       nota -- que suman unos 46. La tercera se derramaba fuera de la caja y
       aterrizaba sobre el rótulo de fase de abajo. Abajo de 860px no se veía
       porque la nota está oculta ahí; arriba de 860px sí, y el detector de
       superposiciones lo midió en 49% de área compartida entre "profundidad
       sin límite conocido" y "EXCAVATION · E00". */
    /* 30px alcanzan cuando la nota está oculta -- signo y nombre, dos líneas.
       Subirlo a 46 en todos lados hacía lo contrario de lo buscado: medido,
       RETURN en 390px pasó de 19 superposiciones a 22, porque la caja crecía
       16px sin contenido que la justificara y empujaba lo de abajo. El alto
       acompaña a lo que hay dentro, y lo que hay dentro cambia con el corte. */
    min-height: 30px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .kdx-eje__marcas li {
    position: absolute;
    top: 0;
    left: calc(var(--en) * 100%);
    display: grid;
    gap: 1px;
    /* Los extremos se alinean hacia adentro para no cortarse contra el borde. */
    transform: translateX(calc(var(--en) * -100%));
    /* Las marcas viven en 0%, 50% y 100% de un eje que no siempre es ancho.
       Con `white-space:nowrap` la nota más larga -- "una forma, muchas
       manifestaciones" -- estiraba su marca hasta cruzarse ENTERA con la
       vecina: 100% de superposición entre "−∞" y "+∞" medido en RETURN a
       1440px. Un tercio del eje por marca, y la nota envuelve. */
    max-width: 32%;
    white-space: normal;
  }
  .kdx-eje__marcas li:nth-child(2) { text-align: center; }
  .kdx-eje__marcas li:last-child { text-align: right; }
  .kdx-eje__marcas b { font-size: 12px; color: rgba(232, 229, 222, 0.78); font-weight: 500; }
  .kdx-eje__marcas small { font-size: 8px; letter-spacing: 0.1em; text-transform: none; opacity: 0.5; line-height: 1.25; }
  .kdx-eje__marcas li[data-activa] b { color: var(--kdx-eje-accent); }
  .kdx-eje__marcas li[data-activa] span { color: rgba(232, 229, 222, 0.9); }

  .kdx-eje__fase { margin: 0; color: var(--kdx-eje-accent); }

  @media (min-width: 861px) {
    /* Acá SÍ aparece la tercera línea, y acá es donde hace falta el alto. */
    .kdx-eje__marcas { min-height: 46px; }
  }

  @media (max-width: 860px) {
    .kdx-eje__marcas small { display: none; }
    /* Sin nota, la marca no necesita un tercio del eje y angostarla de más
       obliga a envolver el nombre en dos líneas. */
    .kdx-eje__marcas li { max-width: 46%; }
  }
</style>
