---
import KodexField from '../field/KodexField.astro';
import { specimens } from '../../../lib/kodexBook.js';

const strata = specimens.slice(0, 11);
const first = strata[0];
---

<section class="kdx-descent" data-kdx-native-descent data-stratum-index="0" aria-labelledby="kdx-descent-title">
  <KodexField
    field="network-vortex"
    intensity={0.62}
    feedback={0.48}
    speed={1.08}
    seed={2}
    tint="#FF6A00"
    spark="#8FD4FF"
    floor={0.05}
    detail={0.92}
    class="kdx-descent__organism"
  />

  <div class="kdx-descent__depth" aria-hidden="true">
    <span class="kdx-descent__ring kdx-descent__ring--a"></span>
    <span class="kdx-descent__ring kdx-descent__ring--b"></span>
    <span class="kdx-descent__axis"></span>
  </div>

  <header class="kdx-descent__identity">
    <a href="/kodex/folio/i/" class="kdx-descent__back">← PROLOGUE</a>
    <p>DESCENT · STRATA ENGINE</p>
    <h1 id="kdx-descent-title">THE TREE DESCENDS TO HOLD WHAT RISES.</h1>
  </header>

  <div class="kdx-descent__record" aria-live="polite" aria-atomic="true">
    <p class="kdx-descent__count" data-kdx-stratum-count>STRATUM · 01 / {String(strata.length).padStart(2, '0')}</p>
    <h2 data-kdx-stratum-title>{first?.name}</h2>
    <p data-kdx-stratum-read>{first?.read}</p>
    <div class="kdx-descent__tags" data-kdx-stratum-tags>
      {(first?.tags ?? []).slice(0, 3).map((tag) => <span>{tag}</span>)}
    </div>
  </div>

  <nav class="kdx-descent__strata" aria-label="Depth strata">
    {strata.map((stratum, index) => (
      <button
        type="button"
        data-kdx-stratum-button
        data-index={index}
        data-name={stratum.name}
        data-read={stratum.read}
        data-tags={(stratum.tags ?? []).slice(0, 3).join('|')}
        aria-current={index === 0 ? 'step' : undefined}
        aria-label={`Open stratum ${String(index + 1).padStart(2, '0')}: ${stratum.name}`}
      >
        <span>{String(index + 1).padStart(2, '0')}</span>
      </button>
    ))}
  </nav>

  <div class="kdx-descent__actions">
    <button type="button" class="kdx-descent__advance" data-kdx-stratum-next>DESCEND</button>
    <a href="/kodex/folio/iii/" class="kdx-descent__cross" data-kdx-descent-cross hidden>CROSS INTO ARCHIVE →</a>
  </div>

  <p class="kdx-descent__hint">WHEEL / SWIPE / ↓ · CHOOSE THE NEXT STRATUM</p>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-kdx-native-descent]');
  if (root && root.dataset.kdxBound !== '1') {
    root.dataset.kdxBound = '1';
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-kdx-stratum-button]'));
    const count = root.querySelector<HTMLElement>('[data-kdx-stratum-count]');
    const title = root.querySelector<HTMLElement>('[data-kdx-stratum-title]');
    const read = root.querySelector<HTMLElement>('[data-kdx-stratum-read]');
    const tags = root.querySelector<HTMLElement>('[data-kdx-stratum-tags]');
    const next = root.querySelector<HTMLButtonElement>('[data-kdx-stratum-next]');
    const cross = root.querySelector<HTMLAnchorElement>('[data-kdx-descent-cross]');
    let index = 0;
    let wheelLocked = false;
    let touchY = 0;

    const render = (nextIndex: number) => {
      index = Math.max(0, Math.min(buttons.length - 1, nextIndex));
      root.dataset.stratumIndex = String(index);
      const total = Math.max(1, buttons.length - 1);
      const progress = index / total;
      root.style.setProperty('--kdx-depth-progress', progress.toFixed(3));
      root.style.setProperty('--kdx-depth-scale', (1 + progress * 0.22).toFixed(3));
      root.style.setProperty('--kdx-depth-compress', (1 - progress * 0.16).toFixed(3));
      root.style.setProperty('--kdx-depth-glow', (0.12 + progress * 0.46).toFixed(3));
      const button = buttons[index];
      buttons.forEach((item, i) => {
        if (i === index) item.setAttribute('aria-current', 'step');
        else item.removeAttribute('aria-current');
      });
      if (count) count.textContent = `STRATUM · ${String(index + 1).padStart(2, '0')} / ${String(buttons.length).padStart(2, '0')}`;
      if (title) title.textContent = button?.dataset.name ?? '';
      if (read) read.textContent = button?.dataset.read ?? '';
      if (tags) {
        tags.replaceChildren();
        (button?.dataset.tags ?? '').split('|').filter(Boolean).forEach((value) => {
          const span = document.createElement('span');
          span.textContent = value;
          tags.appendChild(span);
        });
      }
      const isLast = index === buttons.length - 1;
      if (next) {
        next.hidden = isLast;
        next.textContent = index === 0 ? 'DESCEND' : 'DESCEND DEEPER';
      }
      if (cross) cross.hidden = !isLast;
      root.dispatchEvent(new CustomEvent('kdx:stratum', { bubbles: true, detail: { index, total: buttons.length, progress } }));
    };

    buttons.forEach((button, i) => button.addEventListener('click', () => render(i)));
    next?.addEventListener('click', () => render(index + 1));

    root.addEventListener('wheel', (event) => {
      event.preventDefault();
      if (wheelLocked || Math.abs(event.deltaY) < 8) return;
      wheelLocked = true;
      render(index + (event.deltaY > 0 ? 1 : -1));
      window.setTimeout(() => { wheelLocked = false; }, 320);
    }, { passive: false });

    root.addEventListener('touchstart', (event) => {
      touchY = event.touches[0]?.clientY ?? 0;
    }, { passive: true });
    root.addEventListener('touchend', (event) => {
      const endY = event.changedTouches[0]?.clientY ?? touchY;
      const delta = touchY - endY;
      if (Math.abs(delta) > 42) render(index + (delta > 0 ? 1 : -1));
    }, { passive: true });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'PageDown') {
        event.preventDefault(); render(index + 1);
      }
      if (event.key === 'ArrowUp' || event.key === 'PageUp') {
        event.preventDefault(); render(index - 1);
      }
    });

    render(0);
  }
</script>

<style>
  .kdx-descent {
    --orange: #ff6a00;
    --ice: #8fd4ff;
    --kdx-depth-progress: 0;
    --kdx-depth-scale: 1;
    --kdx-depth-compress: 1;
    --kdx-depth-glow: .12;
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 100dvh;
    min-height: 100dvh;
    overflow: hidden;
    background: #020202;
    color: #f4f1e9;
    touch-action: pan-x;
  }
  .kdx-descent__organism {
    z-index: 0;
    transform: scale(var(--kdx-depth-scale));
    filter: saturate(calc(.88 + var(--kdx-depth-progress) * .48)) contrast(calc(1 + var(--kdx-depth-progress) * .2));
    transition: transform 520ms cubic-bezier(.16,.78,.18,1), filter 420ms ease;
    transform-origin: 50% 52%;
  }
  .kdx-descent__depth {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 52%, rgba(139,92,246,calc(.16 + var(--kdx-depth-progress) * .22)) 0 2%, transparent calc(10% * var(--kdx-depth-compress))),
      radial-gradient(circle at 50% 52%, transparent 0 calc(18% * var(--kdx-depth-compress)), rgba(255,106,0,calc(.08 + var(--kdx-depth-progress) * .12)) 24%, transparent 48%);
  }
  .kdx-descent__ring {
    position: absolute;
    left: 50%; top: 52%;
    width: min(68vw, 920px); aspect-ratio: 1;
    border: 1px solid rgba(255,106,0,calc(.18 + var(--kdx-depth-progress) * .22));
    border-radius: 50%;
    transform: translate(-50%,-50%) scale(var(--kdx-depth-compress));
    box-shadow: 0 0 60px rgba(255,106,0,var(--kdx-depth-glow)), inset 0 0 50px rgba(143,212,255,.035);
    transition: transform 520ms cubic-bezier(.16,.78,.18,1), border-color 420ms ease, box-shadow 420ms ease;
  }
  .kdx-descent__ring--b { width: min(42vw, 560px); border-color: rgba(143,212,255,calc(.16 + var(--kdx-depth-progress) * .2)); }
  .kdx-descent__axis {
    position: absolute;
    left: 50%; top: 8%; bottom: 8%; width: 1px;
    background: linear-gradient(transparent, rgba(255,106,0,.28), rgba(139,92,246,calc(.44 + var(--kdx-depth-progress) * .3)), rgba(255,106,0,.28), transparent);
    transform: scaleY(calc(.82 + var(--kdx-depth-progress) * .18));
    transform-origin: 50% 52%;
  }
  .kdx-descent__identity,
  .kdx-descent__record,
  .kdx-descent__strata,
  .kdx-descent__actions,
  .kdx-descent__hint { position: absolute; z-index: 3; }
  .kdx-descent__identity { left: clamp(22px,3.2vw,58px); top: clamp(24px,4vh,56px); max-width: 520px; }
  .kdx-descent__back,
  .kdx-descent__identity p,
  .kdx-descent__count,
  .kdx-descent__hint {
    color: rgba(244,241,233,.56);
    font: 500 10px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .18em;
    text-decoration: none;
  }
  .kdx-descent__identity h1 {
    margin: 18px 0 0;
    max-width: 13ch;
    font: 600 clamp(30px,4.6vw,72px)/.9 var(--kdx-font-display, sans-serif);
    letter-spacing: calc(-.045em - var(--kdx-depth-progress) * .012em);
    text-transform: uppercase;
    transform: translateY(calc(var(--kdx-depth-progress) * 8px)) scaleY(calc(1 - var(--kdx-depth-progress) * .08));
    transform-origin: left top;
    opacity: calc(1 - var(--kdx-depth-progress) * .18);
    transition: transform 420ms ease, opacity 420ms ease, letter-spacing 420ms ease;
  }
  .kdx-descent__record {
    right: clamp(24px,4vw,72px);
    bottom: clamp(90px,12vh,150px);
    width: min(330px,28vw);
    padding-left: 18px;
    border-left: 1px solid rgba(255,106,0,.34);
  }
  .kdx-descent__record h2 { margin: 10px 0 8px; font-size: clamp(17px,1.6vw,25px); font-weight: 500; }
  .kdx-descent__record > p:not(.kdx-descent__count) { margin: 0; color: rgba(244,241,233,.67); font-size: 12px; line-height: 1.55; }
  .kdx-descent__tags { display:flex; flex-wrap:wrap; gap:6px; margin-top:12px; }
  .kdx-descent__tags span { font: 500 9px/1 ui-monospace,monospace; letter-spacing:.12em; color:rgba(143,212,255,.64); }
  .kdx-descent__strata {
    left: clamp(20px,3vw,52px); bottom: clamp(84px,10vh,120px);
    display: flex; gap: 7px; align-items: end;
  }
  .kdx-descent__strata button {
    width: 28px; height: 44px; padding: 0;
    border: 0; border-bottom: 1px solid rgba(244,241,233,.2);
    background: transparent; color: rgba(244,241,233,.36);
    font: 500 8px/1 ui-monospace,monospace;
    cursor: pointer;
  }
  .kdx-descent__strata button[aria-current="step"] { color: #fff; border-color: var(--orange); box-shadow: 0 8px 18px -12px var(--orange); }
  .kdx-descent__actions { right: clamp(24px,4vw,72px); bottom: clamp(28px,4vh,50px); }
  .kdx-descent__advance,
  .kdx-descent__cross {
    min-height: 44px; padding: 0 16px;
    border: 1px solid rgba(255,106,0,.46);
    background: rgba(2,2,2,.56); color:#fff;
    font: 600 10px/42px ui-monospace,monospace;
    letter-spacing:.12em; text-decoration:none; cursor:pointer;
  }
  .kdx-descent__hint { left: 50%; bottom: 28px; transform:translateX(-50%); white-space:nowrap; }

  @media (max-width: 720px) {
    .kdx-descent__identity { inset: 22px 20px auto; max-width: none; }
    .kdx-descent__identity h1 { margin-top: 10px; max-width: 15ch; font-size: clamp(30px,10vw,44px); }
    .kdx-descent__depth { background: radial-gradient(circle at 50% 47%, rgba(139,92,246,calc(.18 + var(--kdx-depth-progress) * .22)), transparent 12%), radial-gradient(circle at 50% 47%, transparent 0 22%, rgba(255,106,0,calc(.09 + var(--kdx-depth-progress) * .12)) 28%, transparent 58%); }
    .kdx-descent__ring { top: 47%; width: 112vw; }
    .kdx-descent__ring--b { width: 72vw; }
    .kdx-descent__axis { top: 14%; bottom: 19%; }
    .kdx-descent__record { left: 22px; right: 22px; bottom: 128px; width:auto; max-width: 360px; padding: 13px 0 0; border-left:0; border-top:1px solid rgba(255,106,0,.28); }
    .kdx-descent__record h2 { font-size: 18px; }
    .kdx-descent__record > p:not(.kdx-descent__count) { font-size: 11px; max-width: 34ch; }
    .kdx-descent__strata { left: 20px; right: 20px; bottom: 73px; gap:0; justify-content:space-between; }
    .kdx-descent__strata button { width: 27px; height: 44px; }
    .kdx-descent__actions { right: 20px; bottom: 18px; }
    .kdx-descent__hint { display:none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kdx-descent *, .kdx-descent *::before, .kdx-descent *::after { animation: none !important; transition: none !important; }
  }
</style>
