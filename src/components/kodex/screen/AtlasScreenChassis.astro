---
import PuntoSenal from '../os/PuntoSenal.astro';
import CarrilEstados from '../os/CarrilEstados.astro';
import RielInstrumento from '../os/RielInstrumento.astro';
import TrazaViva from '../os/TrazaViva.astro';
import KodexOriginVector from '../density/KodexOriginVector.astro';
import KodexSystemLog from '../density/KodexSystemLog.astro';

interface AtlasRow {
  id: string;
  title: string;
  sourceUrl: string;
  concept: string;
  secondary: string;
  zone: string;
  scene: string;
  nodeIds: string[];
  symbols: string[];
  geometry: string;
  palette: string;
  composition: string;
  motion: string;
  interaction: string;
  sound: string;
  copy: string;
  epistemicLayer: string;
  provenance: string;
  status: string;
  nextAction: string;
  svgAssets: string[];
  pngAssets: string[];
  codeModule: string;
  followUp: string;
  notes: string;
}

interface Props {
  row: AtlasRow;
  slug: string;
  accent?: string;
  sceneIndex?: number;
  signalBase?: string;
}

const {
  row,
  slug,
  accent = '#8B5CF6',
  sceneIndex = 0,
  signalBase = 'LATENT',
} = Astro.props;

const atlasSource = 'ATLAS-07A-inventario-nodos-conexiones.md';
const liveState = 'HUECO';
const sourceLabel = `${atlasSource}:${row.id}`;
const assets = [...row.svgAssets, ...row.pngAssets];
const systemEntries: Array<[string, string]> = [
  ['00:00:00', `${row.id} SCREEN CANDIDATE LOADED`],
  ['00:00:01', `${row.codeModule} NOT IMPLEMENTED IN RUNTIME`],
  ['00:00:02', 'VISIBLE CHASSIS MOUNTED'],
  ['00:00:03', 'DATA STATUS HUECO DECLARED'],
];
---

<main class="kdx-screen" data-kdx-screen={slug} style={`--screen-accent:${accent};`}>
  <header class="kdx-screen__top">
    <a class="kdx-screen__back" href="/kodex/atlas/">ATLAS</a>
    <PuntoSenal base={signalBase} modo="SCREEN CANDIDATE / HUECO" accent="var(--screen-accent)" />
  </header>

  <section class="kdx-screen__grid" aria-labelledby="kdx-screen-title">
    <RielInstrumento
      lado="izq"
      nodo={row.id}
      estadoBase={liveState}
      senal={signalBase}
      acceso="SCREEN"
      accent="var(--screen-accent)"
      class="kdx-screen__rail"
    />

    <article class="kdx-screen__core">
      <p class="kdx-screen__eyebrow">{row.id} / {row.status}</p>
      <h1 id="kdx-screen-title">{row.title}</h1>
      <p class="kdx-screen__copy" data-fuente={sourceLabel}>{row.copy}</p>

      <div class="kdx-screen__organism" aria-label={row.composition}>
        <span class="kdx-screen__field" aria-hidden="true"></span>
        {row.nodeIds.map((node, index) => (
          <span class="kdx-screen__node" style={`--node-i:${index};`} data-node-id={node}>
            <b>{node.replace('KDX-NODE-', '')}</b>
          </span>
        ))}
      </div>

      <CarrilEstados />

      <dl class="kdx-screen__readouts">
        <div>
          <dt>CONCEPT</dt>
          <dd data-fuente={sourceLabel}>{row.concept}</dd>
        </div>
        <div>
          <dt>ZONE</dt>
          <dd data-fuente={sourceLabel}>{row.zone}</dd>
        </div>
        <div>
          <dt>MOTION</dt>
          <dd data-fuente={sourceLabel}>{row.motion}</dd>
        </div>
        <div>
          <dt>INTERACTION</dt>
          <dd data-fuente={sourceLabel}>{row.interaction}</dd>
        </div>
        <div>
          <dt>SOUND</dt>
          <dd data-fuente={sourceLabel}>{row.sound}</dd>
        </div>
        <div>
          <dt>RUNTIME</dt>
          <dd data-fuente="HUECO">{row.codeModule} pendiente</dd>
        </div>
      </dl>
    </article>

    <aside class="kdx-screen__right">
      <KodexOriginVector
        ra="RA HUECO"
        dec="DEC HUECO"
        sig="SIG HUECO"
        mod={`MOD ${row.scene}`}
        id={row.id}
        lines={[row.scene, row.epistemicLayer, 'SOURCE ATLAS 07A']}
        accent="var(--screen-accent)"
      />

      <section class="kdx-screen__panel">
        <p class="kdx-screen__panel-title">ATLAS ROW</p>
        <dl>
          <div><dt>SCENE</dt><dd data-fuente={sourceLabel}>{row.scene}</dd></div>
          <div><dt>GEOMETRY</dt><dd data-fuente={sourceLabel}>{row.geometry}</dd></div>
          <div><dt>PALETTE</dt><dd data-fuente={sourceLabel}>{row.palette}</dd></div>
          <div><dt>PROVENANCE</dt><dd data-fuente={sourceLabel}>{row.provenance}</dd></div>
        </dl>
      </section>

      <section class="kdx-screen__panel">
        <p class="kdx-screen__panel-title">DECLARED ASSETS</p>
        <ul>
          {assets.map((asset) => <li data-fuente="HUECO">{asset} / archivo no montado</li>)}
        </ul>
      </section>
    </aside>

    <KodexSystemLog
      entries={systemEntries}
      checksum={row.id}
      verifyAt="ATLAS-07A / SCREEN_CANDIDATE"
      threatLabel="NO REAL RUNTIME YET"
      accent="var(--screen-accent)"
      class="kdx-screen__log"
    />

    <TrazaViva actual={sceneIndex} accent="var(--screen-accent)" />
  </section>
</main>

<style>
  .kdx-screen {
    min-height: 100dvh;
    background:
      radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--screen-accent) 18%, transparent), transparent 32rem),
      linear-gradient(180deg, #050507 0%, #0b090f 52%, #050507 100%);
    color: var(--kdx-bone, #f0ede8);
    font-family: var(--kdx-mono, 'IBM Plex Mono', ui-monospace, monospace);
    overflow-x: clip;
  }

  .kdx-screen__top {
    position: fixed;
    z-index: 4;
    top: 18px;
    left: clamp(16px, 4vw, 42px);
    right: clamp(56px, 5vw, 88px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    pointer-events: none;
  }

  .kdx-screen__top > * { pointer-events: auto; }

  .kdx-screen__back {
    color: color-mix(in srgb, var(--screen-accent) 78%, #f0ede8);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-decoration: none;
  }

  .kdx-screen__grid {
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(160px, 0.72fr) minmax(0, 1.9fr) minmax(170px, 0.85fr);
    gap: clamp(18px, 3vw, 42px);
    padding: clamp(76px, 10vh, 112px) clamp(18px, 4vw, 56px) 34px;
  }

  .kdx-screen__core {
    align-self: center;
    min-width: 0;
    text-align: center;
  }

  .kdx-screen__eyebrow,
  .kdx-screen__panel-title {
    margin: 0;
    color: var(--screen-accent);
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .kdx-screen h1 {
    max-width: 12ch;
    margin: 0.22em auto 0;
    font-family: 'Instrument Serif', ui-serif, serif;
    font-size: clamp(3rem, 9vw, 8rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .kdx-screen__copy {
    max-width: 42rem;
    margin: clamp(16px, 3vh, 28px) auto 0;
    color: color-mix(in srgb, var(--screen-accent) 68%, #f0ede8);
    font-family: 'Instrument Serif', ui-serif, serif;
    font-size: clamp(1.05rem, 2.2vw, 1.55rem);
    font-style: italic;
    line-height: 1.25;
  }

  .kdx-screen__organism {
    position: relative;
    width: min(62vw, 560px);
    aspect-ratio: 1;
    margin: clamp(24px, 5vh, 54px) auto clamp(12px, 2vh, 22px);
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .kdx-screen__field {
    position: absolute;
    inset: 9%;
    border: 1px solid color-mix(in srgb, var(--screen-accent) 36%, transparent);
    border-radius: 50%;
    background:
      repeating-radial-gradient(circle, color-mix(in srgb, var(--screen-accent) 18%, transparent) 0 1px, transparent 1px 18px),
      radial-gradient(circle, color-mix(in srgb, var(--screen-accent) 22%, transparent), transparent 58%);
    box-shadow:
      inset 0 0 46px color-mix(in srgb, var(--screen-accent) 18%, transparent),
      0 0 42px color-mix(in srgb, var(--screen-accent) 13%, transparent);
    animation: kdx-screen-breathe 8s ease-in-out infinite;
  }

  .kdx-screen__field::before,
  .kdx-screen__field::after {
    content: '';
    position: absolute;
    inset: 18%;
    border: 1px solid color-mix(in srgb, #f0ede8 18%, transparent);
    border-radius: 50%;
  }

  .kdx-screen__field::after {
    inset: 36%;
    background: var(--screen-accent);
    opacity: 0.9;
    box-shadow: 0 0 24px var(--screen-accent);
  }

  .kdx-screen__node {
    --a: calc((360deg / 6) * var(--node-i) - 90deg);
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(34vw, 150px);
    min-height: 34px;
    display: grid;
    place-items: center;
    transform:
      translate(-50%, -50%)
      rotate(var(--a))
      translateY(calc(min(25vw, 220px) * -1))
      rotate(calc(var(--a) * -1));
    border-top: 1px solid color-mix(in srgb, var(--screen-accent) 34%, transparent);
    color: color-mix(in srgb, #f0ede8 72%, transparent);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .kdx-screen__node b {
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  .kdx-screen__readouts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 24px auto 0;
    border: 1px solid color-mix(in srgb, var(--screen-accent) 18%, transparent);
    text-align: left;
  }

  .kdx-screen__readouts > div,
  .kdx-screen__panel {
    padding: 12px;
    background: color-mix(in srgb, #050507 72%, transparent);
  }

  .kdx-screen dt {
    margin: 0 0 0.5em;
    color: color-mix(in srgb, var(--screen-accent) 62%, transparent);
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .kdx-screen dd,
  .kdx-screen li {
    margin: 0;
    color: color-mix(in srgb, #f0ede8 66%, transparent);
    font-size: 0.66rem;
    line-height: 1.55;
  }

  .kdx-screen__right {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-self: center;
    min-width: 0;
  }

  .kdx-screen__panel {
    border: 1px solid color-mix(in srgb, var(--screen-accent) 16%, transparent);
  }

  .kdx-screen__panel dl {
    margin: 12px 0 0;
    display: grid;
    gap: 10px;
  }

  .kdx-screen__panel ul {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .kdx-screen__log {
    grid-column: 1 / -1;
  }

  [data-fuente='HUECO'] {
    color: color-mix(in srgb, currentColor 44%, transparent);
  }

  [data-fuente='HUECO']::after {
    content: ' / HUECO';
    color: color-mix(in srgb, var(--screen-accent) 60%, transparent);
  }

  @media (max-width: 980px) {
    .kdx-screen__grid {
      grid-template-columns: 1fr;
    }

    .kdx-screen__rail {
      order: 2;
    }

    .kdx-screen__core {
      order: 1;
      padding-top: 26px;
    }

    .kdx-screen__right {
      order: 3;
    }

    .kdx-screen__organism {
      width: min(86vw, 460px);
    }

    .kdx-screen__node {
      transform:
        translate(-50%, -50%)
        rotate(var(--a))
        translateY(calc(min(36vw, 190px) * -1))
        rotate(calc(var(--a) * -1));
    }
  }

  @media (max-width: 640px) {
    .kdx-screen__top {
      position: absolute;
      align-items: flex-start;
      right: 14px;
    }

    .kdx-screen__grid {
      padding-top: 92px;
      gap: 24px;
    }

    .kdx-screen h1 {
      font-size: clamp(2.5rem, 17vw, 4.2rem);
    }

    .kdx-screen__organism {
      width: min(88vw, 360px);
      margin-top: 24px;
    }

    .kdx-screen__node {
      width: 108px;
      font-size: 0.48rem;
      transform:
        translate(-50%, -50%)
        rotate(var(--a))
        translateY(-132px)
        rotate(calc(var(--a) * -1));
    }

    .kdx-screen__readouts {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kdx-screen__field {
      animation: none;
    }
  }

  @keyframes kdx-screen-breathe {
    0%, 100% { transform: scale(0.985); opacity: 0.72; }
    50% { transform: scale(1.015); opacity: 0.96; }
  }
</style>
