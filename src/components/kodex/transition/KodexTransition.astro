---
/**
 * KODEX-∞ · RITUAL DE TRANSICIÓN
 *
 * One shared ritual with bounded boundary variants. KOD-74 changes spatial
 * semantics only; it does not create a second transition/runtime system.
 */
---

<div class="kdx-ritual" data-kdx-ritual data-variante="default" aria-hidden="true">
  <canvas class="kdx-ritual__bandas" data-kdx-ritual-canvas></canvas>
  <span class="kdx-ritual__linea"></span>
</div>

{/*
  PRE-PAINT HANDOFF

  The module runtime is deferred. Without this tiny parser-time handoff the
  target document can paint once at full visibility before recomposition mounts;
  on MACHINE→COSMOLOGY that produced the exact double-arrival KOD-74 exists to
  remove: full target → circular mask → full target again.

  This script does not choose a route or create state. It only consumes the
  already-existing one-navigation `sessionStorage` handoff and paints the same
  transition canvas black before the rest of the target scene can reach first
  paint. The module immediately takes ownership of this canvas and recomposes it.
*/}
<script is:inline>
  (() => {
    try {
      if (sessionStorage.getItem('kdx-ritual-pending') !== '1') return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const script = document.currentScript;
      const root = script?.previousElementSibling;
      if (!(root instanceof HTMLElement) || !root.matches('[data-kdx-ritual]')) return;

      const stored = sessionStorage.getItem('kdx-ritual-variant');
      const variant = stored === 'descent' || stored === 'cosmology' ? stored : 'default';
      root.dataset.variante = variant;
      root.dataset.activo = '';
      root.dataset.fase = 'recomposicion';

      const canvas = root.querySelector('[data-kdx-ritual-canvas]');
      if (!(canvas instanceof HTMLCanvasElement)) return;
      const d = Math.min(devicePixelRatio || 1, 1.5) * 0.5;
      canvas.width = Math.max(2, Math.round(innerWidth * d));
      canvas.height = Math.max(2, Math.round(innerHeight * d));
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.fillStyle = '#050507';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    } catch (_) {
      // Transition evidence must never turn a normal navigation into a dead end.
    }
  })();
</script>

<script>
  import "./kodex-transition-client.ts";
</script>

<style>
  .kdx-ritual {
    position: fixed;
    inset: 0;
    z-index: 9000;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }
  .kdx-ritual[data-activo] { opacity: 1; visibility: visible; }

  .kdx-ritual__bandas { display: block; width: 100%; height: 100%; }

  /* Default corridor ritual. Semantic variants draw their own accent edge in
     canvas so this horizontal line cannot reintroduce the generic aperture. */
  .kdx-ritual__linea {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    top: 50%;
    background: var(--kdx-scene-accent, var(--kdx-red, #FF3833));
    box-shadow: 0 0 24px 4px color-mix(in srgb, var(--kdx-scene-accent, #FF3833) 55%, transparent);
    transform: scaleX(0);
    opacity: 0;
  }
  .kdx-ritual[data-fase="colapso"][data-variante="default"] .kdx-ritual__linea {
    animation: kdx-ritual-filo var(--kdx-ritual-ms, 1400ms) cubic-bezier(0.7, 0, 0.2, 1) forwards;
  }
  .kdx-ritual[data-variante="descent"] .kdx-ritual__linea,
  .kdx-ritual[data-variante="cosmology"] .kdx-ritual__linea {
    display: none;
  }

  @keyframes kdx-ritual-filo {
    0%   { transform: scaleX(0); opacity: 0; }
    28%  { transform: scaleX(1); opacity: 1; }
    72%  { transform: scaleX(1); opacity: 1; }
    100% { transform: scaleX(1); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Same semantic end-state, without moving bands/rings. The two KOD-74
       boundaries retain only a quiet static spatial cue during crossfade. */
    .kdx-ritual__bandas, .kdx-ritual__linea { display: none; }
    .kdx-ritual {
      background: #050507;
      transition: opacity 240ms linear;
    }
    .kdx-ritual[data-variante="descent"] {
      background:
        linear-gradient(
          to bottom,
          color-mix(in srgb, var(--kdx-scene-accent, #FF3833) 11%, #050507) 0%,
          #050507 42%,
          #050507 100%
        );
    }
    .kdx-ritual[data-variante="cosmology"] {
      background:
        radial-gradient(
          circle at 50% 50%,
          color-mix(in srgb, var(--kdx-scene-accent, #FF3833) 12%, #050507) 0%,
          #050507 58%,
          #050507 100%
        );
    }
  }
</style>
