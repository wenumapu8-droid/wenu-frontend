---
/**
 * KODEX-∞ · RITUAL DE TRANSICIÓN
 *
 * La fórmula universal de escena (Receta Madre §2) termina en "1 transition
 * ritual". Hasta ahora el deck cambiaba de lámina con un desvanecido de opacidad
 * de medio segundo: correcto como transición web, vacío como ritual. En un
 * instrumento, pasar de una escena a otra es una operación del aparato, no un
 * corte de página.
 *
 * El movimiento sale de la gramática -- MOTION_12_STATE_TRANSITION, con sus
 * cuatro comportamientos: abrir, colapsar, recomponer, navegar. Dura entre 1.2
 * y 2.2 segundos, tiene prioridad crítica (es el único movimiento importante
 * mientras ocurre) y con movimiento reducido se degrada a crossfade.
 *
 * Se apoya en el estado de la escena: antes de colapsar, la máquina pasa a
 * `transitionOut`, así que el portal, el campo y el CRT se abren en el mismo
 * gesto. La imagen no se apaga: se abre y se va.
 *
 * El runtime puede seleccionar un perfil visual acotado dentro de este mismo
 * ritual. `depth` se reserva al corredor inicial para que la entrada se lea
 * como travesía hacia dentro; no crea una segunda arquitectura de transición.
 */
---

<div class="kdx-ritual" data-kdx-ritual aria-hidden="true">
  <canvas class="kdx-ritual__bandas" data-kdx-ritual-canvas></canvas>
  <span class="kdx-ritual__linea"></span>
</div>

<script>
  import "./kodex-transition-client.ts";
</script>

<style>
  .kdx-ritual {
    position: fixed;
    inset: 0;
    z-index: 9000;
    pointer-events: none;
    opacity: 0;
    /* Sin visibilidad oculta el lienzo sigue componiéndose en cada cuadro
       aunque no se vea, y son 60 composiciones por segundo de pura pérdida. */
    visibility: hidden;
  }
  .kdx-ritual[data-activo] { opacity: 1; visibility: visible; }

  .kdx-ritual__bandas { display: block; width: 100%; height: 100%; }

  /* El filo que recorre la lámina en el colapso. Es lo que da la sensación de
     que algo se cierra en vez de que algo se apaga. */
  .kdx-ritual__linea {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    top: 50%;
    background: var(--kdx-scene-accent, var(--kdx-red, #FF3833));
    box-shadow: 0 0 24px 4px color-mix(in srgb, var(--kdx-scene-accent, #FF3833) 55%, transparent);
    transform: scaleX(0);
    opacity: 0;
  }
  .kdx-ritual[data-fase="colapso"] .kdx-ritual__linea {
    animation: kdx-ritual-filo var(--kdx-ritual-ms, 1400ms) cubic-bezier(0.7, 0, 0.2, 1) forwards;
  }

  /* El corredor de profundidad usa el canvas completo; el filo horizontal
     pertenece al perfil de bandas y rompería la lectura de túnel/portal. */
  .kdx-ritual[data-perfil="depth"] .kdx-ritual__linea {
    display: none;
  }

  /* Segunda lectura del perfil depth: no agrega geometría de contenido, sólo
     materializa la señal del cruce. El canvas sigue llevando los anillos/rayos;
     esta capa aporta scan + interferencia luminosa para que el umbral se lea
     como información atravesada, no como un túnel 3D genérico. */
  .kdx-ritual[data-perfil="depth"]::before,
  .kdx-ritual[data-perfil="depth"]::after {
    content: "";
    position: absolute;
    inset: -8%;
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .kdx-ritual[data-perfil="depth"]::before {
    background:
      radial-gradient(ellipse at center, transparent 0 18%, color-mix(in srgb, var(--kdx-scene-accent, #FF3833) 13%, transparent) 42%, transparent 72%),
      repeating-linear-gradient(0deg, transparent 0 5px, rgba(255,255,255,.025) 6px, transparent 7px);
    opacity: .72;
    animation: kdx-depth-scan 860ms ease-in-out both;
  }
  .kdx-ritual[data-perfil="depth"]::after {
    background:
      conic-gradient(from 0deg at 50% 50%, transparent 0 12deg, color-mix(in srgb, var(--kdx-scene-accent, #FF3833) 10%, transparent) 13deg 14deg, transparent 15deg 43deg);
    opacity: .38;
    filter: blur(.6px);
    animation: kdx-depth-field 900ms cubic-bezier(.2,.7,.1,1) both;
  }

  @keyframes kdx-ritual-filo {
    0%   { transform: scaleX(0); opacity: 0; }
    28%  { transform: scaleX(1); opacity: 1; }
    72%  { transform: scaleX(1); opacity: 1; }
    100% { transform: scaleX(1); opacity: 0; }
  }

  @keyframes kdx-depth-scan {
    0% { opacity: 0; transform: scale(.92); filter: blur(0); }
    34% { opacity: .82; }
    100% { opacity: .14; transform: scale(1.5); filter: blur(1.2px); }
  }

  @keyframes kdx-depth-field {
    0% { transform: scale(.9) rotate(0deg); opacity: 0; }
    26% { opacity: .44; }
    100% { transform: scale(1.72) rotate(8deg); opacity: .08; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* La gramática lo dice explícitamente: con movimiento reducido este
       preset degrada a crossfade. Sin bandas, sin filo, sin barrido. */
    .kdx-ritual__bandas, .kdx-ritual__linea { display: none; }
    .kdx-ritual { background: #050507; transition: opacity 240ms linear; }
    .kdx-ritual::before, .kdx-ritual::after { display: none !important; }
  }
</style>

<!--
  DEPTH TRAVERSAL P0

  El ritual ya sabía dibujar profundidad, pero hasta ahora la escena debajo no
  participaba: era un túnel superpuesto. Este bloque global hace que las capas
  REALES del opening respondan al único estado autoritativo `transitionOut`.

  No hay cámara 3D, no hay router nuevo y no se rasteriza texto. DOM/SVG conserva
  composición y accesibilidad; WebGL/canvas aporta materia/señal. El resultado
  es 2.5D: planos con velocidades y escalas diferentes que producen optical flow.
-->
<style is:global>
  :root {
    --kdx-depth-ease: cubic-bezier(.18,.78,.12,1);
    --kdx-depth-ms: 880ms;
  }

  /* Sólo el corredor inicial. Ninguna otra escena hereda esta firma hasta que
     exista creator KEEP y evidencia temporal suficiente para escalarla. */
  .kx--threshold .kx-threshold__field,
  .kx--threshold .kx-threshold__body,
  .kx--threshold .kx-threshold__artifact,
  .kx-os-scene--prologue .kx-os-stage__livefield,
  .kx-os-scene--prologue .kx-os-stage__field,
  .kx-os-scene--prologue .kx-os-stage__copy,
  .kx-os-scene--prologue .kx-os-stage__art,
  .kx-os-scene--prologue .kx-os-stage__strip,
  .kx-os-scene--prologue .kx-os-stage__eje,
  .kx-os-scene--prologue .kx-os-stage__tira {
    will-change: transform, opacity, filter;
    transition:
      transform var(--kdx-depth-ms) var(--kdx-depth-ease),
      opacity calc(var(--kdx-depth-ms) * .82) ease,
      filter calc(var(--kdx-depth-ms) * .82) ease;
    backface-visibility: hidden;
  }

  /* THRESHOLD → PROLOGUE: la OBRA se vuelve puerta. La periferia y el campo
     pierden jerarquía mientras el anchor crece hacia la cámara. */
  html[data-kdx-state="transitionOut"] .kx--threshold .kx-threshold__artifact {
    transform: translate3d(0,0,0) scale(3.7);
    transform-origin: 50% 50%;
    filter: brightness(1.28) saturate(1.18) blur(.8px);
    opacity: .96;
  }
  html[data-kdx-state="transitionOut"] .kx--threshold .kx-threshold__field {
    transform: scale(1.78);
    filter: blur(2.2px) brightness(1.22);
    opacity: .42;
  }
  html[data-kdx-state="transitionOut"] .kx--threshold .kx-threshold__body {
    transform: scale(.94);
    filter: blur(3px);
    opacity: 0;
  }

  /* PROLOGUE → DESCENT: no repite el portal radial. La placa central atraviesa
     el frame mientras los instrumentos se expulsan con distinta velocidad.
     Así la escena se convierte en profundidad estratificada. */
  html[data-kdx-state="transitionOut"] .kx-os-scene--prologue .kx-os-stage__art {
    transform: translate3d(0,0,0) scale(4.35);
    transform-origin: 50% 50%;
    filter: brightness(1.34) contrast(1.08) saturate(1.16) blur(.7px);
    opacity: .98;
  }
  html[data-kdx-state="transitionOut"] .kx-os-scene--prologue .kx-os-stage__livefield,
  html[data-kdx-state="transitionOut"] .kx-os-scene--prologue .kx-os-stage__field {
    transform: scale(1.86);
    filter: blur(2.4px) brightness(1.3);
    opacity: .48;
  }
  html[data-kdx-state="transitionOut"] .kx-os-scene--prologue .kx-os-stage__copy {
    transform: translate3d(-8vw,-2vh,0) scale(.92);
    filter: blur(3px);
    opacity: 0;
  }
  html[data-kdx-state="transitionOut"] .kx-os-scene--prologue .kx-os-stage__strip {
    transform: translate3d(10vw,0,0) scale(1.08);
    filter: blur(2px);
    opacity: 0;
  }
  html[data-kdx-state="transitionOut"] .kx-os-scene--prologue .kx-os-stage__eje,
  html[data-kdx-state="transitionOut"] .kx-os-scene--prologue .kx-os-stage__tira {
    transform: translate3d(0,7vh,0) scale(1.14);
    filter: blur(1.6px);
    opacity: 0;
  }

  /* DECODE / SETTLE. La escena de llegada se construye por planos en vez de
     aparecer completa de golpe. También funciona en entrada directa: sigue
     siendo una llegada suave y no altera estado, URL ni memoria. */
  .kx-os-scene--prologue .kx-os-stage__art,
  .kx-os-scene--descent .kx-os-stage__art {
    animation: kdx-depth-anchor-settle 760ms var(--kdx-depth-ease) both;
  }
  .kx-os-scene--prologue .kx-os-stage__copy,
  .kx-os-scene--descent .kx-os-stage__copy {
    animation: kdx-depth-copy-settle 680ms 120ms ease-out both;
  }
  .kx-os-scene--prologue .kx-os-stage__field,
  .kx-os-scene--descent .kx-os-stage__field,
  .kx-os-scene--prologue .kx-os-stage__livefield,
  .kx-os-scene--descent .kx-os-stage__livefield {
    animation: kdx-depth-field-settle 900ms ease-out both;
  }

  @keyframes kdx-depth-anchor-settle {
    0% { opacity: .2; transform: scale(1.22); filter: blur(4px) brightness(1.45); }
    42% { opacity: .92; filter: blur(.8px) brightness(1.16); }
    100% { opacity: 1; transform: scale(1); filter: none; }
  }
  @keyframes kdx-depth-copy-settle {
    0% { opacity: 0; transform: translate3d(0,16px,0); filter: blur(3px); }
    100% { opacity: 1; transform: translate3d(0,0,0); filter: none; }
  }
  @keyframes kdx-depth-field-settle {
    0% { opacity: .18; transform: scale(1.24); filter: blur(3px); }
    100% { opacity: 1; transform: scale(1); filter: none; }
  }

  /* Móvil conserva la misma ley espacial pero reduce amplitud: menos expulsión
     periférica y menos zoom, no una miniatura del desktop. */
  @media (max-width: 700px) {
    html[data-kdx-state="transitionOut"] .kx--threshold .kx-threshold__artifact {
      transform: scale(2.7);
    }
    html[data-kdx-state="transitionOut"] .kx-os-scene--prologue .kx-os-stage__art {
      transform: scale(3.15);
    }
    html[data-kdx-state="transitionOut"] .kx-os-scene--prologue .kx-os-stage__copy {
      transform: translate3d(-4vw,-1vh,0) scale(.95);
    }
    html[data-kdx-state="transitionOut"] .kx-os-scene--prologue .kx-os-stage__strip {
      transform: translate3d(6vw,0,0) scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kx--threshold .kx-threshold__field,
    .kx--threshold .kx-threshold__body,
    .kx--threshold .kx-threshold__artifact,
    .kx-os-scene--prologue .kx-os-stage__livefield,
    .kx-os-scene--prologue .kx-os-stage__field,
    .kx-os-scene--prologue .kx-os-stage__copy,
    .kx-os-scene--prologue .kx-os-stage__art,
    .kx-os-scene--prologue .kx-os-stage__strip,
    .kx-os-scene--prologue .kx-os-stage__eje,
    .kx-os-scene--prologue .kx-os-stage__tira,
    .kx-os-scene--descent .kx-os-stage__livefield,
    .kx-os-scene--descent .kx-os-stage__field,
    .kx-os-scene--descent .kx-os-stage__copy,
    .kx-os-scene--descent .kx-os-stage__art {
      animation: none !important;
      transform: none !important;
      filter: none !important;
      transition: opacity 180ms linear !important;
    }
  }
</style>