---
/**
 * KODEX-∞ · RITUAL DE TRANSICIÓN
 *
 * La fórmula universal de escena (Receta Madre §2) termina en "1 transition
 * ritual". Hasta ahora el deck cambiaba de lámina con un desvanecido de opacidad
 * de medio segundo: correcto como transición web, vacío como ritual. En un
 * instrumento, pasar de una escena a otra es una operación del aparato, no un
 * corte de página.
 *
 * El movimiento sale de la gramática -- MOTION_12_STATE_TRANSITION, con sus
 * cuatro comportamientos: abrir, colapsar, recomponer, navegar. Dura entre 1.2
 * y 2.2 segundos, tiene prioridad crítica (es el único movimiento importante
 * mientras ocurre) y con movimiento reducido se degrada a crossfade.
 *
 * Se apoya en el estado de la escena: antes de colapsar, la máquina pasa a
 * `transitionOut`, así que el portal, el campo y el CRT se abren en el mismo
 * gesto. La imagen no se apaga: se abre y se va.
 *
 * El runtime puede seleccionar un perfil visual acotado dentro de este mismo
 * ritual. `depth` se reserva al corredor inicial para que la entrada se lea
 * como travesía hacia dentro; no crea una segunda arquitectura de transición.
 */
---

<div class="kdx-ritual" data-kdx-ritual aria-hidden="true">
  <canvas class="kdx-ritual__bandas" data-kdx-ritual-canvas></canvas>
  <span class="kdx-ritual__linea"></span>
</div>

<script>
  import "./kodex-transition-client.ts";
  import "./kodex-depth-continuity-client.ts";
</script>

<style>
  .kdx-ritual {
    position: fixed;
    inset: 0;
    z-index: 9000;
    pointer-events: none;
    opacity: 0;
    /* Sin visibilidad oculta el lienzo sigue componiéndose en cada cuadro
       aunque no se vea, y son 60 composiciones por segundo de pura pérdida. */
    visibility: hidden;
  }
  .kdx-ritual[data-activo] { opacity: 1; visibility: visible; }

  .kdx-ritual__bandas { display: block; width: 100%; height: 100%; }

  /* El filo que recorre la lámina en el colapso. Es lo que da la sensación de
     que algo se cierra en vez de que algo se apaga. */
  .kdx-ritual__linea {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    top: 50%;
    background: var(--kdx-scene-accent, var(--kdx-red, #FF3833));
    box-shadow: 0 0 24px 4px color-mix(in srgb, var(--kdx-scene-accent, #FF3833) 55%, transparent);
    transform: scaleX(0);
    opacity: 0;
  }
  .kdx-ritual[data-fase="colapso"] .kdx-ritual__linea {
    animation: kdx-ritual-filo var(--kdx-ritual-ms, 1400ms) cubic-bezier(0.7, 0, 0.2, 1) forwards;
  }

  /* El corredor de profundidad usa el canvas completo; el filo horizontal
     pertenece al perfil de bandas y rompería la lectura de túnel/portal. */
  .kdx-ritual[data-perfil="depth"] .kdx-ritual__linea {
    display: none;
  }

  /* PROLOGUE → DESCENT: el documento nuevo puede existir durante unos frames
     antes de que el bridge JS de llegada se hidrate. En ese intervalo el canvas
     de profundidad no puede volver a leerse como un túnel negro genérico. Este
     residuo vive DENTRO del ritual existente y sólo aparece cuando el destino
     ya contiene la escena DESCENT; THRESHOLD → PROLOGUE no lo recibe.

     `body` vive fuera del scope del componente Astro. Mantenerlo explícitamente
     global evita que el compilador le añada el atributo scoped y vuelva esta
     condición imposible durante la recomposición del documento destino. */
  :global(body:has(.kx-os-scene--descent)) .kdx-ritual[data-perfil="depth"][data-fase="recomposicion"]::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: clamp(170px, 42vmin, 440px);
    height: clamp(118px, 28vmin, 294px);
    transform: translate(-50%, -50%) scale(2.2);
    border-radius: 52% 48% 52% 48% / 48% 52% 48% 52%;
    border: 1px solid color-mix(in srgb, #B27CFF 88%, white);
    background:
      radial-gradient(circle at 50% 50%, #050507 0 4%, #B27CFF 4.5% 5.3%, transparent 5.8% 18%, color-mix(in srgb, #B27CFF 74%, transparent) 18.5% 19.1%, transparent 19.6% 31%, color-mix(in srgb, #B27CFF 52%, transparent) 31.5% 32.1%, transparent 32.6%),
      radial-gradient(ellipse at 50% 50%, color-mix(in srgb, #B27CFF 18%, transparent), transparent 68%);
    box-shadow:
      0 0 42px color-mix(in srgb, #B27CFF 62%, transparent),
      inset 0 0 36px color-mix(in srgb, #B27CFF 34%, transparent);
    opacity: .94;
    animation: kdx-depth-eye-handoff 720ms cubic-bezier(.16,.78,.28,1) both;
  }

  @keyframes kdx-depth-eye-handoff {
    0%   { transform: translate(-50%, -50%) scale(2.5); opacity: .96; filter: blur(0); }
    46%  { transform: translate(-50%, -50%) scale(1.72); opacity: .82; filter: blur(.2px); }
    72%  { transform: translate(-50%, -50%) scale(1.18); opacity: .58; filter: blur(.5px); }
    100% { transform: translate(-50%, -50%) scale(.84); opacity: 0; filter: blur(1px); }
  }

  @keyframes kdx-ritual-filo {
    0%   { transform: scaleX(0); opacity: 0; }
    28%  { transform: scaleX(1); opacity: 1; }
    72%  { transform: scaleX(1); opacity: 1; }
    100% { transform: scaleX(1); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* La gramática lo dice explícitamente: con movimiento reducido este
       preset degrada a crossfade. Sin bandas, sin filo, sin barrido. */
    .kdx-ritual__bandas, .kdx-ritual__linea { display: none; }
    .kdx-ritual { background: #050507; transition: opacity 240ms linear; }
    :global(body:has(.kx-os-scene--descent)) .kdx-ritual[data-perfil="depth"][data-fase="recomposicion"]::after {
      animation: none;
      transform: translate(-50%, -50%) scale(1.2);
      opacity: .72;
    }
  }
</style>