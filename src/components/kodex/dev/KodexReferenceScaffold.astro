---
interface Props {
  referenceSrc: string;
  alt?: string;
  label?: string;
  sourceId?: string;
  initialMode?: 'REFERENCE' | 'OVERLAY' | 'SPLIT' | 'NATIVE';
  initialOpacity?: number;
  fit?: 'cover' | 'contain';
  visualTargetMatch?: number;
  nativeImplementation?: number;
}

const {
  referenceSrc,
  alt = 'KODEX working visual reference',
  label = 'VISUAL REFERENCE',
  sourceId = 'UNREGISTERED',
  initialMode = 'SPLIT',
  initialOpacity = 0.5,
  fit = 'cover',
  visualTargetMatch,
  nativeImplementation,
} = Astro.props;

const opacity = Math.max(0, Math.min(1, initialOpacity));
---

<div
  class="kdx-ref"
  data-kdx-reference-scaffold
  data-mode={initialMode}
  style={`--kdx-ref-opacity:${opacity}; --kdx-ref-fit:${fit};`}
>
  <div class="kdx-ref__reference" aria-hidden="true">
    <img src={referenceSrc} alt="" draggable="false" />
  </div>

  <aside class="kdx-ref__controls" aria-label="KODEX visual reference scaffold controls">
    <div class="kdx-ref__identity">
      <strong>{label}</strong>
      <span>{sourceId}</span>
    </div>

    <div class="kdx-ref__modes" role="group" aria-label="Comparison mode">
      {['REFERENCE', 'OVERLAY', 'SPLIT', 'NATIVE'].map((mode) => (
        <button type="button" data-kdx-ref-mode={mode} aria-pressed={mode === initialMode ? 'true' : 'false'}>
          {mode}
        </button>
      ))}
    </div>

    <label class="kdx-ref__opacity">
      <span>REF OPACITY</span>
      <input
        type="range"
        min="0"
        max="100"
        step="1"
        value={Math.round(opacity * 100)}
        data-kdx-ref-opacity
      />
      <output data-kdx-ref-opacity-value>{Math.round(opacity * 100)}%</output>
    </label>

    <div class="kdx-ref__measurements">
      <span>
        VISUAL TARGET
        <strong>{typeof visualTargetMatch === 'number' ? `${visualTargetMatch}%` : '—'}</strong>
      </span>
      <span>
        NATIVE BUILD
        <strong>{typeof nativeImplementation === 'number' ? `${nativeImplementation}%` : '—'}</strong>
      </span>
    </div>

    <details>
      <summary>REFERENCE INFO</summary>
      <p>{alt}</p>
      <code>{referenceSrc}</code>
    </details>
  </aside>
</div>

<script>
  const scaffolds = document.querySelectorAll<HTMLElement>('[data-kdx-reference-scaffold]');

  scaffolds.forEach((root) => {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-kdx-ref-mode]');
    const slider = root.querySelector<HTMLInputElement>('[data-kdx-ref-opacity]');
    const value = root.querySelector<HTMLOutputElement>('[data-kdx-ref-opacity-value]');

    const setMode = (mode: string) => {
      root.dataset.mode = mode;
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.kdxRefMode === mode));
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => setMode(button.dataset.kdxRefMode ?? 'NATIVE'));
    });

    slider?.addEventListener('input', () => {
      const next = Math.max(0, Math.min(100, Number(slider.value)));
      root.style.setProperty('--kdx-ref-opacity', String(next / 100));
      if (value) value.value = `${next}%`;
    });
  });
</script>

<style>
  .kdx-ref {
    --kdx-ref-opacity: .5;
    --kdx-ref-fit: cover;
    position: fixed;
    inset: 0;
    z-index: 2147482000;
    pointer-events: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .kdx-ref__reference {
    position: absolute;
    inset: 0;
    opacity: var(--kdx-ref-opacity);
    transition: opacity 120ms linear, clip-path 120ms linear;
  }

  .kdx-ref__reference img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: var(--kdx-ref-fit);
    object-position: center;
    user-select: none;
  }

  .kdx-ref[data-mode='REFERENCE'] .kdx-ref__reference {
    opacity: 1;
  }

  .kdx-ref[data-mode='OVERLAY'] .kdx-ref__reference {
    opacity: var(--kdx-ref-opacity);
  }

  .kdx-ref[data-mode='SPLIT'] .kdx-ref__reference {
    opacity: 1;
    clip-path: inset(0 50% 0 0);
  }

  .kdx-ref[data-mode='NATIVE'] .kdx-ref__reference {
    opacity: 0;
    visibility: hidden;
  }

  .kdx-ref__controls {
    position: absolute;
    top: max(12px, env(safe-area-inset-top));
    right: max(12px, env(safe-area-inset-right));
    width: min(430px, calc(100vw - 24px));
    box-sizing: border-box;
    padding: 10px;
    color: #f4f4f0;
    background: rgb(6 7 7 / 92%);
    border: 1px solid rgb(255 255 255 / 22%);
    backdrop-filter: blur(12px);
    pointer-events: auto;
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .kdx-ref__identity,
  .kdx-ref__measurements,
  .kdx-ref__opacity {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .kdx-ref__identity span,
  .kdx-ref__measurements span,
  .kdx-ref details {
    color: rgb(244 244 240 / 62%);
  }

  .kdx-ref__modes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4px;
    margin: 9px 0;
  }

  .kdx-ref button {
    min-height: 28px;
    padding: 4px 5px;
    color: inherit;
    background: transparent;
    border: 1px solid rgb(255 255 255 / 18%);
    font: inherit;
    cursor: pointer;
  }

  .kdx-ref button[aria-pressed='true'] {
    background: #f4f4f0;
    color: #070808;
  }

  .kdx-ref__opacity {
    display: grid;
    grid-template-columns: auto 1fr auto;
    margin: 8px 0;
  }

  .kdx-ref__opacity input {
    width: 100%;
  }

  .kdx-ref__measurements {
    border-top: 1px solid rgb(255 255 255 / 12%);
    padding-top: 8px;
  }

  .kdx-ref__measurements span {
    display: flex;
    gap: 8px;
  }

  .kdx-ref__measurements strong {
    color: #f4f4f0;
  }

  .kdx-ref details {
    margin-top: 8px;
    border-top: 1px solid rgb(255 255 255 / 12%);
    padding-top: 7px;
  }

  .kdx-ref summary {
    cursor: pointer;
    color: #f4f4f0;
  }

  .kdx-ref details p {
    margin: 6px 0;
    text-transform: none;
    letter-spacing: normal;
  }

  .kdx-ref code {
    overflow-wrap: anywhere;
    text-transform: none;
    letter-spacing: normal;
  }

  @media (max-width: 620px) {
    .kdx-ref__controls {
      top: auto;
      right: max(8px, env(safe-area-inset-right));
      bottom: max(8px, env(safe-area-inset-bottom));
      left: max(8px, env(safe-area-inset-left));
      width: auto;
    }

    .kdx-ref__measurements {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kdx-ref__reference {
      transition: none;
    }
  }
</style>
