---
import KodexOrganism from "../organism/KodexOrganism.astro";

interface Props {
  altarId: string;
  nodeCoordinate: string;
  organismPreset: string;
  organismFallback: string;
  organismLabel: string;
  organismDescription?: string;
  eager?: boolean;
  class?: string;
}

const {
  altarId,
  nodeCoordinate,
  organismPreset,
  organismFallback,
  organismLabel,
  organismDescription,
  eager = true,
  class: className = "",
} = Astro.props;
---

<section
  class:list={["kdx-digital-altar", "kdx-temple__altar-zone", className]}
  data-kdx-digital-altar
  data-altar-id={altarId}
  data-node-coordinate={nodeCoordinate}
  aria-label={`Digital Altar ${altarId}`}
>
  <div class="kdx-temple__altar-halo" aria-hidden="true"></div>

  <div class="kdx-temple__organism-shell">
    <KodexOrganism
      preset={organismPreset}
      fallback={organismFallback}
      label={organismLabel}
      description={organismDescription}
      eager={eager}
    />
  </div>

  <div class="kdx-temple__pedestal" aria-hidden="true">
    <span class="kdx-temple__pedestal-ring kdx-temple__pedestal-ring--outer"></span>
    <span class="kdx-temple__pedestal-ring kdx-temple__pedestal-ring--middle"></span>
    <span class="kdx-temple__pedestal-ring kdx-temple__pedestal-ring--inner"></span>
    <strong>∞</strong>
  </div>

  <div class="kdx-digital-altar__semantic" aria-hidden="false">
    <span>ALTAR // {nodeCoordinate}</span>
    <span>{organismPreset}</span>
  </div>

  <slot />
</section>

<style>
  .kdx-digital-altar__semantic {
    position: absolute;
    left: 50%;
    bottom: -0.35rem;
    z-index: 4;
    display: flex;
    gap: 0.7rem;
    transform: translateX(-50%);
    color: rgb(255 255 255 / 0.34);
    font: 500 0.5rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .kdx-digital-altar__semantic { display: none; }
  }
</style>
