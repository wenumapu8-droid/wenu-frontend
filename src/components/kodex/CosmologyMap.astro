---
// KODEX−∞ · COSMOLOGY MAP (§3 storyboard 05, §6 organs).
// Orbital map: 6 concept nodes around KODEX center, 5 organs on outer ring
// as portals to the wider Wenu ecosystem. Pointer, keyboard and touch all
// resolve through the same semantic relation map. Below 640px the orbital
// drawing yields to a compact list made from those same six canonical nodes.
---
<section class="kdx-cosmo" aria-labelledby="kdx-cosmo-title">
  <header class="kdx-cosmo__head">
    <span class="kdx-cosmo__eyebrow">◐ COSMOLOGY · MAP</span>
    <h2 class="kdx-cosmo__title" id="kdx-cosmo-title">the system beneath the system</h2>
    <p class="kdx-cosmo__lede">
      Nothing here stands alone. Signal becomes matter, matter becomes body,
      body becomes memory. Each concept is a doorway to a working part of the
      wider Wenu ecosystem — jewelry, biology, artifacts, DNA, practice.
    </p>
  </header>

  <div class="kdx-cosmo__stage">
    <svg class="kdx-cosmo__svg" viewBox="0 0 500 500" role="img" aria-labelledby="kdx-cosmo-svg-title" preserveAspectRatio="xMidYMid meet">
      <title id="kdx-cosmo-svg-title">KODEX cosmology map — 6 concept nodes orbit the codex, connected to 5 living systems.</title>
      <defs>
        <radialGradient id="kdx-cosmo-core" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#FF00C8" stop-opacity=".28" />
          <stop offset="60%" stop-color="#0A0A0A" stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle cx="250" cy="250" r="220" fill="url(#kdx-cosmo-core)" />
      <circle cx="250" cy="250" r="150" fill="none" stroke="rgba(237,237,237,.12)" stroke-dasharray="2 6" />
      <circle cx="250" cy="250" r="220" fill="none" stroke="rgba(237,237,237,.08)" stroke-dasharray="1 4" />

      <g class="kdx-cosmo__links" stroke="rgba(183,112,255,.28)" stroke-width="1" fill="none">
        <line x1="250" y1="250" x2="250" y2="100" data-link="signal-machine" />
        <line x1="250" y1="250" x2="380" y2="175" data-link="matter-wenumapu" />
        <line x1="250" y1="250" x2="380" y2="325" data-link="body-wenumapu" />
        <line x1="250" y1="250" x2="250" y2="400" data-link="memory-serpent" />
        <line x1="250" y1="250" x2="120" y2="325" data-link="territory-soma" />
        <line x1="250" y1="250" x2="120" y2="175" data-link="machine-kodex" />
      </g>

      <g class="kdx-cosmo__nodes">
        <g data-node="signal" role="button" tabindex="0" aria-label="Reveal SIGNAL relation" transform="translate(250 100)">
          <circle r="6" fill="#B770FF" />
          <text y="-14" text-anchor="middle" class="kdx-cosmo__label">SIGNAL</text>
        </g>
        <g data-node="matter" role="button" tabindex="0" aria-label="Reveal MATTER relation" transform="translate(380 175)">
          <circle r="6" fill="#B770FF" />
          <text y="-14" text-anchor="middle" class="kdx-cosmo__label">MATTER</text>
        </g>
        <g data-node="body" role="button" tabindex="0" aria-label="Reveal BODY relation" transform="translate(380 325)">
          <circle r="6" fill="#B770FF" />
          <text y="22" text-anchor="middle" class="kdx-cosmo__label">BODY</text>
        </g>
        <g data-node="memory" role="button" tabindex="0" aria-label="Reveal MEMORY relation" transform="translate(250 400)">
          <circle r="6" fill="#B770FF" />
          <text y="22" text-anchor="middle" class="kdx-cosmo__label">MEMORY</text>
        </g>
        <g data-node="territory" role="button" tabindex="0" aria-label="Reveal TERRITORY relation" transform="translate(120 325)">
          <circle r="6" fill="#B770FF" />
          <text y="22" text-anchor="middle" class="kdx-cosmo__label">TERRITORY</text>
        </g>
        <g data-node="machine" role="button" tabindex="0" aria-label="Reveal MACHINE relation" transform="translate(120 175)">
          <circle r="6" fill="#B770FF" />
          <text y="-14" text-anchor="middle" class="kdx-cosmo__label">MACHINE</text>
        </g>
      </g>

      <g class="kdx-cosmo__core">
        <circle cx="250" cy="250" r="24" fill="#0A0A0A" stroke="#EDEDED" stroke-width="1" />
        <text x="250" y="256" text-anchor="middle" class="kdx-cosmo__center">KODEX ∞</text>
      </g>
    </svg>

    <ol class="kdx-cosmo__concept-list" aria-label="cosmology concepts">
      <li><button type="button" data-node="signal">SIGNAL <span>→ MACHINE</span></button></li>
      <li><button type="button" data-node="matter">MATTER <span>→ WENU MAPU</span></button></li>
      <li><button type="button" data-node="body">BODY <span>→ WENU MAPU</span></button></li>
      <li><button type="button" data-node="memory">MEMORY <span>→ COSMIC SERPENT</span></button></li>
      <li><button type="button" data-node="territory">TERRITORY <span>→ SOMA</span></button></li>
      <li><button type="button" data-node="machine">MACHINE <span>→ PRACTICE</span></button></li>
    </ol>

    <ol class="kdx-cosmo__portals" role="list" aria-label="ecosystem portals">
      <li class="kdx-portal">
        <a href="/" data-organ="wenumapu">
          <span class="kdx-portal__eye">◈ WENU MAPU</span>
          <span class="kdx-portal__dom">body · jewelry · piercing · ritual technology</span>
          <span class="kdx-portal__state">MANIFESTED</span>
        </a>
      </li>
      <li class="kdx-portal">
        <a href="mailto:marimari@wenumapuonline.com?subject=SOMA · inquiry" data-organ="soma">
          <span class="kdx-portal__eye">◈ SOMA</span>
          <span class="kdx-portal__dom">biology · fungi · inner change · consciousness</span>
          <span class="kdx-portal__state">EXCAVATION</span>
        </a>
      </li>
      <li class="kdx-portal">
        <a href="mailto:marimari@wenumapuonline.com?subject=DISCO SOLAR · inquiry" data-organ="disco">
          <span class="kdx-portal__eye">◈ DISCO SOLAR</span>
          <span class="kdx-portal__dom">speculative artifacts · WebAR · spirit interfaces</span>
          <span class="kdx-portal__state">TRANSMUTATION</span>
        </a>
      </li>
      <li class="kdx-portal">
        <a href="mailto:marimari@wenumapuonline.com?subject=COSMIC SERPENT · inquiry" data-organ="serpent">
          <span class="kdx-portal__eye">◈ COSMIC SERPENT</span>
          <span class="kdx-portal__dom">DNA · cycles · the unconscious · archetypes</span>
          <span class="kdx-portal__state">LATENT</span>
        </a>
      </li>
      <li class="kdx-portal">
        <a href="/kodex/" data-organ="practice">
          <span class="kdx-portal__eye">◈ PRACTICE</span>
          <span class="kdx-portal__dom">research · art direction · UX/UI · 3D · systems</span>
          <span class="kdx-portal__state">ACTIVE</span>
        </a>
      </li>
    </ol>
  </div>
</section>

<style is:global>
  .kdx-cosmo{ background:var(--kdx-black,#0A0A0A); color:var(--kdx-dust-white,#EDEDED);
    padding:clamp(40px,7vh,80px) clamp(16px,5vw,64px);
    font-family:'Inter Tight','Instrument Sans',system-ui,sans-serif; }
  .kdx-cosmo__head{ max-width:60ch; margin:0 auto clamp(28px,5vh,52px); text-align:center; }
  .kdx-cosmo__eyebrow{ font-family:'IBM Plex Mono',ui-monospace,monospace; font-size:11px; letter-spacing:.24em; color:var(--kdx-magenta,#FF00C8); }
  .kdx-cosmo__title{ font-family:'Archivo','Inter Tight',system-ui,sans-serif; font-stretch:125%; font-weight:700;
    letter-spacing:.02em; text-transform:uppercase; font-size:clamp(1.4rem,3.5vw,2.2rem); margin:10px 0; }
  .kdx-cosmo__lede{ font-size:14px; line-height:1.6; color:var(--kdx-muted,#88888A); margin:0; }
  .kdx-cosmo__stage{ display:grid; grid-template-columns:minmax(0, 1.2fr) minmax(0, 1fr); gap:clamp(24px,5vw,60px); align-items:center; max-width:1080px; margin:0 auto; }
  @media (max-width:820px){ .kdx-cosmo__stage{ grid-template-columns:1fr; } }
  .kdx-cosmo__svg{ width:100%; height:auto; max-width:500px; margin:0 auto; display:block; }
  .kdx-cosmo__label{ font-family:'IBM Plex Mono',ui-monospace,monospace; font-size:10.5px; letter-spacing:.2em; fill:var(--kdx-dust-white,#EDEDED); pointer-events:none; }
  .kdx-cosmo__center{ font-family:'Archivo','Inter Tight',system-ui,sans-serif; font-stretch:125%; font-weight:700;
    letter-spacing:.06em; font-size:11px; fill:var(--kdx-dust-white,#EDEDED); text-transform:uppercase; }
  /* SVG groups otherwise hit-test only their painted descendants. Bounding-box
     makes the authored label + dot area one reliable pointer target without
     changing the visible node geometry or keyboard/touch semantics. */
  .kdx-cosmo__nodes g{ cursor:pointer; outline:none; pointer-events:bounding-box; }
  .kdx-cosmo__nodes g circle{ transition:r .2s, fill .2s; }
  .kdx-cosmo__nodes g:hover circle,
  .kdx-cosmo__nodes g:focus circle,
  .kdx-cosmo__nodes g[aria-pressed="true"] circle,
  .kdx-cosmo__nodes g.is-related circle{ r:9; fill:var(--kdx-magenta,#FF00C8); }
  .kdx-cosmo__nodes g:focus-visible circle{ stroke:var(--kdx-dust-white,#EDEDED); stroke-width:2; }
  .kdx-cosmo__links line{ transition:stroke .2s, stroke-opacity .2s; }

  .kdx-cosmo__concept-list{ display:none; list-style:none; padding:0; margin:0; }
  .kdx-cosmo__concept-list button{ width:100%; min-height:36px; display:flex; align-items:center; justify-content:space-between;
    gap:8px; border:0; border-bottom:1px solid rgba(237,237,237,.12); background:transparent; color:var(--kdx-dust-white,#EDEDED);
    font:700 10px/1.2 'IBM Plex Mono',ui-monospace,monospace; letter-spacing:.16em; text-align:left; }
  .kdx-cosmo__concept-list button span{ color:var(--kdx-magenta,#FF00C8); font-size:8px; letter-spacing:.08em; }
  .kdx-cosmo__concept-list button:focus-visible,
  .kdx-cosmo__concept-list button[aria-pressed="true"],
  .kdx-cosmo__concept-list button.is-related{ outline:1px solid var(--kdx-magenta,#FF00C8); outline-offset:-1px; background:rgba(255,0,200,.08); }

  .kdx-cosmo__portals{ list-style:none; padding:0; margin:0; display:grid; gap:1px;
    background:var(--kdx-line,rgba(237,237,237,.15)); border:1px solid var(--kdx-line,rgba(237,237,237,.15)); }
  .kdx-portal{ background:var(--kdx-black,#0A0A0A); }
  .kdx-portal a{ display:grid; grid-template-columns:1fr auto; gap:8px 16px; padding:14px 18px;
    text-decoration:none; color:var(--kdx-dust-white,#EDEDED); transition:background .2s; }
  .kdx-portal a:hover, .kdx-portal a:focus-visible{ background:var(--kdx-surface,#111113); outline:none; }
  .kdx-portal__eye{ font-family:'Archivo','Inter Tight',system-ui,sans-serif; font-stretch:125%; font-weight:700;
    letter-spacing:.06em; text-transform:uppercase; font-size:13px; }
  .kdx-portal__state{ font-family:'IBM Plex Mono',ui-monospace,monospace; font-size:10px; letter-spacing:.2em; color:var(--kdx-magenta,#FF00C8); align-self:center; }
  .kdx-portal__dom{ grid-column:1 / -1; font-family:'Inter Tight',system-ui,sans-serif; font-size:12px; color:var(--kdx-muted,#88888A); }

  /* Folio V embeds the map inside a viewport-bounded artifact plate. The
     standalone map keeps its editorial spacing; the embedded form must use
     the dimensions of the plate instead of creating a second page inside it. */
  .kx-os-stage__cosmo{ position:absolute; inset:0; z-index:2; width:100%; height:100%; min-width:0; min-height:0; overflow:hidden; }
  .kx-os-stage__cosmo .kdx-cosmo{ width:100%; height:100%; min-height:0; box-sizing:border-box; padding:clamp(8px,1vw,14px); background:transparent;
    display:grid; grid-template-rows:auto minmax(0,1fr); overflow:hidden; }
  .kx-os-stage__cosmo .kdx-cosmo__head{ max-width:none; margin:0 0 6px; text-align:left; }
  .kx-os-stage__cosmo .kdx-cosmo__title{ margin:3px 0 0; font-size:clamp(.86rem,1.35vw,1.18rem); line-height:1; }
  .kx-os-stage__cosmo .kdx-cosmo__lede{ display:none; }
  .kx-os-stage__cosmo .kdx-cosmo__eyebrow{ font-size:8px; }
  .kx-os-stage__cosmo .kdx-cosmo__stage{ width:100%; height:100%; min-height:0; max-width:none; margin:0; gap:clamp(6px,1vw,12px);
    grid-template-columns:minmax(0,1.15fr) minmax(150px,.85fr); align-items:stretch; overflow:hidden; }
  .kx-os-stage__cosmo .kdx-cosmo__svg{ width:100%; height:100%; max-width:100%; max-height:100%; min-height:0; }
  .kx-os-stage__cosmo .kdx-cosmo__portals{ align-self:stretch; overflow:hidden; grid-template-rows:repeat(5,minmax(0,1fr)); }
  .kx-os-stage__cosmo .kdx-portal a{ height:100%; box-sizing:border-box; align-content:center; padding:5px 8px; gap:2px 6px; }
  .kx-os-stage__cosmo .kdx-portal__eye{ font-size:9px; }
  .kx-os-stage__cosmo .kdx-portal__state{ font-size:7px; }
  .kx-os-stage__cosmo .kdx-portal__dom{ font-size:8px; line-height:1.1; }

  /* COSMOLOGY is an instrument panel inside a bounded scene, not another
     scrolling page. Anchor the existing art plate in the measured free zone
     above the corridor navigation so the orbital map is fully inspectable. */
  .kx-os-scene--cosmology .kx-os-stage__art{
    position:absolute;
    right:clamp(18px,4vw,64px);
    bottom:clamp(88px,11vh,110px);
    left:auto;
    width:min(54vw,680px);
    height:min(48vh,420px);
    max-height:none;
    aspect-ratio:auto;
    z-index:6;
  }

  /* Desktop keeps the relation control in the open left field rather than
     inheriting the generic copy-column flow that pushes it below 100dvh.
     This moves presentation only; the existing control, state and relation
     semantics are unchanged. */
  @media (min-width:641px){
    .kx-os-scene--cosmology .kx-cosmo-readout{
      position:absolute;
      left:clamp(36px,4vw,64px);
      top:clamp(292px,34vh,326px);
      z-index:8;
      width:min(300px,24vw);
    }
    .kx-os-scene--cosmology [data-cosmo-next]{
      display:inline-flex;
      position:static;
      margin-top:12px;
      min-height:44px;
    }
  }

  @media (max-width:640px){
    .kx-os-scene--cosmology .kx-os-stage__art{
      position:absolute;
      left:10px;
      right:10px;
      bottom:calc(70px + env(safe-area-inset-bottom));
      width:auto;
      height:min(26svh,220px);
      max-height:none;
      aspect-ratio:auto;
      z-index:6;
    }
    .kx-os-stage__cosmo .kdx-cosmo{ padding:6px 8px; grid-template-rows:auto minmax(0,1fr); }
    .kx-os-stage__cosmo .kdx-cosmo__head{ margin-bottom:4px; }
    .kx-os-stage__cosmo .kdx-cosmo__title{ display:none; }
    .kx-os-stage__cosmo .kdx-cosmo__stage{ grid-template-columns:minmax(0,1fr) minmax(0,.72fr); gap:6px; }
    .kx-os-stage__cosmo .kdx-cosmo__svg{ position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
    .kx-os-stage__cosmo .kdx-cosmo__concept-list{ display:grid; grid-template-columns:1fr 1fr; align-content:start; overflow:hidden; }
    .kx-os-stage__cosmo .kdx-cosmo__concept-list button{ min-height:30px; padding:3px 5px; font-size:7px; letter-spacing:.1em; }
    .kx-os-stage__cosmo .kdx-cosmo__concept-list button span{ display:block; font-size:6px; }
    .kx-os-stage__cosmo .kdx-cosmo__portals{ grid-template-rows:repeat(5,minmax(0,1fr)); }
    .kx-os-stage__cosmo .kdx-portal a{ padding:2px 4px; display:flex; align-items:center; justify-content:space-between; gap:4px; }
    .kx-os-stage__cosmo .kdx-portal__eye{ font-size:6px; letter-spacing:.04em; }
    .kx-os-stage__cosmo .kdx-portal__state{ font-size:5px; letter-spacing:.04em; }
    .kx-os-stage__cosmo .kdx-portal__dom{ display:none; }

    /* The generic copy column places the scene CTA below the first viewport on
       390px devices. Pull only that existing control into the measured gap
       above the compact map; the readout remains in its authored location. */
    .kx-os-scene--cosmology .kx-cosmo-readout{ position:static; }
    .kx-os-scene--cosmology [data-cosmo-next]{
      position:absolute;
      left:12px;
      bottom:calc(82px + min(26svh,220px) + env(safe-area-inset-bottom));
      z-index:8;
    }
  }

  @media (prefers-reduced-motion:reduce){
    .kdx-cosmo__nodes g circle,.kdx-cosmo__links line,.kdx-portal a{ transition:none; }
  }
</style>

<script is:inline>
  (() => {
    const svgNodes = document.querySelectorAll('.kdx-cosmo__nodes [data-node]');
    const listNodes = document.querySelectorAll('.kdx-cosmo__concept-list [data-node]');
    const nodes = [...svgNodes, ...listNodes];
    const links = document.querySelectorAll('.kdx-cosmo__links [data-link]');
    const portals = document.querySelectorAll('.kdx-cosmo__portals [data-organ]');
    if (!nodes.length) return;

    // Concept-to-concept and concept-to-organ relations are separate truths.
    // SIGNAL→MACHINE is a relation between canonical concept nodes; MACHINE is
    // not one of the five ecosystem portals and must not be fabricated as one.
    const organMap = {
      signal: [],
      matter: ['wenumapu'],
      body: ['wenumapu'],
      memory: ['serpent'],
      territory: ['soma'],
      machine: ['practice'],
    };
    const conceptMap = {
      signal: ['machine'],
      matter: [],
      body: [],
      memory: [],
      territory: [],
      machine: [],
    };
    let activeNode = null;
    const paintPressed = (node) => {
      nodes.forEach((control) => {
        const isActive = control.dataset.node === node;
        control.setAttribute('aria-pressed', String(isActive));
        control.classList.toggle('is-related', (conceptMap[node] || []).includes(control.dataset.node));
      });
    };
    const pulse = (node) => {
      activeNode = node;
      const organs = organMap[node] || [];
      paintPressed(node);
      portals.forEach((p) => p.parentElement.classList.toggle('is-pulse', organs.includes(p.dataset.organ)));
      links.forEach((l) => l.setAttribute('stroke', l.dataset.link?.startsWith(node) ? '#FF00C8' : 'rgba(183,112,255,.28)'));
    };
    const clear = () => {
      activeNode = null;
      paintPressed('');
      portals.forEach((p) => p.parentElement.classList.remove('is-pulse'));
      links.forEach((l) => l.setAttribute('stroke', 'rgba(183,112,255,.28)'));
    };
    nodes.forEach((n) => {
      n.setAttribute('aria-pressed', 'false');
      n.addEventListener('mouseenter', () => pulse(n.dataset.node));
      n.addEventListener('mouseleave', () => { if (document.activeElement !== n) clear(); });
      n.addEventListener('focus', () => pulse(n.dataset.node));
      n.addEventListener('blur', clear);
      n.addEventListener('click', () => pulse(n.dataset.node));
      n.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        pulse(n.dataset.node);
      });
    });
    document.addEventListener('pointerdown', (event) => {
      if (!activeNode) return;
      if (event.target instanceof Element && event.target.closest('.kdx-cosmo__nodes [data-node],.kdx-cosmo__concept-list [data-node]')) return;
      clear();
    });
    portals.forEach((p) => p.addEventListener('click', () => {
      try { window.kdx && window.kdx('outbound_' + (p.dataset.organ || 'unknown'), { href: p.getAttribute('href') }); } catch (_) {}
    }));
    const s = document.createElement('style');
    s.textContent = '.kdx-portal.is-pulse a{ background:var(--kdx-surface,#111113); box-shadow:inset 3px 0 0 var(--kdx-magenta,#FF00C8); }';
    document.head.appendChild(s);
  })();
</script>