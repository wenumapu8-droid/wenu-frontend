---
// KODEX−∞ · COSMOLOGY MAP (§3 storyboard 05, §6 organs).
// Orbital map: 6 concept nodes around KODEX center, 5 organs on outer ring
// as portals to the wider Wenu ecosystem. Hover a concept → its organ pulses.
// Non-blocking: falls back to a legible list layout on <640px.
---
<section class="kdx-cosmo" aria-labelledby="kdx-cosmo-title">
  <header class="kdx-cosmo__head">
    <span class="kdx-cosmo__eyebrow">◐ COSMOLOGY · MAP</span>
    <h2 class="kdx-cosmo__title" id="kdx-cosmo-title">the system beneath the system</h2>
    <p class="kdx-cosmo__lede">
      Nothing here stands alone. Signal becomes matter, matter becomes body,
      body becomes memory. Each concept is a doorway to a working part of the
      wider Wenu ecosystem — jewelry, biology, artifacts, DNA, practice.
    </p>
  </header>

  <div class="kdx-cosmo__stage">
    <svg class="kdx-cosmo__svg" viewBox="0 0 500 500" role="img" aria-labelledby="kdx-cosmo-svg-title" preserveAspectRatio="xMidYMid meet">
      <title id="kdx-cosmo-svg-title">KODEX cosmology map — 6 concept nodes orbit the codex, connected to 5 living systems.</title>
      <defs>
        <radialGradient id="kdx-cosmo-core" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#FF00C8" stop-opacity=".28" />
          <stop offset="60%" stop-color="#0A0A0A" stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle cx="250" cy="250" r="220" fill="url(#kdx-cosmo-core)" />
      <circle cx="250" cy="250" r="150" fill="none" stroke="rgba(237,237,237,.12)" stroke-dasharray="2 6" />
      <circle cx="250" cy="250" r="220" fill="none" stroke="rgba(237,237,237,.08)" stroke-dasharray="1 4" />

      <g class="kdx-cosmo__links" stroke="rgba(183,112,255,.28)" stroke-width="1" fill="none">
        <line x1="250" y1="250" x2="250" y2="100" data-link="signal-machine" />
        <line x1="250" y1="250" x2="380" y2="175" data-link="matter-wenumapu" />
        <line x1="250" y1="250" x2="380" y2="325" data-link="body-wenumapu" />
        <line x1="250" y1="250" x2="250" y2="400" data-link="memory-serpent" />
        <line x1="250" y1="250" x2="120" y2="325" data-link="territory-soma" />
        <line x1="250" y1="250" x2="120" y2="175" data-link="machine-kodex" />
      </g>

      <g class="kdx-cosmo__nodes">
        <g data-node="signal" transform="translate(250 100)">
          <circle r="6" fill="#B770FF" />
          <text y="-14" text-anchor="middle" class="kdx-cosmo__label">SIGNAL</text>
        </g>
        <g data-node="matter" transform="translate(380 175)">
          <circle r="6" fill="#B770FF" />
          <text y="-14" text-anchor="middle" class="kdx-cosmo__label">MATTER</text>
        </g>
        <g data-node="body" transform="translate(380 325)">
          <circle r="6" fill="#B770FF" />
          <text y="22" text-anchor="middle" class="kdx-cosmo__label">BODY</text>
        </g>
        <g data-node="memory" transform="translate(250 400)">
          <circle r="6" fill="#B770FF" />
          <text y="22" text-anchor="middle" class="kdx-cosmo__label">MEMORY</text>
        </g>
        <g data-node="territory" transform="translate(120 325)">
          <circle r="6" fill="#B770FF" />
          <text y="22" text-anchor="middle" class="kdx-cosmo__label">TERRITORY</text>
        </g>
        <g data-node="machine" transform="translate(120 175)">
          <circle r="6" fill="#B770FF" />
          <text y="-14" text-anchor="middle" class="kdx-cosmo__label">MACHINE</text>
        </g>
      </g>

      <g class="kdx-cosmo__core">
        <circle cx="250" cy="250" r="24" fill="#0A0A0A" stroke="#EDEDED" stroke-width="1" />
        <text x="250" y="256" text-anchor="middle" class="kdx-cosmo__center">KODEX ∞</text>
      </g>
    </svg>

    <ol class="kdx-cosmo__portals" role="list" aria-label="ecosystem portals">
      <li class="kdx-portal">
        <a href="/" data-organ="wenumapu">
          <span class="kdx-portal__eye">◈ WENU MAPU</span>
          <span class="kdx-portal__dom">body · jewelry · piercing · ritual technology</span>
          <span class="kdx-portal__state">MANIFESTED</span>
        </a>
      </li>
      <li class="kdx-portal">
        <a href="mailto:marimari@wenumapuonline.com?subject=SOMA · inquiry" data-organ="soma">
          <span class="kdx-portal__eye">◈ SOMA</span>
          <span class="kdx-portal__dom">biology · fungi · inner change · consciousness</span>
          <span class="kdx-portal__state">EXCAVATION</span>
        </a>
      </li>
      <li class="kdx-portal">
        <a href="mailto:marimari@wenumapuonline.com?subject=DISCO SOLAR · inquiry" data-organ="disco">
          <span class="kdx-portal__eye">◈ DISCO SOLAR</span>
          <span class="kdx-portal__dom">speculative artifacts · WebAR · spirit interfaces</span>
          <span class="kdx-portal__state">TRANSMUTATION</span>
        </a>
      </li>
      <li class="kdx-portal">
        <a href="mailto:marimari@wenumapuonline.com?subject=COSMIC SERPENT · inquiry" data-organ="serpent">
          <span class="kdx-portal__eye">◈ COSMIC SERPENT</span>
          <span class="kdx-portal__dom">DNA · cycles · the unconscious · archetypes</span>
          <span class="kdx-portal__state">LATENT</span>
        </a>
      </li>
      <li class="kdx-portal">
        <a href="/kodex/" data-organ="practice">
          <span class="kdx-portal__eye">◈ PRACTICE</span>
          <span class="kdx-portal__dom">research · art direction · UX/UI · 3D · systems</span>
          <span class="kdx-portal__state">ACTIVE</span>
        </a>
      </li>
    </ol>
  </div>
</section>

<style is:global>
  .kdx-cosmo{ background:var(--kdx-black,#0A0A0A); color:var(--kdx-dust-white,#EDEDED);
    padding:clamp(40px,7vh,80px) clamp(16px,5vw,64px);
    font-family:'Inter Tight','Instrument Sans',system-ui,sans-serif; }
  .kdx-cosmo__head{ max-width:60ch; margin:0 auto clamp(28px,5vh,52px); text-align:center; }
  .kdx-cosmo__eyebrow{ font-family:'IBM Plex Mono',ui-monospace,monospace; font-size:11px; letter-spacing:.24em; color:var(--kdx-magenta,#FF00C8); }
  .kdx-cosmo__title{ font-family:'Archivo','Inter Tight',system-ui,sans-serif; font-stretch:125%; font-weight:700;
    letter-spacing:.02em; text-transform:uppercase; font-size:clamp(1.4rem,3.5vw,2.2rem); margin:10px 0; }
  .kdx-cosmo__lede{ font-size:14px; line-height:1.6; color:var(--kdx-muted,#88888A); margin:0; }
  .kdx-cosmo__stage{ display:grid; grid-template-columns:minmax(0, 1.2fr) minmax(0, 1fr); gap:clamp(24px,5vw,60px); align-items:center; max-width:1080px; margin:0 auto; }
  @media (max-width:820px){ .kdx-cosmo__stage{ grid-template-columns:1fr; } }
  .kdx-cosmo__svg{ width:100%; height:auto; max-width:500px; margin:0 auto; display:block; }
  .kdx-cosmo__label{ font-family:'IBM Plex Mono',ui-monospace,monospace; font-size:10.5px; letter-spacing:.2em; fill:var(--kdx-dust-white,#EDEDED); }
  .kdx-cosmo__center{ font-family:'Archivo','Inter Tight',system-ui,sans-serif; font-stretch:125%; font-weight:700;
    letter-spacing:.06em; font-size:11px; fill:var(--kdx-dust-white,#EDEDED); text-transform:uppercase; }
  .kdx-cosmo__nodes g{ cursor:default; transition:transform .2s; }
  .kdx-cosmo__nodes g:hover circle{ r:9; fill:var(--kdx-magenta,#FF00C8); }
  .kdx-cosmo__links line{ transition:stroke .2s, stroke-opacity .2s; }

  .kdx-cosmo__portals{ list-style:none; padding:0; margin:0; display:grid; gap:1px;
    background:var(--kdx-line,rgba(237,237,237,.15)); border:1px solid var(--kdx-line,rgba(237,237,237,.15)); }
  .kdx-portal{ background:var(--kdx-black,#0A0A0A); }
  .kdx-portal a{ display:grid; grid-template-columns:1fr auto; gap:8px 16px; padding:14px 18px;
    text-decoration:none; color:var(--kdx-dust-white,#EDEDED); transition:background .2s; }
  .kdx-portal a:hover, .kdx-portal a:focus-visible{ background:var(--kdx-surface,#111113); outline:none; }
  .kdx-portal__eye{ font-family:'Archivo','Inter Tight',system-ui,sans-serif; font-stretch:125%; font-weight:700;
    letter-spacing:.06em; text-transform:uppercase; font-size:13px; }
  .kdx-portal__state{ font-family:'IBM Plex Mono',ui-monospace,monospace; font-size:10px; letter-spacing:.2em; color:var(--kdx-magenta,#FF00C8); align-self:center; }
  .kdx-portal__dom{ grid-column:1 / -1; font-family:'Inter Tight',system-ui,sans-serif; font-size:12px; color:var(--kdx-muted,#88888A); }
</style>

<script is:inline>
  (() => {
    const nodes = document.querySelectorAll('.kdx-cosmo__nodes [data-node]');
    const links = document.querySelectorAll('.kdx-cosmo__links [data-link]');
    const portals = document.querySelectorAll('.kdx-cosmo__portals [data-organ]');
    if (!nodes.length) return;
    const map = {
      signal: ['machine'],
      matter: ['wenumapu'],
      body: ['wenumapu'],
      memory: ['serpent'],
      territory: ['soma'],
      machine: ['practice'],
    };
    const pulse = (node) => {
      const organs = map[node] || [];
      portals.forEach((p) => p.parentElement.classList.toggle('is-pulse', organs.includes(p.dataset.organ)));
      links.forEach((l) => l.setAttribute('stroke', l.dataset.link?.startsWith(node) ? '#FF00C8' : 'rgba(183,112,255,.28)'));
    };
    const clear = () => {
      portals.forEach((p) => p.parentElement.classList.remove('is-pulse'));
      links.forEach((l) => l.setAttribute('stroke', 'rgba(183,112,255,.28)'));
    };
    nodes.forEach((n) => {
      n.addEventListener('mouseenter', () => pulse(n.dataset.node));
      n.addEventListener('mouseleave', clear);
    });
    portals.forEach((p) => p.addEventListener('click', () => {
      try { window.kdx && window.kdx('outbound_' + (p.dataset.organ || 'unknown'), { href: p.getAttribute('href') }); } catch (_) {}
    }));
    const s = document.createElement('style');
    s.textContent = '.kdx-portal.is-pulse a{ background:var(--kdx-surface,#111113); box-shadow:inset 3px 0 0 var(--kdx-magenta,#FF00C8); }';
    document.head.appendChild(s);
  })();
</script>
