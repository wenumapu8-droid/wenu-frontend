---
/**
 * KODEX-∞ · t01-02 · BLOQUE CENTRO
 * 04. OBSERVATION EYE / CORE INTERFACE  ·  07. OBSERVATION LOGS
 * 08. SHADER LOGIC (izquierda del panel)  ·  tira de 05/06 que cae dentro de la caja
 *
 * Caja del bloque: ref (468,88) 712×778. TODO acá es LOCAL a esa caja:
 * a cualquier coordenada de la referencia restarle 468 en x y 88 en y.
 *
 * ── Lo medido (perfiles de tinta sobre reference/canon/t01-02-observation-eye.png)
 *
 * El andamiaje parte en x=1180, que NO es un marco: el marco real de la banda
 * derecha está en x=1122. Por eso este bloque termina con 58 px de los paneles
 * 05 y 06 adentro. Se dibujan acá porque el vecino no puede alcanzarlos sin
 * salirse de su caja.
 *
 *   marcos      04: x 468→1113 · y 93→579      (regla de título y 118)
 *               07: x 468→828  · y 584→844     (regla de título y 608)
 *               08: x 837→…    · y 584→844     (regla de título y 607)
 *               05: x 1122→…   · y 93→319      06: x 1122→… · y 336→579
 *   regla SUBJECT  y 551, ancho completo del panel 04
 *   HUD izquierdo  barra en x 481; rótulo x 490; valor x 490
 *                  grupos (tope de caja alta del rótulo): 151 · 206 · 259 ·
 *                  409 · 462 · 514 — hay un HUECO en el medio: el ojo se come
 *                  la franja 290-400 y ahí no hay rótulos.
 *   HUD derecho    mismas filas, x 1055/1062/1067 según largo del rótulo
 *   chips          ojo x 970→1017 y 103→138 (violeta) · OBSERVE MODE
 *                  x 1026→1103 y 103→137 (marco gris, ACTIVE en cian)
 *
 * ── El ojo
 *
 * Centro en (816, 341) = local (348, 253). Salió del cruce de la columna y la
 * fila de mayor energía; NO es el centro de la caja (322, 243). Correrlo al
 * medio mueve las veinte coronas a la vez.
 *
 * El organismo no se dibuja «a ojo»: se dibuja contra el PERFIL RADIAL MEDIDO
 * (`PERFIL`, luminancia media por radio, 0..360 px, excluyendo ±14° de la
 * horizontal para que la raya de barrido no contamine el promedio). Cada capa
 * —filamentos, coronas, anillos de datos— toma su alfa de ese perfil. Eso es
 * lo que hace que el diff estructural por bloques de 8×8 cierre: la media de
 * cada anillo es la de la referencia por construcción, no por tanteo.
 *
 * Hitos del perfil, que son los que se ven:
 *   r 9-23    pupila negra (lum 5-11)
 *   r 24-44   collar quemado, pico en r=33 (88)
 *   r 45-67   valle de fibra media (22-43)
 *   r 68-77   anillo limbal, pico en r=72 (106) — el más brillante del ojo
 *   r 78-135  filamento largo, cae 63 → 8
 *   r 136-245 anillos de datos, crestas en 143 · 159 · 168 · 189 · 214 · 225
 *   r 246-360 coronas exteriores tenues (5-11)
 *
 * La raya de barrido es aparte: fila 341 con media 110 sobre TODO el ancho del
 * panel, halo de 326 a 352. Es lo que le da al panel su eje.
 *
 * ── Reglas de la casa que se respetaron
 *
 * · Cero imágenes: un solo <canvas> pinta ojo, códigos de barras, miniaturas,
 *   ondas y sello; el cromo y la tipografía van en HTML.
 * · El código de barras se lee COLUMNA POR COLUMNA (`BARRAS`), no se traza con
 *   contornos — el contorno le inventa esquinas y pierde tinta.
 * · Todos los números son ficción del póster: los contenedores llevan
 *   data-symbolic="true".
 * · El panel es estático a propósito, pero registra __kdxRegisterFreeze porque
 *   es el contrato de la página.
 */
import { rng } from "../kit/rng";

interface Props { box: string }
const { box } = Astro.props;

/* ══ HUD ═══════════════════════════════════════════════════════════════════
   [rótulo, valor, y del rótulo, y del valor, x, barra?] — coordenadas locales. */
const HUD_IZQ = [
  ["AZIMUTH", "180.00°", 63, 75, 59],
  ["ELEVATION", "+00.42°", 118, 129, 114],
  ["ZOOM", "x 3.75", 171, 182, 167],
  ["FOCUS", "MANUAL", 321, 335, 317],
  ["IRIS", "AUTO", 374, 388, 371],
  ["APERTURE", "f/2.8", 426, 438, 421],
] as const;

const HUD_DER = [
  ["SIGNAL", "STR 87%", 63, 75, 599, 59],
  ["NOISE", "LOW", 118, 129, 599, 114],
  ["SYNC", "LOCKED", 172, 184, 599, 168],
  ["RESOLUTION", "4096 x 1728", 324, 337, 584, 0],
  ["BIT DEPTH", "16-BIT", 376, 389, 594, 372],
  ["COLOR SPACE", "ACEScg", 426, 439, 584, 422],
] as const;

/* ══ 07. OBSERVATION LOGS ══════════════════════════════════════════════════ */
const LOG_COLS = [14, 89, 192, 306];          /* x local de cada columna */
const LOGS = [
  ["00:00:01.12", "SIGNAL ACQUIRED", "WEAK PATTERN DETECTED", "72%", "ojo", "#9a9a98"],
  ["00:00:02.08", "FOCUS ADJUST", "ZOOM + CALIBRATION", "81%", "onda", "#9a9a98"],
  ["00:00:03.21", "PATTERN MATCH", "K-X-07 / PARTIAL", "91%", "mira", "#9a9a98"],
  ["00:00:04.17", "THREAT EVAL", "LEVEL C-4 CONFIRMED", "98%", "craneo", "#b6b6b4"],
  ["00:00:05.02", "TRACKING", "SUBJECT MOVEMENT LOCK", "87%", "rosa", "#9a9a98"],
  ["00:00:06.11", "ANOMALY", "GLITCH SPIKE DETECTED", "65%", "estrella", "#b4342a"],
  ["00:00:07.09", "SIGNAL STABILIZED", "LINK INTEGRITY NOMINAL", "93%", "nodo", "#159fae"],
] as const;

/* ══ 08. SHADER LOGIC ══════════════════════════════════════════════════════
   [palabra clave, cuerpo] — cuerpo vacío = renglón de separación (la pastilla
   redondeada que la referencia usa como línea en blanco). */
const CODIGO = [
  ["float", "scan = sin(_Time.y * SCAN_SPEED);"],
  ["float", "pulse = smoothstep(0.2, 0.8, abs(sin(_Time.y * PULSE_SPEED)));"],
  ["float", "noise = tex3D(_NoiseTex, uv * NOISE_SCALE + _Time.y).r;"],
  ["float", "iris = length(uv - 0.5);"],
  ["float", "ring = smoothstep(IRIS_INNER, IRIS_OUTER, iris);"],
  ["float", "glitch = step(0.995, noise) * rand(uv + _Time.y);"],
  ["", ""],
  ["float", "intensity = (1.0 - ring) * (0.6 + pulse * 0.4);"],
  ["float", "scanLine = step(frac(uv.y * SCAN_DENSITY + scan), 0.02);"],
  ["float", "color = lerp(COLOR_BASE, COLOR_HIGHLIGHT, intensity);"],
  ["color", "+= scanLine * COLOR_SCAN;"],
  ["color", "+= glitch * COLOR_GLITCH;"],
  ["", ""],
  ["return", "float4(color, 1.0);"],
] as const;

const UNIFORMES = [
  ["SCAN_SPEED", "1.25", 389, 398],
  ["PULSE_SPEED", "2.40", 455, 467],
  ["SCAN_DENSITY", "1024.0", 531, 537],
  ["IRIS_INNER", "0.12", 607, 619],
  ["NOISE_SCALE", "2.75", 670, 682],
] as const;

/* ══ 06. SIGNAL WAVEFORMS — la tira que cae dentro de esta caja ═══════════ */
const ONDAS = [
  ["VISUAL SIGNAL", 282, 42, "#8a4fb8", 0x51a3],
  ["NEURAL FEED", 325, 44, "#0f97a4", 0x77c1],
  ["ENERGY FIELD", 370, 45, "#763a9a", 0x2e05],
  ["SPECTRAL RANGE", 416, 63, "#8a4fb8", 0x64bb],
] as const;

/* Semillas fijas para el micro-detalle del cromo (regla de determinismo). */
const rTicks = rng(0x0402);
const TICKS_04 = Array.from({ length: 26 }, () => ({
  x: Math.round(6 + rTicks() * 632),
  w: 1 + Math.round(rTicks() * 3),
}));
---

<div data-box style={box} class="oe4">
  <canvas class="oe4__lienzo" width="712" height="778" aria-hidden="true"></canvas>

  <!-- ══ 04. OBSERVATION EYE ══════════════════════════════════════════ -->
  <i class="oe4__marco oe4__marco--p04" aria-hidden="true"></i>
  <i class="oe4__regla" style="left:0;top:30px;width:645px" aria-hidden="true"></i>
  <i class="oe4__regla oe4__regla--sub" style="left:0;top:463px;width:645px" aria-hidden="true"></i>
  <p class="oe4__tit oe4__tit--hero" style="left:10px;top:13px">04. OBSERVATION EYE / CORE INTERFACE</p>
  {TICKS_04.map((t) => (
    <i class="oe4__tick" style={`left:${t.x}px;top:5px;width:${t.w}px`} aria-hidden="true"></i>
  ))}

  <!-- chip del ojo -->
  <i class="oe4__caja oe4__caja--ojo" aria-hidden="true"></i>
  <svg class="oe4__ico-ojo" viewBox="0 0 40 26" aria-hidden="true">
    <path d="M2 13C8 3.4 32 3.4 38 13C32 22.6 8 22.6 2 13Z" fill="none" stroke="currentColor" stroke-width="1.15" />
    <circle cx="20" cy="13" r="6.4" fill="none" stroke="currentColor" stroke-width="1.15" />
    <circle cx="20" cy="13" r="2.5" fill="currentColor" opacity="0.85" />
    <path d="M20 3.2V0.6M20 25.4V23M6.5 20.6L4.8 22.4M33.5 20.6L35.2 22.4" stroke="currentColor" stroke-width="0.7" opacity="0.55" />
    <path d="M9 19.5C13 22 27 22 31 19.5" stroke="currentColor" stroke-width="0.55" opacity="0.4" fill="none" stroke-dasharray="1.6 1.8" />
  </svg>

  <!-- chip OBSERVE MODE -->
  <i class="oe4__caja oe4__caja--modo" aria-hidden="true"></i>
  <p class="oe4__modo">OBSERVE MODE</p>
  <p class="oe4__modo oe4__modo--on">ACTIVE &#8722;</p>

  <!-- HUD -->
  <div class="oe4__hud" data-symbolic="true">
    {HUD_IZQ.map(([rot, val, yr, yv, yb]) => (
      <>
        <i class="oe4__barra" style={`left:13px;top:${yb}px`}></i>
        <p class="oe4__rot" style={`left:22px;top:${yr - 1}px`}>{rot}</p>
        <p class="oe4__val" style={`left:22px;top:${yv - 1.5}px`}>{val}</p>
      </>
    ))}
    {HUD_DER.map(([rot, val, yr, yv, x, yb]) => (
      <>
        {yb > 0 && <i class="oe4__barra" style={`left:583px;top:${yb}px`}></i>}
        <p class="oe4__rot" style={`left:${x}px;top:${yr - 1}px`}>{rot}</p>
        <p class={val.length > 8 ? "oe4__val oe4__val--largo" : "oe4__val"} style={`left:${x}px;top:${yv - 1.5}px`}>{val}</p>
      </>
    ))}
  </div>

  <!-- fila SUBJECT -->
  <div class="oe4__subj" data-symbolic="true">
    <p class="oe4__val" style="left:11px;top:470.5px">SUBJECT:</p>
    <p class="oe4__val oe4__val--fuerte" style="left:66px;top:470.5px">UNKNOWN</p>
    <i class="oe4__regla oe4__regla--corta" style="left:150px;top:476px;width:16px"></i>
    <p class="oe4__val oe4__val--tenue" style="left:457px;top:470.5px">OBS LOG:</p>
    <p class="oe4__val oe4__val--tenue" style="left:515px;top:470.5px">000047.22</p>
  </div>

  <!-- ══ 07. OBSERVATION LOGS ═════════════════════════════════════════ -->
  <i class="oe4__marco oe4__marco--p07" aria-hidden="true"></i>
  <i class="oe4__regla" style="left:0;top:520px;width:361px" aria-hidden="true"></i>
  <p class="oe4__tit" style="left:10px;top:503px">07. OBSERVATION LOGS</p>
  <div class="oe4__tabla" data-symbolic="true">
    {LOG_COLS.slice(1).map((x) => (
      <i class="oe4__vsep" style={`left:${x - 9}px;top:527px;height:224px`}></i>
    ))}
    <p class="oe4__rot" style="left:14px;top:529px">TIMECODE</p>
    <p class="oe4__rot" style="left:89px;top:529px">EVENT</p>
    <p class="oe4__rot" style="left:192px;top:529px">DETAILS</p>
    <p class="oe4__rot" style="left:306px;top:529px">CONFIDENCE</p>
    <i class="oe4__regla oe4__regla--fina" style="left:8px;top:542px;width:345px"></i>
    {LOGS.map(([tc, ev, det, conf], i) => (
      <>
        <p class="oe4__log oe4__log--tc" style={`left:32px;top:${549.5 + i * 22.05}px`}>{tc}</p>
        <p class="oe4__log" style={`left:89px;top:${549.5 + i * 22.05}px`}>{ev}</p>
        <p class="oe4__log" style={`left:192px;top:${549.5 + i * 22.05}px`}>{det}</p>
        <p class="oe4__log oe4__log--pct" style={`left:329px;top:${549.5 + i * 22.05}px`}>{conf}</p>
        {i < 6 && <i class="oe4__hair" style={`top:${565.7 + i * 22.05}px`}></i>}
      </>
    ))}
  </div>

  <!-- ══ 08. SHADER LOGIC ═════════════════════════════════════════════ -->
  <i class="oe4__marco oe4__marco--p08" aria-hidden="true"></i>
  <i class="oe4__regla" style="left:369px;top:519px;width:343px" aria-hidden="true"></i>
  <p class="oe4__tit" style="left:379px;top:503px">08. SHADER LOGIC (PSEUDO-CODE)</p>
  <div class="oe4__cod" data-symbolic="true">
    {CODIGO.map(([kw, cuerpo], i) => (
      kw === ""
        ? <i class="oe4__nula" style={`top:${529.5 + i * 12.35}px`}></i>
        : <>
            <p class="oe4__kw" style={`left:379px;top:${527 + i * 12.35}px`}>{kw}</p>
            <p class="oe4__src" style={`left:418px;top:${527 + i * 12.35}px`}>{cuerpo}</p>
          </>
    ))}
    <i class="oe4__regla oe4__regla--fina" style="left:369px;top:703px;width:343px"></i>
    <p class="oe4__rot oe4__rot--big" style="left:379px;top:709px">UNIFORMS</p>
    {UNIFORMES.map(([nom, val, xn, xv], i) => (
      <>
        {i > 0 && <i class="oe4__vsep" style={`left:${xn - 12}px;top:720px;height:32px`}></i>}
        <p class="oe4__rot oe4__rot--uni" style={`left:${xn}px;top:721px`}>{nom}</p>
        <p class="oe4__val" style={`left:${xv}px;top:737px`}>{val}</p>
      </>
    ))}
  </div>

  <!-- ══ tira de 05 / 06 que cae dentro de esta caja ══════════════════ -->
  <div class="oe4__tira" data-symbolic="true">
    <i class="oe4__marco oe4__marco--p05" aria-hidden="true"></i>
    <i class="oe4__regla" style="left:654px;top:28px;width:58px"></i>
    <p class="oe4__tit" style="left:664px;top:13px">05. EYE FRAGMENTS &#38; TREATMENT CROPS</p>
    <i class="oe4__crop" style="top:41px;height:70px"></i>
    <p class="oe4__rot oe4__rot--crop" style="left:674px;top:130px">HALFTONE</p>
    <i class="oe4__crop" style="top:147px;height:77px"></i>

    <i class="oe4__marco oe4__marco--p06" aria-hidden="true"></i>
    <i class="oe4__regla" style="left:654px;top:270px;width:58px"></i>
    <p class="oe4__tit" style="left:664px;top:255px">06. SIGNAL WAVEFORMS / SPECTRAL READOUT</p>
    {ONDAS.map(([rot, y, h, col]) => (
      <>
        <i class="oe4__ondabox" style={`top:${y}px;height:${h}px`}></i>
        <p class="oe4__rot" style={`left:668px;top:${y + 8}px;color:${col}`}>{rot}</p>
      </>
    ))}
  </div>
</div>

<style>
  .oe4 {
    position: absolute;
    overflow: hidden;
    background: #000;
    font-family: var(--lam-mono, ui-monospace, "SF Mono", Menlo, Consolas, monospace);
    line-height: 1;
    letter-spacing: 0;
    color: #6f6c68;
    --pu: #a45fd8;
    --tit: #a05fce;
  }
  .oe4 i, .oe4 p, .oe4 svg, .oe4 canvas { position: absolute; }
  .oe4 p { margin: 0; white-space: nowrap; }
  .oe4 > div i, .oe4 > div p { position: absolute; }
  .oe4__lienzo { left: 0; top: 0; width: 712px; height: 778px; }

  /* ── cromo ─────────────────────────────────────────────────────────── */
  .oe4__marco { border: 1px solid #201f20; box-sizing: border-box; }
  .oe4__marco--p04 { left: 0; top: 5px; width: 645px; height: 486px; border-color: #232224; }
  .oe4__marco--p07 { left: 0; top: 496px; width: 361px; height: 261px; border-color: #1e1e1d; }
  .oe4__marco--p08 { left: 369px; top: 496px; width: 343px; height: 261px; border-color: #1e1e1d; border-right: 0; }
  .oe4__marco--p05 { left: 654px; top: 5px; width: 58px; height: 227px; border-color: #232224; border-right: 0; }
  .oe4__marco--p06 { left: 654px; top: 248px; width: 58px; height: 243px; border-color: #232224; border-right: 0; }

  .oe4__regla { height: 1px; background: #17161a; }
  .oe4__regla--sub { background: #131315; }
  .oe4__regla--fina { background: #131213; }
  .oe4__regla--corta { background: #4a4a4a; }
  .oe4__tick { top: 5px; height: 1px; background: #2c2a2f; }
  .oe4__hair { left: 8px; width: 345px; height: 1px; background: #090909; }
  .oe4__vsep { width: 1px; background: #0d0c0e; }

  /* ── tipografía ────────────────────────────────────────────────────────
     El póster no usa una monoespaciada real: los avances medidos (6,8 px en
     títulos, 5,0 en rótulos, 6,4 en valores) no se corresponden con la altura
     de caja de ninguna mono del sistema. Se fija el AVANCE, que es lo que se
     ve, con letter-spacing negativo. */
  .oe4__tit {
    font-size: 12.4px; letter-spacing: -0.66px; color: var(--tit);
  }
  /* El título del héroe va un pelo más apretado que los de sección: medido,
     6,54 px de avance contra 6,95. */
  .oe4__tit--hero { letter-spacing: -0.97px; }
  .oe4__rot {
    font-size: 9.6px; letter-spacing: -1.22px; color: #6d706e;
  }
  .oe4__rot--uni { color: #7a7d7b; font-size: 10.2px; letter-spacing: -1.17px; }
  .oe4__rot--big { font-size: 11px; letter-spacing: -1.05px; }
  .oe4__rot--crop { font-size: 10.2px; letter-spacing: -1.05px; color: #8f8f8d; }
  .oe4__val {
    font-size: 11.4px; letter-spacing: -0.95px; color: #909292;
  }
  .oe4__val--fuerte { color: #a6a8a8; }
  .oe4__val--tenue { color: #7d7f7f; }
  .oe4__val--largo { font-size: 10.4px; letter-spacing: -0.72px; }

  .oe4__barra { width: 1px; height: 32px; background: #45444a; }

  /* ── chips ─────────────────────────────────────────────────────────── */
  .oe4__caja { box-sizing: border-box; }
  .oe4__caja--ojo { left: 502px; top: 15px; width: 48px; height: 35px; border: 1px solid #5e2c8a; }
  .oe4__ico-ojo { left: 506px; top: 20px; width: 40px; height: 26px; color: #8544b0; }
  .oe4__caja--modo { left: 558px; top: 15px; width: 78px; height: 35px; border: 1px solid #4e4e4e; }
  .oe4__modo {
    left: 566px; top: 22.5px;
    font-size: 9.4px; letter-spacing: -0.32px; color: #8259a6;
  }
  .oe4__modo--on { top: 34.5px; color: #10a89c; }

  /* ── 07 ────────────────────────────────────────────────────────────── */
  .oe4__log {
    font-size: 9.9px; letter-spacing: -0.86px; color: #625f5c;
  }
  .oe4__log--tc { font-size: 9.2px; letter-spacing: -1.62px; color: #5f5e5c; }
  .oe4__log--pct { color: #858481; font-size: 10.6px; letter-spacing: -0.09px; }

  /* ── 08 ────────────────────────────────────────────────────────────── */
  .oe4__kw { font-size: 9.6px; letter-spacing: -1.24px; color: #563d68; }
  .oe4__src { font-size: 9.6px; letter-spacing: -1.24px; color: #4c4b4d; }
  .oe4__nula {
    left: 379px; width: 15px; height: 6px;
    border: 1px solid #3d3b3e; border-radius: 3px;
  }

  /* ── tira 05 / 06 ──────────────────────────────────────────────────── */
  .oe4__crop { left: 661px; width: 51px; border: 1px solid #2b2830; box-sizing: border-box; }
  .oe4__ondabox { left: 660px; width: 52px; border: 1px solid #241f2a; box-sizing: border-box; }
</style>

<script>
  /* ══════════════════════════════════════════════════════════════════════
     PERFIL RADIAL MEDIDO del ojo de la referencia (luminancia media por radio,
     0..360 px, excluyendo ±14° de la horizontal). Es el contrato entre este
     dibujo y el póster: cada capa toma su alfa de acá.
     ══════════════════════════════════════════════════════════════════════ */
  const PERFIL = [
    0, 73.8, 45.7, 29.6, 29.3, 21.6, 29.9, 25.7, 17.7, 6.3, 4.8, 5.1, 5.0, 5.5,
    5.8, 6.2, 6.8, 8.3, 9.2, 10.6, 10.9, 11.3, 11.5, 9.1, 19.1, 41.2, 53.6, 46.6,
    43.0, 46.0, 49.7, 62.5, 80.9, 87.7, 80.1, 73.1, 69.8, 63.6, 55.9, 54.1, 52.5,
    50.0, 50.5, 53.8, 53.5, 39.3, 37.7, 36.4, 37.2, 39.0, 40.8, 43.7, 43.2, 37.9,
    34.4, 29.8, 29.4, 25.3, 21.9, 21.7, 26.0, 27.4, 27.3, 29.1, 25.2, 22.1, 27.8,
    40.1, 57.8, 73.8, 86.3, 95.6, 105.6, 104.9, 89.1, 78.6, 74.9, 70.8, 58.4,
    54.7, 56.9, 56.3, 55.3, 56.6, 57.4, 59.1, 60.4, 60.7, 60.2, 62.8, 63.2, 60.8,
