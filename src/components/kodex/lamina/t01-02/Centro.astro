    7.8, 7.0, 11.0, 14.9, 13.9, 9.4, 6.7, 6.2, 6.4, 4.8, 3.2, 4.2, 5.0, 4.6, 4.7,
    7.4, 8.1, 7.9, 8.3, 6.7, 7.1, 8.3, 7.6, 6.8, 8.1, 7.8, 10.8, 15.2, 17.3, 16.5,
    10.9, 8.2, 8.8, 8.8, 8.9, 9.2, 10.1, 14.0, 14.3, 14.9, 15.4, 11.1, 8.0, 7.0,
    6.6, 6.4, 7.2, 7.6, 7.0, 5.6, 5.6, 6.3, 7.5, 9.0, 8.8, 8.2, 9.3, 8.4, 7.4,
    4.4, 4.6, 4.4, 3.8, 4.0, 4.4, 4.7, 5.5, 5.1, 5.3, 5.7, 5.2, 5.4, 5.6, 5.8,
    6.1, 6.0, 6.2, 6.5, 6.6, 6.9, 6.8, 6.6, 7.0, 6.6, 6.8, 6.2, 5.8, 5.6, 6.6,
    6.4, 7.0, 7.9, 7.7, 6.4, 5.9, 5.5, 6.4, 6.2, 5.8, 6.7, 6.5, 6.4, 6.3, 6.4,
    6.0, 5.5, 7.1, 7.0, 5.4, 6.6, 7.0, 6.5, 5.9, 5.5, 5.9, 6.4, 6.8, 6.5, 6.6,
    6.1, 5.9, 6.5, 5.6, 6.3, 6.5, 6.1, 5.9, 7.3, 7.1, 7.4, 6.8, 7.3, 7.0, 6.5,
    7.2, 7.9, 7.2, 8.2, 8.3, 8.4, 7.1, 7.8, 9.5, 7.4, 6.6, 7.4, 9.4, 11.2, 10.7,
    9.1, 9.3, 8.9, 7.8, 9.5, 9.6, 9.2, 10.6, 9.0, 9.6, 9.4, 10.0, 11.3, 11.4, 9.3,
    9.9, 10.7, 10.7, 9.5, 9.2, 10.7, 10.2, 9.0, 7.8, 8.7, 7.9,
  ];

  /* Código de barras leído COLUMNA POR COLUMNA de la referencia (x 636→810,
     y 555→574). Con vtracer el contorno inventa esquinas y pierde ~38 % de la
     tinta; por eso va como cadena de bits y no como trazo. */
  const BARRAS =
    "000000000011100110110111111110010100111110011011011011111101111111111001011011101001101101101110011011011001111101011011111111101111101111111111110110111111101001100000000000";

  /* rng determinista (mismo generador que el kit: el banco compara píxel a
     píxel y con Math.random dos capturas de la misma página no coinciden). */
  function rng(semilla) {
    let s = semilla >>> 0 || 1;
    return function () {
      s ^= s << 13; s >>>= 0;
      s ^= s >> 17;
      s ^= s << 5; s >>>= 0;
      return s / 4294967296;
    };
  }

  /* Corrección por banda. Aunque cada capa saque su alfa del perfil, el modo
     `lighter` no es lineal: donde se apilan tres capas el resultado satura por
     encima de lo medido y donde hay una sola queda corto. Estos factores son la
     RAZÓN medida entre el perfil radial de la captura y el de la referencia,
     banda por banda; se aplican al alfa, no al perfil, para que el perfil siga
     siendo el dato crudo. */
  const AJUSTE = [[24, 0.08], [55, 0.66], [72, 0.29], [90, 0.26], [118, 0.52],
                  [150, 0.43], [190, 1.04], [228, 0.69], [270, 0.74], [330, 0.30]];
  function ajuste(r) {
    if (r <= AJUSTE[0][0]) return AJUSTE[0][1];
    for (let i = 1; i < AJUSTE.length; i++) {
      if (r <= AJUSTE[i][0]) {
        const [x0, y0] = AJUSTE[i - 1], [x1, y1] = AJUSTE[i];
        return y0 + ((y1 - y0) * (r - x0)) / (x1 - x0);
      }
    }
    return AJUSTE[AJUSTE.length - 1][1];
  }

  const perfil = (r) => {
    if (r <= 0) return PERFIL[0];
    if (r >= 360) return PERFIL[360];
    const i = Math.floor(r), f = r - i;
    return PERFIL[i] * (1 - f) + PERFIL[i + 1] * f;
  };

  /* Ganancia angular medida: el ojo NO es isótropo. En el anillo r 112-135 la
     media va de 5 (arriba a la derecha) a 72 (a la izquierda, sobre el eje) y
     el lado izquierdo pesa ~1.4 veces el derecho. Sin esto el organismo sale
     como una diana perfecta y pierde la lectura de «ojo mirando». */
  function ganancia(a) {
    const c = Math.cos(a);
    /* El sesgo hacia la izquierda que se midió al principio resultó ser de la
       RAYA DE BARRIDO, no del iris: con izq=1.34 y exponente 2.6 el cuadrante
       135°-195° salía 1,5 veces la referencia y los 0°/180° cortos. La curva
       angular del iris es estrecha y simétrica; el ala la pone el barrido. */
    return (0.80 + 0.85 * Math.pow(Math.abs(c), 8)) * (c < 0 ? 1.05 : 1.0);
  }

  const CX = 348, CY = 253;              /* centro del ojo, local */
  /* El organismo NO llega hasta el fondo del panel: la regla de SUBJECT (y=551
     ref, 463 local) lo corta. Medido: en la fila 550 todavía hay anillos, en la
     560 sólo hay tipografía. Sin este corte las coronas cruzan la fila SUBJECT
     y ensucian el código de barras. */
  const P04 = { x: 1, y: 6, w: 643, h: 457 };

  function ctx2d(cv, w, h) {
    const dpr = 2;
    cv.width = w * dpr;
    cv.height = h * dpr;
    const c = cv.getContext("2d");
    c.scale(dpr, dpr);
    return c;
  }

  /* ── retícula de fondo ────────────────────────────────────────────────
     Medida: en los rincones sin organismo la media de luminancia es 0.4-0.6,
     lo que corresponde a una línea de ~8 de luminancia cada 15.5 px. Es casi
     invisible y aun así es lo que separa el negro del panel del negro del
     papel en el diff estructural. */
  function reticula(ctx) {
    ctx.save();
    ctx.beginPath();
    ctx.rect(P04.x, P04.y, P04.w, P04.h);
    ctx.clip();
    ctx.strokeStyle = "rgba(150,96,205,0.026)";
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let x = P04.x + 4.5; x < P04.x + P04.w; x += 15.5) { ctx.moveTo(x, P04.y); ctx.lineTo(x, P04.y + P04.h); }
    for (let y = P04.y + 6.5; y < P04.y + P04.h; y += 15.5) { ctx.moveTo(P04.x, y); ctx.lineTo(P04.x + P04.w, y); }
    ctx.stroke();
    ctx.restore();
  }

  /* ── capa base ────────────────────────────────────────────────────────
     Descomposición: BASE = promedio angular medido (el perfil), DETALLE = la
     textura encima. Sin la base, los huecos entre penacho y penacho quedan en
     negro puro mientras la referencia los tiene en violeta oscuro, y eso es lo
     que castigaba el diff estructural por bloques de 8×8 — el bloque promedia
     y el promedio de «pelo sobre negro» no es el de «pelo sobre violeta».

     Se pinta por sectores de 15° porque el ojo NO es isótropo: a r 112-135 la
     referencia va de 5 (arriba a la derecha) a 72 (a la izquierda). Un
     gradiente radial puro aplana justo lo que hace que el ojo mire. */
  function base(ctx) {
    const S = 24, paso = (Math.PI * 2) / S;
    for (let i = 0; i < S; i++) {
      const a0 = i * paso, g = ganancia(a0 + paso / 2);
      for (let rad = 3; rad <= 150; rad += 2.5) {
        const alfa = (perfil(rad) / 255) * g * 0.68;
        if (alfa < 0.006) continue;
        ctx.strokeStyle = `rgba(150,86,205,${alfa.toFixed(3)})`;
        ctx.lineWidth = 2.8;
        ctx.beginPath();
        ctx.arc(CX, CY, rad, a0, a0 + paso * 1.04);
        ctx.stroke();
      }
    }
  }

  /* ── anillos de datos y coronas exteriores ───────────────────────────
     Un anillo por radio entero de 136 a 360, con el alfa que dice el perfil.
     Así las crestas medidas (143 · 159 · 168 · 189 · 214 · 225) aparecen solas
     y los valles quedan vacíos, sin tener que listar radios a mano. Los arcos
     se cortan: la referencia casi no tiene circunferencias enteras. */
  function anillos(ctx) {
    const r = rng(0x5e17);
    for (let rad = 136; rad <= 360; rad++) {
      const v = perfil(rad);
      if (v < 4.2) continue;
      const a = Math.min(0.95, (v - 3.0) / 62) * ajuste(rad) * (rad > 300 ? 0.32 : rad > 240 ? 0.48 : 1);
      /* En las crestas del perfil la referencia tiene la circunferencia casi
         entera; en los valles, esquirlas. Repartir siempre en trocitos sueltos
         deja el campo exterior lechoso y sin los aros que se leen. */
      const cresta = v > (rad > 205 ? 6.4 : 11);
      const n = cresta ? 1 : 1 + Math.floor(r() * 3);
      for (let k = 0; k < n; k++) {
        const a0 = r() * Math.PI * 2;
        const arc = cresta ? (1.35 + r() * 0.6) * Math.PI : (0.35 + r() * 1.5) * Math.PI / n;
        ctx.strokeStyle = `rgba(178,120,226,${(a * (0.72 + r() * 0.6)).toFixed(3)})`;
        ctx.lineWidth = r() < 0.18 ? 1.5 : 0.85;
        ctx.beginPath();
        ctx.arc(CX, CY, rad, a0, a0 + arc);
        ctx.stroke();
      }
      /* puntos sobre el anillo: la referencia los tiene punteados, no continuos */
      if (r() < 0.34) {
        const paso = 0.05 + r() * 0.14;
        ctx.fillStyle = `rgba(198,146,240,${(a * 0.9).toFixed(3)})`;
        for (let t = 0; t < Math.PI * 2; t += paso) {
          ctx.fillRect(CX + Math.cos(t) * rad - 0.5, CY + Math.sin(t) * rad - 0.5, 1.1, 1.1);
        }
      }
    }
  }

  /* ── filamentos del iris ──────────────────────────────────────────────
     El iris no son anillos: son agujas radiales. Se recorre cada aguja en
     pasos de 2 px tomando el alfa del perfil, de modo que la media por radio
     sea la medida. La cantidad de agujas se eligió para que la cobertura
     angular ronde 1 en r≈80 (2πr / ancho de trazo). */
  function filamentos(ctx, n, r0min, r0max, r1min, r1max, semilla, gan, ancho) {
    const r = rng(semilla);
    for (let i = 0; i < n; i++) {
      const a = (i / n) * Math.PI * 2 + (r() - 0.5) * 0.02;
      const deriva = (r() - 0.5) * 0.06;
      const ra = r0min + r() * (r0max - r0min);
      const rb = r1min + r() * (r1max - r1min);
      const g = ganancia(a) * (0.45 + r() * 1.05) * gan;
      const w = ancho * (0.6 + r() * 0.9);
      let prevX = CX + Math.cos(a) * ra;
      let prevY = CY + Math.sin(a) * ra;
      for (let rad = ra + 2; rad <= rb; rad += 2) {
        const ang = a + deriva * ((rad - ra) / (rb - ra));
        const x = CX + Math.cos(ang) * rad;
        const y = CY + Math.sin(ang) * rad;
        const alfa = Math.min(0.92, (perfil(rad) / 168) * g * ajuste(rad));
        if (alfa > 0.012 && r() > 0.3) {
          ctx.strokeStyle = `rgba(186,128,232,${alfa.toFixed(3)})`;
          ctx.lineWidth = w;
          ctx.beginPath();
          ctx.moveTo(prevX, prevY);
          ctx.lineTo(x, y);
          ctx.stroke();
        }
        prevX = x; prevY = y;
      }
    }
  }

  /* ── aros finos del iris ──────────────────────────────────────────────
     Un arco por radio entero, con el alfa que dicta el perfil y el peso
     irregular que pide el kit (no hay dos anillos con el mismo brillo). */
  function aroFino(ctx, r0, r1, semilla) {
    const r = rng(semilla);
    for (let rad = r0; rad <= r1; rad++) {
      const v = perfil(rad);
      const a = Math.min(0.5, (v / 320) * (0.4 + r() * 1.2) * ajuste(rad));
      if (a < 0.02) continue;
      const n = 1 + Math.floor(r() * 3);
      for (let k = 0; k < n; k++) {
        const a0 = r() * Math.PI * 2;
        ctx.strokeStyle = `rgba(176,116,226,${a.toFixed(3)})`;
        ctx.lineWidth = 0.55 + (r() < 0.2 ? 0.7 : 0);
        ctx.beginPath();
        ctx.arc(CX, CY, rad, a0, a0 + (0.5 + r() * 2.2));
        ctx.stroke();
      }
    }
  }

  /* ── engranaje ────────────────────────────────────────────────────────
     La banda entre la pupila y el anillo limbal (r 24-66) no es un degradado:
     en la referencia es un enrejado de dientes radiales finos con un collar
     partido en r≈33. Con sólo el degradado la zona quedaba lisa y el ojo
     perdía la lectura de mecanismo. */
  function engranaje(ctx) {
    const r = rng(0x4d19);
    for (const [n, ra, rb, esc] of [[210, 25, 46, 0.42], [150, 40, 63, 0.9], [96, 26, 34, 0.38]]) {
      for (let i = 0; i < n; i++) {
        const a = (i / n) * Math.PI * 2 + (r() - 0.5) * 0.012;
        const g = ganancia(a);
        const r0 = ra + r() * 2.5;
        const r1 = r0 + (rb - ra) * (0.45 + r() * 0.6);
        const alfa = Math.min(0.7, (perfil((r0 + r1) / 2) / 255) * g * esc * (0.3 + r() * 1.1) * 0.42);
        if (alfa < 0.02) continue;
        ctx.strokeStyle = `rgba(${r() < 0.1 ? "234,212,255" : "182,124,230"},${alfa.toFixed(3)})`;
        ctx.lineWidth = 0.5 + r() * 0.8;
        ctx.beginPath();
        ctx.moveTo(CX + Math.cos(a) * r0, CY + Math.sin(a) * r0);
        ctx.lineTo(CX + Math.cos(a) * r1, CY + Math.sin(a) * r1);
        ctx.stroke();
      }
    }
    /* collar partido: tramos de arco brillante sobre r=33, no un aro continuo */
    for (let k = 0; k < 46; k++) {
      const a0 = r() * Math.PI * 2;
      const alfa = 0.028 + r() * 0.12;
      ctx.strokeStyle = `rgba(226,190,255,${alfa.toFixed(3)})`;
      ctx.lineWidth = 0.8 + r() * 1.4;
      ctx.beginPath();
      ctx.arc(CX, CY, 32 + r() * 4, a0, a0 + 0.06 + r() * 0.22);
      ctx.stroke();
    }
  }

  /* ── plumas ───────────────────────────────────────────────────────────
     El fleco exterior del iris (r 78-142) NO es pelo parejo: son ~64 penachos
     con calle negra entre uno y otro, cada uno con su propia punta. Repartir
     las agujas en ángulo uniforme daba una alfombra y era el error de textura
     más grande que quedaba después de casar el perfil radial. */
  function plumas(ctx, n, semilla) {
    const r = rng(semilla);
    for (let i = 0; i < n; i++) {
      const centro = (i / n) * Math.PI * 2 + (r() - 0.5) * 0.03;
      const abre = ((Math.PI * 2) / n) * (0.52 + r() * 0.3);
      const punta = 118 + r() * 26;
      const g = ganancia(centro) * (0.55 + r() * 0.9);
      const agujas = 9 + Math.floor(r() * 9);
      for (let k = 0; k < agujas; k++) {
        const u = (k + 0.5) / agujas;
        const a = centro + (u - 0.5) * abre;
        const borde = 1 - Math.pow(Math.abs(u - 0.5) * 2, 1.7);
        const ra = 62 + r() * 22;
        const rb = 88 + borde * (punta - 88) + r() * 8;
        let px = CX + Math.cos(a) * ra, py = CY + Math.sin(a) * ra;
        for (let rad = ra + 2.4; rad <= rb; rad += 2.4) {
          const x = CX + Math.cos(a) * rad, y = CY + Math.sin(a) * rad;
          const alfa = Math.min(0.85, (perfil(rad) / 168) * g * ajuste(rad) * (0.35 + borde));
          if (alfa > 0.015 && r() > 0.2) {
            ctx.strokeStyle = `rgba(184,126,230,${alfa.toFixed(3)})`;
            ctx.lineWidth = 0.8 + r() * 1.5;
            ctx.beginPath();
            ctx.moveTo(px, py);
            ctx.lineTo(x, y);
            ctx.stroke();
          }
          px = x; py = y;
        }
      }
    }
  }

  /* ── tejas ────────────────────────────────────────────────────────────
     El error que quedaba después de casar el perfil radial era de TEXTURA: el
     iris de la referencia no es pelo fino, son tramos rectangulares cosidos en
     anillos —bloques de dato— y el diff estructural por bloques de 8×8 mide
     justo eso. Cada anillo lleva n tejas repartidas con salteo, no continuas.  */
  function tejas(ctx, r0, r1, paso, densidad, semilla, esc) {
    const r = rng(semilla);
    for (let rad = r0; rad <= r1; rad += paso) {
      const v = perfil(rad) * ajuste(rad);
      if (v < 3) continue;
      const n = Math.max(6, Math.round((Math.PI * 2 * rad) / (7 + r() * 6)));
      for (let i = 0; i < n; i++) {
        if (r() > densidad) continue;
        const a = (i / n) * Math.PI * 2 + (r() - 0.5) * 0.02;
        const g = ganancia(a);
        const alfa = Math.min(0.85, (v / 190) * (0.25 + r() * 1.3) * g * esc);
        if (alfa < 0.02) continue;
        const largo = 1.6 + r() * (r() < 0.16 ? 9 : 4.4);
        const ancho = 1 + r() * 2.6;
        ctx.save();
        ctx.translate(CX + Math.cos(a) * rad, CY + Math.sin(a) * rad);
        ctx.rotate(a);
        ctx.fillStyle = `rgba(${r() < 0.12 ? "236,214,255" : "178,120,228"},${alfa.toFixed(3)})`;
        ctx.fillRect(-largo / 2, -ancho / 2, largo, ancho);
        ctx.restore();
      }
    }
  }

  /* ── coronas quemadas ─────────────────────────────────────────────────
     Los dos picos del perfil: r=33 (collar de la pupila, 88) y r=72 (anillo
     limbal, 106 — el punto más brillante del organismo). Van en tres pasadas
     de ancho decreciente, que es lo que da el borde quemado sin glow difuso. */
  function coronas(ctx) {
    const capas = [
      [33, [[7.5, "rgba(150,86,205,0.022)"], [4.0, "rgba(186,124,235,0.04)"], [1.5, "rgba(226,190,255,0.055)"]]],
      [72.5, [[10.0, "rgba(150,86,205,0.040)"], [5.0, "rgba(196,140,242,0.072)"], [2.0, "rgba(236,208,255,0.13)"]]],
      [95, [[6.0, "rgba(140,80,195,0.087)"], [1.6, "rgba(200,152,244,0.14)"]]],
      [120, [[4.0, "rgba(130,74,182,0.118)"], [1.2, "rgba(190,140,236,0.177)"]]],
    ];
    for (const [rad, pasadas] of capas) {
      for (const [lw, col] of pasadas) {
        ctx.strokeStyle = col;
        ctx.lineWidth = lw;
        ctx.beginPath();
        ctx.arc(CX, CY, rad, 0, Math.PI * 2);
        ctx.stroke();
      }
    }
    /* dientes del collar: 128 marcas cortas justo afuera de la pupila */
    const r = rng(0x33a1);
    for (let i = 0; i < 128; i++) {
      const a = (i / 128) * Math.PI * 2;
      const g = ganancia(a);
      const ra = 25 + r() * 2;
      const rb = ra + 5 + r() * 9;
      ctx.strokeStyle = `rgba(214,168,250,${(0.039 + r() * 0.17 * g).toFixed(3)})`;
      ctx.lineWidth = 0.55 + r() * 0.8;
      ctx.beginPath();
      ctx.moveTo(CX + Math.cos(a) * ra, CY + Math.sin(a) * ra);
      ctx.lineTo(CX + Math.cos(a) * rb, CY + Math.sin(a) * rb);
      ctx.stroke();
    }
  }

  /* ── pupila e infinito ────────────────────────────────────────────────
     Pupila negra hasta r=23.5 (perfil 5-11: es negro, no gris). Al centro el
     símbolo ∞, medido en 15 px de ancho por 8 de alto: lemniscata de
     Bernoulli, no dos círculos pegados. */
  function pupila(ctx) {
    ctx.globalCompositeOperation = "source-over";
    /* La pupila TAPA: el aditivo de las capas de abajo le mete brillo y medido
       daba 1,7 veces la referencia. Va un disco opaco hasta r=21 y un borde
       degradado hasta 25, que es donde arranca el collar. */
    ctx.fillStyle = "#0b0512";
    ctx.beginPath();
    ctx.arc(CX, CY, 21, 0, Math.PI * 2);
    ctx.fill();
    const g = ctx.createRadialGradient(CX, CY, 21, CX, CY, 26);
    g.addColorStop(0, "#0b0512");
    g.addColorStop(1, "rgba(11,5,18,0)");
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(CX, CY, 26, 0, Math.PI * 2);
    ctx.fill();

    ctx.globalCompositeOperation = "lighter";
    ctx.strokeStyle = "rgba(198,124,242,0.78)";
    ctx.lineWidth = 1.15;
    ctx.beginPath();
    const a = 6.9;
    for (let i = 0; i <= 96; i++) {
      const t = (i / 96) * Math.PI * 2;
      const d = 1 + Math.sin(t) * Math.sin(t);
      const x = CX + (a * Math.cos(t)) / d;
      const y = CY + (a * Math.sin(t) * Math.cos(t)) / d;
      i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
    }
    ctx.closePath();
    ctx.stroke();
  }

  /* ── raya de barrido ──────────────────────────────────────────────────
     Fila 341 (local 253): media 110 sobre TODO el ancho del panel, con halo
     de 326 a 352 y bloques de ruido rectangular a los costados de la pupila.
     Es el elemento que más tinta aporta del panel y el que le da el eje. */
  function barrido(ctx) {
    const r = rng(0x7a41);
    ctx.save();
    ctx.beginPath();
    ctx.rect(P04.x, P04.y, P04.w, P04.h);
    ctx.clip();
    ctx.globalCompositeOperation = "lighter";

    /* halo */
    const g = ctx.createLinearGradient(0, CY - 28, 0, CY + 28);
    g.addColorStop(0, "rgba(150,86,205,0)");
    g.addColorStop(0.5, "rgba(160,96,215,0.115)");
    g.addColorStop(1, "rgba(150,86,205,0)");
    ctx.fillStyle = g;
    ctx.fillRect(P04.x, CY - 28, P04.w, 56);

    /* bloques de ruido de escaneo: se apilan cerca del eje y se apagan al
       alejarse; los de la izquierda son más densos (medido). */
    for (let i = 0; i < 1500; i++) {
      const x = P04.x + r() * P04.w;
      const dy = (r() - 0.5) * 2;
      const y = CY + Math.sign(dy) * Math.pow(Math.abs(dy), 2.1) * 42;
      const d = Math.abs(x - CX);
      if (d < 26 && Math.abs(y - CY) < 24) continue;
      const cerca = 1 - Math.min(1, Math.abs(y - CY) / 44);
      const lado = x < CX ? 1.25 : 1.0;
      const a = Math.pow(cerca, 1.6) * (0.04 + r() * 0.215) * lado;
      if (a < 0.03) continue;
      const w = 1 + r() * (r() < 0.14 ? 22 : 6);
      const h = r() < 0.8 ? 1 : 2;
      ctx.fillStyle = r() < 0.22
        ? `rgba(244,228,255,${a.toFixed(3)})`
        : `rgba(176,116,226,${a.toFixed(3)})`;
      ctx.fillRect(x, y, w, h);
    }

    /* núcleo de la raya: tramos brillantes de ancho irregular en y = CY */
    let x = P04.x;
    while (x < P04.x + P04.w) {
      const w = 3 + r() * 34;
      const hueco = r() < 0.18;
      if (!hueco && !(x + w > CX - 24 && x < CX + 24)) {
        const a = 0.21 + r() * 0.19;
        ctx.fillStyle = `rgba(250,240,255,${a.toFixed(3)})`;
        ctx.fillRect(x, CY, w, 1);
        ctx.fillStyle = `rgba(198,150,242,${(a * 0.5).toFixed(3)})`;
        ctx.fillRect(x, CY - 1, w, 1);
      }
      x += w + r() * 5;
    }
    ctx.restore();
  }

  /* ── ejes y miras ─────────────────────────────────────────────────────
     Eje vertical en x=816 (local 348) de tope a tope del panel, con rombos de
     mira sobre las coronas. La referencia también cuelga una marca del borde
     superior: es lo que ata el organismo al marco. */
  function ejes(ctx) {
    ctx.save();
    ctx.beginPath();
    ctx.rect(P04.x, P04.y, P04.w, P04.h);
    ctx.clip();
    ctx.globalCompositeOperation = "lighter";
    ctx.strokeStyle = "rgba(206,166,244,0.20)";
    ctx.lineWidth = 1;
    ctx.setLineDash([9, 5]);
    ctx.beginPath();
    ctx.moveTo(CX + 0.5, P04.y);
    ctx.lineTo(CX + 0.5, P04.y + P04.h);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.strokeStyle = "rgba(226,196,252,0.38)";
    ctx.beginPath();
    ctx.moveTo(CX + 0.5, P04.y);
    ctx.lineTo(CX + 0.5, P04.y + 26);
    ctx.moveTo(CX + 0.5, P04.y + P04.h - 26);
    ctx.lineTo(CX + 0.5, P04.y + P04.h);
    ctx.stroke();

    ctx.strokeStyle = "rgba(196,142,240,0.34)";
    for (const rad of [33, 72.5, 120, 168, 214]) {
      for (const s of [-1, 1]) {
        ctx.beginPath();
        ctx.moveTo(CX, CY + s * rad - 3);
        ctx.lineTo(CX + 3, CY + s * rad);
        ctx.lineTo(CX, CY + s * rad + 3);
        ctx.lineTo(CX - 3, CY + s * rad);
        ctx.closePath();
        ctx.stroke();
      }
    }
    ctx.restore();
  }

  /* ── micro-glifos del campo ───────────────────────────────────────────
     Las marcas sueltas que la referencia siembra fuera del iris: cuadraditos
     de dato, cruces de registro y arcos rotos. Sin ellas el campo exterior
     queda liso y el diff estructural lo castiga por bloque vacío. */
  function glifos(ctx) {
    const r = rng(0x1d3c);
    ctx.save();
    ctx.beginPath();
    ctx.rect(P04.x, P04.y, P04.w, P04.h);
    ctx.clip();
    ctx.globalCompositeOperation = "lighter";
    for (let i = 0; i < 330; i++) {
      const a = r() * Math.PI * 2;
      const rad = 140 + Math.pow(r(), 0.75) * 205;
      const x = CX + Math.cos(a) * rad;
      const y = CY + Math.sin(a) * rad * 0.98;
      if (x < P04.x || x > P04.x + P04.w || y < P04.y || y > P04.y + P04.h) continue;
      const a0 = 0.04 + r() * 0.17;
      ctx.strokeStyle = `rgba(180,124,228,${a0.toFixed(3)})`;
      ctx.fillStyle = `rgba(180,124,228,${a0.toFixed(3)})`;
      ctx.lineWidth = 0.7;
      const k = r();
      if (k < 0.42) {
        ctx.fillRect(x, y, 1 + r() * 4, 1 + r() * 2);
      } else if (k < 0.66) {
        ctx.strokeRect(x, y, 3 + r() * 7, 3 + r() * 5);
      } else if (k < 0.84) {
        ctx.beginPath();
        ctx.moveTo(x - 3, y); ctx.lineTo(x + 3, y);
        ctx.moveTo(x, y - 3); ctx.lineTo(x, y + 3);
        ctx.stroke();
      } else {
        ctx.beginPath();
        ctx.arc(x, y, 2 + r() * 5, 0, 1 + r() * 3);
        ctx.stroke();
      }
    }
    ctx.restore();
  }

  /* ── el ojo entero ────────────────────────────────────────────────── */
  function ojo(ctx) {
    reticula(ctx);
    ctx.save();
    ctx.beginPath();
    ctx.rect(P04.x, P04.y, P04.w, P04.h);
    ctx.clip();
    ctx.globalCompositeOperation = "lighter";
    base(ctx);
    anillos(ctx);
    /* Cuatro pasadas de filamento. La primera versión usaba pocas agujas muy
       largas y salió un ESTALLIDO de rayos: la referencia no tiene rayos, tiene
       pluma. Lo que la arregla es más agujas, más cortas, con menos alfa cada
       una y con deriva angular — el fleco de la referencia muere en r≈135. */
    filamentos(ctx, 520, 25, 29, 48, 70, 0xa11f, 0.42, 0.62);
    filamentos(ctx, 720, 30, 48, 70, 104, 0xb327, 0.46, 0.62);
    engranaje(ctx);
    plumas(ctx, 64, 0xc435);
    /* Circunferencias finas DENTRO del iris: la referencia teje la pluma con
       aros concéntricos y sin ellos quedan calles negras entre aguja y aguja. */
    aroFino(ctx, 24, 140, 0x6b2c);
    tejas(ctx, 26, 142, 3.1, 0.55, 0x77e3, 1.0);
    tejas(ctx, 145, 250, 5.3, 0.34, 0x88f4, 0.85);
    tejas(ctx, 252, 350, 8.7, 0.22, 0x9905, 0.7);
    coronas(ctx);
    ctx.restore();
    glifos(ctx);
    barrido(ctx);
    ejes(ctx);
    ctx.save();
    ctx.beginPath();
    ctx.rect(P04.x, P04.y, P04.w, P04.h);
    ctx.clip();
    pupila(ctx);
    ctx.restore();
    ctx.globalCompositeOperation = "source-over";
  }

  /* ── código de barras ─────────────────────────────────────────────────
     Columna por columna desde la lectura de la referencia: cada bit es 1 px
     de ancho. Trazarlo con contornos pierde ~38 % de la tinta. */
  function barcode(ctx) {
    ctx.fillStyle = "#3f4141";
    for (let i = 0; i < BARRAS.length; i++) {
      if (BARRAS[i] === "1") ctx.fillRect(168 + i, 467, 1, 19);
    }
  }

  /* ── sello ────────────────────────────────────────────────────────────
     El emblema alado de la esquina, en versión de 30 px: dos aros con texto
     ilegible entre medio (micrografía: a 2 px nada es legible y poner texto
     real sería inventar contenido) y el ala al centro. */
  function sello(ctx) {
    const cx = 614, cy = 477, r = rng(0x9c02);
    ctx.strokeStyle = "rgba(150,80,200,0.48)";
    ctx.lineWidth = 0.8;
    for (const rad of [14.5, 11.5]) {
      ctx.beginPath();
      ctx.arc(cx, cy, rad, 0, Math.PI * 2);
      ctx.stroke();
    }
    ctx.fillStyle = "rgba(168,102,214,0.42)";
    for (let i = 0; i < 54; i++) {
      const a = (i / 54) * Math.PI * 2;
      const rad = 13;
      ctx.fillRect(cx + Math.cos(a) * rad - 0.5, cy + Math.sin(a) * rad - 0.9, 1, 1.8 + r() * 0.6);
    }
    ctx.strokeStyle = "rgba(186,124,232,0.66)";
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(cx - 8, cy - 2);
    ctx.lineTo(cx, cy - 5.5);
    ctx.lineTo(cx + 8, cy - 2);
    ctx.moveTo(cx - 6, cy + 1.5);
    ctx.lineTo(cx, cy - 1.5);
    ctx.lineTo(cx + 6, cy + 1.5);
    ctx.moveTo(cx, cy - 5.5);
    ctx.lineTo(cx, cy + 5.5);
    ctx.stroke();
  }

  /* ── iconos de la tabla 07 ───────────────────────────────────────────
     Siete marcas de 15 px, una por evento. No son siete dibujos distintos:
     son el mismo trazo de instrumento con distinto núcleo. */
  function iconos(ctx) {
    const y0 = 554.5;
    for (let i = 0; i < 7; i++) {
      const cy = y0 + i * 22.05;
      const cx = 18;
      const col = i === 5 ? "rgba(180,52,42,0.9)" : i === 6 ? "rgba(21,159,174,0.9)" : "rgba(150,150,146,0.85)";
      ctx.strokeStyle = col;
      ctx.fillStyle = col;
      ctx.lineWidth = 0.85;
      const r = rng(0x2200 + i * 37);
      if (i === 0) {
        ctx.beginPath();
        ctx.moveTo(cx - 8, cy);
        ctx.quadraticCurveTo(cx, cy - 6, cx + 8, cy);
        ctx.quadraticCurveTo(cx, cy + 6, cx - 8, cy);
        ctx.stroke();
        ctx.beginPath(); ctx.arc(cx, cy, 2.6, 0, Math.PI * 2); ctx.stroke();
        ctx.beginPath(); ctx.arc(cx, cy, 1.1, 0, Math.PI * 2); ctx.fill();
      } else if (i === 1) {
        ctx.beginPath();
        ctx.moveTo(cx - 9, cy);
        for (let k = 0; k < 18; k++) {
          const x = cx - 9 + k;
          const h = k > 4 && k < 13 ? (r() - 0.5) * 11 : (r() - 0.5) * 2.5;
          ctx.lineTo(x, cy + h);
        }
        ctx.stroke();
      } else if (i === 2) {
        ctx.beginPath(); ctx.arc(cx, cy, 7, 0, Math.PI * 2); ctx.stroke();
        ctx.beginPath(); ctx.arc(cx, cy, 3.4, 0, Math.PI * 2); ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(cx - 9, cy); ctx.lineTo(cx + 9, cy);
        ctx.moveTo(cx, cy - 9); ctx.lineTo(cx, cy + 9);
        ctx.stroke();
      } else if (i === 3) {
        ctx.beginPath();
        ctx.arc(cx, cy - 1.5, 5.2, Math.PI, 0);
        ctx.lineTo(cx + 5.2, cy + 2);
        ctx.lineTo(cx - 5.2, cy + 2);
        ctx.closePath();
        ctx.stroke();
        ctx.fillRect(cx - 3.4, cy - 2.4, 2, 2);
        ctx.fillRect(cx + 1.4, cy - 2.4, 2, 2);
        ctx.fillRect(cx - 2.6, cy + 3.2, 5.2, 2.6);
      } else if (i === 4 || i === 5) {
        const n = i === 4 ? 4 : 8;
        for (let k = 0; k < n; k++) {
          const a = (k / n) * Math.PI * 2 + (i === 5 ? 0.2 : 0.78);
          ctx.beginPath();
          ctx.moveTo(cx + Math.cos(a) * 2.5, cy + Math.sin(a) * 2.5);
          ctx.lineTo(cx + Math.cos(a) * 9, cy + Math.sin(a) * 9);
          ctx.stroke();
        }
        ctx.beginPath(); ctx.arc(cx, cy, 2.4, 0, Math.PI * 2); ctx.stroke();
      } else {
        ctx.beginPath();
        ctx.moveTo(cx - 8, cy + 4); ctx.lineTo(cx, cy - 6); ctx.lineTo(cx + 8, cy + 4);
        ctx.closePath();
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(cx - 8, cy); ctx.lineTo(cx + 8, cy);
        ctx.moveTo(cx - 5, cy + 6); ctx.lineTo(cx + 5, cy + 6);
        ctx.stroke();
      }
    }
  }

  /* ── tira de señal del pie de 07 ──────────────────────────────────────
     No es un peine simétrico (eso se lee como ecualizador): es una serie con
     racimos de picos altos y valles largos, con la mancha densa a la
     izquierda del panel, como en la referencia. */
  function tiraSenal(ctx) {
    const r = rng(0x4411);
    const base = 741, x0 = 10, x1 = 351;
    for (let x = x0; x < x1; x += 1) {
      const t = (x - x0) / (x1 - x0);
      const racimo = Math.pow(Math.max(0, Math.sin(t * 17.3) * 0.5 + 0.5), 2.4);
      const h = (1.2 + r() * 5) + racimo * (2 + r() * 22) * (r() < 0.06 ? 2.2 : 1);
      const a = 0.09 + r() * 0.26;
      ctx.fillStyle = `rgba(168,110,220,${a.toFixed(3)})`;
      ctx.fillRect(x, base - h, 1, h);
      if (r() < 0.5) {
        ctx.fillStyle = `rgba(150,96,206,${(a * 0.7).toFixed(3)})`;
        ctx.fillRect(x, base, 1, 1 + r() * 5);
      }
    }
    ctx.fillStyle = "rgba(120,74,168,0.5)";
    for (let x = x0; x < x1; x += 9.7) ctx.fillRect(Math.round(x), 749, 1, 3);
  }

  /* ── miniaturas y ondas de la tira 05/06 ─────────────────────────────
     Sólo se ve la primera columna de recortes: el marco real de esa banda
     está en x=1122 y esta caja llega hasta 1180. */
  function tira(ctx) {
    /* Los dos recortes de 05 que caen en esta caja. No son la misma textura:
       el de arriba es un fragmento de iris «tratado» —vetas largas y diagonales
       con brillos, como piedra rota— y el de abajo es el pase HALFTONE, gris,
       con fibra radial alrededor de una pupila negra corrida a la derecha.
       Resolverlos con el mismo salpicado daba dos manchas iguales y ninguna se
       parecía a la referencia. */
    {
      const r = rng(0x8801);
      ctx.save();
      ctx.beginPath();
      ctx.rect(662, 42, 50, 68);
      ctx.clip();
      ctx.fillStyle = "#05030a";
      ctx.fillRect(662, 42, 50, 68);
      ctx.globalCompositeOperation = "lighter";
      for (let i = 0; i < 190; i++) {
        const x = 660 + r() * 54, y = 40 + r() * 72;
        const ang = -0.5 + (r() - 0.5) * 1.5;
        const largo = 3 + r() * (r() < 0.2 ? 22 : 9);
        const al = 0.04 + r() * 0.28;
        ctx.strokeStyle = `rgba(${r() < 0.14 ? "236,222,255" : "158,96,206"},${al.toFixed(3)})`;
        ctx.lineWidth = 0.6 + r() * 2.4;
        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x + Math.cos(ang) * largo, y + Math.sin(ang) * largo);
        ctx.stroke();
      }
      for (let i = 0; i < 90; i++) {
        const x = 660 + r() * 54, y = 40 + r() * 72;
        ctx.fillStyle = `rgba(202,150,244,${(0.05 + r() * 0.28).toFixed(3)})`;
        ctx.fillRect(x, y, 1 + r() * 4, 1 + r() * 3);
      }
      ctx.restore();
    }
    {
      const r = rng(0x8802);
      ctx.save();
      ctx.beginPath();
      ctx.rect(662, 148, 50, 75);
      ctx.clip();
      ctx.fillStyle = "#050505";
      ctx.fillRect(662, 148, 50, 75);
      ctx.globalCompositeOperation = "lighter";
      const cx = 716, cy = 187;
      for (let i = 0; i < 2300; i++) {
        const a2 = r() * Math.PI * 2;
        const rad = 22 + Math.pow(r(), 0.7) * 62;
        const x = cx + Math.cos(a2) * rad, y = cy + Math.sin(a2) * rad * 0.92;
        const al = (0.075 + r() * 0.75) * (1 - Math.min(1, (rad - 22) / 78));
        ctx.fillStyle = `rgba(216,216,218,${al.toFixed(3)})`;
        ctx.fillRect(x, y, 0.7 + r() * 2.2, 0.6 + r() * 1.1);
      }
      ctx.globalCompositeOperation = "source-over";
      ctx.fillStyle = "#000";
      ctx.beginPath();
      ctx.arc(cx, cy, 19, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    /* ondas de 06 */
    const conf = [
      [283, 41, "168,96,222", 0x51a3, 1.0],
      [326, 43, "18,182,198", 0x77c1, 0.95],
      [371, 44, "141,70,184", 0x2e05, 0.6],
      [417, 62, "164,95,216", 0x64bb, 1.2],
    ];
    for (const [y, h, col, sem, gan] of conf) {
      const r = rng(sem);
      const base = y + h - 9;
      ctx.save();
      ctx.beginPath();
      ctx.rect(661, y + 12, 51, h - 13);
      ctx.clip();
      if (sem === 0x64bb) {
        /* SPECTRAL RANGE es un espectro, no un peine: picos anchos con falda */
        for (let x = 661; x < 712; x++) {
          const t = (x - 661) / 51;
          const p = Math.pow(Math.max(0, Math.sin(t * 9.1 + 0.4)), 6) + Math.pow(Math.max(0, Math.sin(t * 4.3)), 9);
          const hh = 1.8 + p * 23 + r() * 2.8;
          ctx.fillStyle = `rgba(${col},${(0.12 + r() * 0.34).toFixed(3)})`;
          ctx.fillRect(x, base - hh, 1, hh);
        }
      } else {
        for (let x = 661; x < 712; x++) {
          const t = (x - 661) / 51;
          const env = Math.pow(Math.max(0, Math.sin(t * 11.7 + sem % 7)), 3);
          const hh = (0.6 + r() * 1.5) + env * (1.6 + r() * 8) * gan;
          const a = 0.11 + r() * 0.28;
          ctx.fillStyle = `rgba(${col},${a.toFixed(3)})`;
          ctx.fillRect(x, base - hh, 1, hh * 2);
        }
        ctx.fillStyle = `rgba(${col},0.3)`;
        ctx.fillRect(661, base, 51, 1);
      }
      ctx.restore();
    }
  }

  function pintar(cv) {
    const ctx = ctx2d(cv, 712, 778);
    ctx.clearRect(0, 0, 712, 778);
    ctx.fillStyle = "#000";
    ctx.fillRect(0, 0, 712, 778);
    ojo(ctx);
    barcode(ctx);
    sello(ctx);
    iconos(ctx);
    tiraSenal(ctx);
    tira(ctx);
  }

  function arrancar() {
    const cv = document.querySelector(".oe4__lienzo");
    if (cv && cv.dataset.pintado !== "1") {
      cv.dataset.pintado = "1";
      pintar(cv);
    }
  }

  arrancar();

  /* El panel es estático a propósito — el banco compara píxel a píxel y un rAF
     propio le hace medir ruido. Aun así se registra el congelador, que es el
     contrato que espera la página. */
  const w = window;
  const congelar = () => arrancar();
  if (typeof w.__kdxRegisterFreeze === "function") {
    w.__kdxRegisterFreeze(congelar);
  } else {
    let n = 0;
    const id = setInterval(() => {
      if (typeof w.__kdxRegisterFreeze === "function") {
        clearInterval(id);
        w.__kdxRegisterFreeze(congelar);
      } else if (++n > 200) clearInterval(id);
    }, 25);
  }
</script>
