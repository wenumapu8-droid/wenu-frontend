 * KODEX-∞ · t01-02 · BLOQUE IZQUIERDA
 * 01. SCAN STATES · 02. MOTION NOTES (EYE BEHAVIOR) · 03. UI CHIPS & DETECTION LABELS
 *
 * Caja del bloque: ref (4,88) 464×778. Todo lo de acá es LOCAL a esa caja
 * (restar 4 en x y 88 en y a cualquier coordenada de la referencia).
 *
 * TODO lo geométrico está medido sobre reference/canon/t01-02-observation-eye.png
 * con perfiles de tinta por fila y por columna (umbral 8–20 según la zona,
 * porque los filetes de esta lámina bajan hasta luminancia 8). Lo medido:
 *
 *   marcos de sección   x 12→459 · y 93→330 · 339→539 · 555→844   (ref)
 *   filete bajo título  y 117 · 361 · 578      (lum 22 · 15 · 12: van bajando)
 *   tarjetas de estado  y 128→180 · 199→251 · 269→321, x 82→453
 *   partidor tarjeta    x 273 (a la izquierda texto, a la derecha la miniatura)
 *   columnas de la 02   x 13|154|305|459 — NO son iguales (141·151·153)
 *   tabla de la 02      filетes y 463 y 484, partidor x 69·216·217·367
 *   chips fila 1        y 586→607, x [19,116] [125,225] [234,332] [340,451]
 *   chips fila 2        y 616→638, x [19,125] [125,225] [234,332] [340,451]
 *   iconos fila 1       y 659→711, 7 cajas desde x 19 hasta 451
 *   iconos fila 2       y 727→836, 6 cajas de ancho DISTINTO (58·57·60·76·67·74)
 *
 * Densidad objetivo por zona (tinta >18 y media rgb), que es contra lo que
 * mide el banco desde que el diff estructural entró en la métrica:
 *
 *   bloque entero      media  9,2  8,0 11,9   ·  14,6 %
 *   sección 01         media 12,3 13,3 20,0   ·  23,2 %
 *   sección 02         media  8,4  6,5  9,4   ·  11,3 %
 *   sección 03         media  9,2  6,5  9,6   ·  13,5 %
 *   miniatura LOCK     media 34,0  7,8 51,8   ·  37,9 %
 *   miniatura TRACK    media 11,4 45,0 53,3   ·  60,1 %
 *   miniatura IDLE     media 33,0 32,8 32,3   ·  57,5 %
 *
 * Los tres iris NO son tres dibujos: son el mismo organismo (`iris()`) con
 * ganancia y tinta distintas, igual que las tarjetas de t01-08. TRACK es el
 * más denso porque es el estado activo; IDLE es el mismo campo desaturado.
 *
 * Todos los números de esta lámina son ficción del póster: los contenedores
 * que los muestran van con data-symbolic.
 */
import { rng, serieSuave, p2 } from "../kit/rng";

interface Props { box: string }
const { box } = Astro.props;

/* ══════════════════════════════════════════════════════════════════════════
   GENERADORES
   ══════════════════════════════════════════════════════════════════════════ */

/** Anillos en progresión geométrica, con peso irregular (regla del kit). */
function anillos(n: number, rmax: number, razon: number, semilla: number) {
  const r = rng(semilla);
  return Array.from({ length: n }, (_, i) => ({
    r: p2(rmax * Math.pow(razon, i)),
    o: p2(0.14 + r() * 0.6),
    w: p2(0.3 + (r() < 0.25 ? 0.45 : 0)),
  }));
}

/**
 * Iris de la miniatura. Un núcleo negro, una corona de fibras radiales, un
 * anillo de "dientes" (la mandala que en la referencia parece un engranaje) y
 * unos pocos aros exteriores recortados por la caja.
 */
function iris(semilla: number, densidad: number) {
  const r = rng(semilla);
  const fibras = Array.from({ length: Math.round(150 * densidad) }, () => {
    const a = r() * Math.PI * 2;
    const r0 = 8.6 + r() * 2.2;
    const r1 = 15 + r() * 11;
    return {
      x1: p2(Math.cos(a) * r0), y1: p2(Math.sin(a) * r0),
      x2: p2(Math.cos(a) * r1), y2: p2(Math.sin(a) * r1),
      o: p2(0.12 + r() * 0.72), w: p2(0.3 + r() * 0.6),
    };
  });
  const dientes = Array.from({ length: 96 }, (_, i) => {
    const a = (i * Math.PI * 2) / 96 + r() * 0.02;
    const r0 = 26 + r() * 3;
    const r1 = r0 + 3 + r() * 7;
    return {
      x1: p2(Math.cos(a) * r0), y1: p2(Math.sin(a) * r0),
      x2: p2(Math.cos(a) * r1), y2: p2(Math.sin(a) * r1),
      o: p2(0.1 + r() * 0.6), w: p2(0.4 + r() * 0.9),
    };
  });
  const motas = Array.from({ length: Math.round(220 * densidad) }, () => {
    const a = r() * Math.PI * 2;
    const rad = 9 + Math.pow(r(), 0.6) * 64;
    return {
      x: p2(Math.cos(a) * rad), y: p2(Math.sin(a) * rad * 0.92),
      r: p2(0.3 + r() * 0.85), o: p2(0.1 + r() * 0.7),
    };
  });
  /* La cola de señal: el iris sale por los dos lados como una onda tumbada. */
  const picos = Array.from({ length: 132 }, (_, i) => {
    const x = -88 + (i * 176) / 131;
    const d = Math.abs(x);
    const caida = d < 34 ? 0 : Math.min(1, (d - 30) / 26) * (1 - Math.min(1, (d - 34) / 62) * 0.45);
    const h = caida * (1.2 + r() * 12) * (r() < 0.14 ? 2.1 : 1);
    return { x: p2(x), h: p2(h), o: p2(0.14 + r() * 0.66), w: p2(0.35 + r() * 0.7) };
  });
  const verticales = Array.from({ length: 22 }, () => ({
    x: p2(-88 + r() * 176),
    y1: p2(-26 + r() * 10),
    y2: p2(16 + r() * 12),
    o: p2(0.05 + r() * 0.2),
  }));
  return { fibras, dientes, motas, picos, verticales };
}

/* Un solo organismo, tres ganancias. */
const irisA = iris(2207, 0.62);
const irisB = iris(2207, 1.0);
const irisC = iris(2207, 0.92);
const arosOjo = anillos(9, 74, 0.9, 3301);

/** Onda de peine tumbada, la de abajo del rótulo de cada tarjeta. */
function onda(semilla: number, ancho: number, alto: number, n: number, inercia: number) {
  const v = serieSuave(semilla, n, inercia, 0.05, 1);
  const r = rng(semilla ^ 0x51ab);
  const paso = ancho / (n - 1);
  return v.map((t, i) => {
    const a = (t * alto) / 2 * (r() < 0.1 ? 1.5 : 1);
    const off = (r() - 0.5) * alto * 0.1;
    return { x: p2(i * paso), y1: p2(-a + off), y2: p2(a + off), o: p2(0.35 + r() * 0.6) };
  });
}
const ondaLock = onda(811, 114, 11, 118, 0.42);
const ondaTrack = onda(907, 114, 15, 130, 0.3);
const ondaIdle = onda(1013, 114, 20, 126, 0.18);

/* ── 02 · diagramas ─────────────────────────────────────────────────────── */

/** BLINK — párpado: lente de dos arcos, relleno de puntos en hileras. */
function blink(semilla: number) {
  const r = rng(semilla);
  const contornos = Array.from({ length: 7 }, (_, i) => {
    const k = 0.24 + i * 0.126;
    return { rx: p2(64 * k + 4), ry: p2(37 * k), o: p2(0.5 - i * 0.05) };
  });
  const puntos: { x: number; y: number; r: number; o: number }[] = [];
  for (let f = -13; f <= 13; f++) {
    const yy = f * 2.65;
    const t = 1 - Math.abs(f) / 14;
    const semi = 66 * Math.pow(t, 0.62);
    const n = Math.round(semi / 2.1);
    for (let i = -n; i <= n; i++) {
      const x = (i / (n || 1)) * semi;
      if (r() > 0.52) continue;
      puntos.push({
        x: p2(x), y: p2(yy),
        r: p2(0.3 + r() * 0.55),
        o: p2(0.12 + r() * 0.6 * (0.35 + t)),
      });
    }
  }
  const nucleo = Array.from({ length: 130 }, () => ({
    x: p2((r() - 0.5) * 30), y: p2((r() - 0.5) * 11),
    r: p2(0.3 + r() * 0.8), o: p2(0.2 + r() * 0.75),
  }));
  return { contornos, puntos, nucleo };
}
const dBlink = blink(4111);

/** SCAN — barrido polar: aros achatados, radios, y una cuña encendida. */
function scan(semilla: number) {
  const r = rng(semilla);
  const aros = Array.from({ length: 8 }, (_, i) => ({
    rx: p2(52 * Math.pow(0.9, i)), ry: p2(36 * Math.pow(0.905, i)),
    o: p2(0.18 + r() * 0.55), w: p2(0.32 + (r() < 0.3 ? 0.4 : 0)),
    dx: p2((r() - 0.5) * 7),
  }));
  const radios = Array.from({ length: 26 }, (_, i) => {
    const a = (i * Math.PI * 2) / 26;
    const r0 = 6 + r() * 6;
    const r1 = 30 + r() * 22;
    return {
      x1: p2(Math.cos(a) * r0), y1: p2(Math.sin(a) * r0 * 0.7),
      x2: p2(Math.cos(a) * r1), y2: p2(Math.sin(a) * r1 * 0.7),
      o: p2(0.08 + r() * 0.3),
    };
  });
  const arcos = Array.from({ length: 9 }, () => {
    const a0 = r() * Math.PI * 2;
    const ext = 0.5 + r() * 2.1;
    const rad = 14 + r() * 34;
    const pts = Array.from({ length: 14 }, (_, k) => {
      const a = a0 + (ext * k) / 13;
      return `${k ? "L" : "M"}${p2(Math.cos(a) * rad)} ${p2(Math.sin(a) * rad * 0.72)}`;
    }).join("");
    return { d: pts, o: p2(0.2 + r() * 0.6), w: p2(0.35 + r() * 0.55) };
  });
  const cuna = Array.from({ length: 46 }, () => {
    const a = -0.55 + r() * 1.1;
    const rad = 18 + r() * 26;
    return {
      x: p2(Math.cos(a) * rad), y: p2(Math.sin(a) * rad * 0.72),
      r: p2(0.4 + r() * 1.3), o: p2(0.3 + r() * 0.7),
    };
  });
  return { aros, radios, arcos, cuna };
}
const dScan = scan(4703);

/** PULSE — expansión: aro doble y rayos con guiones hacia afuera. */
function pulse(semilla: number) {
  const r = rng(semilla);
  const aros = Array.from({ length: 6 }, (_, i) => ({
    rx: p2(38 - i * 4.4), ry: p2(30 - i * 3.6),
    o: p2(0.2 + r() * 0.55), w: p2(0.32 + (r() < 0.3 ? 0.4 : 0)),
  }));
  const rayos = Array.from({ length: 44 }, (_, i) => {
    const a = (i * Math.PI * 2) / 44 + (r() - 0.5) * 0.03;
    const r0 = 40 + r() * 4;
    const r1 = r0 + 5 + r() * 20;
    return {
      x1: p2(Math.cos(a) * r0), y1: p2(Math.sin(a) * r0 * 0.79),
      x2: p2(Math.cos(a) * r1), y2: p2(Math.sin(a) * r1 * 0.79),
      o: p2(0.15 + r() * 0.65), w: p2(0.4 + r() * 0.8),
    };
  });
  const motas = Array.from({ length: 120 }, () => {
    const a = r() * Math.PI * 2;
    const rad = 26 + Math.pow(r(), 0.7) * 34;
    return {
      x: p2(Math.cos(a) * rad), y: p2(Math.sin(a) * rad * 0.79),
      r: p2(0.3 + r() * 0.7), o: p2(0.12 + r() * 0.6),
    };
  });
  return { aros, rayos, motas };
}
const dPulse = pulse(5309);

/* ── 03 · glifos de la fila de abajo ────────────────────────────────────── */

function puntosAnillo(n: number, rad: number, semilla: number, ex = 1) {
  const r = rng(semilla);
  return Array.from({ length: n }, (_, i) => {
    const a = (i * Math.PI * 2) / n;
    const rr = rad * (0.94 + r() * 0.12);
    return { x: p2(Math.cos(a) * rr), y: p2(Math.sin(a) * rr * ex), r: p2(0.4 + r() * 0.5), o: p2(0.3 + r() * 0.6) };
  });
}
const gRetina = {
