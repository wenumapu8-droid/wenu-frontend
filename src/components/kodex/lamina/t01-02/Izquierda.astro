  rayos: Array.from({ length: 24 }, (_, i) => {
    const a = (i * Math.PI * 2) / 24;
    return { x1: p2(Math.cos(a) * 12), y1: p2(Math.sin(a) * 12), x2: p2(Math.cos(a) * 22), y2: p2(Math.sin(a) * 22) };
  }),
};
