/* Barra de marcas de la fila 1 de iconos: no es un código de barras real,
   es la tira de guiones y rombos que la referencia repite bajo cada rótulo. */
function tira(semilla: number, ancho: number) {
  const r = rng(semilla);
  const out: { x: number; w: number; o: number }[] = [];
  let x = 0;
  while (x < ancho) {
    const w = 0.7 + r() * 2.6;
    if (r() > 0.32) out.push({ x: p2(x), w: p2(w), o: p2(0.3 + r() * 0.6) });
    x += w + 0.7 + r() * 1.7;
  }
  return out;
}

