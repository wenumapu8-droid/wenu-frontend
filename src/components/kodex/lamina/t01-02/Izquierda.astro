<style>
  /* `position:absolute` explícito: el estilo con ámbito del componente gana por
     orden de cascada a `.kdx-lam [data-box]`, y con `relative` el bloque se
     acomoda en el flujo y aparece desplazado. */
  .oe {
    position: absolute;
    overflow: hidden;
    box-sizing: border-box;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    color: #6f6c68;
    --pu: #a45fd8;
    --cy: #12b6c6;
    --wh: #c6c6c6;
    --rj: #c2382e;
  }
  .oe :global(*) { box-sizing: border-box; }

  /* ── marcos ──────────────────────────────────────────────────────────── */
  /* El filete de las tres secciones NO tiene el mismo peso: 27 · 15 · 14 de
     luminancia medidos en la referencia. Es el gradiente de la lámina, no
     ruido, y aplanarlo se nota en el diff estructural. */
  .oe__frame {
    position: absolute;
    border: 1px solid #1c1a1b;
    border-left-width: 2px;
    border-left-color: #232323;
  }
  .oe__frame--b { border-color: #100f10; border-left-color: #232323; }
  .oe__frame--c { border-color: #0f0e0f; border-left-color: #232323; }

  .oe__rule { position: absolute; height: 1px; }
  .oe__rule--a { background: #161615; box-shadow: 0 -1px 0 #100f0f; }
  .oe__rule--b { background: #131213; }
  .oe__rule--c { background: #0c0b0c; }

  .oe__vdiv { position: absolute; width: 1px; background: #191818; }
  .oe__vdiv--tbl { background: #131212; }
  .oe__hair { position: absolute; height: 1px; background: #131212; }
  .oe__hair--tbl { background: #0a090a; }

  /* ── títulos de sección ──────────────────────────────────────────────── */
  .oe__h1 {
    position: absolute;
    font-size: 11px; line-height: 12px; letter-spacing: -0.25px;
    color: #9c62cc; white-space: nowrap;
  }
  .oe__h1--c { color: #8f5abb; }

  /* ── 01 · tarjetas de estado ─────────────────────────────────────────── */
  .oe__mark { position: absolute; display: block; }
  .oe__mark--lock { color: #a054cf; }
  .oe__mark--track { color: #0f9ea6; }
  .oe__mark--idle { color: #a9a9a9; }

  .oe__card {
    position: absolute; left: 78px; width: 372px; height: 53px;
    border: 1px solid var(--b);
    color: var(--t);
  }
  .oe__card--lock { --b: #341648; --t: #b84cf0; --h: #2a0b45; }
  .oe__card--track { --b: #0f3138; --t: #0dc0d6; --h: #06333c; }
  .oe__card--idle { --b: #2e2d2d; --t: #cfcfcf; --h: #232323; }

  .oe__rot {
    position: absolute; left: 22px; top: 3px;
    font-size: 21px; line-height: 22px; letter-spacing: -1.6px;
    color: var(--t);
    text-shadow: 0 0 4px color-mix(in srgb, var(--t) 26%, transparent);
  }
  .oe__sub {
    position: absolute; right: 106px; top: 8px;
    font-size: 9px; line-height: 10px; letter-spacing: -0.4px;
    color: #8b8a89; white-space: nowrap;
  }
  .oe__kv {
    position: absolute; right: 108px; top: 26px;
    font-size: 9px; line-height: 10px; letter-spacing: -0.4px;
    color: #8b8a89; white-space: nowrap;
  }
  .oe__val {
    position: absolute; right: 118px; top: 35px;
    font-size: 12px; line-height: 13px; letter-spacing: -0.1px;
    color: var(--t); white-space: nowrap;
  }
  .oe__wave { position: absolute; left: 12px; display: block; color: var(--t); }

  .oe__cardsplit {
    position: absolute; left: 191px; top: 0; width: 2px; height: 100%;
    background: linear-gradient(90deg, #4a4a4a, #262626);
    opacity: 0.55;
  }

  .oe__thumb {
    position: absolute; left: 193px; top: 0; width: 178px; height: 51px;
    overflow: hidden; color: var(--t);
    background: radial-gradient(84% 150% at 50% 50%, var(--h) 0%, #05040a 78%, #000 100%);
  }
  .oe__thumb svg { display: block; }
  .oe__spec { fill: #ffffff; opacity: 0.9; }
  .oe__card--idle .oe__thumb { background: radial-gradient(84% 150% at 50% 50%, #262626 0%, #070707 78%, #000 100%); }

  /* ── 02 · notas de movimiento ────────────────────────────────────────── */
  .oe__ch {
    position: absolute;
    font-size: 12px; line-height: 11px; letter-spacing: 0.35px;
    color: #8a8a88; text-align: center;
  }
  .oe__dia { position: absolute; width: 140px; height: 80px; color: #a154d6; }
  .oe__dia svg { display: block; }
  .oe__grid { stroke: #171320; stroke-width: 0.4; fill: none; }
  .oe__grid--g { stroke: #14101c; }

  .oe__tl {
    position: absolute;
    font-size: 9px; line-height: 10px; letter-spacing: -0.35px;
    color: #767573; white-space: nowrap;
  }
  .oe__tv {
    position: absolute;
    font-size: 9.5px; line-height: 10px; letter-spacing: -0.1px;
    color: #8e8d8b; white-space: nowrap;
  }
  .oe__tb {
    position: absolute;
    font-size: 8.2px; line-height: 10px; letter-spacing: -0.5px;
    color: #767573; white-space: nowrap;
  }

  /* ── 03 · chips e iconos ─────────────────────────────────────────────── */
  .oe__chip {
    position: absolute;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid #2a1a33;
    font-size: 9px; letter-spacing: -0.2px;
    color: #8d68a8; white-space: nowrap;
  }
  .oe__chip--rojo { border-color: #3b1310; color: #b2382c; }

  .oe__ibox { position: absolute; border: 1px solid #232222; color: #8d8c8b; }
  .oe__ia {
