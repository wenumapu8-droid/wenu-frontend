import { rng, serieSuave, p2 } from "../kit/rng";
import Waveform from "../kit/Waveform.astro";
import Micrografia from "../kit/Micrografia.astro";

interface Props { box: string }
const { box } = Astro.props;

/* ══════════════════════════════════════════════════════════════════════════
   AGRUPADOR — N marcas → 5 <path>, uno por cubo de opacidad
   ══════════════════════════════════════════════════════════════════════════ */

type Marca = { d: string; o: number; w: number };

function cubos(marcas: Marca[], n = 5) {
  const out = Array.from({ length: n }, () => ({ d: "", o: 0, w: 0, k: 0 }));
  for (const m of marcas) {
    const i = Math.min(n - 1, Math.floor(m.o * n));
    out[i].d += m.d;
    out[i].o += m.o;
    out[i].w += m.w;
    out[i].k += 1;
  }
  return out
    .filter((c) => c.k > 0)
    .map((c) => ({ d: c.d, o: p2(c.o / c.k), w: p2(c.w / c.k) }));
}

const seg = (x1: number, y1: number, x2: number, y2: number) =>
  `M${p2(x1)} ${p2(y1)}L${p2(x2)} ${p2(y2)}`;

/* ══════════════════════════════════════════════════════════════════════════
   EL ORGANISMO — un solo ojo, once encuadres
   ══════════════════════════════════════════════════════════════════════════ */

function organismo(semilla: number) {
  const r = rng(semilla);

  /* Fibras del iris: del borde de la pupila (11) hasta ~38. La longitud va con
     raíz para que se apelmacen cerca del núcleo, como en la referencia.
     MUCHAS y CORTAS: la primera versión salió con 1.150 rayos largos y el tile
     se leía como estallido de estrella, no como un iris. Lo que separa las dos
     lecturas es la relación entre el largo de la fibra y su separación, no el
     brillo. */
  const fib: Marca[] = [];
  for (let i = 0; i < 2400; i++) {
    const a = r() * Math.PI * 2;
    const r0 = 15.4 + Math.pow(r(), 1.6) * 4;
    const r1 = Math.min(27, r0 + 1.6 + Math.pow(r(), 0.8) * 10);
    /* Caída de brillo hacia afuera: sin ella el iris no tiene borde y las
       fibras se leen como rayos de sol. El limbo del ojo es un LÍMITE. */
    const caida = 1 - 0.42 * ((r1 - 16) / 11);
    const o = (0.05 + Math.pow(r(), 1.15) * 0.82) * caida;
    fib.push({
      d: seg(Math.cos(a) * r0, Math.sin(a) * r0, Math.cos(a) * r1, Math.sin(a) * r1),
      o, w: p2(0.22 + o * 0.6 + r() * 0.18),
    });
  }

  /* Radios exteriores: del limbo (27) hacia afuera, largos y separados. Son las
     «grietas» de GLITCH MAP y los rayos de NEON ENERGY — la misma capa.
     La proporción que importa es pupila/limbo ≈ 0,55: medida en la referencia,
     el disco negro central pesa la mitad del anillo brillante. Con la pupila a
     0,28 (primera pasada) las once miniaturas se leían como soles y no como
     ojos, por mucho que la densidad total diera bien. */
  const cor: Marca[] = [];
  for (let i = 0; i < 330; i++) {
    const a0 = (i / 330) * Math.PI * 2 + (r() - 0.5) * 0.08;
    const fin = 30 + 4 + Math.pow(r(), 0.7) * 26;
    const oo = 0.06 + Math.pow(r(), 1.25) * 0.74;
    /* CORTADO, no continuo. Un radio entero de 27 a 55 dibuja un rayo de sol;
       el campo exterior de la referencia son filamentos rotos, con huecos y con
       la dirección desviándose un poco a cada tramo. La diferencia entre las
       dos lecturas es sólo esta: dónde se corta la línea. */
    let rad = 26.5 + r() * 3;
    let a = a0;
    while (rad < fin) {
      const largo = 1.6 + Math.pow(r(), 0.8) * 7;
      const a2 = a + (r() - 0.5) * 0.05;
      const o = oo * (0.45 + r() * 0.85) * (1 - 0.35 * ((rad - 27) / 30));
      cor.push({
        d: seg(Math.cos(a) * rad, Math.sin(a) * rad,
               Math.cos(a2) * (rad + largo), Math.sin(a2) * (rad + largo)),
        o: Math.max(0.02, Math.min(0.96, o)), w: p2(0.3 + o * 1.15 + r() * 0.3),
      });
      rad += largo + (0.4 + Math.pow(r(), 1.6) * 5.5);
      a = a2;
    }
  }

  /* Halo: marcas cortas TANGENCIALES fuera de la corona. Son las que dan grano
     al campo exterior; sin ellas los aros quedan solos y la textura se ve
     radial de punta a punta. */
  const hal: Marca[] = [];
  for (let i = 0; i < 900; i++) {
    const a = r() * Math.PI * 2;
    const rad = 40 + Math.pow(r(), 0.75) * 100;
    const dl = (0.02 + r() * 0.06) * (r() < 0.5 ? 1 : -1);
    const o = 0.04 + Math.pow(r(), 1.5) * 0.5;
    hal.push({
      d: seg(Math.cos(a) * rad, Math.sin(a) * rad * 0.9,
             Math.cos(a + dl) * rad, Math.sin(a + dl) * rad * 0.9),
      o, w: p2(0.25 + o * 0.7),
    });
  }

  /* Salpicadura: lo que da la mancha fuera del iris. Cuadraditos, no círculos:
     un <circle> por mota son 1.900 nodos y esto es un solo path. */
  const mot: Marca[] = [];
  for (let i = 0; i < 2600; i++) {
    const a = r() * Math.PI * 2;
    const rad = 17 + Math.pow(r(), 0.75) * 128;
    const s = p2(0.4 + Math.pow(r(), 2.2) * 1.6);
    const x = p2(Math.cos(a) * rad), y = p2(Math.sin(a) * rad * 0.88);
    mot.push({ d: `M${x} ${y}h${s}v${s}h-${s}z`, o: 0.04 + Math.pow(r(), 1.4) * 0.66, w: 0 });
  }

  /* Aros punteados en progresión geométrica 0.93 (regla del kit; repartidos de
     a uno se leen como diana). Llegan a 172 porque en la pantalla del teléfono
     los aros salen del encuadre por los cuatro lados. */
  const aros: { r: number; o: number; w: number; g: string }[] = [];
  let rr = 172;
  for (let i = 0; i < 22; i++) {
    aros.push({
      r: p2(rr), o: p2(0.08 + r() * 0.42), w: p2(0.28 + (r() < 0.28 ? 0.42 : 0)),
      g: `${p2(0.5 + r() * 3.4)} ${p2(0.9 + r() * 4.2)}`,
    });
    rr *= 0.93;
  }

  /* La veta: el ojo sale por los dos lados como una onda tumbada. */
  const veta: Marca[] = [];
  for (let i = 0; i < 230; i++) {
    const x = -150 + (i * 300) / 229;
    const d = Math.abs(x);
    const g = d < 13 ? 0.35 : Math.max(0, 1 - (d - 13) / 135);
    const h = (0.5 + r() * 5.2) * g * (r() < 0.12 ? 2.5 : 1);
    const o = 0.12 + r() * 0.8;
    veta.push({ d: seg(x, -h, x, h), o, w: p2(0.35 + o * 0.9) });
  }

  /* Venas / párpado: arcos larguísimos de radio grande, los que cruzan la
     primera miniatura de lado a lado. */
  const ven: Marca[] = [];
  for (let i = 0; i < 11; i++) {
    const R = 62 + r() * 105;
    const a0 = r() * Math.PI * 2;
    const sp = 0.5 + r() * 1.7;
    const cx = (r() - 0.5) * 70, cy = (r() - 0.5) * 46;
    const pts: string[] = [];
    for (let k = 0; k <= 18; k++) {
      const a = a0 + (sp * k) / 18;
      pts.push(`${k ? "L" : "M"}${p2(cx + Math.cos(a) * R)} ${p2(cy + Math.sin(a) * R * 0.82)}`);
    }
    const o = 0.08 + r() * 0.42;
    ven.push({ d: pts.join(""), o, w: p2(0.45 + o * 2.2) });
  }

  /* Arcos de instrumento: tramos de circunferencia CONTINUOS y brillantes, no
     aros enteros. Son la firma que distingue las miniaturas de la referencia de
     un simple estallido — cada recorte tiene dos o tres arcos gruesos cruzando
     el encuadre. Sin ellos el tile se lee como estrella y el diff estructural
     lo cobra en los bloques de 8×8 del borde. */
  const arc: Marca[] = [];
  for (let i = 0; i < 20; i++) {
    const R = 26 + Math.pow(r(), 0.8) * 120;
    const a0 = r() * Math.PI * 2;
    const sp = 0.7 + r() * 2.6;
    const pts: string[] = [];
    for (let k = 0; k <= 26; k++) {
      const a = a0 + (sp * k) / 26;
      pts.push(`${k ? "L" : "M"}${p2(Math.cos(a) * R)} ${p2(Math.sin(a) * R * 0.9)}`);
    }
    const o = 0.16 + Math.pow(r(), 0.9) * 0.72;
    arc.push({ d: pts.join(""), o, w: p2(0.4 + o * 1.5) });
  }

  return {
    fib: cubos(fib), cor: cubos(cor), hal: cubos(hal, 4), mot: cubos(mot, 4),
    aros, arc: cubos(arc, 4), veta: cubos(veta), ven: cubos(ven, 3),
  };
}

const OJO = organismo(2207);

