/* PIXEL SORT no es un recorte del ojo: es el ojo arrastrado en horizontal.
   Filas de barras de largo irregular que caen desde la silueta del iris. */
function pixelSort(semilla: number, w: number, h: number) {
  const r = rng(semilla);
  const filas: { y: number; x: number; w: number; o: number; c: number; alto: number }[] = [];
  const cy = h * 0.52, rx = w * 0.34, ry = h * 0.42;
  for (let y = 1; y < h - 1; y += 1) {
    const t = (y - cy) / ry;
    if (Math.abs(t) > 1) continue;
    const media = Math.sqrt(1 - t * t) * rx;
    const n = 2 + Math.floor(r() * 4);
    for (let k = 0; k < n; k++) {
      const x0 = w * 0.04 + r() * media * 1.1;
      const largo = media * (0.14 + r() * 0.85) * (r() < 0.12 ? 2.1 : 1);
      filas.push({
        y: p2(y), x: p2(x0), w: p2(Math.min(largo, w - x0 - 1)),
        o: p2(0.18 + r() * 0.78), c: r(), alto: r() < 0.2 ? 2 : 1,
      });
    }
  }
  return filas;
}
const PIXELS = pixelSort(4409, ANCHO, 77);

/* SCANLINE lleva encima las bandas horizontales que le dan el nombre. */
const SCANLINES = Array.from({ length: 26 }, (_, i) => p2(1.5 + i * 2.9));

/* BITMAP NOISE: trama de puntos ordenada (Bayer-ish) recortada por el iris. */
function trama(semilla: number, w: number, h: number) {
  const r = rng(semilla);
  const p: string[] = [];
  for (let y = 1; y < h; y += 2) {
    for (let x = 1 + (y % 4 === 1 ? 0 : 1); x < w; x += 2) {
      const dx = (x - w * 0.5) / (w * 0.46), dy = (y - h * 0.5) / (h * 0.46);
      const d = Math.hypot(dx, dy);
      if (d > 1.05) continue;
      if (r() > 0.28 + 0.55 * Math.abs(Math.sin(d * 5.4))) continue;
      p.push(`M${x} ${y}h1v1h-1z`);
    }
  }
  return p.join("");
}
const TRAMA = trama(5501, ANCHO, 77);

/* HALFTONE: el mismo ojo pero resuelto en puntos de tamaño variable. */
function halftone(semilla: number, w: number, h: number) {
  const r = rng(semilla);
  const p: { d: string; o: number }[] = [];
  for (let y = 1.2; y < h; y += 1.9) {
    for (let x = 1.2; x < w; x += 1.9) {
      const dx = (x - w * 0.5) / (w * 0.42), dy = (y - h * 0.5) / (h * 0.42);
      const d = Math.hypot(dx, dy);
      if (d > 1.25) continue;
      /* anillo brillante entre 0,45 y 0,95: el iris. Pupila negra. */
      const v = d < 0.4 ? 0.02 : Math.max(0, 1 - Math.abs(d - 0.8) / 0.62) * (0.4 + r() * 0.9);
      if (v < 0.12) continue;
      const s = p2(0.5 + v * 1.7);
      p.push({ d: `M${p2(x)} ${p2(y)}h${s}v${s}h-${s}z`, o: p2(Math.min(0.95, v)) });
    }
  }
  return cubos(p.map((q) => ({ ...q, w: 0 })), 4);
}
