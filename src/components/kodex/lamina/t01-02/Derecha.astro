/**
 * SPECTRUM ANALYSIS · cresta apilada.
 *
 * No es un gráfico de barras: son ~24 perfiles espectrales dibujados uno detrás
 * del otro, cada uno un poco más arriba y a la izquierda, del fondo al frente.
 * El color no va por capa sino por posición horizontal — turquesa a la
 * izquierda, blanco en el pico central, violeta y azul a la derecha — así que
 * todos comparten un degradado horizontal.
 */
function crestas(semilla: number, w: number, h: number, n: number) {
  const r = rng(semilla);
  const M = 150;
  /* perfil común: dónde están los picos del espectro */
  const picos = [
    { c: 0.09, a: 0.62, s: 0.016 }, { c: 0.15, a: 0.3, s: 0.02 },
    { c: 0.24, a: 0.44, s: 0.022 }, { c: 0.3, a: 0.98, s: 0.012 },
    { c: 0.33, a: 0.55, s: 0.018 }, { c: 0.37, a: 0.7, s: 0.014 },
    { c: 0.43, a: 0.42, s: 0.026 }, { c: 0.52, a: 0.3, s: 0.03 },
    { c: 0.62, a: 0.26, s: 0.034 }, { c: 0.73, a: 0.28, s: 0.03 },
    { c: 0.84, a: 0.2, s: 0.036 },
  ];
  const capas: { d: string; o: number; w: number }[] = [];
  for (let k = n - 1; k >= 0; k--) {
    const dx = -k * 0.34;
    const base = h - 2 - k * 0.42;
    const cima = base;
    const g = 1 - k / (n + 5);
    const pts: string[] = [`M${p2(dx)} ${p2(base)}`];
    for (let i = 0; i <= M; i++) {
      const t = i / M;
      let v = 0.012;
      for (const p of picos) {
        const u = (t - p.c - k * 0.0016) / p.s;
        v += p.a * Math.exp(-u * u * 0.5) * (0.55 + 0.75 * r());
      }
      v += Math.pow(r(), 3) * 0.06;
      v *= g * (0.5 + 0.85 * Math.exp(-Math.pow((t - 0.3) / 0.36, 2)));
      pts.push(`L${p2(dx + t * w)} ${p2(Math.max(2, cima - v * (h - 8)))}`);
    }
    pts.push(`L${p2(dx + w)} ${p2(base)}Z`);
    capas.push({ d: pts.join(""), o: p2(0.14 + g * 0.34), w: p2(0.28 + g * 0.34) });
  }
  return capas;
}
