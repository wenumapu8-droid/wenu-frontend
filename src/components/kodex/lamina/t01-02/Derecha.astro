/* SPECTRAL RANGE no es un peine centrado: es un espectro apoyado en la base,
   con picos agrupados a la izquierda y una cola de puntos a la derecha. */
function espectroBanda(semilla: number, w: number, base: number, altoMax: number) {
  const r = rng(semilla);
  /* Al cuadrado, igual que la envolvente del kit: la referencia tiene racimos
     de picos y tramos de silencio, no una empalizada pareja. */
  const crudo = serieSuave(semilla ^ 0x77, 210, 0.93, 0, 1);
  const lo = Math.min(...crudo), hi = Math.max(...crudo);
  const env = crudo.map((v) => 0.1 + 0.9 * Math.pow((v - lo) / (hi - lo || 1), 1.4));
  const barras: Marca[] = [];
  for (let i = 0; i < 210; i++) {
    const x = p2((i * w) / 209);
    const caida = 1 - Math.pow(i / 209, 0.8) * 0.78;
    const h = env[i] * altoMax * caida * (r() < 0.1 ? 2.1 : 0.55 + r() * 0.95);
    if (h < 0.7) continue;
    const o = 0.14 + r() * 0.72;
    barras.push({ d: seg(x, base, x, base - h), o, w: p2(0.35 + o * 0.7) });
  }
  const motas: Marca[] = [];
  for (let i = 0; i < 320; i++) {
    const x = p2(r() * w);
    const t = x / w;
    const y = p2(base - Math.pow(r(), 1.6) * altoMax * (1 - t * 0.5));
    motas.push({ d: `M${x} ${y}h0.8v0.8h-0.8z`, o: 0.1 + r() * 0.65, w: 0 });
  }
  return { barras: cubos(barras), motas: cubos(motas, 3) };
}
