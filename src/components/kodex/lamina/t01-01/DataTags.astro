---
/**
 * KODEX-∞ · t01-01 THRESHOLD PORTAL · 09. DATA TAGS / ETIQUETAS DE DATOS
 *
 * Caja medida: 9,792 751×70. Las coordenadas de este archivo están corridas
 * −9,−792 respecto del póster.
 *
 * Todo lo que lleva una coordenada salió de barrer el PNG de referencia fila
 * por fila y columna por columna:
 *
 *  · El marco del panel NO coincide con la caja. Su filo superior cae en
 *    y=788,5 y el inferior en y=866, o sea CUATRO filas por encima y cinco por
 *    debajo de la caja medida; el canto derecho vive en x=760, una columna
 *    afuera. Se dibujan donde están —el marco es del póster, no de la caja— y
 *    por eso este panel no recorta: la franja que ocupan no pertenece a ningún
 *    otro panel de la lámina.
 *
 *  · Los ocho chips no están repartidos a paso fijo. Sus cantos verticales
 *    medidos son 21·95,8 / 105·171,5 / 180,5·249,5 / 258,5·373,5 / 383·470,5 /
 *    479,5·558 / 567·659,5 / 669·749, o sea anchos de 74,8 a 115 px según lo
 *    que diga la etiqueta. Repartirlos parejo es lo primero que delata una
 *    reconstrucción.
 *
 *  · Cada etiqueta lleva su propio ancho de tinta medido. Van con textLength
 *    porque a 7 px de versal Chromium redondea el avance de la mono al píxel
 *    entero y una fila de catorce caracteres se va siete por ciento larga.
 */
import Trazo from "./Trazo.astro";
import { rotulo } from "./tipografia";
import { titDT } from "./arte";

interface Props { box: string }
const { box } = Astro.props;

/* [etiqueta, x del primer píxel de tinta, ancho de avance, canto izquierdo del
   chip, canto derecho]. Todo en coordenadas de la caja. */
const chips: [string, number, number, number, number][] = [
  ["REALM: UNKNOWN", 17, 67, 12.5, 86.8],
  ["CLASS: UMBRAL", 99, 61, 96.0, 162.5],
  ["TYPE: PORTAL", 177, 56, 171.5, 240.5],
  ["ORIGIN: NON-EUCLIDEAN", 255, 101, 249.5, 364.5],
  ["THREAT: VARIABLE", 381, 76, 374.0, 461.5],
  ["ACCESS: RITUAL", 475, 67, 470.5, 549.0],
  ["ENERGY: ENTANGLED", 564, 80, 558.0, 650.5],
  ["ENTITY: WATCHER", 664, 71, 660.0, 740.0],
];

/* Los chips: filo superior en y=817,75 e inferior en y=837,95 del póster
   (25,75 y 45,95 acá). Salen de que la fila 817 lleva 72 de luminancia y la 818
   lleva 23: un trazo de 1 px a tres cuartos de píxel de la retícula. */
const CHIP_Y = 25.75;
const CHIP_H = 20.2;
/* Cima de la versal de las etiquetas: y=824 del póster. Versal de 7 filas. */
const CHIP_TEXTO = 32;
---

<div data-box style={box} class="dtag">
  <svg class="dtag__art" viewBox="0 0 751 70" width="751" height="70" aria-hidden="true">
    <!-- Marco del panel. Sale de la caja por arriba y por abajo porque ahí es
         donde está en el original (ver cabecera del archivo). -->
    <rect class="dtag__marco" x="3" y="-4" width="1.75" height="79" />
    <rect class="dtag__marco dtag__marco--der" x="751" y="-4" width="1" height="79" />
    <rect class="dtag__marco dtag__marco--sup" x="3" y="-4" width="735" height="1.9" />
    <rect class="dtag__marco dtag__marco--inf" x="3" y="74" width="748" height="1" />

    <!-- Regla bajo el título: de x=19 a x=750 del póster, y=811,4. -->
    <rect class="dtag__regla" x="10" y="19.2" width="732" height="1.5" />

    <!-- El título va partido en dos: el ordinal como texto de verdad, porque
         es una cifra, y el resto trazado del original. Como texto entero el
         rótulo dejaba 8,83 % de residuo contra el 2,71 % del trazo — la mono
         del póster no existe en ninguna máquina y a 9 px de versal el parecido
         de familia no alcanza. El texto real del trazo vive en su aria-label. -->
    <text class="dtag__num" data-symbolic="true" {...rotulo(13, 5, 9, 19)}>09.</text>
    <Trazo glifos={titDT} etiqueta="DATA TAGS / ETIQUETAS DE DATOS" />

    <!-- Las etiquetas son rótulos del póster, no una lectura de nada: THREAT,
         ACCESS o ENERGY no reportan estado de ningún sistema. -->
    <g data-symbolic="true">
      {chips.map(([t, x, ancho, izq, der]) => (
        <>
          <rect class="dtag__chip" x={izq} y={CHIP_Y} width={der - izq} height={CHIP_H} />
          <text class="dtag__tag" {...rotulo(x, CHIP_TEXTO, 7, ancho)}>{t}</text>
        </>
      ))}
    </g>
  </svg>
</div>

<style>
  /* El marco del panel sale de la caja por arriba y por abajo (ver cabecera).
     Entre este panel y el de arriba —que muere en y=778— y entre éste y el pie
     —que empieza en y=880— no hay ningún otro panel. */
  .dtag { overflow: visible; }

  .dtag__art { position: absolute; left: 0; top: 0; overflow: visible; }

  /* Tinta medida sobre el PNG, no elegida. Los cuatro cantos del marco tienen
     brillos distintos en el original y van uno por uno. */
  .dtag__marco { fill: #1e1e1e; }
  .dtag__marco--der { fill: #1b1b1b; }
  .dtag__marco--sup { fill: #191919; }
  .dtag__marco--inf { fill: #141414; }
  .dtag__regla { fill: #121212; }

  .dtag__chip {
    fill: none;
    stroke: #551006;
    stroke-width: 1;
  }

  .dtag__num,
  .dtag__tag {
    font-family: var(--lam-mono);
    font-variant-ligatures: none;
    white-space: pre;
    /* Un píxel de desenfoque reproduce el derrame del raster del póster. Por
       debajo de 0,8 px Chromium colapsa el núcleo del filtro a una caja de 1 px
       y no hace nada: 0 · 0,4 · 0,7 px dan la misma captura. */
    filter: blur(1px);
  }
  .dtag__num { fill: #b4180c; }
  .dtag__tag { fill: #5a4838; }
</style>
