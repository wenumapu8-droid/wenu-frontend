---
/**
 * KODEX-∞ · t01-01 THRESHOLD PORTAL · panel 01 — SCENE INTENT / INTENCIÓN DE ESCENA
 *
 * Párrafo en mono a la izquierda y el árbol de raíces a la derecha.
 *
 * Todo lo geométrico está MEDIDO sobre reference/canon/t01-01-threshold-portal.png
 * con perfiles de tinta por fila y por columna (umbral 7), no estimado. En
 * coordenadas de la lámina, y entre paréntesis relativas a la caja (9, 87):
 *
 *   marco             x 12→470 (3→461) · y 87→237 (0→150); el filete izquierdo
 *                     son DOS columnas, no una
 *   título            tinta desde x 22 (13), altos y 95→103 (8→16)
 *   filete bajo tít.  y 109-110 (22-23), de x 12 a x 471 — se sale un píxel
 *                     de la caja por la derecha, y en el original también
 *   cuerpo            tinta desde x 26 (17); altos de línea
 *                     y 121·135·148·162·176·190 | 205·219
 *                     → paso 13,8 px y UN salto extra entre los dos párrafos
 *   avance del cuerpo 6,12 px/carácter, medido sobre las cuatro líneas largas
 *   árbol             x 312→431, y 111→236
 *
 * El título NO es de un solo peso: «01. SCENE INTENT /» va en rojo y bold (9
 * filas de altura de caja) y «INTENCION DE ESCENA» en gris regular (8 filas).
 *
 * El árbol es arte fija y va TRAZADA, no dibujada: ver trazos/SceneIntentArt.astro.
 */
import Arbol from "./trazos/SceneIntentArt.astro";

interface Props { box: string }
const { box } = Astro.props;

/**
 * [texto, alto de la caja de mayúsculas relativo a la caja del panel, corrección
 * de avance en px].
 *
 * El tercer número no es un gusto: las cuatro primeras líneas del original
 * miden 6,11 px/carácter y las cuatro últimas se van abriendo hasta 6,46. Con
 * un solo avance para las ocho, la línea 8 termina nueve píxeles corta. La
 * corrección es la diferencia medida en el render contra la referencia,
 * repartida entre los huecos de cada línea.
 */
const lineas: Array<[string, number, number]> = [
  ["A MONUMENTAL THRESHOLD EXISTS BETWEEN", 34, 0],
  ["KNOWN SYSTEMS AND FORBIDDEN REALMS.", 48, 0],
  ["THE PORTAL RESPONDS ONLY TO COHERENT", 61, 0],
  ["SIGNAL, INTENT, AND RITUAL ALIGNMENT.", 75, 0],
  ["THIS SCENE IS A LIVING INTERFACE--", 89, 0.15],
  ["PART MACHINE, PART ORGANISM.", 103, 0.19],
  ["YOU DO NOT OPEN IT.", 117, 0.28],
  ["YOU ARE RECOGNIZED BY IT.", 131, 0.37],
];
---

<div data-box style={box} class="si">
  <i class="si__marco"></i>

  <b class="si__t1">01. SCENE INTENT /</b><span class="si__t2">INTENCION DE ESCENA</span>
  <i class="si__filete"></i>

  <div class="si__cuerpo">
    {lineas.map(([t, y, ls]) => <p style={`top:${y}px;letter-spacing:${(-0.167 + ls).toFixed(3)}px`}>{t}</p>)}
  </div>

  <Arbol />
</div>

<style>
  /* `position:absolute` explícito: el estilo con ámbito del componente gana por
     orden de cascada a `.kdx-lam [data-box]`, y con `relative` el panel se
     acomoda en el flujo y aparece corrido por el alto de los anteriores. */
  .si {
    position: absolute;
    overflow: hidden;
    font-family: var(--lam-mono);
  }

  .si__marco {
    position: absolute;
    left: 3px; right: 0; top: 0; bottom: 0;
    border: 1px solid #212121;
    border-left: 2px solid #1d1d1d;
    border-bottom-color: #131313;
  }

  /* El título son DOS tipografías, no una con dos colores: en el original el
     avance del tramo rojo es 7,35 px/carácter y el del gris 6,17 px/carácter.
     Escrito como una sola línea, o el rojo queda corto o el gris se pasa
     quince píxeles del borde del recorte. */
  .si__t1, .si__t2 { position: absolute; white-space: nowrap; }
  .si__t1 {
    left: 13.3px; top: 5.5px;
    font-size: 12px; line-height: 12px;
    letter-spacing: 0.1px;
    font-weight: 700;
    color: #a80f00;
  }
  .si__t2 {
    left: 152.4px; top: 7.5px;
    font-size: 10.3px; line-height: 10.3px;
    letter-spacing: 0px;
    color: #63635e;
  }

  .si__filete {
    position: absolute;
    left: 3px; right: -1px; top: 22px; height: 2px;
    background: linear-gradient(#141414 0 1px, #212121 1px 2px);
  }

  .si__cuerpo { position: absolute; left: 17px; top: -0.4px; }
  .si__cuerpo p {
    position: absolute;
    margin: 0;
    left: 0;
    font-size: 10.2px;
    line-height: 10.2px;
    letter-spacing: -0.167px;
    white-space: nowrap;
    color: #6c6c68;
  }
</style>
