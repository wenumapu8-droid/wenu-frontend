---
/**
 * KODEX-∞ · t01-01 THRESHOLD PORTAL · panel 03 — MOTION VERBS / VERBOS DE MOVIMIENTO
 *
 * Seis columnas: verbo, icono, y tres renglones de descripción.
 *
 * Medido sobre reference/canon/t01-01-threshold-portal.png. Coordenadas de
 * lámina (entre paréntesis, relativas a la caja del panel = 9, 467):
 *
 *   título 03      y 452→460, en el hueco de arriba (fuera de la caja)
 *   marco          x 12→470 (3→461) · y 467 (0) → 567, que cae un píxel FUERA
 *                  por abajo
 *   separadores    x 94 · 168 · 242 · 313 · 390, de y 475 a y 557 (8→90).
 *                  NO están repartidos parejo: los pasos son 74 · 74 · 71,5 ·
 *                  76,5. Es irregularidad de la obra, no ruido de medición —
 *                  con seis columnas iguales tres bloques de texto se corren.
 *   verbos         y 476→482 (9→15)
 *   iconos         y 488→521
 *   renglones      y 527 · 539 · 551 (60 · 72 · 84)
 *
 * Los iconos son arte fija y van TRAZADOS: ver trazos/MotionVerbsArt.astro.
 */
import Iconos from "./trazos/MotionVerbsArt.astro";

interface Props { box: string }
const { box } = Astro.props;

/** [verbo, tres renglones, centro de la columna relativo a la caja] */
const verbos: Array<[string, [string, string, string], number]> = [
  ["PULSE", ["RHYTHMIC", "BREATH OF", "THE GATE."], 47],
  ["REVEAL", ["INFORMATION", "UNFOLDS BY", "LAYER."], 121.5],
  ["DESCEND", ["CAMERA", "DROPS INTO", "THE CORE."], 195.5],
  ["TRANSMIT", ["DATA & ENERGY", "FLOW ACROSS", "THE VEIL."], 269],
  ["RESONATE", ["PATTERN LOCK", "ESTABLISHES", "HARMONY."], 342],
  ["RETURN", ["EMERGE WITH", "NEW CONTEXT /", "REINITIATE."], 416.5],
];

/** separadores, relativos a la caja */
const seps = [85, 159, 233, 304.5, 381];
const yLinea = [59, 70, 83];
---

<div data-box style={box} class="mv">
  <b class="mv__t1">03. MOTION VERBS /</b><span class="mv__t2">VERBOS DE MOVIMIENTO</span>

  <i class="mv__marco"></i>
  {seps.map((x) => <i class="mv__sep" style={`left:${x}px`}></i>)}

  {verbos.map(([v, lineas, c]) => (
    <div class="mv__col" style={`left:${c - 100}px`}>
      <div class="mv__verbo">{v}</div>
      {lineas.map((l, i) => <div class="mv__linea" style={`top:${yLinea[i]}px`}>{l}</div>)}
    </div>
  ))}

  <Iconos />
</div>

<style>
  .mv {
    position: absolute;
    overflow: visible; /* el rótulo 03 vive arriba, en el hueco entre marcos */
    font-family: var(--lam-mono);
  }

  .mv__t1, .mv__t2 { position: absolute; white-space: nowrap; }
  .mv__t1 {
    left: 13.3px; top: -17.5px;
    font-size: 12px; line-height: 12px;
    letter-spacing: -0.19px;
    font-weight: 700;
    color: #ba1100;
  }
  .mv__t2 {
    left: 146.4px; top: -15.5px;
    font-size: 10.3px; line-height: 10.3px;
    letter-spacing: 0px;
    color: #67675f;
  }

  .mv__marco {
    position: absolute;
    left: 3px; right: 0; top: 0; bottom: -1px;
    border: 1px solid #1e1e1e;
    border-left: 2px solid #1d1d1d;
  }

  .mv__sep {
    position: absolute;
    top: 8px; height: 83px; width: 1px;
    background: #2b2b2b;
  }

  /* Cada columna es una caja de 200 px centrada en el centro medido: centrar
     con text-align da una posición estable, y `translateX(-50%)` sobre un
     ancho impar deja el texto a medio píxel y lo emborrona. */
  .mv__col { position: absolute; top: 0; width: 200px; text-align: center; }
  .mv__col > div { position: absolute; left: 0; width: 200px; white-space: nowrap; }

  .mv__verbo {
    top: 9.3px;
    font-size: 8.9px; line-height: 8.9px;
    letter-spacing: 0;
    color: #9fa09e;
  }
  .mv__linea {
    font-size: 8.5px; line-height: 8.5px;
    letter-spacing: 0px;
    color: #727272;
  }
</style>
