---
/**
 * KODEX-∞ · t01-01 THRESHOLD PORTAL · 10. COLOR PALETTE / PALETA
 *
 * Caja medida: 769,792 383×70. Las coordenadas de este archivo están corridas
 * −769,−792 respecto del póster.
 *
 * La decisión que importa acá: las muestras se pintan con el color MEDIDO en el
 * original, no con el hexadecimal que el póster escribe debajo. No coinciden, y
 * la diferencia no es ruido — #FF1A0A rotula una muestra que mide
 * rgb(216,20,13), y #1A1A1A rotula una que mide rgb(0,0,0) con un filo de
 * rgb(23,23,23). El póster imprime su intención y muestra otra cosa; reproducir
 * la lámina es reproducir lo que muestra. El rótulo sí dice lo que el póster
 * dice, que es el otro lado del mismo compromiso.
 *
 * Este panel es el único de la banda que NO lleva regla bajo el título: las
 * filas 808 a 816 del original están vacías. Ponérsela "porque los otros dos la
 * tienen" es exactamente el tipo de regularización que la referencia no tiene.
 */
import Trazo from "./Trazo.astro";
import { rotulo } from "./tipografia";
import { titCP } from "./arte";

interface Props { box: string }
const { box } = Astro.props;

/**
 * [hexadecimal rotulado, x del filo izquierdo, ancho, color medido, x del
 * primer píxel de tinta del rótulo, ancho de avance del rótulo].
 *
 * Los filos no están a paso fijo: medidos en el póster arrancan en 780,6 ·
 * 833,4 · 884,6 · 935 · 985,6 · 1037,2 · 1088,4, o sea pasos de 50,4 a 52,8 px.
 */
const muestras: [string, number, number, string, number, number][] = [
  ["#FF1A0A", 11.6, 43.7, "#d8140d", 12, 39],
  ["#FF5A00", 64.4, 43.0, "#d64d02", 65, 37],
  ["#FFB000", 115.6, 43.0, "#cd8906", 117, 36],
  ["#FF2E2E", 166.0, 43.6, "#d51522", 167, 36],
  ["#FF004B", 216.6, 43.6, "#d60234", 218, 38],
  ["#DADADA", 268.2, 43.0, "#bbbaba", 269, 41],
  ["#1A1A1A", 319.4, 43.0, "#000000", 321, 40],
];

/* Muestras: y=817,8 a 842,3 del póster. */
const MUESTRA_Y = 26.25;
const MUESTRA_H = 24.15;
/* Cima de la versal de los rótulos: y=848 del póster. Versal de 8 filas. */
const ROTULO_Y = 56.2;
---

<div data-box style={box} class="pal">
  <svg class="pal__art" viewBox="0 0 383 70" width="383" height="70" aria-hidden="true">
    <!-- Marco del panel: canto izquierdo en x=769 y derecho en x=1151, o sea
         las dos columnas extremas de la caja. El filo superior cae en y=789,5 y
         el inferior en y=866, fuera de la caja medida, que es donde el original
         los tiene. -->
    <rect class="pal__marco" x="0" y="-3" width="1" height="78" />
    <rect class="pal__marco pal__marco--der" x="382" y="-3" width="1" height="78" />
    <rect class="pal__marco pal__marco--sup" x="0" y="-2.5" width="382" height="1.5" />
    <rect class="pal__marco pal__marco--inf" x="0" y="74" width="383" height="1" />

    <!-- Ordinal como texto —es una cifra— y el resto del título trazado del
         original: como texto entero dejaba 12,25 % de residuo contra 3,39 %. -->
    <text class="pal__num" data-symbolic="true" {...rotulo(9, 7, 9, 19)}>10.</text>
    <Trazo glifos={titCP} etiqueta="COLOR PALETTE / PALETA" />

    <!-- La séptima muestra es negra con filo, no un relleno #1A1A1A: medido, su
         interior da 0 y sólo el contorno lleva tinta. -->
    <g data-symbolic="true" role="img" aria-label="Paleta: #FF1A0A, #FF5A00, #FFB000, #FF2E2E, #FF004B, #DADADA, #1A1A1A">
      {muestras.map(([hex, x, w, color, tx, ancho], i) => (
        <>
          <rect x={x} y={MUESTRA_Y} width={w} height={MUESTRA_H} fill={color} />
          {i === muestras.length - 1 && (
            <rect class="pal__filo" x={x + 0.5} y={MUESTRA_Y + 0.5} width={w - 1} height={MUESTRA_H - 1} />
          )}
          <text class="pal__hex" {...rotulo(tx, ROTULO_Y, 7.5, ancho)} fill={i < 5 ? "#8c2a12" : "#4a4a4a"}>{hex}</text>
        </>
      ))}
    </g>
  </svg>
</div>

<style>
  /* Los filos superior e inferior del marco caen fuera de la caja, donde el
     original los tiene. Esa franja no pertenece a ningún otro panel. */
  .pal { overflow: visible; }

  .pal__art { position: absolute; left: 0; top: 0; overflow: visible; }

  .pal__marco { fill: #1b1b1b; }
  .pal__marco--der { fill: #181818; }
  .pal__marco--sup { fill: #202020; }
  .pal__marco--inf { fill: #141414; }

  .pal__filo { fill: none; stroke: #232323; stroke-width: 1; }

  .pal__num,
  .pal__hex {
    font-family: var(--lam-mono);
    font-variant-ligatures: none;
    white-space: pre;
    /* Un píxel de desenfoque reproduce el derrame del raster del póster. */
    filter: blur(1px);
  }
  .pal__num { fill: #861008; }
</style>
