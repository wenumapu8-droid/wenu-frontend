---
/**
 * KODEX-∞ · t01-01 THRESHOLD PORTAL · panel 05 — RITUAL GLYPHS (SAMPLE SET)
 *
 * Una fila de diez sellos. No son nueve ni once: el barrido de columnas de
 * tinta sobre la banda y 738→775 da diez celdas, con los bordes izquierdos en
 * x 25 · 68 · 112 · 153 · 194 · 237 · 281 · 324 · 380 · 425 — paso ~44 px, y
 * el octavo (el ojo) es más ancho que el paso.
 *
 * Nada de esto está dibujado. Son diez trazados del original, uno por celda y
 * con su propio par umbral/color, porque los sellos NO comparten tinta: hay
 * blancos, rojos y uno naranja, y un umbral único deja la mitad fuera. Ver
 * trazos/RitualGlyphsArt.astro.
 *
 * Marco medido: x 12→470 (3→461) · y 734→778 (0→44).
 * El rótulo 05 vive en el hueco de arriba, y 720→728, fuera de la caja.
 */
import Glifos from "./trazos/RitualGlyphsArt.astro";

interface Props { box: string }
const { box } = Astro.props;
---

<div data-box style={box} class="rg">
  <b class="rg__t1">05. RITUAL GLYPHS /</b><span class="rg__t2">GLIFOS RITUALES (SAMPLE SET)</span>

  <i class="rg__marco"></i>
  <Glifos />
</div>

<style>
  .rg {
    position: absolute;
    overflow: visible; /* el rótulo 05 vive arriba, en el hueco entre marcos */
    font-family: var(--lam-mono);
  }

  .rg__t1, .rg__t2 { position: absolute; white-space: nowrap; }
  .rg__t1 {
    left: 13.3px; top: -15.5px;
    font-size: 12px; line-height: 12px;
    letter-spacing: -0.4px;
    font-weight: 700;
    color: #ba1100;
  }
  .rg__t2 {
    left: 150.4px; top: -13.5px;
    font-size: 10.3px; line-height: 10.3px;
    letter-spacing: -0.08px;
    color: #67675f;
  }

  .rg__marco {
    position: absolute;
    left: 3px; right: 0; top: 0; bottom: 0;
    border: 1px solid #1e1e1e;
    border-left: 2px solid #1d1d1d;
  }
</style>
