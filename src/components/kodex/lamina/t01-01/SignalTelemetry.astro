---
/**
 * KODEX-∞ · t01-01 THRESHOLD PORTAL · panel 04 — SIGNAL TELEMETRY / TELEMETRÍA DE SEÑAL
 *
 * Cuatro instrumentos con su lectura debajo. Tres son trazas de señal y el
 * cuarto no: GATE STABILITY es un ojo/lente con un disco polar dentro, y se
 * sale por la derecha de su propio marco. Reproducirlo como una cuarta onda
 * sería inventar.
 *
 * Medido sobre reference/canon/t01-01-threshold-portal.png. Coordenadas de
 * lámina (entre paréntesis, relativas a la caja del panel = 9, 590):
 *
 *   título 04      y 576→584, en el hueco de arriba (fuera de la caja)
 *   marco          x 12→470 (3→461) · y 590 (0) → 711 (un píxel fuera por abajo)
 *   marcos de gráf x [20,123] [130,238] [247,356] [363,463] · y 596→672
 *                  anchos 104 · 109 · 110 · 101 — tampoco son iguales
 *   rótulos        y 601→607 (11→17), tinta desde x 23 · 138 · 253 · 370
 *   lecturas       y 681→687 (91→97) y y 695→701 (105→111)
 *
 * Las cuatro lecturas NO comparten sangría: las columnas 2, 3 y 4 alinean sus
 * dos renglones a la izquierda y la primera no (AMP en x 33, FREQ en x 28).
 * Va cada renglón donde está medido.
 *
 * Los gráficos son arte fija y van TRAZADOS: ver trazos/SignalTelemetryArt.astro.
 * La retícula del fondo entra en el mismo trazo — a umbral 16 es tinta como
 * cualquier otra, y dibujarla aparte con un repeating-linear-gradient la deja
 * en otro sitio.
 *
 * Los números son ficción del póster; el bloque de lecturas va con data-symbolic.
 */
import Graficos from "./trazos/SignalTelemetryArt.astro";

interface Props { box: string }
const { box } = Astro.props;

type Instrumento = {
  rotulo: string;
  /** marco del gráfico, relativo a la caja: [x, ancho] */
  caja: [number, number];
  /** sangría del rótulo, relativa a la caja */
  xRotulo: number;
  rojo: boolean;
  /** [texto, x] de cada renglón de lectura */
  lecturas: Array<[string, number]>;
};

const instrumentos: Instrumento[] = [
  { rotulo: "SIGNAL STRENGTH", caja: [11, 104], xRotulo: 13.5, rojo: true,
    lecturas: [["AMP: 0.843", 23.5], ["FREQ: 17.2 HZ", 18.5]] },
  { rotulo: "COHERENCE INDEX", caja: [121, 109], xRotulo: 128.5, rojo: false,
    lecturas: [["C9H: 92.7%", 145.5], ["SYNC: 0.88", 145.5]] },
  { rotulo: "HARMONIC ALIGNMENT", caja: [238, 110], xRotulo: 243.5, rojo: true,
    lecturas: [["HARM: 3/7", 257.5], ["PHASE: 0.634", 257.5]] },
  { rotulo: "GATE STABILITY", caja: [354, 101], xRotulo: 360.5, rojo: false,
    lecturas: [["STAB: 87.1%", 363.5], ["DECAY: -0.21", 363.5]] },
];

const yLectura = [90.5, 104.5];
---

<div data-box style={box} class="st">
  <b class="st__t1">04. SIGNAL TELEMETRY /</b><span class="st__t2">TELEMETRIA DE SEÑAL</span>

  <i class="st__marco"></i>

  {instrumentos.map((i) => (
    <i class="st__caja" style={`left:${i.caja[0]}px;width:${i.caja[1]}px`}></i>
  ))}

  <Graficos />

  {instrumentos.map((i) => (
    <div class={`st__rotulo${i.rojo ? " st__rotulo--rojo" : ""}`} style={`left:${i.xRotulo}px`}>{i.rotulo}</div>
  ))}

  <div class="st__lecturas" data-symbolic="true">
    {instrumentos.map((i) => i.lecturas.map(([t, x], k) => (
      <div style={`left:${x}px;top:${yLectura[k]}px`}>{t}</div>
    )))}
  </div>
</div>

<style>
  .st {
    position: absolute;
    overflow: visible; /* el rótulo 04 vive arriba, en el hueco entre marcos */
    font-family: var(--lam-mono);
  }

  .st__t1, .st__t2 { position: absolute; white-space: nowrap; }
  .st__t1 {
    left: 13.3px; top: -15.5px;
    font-size: 12px; line-height: 12px;
    letter-spacing: -0.47px;
    font-weight: 700;
    color: #ba1100;
  }
  .st__t2 {
    left: 169.4px; top: -13.5px;
    font-size: 9.4px; line-height: 9.4px;
    letter-spacing: -0.15px;
    color: #67675f;
  }

  .st__marco {
    position: absolute;
    left: 3px; right: 0; top: 0; bottom: -1px;
    border: 1px solid #1e1e1e;
    border-left: 2px solid #1d1d1d;
  }

  .st__caja {
    position: absolute;
    box-sizing: border-box;
    top: 6px; height: 77px;
    border: 1px solid #222220;
  }

  .st__rotulo {
    position: absolute;
    top: 10.5px;
    font-size: 8.2px; line-height: 8.2px;
    letter-spacing: 0;
    white-space: nowrap;
    color: #5f5f5d;
  }
  .st__rotulo--rojo { color: #8a2c1c; }

  .st__lecturas > div {
    position: absolute;
    font-size: 10.1px; line-height: 10.1px;
    letter-spacing: 0;
    white-space: nowrap;
    color: #666664;
  }
</style>
