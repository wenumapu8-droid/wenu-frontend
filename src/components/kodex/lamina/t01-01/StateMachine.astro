---
/**
 * KODEX-∞ · t01-01 THRESHOLD PORTAL · panel 02 — STATE MACHINE / MÁQUINA DE ESTADO
 *
 * Tres estados del portal — DORMANT, AWARE, OPEN — de tenue a saturado, con su
 * emblema arriba y tres viñetas debajo. Los tres emblemas son dibujos
 * DISTINTOS, no el mismo con otro color: el primero y el tercero son el árbol
 * dentro del anillo y el del medio es una mandala de pétalos sin árbol.
 *
 * Medido sobre reference/canon/t01-01-threshold-portal.png con perfiles de
 * tinta por fila y por columna. Coordenadas de lámina (y entre paréntesis
 * relativas a la caja del panel, que es 9, 264):
 *
 *   título 02        y 248→257, FUERA de la caja: en esta lámina el rótulo de
 *                    los paneles 02 a 05 vive en el hueco entre marcos, no
 *                    dentro del marco como en el 01
 *   marco            x 12→470 (3→461) · y 264→442 (0→178)
 *   nombre de estado y 272→280 (8→16); tinta desde x 53 · 206 · 363
 *   subtítulo        y 286→292 (22→28); tinta desde x 36 · 173 · 337
 *   emblemas         y 300→397, x [36,117] [181,272] [332,428]
 *   conectores       x 147 y x 299 — el puertecito entre columnas
 *   viñetas          altos y 403 · 416 · 428 (139 · 152 · 164)
 *                    tinta desde x 37 · 190 · 344
 *   puntos           2×2 px en x 27 · 180 · 335, y 406 · 418 · 431
 *
 * Los emblemas son arte fija y van TRAZADOS: ver trazos/StateMachineArt.astro.
 * El texto es texto.
 */
import Emblemas from "./trazos/StateMachineArt.astro";

interface Props { box: string }
const { box } = Astro.props;

type Col = {
  k: string;
  nombre: string; xNombre: number;
  sub: string; xSub: number;
  vinetas: string[]; xVineta: number; xPunto: number;
};

/* Las tres columnas NO están repartidas parejo: los pasos entre los orígenes
   de texto son 153 y 155 px, y los de los emblemas 150 y 151. Se posiciona
   cada tramo donde está medido, no sobre una grilla inventada. */
const cols: Col[] = [
  {
    k: "dormant",
    nombre: "DORMANT", xNombre: 43.5,
    sub: "INACTIVE / SILENCIO", xSub: 26.5,
    vinetas: ["SIGNAL ABSENT", "SYSTEM IDLE", "ENERGY MINIMAL"], xVineta: 27.5, xPunto: 18,
  },
  {
    k: "aware",
    nombre: "AWARE", xNombre: 196.5,
    sub: "RECOGNIZING / ANALIZANDO", xSub: 163.5,
    vinetas: ["SIGNAL DETECTED", "ALIGNMENT TEST", "PATTERN MATCHING"], xVineta: 180.5, xPunto: 171,
  },
  {
    k: "open",
    nombre: "OPEN", xNombre: 353.5,
    sub: "THRESHOLD / ABIERTO", xSub: 327.5,
    vinetas: ["GATE UNSEALED", "TRANSFER ACTIVE", "REALITY SHIFT"], xVineta: 334.5, xPunto: 326,
  },
];

/** altos de la caja de mayúsculas de cada viñeta, y de su punto */
const yVineta = [139, 152, 164];
const yPunto = [142, 154, 167];
---

<div data-box style={box} class="sm">
  <b class="sm__t1">02. STATE MACHINE /</b><span class="sm__t2">MAQUINA DE ESTADO</span>

  <i class="sm__marco"></i>

  {cols.map((c) => (
    <div class={`sm__col sm__col--${c.k}`}>
      <div class="sm__nombre" style={`left:${c.xNombre}px`}>{c.nombre}</div>
      <div class="sm__sub" style={`left:${c.xSub}px`}>{c.sub}</div>
      {c.vinetas.map((v, i) => (
        <>
          <i class="sm__punto" style={`left:${c.xPunto}px;top:${yPunto[i]}px`}></i>
          <div class="sm__vineta" style={`left:${c.xVineta}px;top:${yVineta[i]}px`}>{v}</div>
        </>
      ))}
    </div>
  ))}

  <Emblemas />
</div>

<style>
  .sm {
    position: absolute;
    overflow: visible; /* el rótulo 02 vive arriba, en el hueco entre marcos */
    font-family: var(--lam-mono);
  }

  /* Rótulo del panel: alto y 248→257 de la lámina = -16 respecto de la caja.
     Mismo par de tipografías que el panel 01 — el tramo rojo va más ancho que
     el gris en el original. */
  .sm__t1, .sm__t2 { position: absolute; white-space: nowrap; }
  .sm__t1 {
    left: 13.3px; top: -17.5px;
    font-size: 12px; line-height: 12px;
    letter-spacing: -0.12px;
    font-weight: 700;
    color: #ba1100;
  }
  .sm__t2 {
    left: 155.4px; top: -15.5px;
    font-size: 10.3px; line-height: 10.3px;
    letter-spacing: -0.19px;
    color: #67675f;
  }

  .sm__marco {
    position: absolute;
    left: 3px; right: 0; top: 0; bottom: 0;
    border: 1px solid #1e1e1e;
    border-left: 2px solid #1d1d1d;
    border-top-color: #171717;
  }

  .sm__col > div { position: absolute; white-space: nowrap; }

  .sm__nombre {
    top: 7.3px;
    font-size: 12px; line-height: 12px;
    letter-spacing: -0.45px;
  }
  .sm__sub {
    top: 20.5px;
    font-size: 8.2px; line-height: 8.2px;
    letter-spacing: -0.2px;
  }
  .sm__vineta {
    font-size: 8.9px; line-height: 8.9px;
    letter-spacing: -0.31px;
    color: #686864;
  }
  .sm__punto { position: absolute; width: 2px; height: 2px; }

  .sm__col--dormant .sm__nombre { color: #8c8c8c; }
  .sm__col--dormant .sm__sub { color: #6d6d69; }
  .sm__col--aware .sm__vineta { color: #6a6a66; }
  .sm__col--open .sm__vineta { color: #6c6c68; }
  .sm__col--dormant .sm__punto { background: #5d5e5a; }

  .sm__col--aware .sm__nombre { color: #a96d1a; }
  .sm__col--aware .sm__sub { color: #6e6e69; }
  .sm__col--aware .sm__punto { background: #9d721b; }

  .sm__col--open .sm__nombre { color: #d41300; }
  .sm__col--open .sm__sub { color: #b22f24; }
  .sm__col--open .sm__punto { background: #c53013; }
</style>
