---
/**
 * KODEX-∞ · t01-01 THRESHOLD PORTAL · 11. ICON CLUSTERS / CLUSTERS DE ICONOS
 *
 * Caja medida: 1152,792 506×70. Las coordenadas de este archivo están corridas
 * −1152,−792 respecto del póster.
 *
 * Los treinta y cuatro iconos van TRAZADOS del original (arte.ts), no dibujados.
 * Cada uno es una maraña distinta de anillos, radios y puntos de dieciocho
 * píxeles de lado; a ojo salen treinta y cuatro aproximaciones parecidas entre
 * sí, que es justamente lo que la referencia no tiene. Trazados salen en
 * segundos y son el original.
 *
 * Van en DOS piezas, una por fila, y no en una: el trazador separa glifos por
 * columnas de tinta, y con las dos filas en la misma banda cada columna
 * arrastraría un icono de arriba y otro de abajo dentro de la misma caja.
 *
 * El color va por icono y no por fila. No es un detalle: en la referencia
 * conviven rojos intensos y grises apagados en la misma tira —el primero, el
 * tercero, el octavo y el noveno de la fila de arriba son rojos y sus vecinos
 * no— y pintarlos todos del mismo color aplana justo lo que hace que la tira se
 * lea como un muestrario y no como un patrón.
 */
import Trazo from "./Trazo.astro";
import { rotulo } from "./tipografia";
import { icoUno, icoDos, titIC } from "./arte";

interface Props { box: string }
const { box } = Astro.props;
---

<div data-box style={box} class="icl">
  <svg class="icl__art" viewBox="0 0 506 70" width="506" height="70" aria-hidden="true">
    <!-- Marco del panel. El canto izquierdo (x=1152) y el derecho (x=1657) son
         las dos columnas extremas de la caja; los filos horizontales caen en
         y=789,5 y y=866, fuera de la caja medida, que es donde el original los
         tiene. -->
    <rect class="icl__marco" x="0" y="-3" width="1" height="78" />
    <rect class="icl__marco icl__marco--der" x="505" y="-3" width="1" height="78" />
    <rect class="icl__marco icl__marco--sup" x="0" y="-2.5" width="505" height="1.5" />
    <rect class="icl__marco icl__marco--inf" x="0" y="74" width="506" height="1" />

    <!-- Regla bajo el título: de x=1166 a x=1651 del póster, y=812,6. -->
    <rect class="icl__regla" x="14" y="20.6" width="486" height="1.4" />

    <!-- Ordinal como texto —es una cifra— y el resto del título trazado del
         original: como texto entero dejaba 9,66 % de residuo contra 1,94 %. -->
    <text class="icl__num" data-symbolic="true" {...rotulo(15, 6, 9, 19)}>11.</text>
    <Trazo glifos={titIC} etiqueta="ICON CLUSTERS / CLUSTERS DE ICONOS" />

    <Trazo glifos={icoUno} etiqueta="Primera fila de iconos rituales" />
    <Trazo glifos={icoDos} etiqueta="Segunda fila de iconos rituales" />
  </svg>
</div>

<style>
  /* Los filos superior e inferior del marco caen fuera de la caja, donde el
     original los tiene. Esa franja no pertenece a ningún otro panel. */
  .icl { overflow: visible; }

  .icl__art { position: absolute; left: 0; top: 0; overflow: visible; }

  .icl__marco { fill: #111111; }
  .icl__marco--der { fill: #232323; }
  .icl__marco--sup { fill: #181818; }
  .icl__marco--inf { fill: #141414; }
  .icl__regla { fill: #161616; }

  .icl__num {
    font-family: var(--lam-mono);
    font-variant-ligatures: none;
    white-space: pre;
    /* Un píxel de desenfoque reproduce el derrame del raster del póster. */
    filter: blur(1px);
  }
  .icl__num { fill: #a01409; }
</style>
