---
/**
 * KODEX-∞ · t01-01 THRESHOLD PORTAL · 06. UI ELEMENTS / ELEMENTOS DE INTERFAZ
 *
 * Caja medida: 1228,88 429×289.
 *
 * Cinco botones y dos cajas de estado. Estructura medida por bandas de tinta
 * (los bordes son rojos oscuros, umbral 24-30), no estimada:
 *
 *      y  97-105  título            y 200-272  CROSS THRESHOLD (ancho entero)
 *      y 113-114  regla de cabecera y 283-328  ABORT · PAUSE
 *      y 126-189  ENTER · INITIATE  y 341-369  AUTH STATUS · CLEARANCE
 *
 * Las columnas NO se reparten parejo y ése es el detalle que delata un redibujo:
 *
 *      fila 1   ENTER   1243-1428 (186)   INITIATE 1444-1639 (196)
 *      fila 3   ABORT   1243-1426 (184)   PAUSE    1438-1639 (202)
 *      estado   VERIF.  1243-1456 (214)   CLEAR.   1469-1641 (173)
 *
 * Repartir 396 px en dos mitades iguales deja los cuatro botones de la derecha
 * 5 px corridos y el diff lo castiga en los ocho bordes verticales.
 *
 * EL MARCO DE CADA BOTÓN TIENE TRES PESOS, no uno. Medido a x=1350:
 *      filo superior  y126 rgb(128,23,11)   una línea
 *      filo inferior  y187-190 rgb(34/80/74/44) — una BANDA de cuatro, con halo
 *      costados       x1243-1246 rgb(102,85,66,28) — tres, degradando hacia dentro
 * Un `border: 1px solid` parejo da un marco de wireframe; lo que hace que se
 * lea como panel encendido es que la base pesa el triple que el techo.
 *
 * Dentro de cada extremo va un CORCHETE: diagonal desde el filo, tramo vertical
 * y diagonal de vuelta. Medido en la fila 1: la vertical interior está en 1253
 * (10 px adentro) y va de y140 a y175, con las diagonales entre y133-140 y
 * y175-181 — o sea 7 y 14 px desde el borde, CONSTANTES, no proporcionales al
 * alto: en el botón de 46 px de alto los mismos 7 y 14 vuelven a caer sobre la
 * medición.
 *
 * El interior de los botones NO tiene textura que valga. Amplificado ×2 se ve
 * una retícula, pero medido en zona sin texto la media es rgb(5,5,5) en los
 * botones normales y rgb(15,3,2) en CROSS THRESHOLD. Los dos están por debajo
 * de lo que pixelmatch distingue del negro con threshold 0,12 (la tolerancia
 * cae en ~31 de luma). Se pone la retícula igual, a la intensidad medida, pero
 * no es de ahí de donde sale el puntaje.
 *
 * Los avances de texto se midieron renglón por renglón dividiendo el ancho de
 * tinta por los caracteres, y NO son uno solo: ENTER va a 11,75 px por carácter
 * y INITIATE a 10,14 en el mismo cuerpo. El póster no usa una tipografía
 * consistente; igualarlos descentra los dos rótulos.
 *
 * Los números y estados de este panel son ficción del póster: el contenedor va
 * con data-symbolic="true".
 */
interface Props { box: string }
const { box } = Astro.props;

const OX = 1228;
const OY = 88;

/* Alto de versal / cuerpo ≈ 0,63 en el mono del sistema, y el borde de la caja
   de línea queda 0,118·cuerpo por encima del alto de versal. Las dos constantes
   salieron de medir el render, no de la métrica de la fuente. */
const cuerpo = (versal: number) => +(versal / 0.727).toFixed(2);
const CAPF = 0.118;
/* Avance natural: 0,60 del cuerpo + el letter-spacing 0.04em de .kdx-lam. */
const ADVF = 0.64;

type Txt = { t: string; cx: number; cap: number; versal: number; adv: number; cls: string };
const textos: Txt[] = [
  // título: la mitad roja y la gris NO comparten avance (6,29 contra 6,77)
  { t: "06. UI ELEMENTS", cx: 1238 + (15 * 6.5) / 2, cap: 97, versal: 9, adv: 6.5, cls: "t-num" },
  { t: "/ ELEMENTOS DE INTERFAZ", cx: 1338 + (23 * 6.95) / 2, cap: 97, versal: 9, adv: 6.95, cls: "t-sub" },

  { t: "ENTER", cx: 1335, cap: 145, versal: 13, adv: 11.75, cls: "t-btn" },
  { t: "// AUTHENTICATE", cx: 1335, cap: 166, versal: 7, adv: 6.46, cls: "t-cap" },
  { t: "INITIATE", cx: 1536.5, cap: 145, versal: 13, adv: 10.75, cls: "t-btn" },
  { t: "// RUN PROTOCOL", cx: 1536, cap: 166, versal: 7, adv: 6.46, cls: "t-cap" },

  { t: "CROSS THRESHOLD", cx: 1430.5, cap: 225, versal: 16, adv: 15.0, cls: "t-hero" },
  { t: "// COMMIT TO TRANSFER", cx: 1425, cap: 250, versal: 7, adv: 6.71, cls: "t-cap" },

  // ABORT y PAUSE no tienen el mismo brillo en el original: rgb(118) contra rgb(143)
  { t: "ABORT", cx: 1337, cap: 295, versal: 10, adv: 8.3, cls: "t-min t-min--ab" },
  { t: "// CANCEL", cx: 1332.5, cap: 311, versal: 7, adv: 5.52, cls: "t-cap" },
  { t: "PAUSE", cx: 1533, cap: 295, versal: 10, adv: 8.3, cls: "t-min" },
  { t: "// HOLD STATE", cx: 1532, cap: 311, versal: 7, adv: 5.59, cls: "t-cap" },

  { t: "AUTH STATUS: VERIFIED", cx: 1335, cap: 351, versal: 9, adv: 7.0, cls: "t-ok" },
  { t: "CLEARANCE: OMEGA", cx: 1549.5, cap: 351, versal: 9, adv: 7.13, cls: "t-cle" },
];

const estilo = (x: Txt) => {
  const F = cuerpo(x.versal);
  const left = +(x.cx - OX - (x.t.length * x.adv) / 2).toFixed(2);
  const top = +(x.cap - OY - F * CAPF).toFixed(2);
  const k = +(x.adv / (F * ADVF)).toFixed(4);
  return `left:${left}px;top:${top}px;font-size:${F}px;transform:scaleX(${k})`;
};

/* Botones: x,y,w,h relativos a la caja. */
const botones = [
  { x: 15, y: 38, w: 186, h: 64, cls: "" },
  { x: 216, y: 38, w: 196, h: 64, cls: "" },
  { x: 15, y: 112, w: 397, h: 73, cls: "b--hero" },
  { x: 15, y: 195, w: 184, h: 46, cls: "b--min" },
  { x: 211, y: 195, w: 202, h: 46, cls: "b--min" },
];

/* Corchete: diagonal de 7 a 14 desde cada esquina, vertical 10 px adentro. */
const corchete = (w: number, h: number) =>
  `M2,7 L10,14 L10,${h - 15} L3,${h - 9} M${w - 3},7 L${w - 11},14 L${w - 11},${h - 15} L${w - 4},${h - 9}`;
---

<div data-box style={box} class="ui" data-symbolic="true">
  <i class="ui__col" aria-hidden="true"></i>
  <i class="ui__regla" aria-hidden="true"></i>

  {botones.map((b) => (
    <div class={`ui__b ${b.cls}`} style={`left:${b.x}px;top:${b.y}px;width:${b.w}px;height:${b.h}px`}>
      <i class="ui__bTop" aria-hidden="true"></i>
      <i class="ui__bGlow" aria-hidden="true"></i>
      <svg class="ui__brk" viewBox={`0 0 ${b.w} ${b.h}`} width={b.w} height={b.h} aria-hidden="true">
        <path d={corchete(b.w, b.h)} fill="none" stroke="currentColor" stroke-width="1.1" />
      </svg>
    </div>
  ))}

  <div class="ui__s ui__s--ok" style="left:15px;top:253px;width:214px;height:29px"></div>
  <div class="ui__s ui__s--cle" style="left:241px;top:253px;width:173px;height:29px"></div>
  <div class="ui__s ui__s--cle" style="left:244px;top:253px;width:166px;height:29px"></div>

  <svg class="ui__chk" viewBox="0 0 10 9" width="10" height="9" aria-hidden="true">
    <path d="M0,5.5 L3,8.5 L9.5,0.5" fill="none" stroke="currentColor" stroke-width="1.4" />
  </svg>
  <svg class="ui__dots" viewBox="0 0 4 20" width="4" height="20" aria-hidden="true">
    <path d="M0,0.5h4 M1,5.5h3 M1,8.5h3 M0,11.5h4 M1,12.5h3" stroke="currentColor" stroke-width="1" />
  </svg>

  {textos.map((x) => <span class={`ui__t ${x.cls}`} style={estilo(x)}>{x.t}</span>)}
</div>

<style>
  .ui {
    /* Los cuatro anillos del costado, medidos a media altura en x 1243-1246:
       rgb(102,20,12) · (85,14,6) · (66,17,10) · (28,11,10). */
    --bd: #661408;
    --bd2: #551006;
    --bd3: #42110a;
    --bd4: #1c0b0a;
    --brk: #7a1610;
    --bd-top: linear-gradient(180deg, #210502 0 1px, #801710 1px 2px, #3e0804 2px 3px, #020101 3px 5px);
    --bd-top-h: 5px;
    --bd-glow: linear-gradient(180deg, #010000 0 1px, #220906 1px 2px, #500b07 2px 3px, #4a0604 3px 4px, #2c0907 4px 5px);
    overflow: hidden;
    font-family: var(--lam-mono);
  }
  .ui i, .ui svg, .ui span, .ui div { position: absolute; }

  .ui__col { left: 0; top: 0; width: 1px; height: 289px; background: #232323; }
  .ui__regla { left: 8px; top: 25px; width: 413px; height: 2px; background: #141414; }

  /* ── botones ─────────────────────────────────────────────────────── */
  .ui__b {
    box-sizing: border-box;
    border: 1px solid var(--bd);
    border-radius: 5px;
    color: var(--bd);
    /* Los anillos interiores van como sombras insertadas y no como divs: así
       siguen el radio de la esquina sin recalcularlo tres veces, y la primera
       sombra de la lista queda ENCIMA de las siguientes, que es justo el orden
       que hace falta para que cada anillo pise al de adentro. */
    box-shadow:
      inset 0 0 0 1px var(--bd2),
      inset 0 0 0 2px var(--bd3),
      inset 0 0 0 3px var(--bd4);
    /* Media medida del interior: rgb(5,5,5). No es negro puro pero está por
       debajo de lo que el banco separa del negro; va por fidelidad, no por
       puntaje. */
    background:
      repeating-linear-gradient(90deg, rgba(255, 70, 45, 0.05) 0 1px, transparent 1px 4px),
      repeating-linear-gradient(0deg, rgba(255, 70, 45, 0.04) 0 1px, transparent 1px 4px);
  }
  .ui__b.b--hero {
    /* CROSS THRESHOLD sí tiene un lavado rojo por encima del resto:
       rgb(15,3,2) contra rgb(5,5,5). */
    background-color: rgba(255, 40, 25, 0.055);
    --bd: #6d1106;
    --bd2: #6a0e05;
    --bd3: #440301;
    --bd4: #3f0d09;
    /* El filo de arriba de CROSS THRESHOLD es una BANDA de cinco líneas y la
       más brillante es la de ABAJO (y203 rgb(151,38,9)), no la de arriba. */
    --bd-top: linear-gradient(180deg, #0e0000 0 1px, #5c0901 1px 2px, #6e0d02 2px 3px, #620a03 3px 4px, #97260a 4px 5px, #010000 5px 6px);
    --bd-top-h: 6px;
    --bd-glow: linear-gradient(180deg, #090302 0 1px, #0d0100 1px 2px, #580904 2px 3px, #7b1308 3px 4px, #010000 4px 5px);
  }
  .ui__b.b--min {
    /* La fila corta no tiene la misma caída: 97 · 61 · 36 · 13, y el filo de
       arriba es UNA línea sola (y283) sin degradado. */
    --bd: #611209; --bd2: #3d0a05; --bd3: #240b05; --bd4: #0d0808;
    --bd-top: linear-gradient(180deg, #0e0100 0 1px, #6f0d07 1px 2px, #040100 2px 3px, #050505 3px 4px);
    --bd-top-h: 4px;
    --bd-glow: linear-gradient(180deg, #070604 0 1px, #020000 1px 2px, #440802 2px 3px, #3a0803 3px 4px, #010000 4px 5px);
  }

  /* Los dos filetes horizontales se dibujan APARTE de los anillos porque no
     tienen su perfil: el techo pesa 33·128·62 y la base 34·80·74·44. Van desde
     −2 px de la caja de relleno, que es donde cae la primera fila medida. */
  .ui__bTop { left: 5px; right: 5px; top: -2px; height: var(--bd-top-h); background: var(--bd-top); }
  .ui__bGlow { left: 6px; right: 6px; bottom: -2px; height: 5px; background: var(--bd-glow); }
  .ui__brk { left: 0; top: 0; }

  /* ── cajas de estado ─────────────────────────────────────────────── */
  .ui__s { box-sizing: border-box; border: 1px solid; border-radius: 5px; }
  .ui__s--ok { border-color: #4a3d0c; }
  .ui__s--cle { border-color: #6d0f04; }

  .ui__chk { left: 195px; top: 263px; color: #6d7c26; }
  .ui__dots { left: 403px; top: 259px; color: #851104; stroke: currentColor; }

  /* ── texto ───────────────────────────────────────────────────────── */
  .ui__t {
    margin: 0;
    font-weight: 400;
    line-height: 1;
    white-space: pre;
    transform-origin: 0 0;
  }
  .t-num { color: #a51008; }
  .t-sub { color: #48403f; }
  .t-btn { color: #c52020; }
  .t-hero { color: #cc201e; }
  .t-cap { color: #424242; }
  .t-min { color: #8f1211; }
  .t-min--ab { color: #76120f; }
  .t-ok { color: #4d581d; }
  .t-cle { color: #aa1009; }
</style>
