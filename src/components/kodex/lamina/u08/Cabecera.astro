---
/**
 * KODEX-∞ · u08-anomaly · CABECERA
 *
 * Cromo compartido de la serie (`serie-universe/CabeceraUniverse.astro`) con
 * las props medidas sobre `reference/canon/u08-anomaly.png` (1122×1402).
 *
 * MEDIDO — lo que distingue a esta lámina:
 *  · FONDO negro puro: diez muestras dan rgb(0,0,0)..rgb(2,1,1).
 *  · PALETA: título plata cálida (top-5 % rgb 213,212,207), tinta de cuerpo
 *    gris neutra (rótulos grises rinden ~130,131,132) y DOS acentos: violeta
 *    (MUTATION pica en 189,168,216 → #bda8d8) y NARANJA de ruptura
 *    (RUPTURE 195,116,88 · MUTATION-panel 209,107,81) — ese naranja no existe
 *    en ninguna otra lámina de la serie y vive en los Paneles, no acá.
 *  · MARCO SUPERIOR en y=11,5 (u05: 12,5) con el hueco del hexágono en
 *    x 499..618 y un punto a cada lado (504,5 y 612).
 *  · HEXÁGONO más grande y casi centrado: cx 558,5, vértices y 15,5 y 62,5,
 *    lados x 533,5/583,5 (u05 lo tiene en 534,5 con lados 514..555).
 *  · SIN marco interior: barrido de la fila 65 y la columna 52 no da nada.
 *  · RIELES en x 12,5 y 1107,5 (u05: 13,5/1106,5).
 *  · Título: KODEX x 97..443 (¡346 px — más interletrado que u05!), versal 53
 *    (y 104..157), ∞ x 461..542 centro 501,5, barra 578..592 inclinada,
 *    ANOMALY x 624..1063.
 *  · Bajada MUTATION violeta x 419..705, versal 15 (y 183..198), flanqueada
 *    por rombos en x 296/830 con punteo.
 *  · Nota "INTERFERENCE BREEDS TRANSFORMATION." gris, x 384..721, base 227.
 *  · A / -∞ y PAGE 08 con versal 13 (y 190..203) — más grandes que en u05.
 *  · Folio "08" en x 1102..1114, y 604..628.
 */
import CabeceraUniverse from "../serie-universe/CabeceraUniverse.astro";
import { rombo, rayos, cruz } from "../serie-universe/geom";

const chaflanes = [
  "M12.5 25.5L29 11.5",
  "M1095 11.5L1107.5 25.5",
  "M1107.5 1377.5L1095 1391.5",
  "M26.5 1391.5L12.5 1377.5",
];

/* Paleta medida de u08: tinta neutra, violeta #bda8d8 (los rótulos violeta
   son ese color a ~0,78 de alfa) y título plata cálida. NO se hereda. */
const vars = [
  "--cb-ink:#d8d4d0",
  "--cb-vio:#bda8d8",
  "--cb-tit:#d4d0c7",
  "--cb-regla-size:11.5px",
  "--cb-regla-op:0.26",
  "--cb-regla-der-op:0.22",
  "--cb-lema-size:21px",
  "--cb-lema-op:0.9",
  "--cb-sig-size:17px",
  "--cb-sig-op:0.52",
  "--cb-pag-size:17px",
  "--cb-pag-op:0.5",
  "--cb-nota-size:12.6px",
  "--cb-nota-op:0.56",
  "--cb-cruz-op:0.4",
  "--cb-folio-size:13px",
  "--cb-folio-op:0.42",
].join(";");
---

<CabeceraUniverse
  gradId="u08"
  grad={["#e8e4db", "#d4d0c7", "#a29f98"]}
