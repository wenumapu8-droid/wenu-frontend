---
/**
 * KODEX-∞ · u08-anomaly · PANELES
 *
 * Todo el texto y las cajas alrededor del héroe, medido sobre la referencia:
 *
 *  · IZQUIERDA (x 96, sin interletrado, ~7,8 px por carácter):
 *    INTERFERENCE (violeta, base 287) + 4 líneas grises (313/331/349/369) y
 *    la trama "≫≫≫" en y 391..396 · RUPTURE (NARANJA, base 609) + 4 líneas
 *    (635/653/672/691) y el hexágono de riel en (127,728) · NEW FORM
 *    (violeta, base 852) + 4 líneas (877/896/915/935) y la roseta de ocho
 *    pétalos en (122,980) — montada SOBRE la línea del destello del héroe.
 *  · DERECHA (x 902): caja SIGNAL CORRUPTION x 845..1030 · y 263..438 con
 *    rótulo violeta (base 287), cinco líneas punteadas (312/331/350/370/390)
 *    y un peine de señal en y 416 · DRIFT (violeta, base 475) · MUTATION
 *    (NARANJA, base 707) con la estrella de rayos en (997,670) · ADAPTATION
 *    (violeta, base 876) con el blanco de anillos en (953,1018).
 *  · ABAJO: ANOMALY LOG en caja doble (79,5..298,5 / 90,5..289,5 ·
 *    y 1072,5..1242,5) con cinco líneas y trama violeta en y 1220 ·
 *    OBSERVATION en caja doble (814,5..1033,5) con tres líneas y un peine
 *    violeta centrado en y 1205 · STABILIZED ENTITY (violeta, x 479..638,
 *    base 1195) y "// NEW CODE ACTIVE //" (gris, base 1218) con el punteo
 *    que baja del círculo-∞ (x 557,5, y 1155..1176).
 *
 * El naranja #dc7050 es el segundo acento de la lámina (rótulos naranjas
 * miden 195..209 de rojo en sus picos): es la tinta de la RUPTURA y sólo
 * la llevan RUPTURE y MUTATION.
 */
import Waveform from "../kit/Waveform.astro";
import { rayos, hexPuntos } from "../serie-universe/geom";

const CHAR = 7.8;

const izq = [
  {
    lab: "INTERFERENCE", labY: 287, nar: false,
    lineas: [["FOREIGN SIGNALS", 313], ["COLLIDE WITH CORE", 331], ["STRUCTURES.", 349], ["COHERENCE DEGRADES.", 369]],
  },
  {
    lab: "RUPTURE", labY: 609, nar: true,
    lineas: [["BOUNDARIES BREAK.", 635], ["OLD CODE SHATTERS.", 653], ["THE FIELD TEARS", 672], ["OPEN.", 691]],
  },
  {
    lab: "NEW FORM", labY: 852, nar: false,
    lineas: [["A STABLE PATTERN", 877], ["IS BORN.", 896], ["NOT A COPY.", 915], ["AN EVOLUTION.", 935]],
  },
];

const der = [
  {
    lab: "DRIFT", labY: 475, nar: false,
    lineas: [["STRUCTURE LOSES", 499], ["ANCHOR. PATTERNS", 518], ["BECOME LIQUID.", 537], ["DIRECTION FADES.", 555]],
  },
  {
    lab: "MUTATION", labY: 707, nar: true,
    lineas: [["NEW ALGORITHMIC", 735], ["POSSIBILITIES", 753], ["EMERGE FROM CHAOS.", 771], ["CODE REWRITES ITSELF.", 790]],
  },
  {
    lab: "ADAPTATION", labY: 876, nar: false,
    lineas: [["THE SYSTEM", 900], ["INTEGRATES CHANGE.", 919], ["NEW HARMONICS", 939], ["ESTABLISHED.", 958], ["ALIGNMENT RESTORED.", 976]],
  },
];

const sc = [
  ["COHERENCE .......... 12.3%", 312.5],
  ["STABILITY ............ LOW", 331.5],
  ["INTEGRITY ........ CRITICAL", 350.5],
  ["ENTROPY ........... RISING", 370.5],
  ["STATE ......... INTERFERED", 390.5],
];

const al = [
  ["EVENT TYPE ........ MUTATION", 1124],
  ["TRIGGER ............ INTERFERENCE", 1142],
  ["ORIGIN ............. UNKNOWN", 1160],
  ["OUTCOME ............ TRANSFORMATION", 1177],
  ["THREAT LEVEL ....... VARIABLE", 1195],
];

const ob = [
  ["ANOMALIES ARE NOT ERRORS.", 1125],
  ["THEY ARE OPPORTUNITIES", 1144],
  ["FOR BECOMING.", 1164],
];

/* Trama "≫≫≫" de ocho aspas diagonales: la de INTERFERENCE (y 391..396) y la
   de ANOMALY LOG (y 1218..1222) son la misma marca en dos sitios. */
const trama = (x0, y0) =>
  Array.from({ length: 9 }, (_, i) => `M${x0 + i * 4.6} ${y0 + 5}l4 -5`).join("");
---

<div data-bloque="Paneles" style="inset:0">
  <svg class="u08p" viewBox="0 0 1122 1402" width="1122" height="1402" aria-hidden="true">
    <!-- ── columna izquierda ─────────────────────────────────────────────── -->
    {izq.map((b) => (
      <g>
        <text class={b.nar ? "u08p__lab u08p__lab--nar" : "u08p__lab"} x="96" y={b.labY} textLength={b.lab.length * CHAR}>{b.lab}</text>
        {b.lineas.map(([t, y]) => (
          <text class="u08p__lin" x="96" y={y} textLength={t.length * CHAR}>{t}</text>
        ))}
      </g>
    ))}
    <path class="u08p__trama" d={trama(97, 391)} />
    <!-- hexágono de riel bajo RUPTURE -->
    <g class="u08p__glifo">
      <polygon points={hexPuntos(127, 728, 12)} />
      <polygon points={hexPuntos(127, 728, 6.5)} />
      <circle cx="127" cy="728" r="1.4" />
    </g>
    <!-- roseta de NEW FORM, sobre la línea del destello (y 980) -->
    <g class="u08p__glifo">
      <circle cx="122.5" cy="979.5" r="22" />
      <circle cx="122.5" cy="979.5" r="9" />
      <circle cx="122.5" cy="979.5" r="1.6" />
      <path d={rayos(122.5, 979.5, 21, 8, Math.PI / 8)} />
      {Array.from({ length: 8 }, (_, i) => {
        const a = Math.PI / 8 + (i * Math.PI) / 4;
        return <circle cx={(122.5 + 15 * Math.cos(a)).toFixed(1)} cy={(979.5 + 15 * Math.sin(a)).toFixed(1)} r="1.2" />;
      })}
    </g>

    <!-- ── caja SIGNAL CORRUPTION ────────────────────────────────────────── -->
    <g class="u08p__caja">
      <path d="M845.5 263.5H1029.5V437.5H845.5Z" />
      <path class="u08p__caja--tic" d="M940 263.5h5M940 437.5h5" />
    </g>
    <text class="u08p__lab" x="863" y="287" textLength={117}>SIGNAL CORRUPTION</text>
    {sc.map(([t, y]) => (
      <text class="u08p__lin u08p__lin--sc" x="862" y={y} textLength={t.length * 5.85}>{t}</text>
    ))}

    <!-- ── columna derecha ───────────────────────────────────────────────── -->
    {der.map((b) => (
      <g>
        <text class={b.nar ? "u08p__lab u08p__lab--nar" : "u08p__lab"} x="902" y={b.labY} textLength={b.lab.length * CHAR}>{b.lab}</text>
        {b.lineas.map(([t, y]) => (
          <text class="u08p__lin" x="902" y={y} textLength={t.length * CHAR}>{t}</text>
        ))}
      </g>
    ))}
    <!-- estrella de rayos junto a MUTATION -->
    <g class="u08p__glifo">
      <path d={rayos(997.5, 670, 16, 12)} />
      <path d={rayos(997.5, 670, 8, 12, Math.PI / 12)} />
      <circle cx="997.5" cy="670" r="1.5" />
    </g>
    <!-- blanco de anillos bajo ADAPTATION -->
    <g class="u08p__glifo">
      <circle cx="953.5" cy="1018" r="20" />
      <circle cx="953.5" cy="1018" r="13.5" />
      <circle cx="953.5" cy="1018" r="7.5" />
      <circle cx="953.5" cy="1018" r="1.6" />
    </g>

    <!-- ── caja ANOMALY LOG (doble marco) ────────────────────────────────── -->
    <g class="u08p__caja">
      <path class="u08p__caja--ext" d="M79.5 1072.5H298.5V1242.5H79.5Z" />
      <path d="M90.5 1080.5H289.5V1232.5H90.5Z" />
    </g>
    <text class="u08p__lab" x="96" y="1101" textLength={11 * CHAR}>ANOMALY LOG</text>
    {al.map(([t, y]) => (
      <text class="u08p__lin u08p__lin--sc" x="96" y={y} textLength={t.length * 5.6}>{t}</text>
    ))}
    <path class="u08p__trama u08p__trama--vio" d={trama(98, 1217)} />
    <g class="u08p__nodo">
      {[148, 158, 170, 184, 197, 211, 217].map((x) => <circle cx={x} cy={1220} r="1.1" />)}
      <rect x="144" y="1218.6" width="2.8" height="2.8" />
      <rect x="204" y="1218.6" width="2.8" height="2.8" />
    </g>

    <!-- ── caja OBSERVATION (doble marco) ────────────────────────────────── -->
    <g class="u08p__caja">
      <path class="u08p__caja--ext" d="M814.5 1071.5H1033.5V1242.5H814.5Z" />
      <path d="M825.5 1080.5H1023.5V1232.5H825.5Z" />
    </g>
    <text class="u08p__lab" x="834" y="1101" textLength={11 * CHAR}>OBSERVATION</text>
    {ob.map(([t, y]) => (
      <text class="u08p__lin" x="830" y={y} textLength={t.length * 7}>{t}</text>
    ))}

    <!-- ── STABILIZED ENTITY, bajo el héroe ──────────────────────────────── -->
    <path class="u08p__punteo" d="M557.5 1155V1176" stroke-dasharray="3.5 3.5" />
    <text class="u08p__lab u08p__lab--ent" x="479" y="1195" textLength="159">STABILIZED ENTITY</text>
    <text class="u08p__lin u08p__lin--ent" x="469" y="1218" textLength="174">// NEW CODE ACTIVE //</text>
  </svg>

  <!-- Peines de señal del kit, violetas: el de la caja SIGNAL CORRUPTION y el
       de OBSERVATION. Van fuera del SVG grande con su propio contenedor. -->
  <div style="position:absolute;left:864px;top:407px;color:#bda8d8">
    <Waveform w={148} h={18} semilla={0x0801} variante="peine" envolvente={0.8} grosor={0.7} clase="u08p__onda" />
  </div>
  <div style="position:absolute;left:837px;top:1195px;color:#bda8d8">
    <Waveform w={156} h={21} semilla={0x0802} variante="peine" envolvente={0.9} grosor={0.7} clase="u08p__onda" />
  </div>
</div>

<style is:global>
  .u08p {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .u08p text {
    font-family: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
    font-variant-ligatures: none;
    white-space: pre;
  }
  /* Rótulos violeta: pico medido ~150,135,180 = #bda8d8 a 0,78. */
  .u08p__lab { font-size: 13px; fill: #bda8d8; fill-opacity: 0.78; }
  /* Los DOS rótulos naranjas de la ruptura: picos 195..209 de rojo. */
  .u08p__lab--nar { fill: #dc7050; fill-opacity: 0.94; }
  .u08p__lab--ent { font-size: 14px; }
  /* Cuerpo gris neutro: picos ~130,131,132 → tinta a 0,56. */
  .u08p__lin { font-size: 10.8px; fill: #d8d4d0; fill-opacity: 0.56; }
  .u08p__lin--sc { font-size: 10.2px; }
  .u08p__lin--ent { font-size: 11px; fill-opacity: 0.5; }

  .u08p__caja path { fill: none; stroke: #d8d4d0; stroke-width: 1; stroke-opacity: 0.3; }
  .u08p__caja--ext { stroke-opacity: 0.14 !important; }
  .u08p__caja--tic { stroke-opacity: 0.4 !important; }

  .u08p__glifo path,
  .u08p__glifo polygon,
  .u08p__glifo circle { fill: none; stroke: #bda8d8; stroke-width: 0.9; stroke-opacity: 0.5; }
  .u08p__glifo circle[r="1.4"],
  .u08p__glifo circle[r="1.6"],
  .u08p__glifo circle[r="1.5"],
  .u08p__glifo circle[r="1.2"] { fill: #bda8d8; fill-opacity: 0.6; stroke: none; }

  .u08p__trama { fill: none; stroke: #d8d4d0; stroke-width: 1; stroke-opacity: 0.4; }
  .u08p__trama--vio { stroke: #bda8d8; stroke-opacity: 0.55; }
  .u08p__nodo circle { fill: #bda8d8; fill-opacity: 0.45; }
  .u08p__nodo rect { fill: #bda8d8; fill-opacity: 0.45; }
  .u08p__punteo { fill: none; stroke: #bda8d8; stroke-width: 1; stroke-opacity: 0.4; }

  .u08p__onda { opacity: 0.75; }
</style>
