---
/**
 * KODEX-∞ · u08-anomaly · PIE — la banda final, y 1250..1402. Medido:
 *   · regla de apertura y=1263,5, x 64..1054, con cierres en 53..61 y
 *     1056..1064;
 *   · el lema "EVOLUTION IS THE LANGUAGE OF THE UNWRITTEN." va ARRIBA de la
 *     banda (x 313..812, base 1293) en GRIS (pico 119,121,119 — no violeta),
 *     flanqueado por marcas en x ~286 y ~838;
 *   · codigo x 82, bases 1338/1356, violeta;
 *   · ONE SOURCE / INFINITE EXPRESSIONS alineados a la derecha contra x=958;
 *   · sello hexagonal cx 1019,5 · cy 1341,5 · vértices y 1313,5/1369,5 → R 28;
 *   · marco inferior y=1391,5 partido en x 492/627 por el ornamento central.
 *
 * `KDX-ANM-0008 / PROTOCOL INITIATED` es ficción del póster: PieUniverse ya
 * lo marca data-symbolic="true".
 */
import PieUniverse from "../serie-universe/PieUniverse.astro";
import { rombo, romboR } from "../serie-universe/geom";

/* Paleta medida de u08 + calibrado por alfas de pintura (mandos `-a`). */
const vars = [
  "--pi-ink:#d8d4d0",
  "--pi-vio:#bda8d8",
  "--pi-cod-size:10.5px",
  "--pi-cod-ls:.08em",
  "--pi-cod-a:.62",
  /* El lema de u08 es GRIS y va montado sobre la regla, no en la banda. */
  "--pi-lema-size:13px",
  "--pi-lema-fill:#d8d4d0",
  "--pi-lema-ls:.31em",
  "--pi-lema-a:.55",
  "--pi-lema-tr:translateX(2.01px)",
  "--pi-fuente-size:10.5px",
  "--pi-fuente-a:.6",
  "--pi-expr-fill:var(--pi-vio)",
  "--pi-expr-a:.5",
  "--pi-hex-a:.42",
  "--pi-rosa-a:.7",
  "--pi-pelo-a:.55",
].join(";");
---

<PieUniverse
  vars={vars}
  codigo={{ x: 82, y: 1338, t: "KDX-ANM-0008" }}
  estado={{ x: 82, y: 1356, t: "PROTOCOL INITIATED" }}
  lema={{ x: 562.5, y: 1293, anchor: "middle", t: "EVOLUTION IS THE LANGUAGE OF THE UNWRITTEN." }}
  fuente={{ x: 958, y: 1338, anchor: "end", t: "ONE SOURCE" }}
  expr={{ x: 958, y: 1356, anchor: "end", t: "INFINITE EXPRESSIONS" }}
  sello={{ cx: 1019.5, cy: 1341.5, R: 28 }}
>
  <Fragment slot="antes">
    <!-- Regla de apertura con cierres a los dos lados. -->
    <path class="u08pie__regla" d="M64 1263.5H1054" />
    <path class="u08pie__cierre" d="M57 1259.3v8.4m-4.2 -4.2h8.4" />
    <path class="u08pie__cierre" d={romboR(1060, 1263.5, 3.6)} />

    <!-- Marco inferior con ornamento central: la regla se parte en x 492/627. -->
    <path class="u08pie__marco" d="M29 1391.5H492M627 1391.5H1090" />
    <g class="u08pie__orna">
      <path d="M493.5 1388l7 7m0 -7l-7 7" />
      <circle cx="517.5" cy="1391.5" r="1.1" />
      <circle cx="524" cy="1391.5" r="1.1" />
      <circle cx="542.5" cy="1391.5" r="1.1" />
      <path d={rombo(558.5, 1391.5, 13, 9)} />
      <circle cx="558.5" cy="1391.5" r="1.3" />
      <circle cx="576" cy="1391.5" r="1.1" />
      <circle cx="594" cy="1391.5" r="1.1" />
      <circle cx="600.5" cy="1391.5" r="1.1" />
      <path d="M617.5 1388l7 7m0 -7l-7 7" />
    </g>
  </Fragment>

  {
    [286, 838.5].map((x) => (
      <g class="u08pie__cruz" slot="cruces">
        <rect x={x - 1.4} y={1288} width="2.8" height="2.8" />
        <path d={`M${x} 1283.6v2.4M${x} 1292.6v2.4M${x - 5} 1289.4H${x - 2.8}M${x + 2.8} 1289.4H${x + 5}`} />
      </g>
    ))
  }
</PieUniverse>

<style is:global>
  .u08pie__regla {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 1;
    stroke-opacity: 0.12;
  }
  .u08pie__cierre {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 1;
    stroke-opacity: 0.4;
  }
  .u08pie__marco {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 1;
    stroke-opacity: 0.12;
  }
  .u08pie__orna path {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 0.9;
    stroke-opacity: 0.42;
  }
  .u08pie__orna circle {
    fill: #d8d4d0;
    fill-opacity: 0.42;
  }
  .u08pie__cruz rect {
    fill: #d8d4d0;
    fill-opacity: 0.5;
  }
  .u08pie__cruz path {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 0.9;
    stroke-opacity: 0.5;
  }
</style>
