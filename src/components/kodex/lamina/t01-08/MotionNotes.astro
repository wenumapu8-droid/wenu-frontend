---
/**
 * KODEX-∞ · t01-08 · panel 02 — MOTION NOTES / NOTAS DE MOVIMIENTO
 *
 * Cuatro columnas, cada una con pictograma arriba, tres renglones en el medio y
 * una tira de señal abajo. Medido sobre la referencia:
 *
 *   filete superior      y 0 (a sangre)          regla de título  y 20-21
 *   separadores          x 116 · 237 · 360, de y 27 a y 147
 *   rótulos              y 30→37, avance 6,8 px
 *   pictogramas          y 43→72
 *   renglones            líneas base 87 · 98,7 · 110,4
 *   tiras de señal       y 118→144
 *
 * Los cuatro pictogramas son arte fija y cortos: dibujarlos aquí sale más
 * barato que trazarlos, porque son cuatro figuras de menos de 40 px con
 * geometría regular (una línea de ECG, una antena, unos bloques, una flecha
 * circular). El trazador se reserva para los sellos con relleno irregular.
 */
import { rng, p2 } from "../kit/rng";
import { tiras } from "./_signal";
import Waveform from "../kit/Waveform.astro";

interface Props { box: string }
const { box } = Astro.props;

type Col = {
  key: string;
  rotulo: string;
  cx: number;       // centro del rótulo, medido
  tx: number;       // sangría del bloque de texto, medida
  tinta: string;
  icono: string;
  onda: string;
  lineas: [string, string, string];
};

const cols: Col[] = [
  { key: "pulse", rotulo: "PULSE", cx: 56, tx: 11, tinta: "#2d938f", icono: "#7bcecf", onda: "#2c6d68",
    lineas: ["RHYTHMIC THROB", "BREATH OF FIELD", "SYNC TO HEARTBEAT"] },
  { key: "transmit", rotulo: "TRANSMIT", cx: 173, tx: 127, tinta: "#a36ed8", icono: "#9c56c3", onda: "#72408c",
    lineas: ["DATA OUTBOUND", "SIGNAL BEAM", "CONNECT & SEND"] },
  { key: "glitch", rotulo: "GLITCH", cx: 297, tx: 250, tinta: "#a72f6c", icono: "#e21b8d", onda: "#f965bf",
    lineas: ["INTERFERENCE", "PIXEL SHIFT", "REALITY BREAK"] },
  { key: "return", rotulo: "RETURN", cx: 420, tx: 379, tinta: "#c93f40", icono: "#f4363f", onda: "#a2272e",
    lineas: ["DECAY & RESET", "ENERGY FALL", "BACK TO SOURCE"] },
];

/* ── pictograma 1 · PULSE ─────────────────────────────────────────────────
   Latido: una base plana con dientes menudos y un pico central alto. La base
   NO es recta — en la referencia tiembla, y recta se lee como osciloscopio
   apagado. */
const rP = rng(2101);
const ecg = (() => {
  const pts: string[] = [];
  const n = 78;
  for (let i = 0; i < n; i++) {
    const t = i / (n - 1);
    let v = (rP() - 0.5) * 0.16;
    // dientes secundarios repartidos, no periódicos
    v += Math.sin(t * 41) * 0.07;
    if (t > 0.3 && t < 0.34) v -= 0.35;
    if (t > 0.34 && t < 0.42) v += 1;
    if (t > 0.42 && t < 0.47) v -= 0.55;
    if (t > 0.53 && t < 0.57) v += 0.42;
    if (t > 0.62 && t < 0.66) v -= 0.3;
    pts.push(`${i ? "L" : "M"}${p2(t * 78)} ${p2(14 - v * 12)}`);
  }
  return pts.join("");
})();

/* ── pictograma 3 · GLITCH ────────────────────────────────────────────────
   Bloques de píxel desalineados sobre una retícula de 34×24. Se generan con
   semilla y no a mano: quince rectángulos escritos uno a uno se ven ordenados
   por más que uno intente desordenarlos. */
const rG = rng(3307);
const bloques = Array.from({ length: 34 }, () => {
  const w = 1.5 + Math.pow(rG(), 1.6) * 11;
  return {
    x: p2(rG() * (34 - w)), y: p2(rG() * 22),
    w: p2(w), h: p2(1.1 + rG() * 1.9),
    o: p2(0.32 + rG() * 0.68),
  };
});

/* ── tiras de señal del pie ───────────────────────────────────────────────── */
const glitchBandas = tiras(95, 26, 130, 4801, { minW: 3, maxW: 52, alto: 1.1 });

/* RETURN: caída suave con relleno; la referencia la dibuja con un valle largo y
   una recuperación al final. */
const caida = (() => {
  const n = 60, w = 96, h = 26;
  const r = rng(5501);
  const pts: string[] = [];
  for (let i = 0; i < n; i++) {
    const t = i / (n - 1);
    const v = Math.exp(-t * 3.4) * 0.85 + Math.sin(t * 7.2) * 0.09 + t * t * 0.5 + (r() - 0.5) * 0.05;
    pts.push(`${i ? "L" : "M"}${p2(t * w)} ${p2(h - 3 - Math.max(0, Math.min(1, v)) * (h - 6))}`);
  }
  return { linea: pts.join(""), area: `${pts.join("")}L${w} ${h - 3}L0 ${h - 3}Z` };
})();
---

<div data-box style={box} class="mtn">
  <i class="mtn__gutter"></i>
  <i class="mtn__top"></i>

  <div class="mtn__title">
    <span class="mtn__title-a">02. MOTION NOTES</span><span class="mtn__title-b"> / NOTAS DE MOVIMIENTO</span>
  </div>
  <i class="mtn__rule"></i>

  <i class="mtn__sep" style="left:116px"></i>
  <i class="mtn__sep" style="left:237px"></i>
  <i class="mtn__sep" style="left:360px"></i>

  {cols.map((c) => (
    <div class="mtn__col" style={`--t:${c.tinta};--i:${c.icono};--o:${c.onda}`}>
      <div class="mtn__label" style={`left:${c.cx - 60}px`}>{c.rotulo}</div>
      <div class="mtn__lines" style={`left:${c.tx}px`}>
        {c.lineas.map((l) => <p>{l}</p>)}
      </div>
    </div>
  ))}

  {/* ── pictogramas ─────────────────────────────────────────────────────── */}
  <svg class="mtn__ico" style="left:14px;top:43px" width="78" height="28" viewBox="0 0 78 28" aria-hidden="true">
    <path d={ecg} fill="none" stroke="#7bcecf" stroke-width="1.1" stroke-linejoin="round" opacity="0.92" />
  </svg>

  <svg class="mtn__ico" style="left:153px;top:43px" width="40" height="29" viewBox="0 0 40 29" aria-hidden="true">
    <g fill="none" stroke="#9c56c3" stroke-width="1.5" stroke-linecap="round">
      <path d="M20 10.5V27" />
      <path d="M14.6 5.6a9 12 0 0 0 0 14" opacity="0.95" />
      <path d="M25.4 5.6a9 12 0 0 1 0 14" opacity="0.95" />
      <path d="M9.4 2.4a15 18 0 0 0 0 20.4" opacity="0.8" />
      <path d="M30.6 2.4a15 18 0 0 1 0 20.4" opacity="0.8" />
      <path d="M4.4 0.6a20 23 0 0 0 0 24" opacity="0.55" />
      <path d="M35.6 0.6a20 23 0 0 1 0 24" opacity="0.55" />
    </g>
    <circle cx="20" cy="9" r="2.2" fill="#c896ea" />
  </svg>

  <svg class="mtn__ico" style="left:282px;top:43px" width="34" height="24" viewBox="0 0 34 24" aria-hidden="true">
    {bloques.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h} fill="#e21b8d" opacity={b.o} />)}
    <path d="M13 9h6M16 6v9" stroke="#ff69bd" stroke-width="0.8" opacity="0.8" />
  </svg>

  <svg class="mtn__ico" style="left:407px;top:43px" width="27" height="28" viewBox="0 0 27 28" aria-hidden="true">
    <g fill="none" stroke="#f4363f" stroke-width="1.7" stroke-linecap="round">
      <path d="M22.4 8.6a10.5 10.5 0 1 0 1.3 7.6" />
      <path d="M4.6 19.4a10.5 10.5 0 1 0-1.3-7.6" />
    </g>
    <path d="M23.4 4.2l1.2 6.1-6-1.3z" fill="#f4363f" />
    <path d="M3.6 23.8l-1.2-6.1 6 1.3z" fill="#f4363f" />
  </svg>

  {/* ── tiras de señal ──────────────────────────────────────────────────── */}
  <div class="mtn__wave" style="left:10px;top:118px;width:96px;filter:brightness(.72)" data-symbolic="true" aria-hidden="true">
    <Waveform w={96} h={26} semilla={881} variante="peine" n={62} color="#2c6d68" grosor={1} inercia={0.12} />
  </div>

  <div class="mtn__wave" style="left:126px;top:118px;width:95px;filter:brightness(.92)" data-symbolic="true" aria-hidden="true">
    <Waveform w={95} h={26} semilla={1447} variante="linea" n={60} color="#7d47a0" grosor={1.5} inercia={0.55} />
  </div>

  <svg class="mtn__wave" style="left:250px;top:118px;filter:brightness(.37)" width="96" height="26" viewBox="0 0 96 26" data-symbolic="true" aria-hidden="true">
    {glitchBandas.map((t) => <rect x={t.x} y={t.y} width={t.w} height={t.h} fill="#f0289c" opacity={t.o} />)}
  </svg>

  <svg class="mtn__wave" style="left:378px;top:118px;filter:brightness(.5)" width="97" height="26" viewBox="0 0 97 26" data-symbolic="true" aria-hidden="true">
    <path d={caida.area} fill="#5c1418" opacity="0.55" />
    <path d={caida.linea} fill="none" stroke="#a2272e" stroke-width="1.1" stroke-linejoin="round" />
    <path d="M0 2V24" stroke="#a2272e" stroke-width="0.7" opacity="0.7" />
    <path d="M0 23H96" stroke="#a2272e" stroke-width="0.5" opacity="0.4" />
  </svg>
</div>

<style>
  /* `position:absolute` explícito: el estilo con ámbito del componente gana
     por orden de cascada a `.kdx-lam [data-box]`, y con `relative` el panel se
     acomoda en el flujo y aparece desplazado por la altura de los anteriores. */
  .mtn { position: absolute; overflow: hidden; }

  .mtn__gutter { position: absolute; left: 0; top: 0; width: 1px; height: 100%; background: #141414; }
  .mtn__top { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: #0f0e0f; }

  .mtn__title {
    position: absolute; left: 10px; top: 5px; height: 12px; line-height: 12px;
    font-size: 10px; letter-spacing: -0.1px; white-space: nowrap;
  }
  .mtn__title-a { color: #cf3d86; }
  .mtn__title-b { color: #5f6160; }

  .mtn__rule {
    position: absolute; left: 5px; top: 20px; width: 477px; height: 1px;
    background: #1b1a19; box-shadow: 0 1px 0 #0d0d0c;
  }

  .mtn__sep { position: absolute; top: 27px; width: 1px; height: 121px; background: #171616; }

  /* El rótulo se centra sobre un bloque de 120 px anclado en el centro medido de
     cada columna: los cuatro centros de la referencia no caen en el medio
     geométrico de su columna, se corren unos 2-4 px a la izquierda. */
  .mtn__label {
    position: absolute; top: 26px; width: 120px; height: 16px; line-height: 16px;
    text-align: center;
    font-size: 12.5px; letter-spacing: -0.7px;
    color: color-mix(in srgb, var(--t) 84%, #000);
  }

  .mtn__lines { position: absolute; top: 79px; }
  .mtn__lines p {
    margin: 0;
    font-size: 9px; line-height: 11.7px; letter-spacing: -0.45px;
    white-space: nowrap; color: #838381;
  }

  .mtn__ico { position: absolute; display: block; }
  .mtn__wave { position: absolute; display: block; }
  .mtn__wave :global(svg) { display: block; }
</style>
