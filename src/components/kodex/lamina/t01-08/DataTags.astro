---
/**
 * KODEX-∞ · t01-08 SIGNAL BLOOM · 10. DATA TAGS / ETIQUETAS DE DATOS
 *
 * Caja medida: 1181,723 485×127.
 *
 * Nada de esto se estimó a ojo. Todo lo que lleva una coordenada salió de
 * barrer el PNG de referencia fila por fila y columna por columna:
 *
 *  · El marco del panel NO es un rectángulo completo. La vertical izquierda
 *    vive en x=1181 y la derecha en x=1657 (no en 1665: ésa es la regla de
 *    margen del póster, que corre de y=80 a y=930 y no pertenece a ningún
 *    panel). El filo de arriba cae en y=723, o sea la primera fila de la caja;
 *    el de abajo en y=850, una fila POR DEBAJO de la caja, así que no se dibuja.
 *  · La retícula tipográfica de la lámina es de paso 5,95 px con altura de
 *    versal 8 px. Esas dos medidas juntas no las da ninguna mono del sistema
 *    (Menlo avanza 0,60 em y su versal mide 0,73 em: al tamaño que da la altura
 *    correcta, el texto sale un 20 % ancho). Por eso el texto va a cuerpo 11 px
 *    —que clava la versal— y se condensa con scaleX hasta el paso medido. Con
 *    letter-spacing negativo se corrige el paso pero las letras siguen anchas y
 *    la mancha no coincide.
 *  · La columna derecha NO está alineada: sus valores empiezan en x 1551, 1504
 *    y 1506. Se respetan donde están en vez de inventar una columna.
 *
 * El código de barras, el sello y el bloque C-4 no se dibujan: son contorno
 * trazado del original (ver trazos/DataTagsArt.astro).
 */
import Art from "./trazos/DataTagsArt.astro";

interface Props { box: string }
const { box } = Astro.props;

/* Cuerpo que clava la altura de versal medida (8 px) y avance natural de la
   mono del sistema a ese cuerpo. ADV es la única constante a recalibrar si la
   familia cambia: todo lo demás se deriva. */
const F = 11;
const ADV = 7.0;
const sx = (paso: number) => +(paso / ADV).toFixed(4);
/* Desplazamiento del borde superior de la caja de línea a la cima de la versal,
   con line-height:1. */
const CAP = 1.3;

/* Paso por carácter medido: títulos 5,95 · texto de tabla 5,7. */
const PT = 5.83;
const PK = 5.7;

/* Las guías de puntos NO son un relleno automático entre etiqueta y valor: en
   la referencia cada fila tiene la suya, de largo distinto, y la primera de la
   derecha no tiene puntos sino un solo dos-puntos magenta. Medidas (x absoluta
   del póster): r1L 1264-1270 · r2L y r3L 1233-1273 · r1R sólo ":" en 1486 ·
   r2R 1469-1494 · r3R 1473-1484. Y el paso de los puntos es 3,25 px, no el de
   la retícula de texto: rellenarlos al paso del texto da la mitad de puntos. */
const filas = [
  { y: 31, k: "SIGNAL ID", v: ["KX", "∞", "-T01-172A"], k2: "ARCHIVE", v2: "LPA-2025-05-22", vx2: 370,
    g1: [83, 7], g2: null, dosp: 305 },
  { y: 47, k: "CLASS", v: ["LIVING PATTERN"], k2: "CATEGORY", v2: "TRANSMISSION FIELD", vx2: 323,
    g1: [52, 41], g2: [288, 26], dosp: null },
  { y: 64, k: "STATUS", v: ["ACTIVE / LOCKED"], k2: "CLEARANCE", v2: "LEVEL  C-4", vx2: 325,
    g1: [52, 41], g2: [292, 12], dosp: null },
];

const KX = 12;    // etiqueta izquierda
const VX = 103;   // valor izquierdo
const KX2 = 231;  // etiqueta derecha
const DIV = 221;  // divisoria vertical entre columnas
---

<div data-box style={box} class="dtag" data-symbolic="true">
  <i class="dtag__edge dtag__edge--l"></i>
  <i class="dtag__edge dtag__edge--r"></i>
  <i class="dtag__edge dtag__edge--t"></i>

  <h2 class="dtag__title" style={`left:11px;top:${7 - CAP}px;transform:scaleX(${sx(PT)})`}>
    <span class="dtag__num">10. DATA TAGS</span><span class="dtag__sub"> / ETIQUETAS DE DATOS</span>
  </h2>
  <i class="dtag__rule" style="top:21px;left:6px;right:9px"></i>

  <i class="dtag__div" style={`left:${DIV}px;top:25px;height:53px`}></i>

  {filas.map((f) => (
    <>
      <span class="dtag__k" style={`left:${KX}px;top:${f.y - CAP}px;transform:scaleX(${sx(PK)})`}>{f.k}</span>
      <span class="dtag__v" style={`left:${VX}px;top:${f.y - CAP}px;transform:scaleX(${sx(PK)})`}>{f.v.map((t) => (t === "∞" ? <i class="dtag__inf">∞</i> : t))}</span>
      <span class="dtag__k" style={`left:${KX2}px;top:${f.y - CAP}px;transform:scaleX(${sx(PK)})`}>{f.k2}</span>
      <span class="dtag__v" style={`left:${f.vx2}px;top:${f.y - CAP}px;transform:scaleX(${sx(PK)})`}>{f.v2}</span>
      <i class="dtag__lead" style={`left:${f.g1[0]}px;top:${f.y + 6}px;width:${f.g1[1]}px`}></i>
      {f.g2 && <i class="dtag__lead" style={`left:${f.g2[0]}px;top:${f.y + 6}px;width:${f.g2[1]}px`}></i>}
      {f.dosp && (
        <span class="dtag__sep" style={`left:${f.dosp}px;top:${f.y - CAP}px;transform:scaleX(${sx(PK)})`}>:</span>
      )}
    </>
  ))}

  {/* Regla baja: muere en el filo del bloque C-4 (x 1567), no cruza hasta el
      sello. Medido: y 805-806 con tinta de 1190 a 1567. */}
  <i class="dtag__rule dtag__rule--low" style="top:82px;left:9px;width:377px"></i>

  <Art />
</div>

<style>
  .dtag {
    /* Tinta medida sobre el PNG, no elegida: el pico de cada texto es el núcleo
       de su trazo y a este cuerpo eso ES el color. */
    --dt-ink: #7a7e7b;
    --dt-label: #606260;
    --dt-mag: #d53d88;
    --dt-sub: #6c6d6a;
    --dt-frame: #1a191a;
    --dt-rule: #151415;
    --dt-lead: #2b2a2b;
    font-family: var(--lam-mono);
  }

  .dtag__edge { position: absolute; background: var(--dt-frame); }
  .dtag__edge--l { left: 0; top: 0; bottom: 0; width: 1px; }
  .dtag__edge--r { left: 476px; top: 0; bottom: 0; width: 1px; }
  .dtag__edge--t { left: 0; width: 477px; top: 0; height: 1px; }

  .dtag__rule { position: absolute; height: 1px; background: var(--dt-rule); }
  .dtag__rule--low { background: #232223; }
  .dtag__div { position: absolute; width: 1px; background: #121112; }

  .dtag__title,
  .dtag__k,
  .dtag__v,
  .dtag__sep {
    position: absolute;
    margin: 0;
    font-size: 11px;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    transform-origin: 0 0;
    /* La tinta del original no es un trazo limpio: barriendo una fila de texto
       la referencia da 8·50·82·63·9 donde nosotros damos 4·80·72·26·0 — el
       mismo pico pero con medio píxel más de derrame a cada lado, que es como
       rasteriza el póster. 1 px de desenfoque reproduce ese derrame. Medido
       sobre DATA TAGS: sin desenfoque 6,59 %, con 0,8 px 5,89 %, con 1 px
       5,17 %. Más allá de 1 px sigue bajando el número pero el texto deja de
       leerse, y eso ya no es reproducir la lámina. */
    filter: blur(1px);
    /* El color de cada texto es el PICO medido en la referencia, que es el
       núcleo del trazo. Pero al añadirle el derrame de 1 px se cuenta dos veces
       la misma tinta: el bloque queda con la masa correcta y el brillo alto.
       Este factor la devuelve a su sitio. Barrido 1 / 0,85 / 0,72 / 0,6: 5,17 · 5,12 · 5,19 · 5,40 %. */
    opacity: 0.85;
  }
  .dtag__num { color: var(--dt-mag); }
  .dtag__sub { color: var(--dt-sub); }
  .dtag__k { color: var(--dt-label); }
  /* El infinito del ID no ocupa una celda de la retícula: en la referencia el
     "-" que le sigue arranca en x 1308 y la "X" que lo precede en 1289, o sea
     13 px de avance contra los 5,7 del resto. Sin esto los nueve caracteres
     siguientes quedan 5 px corridos a la izquierda. */
  .dtag__inf { font-style: normal; letter-spacing: 8.9px; }
  .dtag__v { color: var(--dt-ink); }
  .dtag__sep { color: #8a3352; }

  /* Los puntos guía no son texto: son una tira de marcas de 1 px al mismo paso
     que la retícula. Escritos como caracteres habría que contarlos por fila y
     el conteo cambia con cada retoque de columna. */
  .dtag__lead {
    position: absolute;
    height: 1px;
    background-image: repeating-linear-gradient(90deg, var(--dt-lead) 0 1.4px, transparent 1.4px 3.25px);
  }
</style>
