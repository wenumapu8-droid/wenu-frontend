---
/**
 * KODEX-∞ · t01-08 · 00. TRANSMISSION FIELD / CAMPO DE TRANSMISIÓN
 *
 * El héroe: 661×491, organismo procedural en canvas 2D y HUD en HTML encima.
 * Ni un bitmap.
 *
 * Medido sobre la referencia (coordenadas relativas a la caja del panel):
 *
 *   · Centro del organismo en (326, 220) — píxel más brillante, y también la
 *     columna y la fila de mayor energía acumulada. Es el eje de simetría, NO
 *     una regla del cartel: el detector de marcos se comió esa columna como si
 *     fuera chrome y por eso la medición de cajas se hizo donde hay chrome.
 *   · Simetría diedral D8: el perfil angular a r 80–150 pica limpio en 0, 45,
 *     90, 135, 180, 225, 270 y 315 grados. Ocho ejes, cada uno espejo.
 *   · Cresta radial en r≈120 (borde de los pétalos mayores), valle en r≈27,
 *     repunte en r≈35 (roseta interior), cola hasta r≈205.
 *   · Cuatro estrellas de cuatro puntas en (143,33) (508,32) (143,412)
 *     (506,411): equidistantes del centro, ±182 en x y ±190 en y.
 *   · Reflejo sobre el plano inferior centrado en (326, 447).
 *
 * Chrome medido por segmentos, no inventado: borde izquierdo x=1 de y0 a y479;
 * riel interior x=9 de y25 a y451; regla del título en y=15; ménsula superior
 * izquierda y=24 (x10–95) y derecha y=26 (x559–647); separadores en y=121, 209,
 * 341 y 463; y el borde derecho NO es una línea entera sino cuatro marcas
 * sueltas en x=660.
 *
 * Números: son ficción del póster. Van como texto pero su contenedor lleva
 * data-symbolic="true" — el canon prohíbe presentarlos como estado real.
 */
interface Props { box: string }
const { box } = Astro.props;

const CAPAS = ["07", "06", "05", "04", "03", "02", "01"];
const ESCALA = ["100", "75", "50", "25", "00"];
---

<div data-box style={box} class="tf">
  <canvas class="tf__lienzo" width="661" height="491" aria-hidden="true"></canvas>

  <!-- ── chrome ─────────────────────────────────────────────────────── -->
  <i class="tf__borde-izq" aria-hidden="true"></i>
  <i class="tf__riel-izq" aria-hidden="true"></i>
  <i class="tf__regla-tit" aria-hidden="true"></i>
  <i class="tf__dash-td" aria-hidden="true"></i>
  <i class="tf__mensula-ti" aria-hidden="true"></i>
  <i class="tf__mensula-td" aria-hidden="true"></i>
  <i class="tf__r r121" aria-hidden="true"></i>
  <i class="tf__r r209i" aria-hidden="true"></i>
  <i class="tf__r r209d" aria-hidden="true"></i>
  <i class="tf__r r341i" aria-hidden="true"></i>
  <i class="tf__r r341d" aria-hidden="true"></i>
  <i class="tf__r r463i" aria-hidden="true"></i>
  <i class="tf__r r463d" aria-hidden="true"></i>
  <i class="tf__m m1" aria-hidden="true"></i>
  <i class="tf__m m2" aria-hidden="true"></i>
  <i class="tf__m m3" aria-hidden="true"></i>
  <i class="tf__m m4" aria-hidden="true"></i>

  <h2 class="tf__titulo"><span>00.</span> TRANSMISSION FIELD <em>/ CAMPO DE TRANSMISIÓN</em></h2>

  <!-- ── HUD izquierdo ──────────────────────────────────────────────── -->
  <div class="tf__hud tf__hud--izq" data-symbolic="true">
    <p class="tf__lbl l-coreid">CORE ID</p>
    <p class="tf__val l-tanda">TANDA 01</p>
    <p class="tf__lbl l-seedl">SEED</p>
    <p class="tf__val l-seed">KX−∞−T01−172A</p>

    <svg class="tf__arbol" viewBox="0 0 58 44" aria-hidden="true">
      <path d="M1 1h7M1 1v7M57 1h-7M57 1v7M1 43h7M1 43v-7M57 43h-7M57 43v-7"
            fill="none" stroke="#e83a92" stroke-width="1.3" opacity="1" />
      <circle cx="29" cy="22" r="18.5" fill="none" stroke="#f74bb0" stroke-width="1.4" opacity="1" />
      <circle cx="29" cy="22" r="15.5" fill="none" stroke="#e2379a" stroke-width=".8" opacity=".7" />
      <g stroke="#ff7ce0" fill="none" stroke-width="1.5" stroke-linecap="round">
        <path d="M29 33V19" />
        <path d="M29 22l-5-5M29 22l5-5M29 26l-4-4M29 26l4-4" stroke-width=".8" />
        <path d="M24 17c-4-1-6-4-5-7 1-3 4-4 6-2M34 17c4-1 6-4 5-7-1-3-4-4-6-2" stroke-width=".8" />
        <path d="M29 12c-3-2-4-5-2-7 2-2 5-1 6 1" stroke-width=".8" />
        <path d="M22 33h14" stroke-width="1.2" />
      </g>
    </svg>

    <p class="tf__lbl2 l-fs">FIELD STATUS</p>
    <div class="l-activa">
      <svg class="tf__cuad" viewBox="0 0 12 11" aria-hidden="true">
        <rect x="0" y="0" width="5" height="4.5" fill="#ff2f74" />
        <rect x="7" y="0" width="5" height="4.5" fill="#ff2f74" opacity=".45" />
        <rect x="0" y="6.5" width="5" height="4.5" fill="#ff2f74" opacity=".45" />
        <rect x="7" y="6.5" width="5" height="4.5" fill="#ff2f74" />
      </svg>
      <span>ACTIVE</span>
    </div>
    <i class="tf__pill l-pill"><b style="width:74%"></b></i>

    <p class="tf__lbl2 l-sl">SIGNAL LOCK</p>
    <p class="tf__lbl l-est">ESTABLISHED</p>

    <svg class="tf__fig" viewBox="0 0 11 11" aria-hidden="true">
      <circle cx="5.5" cy="2" r="1.7" fill="#e2379a" />
      <path d="M5.5 4v4M2 5.2h7M3.4 11l2.1-3 2.1 3" stroke="#e2379a" stroke-width="1.1" fill="none" />
    </svg>
    <i class="tf__medidor" aria-hidden="true"></i>
    {ESCALA.map((n, i) => (
      <>
        <i class="tf__pill tf__pill--esc" style={`top:${318 + i * 18.7}px`}><b style={`width:${[92, 62, 48, 34, 12][i]}%`}></b></i>
        <span class="tf__esc" style={`top:${317 + i * 18.7}px`}>{n}</span>
      </>
    ))}

    <p class="tf__lbl2 l-en">ENERGY</p>
    <p class="tf__grande l-pct">87.2%</p>
  </div>

  <!-- ── HUD derecho ────────────────────────────────────────────────── -->
  <div class="tf__hud tf__hud--der" data-symbolic="true">
    <svg class="tf__arbol2" viewBox="0 0 82 46" aria-hidden="true">
      <path d="M1 1h8M1 1v8M81 1h-8M81 1v8M1 45h8M1 45v-8M81 45h-8M81 45v-8"
            fill="none" stroke="#e83a92" stroke-width="1.3" opacity="1" />
      <circle cx="42" cy="23" r="20.5" fill="none" stroke="#e2379a" stroke-width="1" opacity=".9" />
      <circle cx="42" cy="23" r="17" fill="none" stroke="#e2379a" stroke-width=".5" opacity=".4" />
      <g stroke="#f65bd2" fill="none" stroke-width="1.1" stroke-linecap="round">
        <path d="M42 35V19" />
        <path d="M42 23l-5.5-5.5M42 23l5.5-5.5M42 28l-4.5-4.5M42 28l4.5-4.5" stroke-width=".8" />
        <path d="M36.5 17c-4.5-1-7-4.5-5.5-7.5 1.5-3 4.5-4 7-2M47.5 17c4.5-1 7-4.5 5.5-7.5-1.5-3-4.5-4-7-2" stroke-width=".8" />
        <path d="M42 11.5c-3-2-4-5.5-2-7.5 2.5-2.5 5.5-1 6.5 1.5" stroke-width=".8" />
        <path d="M34 35h16" stroke-width="1.2" />
      </g>
    </svg>
    <i class="tf__sello" aria-hidden="true"></i>

    <p class="tf__lbl2 r-origen">ORIGIN</p>
    <p class="tf__lbl r-o1">LIVING PATTERNS</p>
    <p class="tf__lbl r-o2">ARCHIVE STREAM</p>

    <p class="tf__lbl2 r-ls">LAYER STACK</p>
    <i class="tf__rail" aria-hidden="true"></i>
    {CAPAS.map((n, i) => (
      <div class={`tf__capa${n === "04" ? " es-activa" : ""}`} style={`top:${235 + i * 14}px`}>
        <i></i><span>LAYER {n}</span>
      </div>
    ))}
    <svg class="tf__diana" viewBox="0 0 9 9" aria-hidden="true">
      <circle cx="4.5" cy="4.5" r="3.6" fill="none" stroke="#d8203f" stroke-width="1" />
      <circle cx="4.5" cy="4.5" r="1.2" fill="#d8203f" />
    </svg>

    <p class="tf__lbl2 r-coh">COHERENCE</p>
    <i class="tf__punteado" aria-hidden="true"></i>
    <p class="tf__grande r-072">0.72</p>
    <canvas class="tf__mini" width="72" height="60" aria-hidden="true"></canvas>
    <i class="tf__barrita" aria-hidden="true"></i>
  </div>

  <p class="tf__pie">KODEX−∞ // TRANSMISSION FIELD // DO NOT OBSERVE. CONSTRUCT.</p>
</div>

<style>
  .tf {
    --ink: #8d8f8b;
    --dim: #62645f;
    --acc: #f22a6c;
    --acc2: #ff4b9e;
    --vio: #a05fd0;
    --rule: #4a1230;
    overflow: hidden;
    font-family: var(--lam-mono, ui-monospace, Menlo, monospace);
    color: var(--ink);
  }
  .tf__lienzo { position: absolute; left: 0; top: 0; width: 661px; height: 491px; }
  .tf i, .tf p, .tf div, .tf svg, .tf span, .tf h2, .tf canvas { position: absolute; }
  .tf p { margin: 0; }

  /* ── chrome medido ──────────────────────────────────────────────────── */
  .tf__borde-izq { left: 1px; top: 0; width: 1px; height: 480px; background: #4f1531; }
  .tf__riel-izq { left: 9px; top: 25px; width: 1px; height: 427px; background: #3c1026; }
  .tf__regla-tit {
    left: 4px; top: 15px; width: 653px; height: 1px;
    background: repeating-linear-gradient(90deg, #37342f 0 36px, transparent 36px 46px);
    opacity: .85;
  }
  .tf__dash-td { left: 599px; top: 15px; width: 36px; height: 1px; background: #8b2450; }
  .tf__mensula-ti { left: 10px; top: 24px; width: 86px; height: 1px; background: #5d1839; }
  .tf__mensula-td { left: 559px; top: 26px; width: 89px; height: 1px; background: #5d1839; }
  .tf__r { height: 1px; background: #4a1230; }
  .r121 { left: 560px; top: 121px; width: 82px; }
  .r209i { left: 20px; top: 209px; width: 63px; }
  .r209d { left: 565px; top: 209px; width: 76px; }
  .r341i { left: 25px; top: 341px; width: 10px; }
  .r341d { left: 564px; top: 341px; width: 77px; }
  .r463i { left: 22px; top: 463px; width: 47px; }
  .r463d { left: 557px; top: 463px; width: 78px; }
  .tf__m { left: 660px; width: 1px; background: #6d1c40; }
  .m1 { top: 0; height: 17px; } .m2 { top: 20px; height: 7px; }
  .m3 { top: 31px; height: 7px; } .m4 { top: 410px; height: 8px; }

  /* ── título ─────────────────────────────────────────────────────────── */
  .tf__titulo {
    left: 17px; top: -1px; margin: 0;
    font-size: 9.7px; font-weight: 400; letter-spacing: 0;
    color: var(--ink); white-space: nowrap;
  }
  .tf__titulo span { position: static; color: var(--acc); }
  .tf__titulo em { font-style: normal; color: var(--dim); }

  /* ── tipografía del HUD ─────────────────────────────────────────────── */
  .tf__lbl { font-size: 8.1px; letter-spacing: 0; color: var(--dim); white-space: nowrap; }
  .tf__lbl2 { font-size: 8.1px; letter-spacing: 0; color: var(--acc); white-space: nowrap; }
  .tf__val { font-size: 8.8px; letter-spacing: 0; white-space: nowrap; }
  .tf__grande { font-size: 18.6px; letter-spacing: 0; color: #9b9d99; white-space: nowrap; }

  .l-coreid { left: 22px; top: 41px; }
  .l-tanda { left: 22px; top: 55px; color: var(--vio); }
  .l-seedl { left: 22px; top: 77px; }
  .l-seed { left: 22px; top: 93px; color: var(--acc2); font-size: 8.8px; }
  .tf__arbol { left: 24px; top: 122px; width: 58px; height: 44px; }
  .l-fs { left: 22px; top: 219px; }
  .l-activa { left: 22px; top: 236px; display: flex; align-items: center; gap: 5px; }
  .l-activa span { position: static; font-size: 10px; letter-spacing: .07em; color: #d6d2cd; }
  .tf__cuad { position: static !important; width: 12px; height: 11px; flex: none; }
  .tf__pill {
    height: 6px; border: 1px solid #7a2350; box-sizing: border-box;
    background: #16060f; display: block;
  }
  .tf__pill b { display: block; height: 100%; background: #8e2050; opacity: .55; }
  .l-pill { left: 38px; top: 252px; width: 43px; }
  .l-sl { left: 22px; top: 275px; }
  .l-est { left: 22px; top: 290px; font-size: 9.1px; color: #8f918d; }

  .tf__fig { left: 23px; top: 315px; width: 11px; height: 11px; }
  .tf__medidor {
    left: 25px; top: 324px; width: 10px; height: 74px;
    background:
      repeating-linear-gradient(180deg, rgba(0,0,0,.9) 0 1px, transparent 1px 2px),
      linear-gradient(180deg, #6d1a8f 0%, #b0208a 40%, #f0165e 72%, #ff2a2a 100%);
