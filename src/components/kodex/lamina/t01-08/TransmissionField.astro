    box-sizing: border-box;
  }
  .tf__pill--esc { left: 40px; width: 28px; }
  .tf__esc { left: 71px; font-size: 8.1px; letter-spacing: 0; color: #8d8f8b; }

  .l-en { left: 22px; top: 407px; }
  .l-pct { left: 22px; top: 420px; }

  /* ── derecha ────────────────────────────────────────────────────────── */
  .tf__arbol2 { left: 568px; top: 44px; width: 82px; height: 46px; }
  .tf__sello {
    left: 616px; top: 108px; width: 23px; height: 7px;
    background:
      repeating-linear-gradient(90deg, #c4386e 0 2px, transparent 2px 5px),
      repeating-linear-gradient(180deg, #9b2a55 0 1px, transparent 1px 3px);
    opacity: .9;
  }
  .r-origen { left: 560px; top: 127px; }
  .r-o1 { left: 560px; top: 138px; font-size: 8.7px; color: #868883; }
  .r-o2 { left: 560px; top: 152px; font-size: 8.7px; color: #868883; }
  .r-ls { left: 560px; top: 217px; font-size: 9.2px; }
  .tf__rail { left: 568px; top: 237px; width: 1px; height: 90px; background: #56163a; }
  .tf__capa { left: 568px; width: 80px; display: flex; align-items: center; gap: 4px; }
  .tf__capa i { position: static; width: 9px; height: 1px; background: #4c4e4a; flex: none; }
  .tf__capa span { position: static; font-size: 7.1px; letter-spacing: 0; color: #75776f; white-space: nowrap; }
  .tf__capa.es-activa span { color: #d8203f; }
  .tf__capa.es-activa i { background: #d8203f; }
  .tf__diana { left: 564px; top: 277px; width: 9px; height: 9px; }
  .r-coh { left: 564px; top: 354px; }
  .tf__punteado {
    left: 612px; top: 359px; width: 37px; height: 1px;
    background: repeating-linear-gradient(90deg, #8e2a55 0 1px, transparent 1px 3px);
  }
  .r-072 { left: 564px; top: 373px; font-size: 17.6px; letter-spacing: 6.3px; }
  .tf__mini { left: 578px; top: 404px; width: 72px; height: 60px; }
  .tf__barrita {
    left: 651px; top: 410px; width: 5px; height: 46px;
    border: 1px solid #5c1637; box-sizing: border-box;
  }

  .tf__pie {
    left: 0; top: 478px; width: 661px; text-align: center;
    font-size: 6.6px; letter-spacing: .1em; color: #6e5058;
  }
</style>

<script>
  import { pintarFloracion, estrella, reflejo, rng } from "./floracion.js";

  function arrancar() {
    const nodos = document.querySelectorAll(".tf__lienzo");
    for (const cv of nodos) pintar(cv);
    const minis = document.querySelectorAll(".tf__mini");
    for (const cv of minis) pintarMini(cv);
  }

  function ctx2d(cv) {
    const dpr = 2;
    const w = cv.width;
    const h = cv.height;
    cv.width = w * dpr;
    cv.height = h * dpr;
    const ctx = cv.getContext("2d");
    ctx.scale(dpr, dpr);
    return ctx;
  }

  function pintar(cv) {
    if (cv.dataset.pintado === "1") return;
    cv.dataset.pintado = "1";
    const W = 661;
    const H = 491;
    const CX = 326;
    const CY = 220;
    const ctx = ctx2d(cv);
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = "#000";
    ctx.fillRect(0, 0, W, H);

    /* Estrellas de esquina y sus rayos: en la referencia hay líneas rectas
       tenues que van del centro a cada estrella. */
    const puntos = [[143, 33], [508, 32], [143, 412], [506, 411]];
    ctx.globalCompositeOperation = "lighter";
    ctx.strokeStyle = "rgba(210,50,160,1)";
    ctx.lineWidth = 0.5;
    for (const [x, y] of puntos) {
      ctx.globalAlpha = 0.18;
      ctx.beginPath();
      ctx.moveTo(CX, CY);
      ctx.lineTo(x, y);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;
    ctx.globalCompositeOperation = "source-over";

    pintarFloracion(ctx, { cx: CX, cy: CY, R: 218, semilla: 0x51b1, detalle: 1, estado: "BLOOM", alfa: 0.37 });

    /* Eje horizontal: en la referencia la fila y=220 está encendida casi de
       borde a borde, con nodos redondos cerca de los extremos. */
    ctx.globalCompositeOperation = "lighter";
    const gh = ctx.createLinearGradient(50, 0, 612, 0);
    gh.addColorStop(0, "rgba(255,60,200,0)");
    gh.addColorStop(0.14, "rgba(255,90,220,0.55)");
    gh.addColorStop(0.5, "rgba(255,220,255,0.9)");
    gh.addColorStop(0.86, "rgba(255,90,220,0.55)");
    gh.addColorStop(1, "rgba(255,60,200,0)");
    ctx.fillStyle = gh;
    ctx.fillRect(50, CY - 0.5, 562, 1.2);
    for (const [x, r] of [[100, 3.4], [122, 2.2], [530, 2.2], [552, 3.4]]) {
      ctx.globalAlpha = 0.85;
      ctx.strokeStyle = "rgba(255,150,240,1)";
      ctx.lineWidth = 0.8;
      ctx.beginPath();
      ctx.arc(x, CY, r, 0, Math.PI * 2);
      ctx.stroke();
    }
    /* Eje vertical: la columna x=326 también está encendida casi entera. */
    const gv = ctx.createLinearGradient(0, 12, 0, 440);
    gv.addColorStop(0, "rgba(255,60,200,0)");
    gv.addColorStop(0.12, "rgba(255,80,215,0.4)");
    gv.addColorStop(0.5, "rgba(255,220,255,0.85)");
    gv.addColorStop(0.9, "rgba(255,80,215,0.4)");
    gv.addColorStop(1, "rgba(255,60,200,0)");
    ctx.globalAlpha = 1;
    ctx.fillStyle = gv;
    ctx.fillRect(CX - 0.5, 12, 1.2, 428);

    /* Mira del vértice superior. */
    ctx.strokeStyle = "rgba(255,120,235,0.85)";
    ctx.lineWidth = 0.8;
    ctx.beginPath();
    ctx.arc(CX, 17, 5, 0, Math.PI * 2);
    ctx.moveTo(CX - 8, 17); ctx.lineTo(CX + 8, 17);
    ctx.moveTo(CX, 9); ctx.lineTo(CX, 25);
    ctx.stroke();

    for (const [x, y] of puntos) estrella(ctx, x, y, 22, 0.9);
    /* Estrellas menores, más adentro. */
    const re = rng(0x2b41);
    for (let i = 0; i < 5; i++) {
      const a = (i / 5) * Math.PI * 2 + 0.6;
      estrella(ctx, CX + Math.cos(a) * 235, CY + Math.sin(a) * 168, 7 + re() * 5, 0.35);
    }

    reflejo(ctx, CX, 447, 128, 21, 1);

    /* Polvo de fondo: la referencia nunca tiene negro liso. */
    const rd = rng(0x6f21);
    ctx.globalCompositeOperation = "lighter";
    for (let i = 0; i < 420; i++) {
      const x = rd() * W;
      const y = rd() * H;
      ctx.globalAlpha = 0.05 + rd() * 0.22;
      ctx.fillStyle = rd() < 0.2 ? "#6a5cff" : "#c8258f";
      ctx.fillRect(x, y, rd() < 0.15 ? 1.6 : 0.9, 0.9);
    }
    ctx.globalAlpha = 1;
    ctx.globalCompositeOperation = "source-over";
  }

  /* Recuadro inferior derecho: una fuente puntual con radios, dentro de caja. */
  function pintarMini(cv) {
    if (cv.dataset.pintado === "1") return;
    cv.dataset.pintado = "1";
    const ctx = ctx2d(cv);
    const W = 72;
    const H = 60;
    ctx.clearRect(0, 0, W, H);
    ctx.strokeStyle = "#5c1637";
    ctx.lineWidth = 1;
    ctx.strokeRect(0.5, 0.5, W - 1, H - 1);
    const cx = W * 0.5;
    const cy = H * 0.33;
    ctx.globalCompositeOperation = "lighter";
    const r = rng(0x1177);
    for (let i = 0; i < 40; i++) {
      const a = (i * Math.PI * 2) / 40;
      ctx.globalAlpha = 0.14 + r() * 0.4;
      ctx.strokeStyle = "rgba(230,60,190,1)";
      ctx.lineWidth = 0.4;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(a) * 46, cy + Math.sin(a) * 34);
      ctx.stroke();
    }
    const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, 9);
    g.addColorStop(0, "rgba(255,255,255,1)");
    g.addColorStop(0.3, "rgba(255,90,225,0.6)");
    g.addColorStop(1, "rgba(200,30,170,0)");
    ctx.globalAlpha = 1;
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(cx, cy, 9, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalCompositeOperation = "source-over";
  }

  arrancar();

  /**
   * LA FLORACIÓN RESPIRA.
   *
   * Estaba quieta porque se la dejó estática "para que el banco no midiera
   * ruido". Esa precaución sobra: para eso existe __kdxFreeze, que fija el
   * cuadro antes de capturar. Un organismo inmóvil deja de ser un organismo, y
   * la propia lámina lo pide — su pseudo-código dice
   * `pulse = sin(time * BPM) * 0.5 + 0.5` y sus verbos son «pulsa, expande».
   *
   * No se vuelve a dibujar la floración en cada cuadro: costaría un canvas
   * fuera de pantalla de 700 px por frame. Se toma UNA foto del dibujo ya hecho
   * y se la recompone respirando — escala mínima más un latido en el núcleo.
   * Cuesta un blit y se lee como vivo.
   *
   * En t = 0 la respiración vale exactamente 1 y el núcleo no aporta nada, así
   * que el cuadro congelado es idéntico al que el banco venía midiendo: los
   * 9,79 % no se mueven por esto.
   */
  const BPM = 0.42;          // lento: es una transmisión, no un corazón
  const AMPLITUD = 0.014;    // 1,4 % de escala — se percibe, no se nota

  const vivos = [];
  for (const cv of document.querySelectorAll(".tf__lienzo")) {
    const foto = document.createElement("canvas");
    foto.width = cv.width;
    foto.height = cv.height;
    foto.getContext("2d").drawImage(cv, 0, 0);
    vivos.push({ cv, foto, ctx: cv.getContext("2d") });
  }

  const componer = (t) => {
    const fase = Math.sin(t * Math.PI * 2 * BPM);
    const s = 1 + AMPLITUD * fase;
    for (const v of vivos) {
      const { ctx, foto, cv } = v;
      const w = cv.width;
      const h = cv.height;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.globalCompositeOperation = "source-over";
      ctx.globalAlpha = 1;
      ctx.fillStyle = "#000";
      ctx.fillRect(0, 0, w, h);
      // El centro del dibujo es (326, 220) en unidades CSS, y el lienzo va a 2x.
      const cx = 326 * 2;
      const cy = 220 * 2;
      ctx.translate(cx, cy);
      ctx.scale(s, s);
      ctx.translate(-cx, -cy);
      ctx.drawImage(foto, 0, 0);
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      // Latido del núcleo: sólo suma luz, nunca la quita.
      const brillo = Math.max(0, fase) * 0.5;
      if (brillo > 0.001) {
        ctx.globalCompositeOperation = "lighter";
        const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, 78);
        g.addColorStop(0, `rgba(255,190,255,${(brillo * 0.5).toFixed(3)})`);
        g.addColorStop(0.45, `rgba(236,60,190,${(brillo * 0.2).toFixed(3)})`);
        g.addColorStop(1, "rgba(236,60,190,0)");
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(cx, cy, 78, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalCompositeOperation = "source-over";
      }
    }
  };

  const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let raf = 0;
  const t0 = performance.now();
  const bucle = (ts) => {
    componer((ts - t0) / 1000);
    raf = requestAnimationFrame(bucle);
  };
  if (!quieto) raf = requestAnimationFrame(bucle);

  const w = window;
  const congelar = (t = 0) => {
    if (raf) cancelAnimationFrame(raf);
    raf = 0;
    componer(t);
  };
  if (typeof w.__kdxRegisterFreeze === "function") {
    w.__kdxRegisterFreeze(congelar);
  } else {
    let n = 0;
    const id = setInterval(() => {
      if (typeof w.__kdxRegisterFreeze === "function") {
        clearInterval(id);
        w.__kdxRegisterFreeze(congelar);
      } else if (++n > 200) clearInterval(id);
    }, 25);
  }
</script>
