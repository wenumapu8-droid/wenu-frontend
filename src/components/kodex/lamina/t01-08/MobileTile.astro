---
/**
 * KODEX-∞ · t01-08 · 08. MOBILE TILE / BALDOSA MÓVIL
 *
 * Un teléfono VERTICAL con la floración dentro. La caja es 194×272 pero el
 * teléfono no la llena: medido, ocupa x19–127 y y27–260, y a su derecha queda
 * negro. Rellenar ese hueco «porque sobra sitio» sería inventar composición.
 *
 * El título va alineado a la DERECHA: medido x17–188 en una caja de 194 con
 * margen 6, o sea pegado al borde derecho. Es el único de la fila que lo hace.
 */
import Waveform from "../kit/Waveform.astro";
import Micrografia from "../kit/Micrografia.astro";

interface Props { box: string }
const { box } = Astro.props;
---

<div data-box style={box} class="mt">
  <h2 class="mt__titulo"><span>08.</span> MOBILE TILE <em>/ BALDOSA MÓVIL</em></h2>
  <i class="mt__regla" aria-hidden="true"></i>

  <div class="mt__cuerpo">
    <div class="mt__pantalla">
      <canvas class="mt__lienzo" width="94" height="219" aria-hidden="true"></canvas>
      <i class="mt__marco" aria-hidden="true"></i>
      <i class="mt__notch" aria-hidden="true"></i>
      <p class="mt__wm">KODEX−∞</p>
      <i class="mt__div" aria-hidden="true"></i>
      <p class="mt__t1">SIGNAL BLOOM</p>
      <p class="mt__t2">TRANSMISSION ACTIVE</p>
      <div class="mt__onda" aria-hidden="true">
        <Waveform w={86} h={20} semilla={0x5b1} variante="peine" n={62} color="#e24ad8" grosor={0.7} inercia={0.28} />
      </div>
      <i class="mt__ondabase" aria-hidden="true"></i>
      <div class="mt__pie" aria-hidden="true">
        <Micrografia w={52} h={12} semilla={97} renglon={3.6} marca={1.1} palabra={5} color="#c73a86" opacidad={0.65} />
      </div>
      <svg class="mt__sello" viewBox="0 0 18 18" aria-hidden="true">
        <circle cx="9" cy="9" r="8.3" fill="none" stroke="#c02f80" stroke-width=".8" />
        <g stroke="#e657c0" fill="none" stroke-width=".7" stroke-linecap="round">
          <path d="M9 14.5V7.5M9 10L6.6 7.6M9 10l2.4-2.4" stroke-width=".6" />
          <path d="M6.6 7.2c-2-.5-2.9-2-2.1-3.4M11.4 7.2c2-.5 2.9-2 2.1-3.4" stroke-width=".6" />
          <path d="M6.4 14.5h5.2" stroke-width=".8" />
        </g>
      </svg>
    </div>
  </div>
</div>

<style>
  .mt {
    --ink: #8d8f8b;
    --dim: #62645f;
    --acc: #f22a6c;
    overflow: hidden;
    font-family: var(--lam-mono, ui-monospace, Menlo, monospace);
    color: var(--ink);
  }
  .mt h2, .mt p { margin: 0; }
  .mt i, .mt p, .mt svg, .mt canvas, .mt div { position: absolute; }

  .mt__titulo {
    position: absolute; right: 6px; top: 3px; margin: 0;
    font-size: 9.4px; font-weight: 400; letter-spacing: 0;
    color: var(--ink); white-space: nowrap;
  }
  .mt__titulo span { position: static; color: var(--acc); }
  .mt__titulo em { position: static; font-style: normal; color: var(--dim); }
  .mt__regla { left: 4px; top: 18px; width: 186px; height: 1px; background: #34312d; }

  /* Chasis: gris muy oscuro sobre negro, con el borde superior más claro —
     es lo que lo separa del fondo sin dibujarle un contorno brillante. */
  .mt__cuerpo {
    left: 19px; top: 28px; width: 108px; height: 235px;
    border-radius: 17px;
    /* Medido: del chasis sólo pasan el umbral el filo izquierdo (x20–21) y el
       derecho (x122–126). El cuerpo entre el filo y la pantalla es NEGRO. Con
       un gris parejo el teléfono se lee como una losa y el borde de pantalla
       queda tapado — que es lo que pasaba. */
    background: linear-gradient(90deg, #060608 0 1px, #35353d 1px 3px, #060608 3px 100%);
    box-shadow: inset -5px 0 0 #2a2a31, inset 0 0 0 1px #16161b;
  }
  .mt__pantalla {
    position: absolute; left: 7px; top: 7px; width: 94px; height: 221px;
    border-radius: 13px; overflow: hidden;
    background: #050106;
  }
  .mt__lienzo { left: 0; top: 0; width: 94px; height: 219px; }
  .mt__marco {
    left: 0; top: 0; width: 94px; height: 221px;
    border: 1px solid #5c1a38; border-radius: 13px; box-sizing: border-box;
  }
  .mt__notch {
    left: 31px; top: 2px; width: 32px; height: 4px;
    border-radius: 3px; background: #16161a;
  }
  .mt__wm {
    left: 7px; top: 8px; width: 80px; text-align: left;
    font-family: var(--lam-display, "Archivo", system-ui, sans-serif);
    font-weight: 800; font-size: 14px; letter-spacing: .8px; line-height: 1;
    color: #cfccc6;
  }
  .mt__div { left: 7px; top: 126px; width: 80px; height: 1px; background: #7a2350; }
  .mt__t1 {
    left: 7px; top: 132px; font-size: 8.4px; letter-spacing: .06em; color: #c7c4be;
  }
  .mt__t2 {
    left: 8px; top: 144px; font-size: 6.1px; letter-spacing: .04em; color: #86635f;
  }
  .mt__onda { left: 4px; top: 166px; width: 86px; height: 20px; }
  .mt__ondabase { left: 4px; top: 186px; width: 86px; height: 1px; background: #4b1330; }
  .mt__pie { left: 6px; top: 216px; width: 52px; height: 12px; }
  .mt__sello { left: 73px; top: 206px; width: 10px; height: 10px; }
</style>

<script>
  import { pintarFloracion, rng } from "./floracion.js";

  function pintar() {
    const nodos = document.querySelectorAll(".mt__lienzo");
    for (const cv of nodos) {
      if (cv.dataset.pintado === "1") continue;
      cv.dataset.pintado = "1";
      const W = 94;
      const H = 219;
      cv.width = W * 2;
      cv.height = H * 2;
      const ctx = cv.getContext("2d");
      ctx.scale(2, 2);
      ctx.fillStyle = "#050106";
      ctx.fillRect(0, 0, W, H);
      const rd = rng(0x77c1);
      ctx.globalCompositeOperation = "lighter";
      for (let i = 0; i < 110; i++) {
        ctx.globalAlpha = 0.05 + rd() * 0.22;
        ctx.fillStyle = rd() < 0.2 ? "#6a5cff" : "#c8258f";
        ctx.fillRect(rd() * W, rd() * 130, 0.9, 0.9);
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = "source-over";
      /* Radio grande a propósito: en la referencia la floración de la baldosa
         desborda la pantalla por los lados, no se ve entera. */
      pintarFloracion(ctx, { cx: 47, cy: 75, R: 70, semilla: 0x51b1, detalle: 1, estado: "BLOOM", alfa: 0.27 });
    }
  }

  pintar();
  const w = window;
  if (typeof w.__kdxRegisterFreeze === "function") {
    w.__kdxRegisterFreeze(pintar);
  } else {
    let n = 0;
    const id = setInterval(() => {
      if (typeof w.__kdxRegisterFreeze === "function") {
        clearInterval(id);
        w.__kdxRegisterFreeze(pintar);
      } else if (++n > 200) clearInterval(id);
    }, 25);
  }
</script>
