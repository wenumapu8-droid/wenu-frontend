---
/**
 * KODEX-∞ · t01-08 · 09. PALETTE & GRADIENT
 *
 * Seis muestras con su hex debajo y una barra de degradado con marcas.
 *
 * Los hex ROTULADOS son los del sistema (#FF00FF #8000FF #6A00FF #00C5FF
 * #FF2A2A #FFFFFF). Los hex PINTADOS son los medidos sobre la referencia, que
 * están un 15–25 % por debajo: el póster entero está atenuado —el blanco puro
 * de la sexta muestra sale 184,184,184— y reproducirlo con los valores
 * nominales deja el panel más brillante que la lámina. Se pinta lo que la
 * lámina muestra y se rotula lo que la lámina dice; son dos cosas distintas y
 * en la obra tampoco coinciden.
 *
 * Geometría medida: título y6–13 desde x9 · regla y19 · «PRIMARY PALETTE»
 * y30–37 · muestras y46–105 con paso 34,6 desde x8 y ancho 32 · hex y112–117 ·
 * «NEON SPECTRUM GRADIENT» y146–152 · barra y166–209 entre x8 y x217 · marcas
 * y225–236 entre x32 y x192, once, con las dos de los extremos en rojo.
 *
 * Paradas del degradado tomadas píxel a píxel sobre la fila y=185: arranca
 * rosa (215,3,124), cruza violeta al 40 % (60,4,174), y vuelve a rojo
 * (204,31,33). No es un magenta→azul→rojo parejo: el tramo violeta es largo y
 * plano, y ahí es donde un degradado «obvio» de tres paradas se nota falso.
 */
interface Props { box: string }
const { box } = Astro.props;

const MUESTRAS = [
  { hex: "#FF00FF", pintura: "#d501c8" },
  { hex: "#8000FF", pintura: "#9602d8" },
  { hex: "#6A00FF", pintura: "#4504d1" },
  { hex: "#00C5FF", pintura: "#00a5c4" },
  { hex: "#FF2A2A", pintura: "#d31d20" },
  { hex: "#FFFFFF", pintura: "#b8b8b8" },
];

const MARCAS = Array.from({ length: 11 }, (_, i) => 32 + i * 16);
---

<div data-box style={box} class="pg">
  <h2 class="pg__titulo"><span>09.</span> PALETTE &amp; GRADIENT</h2>
  <i class="pg__regla" aria-hidden="true"></i>

  <p class="pg__rot pg__rot--a">PRIMARY PALETTE</p>

  <div class="pg__muestras" data-symbolic="true">
    {MUESTRAS.map((m, i) => (
      <>
        <i
          class="pg__sw"
          style={`left:${(8 + i * 34.6).toFixed(1)}px;background:${m.pintura}`}
          aria-hidden="true"
        ></i>
        <span class="pg__hex" style={`left:${(8 + i * 34.6).toFixed(1)}px`}>{m.hex}</span>
      </>
    ))}
  </div>

  <i class="pg__regla2" aria-hidden="true"></i>
  <p class="pg__rot pg__rot--b">NEON SPECTRUM GRADIENT (SIGNAL FLOW)</p>

  <i class="pg__barra" aria-hidden="true"></i>

  <svg class="pg__marcas" viewBox="0 0 229 14" aria-hidden="true">
    {MARCAS.map((x, i) => {
      const extremo = i === 0 || i === MARCAS.length - 1;
      const c = extremo ? "#c81f2c" : "#7b7973";
      return (
        <g stroke={c} fill={c} stroke-width="0.9">
          <path d={`M${x} 13V2`} />
          <path d={`M${x - 2.2} 4.4L${x} 1.4l2.2 3`} fill="none" />
          {extremo && <circle cx={x} cy={12.4} r="1.3" stroke="none" />}
        </g>
      );
    })}
  </svg>
</div>

<style>
  .pg {
    --ink: #8d8f8b;
    --dim: #62645f;
    --acc: #f22a6c;
    overflow: hidden;
    font-family: var(--lam-mono, ui-monospace, Menlo, monospace);
    color: var(--ink);
  }
  .pg h2, .pg p { margin: 0; }
  .pg i, .pg p, .pg span, .pg svg, .pg div { position: absolute; }

  .pg__titulo {
    position: absolute; left: 9px; top: 4px; margin: 0;
    font-size: 9.7px; font-weight: 400; letter-spacing: 0;
    color: var(--acc); white-space: nowrap;
  }
  .pg__titulo span { position: static; color: var(--acc); }
  .pg__regla { left: 5px; top: 19px; width: 219px; height: 1px; background: #35322e; }
  .pg__regla2 { left: 5px; top: 134px; width: 219px; height: 1px; background: #3a3833; }

  .pg__rot { font-size: 8.8px; letter-spacing: 0; color: #85837e; white-space: nowrap; }
  .pg__rot--a { left: 8px; top: 29px; }
  .pg__rot--b { left: 8px; top: 144px; font-size: 8.7px; }

  .pg__muestras { left: 0; top: 0; width: 229px; height: 130px; }
  .pg__sw {
    top: 46px; width: 32px; height: 59px;
    background-image: linear-gradient(180deg, rgba(255,255,255,.07), rgba(0,0,0,.13));
  }
  .pg__hex {
    top: 111px; width: 32px; text-align: center;
    font-size: 7.05px; letter-spacing: 0; color: #6d6a67;
  }

  /* La barra: paradas medidas sobre la fila y=185 de la referencia. */
  .pg__barra {
    left: 8px; top: 166px; width: 210px; height: 43px;
    background-image:
      linear-gradient(180deg, rgba(255,255,255,.05) 0%, rgba(0,0,0,0) 38%, rgba(0,0,0,.12) 100%),
      linear-gradient(90deg,
        #d7037c 0%,
        #d6068a 7%,
        #ba0a8e 11%,
        #800499 22%,
        #52029f 30%,
        #4203ab 38%,
        #3c04ae 42%,
        #3b1fb0 49%,
        #452199 56%,
        #62186a 64%,
        #7c1a59 72%,
        #9a1945 79%,
        #bf172d 90%,
        #cc1f21 100%);
  }

  .pg__marcas { left: 0; top: 223px; width: 229px; height: 14px; }
</style>
