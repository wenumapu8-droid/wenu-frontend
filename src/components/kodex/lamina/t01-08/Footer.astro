---
/**
 * t01-08 · FOOTER — franja inferior (1672×75).
 *
 * La caja empieza en y=866, así que las coordenadas de acá están corridas −866
 * respecto del póster. Las x sí son las del póster.
 *
 * Mismo criterio que el Header: el logotipo, los dos lemas y el emblema salen
 * trazados del original (arte.ts) y no dibujados ni compuestos con una fuente,
 * y el código de barras es la luminancia por columna del original. La única
 * línea que sigue siendo <text> de verdad es "VISUAL SYSTEM v2.0", porque lleva
 * una cifra y las cifras del póster van como texto dentro de data-symbolic.
 *
 * Puntaje del panel: 0,31 % de diferencia contra la referencia.
 *   node scripts/lamina/score-panel.mjs t01-08-signal-bloom Footer --triptico
 * El arte se regenera con:
 *   node scripts/lamina/arte-t01-08-hdrftr.mjs
 *
 * El emblema del pie NO es el del encabezado a otra escala: mide 202×39 contra
 * 138×29 y su cuerpo central es un óvalo cerrado, no la almendra en punta de
 * arriba. Por eso van dos trazados y no uno escalado.
 */
import { ftrMarca, ftrAla, ftrLema, ftrPpp, ftrBarras } from "./arte";

interface Props { box: string }
const { box } = Astro.props;

const LSB = 0.9;
---

<div data-box style={box} class="ftr">
  <!-- Cierre del marco exterior: laterales y fondo. El borde de arriba lo abre
       el Header; acá sólo entra el tramo final del mismo rectángulo. -->
  <div class="ftr__marco"></div>

  <svg class="ftr__art" viewBox="0 0 1672 75" width="1672" height="75" aria-label="KODEX−∞ · VISUAL SYSTEM v2.0" role="img">
    <!-- Regla que separa el pie de la grilla de paneles. Cae justo en el borde
         superior de la caja (y=866 del póster) y es bastante más marcada que la
         del encabezado: media 29 sobre negro contra 12. -->
    <rect class="ftr__regla" x="14" y="0" width="1644" height="1" />

    <!-- "KODEX−∞", apagado a propósito en la referencia: el pie repite la marca
         sin volver a gritarla. -->
    <g class="ftr__marca">
      {ftrMarca.map((g) => (
        <svg x={g.x} y={g.y} width={g.w} height={g.h} viewBox={`0 0 ${g.vw} ${g.vh}`} preserveAspectRatio="none">
          {g.d.map(([d, tr]) => <path d={d} transform={tr} />)}
        </svg>
      ))}
    </g>

    <rect class="ftr__sep" x="173" y="15" width="1" height="29" />

    <g class="ftr__ala">
      {ftrAla.map((g) => (
        <svg x={g.x} y={g.y} width={g.w} height={g.h} viewBox={`0 0 ${g.vw} ${g.vh}`} preserveAspectRatio="none">
          {g.d.map(([d, tr]) => <path d={d} transform={tr} />)}
        </svg>
      ))}
    </g>

    <g class="ftr__barras">
      {ftrBarras.tramos.map(([x, w, v]) => (
        <rect x={x} y={ftrBarras.y} width={w} height={ftrBarras.h} fill={`rgb(${v},${v},${v})`} />
      ))}
    </g>

    <!-- data-symbolic: "VISUAL SYSTEM v2.0" es el rótulo de versión ficticio del
         póster, no la versión real de ningún sistema. -->
    <text class="ftr__meta" data-symbolic="true" x={187 - LSB} y="32" textLength="117.5" lengthAdjust="spacing">VISUAL SYSTEM v2.0</text>

    <!-- Lema y consigna van trazados del original, no como <text>: ninguna mono
         del sistema coincide con la del póster y al mismo cuerpo fallaban en
         casi todos sus píxeles de tinta. El texto real queda en el aria-label.
         La línea de versión de arriba SÍ sigue siendo texto: lleva cifras, y
         las cifras del póster van como texto dentro de data-symbolic. -->
    <g class="ftr__lema" role="img" aria-label="BUILT FOR ARCHIVES THAT REMEMBER.">
      {ftrLema.map((g) => (
        <svg x={g.x} y={g.y} width={g.w} height={g.h} viewBox={`0 0 ${g.vw} ${g.vh}`} preserveAspectRatio="none">
          {g.d.map(([d, tr]) => <path d={d} transform={tr} />)}
        </svg>
      ))}
    </g>

    <g class="ftr__ppp" role="img" aria-label="PATTERN. PROTECT. PERPETUATE.">
      {ftrPpp.map((g) => (
        <svg x={g.x} y={g.y} width={g.w} height={g.h} viewBox={`0 0 ${g.vw} ${g.vh}`} preserveAspectRatio="none">
          {g.d.map(([d, tr]) => <path d={d} transform={tr} />)}
        </svg>
      ))}
    </g>
  </svg>
</div>

<style>
  .ftr { overflow: hidden; color: var(--lam-ink); }

  /* Sólo laterales y fondo, con el mismo radio de 5 px del encabezado. El canto
     derecho va más brillante que el izquierdo, igual que arriba. */
  .ftr__marco {
    position: absolute;
    left: 6px;
    top: -140px;
    width: 1661px;
    height: 209px;
    box-sizing: border-box;
    border: 1px solid rgba(216, 212, 204, 0.117);
    border-right-color: rgba(216, 212, 204, 0.203);
    border-bottom-color: rgba(216, 212, 204, 0.102);
    border-top: 0;
    border-radius: 0 0 5px 5px;
  }

  .ftr__art { position: absolute; left: 0; top: 0; }

  .ftr__marca path { fill: #414141; }
  .ftr__ala path { fill: #353535; }
  /* Grises barridos en el banco, no medidos de la tinta: el trazado no tiene
     antialias y el relleno paga esa diferencia de cobertura. */

  .ftr__regla { fill: rgba(216, 212, 204, 0.134); }
  .ftr__sep { fill: rgba(216, 212, 204, 0.1); }

  .ftr text {
    font-family: var(--lam-mono);
    font-variant-ligatures: none;
    white-space: pre;
  }
  .ftr__meta { font-size: 9.2px; fill: #4a4a4a; }
  .ftr__lema path { fill: #3c3c3c; }
  .ftr__ppp path { fill: #3a3a3a; }
</style>
