---
/**
 * KODEX-∞ · t01-08 · 07. MINI POSTER / CARTEL
 *
 * El póster entero reducido a 204×272: la lámina mostrándose a sí misma. La
 * floración es la MISMA del héroe (mismo pintor, radio chico y menos
 * profundidad de rama), no un dibujo distinto que se le parece.
 *
 * Medido: título en y4–13 desde x6; regla gris en y18; marco del cartel de
 * y21 a y265 entre x2 y x203; la mancha de arte ocupa y26–181; la fila de
 * TANDA 01 cae en y188–197; el bloque de pie va de y203 a y256 y la regla
 * inferior en y263.
 */
import Micrografia from "../kit/Micrografia.astro";

interface Props { box: string }
const { box } = Astro.props;

/* Columna de glifos del riel: cada uno es una marca fija, no contenido. */
---

<div data-box style={box} class="mp">
  <h2 class="mp__titulo"><span>07.</span> MINI POSTER <em>/ CARTEL</em></h2>
  <i class="mp__regla" aria-hidden="true"></i>
  <i class="mp__marca" aria-hidden="true"></i>

  <div class="mp__cartel">
    <canvas class="mp__lienzo" width="197" height="243" aria-hidden="true"></canvas>

    <!-- cabecera -->
    <div class="mp__wm"><span>KODEX−∞</span></div>
    <div class="mp__wmcaja" aria-hidden="true"></div>
    <div class="mp__cab2" aria-hidden="true">
      <Micrografia w={34} h={14} semilla={41} renglon={3.4} marca={1} palabra={4} color="#c0325f" opacidad={0.55} />
    </div>
    <p class="mp__remix">REMIX</p>

    <!-- riel izquierdo -->
    <div class="mp__riel mp__riel--izq" aria-hidden="true">
      <div class="mp__cel" style="top:0;height:24px">
        <Micrografia w={20} h={20} semilla={7} renglon={3.2} marca={1} palabra={4} color="#d8407a" opacidad={0.6} />
      </div>
      <svg class="mp__cel mp__glf" style="top:28px;height:23px" viewBox="0 0 22 23">
        <circle cx="11" cy="11.5" r="10" fill="none" stroke="#d4318c" stroke-width=".9" />
        <g stroke="#e657c0" fill="none" stroke-width=".7" stroke-linecap="round">
          <path d="M11 18v-8M11 12l-3-3M11 12l3-3" />
          <path d="M8 9c-2.5-.6-3.6-2.6-2.6-4.3M14 9c2.5-.6 3.6-2.6 2.6-4.3" />
          <path d="M11 6.5c-1.8-1.2-2-3.2-.6-4.3" />
          <path d="M7.6 18h6.8" stroke-width=".9" />
        </g>
      </svg>
      <svg class="mp__cel mp__glf" style="top:56px;height:19px" viewBox="0 0 22 19">
        <path d="M11 2L20 17H2z" fill="none" stroke="#8e8b84" stroke-width=".8" />
        <path d="M11 7v5M11 14v1.2" stroke="#8e8b84" stroke-width="1" />
      </svg>
      <div class="mp__cel" style="top:78px;height:14px">
        <Micrografia w={20} h={14} semilla={19} renglon={3.2} marca={1} palabra={4} color="#c0325f" opacidad={0.5} />
      </div>
      <svg class="mp__cel mp__glf" style="top:100px;height:18px" viewBox="0 0 22 18">
        <path d="M11 1l8.6 4.5v7L11 17l-8.6-4.5v-7z" fill="none" stroke="#b8355f" stroke-width=".8" />
        <circle cx="11" cy="9" r="3.2" fill="none" stroke="#e05a95" stroke-width=".7" />
      </svg>
    </div>

    <!-- riel derecho -->
    <div class="mp__riel mp__riel--der" aria-hidden="true">
      <svg class="mp__cel mp__glf" style="top:0;height:21px" viewBox="0 0 26 21">
        <circle cx="13" cy="10.5" r="9.2" fill="none" stroke="#d4318c" stroke-width=".9" />
        <g stroke="#e657c0" fill="none" stroke-width=".7" stroke-linecap="round">
          <path d="M13 17v-7.5M13 11l-2.8-2.8M13 11l2.8-2.8" />
          <path d="M10.2 8.2c-2.3-.6-3.3-2.4-2.4-4M15.8 8.2c2.3-.6 3.3-2.4 2.4-4" />
          <path d="M9.8 17h6.4" stroke-width=".9" />
        </g>
      </svg>
      <svg class="mp__cel mp__glf" style="top:25px;height:21px" viewBox="0 0 26 21">
        <circle cx="13" cy="10.5" r="9.2" fill="none" stroke="#d4318c" stroke-width=".9" />
        <g stroke="#e657c0" fill="none" stroke-width=".7" stroke-linecap="round">
          <path d="M13 17v-7.5M13 11l-2.8-2.8M13 11l2.8-2.8" />
          <path d="M10.2 8.2c-2.3-.6-3.3-2.4-2.4-4M15.8 8.2c2.3-.6 3.3-2.4 2.4-4" />
          <path d="M9.8 17h6.4" stroke-width=".9" />
        </g>
      </svg>
      <div class="mp__cel" style="top:50px;height:14px">
        <Micrografia w={26} h={14} semilla={23} renglon={3.2} marca={1} palabra={4} color="#b8b4ac" opacidad={0.4} />
      </div>
      <svg class="mp__cel mp__glf" style="top:68px;height:18px" viewBox="0 0 26 18">
        <path d="M6 3l14 12M20 3L6 15" stroke="#9b6f8a" stroke-width=".7" />
        <circle cx="13" cy="9" r="7" fill="none" stroke="#9b6f8a" stroke-width=".5" opacity=".7" />
      </svg>
      <svg class="mp__cel mp__glf" style="top:90px;height:18px" viewBox="0 0 26 18">
        <circle cx="13" cy="9" r="6.4" fill="none" stroke="#d4318c" stroke-width=".8" />
        <path d="M13 2.6v12.8M6.6 9h12.8" stroke="#d4318c" stroke-width=".6" />
      </svg>
      <svg class="mp__cel mp__glf" style="top:112px;height:14px" viewBox="0 0 26 14">
        <path d="M13 2l7 10H6z" fill="none" stroke="#8e8b84" stroke-width=".8" />
        <path d="M13 5.6v3.2" stroke="#8e8b84" stroke-width=".9" />
      </svg>
      <div class="mp__cel" style="top:130px;height:28px">
        <Micrografia w={26} h={28} semilla={29} renglon={3.4} marca={1} palabra={4} color="#c0325f" opacidad={0.5} />
      </div>
    </div>

    <!-- pie del cartel -->
    <div class="mp__tanda"><span>TANDA 01</span></div>
    <div class="mp__cajita" aria-hidden="true">
      <Micrografia w={31} h={11} semilla={53} renglon={3.2} marca={1} palabra={4} color="#c0325f" opacidad={0.55} />
    </div>
    <div class="mp__barras" aria-hidden="true" data-symbolic="true">
      <i style="top:0;width:100%;background:#6d1018"></i>
      <i style="top:6px;width:78%;background:#96171f"></i>
      <i style="top:12px;width:96%;background:#a81b26"></i>
      <i style="top:18px;width:52%;background:#44239c"></i>
      <i style="top:24px;width:70%;background:#5c2fa8"></i>
    </div>

    <p class="mp__l1">TRANSMISSION FIELD</p>
    <p class="mp__l2">FLORACIÓN DE SEÑAL</p>
    <p class="mp__l3">DO NOT OBSERVE. CONSTRUCT.</p>
    <i class="mp__barcode" aria-hidden="true"></i>

    <div class="mp__caja2" aria-hidden="true">
      <Micrografia w={26} h={32} semilla={67} renglon={3.4} marca={1} palabra={4} color="#a52a55" opacidad={0.5} />
    </div>

    <svg class="mp__sello" viewBox="0 0 52 52" aria-hidden="true">
      <circle cx="26" cy="26" r="25" fill="none" stroke="#e4489c" stroke-width="1.2" />
      <circle cx="26" cy="26" r="20.5" fill="none" stroke="#e4489c" stroke-width=".9" opacity=".9" />
      <circle cx="26" cy="26" r="18" fill="none" stroke="#b82f78" stroke-width=".7" opacity=".85" />
      <g stroke="#fb74d8" fill="none" stroke-width="1.2" stroke-linecap="round">
        <path d="M26 38V22M26 26l-5-5M26 26l5-5M26 31l-4-4M26 31l4-4" stroke-width="1" />
        <path d="M21 21c-4-1-6-3.6-4.6-6.6M31 21c4-1 6-3.6 4.6-6.6" stroke-width=".7" />
        <path d="M26 16c-2.8-2-3-5.2-.8-6.8" stroke-width=".7" />
        <path d="M20 38h12" />
      </g>
      <g fill="#c02f80" opacity=".8">
        <rect x="25.4" y="1.4" width="1.2" height="3" />
        <rect x="25.4" y="47.6" width="1.2" height="3" />
        <rect x="1.4" y="25.4" width="3" height="1.2" />
        <rect x="47.6" y="25.4" width="3" height="1.2" />
      </g>
    </svg>
  </div>

  <i class="mp__regla-baja" aria-hidden="true"></i>
</div>

<style>
  .mp {
    --ink: #8d8f8b;
    --dim: #62645f;
    --acc: #f22a6c;
    overflow: hidden;
    font-family: var(--lam-mono, ui-monospace, Menlo, monospace);
    color: var(--ink);
  }
  .mp h2, .mp p { margin: 0; }
  .mp i, .mp p, .mp svg, .mp canvas, .mp div { position: absolute; }

  .mp__titulo {
    position: absolute; left: 6px; top: 2px; margin: 0;
    font-size: 9.7px; font-weight: 400; letter-spacing: 0;
    color: var(--ink); white-space: nowrap;
  }
  .mp__titulo span { position: static; color: var(--acc); }
  .mp__titulo em { position: static; font-style: normal; color: var(--dim); }
  .mp__regla { left: 3px; top: 19px; width: 200px; height: 1px; background: #34312d; }
  .mp__marca { left: 6px; top: 15px; width: 15px; height: 1px; background: #4b4844; }
  .mp__regla-baja { left: 3px; top: 263px; width: 200px; height: 1px; background: #2a2724; }

  .mp__cartel {
    left: 3px; top: 21px; width: 199px; height: 244px;
    border: 1px solid #4a1230; box-sizing: border-box; overflow: hidden;
    background: #030103;
  }
  .mp__lienzo { left: 1px; top: 1px; width: 197px; height: 240px; }

  /* cabecera */
  .mp__wmcaja { left: 5px; top: 4px; width: 124px; height: 25px; border: 1px solid #4a1230; }
  .mp__wm { left: 8px; top: 4px; width: 121px; height: 25px; display: flex; align-items: center; }
  .mp__wm span {
    position: static;
    font-family: var(--lam-display, "Archivo", system-ui, sans-serif);
    font-weight: 800; font-size: 21.5px; letter-spacing: 1.4px; line-height: 1;
    color: #c9c6c0;
  }
  .mp__cab2 { left: 133px; top: 4px; width: 34px; height: 14px; }
  .mp__remix {
    left: 170px; top: 3px; font-size: 6px; letter-spacing: .12em; color: #b0325f;
  }

  .mp__riel { top: 30px; width: 26px; }
  .mp__riel--izq { left: 6px; width: 22px; }
  .mp__riel--der { left: 170px; }
  .mp__cel { left: 0; width: 100%; }
  .mp__glf { fill: none; }

  /* pie */
  .mp__tanda {
    left: 7px; top: 162px; width: 61px; height: 17px;
    border: 1px solid #4a1230; display: flex; align-items: center; justify-content: center;
  }
  .mp__tanda span { position: static; font-size: 11px; letter-spacing: .07em; color: #a6a39d; }
  .mp__cajita { left: 71px; top: 163px; width: 33px; height: 13px; border: 1px solid #3d1027; padding: 1px; }
  .mp__barras { left: 108px; top: 164px; width: 56px; height: 30px; }
  .mp__barras i { left: 0; height: 2px; opacity: .45; }

  .mp__l1 { left: 9px; top: 180px; font-size: 8.6px; letter-spacing: .06em; color: #7d7f7a; }
  .mp__l2 { left: 9px; top: 188px; font-size: 8.6px; letter-spacing: .06em; color: #7d7f7a; }
  .mp__l3 { left: 9px; top: 203px; font-size: 7.6px; letter-spacing: .06em; color: #6b6d68; }
  .mp__barcode {
    left: 9px; top: 218px; width: 99px; height: 15px;
    background-image:
      repeating-linear-gradient(90deg, #b9b5ad 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, #b9b5ad 0 2px, transparent 2px 7px),
      repeating-linear-gradient(90deg, #b9b5ad 0 1px, transparent 1px 11px);
    opacity: .4;
  }
  .mp__caja2 { left: 112px; top: 199px; width: 28px; height: 34px; border: 1px solid #3d1027; padding: 1px; }
  .mp__sello { left: 145px; top: 190px; width: 46px; height: 46px; }
</style>

<script>
  import { pintarFloracion, rng } from "./floracion.js";

  function pintar() {
    const nodos = document.querySelectorAll(".mp__lienzo");
    for (const cv of nodos) {
      if (cv.dataset.pintado === "1") continue;
      cv.dataset.pintado = "1";
      const W = 197;
      const H = 240;
      cv.width = W * 2;
      cv.height = H * 2;
      const ctx = cv.getContext("2d");
      ctx.scale(2, 2);
      ctx.fillStyle = "#030103";
      ctx.fillRect(0, 0, W, H);
      /* Polvo primero: el cartel tampoco tiene negro liso. */
      const rd = rng(0x3311);
      ctx.globalCompositeOperation = "lighter";
      for (let i = 0; i < 150; i++) {
        ctx.globalAlpha = 0.05 + rd() * 0.2;
        ctx.fillStyle = rd() < 0.2 ? "#6a5cff" : "#c8258f";
        ctx.fillRect(rd() * W, rd() * H, 0.9, 0.9);
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = "source-over";
      pintarFloracion(ctx, { cx: 102, cy: 85, R: 64, semilla: 0x51b1, detalle: 1, estado: "BLOOM", alfa: 0.42 });
      /* Plano y reflejo bajo la floración, como en el héroe. */
      ctx.globalCompositeOperation = "lighter";
      const g = ctx.createLinearGradient(30, 0, 172, 0);
      g.addColorStop(0, "rgba(255,60,200,0)");
      g.addColorStop(0.5, "rgba(255,170,250,0.5)");
      g.addColorStop(1, "rgba(255,60,200,0)");
      ctx.fillStyle = g;
      ctx.fillRect(30, 148, 142, 0.9);
      for (let i = 1; i <= 4; i++) {
        ctx.globalAlpha = 0.2 - i * 0.03;
        ctx.strokeStyle = "rgba(220,70,210,1)";
        ctx.lineWidth = 0.5;
        ctx.beginPath();
        ctx.ellipse(102, 150, 14.5 * i, 2.6 * i, 0, 0, Math.PI * 2);
        ctx.stroke();
      }
      const gr = ctx.createRadialGradient(102, 150, 0, 102, 150, 16);
      gr.addColorStop(0, "rgba(255,255,255,0.9)");
      gr.addColorStop(0.2, "rgba(255,110,235,0.45)");
      gr.addColorStop(1, "rgba(160,40,190,0)");
      ctx.globalAlpha = 1;
      ctx.fillStyle = gr;
      ctx.beginPath();
      ctx.ellipse(102, 150, 16, 9, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.globalCompositeOperation = "source-over";
    }
  }

  pintar();
  const w = window;
  if (typeof w.__kdxRegisterFreeze === "function") {
    w.__kdxRegisterFreeze(pintar);
  } else {
    let n = 0;
    const id = setInterval(() => {
      if (typeof w.__kdxRegisterFreeze === "function") {
        clearInterval(id);
        w.__kdxRegisterFreeze(pintar);
      } else if (++n > 200) clearInterval(id);
    }, 25);
  }
</script>
