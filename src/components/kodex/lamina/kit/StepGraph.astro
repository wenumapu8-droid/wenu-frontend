---
/**
 * KIT · GRÁFICO DE SERIE
 *
 * El DEPTH GRAPH y sus parientes: una curva ascendente dentada, con relleno de
 * área, retícula fina y etiquetas de eje.
 *
 * Se dibuja a mano y no con una librería de gráficos, y la decisión está medida
 * (2026-08-09, DEPTH GRAPH de 179×115): a mano da 6,83 % de diferencia contra la
 * referencia, ECharts 6.1 en SSR da 9,07 %.
 *
 * El motivo es más interesante que el número. La referencia rotula su eje Y
 * `10K · 8K · 4K · 2K · 800K`, que no es una escala real: es decorativa. ECharts
 * elige ticks matemáticamente correctos (10.000 · 1.000 · 300) y no hay forma de
 * convencerlo sin pelearle al motor de ejes. Corrige el eje hacia lo correcto —
 * y la referencia no es correcta. Para un tablero propio eso es una virtud;
 * para reproducir una lámina, es el problema.
 *
 * Lo que sí conviene traer de fuera cuando haga falta es `d3-shape` y
 * `d3-scale`: unos pocos KB de matemática pura, sin opinión sobre el DOM.
 */
import { serieSuave, p2 } from "./rng";

interface Props {
  w: number;
  h: number;
  semilla?: number;
  /** valores 0..1; si no se pasan, se generan deterministas */
  valores?: number[];
  n?: number;
  /** sube la serie hacia la derecha, como el DEPTH GRAPH */
  tendencia?: number;
  /** dientes de sierra sobre la tendencia */
  diente?: number;
  color?: string;
  relleno?: string;
  /** retícula: [columnas, filas]; [0,0] la apaga */
  reticula?: [number, number];
  colorReticula?: string;
  etiquetasX?: string[];
  etiquetasY?: string[];
  colorEtiqueta?: string;
  simbolico?: boolean;
  clase?: string;
}
const {
  w, h,
  semilla = 5,
  valores,
  n = 42,
  tendencia = 0.85,
  diente = 0.16,
  color = "currentColor",
  relleno = "",
  reticula = [5, 4],
  colorReticula = "",
  etiquetasX = [],
  etiquetasY = [],
  colorEtiqueta = "",
  simbolico = true,
  clase = "",
} = Astro.props;

// Márgenes: se reservan sólo si hay etiquetas. Un gráfico sin ejes debe llenar
// su caja entera, o queda flotando y el diff lo castiga por desplazamiento.
const mL = etiquetasY.length ? 16 : 0;
const mB = etiquetasX.length ? 9 : 0;
const pw = w - mL;
const ph = h - mB;

const base = valores ?? serieSuave(semilla, n, 0.55, 0, 1);
const pts = base.map((v, i) => {
  const t = i / (base.length - 1 || 1);
  // La tendencia es exponencial, no lineal: así la curva arranca plana y se
  // dispara al final, que es la forma que tiene en la referencia.
  const sube = Math.pow(t, 1.6) * tendencia;
  const y = Math.max(0.02, Math.min(0.98, sube + (v - 0.5) * diente + 0.06));
  return { x: p2(mL + t * pw), y: p2(ph - y * ph) };
});

const linea = pts.map((p, i) => `${i ? "L" : "M"}${p.x} ${p.y}`).join("");
const area = `${linea}L${p2(mL + pw)} ${p2(ph)}L${p2(mL)} ${p2(ph)}Z`;

const [gc, gr] = reticula;
---

<svg
  class={`kit-sg ${clase}`}
  viewBox={`0 0 ${w} ${h}`}
  width={w}
  height={h}
  data-symbolic={simbolico ? "true" : undefined}
  aria-hidden="true"
>
  {(gc > 0 || gr > 0) && (
    <g stroke={colorReticula || color} stroke-width="0.3" opacity="0.2">
      {Array.from({ length: gc + 1 }, (_, i) => (
        <line x1={p2(mL + (i * pw) / gc)} y1="0" x2={p2(mL + (i * pw) / gc)} y2={p2(ph)} />
      ))}
      {Array.from({ length: gr + 1 }, (_, i) => (
        <line x1={p2(mL)} y1={p2((i * ph) / gr)} x2={p2(w)} y2={p2((i * ph) / gr)} />
      ))}
    </g>
  )}

  {relleno && <path d={area} fill={relleno} />}
  <path d={linea} fill="none" stroke={color} stroke-width="0.9" stroke-linejoin="round" />

  {etiquetasY.map((t, i) => (
    <text
      class="kit-sg__lbl"
      x={p2(mL - 3)}
      y={p2((i * ph) / Math.max(1, etiquetasY.length - 1) + 2)}
      text-anchor="end"
      fill={colorEtiqueta || color}
    >{t}</text>
  ))}
  {etiquetasX.map((t, i) => (
    <text
      class="kit-sg__lbl"
      x={p2(mL + (i * pw) / Math.max(1, etiquetasX.length - 1))}
      y={p2(h - 1)}
      text-anchor="middle"
      fill={colorEtiqueta || color}
    >{t}</text>
  ))}
</svg>

<style>
  .kit-sg { display: block; }
  .kit-sg__lbl {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 5.5px;
    letter-spacing: 0.06em;
    opacity: 0.75;
  }
</style>
