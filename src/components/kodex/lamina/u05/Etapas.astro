<script>
  /* Espécimen 01 — trazo de tiza sobre negro, pintado UNA vez. Sin TypeScript:
     Astro compila este bloque como JS. */
  const cv = document.querySelector('[data-bloque="Etapas"] [data-arte="fuente"]');
  if (cv) {
    const W = 161;
    const H = 325;
    const TAU = Math.PI * 2;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = Math.round(W * dpr);
    cv.height = Math.round(H * dpr);
    const g = cv.getContext("2d");
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    g.lineCap = "round";
    g.lineJoin = "round";

    /* mulberry32, semilla fija. */
    function azar(semilla) {
      let a = semilla >>> 0;
      return () => {
        a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    const r = azar(0x0501);
    const TIZA = "196,186,166";

    /* Trazo de tiza: la polilínea se repasa dos veces con jitter y alfa baja,
       y se le siembra grano alrededor. Eso es lo que un path SVG limpio no da. */
    function tiza(pts, alfa, grosor) {
      /* Tres pasadas: trazo, repaso corrido y sangrado ancho tenue. La zona
         del panel 01 promedia L 10,8 en la referencia y con dos pasadas finas
         se quedaba en 6,9 — el carboncillo del póster tiene cuerpo. */
      const pases = [[grosor, alfa], [grosor * 0.75, alfa * 0.55], [grosor * 2.2, alfa * 0.28]];
      for (const [gw, ga] of pases) {
        g.beginPath();
        for (let i = 0; i < pts.length; i++) {
          const x = pts[i][0] + (r() - 0.5) * 1.1;
          const y = pts[i][1] + (r() - 0.5) * 1.1;
          i === 0 ? g.moveTo(x, y) : g.lineTo(x, y);
        }
        g.strokeStyle = "rgba(" + TIZA + "," + ga + ")";
        g.lineWidth = gw;
        g.stroke();
      }
      for (let i = 0; i < pts.length; i += 3) {
        if (r() < 0.5) continue;
        g.fillStyle = "rgba(" + TIZA + "," + alfa * 0.35 + ")";
        g.fillRect(pts[i][0] + (r() - 0.5) * 4, pts[i][1] + (r() - 0.5) * 4, 1, 1);
      }
    }
    const curva = (fn, n, t0, t1) => {
      const pts = [];
      for (let i = 0; i <= n; i++) pts.push(fn(t0 + ((t1 - t0) * i) / n));
      return pts;
    };
    const espiral = (cx, cy, rmax, vueltas) =>
      curva((t) => [cx + rmax * t * Math.cos(t * vueltas * TAU), cy + rmax * t * Math.sin(t * vueltas * TAU)], 80, 0.03, 1);
    const circulo = (cx, cy, rad) => curva((t) => [cx + rad * Math.cos(t * TAU), cy + rad * Math.sin(t * TAU)], 26, 0, 1.02);

    /* Rama: tronco + brotes laterales, recursión corta. */
    function rama(x0, y0, ang, largo, alfa, prof) {
      const pts = [];
      let x = x0, y = y0, a = ang;
      const n = 8;
      for (let i = 0; i <= n; i++) {
        pts.push([x, y]);
        a += (r() - 0.5) * 0.5;
        x += (largo / n) * Math.cos(a);
        y += (largo / n) * Math.sin(a);
        if (prof > 0 && i > 2 && r() < 0.4) rama(x, y, a + (r() < 0.5 ? -0.9 : 0.9), largo * 0.4, alfa * 0.8, prof - 1);
      }
      tiza(pts, alfa, 0.8);
    }

    /* ── composición, en coordenadas locales del panel (0,0 = 86,402) ──── */
    /* Mitad alta: espirales, ramas, corazón, ojo. Divisoria en y≈198.
       Mitad baja: garabatos, círculos concéntricos y sismograma. */
    tiza(espiral(52, 45, 24, 2.6), 0.8, 1.2);
    tiza(espiral(122, 35, 13, 2.1), 0.62, 1);
    tiza(circulo(130, 33, 17).slice(4, 22), 0.55, 1);
    rama(112, 52, 1.9, 82, 0.75, 2);
    rama(140, 66, 2.2, 66, 0.6, 2);
    rama(48, 95, 1.3, 58, 0.55, 1);
    rama(90, 40, 1.6, 70, 0.5, 2);
    rama(30, 130, 0.9, 46, 0.45, 1);
    /* corazón */
    tiza(curva((t) => {
      const a = t * TAU;
      const x = 16 * Math.pow(Math.sin(a), 3);
      const y = -(13 * Math.cos(a) - 5 * Math.cos(2 * a) - 2 * Math.cos(3 * a) - Math.cos(4 * a));
      return [36 + x * 0.85, 165 + y * 0.85];
    }, 40, 0, 1), 0.75, 1.1);
    /* ojo: almendra + iris */
    tiza(curva((t) => [129 + 18 * Math.cos(t * TAU), 146 + 7 * Math.sin(t * TAU)], 30, 0, 1), 0.6, 1);
    tiza(circulo(129, 146, 4), 0.65, 1);
    /* motas y circulitos sueltos */
    for (let i = 0; i < 10; i++) tiza(circulo(20 + r() * 120, 30 + r() * 150, 1.5 + r() * 3.5), 0.4 + r() * 0.25, 0.9);
    /* divisoria rayada */
    tiza(curva((t) => [10 + t * 142, 198 + (r() - 0.5) * 2], 40, 0, 1), 0.55, 1);
    /* mitad baja */
    tiza(espiral(28, 232, 13, 2.2), 0.62, 1);
    tiza(curva((t) => [58 + t * 52, 230 + 7 * Math.sin(t * 26)], 52, 0, 1), 0.58, 1);
    tiza(circulo(36, 288, 5), 0.55, 1);
    tiza(circulo(36, 288, 10), 0.46, 1);
    tiza(circulo(36, 288, 15), 0.38, 1);
    tiza(circulo(132, 250, 8).slice(3, 20), 0.55, 1);
    tiza(circulo(118, 305, 6), 0.4, 0.9);
    tiza(curva((t) => [96 + t * 40, 252 + 5 * Math.sin(t * 18)], 40, 0, 1), 0.42, 0.9);
    /* sismograma: reposo con ráfagas */
    (function () {
      const pts = [];
      for (let i = 0; i <= 140; i++) {
        const x = 12 + i;
        const raf = Math.exp(-Math.pow((i - 55) / 16, 2)) + 0.7 * Math.exp(-Math.pow((i - 100) / 9, 2));
        pts.push([x, 283 + (r() - 0.5) * 3 - raf * (r() * 30 - 15)]);
      }
      tiza(pts, 0.8, 0.9);
    })();
    for (let i = 0; i < 70; i++) {
      g.fillStyle = "rgba(" + TIZA + "," + (0.15 + r() * 0.35) + ")";
      g.fillRect(8 + r() * 145, 12 + r() * 300, 1, 1);
    }
  }
</script>
