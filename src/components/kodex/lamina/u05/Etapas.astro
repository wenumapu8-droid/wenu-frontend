/**
 * KODEX-∞ · u05-genesis · ETAPAS — la secuencia de seis paneles, y 335..860.
 *
 * Seis cajas de espécimen con su cabecera numerada y su anotación, medidas
 * columna por columna sobre la referencia (umbral sobre la media por columna
 * en y 450..700):
 *
 *   01 ARTIFACT SOURCE     x  84..249   (canvas de tiza — ver <script>)
 *   02 RECURRING GEOMETRY  x 259..421   (dos columnas de mandalas, cx 301/380)
 *   03 SYMBOL              x 433..576   (cinco glifos apilados, cx 505)
 *   04 RULE                x 586..727   (rótulos + diagramas, margen x 599)
 *   05 CODE                x 738..887   (alfabeto + sintaxis, cx 812)
 *   06 ORGANISM            x 898..1048  (canvas vivo — Organismo.astro)
 *
 * Todas las cajas corren de y=400 a y=728. Cabeceras: números y 342..351,
 * nombres y 364..372, dominios y 382..388, con chevrones entre etapas en
 * x 251/434/583/736/894. Anotaciones: 5-6 líneas desde y≈753, paso 16,4.
 *
 * Los especímenes 02..05 son SVG paramétrico (círculos, radios, cuerdas y
 * pétalos generados en frontmatter con mulberry32 — jamás Math.random()). El
 * 01 es un canvas estático de trazo de tiza: la textura rota del carboncillo
 * no sale de un path limpio. El 06 vive en su propio componente porque está
 * animado.
 */
import { rayos, rombo, lemniscata } from "../serie-universe/geom";

/* mulberry32 — determinista, la misma de todo el proyecto. */
function azar(semilla: number) {
  let a = semilla >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const p2 = (v: number) => +v.toFixed(2);

/* ── cabeceras ──────────────────────────────────────────────────────────── */
const etapas = [
  { cx: 169, num: "01", nombre: "ARTIFACT SOURCE", dominio: "RAW IMPRESSION" },
  { cx: 340, num: "02", nombre: "RECURRING GEOMETRY", dominio: "PATTERN EMERGENCE" },
  { cx: 504.5, num: "03", nombre: "SYMBOL", dominio: "MEANING SEED" },
  { cx: 651, num: "04", nombre: "RULE", dominio: "RELATION & ORDER" },
  { cx: 810, num: "05", nombre: "CODE", dominio: "ENCODING INTENT" },
  { cx: 970, num: "06", nombre: "ORGANISM", dominio: "LIVING SYSTEM" },
];
const chevrones = [251, 434, 583, 736, 894];

/* ── cajas ──────────────────────────────────────────────────────────────── */
const cajas: [number, number][] = [[84.5, 248.5], [259.5, 421.5], [433.5, 575.5], [586.5, 727.5], [738.5, 886.5], [898.5, 1047.5]];
const CAJA_Y0 = 400.5;
const CAJA_Y1 = 728.5;

/* ── anotaciones ────────────────────────────────────────────────────────── */
const anotaciones: [number, string[]][] = [
  [99, ["OCÍN'S EARLIEST", "OBSERVATIONS.", "NATURAL FORMS,", "EMOTIONAL IMPULSES,", "RHYTHMS, AND DREAM", "FRAGMENTS."]],
  [271, ["REPETITION REVEALS", "STRUCTURE.", "SYMMETRY OBSERVED.", "RATIOS FELT.", "PATTERNS BEGIN", "TO CONSOLIDATE."]],
  [447, ["FORMS ARE CHOSEN.", "ASSOCIATIONS BORN.", "SYMBOLS BECOME", "CARRIERS OF", "INTENTION."]],
  [599, ["RELATIONSHIPS", "ESTABLISHED.", "RULES EMERGE FROM", "OBSERVATION.", "ORDER CREATES", "PREDICTABILITY."]],
  [751, ["INTENT IS ENCODED.", "SYMBOLS COMBINE.", "SYNTAX FORMS.", "MEANING BECOMES", "TRANSMISSIBLE."]],
  [913, ["THE KODEX AWAKENS.", "IT RESPONDS.", "IT ADAPTS.", "IT SEEKS RETURN.", "IT IS ALIVE."]],
];
const CHAR = 5.55; // avance por carácter medido: OCÍN'S EARLIEST = 83 px / 15

/* ── espécimen 02 · mandalas ────────────────────────────────────────────── */
/* Telaraña radial: anillo + radios + cuerdas entre puntos del anillo. */
function tela(cx: number, cy: number, r: number, n: number, semilla: number, saltos: number[]): string {
  const rr = azar(semilla);
  const pt = (k: number, rad = r) => [p2(cx + rad * Math.cos(-Math.PI / 2 + (k * 2 * Math.PI) / n)), p2(cy + rad * Math.sin(-Math.PI / 2 + (k * 2 * Math.PI) / n))];
  let d = "";
  for (let k = 0; k < n; k++) {
    const [x, y] = pt(k);
    d += `M${cx} ${cy}L${x} ${y}`;
  }
  for (const s of saltos) {
    for (let k = 0; k < n; k++) {
      if (rr() < 0.25) continue;
      const [x0, y0] = pt(k);
      const [x1, y1] = pt(k + s);
      d += `M${x0} ${y0}L${x1} ${y1}`;
    }
  }
  return d;
}
function espiral(cx: number, cy: number, r0: number, r1: number, vueltas: number): string {
  const N = 90;
  let d = "";
  for (let i = 0; i <= N; i++) {
    const t = i / N;
    const a = t * vueltas * 2 * Math.PI;
    const r = r0 + (r1 - r0) * t;
    d += `${i ? "L" : "M"}${p2(cx + r * Math.cos(a))} ${p2(cy + r * Math.sin(a))}`;
  }
  return d;
}
/* Pétalos: n elipses que pasan cerca del centro, giradas. Devuelve lista de
   transform + rx/ry para <ellipse>. */
const petalos = (n: number) => Array.from({ length: n }, (_, k) => (k * 360) / n);

/* Nodo estrellado: cruz larga + destello. */
const nodo = (cx: number, cy: number, r: number) => `M${cx - r} ${cy}H${cx + r}M${cx} ${cy - r * 1.25}V${cy + r * 1.25}`;

/* ── espécimen 03 · corazón de línea (caja nativa 18×14 en el origen) ───── */
const HEART =
  "M0,7.2 C-1.4,4.4 -5.4,2.8 -7.2,0 C-9.1,-3.1 -6.7,-7.2 -3.3,-7.2 " +
  "C-1.4,-7.2 -0.4,-6.1 0,-5 C0.4,-6.1 1.4,-7.2 3.3,-7.2 " +
  "C6.7,-7.2 9.1,-3.1 7.2,0 C5.4,2.8 1.4,4.4 0,7.2 Z";

/* ── espécimen 04 · onda trenzada del DUAL FLOW ─────────────────────────── */
function trenza(x0: number, x1: number, cy: number, amp: number, fase: number): string {
  const N = 48;
  let d = "";
  for (let i = 0; i <= N; i++) {
    const t = i / N;
    const x = x0 + (x1 - x0) * t;
    const y = cy + amp * Math.sin(t * 2 * Math.PI * 2 + fase) * Math.sin(Math.PI * t);
    d += `${i ? "L" : "M"}${p2(x)} ${p2(y)}`;
  }
  return d;
}

/* ── espécimen 05 · alfabeto primordial ─────────────────────────────────── */
/* Ficción del póster: glifos ilegibles a este cuerpo. Mezcla de capitales y
   signos, no un alfabeto real. */
const alfabeto = [["K", "D", "E", "T", "Y"], ["◇", "⊙", "H", "D", "X"], ["T", "A", "L", "Z", "M"], ["I", "H", "A", "S", "W"], ["Y", "P", "C", "E", "R"]];

/* Barcode del COMPRESSION: anchos irregulares, sorteados con semilla. */
const barras = (() => {
  const rr = azar(0x0505);
  const out: [number, number, number][] = [];
  let x = 750;
  while (x < 800) {
    const w = 1 + Math.floor(rr() * 3);
    out.push([p2(x), w, 0.3 + rr() * 0.5]);
    x += w + 1 + rr() * 2.5;
  }
  return out;
})();
