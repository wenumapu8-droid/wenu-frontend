---
/**
 * KODEX-∞ · u05-genesis · PIE — la banda final, y 1287..1402.
 *
 * La banda de tres columnas y el sello los pone `serie-universe/PieUniverse`.
 * Medido sobre la referencia:
 *   · regla de apertura y=1297,5 (la de y=1278 es el cierre del marco interior
 *     y la dibuja la Cabecera);
 *   · codigo x 67, líneas de base 1320 / 1336, violeta;
 *   · lema centrado: tinta x 370..733 → eje 551,5, con cruces en x 346,5 y 768;
 *   · ONE SOURCE / INFINITE EXPRESSIONS alineados a la derecha contra x=985;
 *   · sello hexagonal cx 1022,5 · cy 1326 · lados en x 997..1048 → R 29,5;
 *   · marco inferior y=1380,5 con el ornamento central (⋈ ·· ⟐ ·· ⋈) — va acá
 *     y no en la Cabecera porque el ornamento parte la regla.
 *
 * `KDX-GENESIS-0005 / ARCHIVE PROTOCOL ACTIVE` es ficción del póster:
 * PieUniverse ya lo marca data-symbolic="true".
 */
import PieUniverse from "../serie-universe/PieUniverse.astro";
import { rombo, romboR } from "../serie-universe/geom";

const EJE_LEMA = 551.5;

/* Paleta medida de u05 + calibrado por alfas de pintura (mandos `-a`). */
const vars = [
  "--pi-ink:#d8d4d0",
  "--pi-vio:#b48fe2",
  "--pi-cod-size:9.6px",
  "--pi-cod-ls:.1em",
  "--pi-cod-a:.6",
  "--pi-lema-size:11.5px",
  /* Tinta medida x 370..733 = 363 px para 40 caracteres → 9,07 px de paso,
     o sea 0,188em de interletrado a cuerpo 11,5 (0,3em desbordaba sobre las
     cruces — se vio en la captura). */
  "--pi-lema-ls:.188em",
  "--pi-lema-a:.6",
  "--pi-lema-tr:translateX(1.08px)",
  "--pi-fuente-size:9.4px",
  "--pi-fuente-ls:.12em",
  "--pi-fuente-a:.55",
  "--pi-fuente-fill:var(--pi-ink)",
  "--pi-fuente-tr:translateX(1.13px)",
  "--pi-expr-a:.5",
  "--pi-hex-a:.4",
  "--pi-rosa-a:.7",
  "--pi-pelo-a:.55",
].join(";")
---

<PieUniverse
  vars={vars}
  codigo={{ x: 67, y: 1320, t: "KDX-GENESIS-0005" }}
  estado={{ x: 67, y: 1336, t: "ARCHIVE PROTOCOL ACTIVE" }}
  lema={{ x: EJE_LEMA, y: 1323, anchor: "middle", t: "THE KODEX IS LIVING. YOU ARE PART OF IT." }}
  fuente={{ x: 985, y: 1319, anchor: "end", t: "ONE SOURCE" }}
  expr={{ x: 985, y: 1336, anchor: "end", t: "INFINITE EXPRESSIONS" }}
  sello={{ cx: 1022.5, cy: 1326, R: 29.5 }}
>
  <Fragment slot="antes">
    <!-- Regla de apertura de la banda, con cierres a los dos lados. -->
    <path class="u05pie__regla" d="M60 1297.5H1062" />
    <path class="u05pie__cierre" d="M50 1293.3v8.4m-4.2 -4.2h8.4" />
    <path class="u05pie__cierre" d={romboR(1069, 1297.5, 3.4)} />

    <!-- Marco inferior con ornamento central: la regla se parte en x 480/640. -->
    <path class="u05pie__marco" d="M31 1380.5H478M642 1380.5H1084" />
    <g class="u05pie__orna">
      <path d="M489 1377l7 7m0 -7l-7 7" />
      <circle cx="507" cy="1380.5" r="1.1" />
      <circle cx="519" cy="1380.5" r="1.1" />
      <path d={rombo(560, 1380.5, 11, 9)} />
      <circle cx="560" cy="1380.5" r="1.3" />
      <circle cx="601" cy="1380.5" r="1.1" />
      <circle cx="613" cy="1380.5" r="1.1" />
      <path d="M624 1377l7 7m0 -7l-7 7" />
    </g>
  </Fragment>

  {
    [346.5, 768].map((x) => (
      <g class="u05pie__cruz" slot="cruces">
        <rect x={x - 1.5} y="1318" width="3" height="3" />
        <path d={`M${x} 1314v2.2M${x} 1323v2.2M${x - 5.2} 1319.5H${x - 3}M${x + 3} 1319.5H${x + 5.2}`} />
      </g>
    ))
  }
</PieUniverse>

<style is:global>
  .u05pie__regla {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 1;
    stroke-opacity: 0.12;
  }
  .u05pie__cierre {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 1;
    stroke-opacity: 0.4;
  }
  .u05pie__marco {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 1;
    stroke-opacity: 0.12;
  }
  .u05pie__orna path {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 0.9;
    stroke-opacity: 0.42;
  }
  .u05pie__orna circle {
    fill: #d8d4d0;
    fill-opacity: 0.42;
  }
  .u05pie__cruz rect {
    fill: #d8d4d0;
    fill-opacity: 0.5;
  }
  .u05pie__cruz path {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 0.9;
    stroke-opacity: 0.5;
  }
</style>
