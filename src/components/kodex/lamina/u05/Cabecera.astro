---
/**
 * KODEX-∞ · u05-genesis · CABECERA
 *
 * Cromo compartido de la serie (`serie-universe/CabeceraUniverse.astro`) con
 * las props medidas sobre `reference/canon/u05-genesis.png` (1122×1402).
 * Ninguna coordenada está estimada a ojo: salieron de barrer el PNG por filas
 * y columnas con umbral de luminancia.
 *
 * MEDIDO — lo que distingue a esta lámina de u02, que fijó los defaults:
 *  · FONDO negro puro: diez muestras dan rgb(0,0,0)–rgb(1,1,1). El píxel
 *    más oscuro muestreado también es 0.
 *  · PALETA: el título es plata CÁLIDA (top-2 % de tinta rgb 199,196,190),
 *    no la plata violácea de u02; el cuerpo de texto es gris NEUTRO
 *    (rgb 92,93,92 en pantalla) y el acento es un violeta menos saturado
 *    que el #a77cf0 de u02 — los rótulos violeta rinden rgb ~155,126,175.
 *  · HEXÁGONO corrido a la IZQUIERDA: centro en x=534,5 (u02 lo tiene en
 *    561,5), lados en x=514..555, vértices y=15 e y=60.
 *  · El marco inferior corre en y=1380,5 (u02: 1389,5) y lo dibuja el Pie
 *    porque lleva el ornamento central; acá sólo van los chaflanes.
 *  · MARCO INTERIOR: caja completa x 47..1077, y 59..1278 con esquinas
 *    marcadas — u02 sólo tenía las verticales.
 *  · Título "KODEX-∞ / GENESIS": versal 54 px (y 84..138), KODEX x 169..454,
 *    guion x 472..492, ∞ x 507..571 (centro 539), barra x 601..620,
 *    GENESIS x 654..973.
 *  · La bajada es "VISUAL LINEAGE" en violeta, versal 14 (y 152..166),
 *    x 443..683, flanqueada por rombos y puntos (marcas en x 380/408/713/740).
 *  · Tercera línea: sig x 75..132, nota x 372..747, PAGE 05 x 986..1047,
 *    línea de base 192.
 *  · PRELUDE (izq) y THESIS (der, alineado a la derecha) van por el slot
 *    por defecto: son de esta lámina, no de la serie.
 */
import CabeceraUniverse from "../serie-universe/CabeceraUniverse.astro";
import { rombo, rayos } from "../serie-universe/geom";

const chaflanes = [
  "M13.5 26.5L30 12.5",
  "M1094 12.5L1106.5 26.5",
  "M1106.5 1366.5L1094 1380.5",
  "M27.5 1380.5L13.5 1366.5",
];

/* La paleta de u05, medida: tinta gris neutra, violeta apagado y título plata
   cálida. Se declara acá porque NO se hereda de la serie. */
const vars = [
  "--cb-ink:#d8d4d0",
  "--cb-vio:#b48fe2",
  "--cb-tit:#d5d1c8",
  "--cb-regla-size:11.5px",
  "--cb-regla-op:0.24",
  "--cb-regla-der-op:0.2",
  "--cb-lema-size:19px",
  "--cb-lema-op:0.68",
  "--cb-sig-size:13.5px",
  "--cb-sig-op:0.6",
  "--cb-pag-size:13.5px",
  "--cb-pag-op:0.56",
  "--cb-nota-size:12.6px",
  "--cb-nota-op:0.4",
  "--cb-cruz-op:0.4",
].join(";");

/* THESIS va alineado a la derecha contra x=1046: cada línea lleva su propio
   arranque medido en vez de text-anchor, para que textLength siga mandando. */
const prelude = ["BEFORE STRUCTURE,", "THERE WAS PERCEPTION.", "BEFORE CODE, IMPRESSION.", "BEFORE KODEX, OCÍN."];
const thesis = ["EVERY SYSTEM IS BORN", "FROM OBSERVATION.", "EVERY LANGUAGE,", "FROM PATTERN."];
const CHAR = 5.8; // avance medido del cuerpo 9.8 con el tracking del bloque
---

<CabeceraUniverse
  gradId="u05"
  grad={["#e9e5dc", "#d5d1c8", "#a3a099"]}
  ariaLabel="KODEX-∞ / GENESIS — página 05 · Visual lineage · From Ocín's first marks to the living language."
  vars={vars}
  marcoSup="M31 12.5H467M597 12.5H1084"
  fantasma="M13.5 26.5V1366.5M1106.5 26.5V1366.5"
  chaflanes={chaflanes}
  nodosSup={[{ x: 472.5, y: 12.5, r: 1.6 }, { x: 481, y: 12.5, r: 1.6 }, { x: 584.5, y: 12.5, r: 1.6 }, { x: 593, y: 12.5, r: 1.6 }]}
  interior="M47.5 59.5H1077.5V1278.5H47.5Z"
  interiorEsq="M47.5 73.5V59.5H61.5M1063.5 59.5H1077.5V73.5M1077.5 1264.5V1278.5H1063.5M61.5 1278.5H47.5V1264.5"
  cruces={[[35.5, 33.5], [1082.5, 33.5]]}
  reglaIzq={{ x: 57, y: 37.5, len: 156, t: "KODEX-∞ UNIVERSE" }}
  reglaDer={{ x: 778, y: 37.5, len: 220, t: "OBSERVE. DECIPHER. TRANSCEND." }}
  reglaCy={33.5}
  puntosRegla={[278, 308, 1021.5, 1034.5]}
  nodosRegla={[348.5, 737.5, 756.5]}
  punteo={{ d: "M232 33.5H312M1015 33.5H1042", dash: "14 4" }}
  hex={{
    borde: "M534.5 15L554.5 26V49L534.5 60L514.5 49V26Z",
    tics: "M515 24.5h4M550.5 24.5h4M515 50.5h4M550.5 50.5h4",
    tallo: "M534.5 59.5V65",
    inf: [534.5, 37.5, 11.5, 9.5],
  }}
  titKodex={{ x: 169, y: 138.5, size: 86.4, len: 286, t: "KODEX" }}
  titGuion={{ x: 472, y: 107.5, w: 20, h: 3.6 }}
  titInf={[539, 111, 29.9, 23]}
  titBarra="M615.5 84.5L620 84.5L606 138.5L601.5 138.5Z"
  titPalabra={{ x: 654, y: 138.5, size: 86.4, len: 319, t: "GENESIS" }}
  sig={{ x: 75, y: 192, len: 58, t: "A / -∞" }}
  lema={{ x: 443, y: 166, len: 240, t: "VISUAL LINEAGE" }}
  pag={{ x: 986, y: 192, len: 61, t: "PAGE 05" }}
  ejeI={13.5}
  ejeD={1106.5}
  rielIzq={[]}
  rielDer={[]}
  micro={[
    { transform: "translate(1103.6 315) rotate(-90)", len: 78, t: "KDXC // 05 // 8B" },
    { transform: "translate(11 950) rotate(-90)", len: 58, t: "1531313166" },
  ]}
  folio={{ x: 1096.5, y: 665, len: 14.5, t: "01" }}
>
  <!-- Rombos y puntos que flanquean VISUAL LINEAGE, medidos en y=161. -->
  <g class="cab__sep" slot="sep">
    <path d={rombo(380.5, 160.5, 9, 7)} />
    <path d={rombo(740.5, 160.5, 9, 7)} />
    <circle class="cab__nodo-f" cx="408" cy="160.5" r="1.7" />
    <circle class="cab__nodo-f" cx="713" cy="160.5" r="1.7" />
    <circle class="cab__nodo-f" cx="295" cy="162" r="1.3" />
    <circle class="cab__nodo-f" cx="826" cy="162" r="1.3" />
    <path class="cab__punteo" d="M310 160.5H366M754 160.5H812" stroke-dasharray="9 5" />
  </g>

  <Fragment slot="nota">
    <text class="cab__nota" x="372" y="196" textLength="375" lengthAdjust="spacing">FROM OCÍN'S FIRST MARKS TO THE LIVING LANGUAGE.</text>
    <!-- Rombito de cierre bajo la nota, centrado en el eje de la lámina. -->
    <path class="cab__sep-r" d={rombo(554, 209, 8, 8)} />
    <path class="cab__punteo" d="M528 209H544M564 209H580" stroke-dasharray="2 3" />
  </Fragment>

  <!-- Glifos de los rieles, medidos por sus corridas en x=13 y x=1107. -->
  <g class="cab__glifo" slot="glifos">
    <circle cx="13.5" cy="195" r="4.3" />
    <circle cx="13.5" cy="195" r="1.2" />
    <circle cx="13.5" cy="290" r="4" />
    <path d="M9.5 302l4 5l4 -5M13.5 307v4" />
    <path d={rayos(13.5, 320, 4.2, 8)} />
    <path d="M13.5 333v5" />
    <path d={rayos(13.5, 348.5, 3.6, 6, Math.PI / 6)} />
    <path d="M9.8 829l7.4 8.4M17.2 829l-7.4 8.4" />
    <path d="M9.8 848l7.4 8.4M17.2 848l-7.4 8.4" />
    <path d={rombo(1106.5, 382.5, 8, 8)} />
  </g>

  <!-- PRELUDE / THESIS — propios de esta lámina, dentro del mismo SVG. -->
  <g class="u05-pro">
    <text class="u05-pro__lab" x="73" y="236" textLength="49">PRELUDE</text>
    {prelude.map((t, i) => (
      <text class="u05-pro__lin" x="73" y={252 + i * 16} textLength={t.length * CHAR}>{t}</text>
    ))}
    <!-- Garabato de firma bajo el bloque: mancha ilegible, no texto. -->
    <path class="u05-pro__garabato" d="M71 314l6 -3l4 3l5 -4l4 4l6 -2l5 2M105 314h6m5 0h3m6 0h9m5 0h4m7 0h3" />
    <text class="u05-pro__lab" x="1002" y="236" textLength="44">THESIS</text>
    {thesis.map((t, i) => (
      <text class="u05-pro__lin" x={1046 - t.length * CHAR} y={252 + i * 16} textLength={t.length * CHAR}>{t}</text>
    ))}
    <!-- Sismograma en miniatura, cierre del bloque THESIS. -->
    <path class="u05-pro__garabato" d="M962 315h18l2 -4l2 4l3 -8l3 8l2 -3l2 3h6l2 -6l2 6l3 -12l3 15l2 -3h6l2 -5l2 5h8" />
  </g>
</CabeceraUniverse>

<style is:global>
  /* Inyectado por slot dentro de `.cab`: los estilos van globales por la misma
     razón que los del cromo — el ámbito del slot es esta lámina. */
  .u05-pro__lab {
    font-size: 10.5px;
    fill: var(--cb-vio);
    fill-opacity: 0.62;
  }
  .u05-pro__lin {
    font-size: 9.8px;
    fill: var(--cb-ink);
    fill-opacity: 0.5;
  }
  .u05-pro__garabato {
    fill: none;
    stroke: var(--cb-ink);
    stroke-width: 0.8;
    stroke-opacity: 0.34;
    stroke-linejoin: round;
  }
</style>
