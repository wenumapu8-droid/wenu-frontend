---
/**
 * KODEX-∞ · u05-genesis · PANELES — LINEAGE TRACE + la fila inferior.
 *
 * Cinco cajas, medidas por columnas y filas de borde sobre la referencia:
 *
 *   LINEAGE TRACE      x 892..1048   y 868..1063  (a la derecha del torrente)
 *   OCÍN'S NOTE        x  76..312    y 1081..1257
 *   EVOLUTION METRICS  x 327..568    y 1081..1257
 *   CORE AXIOMS        x 586..761    y 1081..1257
 *   NEXT PAGE PREVIEW  x 770..1047   y 1081..1257
 *
 * El sismograma de OCÍN'S NOTE es el `Waveform` del kit en variante línea —
 * determinista por semilla, jamás Math.random(). Las barras de EVOLUTION
 * METRICS son tiras de marcas de ancho irregular, no una barra sólida
 * (kit/README: sólida se lee como <progress> de navegador), y su contenido va
 * marcado data-symbolic="true": los porcentajes son ficción del póster, no
 * estado del sistema.
 */
import Waveform from "../kit/Waveform.astro";
import { rayos, rombo, lemniscata } from "../serie-universe/geom";

function azar(semilla: number) {
  let a = semilla >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const p2 = (v: number) => +v.toFixed(2);

/* ── LINEAGE TRACE ──────────────────────────────────────────────────────── */
const linaje = [
  { nombre: "OCÍN", sub: "THE OBSERVER" },
  { nombre: "FIRST MARKS", sub: "THE TRACE" },
  { nombre: "FIRST PATTERNS", sub: "THE ECHO" },
  { nombre: "FIRST CODE", sub: "THE WORD" },
  { nombre: "KODEX-∞", sub: "THE CONTINUUM" },
];
const LIN_Y = [908, 941.5, 975, 1008.5, 1042]; // centros de glifo, paso 33,5
const GLIFO_X = 921;

/* Garabato de FIRST MARKS: trazos cortos sorteados con semilla. */
const garabato = (() => {
  const rr = azar(0x0520);
  let d = "";
  for (let i = 0; i < 5; i++) {
    const x = GLIFO_X - 6 + rr() * 12;
    const y = LIN_Y[1] - 5 + rr() * 10;
    d += `M${p2(x)} ${p2(y)}l${p2(rr() * 8 - 4)} ${p2(rr() * 8 - 4)}`;
  }
  return d;
})();

/* ── EVOLUTION METRICS ──────────────────────────────────────────────────── */
const metricas: [string, number, string][] = [
  ["OBSERVATION DENSITY", 0.93, "93.1%"],
  ["PATTERN STABILITY", 0.88, "88.4%"],
  ["SYMBOL COHERENCE", 0.92, "91.7%"],
  ["RULE CONSISTENCY", 0.87, "87.2%"],
  ["CODE INTEGRITY", 0.95, "94.6%"],
];
const MET_Y0 = 1133;
const MET_PASO = 20;
const BAR_X = 464;
const BAR_W = 44;
/* Tira de marcas de ancho irregular: la fracción llena va más encendida. */
const ticksBarra = (fila: number, frac: number) => {
  const rr = azar(0x0530 + fila);
  const out: [number, number, number][] = [];
  let x = BAR_X;
  while (x < BAR_X + BAR_W) {
    const w = 1 + Math.floor(rr() * 2);
    const llena = (x - BAR_X) / BAR_W < frac;
    out.push([p2(x), w, llena ? 0.5 + rr() * 0.3 : 0.14 + rr() * 0.1]);
    x += w + 1.4;
  }
  return out;
};

/* ── CORE AXIOMS ────────────────────────────────────────────────────────── */
const axiomas = [
  "1. ALL PATTERNS ARE CONNECTED.",
  "2. MEANING IS RELATIONAL.",
  "3. INTENT SHAPES FORM.",
  "4. LANGUAGE SEEKS RETURN.",
  "5. THE SYSTEM PRESERVES LIFE.",
];

/* ── NEXT PAGE PREVIEW · disco ──────────────────────────────────────────
   Anillos en progresión ~0,93 con pesos desparejos (kit/README: parejos se
   leen como diana de CAD) y radios de sector sorteados con semilla. */
const DISCO = { cx: 838, cy: 1163, R: 52 };
/* Zona del disco medida L 10,3 en la referencia; con los pesos tímidos de la
   primera pasada daba 4,4. Los anillos suben y los radios se duplican. */
const anillos: [number, number, number][] = [[52, 0.5, 0.8], [46, 0.3, 0.6], [38, 0.55, 0.9], [30, 0.36, 0.6], [21, 0.62, 1], [12, 0.5, 0.8]];
const sectores = (() => {
  const rr = azar(0x0540);
  const out: string[] = [];
  for (let i = 0; i < 44; i++) {
    const a = rr() * Math.PI * 2;
    const r0 = 12 + rr() * 28;
    const r1 = r0 + 6 + rr() * 12;
    out.push(
      `M${p2(DISCO.cx + r0 * Math.cos(a))} ${p2(DISCO.cy + r0 * Math.sin(a))}L${p2(DISCO.cx + r1 * Math.cos(a))} ${p2(DISCO.cy + r1 * Math.sin(a))}`,
    );
  }
  return out.join("");
})();
const nodosDisco = (() => {
  const rr = azar(0x0541);
  const out: [number, number, number][] = [];
  for (let i = 0; i < 26; i++) {
    const a = rr() * Math.PI * 2;
    const r = 12 + rr() * 40;
    out.push([p2(DISCO.cx + r * Math.cos(a)), p2(DISCO.cy + r * Math.sin(a)), 0.4 + rr() * 0.5]);
  }
  return out;
})();

const nota = ['"I DID NOT INVENT THE LANGUAGE.', "I LEARNED TO LISTEN TO WHAT", "ALREADY SPOKE.", 'SO I COULD ANSWER."'];
const preview = [
  ["PAGE 06", "gris"],
  ["KODEX-∞ / RETURN", "gris"],
  ["RETURN PATHWAYS", "vio"],
  ["", ""],
  ["THE WAYS BACK", "gris"],
  ["ARE MANY.", "gris"],
  ["THE RETURN IS ONE.", "gris"],
];
const CHAR = 5.55;
---

<div data-bloque="Paneles" style="inset:0">
  <svg class="pn" viewBox="0 0 1122 1402" width="1122" height="1402" aria-hidden="true">
    <defs>
      <filter id="u05PnHalo" x="-80%" y="-80%" width="260%" height="260%">
        <feGaussianBlur stdDeviation="1.4" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>

    <!-- ═══ LINEAGE TRACE ════════════════════════════════════════════════ -->
    <rect class="pn__caja" x="892.5" y="868.5" width="155" height="194.5" />
    <text class="pn__titulo" x="922" y="888" textLength="84">LINEAGE TRACE</text>
    <path class="pn__hilo" d={`M${GLIFO_X} 898V${LIN_Y[4] - 12}`} stroke-dasharray="1.5 4" />
    {linaje.map((l, i) => (
      <g>
        <text class="pn__nombre" x="948" y={LIN_Y[i] + 4}>{l.nombre}</text>
        <text class="pn__sub" x="949" y={LIN_Y[i] + 14.5}>{l.sub}</text>
      </g>
    ))}
    <!-- glifos del linaje, uno por hito -->
    <g class="pn__glifo">
      <circle cx={GLIFO_X} cy={LIN_Y[0]} r="8.5" />
      <path d={lemniscata(GLIFO_X, LIN_Y[0], 5, 4.4)} />
      <path d={garabato} />
      <circle cx={GLIFO_X} cy={LIN_Y[2]} r="7.5" />
      <path d={rayos(GLIFO_X, LIN_Y[2], 7.5, 8)} />
      <path d={rombo(GLIFO_X, LIN_Y[3], 12, 12)} />
      <circle class="pn__glifo-n" cx={GLIFO_X} cy={LIN_Y[3]} r="1.4" />
      <g filter="url(#u05PnHalo)">
        <circle cx={GLIFO_X} cy={LIN_Y[4]} r="8.5" />
        <path d={rayos(GLIFO_X, LIN_Y[4], 8, 8, Math.PI / 8)} />
        <circle class="pn__glifo-n" cx={GLIFO_X} cy={LIN_Y[4]} r="1.6" />
      </g>
    </g>

    <!-- ═══ OCÍN'S NOTE // FRAGMENT 7 ════════════════════════════════════ -->
    <rect class="pn__caja" x="76.5" y="1081.5" width="235.5" height="176" />
    <text class="pn__titulo" x="86" y="1104" textLength="166">OCÍN'S NOTE // FRAGMENT 7</text>
    {nota.map((t, i) => (
      <text class="pn__cita" x="86" y={1157 + i * 25}>{t}</text>
    ))}
    <g class="pn__glifo">
      <path d={rayos(282, 1234, 9, 6, -Math.PI / 2)} />
      <circle cx="282" cy="1234" r="4" />
      <path d="M282 1243v6" />
    </g>

    <!-- ═══ EVOLUTION METRICS ════════════════════════════════════════════ -->
    <rect class="pn__caja" x="327.5" y="1081.5" width="241" height="176" />
    <text class="pn__titulo" x="348" y="1104" textLength="133">EVOLUTION METRICS</text>
    <g data-symbolic="true">
      {metricas.map(([lab, frac, pct], i) => (
        <g>
          <text class="pn__met" x="349" y={MET_Y0 + i * MET_PASO}>{lab}</text>
          {ticksBarra(i, frac).map(([x, w, o]) => (
            <rect class="pn__tick" x={x} y={MET_Y0 - 7 + i * MET_PASO} width={w} height="7" style={`fill-opacity:${p2(o)}`} />
          ))}
          <text class="pn__pct" x="524" y={MET_Y0 + i * MET_PASO}>{pct}</text>
        </g>
      ))}
      <text class="pn__met" x="349" y={MET_Y0 + 5 * MET_PASO}>LIVING RESPONSE</text>
      <path class="pn__hilo" d={`M464 ${MET_Y0 - 3.5 + 5 * MET_PASO}H540m-4 -3l4 3l-4 3`} stroke-dasharray="2 3" />
      <text class="pn__inf" x="550" y={MET_Y0 + 1 + 5 * MET_PASO}>∞</text>
    </g>

    <!-- ═══ CORE AXIOMS ══════════════════════════════════════════════════ -->
    <rect class="pn__caja" x="586.5" y="1081.5" width="174.5" height="176" />
    <text class="pn__titulo" x="595" y="1104" textLength="76">CORE AXIOMS</text>
    {axiomas.map((t, i) => (
      <text class="pn__axioma" x="599" y={1133 + i * 25} textLength={p2(t.length * 5.2)}>{t}</text>
    ))}

    <!-- ═══ NEXT PAGE PREVIEW ════════════════════════════════════════════ -->
    <rect class="pn__caja" x="770.5" y="1081.5" width="276.5" height="176" />
    <text class="pn__titulo" x="794" y="1104" textLength="142" lengthAdjust="spacing">NEXT PAGE PREVIEW</text>
    <g class="pn__disco">
      {anillos.map(([r, o, w]) => (
        <circle cx={DISCO.cx} cy={DISCO.cy} r={r} style={`stroke-opacity:${o};stroke-width:${w}`} />
      ))}
      <circle cx={DISCO.cx} cy={DISCO.cy} r="58" style="stroke-opacity:0.28;stroke-width:0.6" stroke-dasharray="1 4" />
      <path class="pn__disco-radios" d={`M${DISCO.cx - 62} ${DISCO.cy}H${DISCO.cx + 62}M${DISCO.cx} ${DISCO.cy - 62}V${DISCO.cy + 62}`} style="stroke-opacity:0.4" />
      <path class="pn__disco-radios" d={sectores} />
      {nodosDisco.map(([x, y, o]) => <circle class="pn__disco-n" cx={x} cy={y} r="0.9" style={`fill-opacity:${o}`} />)}
      <g filter="url(#u05PnHalo)">
        <circle class="pn__disco-aro" cx={DISCO.cx} cy={DISCO.cy} r="16" />
        <circle class="pn__disco-n" cx={DISCO.cx} cy={DISCO.cy} r="1.8" style="fill-opacity:0.9" />
      </g>
    </g>
    {preview.map(([t, tono], i) =>
      t ? (
        <text class={tono === "vio" ? "pn__prev-v" : "pn__prev"} x="908" y={1144 + i * 19}>{t}</text>
      ) : null,
    )}
  </svg>

  <!-- Sismograma del fragmento 7: kit, determinista. -->
  <div class="pn__onda" data-symbolic="true" style="left:84px;top:1109px;width:218px;height:32px">
    <Waveform w={218} h={32} semilla={0x05f7} variante="linea" n={260} inercia={0.24} envolvente={0.85} grosor={0.75} margen={1} />
  </div>
</div>

<style is:global>
  [data-bloque="Paneles"] { pointer-events: none; }
  [data-bloque="Paneles"] svg { position: absolute; inset: 0; }
  .pn text {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-variant-ligatures: none;
    white-space: pre;
  }
  .pn__caja { fill: none; stroke: #d8d4d0; stroke-width: 1; stroke-opacity: 0.15; }
  .pn__titulo { font-size: 10.4px; fill: #b48fe2; fill-opacity: 0.72; }
  .pn__hilo { fill: none; stroke: #b48fe2; stroke-width: 0.8; stroke-opacity: 0.5; }
  .pn__nombre { font-size: 9.6px; fill: #b48fe2; fill-opacity: 0.72; letter-spacing: 0.08em; }
  .pn__sub { font-size: 8.4px; fill: #d8d4d0; fill-opacity: 0.5; letter-spacing: 0.06em; }
  .pn__glifo circle, .pn__glifo path { fill: none; stroke: #c8a4e8; stroke-width: 0.9; stroke-opacity: 0.72; }
  .pn__glifo-n { fill: #f6eefa !important; stroke: none !important; }
  .pn__cita { font-size: 9.8px; fill: #d8d4d0; fill-opacity: 0.6; letter-spacing: 0.05em; }
  .pn__met { font-size: 8.8px; fill: #d8d4d0; fill-opacity: 0.56; }
  .pn__pct { font-size: 8.8px; fill: #d8d4d0; fill-opacity: 0.62; }
  .pn__tick { fill: #b48fe2; }
  .pn__inf { font-size: 11px; fill: #b48fe2; fill-opacity: 0.75; }
  .pn__axioma { font-size: 9.6px; fill: #d8d4d0; fill-opacity: 0.58; }
  .pn__disco circle { fill: none; stroke: #b48fe2; }
  .pn__disco-radios { fill: none; stroke: #b48fe2; stroke-width: 0.6; stroke-opacity: 0.5; }
  .pn__disco-n { fill: #d9c2f2; stroke: none !important; }
  .pn__disco-aro { stroke: #c8a4e8 !important; stroke-opacity: 0.85 !important; stroke-width: 1 !important; }
  .pn__prev { font-size: 9.4px; fill: #d8d4d0; fill-opacity: 0.56; }
  .pn__prev-v { font-size: 9.4px; fill: #b48fe2; fill-opacity: 0.7; }
  .pn__onda { position: absolute; color: #b48fe2; opacity: 0.9; }
</style>
