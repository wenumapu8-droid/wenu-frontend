---
/**
 * KODEX-∞ · u04-alphabet · PIE — banda inferior, y 1240..1402 del póster.
 *
 * Cuatro piezas, de arriba a abajo:
 *   1. Frase con adornos ◇ a los lados            y 1249,5   (acá)
 *   2. Regla de ancho completo con rombo central  y 1272     (acá)
 *   3. Pie final en tres columnas                 y 1323,5 / 1343,5
 *   4. Sello hexagonal                            centro (1009 · 1329), R=37
 *
 * Las dos últimas las pone `serie-universe/PieUniverse.astro`, que es el mismo
 * remate de las cinco láminas de la serie. Las dos primeras son de esta página
 * y van por el slot `antes`.
 *
 * COORDENADAS. El bloque va con `inset:0` sobre el lienzo entero, así que las
 * x/y de este archivo son las del póster sin corrimiento: lo que se lee acá se
 * puede buscar tal cual en `reference/canon/u04-alphabet.png`. El SVG comparte
 * ese sistema (viewBox 0 0 1122 1402, escala 1:1) y por eso los rótulos van
 * como <text> dentro de él y no como divs colocados aparte — una sola grilla,
 * un solo lugar donde mirar cuando el banco marque un corrimiento.
 *
 * LA u04 NO ES LA u02, Y ACÁ SE NOTA. La lámina 02 cierra con un botón INITIATE
 * de 207×145 y dos monitores de onda; la 04 no tiene ninguna de las tres cosas.
 * Se comprobó barriendo la banda: entre y=1250 y y=1310 el único trazo continuo
 * del original es la regla de y=1272, y no hay ni marco de botón ni corchetes de
 * monitor. Copiar el pie de la 02 tal cual habría metido 350 px de tinta que la
 * referencia no tiene, y el banco lo cobra dos veces (píxel y estructural).
 *
 * MEDIDO, NO ELEGIDO. Los pasos de carácter salieron de contar el arranque de
 * tinta glifo por glifo, y NO son el mismo en las dos líneas de la columna
 * izquierda: `KDX-ALPHABET-004` avanza 8,67 px por carácter y
 * `PROTOCOL INITIATED` avanza 7,65. Es una diferencia de casi un punto entero
 * que se ve al superponer, y por eso cada línea va con su propio `textLength`
 * en vez de con un `letter-spacing` común: en SVG, `textLength` clava el extremo
 * de tinta donde lo tiene la referencia sea cual sea la fuente que resuelva.
 *
 * LO QUE NO SE DIBUJA ACÁ. El marco del póster —las verticales de x=12,5 y
 * x=1109,5, la interior de x=54,5 y la regla de cierre de y=1385— cruza la banda
 * pero pertenece a la Cabecera, que lo abre arriba y lo baja de un solo trazo.
 * Partirlo deja costura en las esquinas.
 */
import PieUniverse from "../serie-universe/PieUniverse.astro";
import { romboR } from "../serie-universe/geom";

/**
 * Eje de simetría de la banda. Los dos adornos que flanquean la frase están en
 * x=364,5 y x=756,5: su punto medio es 560,5, y la propia frase (tinta de 381 a
 * 738) da 559,5. Se toma 560, que es el mismo eje que la Cabecera.
 */
const EJE = 560;

/* La única cota de geometría que se aparta del valor por defecto de la serie es
   el cuerpo de los códigos (versal de 9 px → 12,3). Las opacidades van por los
   mandos `-op`, que caen en `opacity`: es la propiedad contra la que se calibró
   esta lámina y no rasteriza igual que `fill-opacity`. Ver la nota de
   `PieUniverse`. */
const vars = [
  "--pi-ink:#cfc6e8",
  "--pi-vio:#a77cf0",
  "--pi-cod-size:12.3px",
  "--pi-cod-op:.88",
  "--pi-lema-op:.74",
  "--pi-fuente-op:.78",
  "--pi-expr-op:.64",
  "--pi-hex-op:.55",
  "--pi-pelo-op:.75",
].join(";");
---

<PieUniverse
  vars={vars}
  codigo={{ x: 82, y: 1323.5, len: 134, t: "KDX-ALPHABET-004" }}
  estado={{ x: 82, y: 1343.5, len: 135, t: "PROTOCOL INITIATED" }}
  lema={{ x: 349, y: 1334.5, len: 429, t: "THE KODEX IS LIVING. YOU ARE PART OF IT." }}
  fuente={{ x: 893, y: 1323.5, len: 66, t: "ONE SOURCE" }}
  expr={{ x: 823, y: 1343.5, len: 137, t: "INFINITE EXPRESSIONS" }}
  sello={{ cx: 1009, cy: 1329, R: 37 }}
>
  <Fragment slot="antes">
    <!-- ═══ 1 · FRASE ══════════════════════════════════════════════════════
         Tinta de x=381 a 738 con 41 caracteres → 8,9 px de paso. Los dos rombos
         que la flanquean miden 4 px de lado a lado, no 7: medido. -->
    <g class="pie-frase">
      <text class="pie-t pie-t--frase" x="381" y="1249.5" textLength="357" lengthAdjust="spacing">TRAVERSE WITH INTENT. RETURN WITH WISDOM.</text>
      <path class="pie-frase__romb" d={romboR(364.5, 1245.5, 2.2)} />
      <path class="pie-frase__romb" d={romboR(756.5, 1245.5, 2.2)} />
    </g>

    <!-- ═══ 2 · REGLA ════════════════════════════════════════════════════ -->
    <g class="pie-regla">
      <path class="pie-regla__linea" d="M66 1272H1046" />
      <path class="pie-regla__cierre" d="M53 1267.8v8.4m-4.2 -4.2h8.4" />
      <circle class="pie-regla__punto" cx="61" cy="1272" r="0.9" />
      <circle class="pie-regla__punto" cx="1051" cy="1272" r="0.9" />
      <path class="pie-regla__cierre" d={romboR(1060, 1272, 3.6)} />
      <!-- Rombo del eje: el original lo tiene y es lo que parte la regla en dos
           mitades legibles en vez de una sola raya de 1000 px. -->
      <path class="pie-regla__cierre" d={romboR(EJE + 0.5, 1272, 4.4)} />
    </g>
  </Fragment>
</PieUniverse>

<style>
  /* Sólo lo de esta lámina: la banda de tres columnas y el sello los viste
     `PieUniverse` con las variables `--pi-*` de arriba. */
  .pie-t--frase {
    font-size: 12.3px;
    fill: #cfc6e8;
    opacity: 0.86;
  }

  .pie-regla__linea {
    stroke: #4a3570;
    stroke-width: 1;
    opacity: 0.62;
  }
  .pie-regla__cierre {
    fill: none;
    stroke: #cfc6e8;
    stroke-width: 1;
    opacity: 0.55;
  }
  .pie-regla__punto {
    fill: #cfc6e8;
    opacity: 0.55;
  }
  .pie-frase__romb {
    fill: none;
    stroke: #cfc6e8;
    stroke-width: 0.9;
    opacity: 0.5;
  }
</style>
