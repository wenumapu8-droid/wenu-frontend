---
/**
 * KODEX-∞ · u04-alphabet · CABECERA
 *
 * Franja superior (y=0..240) + marco + los dos rieles verticales. Todo SVG
 * trazado por código; ni un bitmap.
 *
 * El cromo lo pone `serie-universe/CabeceraUniverse.astro`. Lo que cambia se
 * midió sobre `reference/canon/u04-alphabet.png` (1122×1402) barriendo filas y
 * columnas con umbral de luminancia, no a ojo:
 *
 *  · marco exterior — verticales x=12,5 y x=1109,5 (la u02 las tiene en 13 y
 *    1107: la u04 es ~2 px más ancha de caja). Regla superior y=12, inferior
 *    y=1385 (la u02 cierra en 1389).
 *  · marco interior — verticales x=54,5 (llega a y=1360) y x=1065,5 (corta en
 *    y=1275, donde arranca el pie).
 *  · título — acá NO pasa lo de la u02: KODEX y ALPHABET tienen el MISMO cuerpo.
 *    Las dos versales miden 54 px (y=110..163) y la tinta va de x=85 a 402 y de
 *    591 a 1038. Componer ALPHABET condensado, como THRESHOLD, lo deja corto:
 *    su tinta pide 447 px y el ancho natural de Cormorant a ese cuerpo ronda
 *    380, así que va ESTIRADO por espaciado (`lengthAdjust="spacing"`), no por
 *    glifo — estirar el glifo un 19 % engorda las astas y se ve.
 *  · bajada — la u04 es más compacta: el subtítulo cae en y=204,5 (la u02 en
 *    210,5) y la línea de la bajada en y=230,5 (la u02 en 245,5).
 *
 * EL COLOR DE LA BAJADA NO ES EL VIOLETA DE ACENTO. `A / -∞`, `RELATION FIELD`
 * y `PAGE 04` van en #b18ce0, que es un violeta más claro que el #a77cf0 del
 * hexágono y de las cruces. Se ve midiendo el pico de sus píxeles y por eso
 * viaja como variable propia (`--cb-sig-fill` y compañía) en vez de reusar
 * `--cb-vio`.
 */
import CabeceraUniverse from "../serie-universe/CabeceraUniverse.astro";
import { rayos, rombo } from "../serie-universe/geom";

/* ── marco exterior ─────────────────────────────────────────────────────── */
/* Chaflán de 14 px medido sobre la diagonal, en las cuatro esquinas. */
const chaflanes = [
  "M12.5 26.5L30 12.5",
  "M1096 12.5L1109.5 26.5",
  "M1109.5 1371.5L1096 1385.5",
  "M27.5 1385.5L12.5 1371.5",
];

/* Los rieles alternan tramos macizos y punteados; [y0, y1, macizo?]. */
const rielIzq: [number, number, boolean][] = [
  [43, 75, true], [120, 197, false], [261, 276, true], [427, 771, true],
  [956, 1187, true], [1214, 1310, false], [1319, 1361, true],
];
const rielDer: [number, number, boolean][] = [
  [43, 75, true], [128, 182, false], [459, 704, true], [723, 791, true],
  [831, 990, true], [1235, 1310, false], [1327, 1373, true],
];

const EJE_I = 12.5;
const EJE_D = 1109.5;

const puntosIzq = [287, 397.5, 783.5, 830, 845.5, 949.5];
const puntosDer = [794.5, 832.5, 574.5, 586.5, 625];
const micropunteo: [number, number][] = [[328, 338], [834, 841]];

const vars = [
  "--cb-ink:#cfc6e8",
  "--cb-vio:#a77cf0",
  "--cb-tit:#d8d3e6",
  "--cb-regla-op:.33",
  "--cb-tit-inf-sw:4.6",
  "--cb-tit-inf-op:.75",
  "--cb-tit-op:.9",
  "--cb-tit-fig-op:.72",
  "--cb-sig-fill:#b18ce0",
  "--cb-sig-op:.72",
  "--cb-lema-fill:#b18ce0",
  "--cb-lema-op:.85",
  "--cb-pag-fill:#b18ce0",
  "--cb-pag-op:.72",
  "--cb-nota-op:.46",
].join(";");
---

<CabeceraUniverse
  gradId="u04"
  grad={["#e9e5f3", "#d8d3e6", "#b0a9c4"]}
  ariaLabel="KODEX-∞ / ALPHABET — página 04 · Relation field · Topología de los nodos A-Y."
  vars={vars}
  marcoSup="M31 12.5H502M620 12.5H1090"
  marcoInf={{ d: "M31 1385.5H1090", dash: "11 4.5" }}
  fantasma="M12.5 26.5V1371.5M1109.5 26.5V1371.5"
  chaflanes={chaflanes}
  nodosSup={[{ x: 509.5, y: 12.5 }, { x: 613.5, y: 12.5 }]}
  interior="M54.5 76V1360M1065.5 76V1275"
  interiorEsq="M54.5 76.5H88.5M1065.5 76.5H1031.5"
  cruces={[[40, 43.5], [1082, 43.5]]}
  reglaIzq={{ x: 66, y: 47.5, len: 187, t: "KODEX-∞ UNIVERSE" }}
  reglaDer={{ x: 798, y: 47.5, len: 260, t: "OBSERVE. DECIPHER. TRANSCEND." }}
  reglaCy={43.5}
  puntosRegla={[272, 332, 347]}
  nodosRegla={[516, 607, 780]}
  punteo={{ d: "M378 43.5H494M631 43.5H773", dash: "17 3" }}
  hex={{
    borde: "M561.5 17L585.5 30V53L561.5 66L537.5 53V30Z",
    tics: "M538 28.5h4M581 28.5h4M538 54.5h4M581 54.5h4",
    tallo: "M561.5 65.5V71",
    inf: [561.5, 42, 12.95, 10.4],
  }}
  titKodex={{ x: 81.7, y: 163.5, size: 86.4, len: 323, ajuste: "spacing", t: "KODEX" }}
  titGuion={{ x: 407, y: 137, w: 24, h: 3.8 }}
  titInf={[480, 141, 31.9, 25.8]}
  titBarra="M557.5 111L562 111L544.5 167L540 167Z"
  titPalabra={{ x: 587.5, y: 163.5, size: 86.4, len: 451, ajuste: "spacing", t: "ALPHABET" }}
  sig={{ x: 87, y: 208.5, len: 71, t: "A / -∞" }}
  lema={{ x: 432, y: 204.5, len: 258, t: "RELATION FIELD" }}
  pag={{ x: 970, y: 208.5, len: 65, t: "PAGE 04" }}
  ejeI={EJE_I}
  ejeD={EJE_D}
  rielIzq={rielIzq}
  rielDer={rielDer}
  nodosIzq={puntosIzq}
  nodosDer={puntosDer}
  micropunteo={micropunteo}
  micro={[
    { transform: "translate(1106.6 399) rotate(-90)", len: 182, t: "05 44 XX XXII / 00 88" },
    { transform: "translate(10 950) rotate(-90)", len: 75, t: "KODEX ARCHIVE ///" },
  ]}
  folio={{ x: 1103.5, y: 610.5, len: 14.5, t: "04" }}
>
  <!-- Separadores: rombo ◇ · guía punteada · punto, espejados en x=560,25. -->
  <g class="cab__sep" slot="sep">
    <path d={rombo(288, 195.5, 12, 9)} />
    <path d={rombo(832.5, 195.5, 12, 9)} />
    <path class="cab__punteo" d="M296 195.5H404M717 195.5H825" stroke-dasharray="9 4" />
    <circle class="cab__nodo-f" cx="409.5" cy="195.5" r="1.9" />
    <circle class="cab__nodo-f" cx="711.5" cy="195.5" r="1.9" />
  </g>

  <text class="cab__nota" slot="nota" x="316" y="230.5" textLength="487" lengthAdjust="spacing">TOPOLOGY OF THE A-Y NODES. PATHS ARE MANY. RETURN IS ONE.</text>

  <g class="cab__glifo" slot="glifos">
    <circle cx={EJE_I} cy="304.5" r="4.7" />
    <path d="M7.8 315.5H17.2L12.5 322.2ZM12.5 322.2V325" />
    <path d={rayos(EJE_I, 347.5, 5, 8)} />
    <path d={rayos(EJE_I, 364, 3.4, 6, Math.PI / 2)} />
    <path d={rayos(EJE_I, 378.5, 4, 8, Math.PI / 8)} />
    <path d={rayos(EJE_I, 799, 4, 6)} />
    <path d={rombo(EJE_I, 814.5, 12, 9)} />
    <circle cx={EJE_I} cy="814.5" r="1.6" />
    <path d="M1109.5 801L1114.6 803.5V808.5L1109.5 811L1104.4 808.5V803.5Z" />
    <path d={rayos(EJE_D, 806, 2.4, 4)} />
  </g>
</CabeceraUniverse>
