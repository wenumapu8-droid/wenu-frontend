---
/**
 * KODEX-∞ · t01-04 ARCHIVE TREE · PIE (0,866 · 1672×75)
 *
 * La caja empieza en y=866, así que las y de este archivo están corridas −866
 * respecto del póster; las x sí son las del póster. Las coordenadas del arte
 * trazada ya vienen restadas desde arte.ts.
 *
 * Mismo criterio que la cabecera:
 *
 *  · El logotipo, la consigna verde, el lema y el emblema van TRAZADOS del
 *    original y no dibujados, con el umbral de cada pieza salido de un barrido
 *    medido (la tabla está en arte.ts). El logotipo del pie es hueco —contorno
 *    sin relleno— y eso lo da el trazado solo; dibujado a ojo se empasta.
 *
 *  · El código de barras NO se traza: un código de barras es una función de una
 *    variable, así que se lee columna por columna del original y se comprime
 *    por tramos. Pasarlo por el contorno le inventa esquinas y le come tinta, y
 *    un repeating-linear-gradient le da un ritmo regular que la referencia no
 *    tiene: acá las noventa barras están donde y como están en el póster.
 *
 *  · "VISUAL SYSTEM v2.0 // TANDA 01" va como <text> de verdad y no trazado
 *    porque lleva cifras, y el canon pide que las cifras del póster vayan como
 *    texto dentro de un contenedor data-symbolic.
 *
 *  · El emblema del pie mide 195×39 y el de la cabecera 131×29: no es el mismo
 *    dibujo a otra escala —la proporción va de 4,5 a 5,0— y por eso hay dos
 *    trazados. Lo que se comparte es el pintor, no la silueta.
 *
 *  · La regla de y=865 no está acá a propósito: cae una fila por encima del
 *    borde de esta caja y pertenece a la banda de bloques, que muere en 865.
 *
 * Todo el pie es tinta tenue: la pieza más brillante es el código de barras con
 * 74 de luminancia media de tinta y la más apagada el emblema, con 40.
 *
 * Puntaje del panel:
 *   node scripts/lamina/score-panel.mjs t01-04-archive-tree Pie --triptico
 * El arte se regenera con:
 *   node scripts/lamina/arte-t01-04-hdrftr.mjs
 */
import { ftrMarca, ftrBarras, ftrVerde, ftrPpp, ftrAla } from "./arte";
import type { Glifo } from "./arte";

interface Props { box: string }
const { box } = Astro.props;

/** Mismo pintor que la cabecera: un <svg> anidado por glifo, con su viewBox
 *  propio, sin conservar proporción, y conservando el transform de cada path
 *  —perderlo desarma el glifo y la letra sale maciza. */
const pinta = (gs: Glifo[], fill: string) =>
  gs
    .map(
      (g) =>
        `<svg x="${g.x}" y="${g.y}" width="${g.w}" height="${g.h}" viewBox="0 0 ${g.vw} ${g.vh}" preserveAspectRatio="none">` +
        g.d.map(([d, tr]) => `<path d="${d}"${tr ? ` transform="${tr}"` : ""} fill="${fill}"/>`).join("") +
        `</svg>`
    )
    .join("");

/* Tono del píxel más brillante de cada pieza, brillo del barrido de umbral. */
const TINTA = {
  marca: "#4c4c48",  // "KODEX−∞" hueco: pico 109,109,104 · relleno de barrido 75
  verde: "#394902",  // "BUILT FOR…": pico 105,136,3 · relleno 60
  ppp: "#323332",    // "PATTERN…": pico 101,104,102 · relleno 50
  ala: "#282926",    // emblema: pico 97,99,92 · relleno 40
};

/* "VISUAL SYSTEM v2.0 // TANDA 01": primer píxel de tinta en x=329, último en
   x=518, cima de la versal en y=890 del póster —24 en esta caja— y versal de
   8 px. Se ancla por el ancho de tinta y no por el avance porque el ancho es lo
   único que se puede medir en un PNG. */
const SISTEMA = "VISUAL SYSTEM v2.0 // TANDA 01";
const SIS_X = 329;
const SIS_ANCHO = 191;
const SIS_CIMA = 24;
const SIS_VERSAL = 8;

/* Versal de la mono del sistema, medida: 0,74 em; apoyo izquierdo 0,9 px. */
const CUERPO = +(SIS_VERSAL / 0.74).toFixed(3);
const LSB = 0.9;
---

<div data-box style={box} class="ftr">
  <!-- Cierre del marco del póster: los dos cantos bajan desde la cabecera y
       mueren en el filo inferior, en y=934. Es el mismo rectángulo redondeado
       de arriba, dibujado alto y recortado por el overflow de la caja. -->
  <div class="ftr__marco"></div>

  <svg class="ftr__art" viewBox="0 0 1672 75" width="1672" height="75" aria-hidden="true">
    <!-- "KODEX−∞", hueco. El pie repite la marca sin volver a gritarla: la
         misma palabra que arriba a la mitad del brillo y en contorno. -->
    <g role="img" aria-label="KODEX−∞" set:html={pinta(ftrMarca, TINTA.marca)} />

    <!-- Código de barras: la luminancia media por columna del original entre
         x=184 y x=293, comprimida por tramos, cada uno con SU valor. -->
    <g class="ftr__barras">
      {ftrBarras.tramos.map(([x, w, v]) => (
        <rect x={x} y={ftrBarras.y} width={w} height={ftrBarras.h} fill={`rgb(${v},${v},${v})`} />
      ))}
    </g>

    <!-- "v2.0" y "TANDA 01" son el rótulo de versión ficticio del póster, no la
         versión real de ningún sistema: de ahí data-symbolic. -->
    <g data-symbolic="true">
      <text
        class="ftr__sistema"
        x={+(SIS_X - LSB).toFixed(2)}
        y={SIS_CIMA + SIS_VERSAL}
        font-size={CUERPO}
        textLength={SIS_ANCHO}
        lengthAdjust="spacing"
      >{SISTEMA}</text>
    </g>

    <!-- Consigna verde y lema, los dos trazados. El texto real de cada uno
         queda en su aria-label, así que el pie se lee sin verlo. -->
    <g role="img" aria-label="BUILT FOR ARCHIVES THAT REMEMBER." set:html={pinta(ftrVerde, TINTA.verde)} />
    <g role="img" aria-label="PATTERN. PROTECT. PERPETUATE." set:html={pinta(ftrPpp, TINTA.ppp)} />
    <g role="img" aria-label="Emblema alado KODEX−∞" set:html={pinta(ftrAla, TINTA.ala)} />
  </svg>
</div>

<style>
  /* position y overflow explícitos: el estilo con ámbito del componente le gana
     a la clase heredada, y todo lo que sale de la caja pisa a los vecinos. */
  .ftr {
    position: absolute;
    overflow: hidden;
    font-family: var(--lam-mono);
  }

  .ftr__art { position: absolute; left: 0; top: 0; }

  /* El rectángulo abre fuera de la caja y sólo entra su filo inferior: con
     top=−100 y alto 169, el borde de abajo cae en la fila 68 de la caja, que es
     y=934 del póster. Los brillos son los mismos que en la cabecera. */
  .ftr__marco {
    position: absolute;
    left: 4px;
    top: -100px;
    width: 1664px;
    height: 169px;
    box-sizing: border-box;
    border: 1px solid #151515;
    border-top: 0;
    border-left-color: #1c1c1c;
    border-right-color: #1e1e1e;
    border-radius: 0 0 6px 6px;
  }

  .ftr__sistema {
    font-family: var(--lam-mono);
    font-variant-ligatures: none;
    white-space: pre;
    fill: #313130;
    /* Un píxel de desenfoque reproduce el derrame del raster del póster, que
       deja medio píxel más de tinta por lado que el rasterizador del navegador.
       Por debajo de 0,8 px Chromium colapsa el núcleo a una caja de 1 px y el
       filtro no hace nada. */
    filter: blur(1px);
  }
</style>
