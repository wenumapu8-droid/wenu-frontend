---
/**
 * KODEX-∞ · t01-03 · panel 03 — MOTION NOTES
 *
 * Tres columnas (ORBIT / DESCEND / ACCELERATE), cada una con un pictograma
 * dibujado en SVG inline y tres líneas de descripción.
 *
 * Sobre las medidas: en la referencia este panel ocupa x 13→310 (298 px de
 * ancho) y su marco va de y 596 a y 703. La caja que entrega el andamiaje es
 * de 257 px de ancho, así que el contenido va comprimido ~0.86 en horizontal
 * (tipografías y columnas) pero se mantiene 1:1 en vertical, que es donde la
 * caja sí alcanza. Por eso el marco no arranca en el borde de la caja: se baja
 * 10 px para que el filete superior y la línea de base de cada renglón caigan
 * en la misma fila que en la referencia.
 *
 * Los pictogramas se dibujan a tamaño real (sin comprimir): entran igual en la
 * columna y comprimirlos sólo los deformaría.
 *
 * No hay telemetría en este panel — no aparece ni una cifra medible, sólo el
 * ordinal de sección. Por eso no lleva data-symbolic.
 */
interface Props { box: string }
const { box } = Astro.props;
---

<div data-box style={box} class="mnotes">
  <div class="mnotes__frame">
    <span class="kdx-panel__title">03. Motion Notes</span>

    <div class="mnotes__cols">
      <!-- ── ORBIT ──────────────────────────────────────────────────── -->
      <section class="mnotes__col">
        <div class="mnotes__icon">
          <svg width="70" height="22" viewBox="0 0 70 22" fill="none" aria-hidden="true">
            <g stroke="#b6601f" stroke-width="1.1">
              <ellipse cx="34.5" cy="12" rx="34" ry="8.2" opacity=".85" />
              <ellipse cx="34.5" cy="12" rx="27.5" ry="7" opacity=".78" />
              <ellipse cx="34.5" cy="12" rx="21" ry="5.6" opacity=".66" />
              <ellipse cx="34.5" cy="12" rx="14.5" ry="4" opacity=".55" />
            </g>
            <!-- El cuerpo central va después de los anillos para que los tape
                 por delante; los de atrás se pierden en el fondo negro igual
                 que en la referencia. -->
            <circle cx="34.5" cy="9.8" r="5.6" fill="url(#mnOrb)" />
            <g stroke="#7e3a11" stroke-width=".55" opacity=".9" fill="none">
              <polygon points="34.5,4.8 39.2,8.2 37.4,13.8 31.6,13.8 29.8,8.2" />
              <ellipse cx="34.5" cy="9.8" rx="2.4" ry="5.5" />
              <path d="M29 9.8h11" />
            </g>
            <defs>
              <radialGradient id="mnOrb" cx=".4" cy=".33" r=".8">
                <stop offset="0" stop-color="#e88a34" />
                <stop offset="1" stop-color="#b34f14" />
              </radialGradient>
            </defs>
          </svg>
        </div>
        <h3 class="mnotes__label">Orbit</h3>
        <div class="mnotes__body"><div>
          <p>Slow rotational drift.</p>
          <p>Parallax layers rotate</p>
          <p>at variable speeds.</p>
        </div></div>
      </section>

      <!-- ── DESCEND ────────────────────────────────────────────────── -->
      <section class="mnotes__col">
        <div class="mnotes__icon">
          <svg width="19" height="26" viewBox="0 0 19 26" fill="none" aria-hidden="true">
            <g stroke="url(#mnArw)" stroke-linecap="square" fill="none">
              <path d="M9.5 0.5V25.5" stroke-width="2.6" />
              <path d="M4 13l5.5 5.5L15 13" stroke-width="1.9" />
              <path d="M0.9 16.5l8.6 8.8 8.6-8.8" stroke-width="1.9" />
            </g>
            <defs>
              <linearGradient id="mnArw" x1="0" y1="0" x2="0" y2="26" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#d9760f" />
                <stop offset=".55" stop-color="#f7960c" />
                <stop offset="1" stop-color="#ffb61c" />
              </linearGradient>
            </defs>
          </svg>
        </div>
        <h3 class="mnotes__label">Descend</h3>
        <div class="mnotes__body"><div>
          <p>Continuous inward pull.</p>
          <p>Camera lowers along</p>
          <p>polar axis.</p>
        </div></div>
      </section>

      <!-- ── ACCELERATE ─────────────────────────────────────────────── -->
      <section class="mnotes__col">
        <div class="mnotes__icon">
          <svg width="42" height="28" viewBox="0 0 42 28" fill="none" aria-hidden="true">
            <!-- Cuatro estelas paralelas a ~-34°, cada una con una marca en
                 aspa cerca de la cola. El degradado corre a lo largo del eje
                 de las estelas, no en vertical: es lo que hace que la punta se
                 apague y se lea como velocidad. -->
            <g stroke="url(#mnStk)" stroke-linecap="round" fill="none">
              <path d="M2.1 20L31.8 0" stroke-width="1.5" />
              <path d="M7.5 24.3L38.6 4.3" stroke-width="1.4" />
              <path d="M18.6 27.1L41.5 10.4" stroke-width="1.3" />
              <path d="M30.4 24.3L41 16.6" stroke-width="1.2" />
            </g>
            <g stroke="#ef4f14" stroke-width="1.3" stroke-linecap="round">
              <path d="M0 21.6l4.2-4M-.1 17.9l4.4 4" />
              <path d="M7.5 15.9l4.2-4M7.4 12.2l4.4 4" />
              <path d="M5.4 26.2l4.2-4M5.3 22.5l4.4 4" />
              <path d="M25.4 14.1l4.2-4M25.3 10.4l4.4 4" />
              <path d="M16.5 29l4.2-4M16.4 25.3l4.4 4" />
              <path d="M29.3 25.6l4.2-4M29.2 21.9l4.4 4" />
            </g>
            <defs>
              <linearGradient id="mnStk" x1="2" y1="27" x2="42" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#ff6a00" />
                <stop offset=".6" stop-color="#ff7a12" />
                <stop offset="1" stop-color="#c9490a" />
              </linearGradient>
            </defs>
          </svg>
        </div>
        <h3 class="mnotes__label">Accelerate</h3>
        <div class="mnotes__body"><div>
          <p>Velocity increases</p>
          <p>with depth.</p>
          <p>Field compresses.</p>
        </div></div>
      </section>
    </div>
  </div>
</div>

<style>
  .mnotes { position: relative; }

  /* El marco real no llena la caja: arranca 10 px más abajo y cierra 7 px
     antes, que es donde están el filete de arriba y el de abajo en la
     referencia. El sobrante queda en negro, igual que ahí. */
  .mnotes__frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 10px;
    height: 107px;
    border: 1px solid var(--lam-faint);
    box-sizing: border-box;
  }

  .mnotes__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: 100%;
  }

  .mnotes__col { position: relative; }

  /* Los separadores no llegan al filete: nacen a la altura del rótulo y
     mueren con la última línea de texto. */
  .mnotes__col + .mnotes__col::before {
    content: "";
    position: absolute;
    left: 0;
    top: 47px;
    width: 1px;
    height: 48px;
    background: repeating-linear-gradient(180deg, #343433 0 1px, transparent 1px 3px);
  }

  .mnotes__icon {
    position: absolute;
    top: 13px;
    left: 0;
    right: 0;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mnotes__label {
    position: absolute;
    top: 45px;
    left: 0;
    right: 0;
    height: 14px;
    line-height: 14px;
    text-align: center;
    font-family: var(--lam-mono);
    font-size: 9.5px;
    font-weight: 400;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #c4c2bb;
  }

  /* Bloque centrado en la columna pero con el texto alineado a la izquierda:
     así se comportan las tres columnas de la referencia. */
  .mnotes__body {
    position: absolute;
    top: 62px;
    left: 0;
    right: 0;
    text-align: center;
  }
  /* El inline-block se centra por su línea más ancha y adentro todo queda
     alineado a la izquierda: las tres líneas arrancan en la misma columna. */
  .mnotes__body > div {
    display: inline-block;
    text-align: left;
  }
  .mnotes__body p {
    margin: 0;
    font-size: 5.6px;
    line-height: 11px;
    letter-spacing: 0;
    white-space: nowrap;
    color: #97948d;
  }
</style>
