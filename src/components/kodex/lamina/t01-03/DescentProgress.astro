---
interface Props { box: string }
const { box } = Astro.props;
---

<div data-box style={box} class="dprog">
  <!-- Esquina inferior izquierda del marco gris que envuelve todo el bloque 04.
       El marco arranca arriba del todo, pero su borde inferior cae dentro de
       esta caja (y=50) y ningún otro panel lo alcanza: Hero termina en 618 y
       Core Readout empieza en 717. Por eso se cierra acá. -->
  <div class="dprog__frame" aria-hidden="true"></div>

  <!-- Sangrado del piso del túnel: las radiales y el riel punteado siguen bajo
       la barra hasta el borde del marco. Va apagadísimo a propósito — en la
       referencia ninguno de estos trazos pasa de ~50/255. -->
  <svg class="dprog__floor" viewBox="0 0 731 60" preserveAspectRatio="none" aria-hidden="true">
    <g class="dprog__fan">
      <path d="M406 -900 L18 52" /><path d="M406 -900 L62 52" />
      <path d="M406 -900 L104 52" /><path d="M406 -900 L152 52" />
      <path d="M406 -900 L206 52" /><path d="M406 -900 L262 52" />
      <path d="M406 -900 L322 52" /><path d="M406 -900 L382 52" />
      <path d="M406 -900 L444 52" /><path d="M406 -900 L502 52" />
      <path d="M406 -900 L560 52" /><path d="M406 -900 L618 52" />
      <path d="M406 -900 L676 52" /><path d="M406 -900 L724 52" />
    </g>
    <path class="dprog__floorline" d="M4 38.5 H727" />
    <g class="dprog__floorteal">
      <path d="M8 35.5 H176" />
      <path d="M556 34.5 H702" />
      <path d="M30 41.5 H150" />
    </g>
    <g class="dprog__spark">
      <path d="M154 29 L166 47 M150 38.5 H170" />
      <path d="M249 29 L261 47 M245 38.5 H265" />
      <path d="M564 29 L576 47 M560 38.5 H580" />
    </g>
  </svg>

  <!-- TELEMETRÍA SIMBÓLICA: el 73 % y el llenado son parte del imaginario del
       póster, no una medición de nada. Se transcriben, no se calculan. -->
  <div class="dprog__bar kdx-panel" data-symbolic="true">
    <span class="dprog__label kdx-acc">DESCENT PROGRESS</span>

    <div class="dprog__track">
      <div class="dprog__fill"></div>
      <div class="dprog__rest"></div>
    </div>

    <span class="dprog__pct kdx-acc">73%</span>
  </div>

  <!-- Sello de rosa de los vientos. Está centrado en (738, 3) de esta caja: le
       sobresale casi toda la mitad de arriba, pero tampoco entra en la caja de
       Hero (que corta en y=618), así que se dibuja acá y se deja desbordar. -->
  <svg class="dprog__seal" viewBox="-31 -31 62 62" aria-hidden="true">
    <g class="dprog__seal-ring">
      <circle r="30" />
      <circle r="25.2" />
    </g>
    <!-- El anillo de microtexto de la referencia es ilegible al tamaño real:
         se reproduce como guiones cortísimos, que es lo que se ve. -->
    <circle class="dprog__seal-text" r="27.6" />
    <circle class="dprog__seal-edge" r="23.4" />
    <circle class="dprog__seal-disc" r="22.6" />
    <g class="dprog__seal-web">
      <circle r="19.2" /><circle r="15.4" />
      <path d="M-19 -11 L19 11 M-19 11 L19 -11 M-11 -19 L11 19 M-11 19 L11 -19" />
    </g>
    <g class="dprog__seal-star">
      <path d="M0 -21.5 L4.6 -4.6 L21.5 0 L4.6 4.6 L0 21.5 L-4.6 4.6 L-21.5 0 L-4.6 -4.6 Z" />
      <circle r="12.6" />
      <circle r="6.4" />
      <path d="M0 -3.6 L3.6 0 L0 3.6 L-3.6 0 Z" />
      <path d="M-2.6 -16.6 L0 -21.5 L2.6 -16.6 M-2.6 16.6 L0 21.5 L2.6 16.6" />
      <path d="M-16.6 -2.6 L-21.5 0 L-16.6 2.6 M16.6 -2.6 L21.5 0 L16.6 2.6" />
    </g>
  </svg>
</div>

<style>
  .dprog {
    /* Nada de overflow:hidden — la barra sube 9 px por encima de la caja y el
       sello se sale por la derecha. Recortarlos partiría el dibujo. */
    color: var(--lam-accent);
  }

  .dprog__frame {
    position: absolute;
    left: 0;
    top: -20px;
    width: 731px;
    height: 71px;
    border-left: 1px solid #2a2a2a;
    border-bottom: 1px solid #2a2a2a;
    border-bottom-left-radius: 4px;
    pointer-events: none;
  }

  /* ── piso del túnel ─────────────────────────────────────────────────── */
  .dprog__floor {
    position: absolute;
    left: 0;
    top: 0;
    width: 731px;
    height: 60px;
    fill: none;
    stroke-width: 1;
  }
  .dprog__fan path { stroke: #0f3033; opacity: 0.55; stroke-width: 0.8; }
  .dprog__fan path:nth-child(2n) { stroke: #38180a; }
  .dprog__floorline {
    stroke: color-mix(in srgb, var(--lam-accent) 30%, transparent);
    stroke-dasharray: 3 4;
  }
  .dprog__floorteal { stroke: #16484d; stroke-dasharray: 5 4; opacity: 0.75; }
  .dprog__spark {
    stroke: color-mix(in srgb, var(--lam-accent) 45%, transparent);
    stroke-width: 0.9;
  }

  /* ── caja de la barra ───────────────────────────────────────────────── */
  /* Sale 9 px por arriba del box asignado porque en la referencia el marco de
     la barra empieza en y=615 y el andamiaje la ancla en 624. */
  .dprog__bar {
    position: absolute;
    left: 23px;
    top: -9px;
    width: 673px;
    height: 32px;
    padding: 0;
    border-radius: 3px;
  }

  .dprog__label,
  .dprog__pct {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    white-space: nowrap;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .dprog__label { left: 11px; font-size: 11.5px; }
  .dprog__pct { left: 643px; font-size: 13px; }

  /* ── pista ──────────────────────────────────────────────────────────── */
  .dprog__track {
    position: absolute;
    left: 131px;
    top: 7px;
    display: flex;
    width: 502px;
    height: 15px;
  }

  /* Tramo lleno: barras de ~2 px cada 4.1 px. Sobre el paso base se apilan dos
     capas de periodo 5 y 7 barras — como no son múltiplos entre sí, el brillo
     no se repite a la vista y la tira lee como ecualizador y no como trama. */
  .dprog__fill {
    width: 340px;
    background-image:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.2) 0 2.1px, transparent 2.1px 28.7px),
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.34) 0 2.1px, transparent 2.1px 20.5px),
      repeating-linear-gradient(90deg, var(--lam-accent) 0 2.1px, transparent 2.1px 4.1px);
    background-position: 8.2px 0, 4.1px 0, 0 0;
  }

  /* Tramo vacío: la trama cambia de paso (6.33 px) y aparece el riel punteado
     a media altura. No es la misma barra apagada, es otro dibujo. */
  .dprog__rest {
    flex: 1;
    background-image:
      repeating-linear-gradient(90deg,
        color-mix(in srgb, var(--lam-accent) 34%, transparent) 0 1.6px,
        transparent 1.6px 3.4px),
      repeating-linear-gradient(90deg,
        color-mix(in srgb, var(--lam-accent) 46%, transparent) 0 1.2px,
        transparent 1.2px 6.33px);
    background-size: 100% 2px, 100% 100%;
    background-position: 0 5px, 6px 0;
    background-repeat: repeat-x, repeat;
  }

  /* ── sello ──────────────────────────────────────────────────────────── */
  .dprog__seal {
    position: absolute;
    left: 707px;
    top: -28px;
    width: 62px;
    height: 62px;
    fill: none;
  }
  .dprog__seal-ring { stroke: #6e6e6e; stroke-width: 0.8; opacity: 0.55; }
  .dprog__seal-text {
    stroke: #a8a8a8;
    stroke-width: 2.6;
    stroke-dasharray: 1 2.2;
    opacity: 0.5;
  }
  .dprog__seal-edge {
    stroke: color-mix(in srgb, var(--lam-accent) 80%, transparent);
    stroke-width: 1.2;
  }
  .dprog__seal-disc { fill: rgba(58, 12, 3, 0.55); stroke: none; }
  .dprog__seal-web {
    stroke: color-mix(in srgb, var(--lam-accent) 36%, transparent);
    stroke-width: 0.7;
    stroke-dasharray: 2 2.6;
  }
  .dprog__seal-star {
    stroke: var(--lam-accent);
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
</style>
