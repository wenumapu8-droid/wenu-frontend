---
interface Props { box: string }
const { box } = Astro.props;

/* Lienzo lógico de cada miniatura, medido sobre la referencia ampliada:
   el panel de 538×230 lleva 3 columnas de ~175 y 2 filas de 98, con 6px de
   canaleta. Trabajar en esas unidades deja los trazos en píxeles reales, así
   que un grosor de 0.7 en el SVG es 0.7 en la lámina. */
const W = 175;
const H = 98;

interface Study {
  seed: number;
  cxf: number;      // centro del túnel, en fracción de la miniatura
  cyf: number;
  rot: number;      // rotación del abanico de radios
  ecc: number;      // excentricidad: >1 achata los anillos en vertical
  r0: number;       // radio del primer anillo
  k: number;        // razón de la progresión: es la "profundidad" del túnel
  rmax: number;     // hasta dónde llega la estructura BRILLANTE
  spokes: number;
  cold: number;     // cuántos arcos fríos (los azulados de la referencia)
  dots: number;
  gain: number;     // brillo general del estudio
  coreF: number;    // tamaño de la boca negra, en múltiplos de r0
  nodes: boolean;   // marcadores rómbicos en los cardinales
}

/* Los seis estudios de la referencia. Medido sobre la referencia ampliada: el
   disco brillante NO llena la miniatura, mide ~128×96 dentro de los 175×98, o
   sea que queda negro a izquierda y derecha y la estructura se corta arriba y
   abajo. De ahí rmax ~64-72 con ecc ~1.25 (sy ~0.8 → 50 de radio vertical).
   Y no son variaciones tímidas: entre el estudio más denso (k 1.09, 30 anillos)
   y el más abierto (k 1.27, 8 anillos) hay un factor de casi cuatro, que es lo
   que hace que las seis se lean como estudios distintos y no como seis copias. */
const STUDIES: Study[] = [
  { seed: 1071, cxf: 0.468, cyf: 0.500, rot:   0, ecc: 1.26, r0: 5.2,  k: 1.098, rmax: 62, spokes: 40, cold:  9, dots: 148, gain: 1.06, coreF: 2.9, nodes: false },
  { seed: 2318, cxf: 0.514, cyf: 0.506, rot:   6, ecc: 1.18, r0: 8.6,  k: 1.180, rmax: 57, spokes: 28, cold: 12, dots: 104, gain: 1.02, coreF: 1.9, nodes: false },
  { seed: 3907, cxf: 0.500, cyf: 0.494, rot:  -3, ecc: 1.30, r0: 10.0, k: 1.215, rmax: 66, spokes: 26, cold:  8, dots:  84, gain: 0.88, coreF: 2.1, nodes: true  },
  { seed: 4426, cxf: 0.452, cyf: 0.500, rot:  11, ecc: 1.22, r0: 4.8,  k: 1.086, rmax: 60, spokes: 44, cold: 10, dots: 168, gain: 1.10, coreF: 3.2, nodes: false },
  { seed: 5713, cxf: 0.506, cyf: 0.500, rot:  -9, ecc: 1.14, r0: 7.0,  k: 1.146, rmax: 58, spokes: 32, cold: 11, dots: 126, gain: 0.96, coreF: 2.4, nodes: false },
  { seed: 6255, cxf: 0.552, cyf: 0.490, rot:  16, ecc: 1.36, r0: 6.2,  k: 1.124, rmax: 65, spokes: 36, cold: 13, dots: 142, gain: 1.04, coreF: 2.7, nodes: true  },
];

/* PRNG determinista (mulberry32). El ruido de la referencia tiene que ser el
   mismo en cada build: si cambia, el diff visual contra la referencia deja de
   servir para nada. */
function mulberry32(seed: number) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const n2 = (v: number) => Number(v.toFixed(2));
const pol = (r: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return [n2(r * Math.cos(a)), n2(r * Math.sin(a))] as const;
};

function build(s: Study) {
  const rnd = mulberry32(s.seed);
  const cx = n2(W * s.cxf);
  const cy = n2(H * s.cyf);

  /* Progresión geométrica, no lineal: es lo que produce la sensación de fuga.
     Se corta en rmax: pasado ese radio la referencia ya no tiene estructura
     brillante, sólo el eco tenue que resuelve `halo`. */
  const radii: number[] = [];
  for (let r = s.r0; r < s.rmax; r *= s.k) radii.push(n2(r));
  const n = radii.length;
  const step = 360 / s.spokes;

  /* Fuera del disco la referencia no es negro liso: hay tres o cuatro arcos
     apenas visibles que llegan a las esquinas del encuadre. Antes esos anillos
     se dibujaban con el mismo peso que los de dentro y se leían como manchones
     marrones que tapaban media miniatura. */
  const halo = Array.from({ length: 5 }, (_, i) => {
    const r = n2(s.rmax * Math.pow(1.28, i + 1));
    return {
      r,
      w: n2(0.32 + rnd() * 0.22),
      o: n2((0.05 + 0.05 * rnd()) * s.gain),
      dash: `${n2(1.2 + rnd() * 3.4)} ${n2(2.2 + rnd() * 6)}`,
    };
  });

  /* La referencia no tiene todos los anillos al mismo peso: sobre el tejido de
     punteados destacan tres o cuatro aros continuos y gruesos. Sin esa jerarquía
     el estudio se lee como trama y pierde la lectura de túnel. El paso entre
     aros fuertes se abre con la densidad: si no, el estudio de k=1.09 saldría
     con doce aros gruesos y quedaría empastado. */
  const sLo = Math.round(n * 0.22);
  const stride = n > 22 ? 4 : n > 13 ? 3 : 2;
  const rings = radii.map((r, i) => {
    const t = i / (n - 1);
    const bell = Math.exp(-Math.pow((t - 0.5) / 0.34, 2));
    const d = rnd();
    const strong = i >= sLo && t <= 0.76 && (i - sLo) % stride === 0;
    /* En la referencia el frío es minoritario: UN aro gris-acero por estudio y
       algún punteado suelto, y siempre más apagado que el naranja. Con más, el
       estudio vira a azul y deja de leerse como el túnel de la lámina. */
    const cold = strong ? (i - sLo) % (stride * 5) === stride * 2 : d > 0.95;
    const o = strong ? Math.min(0.8, (0.22 + 0.56 * bell) * s.gain) : (0.12 + 0.5 * bell) * s.gain;
    return {
      r,
      w: strong ? n2(0.58 + 0.16 * t) : n2(0.34 + 0.18 * t),
      o: n2(cold ? o * 0.66 : o),
      dash: strong ? null : d < 0.3 ? '0.7 1.9' : d < 0.52 ? '0.45 1.3' : d < 0.72 ? '2.1 1.5 0.5 1.5' : null,
      cold,
    };
  });

  /* Los radios son la mitad del dibujo en la referencia: cruzan todos los aros
     y siguen hasta el borde, y es lo que hace que se lea como una malla y no
     como aros sueltos. Antes salían casi invisibles (opacidad ~0.13) y por eso
     los estudios se veían lisos. */
  const spokes = Array.from({ length: s.spokes }, (_, j) => {
    const a = j * step;
    const [x1, y1] = pol(radii[Math.min(n - 1, Math.round(n * 0.2))], a);
    const [x2, y2] = pol(124, a);
    return { x1, y1, x2, y2, o: n2((0.085 + 0.165 * rnd()) * s.gain) };
  });

  /* Los "ladrillos" del fondo. Van en dos pasadas por radio: una continua que
     apenas insinúa la celda, y otra con hueco largo y desfase aleatorio que
     enciende celdas sueltas. Es lo que en la referencia hace que el muro del
     túnel se lea moteado y no como aros gruesos. Dibujar celda por celda daría
     lo mismo con cientos de nodos más, así que se resuelve con dasharray.
     El grosor va topado en 2.6: con el tope viejo de 6.5 los radios grandes
     salían como bloques borrosos de seis píxeles que se comían la miniatura. */
  const bricks = radii
    .filter((r) => r > 13)
    .flatMap((r) => {
      const cell = (2 * Math.PI * r) / s.spokes;
      const w = Math.min(r * (s.k - 1) * 0.72, 2.6);
      return [
        {
          r,
          w: n2(w),
          dash: `${n2(cell * 0.7)} ${n2(cell * 0.3)}`,
          off: 0,
          o: n2((0.03 + 0.035 * rnd()) * s.gain),
        },
        {
          r,
          w: n2(w * 0.62),
          dash: `${n2(cell * 0.42)} ${n2(cell * 2.1)}`,
          off: n2(rnd() * cell * 3.5),
          o: n2((0.09 + 0.2 * rnd()) * s.gain),
        },
      ];
    });

  /* Los arcos fríos se limitan a la corona media: en la referencia nunca caen
     dentro de la boca negra ni se van del encuadre, que es lo que los hace
     leerse como una capa aparte y no como ruido. */
  const cLo = Math.max(1, Math.round(n * 0.34));
  const cHi = Math.max(cLo + 1, Math.round(n * 0.82));
  const cold = Array.from({ length: s.cold }, () => {
    const r = radii[cLo + Math.floor(rnd() * (cHi - cLo))];
    const a0 = rnd() * 360;
    const sweep = 26 + rnd() * 66;
    const [x0, y0] = pol(r, a0);
    const [x1, y1] = pol(r, a0 + sweep);
    return {
      d: `M${x0} ${y0}A${r} ${r} 0 0 1 ${x1} ${y1}`,
      o: n2((0.3 + 0.34 * rnd()) * s.gain),
      w: n2(0.45 + rnd() * 0.5),
    };
  });

  /* El grano brillante cae en cruces anillo×radio, no en cualquier lado: por eso
     la textura de la referencia se lee como estructura y no como polvo. */
  const dLast = Math.max(3, Math.round(n * 0.86));
  const dots = Array.from({ length: s.dots }, () => {
    const r = radii[1 + Math.floor(rnd() * (dLast - 1))];
    const a = Math.floor(rnd() * s.spokes) * step + (rnd() < 0.24 ? step / 2 : 0);
    const [x, y] = pol(r, a);
    const u = rnd();
    return {
      x, y,
      r: n2(0.26 + rnd() * 0.62),
      o: n2((0.32 + 0.62 * rnd()) * s.gain),
      tone: u < 0.24 ? 'cold' : u < 0.32 ? 'ink' : 'acc',
    };
  });

  /* Además de los puntos, la referencia tiene guiones cortos ENCARADOS al centro.
     Son los que dan la sensación de que el muro está tabulado y no sólo salpicado. */
  const ticks = Array.from({ length: Math.round(s.dots * 0.55) }, () => {
    const r = radii[2 + Math.floor(rnd() * Math.max(1, dLast - 2))];
    const a = Math.floor(rnd() * s.spokes) * step;
    const len = 1.3 + rnd() * 2.6;
    const [x1, y1] = pol(r - len / 2, a);
    const [x2, y2] = pol(r + len / 2, a);
    return { x1, y1, x2, y2, o: n2((0.28 + 0.5 * rnd()) * s.gain), w: n2(0.5 + rnd() * 0.4) };
  });

  /* Los marcadores cardinales de la referencia son ROMBOS (cuadrados girados),
     no circulitos: se ven claramente en el estudio 3 arriba y abajo del aro. */
  const nr = radii.reduce((p, c) => (Math.abs(c - 44) < Math.abs(p - 44) ? c : p), radii[0]);
  const nodes = s.nodes
    ? [0, 90, 180, 270].map((a) => {
        const [x, y] = pol(nr, a);
        const d = 2.4;
        return { x, y, d: `M${n2(x)} ${n2(y - d)}L${n2(x + d)} ${n2(y)}L${n2(x)} ${n2(y + d)}L${n2(x - d)} ${n2(y)}Z` };
      })
    : [];

  return {
    cx, cy, rings, halo, spokes, bricks, cold, dots, ticks, nodes,
    sy: n2(1 / s.ecc),
    rot: s.rot,
    core: n2(s.r0 * s.coreF),
  };
}

const studies = STUDIES.map(build);

/* Marcas de esquina de cada miniatura. La primitiva .kdx-crop sólo da dos
   esquinas y acá la referencia tiene las cuatro, así que van en el propio SVG.
   En la referencia el brazo mide 4 y el trazo es fino y apagado; el 4.5 grueso
   de antes hacía que las esquinas pesaran más que el propio túnel. */
const MI = 4.5;
const MA = 4;
const MARKS = [
  `M${MI} ${MI + MA}V${MI}H${MI + MA}`,
  `M${W - MI - MA} ${MI}H${W - MI}V${MI + MA}`,
  `M${MI} ${H - MI - MA}V${H - MI}H${MI + MA}`,
  `M${W - MI - MA} ${H - MI}H${W - MI}V${H - MI - MA}`,
].join('');
---

<div data-box style={box} class="fstud">
  <div class="fstud__head">
    <!-- En la referencia el rótulo va en una condensada de display; acá se
         aproxima con la mono heredada ajustando cuerpo y tracking hasta que la
         línea mide los mismos ~155px. -->
    <span class="fstud__title">05. Tunnel Frame Studies</span>
    <span class="fstud__rule"></span>
  </div>

  <!-- Los seis túneles son estudios de forma, no visualización de nada medido:
       ni un anillo ni un punto codifica estado del sistema. -->
  <div class="fstud__grid" data-symbolic="true" aria-hidden="true">
    {studies.map((st, i) => (
      <div class="fstud__cell">
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
          <defs>
            <radialGradient id={`fstudCore${i}`}>
              <stop offset="0" stop-color="#000" stop-opacity="1" />
              <stop offset="0.45" stop-color="#000" stop-opacity="0.93" />
              <stop offset="1" stop-color="#000" stop-opacity="0" />
            </radialGradient>
            <radialGradient id={`fstudHaze${i}`}>
              <stop offset="0" stop-color="var(--lam-accent)" stop-opacity="0.02" />
              <stop offset="0.34" stop-color="var(--lam-accent)" stop-opacity="0.055" />
              <stop offset="1" stop-color="var(--lam-accent)" stop-opacity="0" />
            </radialGradient>
          </defs>

          {/* Vaho cálido del fondo: en la referencia el muro del túnel no es
              negro puro, tiene una caída marrón que separa el aro brillante del
              encuadre. Sin esto los estudios quedan planos. */}
          <g transform={`translate(${st.cx} ${st.cy}) scale(1 ${st.sy})`}>
            <circle r="66" fill={`url(#fstudHaze${i})`} />
          </g>

          <g transform={`translate(${st.cx} ${st.cy}) rotate(${st.rot}) scale(1 ${st.sy})`}>
            {st.halo.map((h) => (
              <circle class="fstud__halo" r={h.r} stroke-width={h.w} stroke-dasharray={h.dash} opacity={h.o} />
            ))}
            {st.bricks.map((b) => (
              <circle class="fstud__brick" r={b.r} stroke-width={b.w} stroke-dasharray={b.dash} stroke-dashoffset={b.off} opacity={b.o} />
            ))}
            {st.spokes.map((s) => (
              <line class="fstud__spoke" x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} opacity={s.o} />
            ))}
            {st.rings.map((r) => (
              <circle class={r.cold ? 'fstud__ring fstud__ring--cold' : 'fstud__ring'} r={r.r} stroke-width={r.w} stroke-dasharray={r.dash} opacity={r.o} />
            ))}
            {st.cold.map((c) => (
              <path class="fstud__cold" d={c.d} stroke-width={c.w} opacity={c.o} />
            ))}
            {st.nodes.map((nd) => (
              <g>
                <path class="fstud__node" d={nd.d} />
                <circle class="fstud__node-pip" cx={nd.x} cy={nd.y} r="0.7" />
              </g>
            ))}
            {st.ticks.map((t) => (
              <line class="fstud__tick" x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke-width={t.w} opacity={t.o} />
            ))}
            {st.dots.map((d) => (
              <circle class={`fstud__dot fstud__dot--${d.tone}`} cx={d.x} cy={d.y} r={d.r} opacity={d.o} />
            ))}
          </g>

          <line class="fstud__cross" x1="0" y1={st.cy} x2={W} y2={st.cy} />
          <line class="fstud__cross" x1={st.cx} y1="0" x2={st.cx} y2={H} />

          {/* La boca del túnel es negro puro con una caída suave: sin esto los
              anillos interiores se amontonan y el centro deja de leerse hondo. */}
          <g transform={`translate(${st.cx} ${st.cy}) scale(1 ${st.sy})`}>
            <circle r={st.core} fill={`url(#fstudCore${i})`} />
          </g>

          <path class="fstud__mark" d={MARKS} />
        </svg>
      </div>
    ))}
  </div>

  <div class="fstud__foot"></div>
</div>

<style>
  .fstud {
    --fs-frame: color-mix(in srgb, var(--lam-ink) 21%, transparent);
    --fs-mark: color-mix(in srgb, var(--lam-ink) 38%, transparent);
    --fs-rule: color-mix(in srgb, var(--lam-faint) 62%, transparent);
    --fs-cold: #43707e;
    --fs-brick: color-mix(in srgb, var(--lam-accent) 62%, var(--lam-dim));
    --fs-spoke: color-mix(in srgb, var(--lam-accent) 40%, var(--lam-dim));

    display: flex;
    flex-direction: column;
  }

  /* El rótulo no se monta sobre un marco (este panel no lo tiene): la regla
     arranca donde termina el texto y llega al borde derecho. */
  .fstud__head {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    height: 14px;
  }
  .fstud__title {
    color: var(--lam-accent);
    font-size: 9px;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .fstud__rule {
    flex: 1;
    margin-top: 3px;
    border-top: 1px solid var(--fs-rule);
  }

  /* Filas de 98px fijas: la lámina no es responsive y la referencia tiene esa
     altura exacta. Con `auto` la segunda fila se desalinea contra el original. */
  .fstud__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 98px);
    gap: 6px;
  }

  .fstud__cell {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--fs-frame);
    background: var(--lam-bg);
  }
  .fstud__cell > svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .fstud__brick,
  .fstud__spoke,
  .fstud__ring,
  .fstud__halo,
  .fstud__cold,
  .fstud__tick,
  .fstud__cross,
  .fstud__mark,
  .fstud__node {
    fill: none;
  }

  .fstud__brick { stroke: var(--fs-brick); stroke-linecap: butt; }
  .fstud__spoke { stroke: var(--fs-spoke); stroke-width: 0.4; }
  .fstud__ring { stroke: var(--lam-accent); }
  .fstud__ring--cold { stroke: var(--fs-cold); }
  .fstud__halo { stroke: var(--fs-spoke); stroke-linecap: butt; }
  .fstud__cold { stroke: var(--fs-cold); stroke-linecap: round; }
  .fstud__tick { stroke: var(--lam-accent); stroke-linecap: butt; }

  .fstud__cross {
    stroke: var(--lam-accent);
    stroke-width: 0.45;
    opacity: 0.14;
  }

  .fstud__node { stroke: var(--lam-accent); stroke-width: 0.6; opacity: 0.65; }
  .fstud__node-pip { fill: var(--lam-accent); stroke: none; opacity: 0.75; }

  .fstud__dot { stroke: none; }
  .fstud__dot--acc { fill: var(--lam-accent); }
  .fstud__dot--ink { fill: var(--lam-ink); }
  .fstud__dot--cold { fill: var(--fs-cold); }

  .fstud__mark { stroke: var(--fs-mark); stroke-width: 0.8; }

  /* La regla del pie cierra el bloque a 8px del borde inferior de la caja. */
  .fstud__foot {
    margin-top: auto;
    height: 8px;
    border-top: 1px solid var(--fs-rule);
  }
</style>
