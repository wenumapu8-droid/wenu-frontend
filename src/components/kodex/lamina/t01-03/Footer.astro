---
/**
 * t01-03 · FOOTER — franja inferior (1672×61).
 *
 * Mismo criterio que Header.astro: cada número sale de medir
 * reference/canon/t01-03-descent-tunnel.png píxel a píxel. La caja empieza en
 * y=880, así que acá las coordenadas están corridas −880 respecto del póster.
 *
 * Las cuatro piezas de texto NO comparten ritmo: el interlineado tipográfico va
 * de 7,2 px de avance (la línea de metadatos) a 8,75 (el lema central). Por eso
 * cada una lleva su propio font-size + letter-spacing medidos, en vez de una
 * escala común que quedaría mal en las cuatro.
 */
interface Props { box: string }
const { box } = Astro.props;
---

<div data-box style={box} class="ftr">
  <!-- Regla de separación con la grilla de paneles. Cae en y=876 del póster, o
       sea 4 px POR ENCIMA de esta caja: la dibujo igual porque la franja de
       876..880 no pertenece a ningún otro panel (la fila de arriba termina en
       869) y sin esto la regla no la pinta nadie. -->
  <i class="ftr__sep"></i>

  <!-- Cierre del marco exterior del póster: laterales + fondo redondeado. El
       Header abre este mismo marco arriba; acá sólo entra su tramo final. -->
  <div class="ftr__marco"></div>

  <!-- Wordmark en SVG por lo mismo que en el Header: textLength fija el ancho
       real medido (136 px de tinta, x=21..156) sin depender de qué fuente
       resuelva el sistema. Acá va plano y gris, sin el degradado metálico del
       encabezado — en la referencia el pie está apagado a propósito. -->
  <svg class="ftr__mark" viewBox="0 0 200 61" width="200" height="61" aria-label="KODEX−∞">
    <text x="20" y="33" textLength="138" lengthAdjust="spacingAndGlyphs">KODEX−∞</text>
  </svg>

  <!-- "DYELOPMENT" no es un typo mío: la referencia dice literalmente eso, y el
       conteo de glifos lo confirma (10 caracteres, no los 11 de DEVELOPMENT).
       Se transcribe como está.
       data-symbolic: "TANDA 01" es el rótulo de tanda ficticio del póster, no
       un identificador de build real del sistema. -->
  <span class="ftr__meta" data-symbolic="true">VISUAL DYELOPMENT BOARD // TANDA 01</span>

  <span class="ftr__lema">BUILT FOR ARCHIVES THAT REMEMBER.</span>
  <span class="ftr__ppp">PATTERN. PROTECT. PERPETUATE.</span>

  <!-- Emblema alado, versión ancha y chata del pie (170×32 reales, contra el
       160×48 del encabezado). A este tamaño las plumas se leen como textura, no
       como dibujo: son trazos sueltos, no una silueta cerrada.
       La silueta del ala tiene una rodilla marcada: cae rápido desde la punta
       hasta (21,18) y después corre casi horizontal hasta (57,25). Trazarla con
       una sola curva suave —que fue el primer intento— deja el ala demasiado
       alta en el tercio externo, que es donde más se nota.
       El ala izquierda se define una vez y la derecha es la misma reflejada
       sobre el eje del emblema, x=84.5. -->
  <svg class="ftr__ala" viewBox="0 0 170 32" width="170" height="32" aria-hidden="true">
    <defs>
      <g id="t0103ftrAla">
        <path d="M0.5 0.6 H84" />
        <path d="M2 1.7 H83" class="ftr__ala-faint" />
        <path d="M1 1.2 C 7 6.5, 15 13, 21 18 C 33 20.6, 46 23.4, 57 25.6 C 62 26.6, 67 24, 72.5 19.8" />
        <path d="M2.5 1.6 C 22 4.6, 48 10.5, 74 16.8" />
        <path d="M2 1.5 C 17 6.5, 42 13, 71 18.8" />
        <path d="M1.5 1.4 C 12 9.5, 33 16.6, 65 22.6" />
        <path d="M21 18.2 H76" class="ftr__ala-faint" />
        <path d="M16 3.6 L18.5 7.2" />
        <path d="M25 5 L28 8.9" />
        <path d="M34 6.5 L37.5 10.6" />
        <path d="M43.5 8.1 L47 12.2" />
        <path d="M53 9.8 L56.5 13.9" />
        <path d="M62.5 11.5 L66 15.4" />
        <path d="M71 13.2 L74 16.6" />
        <path d="M17 9.5 L19.5 13.4" />
        <path d="M26 12 L29 16" />
        <path d="M36 14.8 L39 18.6" />
        <path d="M45.5 17.4 L48.5 21" />
        <path d="M55 20 L57.5 23.2" />
        <path d="M64 22.4 L66.5 25" />
      </g>
    </defs>
    <g class="ftr__ala-g">
      <use href="#t0103ftrAla" />
      <use href="#t0103ftrAla" transform="translate(169,0) scale(-1,1)" />
      <g class="ftr__ala-c">
        <path d="M84.5 3.5 C 75.5 11, 75.5 24, 84.5 31.5 C 93.5 24, 93.5 11, 84.5 3.5 Z" />
        <path d="M84.5 5.5 C 80.7 11, 80.7 24, 84.5 29.5 C 88.3 24, 88.3 11, 84.5 5.5 Z" />
        <path d="M84.5 5 V30" class="ftr__ala-faint" />
      </g>
    </g>
  </svg>
</div>

<style>
  .ftr { color: var(--lam-ink); }

  .ftr__sep,
  .ftr__marco { position: absolute; }

  .ftr__sep {
    left: 6px;
    top: -4px;
    width: 1661px;
    height: 1px;
    background: rgba(216, 212, 204, 0.07);
  }

  /* Sólo laterales y fondo: el borde superior lo abre el Header. El radio de 6px
     es el mismo que allá — es un único rectángulo redondeado del póster. */
  .ftr__marco {
    left: 6px;
    top: 0;
    width: 1661px;
    height: 51px;
    border: 1px solid rgba(216, 212, 204, 0.085);
    border-top: 0;
    border-radius: 0 0 6px 6px;
    box-sizing: border-box;
  }
  /* La regla de fondo del marco es más tenue que sus laterales en la referencia
     (media 12 contra 20 sobre negro), así que se pisa aparte. */
  .ftr__marco::after {
    content: "";
    position: absolute;
    left: -1px;
    bottom: -1px;
    width: 1661px;
    height: 1px;
    background: rgba(216, 212, 204, 0.055);
  }

  .ftr__mark { position: absolute; left: 0; top: 0; }
  .ftr__mark text {
    font-family: var(--lam-display);
    font-weight: 800;
    font-size: 28px;
    letter-spacing: 0;
    fill: #676563;
  }

  /* Mismo truco que en el Header: con line-height:0 la línea base de un bloque
     absoluto queda a ~0.35em del top, que es la forma menos dependiente de las
     métricas de la fuente de clavar una base medida en la referencia. */
  .ftr span {
    position: absolute;
    line-height: 0;
    white-space: nowrap;
    font-variant-ligatures: none;
  }

  .ftr__meta {
    left: 170.6px;
    top: 26.2px;          /* base 910 */
    font-size: 11px;
    letter-spacing: 0.89px;
    color: #666562;
  }

  .ftr__lema {
    left: 670.5px;
    top: 24.6px;          /* base 909 */
    font-size: 12.5px;
    letter-spacing: 1.16px;
    color: #807f7d;
  }

  .ftr__ppp {
    left: 1123.5px;
    top: 26.5px;          /* base 910 */
    font-size: 10px;
    letter-spacing: 2.15px;
    color: #6e6d6b;
  }

  .ftr__ala { position: absolute; left: 1480px; top: 10px; }
  .ftr__ala-g {
    fill: none;
    stroke: rgba(216, 212, 204, 0.3);
    stroke-width: 0.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Segunda línea del borde de ataque y el travesaño medio: en la referencia son
     casi el doble de tenues que las plumas, no un trazo más del ala. */
  .ftr__ala-faint { stroke: rgba(216, 212, 204, 0.13); }
  .ftr__ala-c { stroke: rgba(216, 212, 204, 0.47); stroke-width: 0.85; }
</style>
