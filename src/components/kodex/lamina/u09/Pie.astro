---
/**
 * KODEX-∞ · u09-source · PIE
 *
 * De y 1189 al borde inferior de `reference/canon/u09-source.png`. Tres piezas:
 *
 *   1. TRUTH CHAMBER OATH   x  62..699  y 1189..1280   el juramento en dos alas
 *      con el medallón del corazón en el medio (su luz vive en `Diagramas`)
 *   2. CHAMBER SIGNATURE    x 711..969  y 1189..1280   firma y sello hexagonal
 *   3. remate               y 1288..1382                tres columnas y la marca
 *
 * El remate lo pone `serie-universe/PieUniverse.astro`, que es el mismo de las
 * cinco láminas de la serie. El juramento y la firma son de esta página y van
 * por el slot `antes`; el cierre de la regla inferior, por `despues`.
 *
 * EL JURAMENTO ES EL CONTRATO DE LA LÁMINA. «WE RECORD WITHOUT BIAS. WE PRESERVE
 * WITHOUT ALTERATION. WE SEEK TRUTH, NOT COMFORT.» es lo que hace que las cinco
 * clases de la tabla signifiquen algo: sin la promesa de no alterar, NEEDS
 * CONFIRMATION sería una etiqueta y no una obligación. Va copiado tal cual.
 *
 * LA FIRMA ES UN TRAZO, NO UNA IMAGEN. Sale de una sola polilínea suavizada por
 * bézier con puntos de control fijos —ni un bitmap, ni `Math.random()`— y NO
 * pretende ser la firma de nadie: es la marca de la cámara, del mismo modo que
 * `KDX-SOURCE-0009` es un número de póster y no el estado de ningún sistema. Va
 * marcada `data-symbolic="true"`, como manda el canon.
 *
 * DOS SELLOS Y UNA SOLA ROSA. El de la firma es el mismo dibujo que el del
 * remate al 78 %: `geom.ts` lo genera con un factor de escala en vez de tener
 * dos juegos de constantes. Lo único que no encoge es el punto suelto del eje
 * vertical, que en la referencia mide lo mismo en los dos.
 *
 * LO QUE NO SE DIBUJA ACÁ. El marco del póster —las verticales de x=10,5 y
 * x=1017,5, el marco interior de x=49 y x=978 y las reglas de y=1288,5 y
 * y=1381,5— cruza esta banda pero pertenece a la `Cabecera`, que lo abre arriba
 * y lo baja de un solo trazo. Partirlo deja costura en las esquinas.
 */
import PieUniverse from "../serie-universe/PieUniverse.astro";
import { hexPuntos, rosa, romboR, esquinaL } from "../serie-universe/geom";

/* ── 1 · el juramento ───────────────────────────────────────────────────── */

const OATH = { x0: 62, x1: 699, y0: 1189, y1: 1280 };
const FIRMA = { x0: 711, x1: 969, y0: 1189, y1: 1280 };

/** Las tres promesas, centradas en x=212 según la tinta medida. */
const PROMESAS: [string, number][] = [
  ["WE RECORD WITHOUT BIAS.", 1231],
  ["WE PRESERVE WITHOUT ALTERATION.", 1245],
  ["WE SEEK TRUTH, NOT COMFORT.", 1263],
];
const PROMESA_CX = 212;

/** El deseo, centrado en x=575. */
const DESEOS: [string, number][] = [
  ["MAY THIS ARCHIVE GUIDE", 1231],
  ["THOSE WHO SEEK WISDOM.", 1245],
  ["MAY IT ENDURE BEYOND US ALL.", 1263],
];
const DESEO_CX = 575;

/**
 * Firma. Puntos de control explícitos y una sola curva. Dos cosas la separan de
 * un electrocardiograma, que es lo que salió en el primer intento:
 *   · las alturas NO son parejas. Hay dos astas altas —x=772 y x=812— que suben
 *     40 px sobre la línea de escritura y entre medio ondas cortas de 15-20. Una
 *     amplitud constante se lee como señal, no como mano.
 *   · va con `Q` encadenadas usando el punto MEDIO entre vértices como ancla, no
 *     con `L`. Es lo que le da el vaivén continuo de una pluma que no levanta.
 */
const RASGO: [number, number][] = [
  [725, 1259], [733, 1236], [740, 1262], [746, 1241], [752, 1263],
  [758, 1247], [763, 1262], [772, 1225], [781, 1266], [789, 1239],
  [795, 1262], [801, 1245], [812, 1223], [821, 1267], [829, 1241],
  [837, 1262], [845, 1243], [853, 1260], [863, 1241], [873, 1256],
  [883, 1245], [893, 1252], [902, 1247],
];
const firmaD = RASGO.reduce((d, [x, y], i, a) => {
  if (i === 0) return `M${x} ${y}`;
  const [px, py] = a[i - 1];
  return `${d}Q${px} ${py} ${((px + x) / 2).toFixed(1)} ${((py + y) / 2).toFixed(1)}`;
}, "") + `T${RASGO[RASGO.length - 1][0]} ${RASGO[RASGO.length - 1][1]}`;

/** Cola larga de la firma: la raya que la subraya y la cierra. */
const COLA = "M725 1272Q790 1266 855 1270Q885 1272 900 1268";

/** El sello de la firma: la misma rosa del remate al 78 %. */
const ROSA_FIRMA = rosa(935, 1229, 0.78);

/* ── 3 · remate ─────────────────────────────────────────────────────────── */

/** Cruz de puntería: cuadradito y cuatro tics. Flanquea el lema del remate. */
const CRUCES = [310, 329, 698.5, 719];

const av = (tinta: number) => +(tinta + 2).toFixed(1);

/**
 * Elige el modo de `lengthAdjust`. NO es un detalle: con `spacingAndGlyphs` el
 * navegador ESTIRA los glifos hasta el largo pedido, y como casi todos los
 * rótulos de esta lámina van más espaciados que su ancho natural, el resultado
 * era una mono engordada un 18 % que se lee negrita. La referencia tiene astas
 * finas y mucho aire entre letras: eso es tracking, no un cuerpo más ancho.
 * Regla: si el largo pedido supera el natural, se reparte en el interletrado
 * (`spacing`); si hay que meter el texto en menos espacio del que ocupa, se
 * condensan los glifos, que es la única forma de que entre.
 */
const modo = (texto: string, largo: number, cuerpo: number) =>
  largo >= texto.length * cuerpo * 0.6 ? "spacing" : "spacingAndGlyphs";

/* Todo este bloque está calibrado contra la referencia caja por caja, y con las
   alfas de pintura (`fill-opacity` / `stroke-opacity`), que son las propiedades
   con las que se midió — por eso los mandos `-a` y no los `-op`. Ver la nota de
   `PieUniverse`. El juramento fue el peor caso de la lámina: puesto "a gusto"
   su título salía 14 puntos de luminancia por encima —más del doble— y la banda
   entera con él. */
const vars = [
  "--pi-ink:#cfcfd2",
  "--pi-vio:#b49ad8",
  "--pi-cod-size:9.4px",
  "--pi-cod-a:.58",
  "--pi-est-a:.48",
  "--pi-lema-size:10.5px",
  "--pi-lema-a:.4",
  "--pi-fuente-size:9.4px",
  "--pi-fuente-a:.5",
  "--pi-expr-a:.38",
  "--pi-hex-a:.3",
  "--pi-rosa-a:.62",
  "--pi-pelo-a:.46",
].join(";");
---

<PieUniverse
  vars={vars}
  codigo={{ x: 68, y: 1334, len: av(113), t: "KDX-SOURCE-0009" }}
  estado={{ x: 68, y: 1349, len: av(146), t: "TRUTH CHAMBER INITIATED" }}
  lema={{ x: 349, y: 1338, len: av(332), t: "THE KODEX IS LIVING. YOU ARE PART OF IT." }}
  fuente={{ x: 832, y: 1333, len: av(61), t: "ONE SOURCE" }}
  expr={{ x: 769, y: 1349, len: av(124), t: "INFINITE EXPRESSIONS" }}
  sello={{ cx: 930.5, cy: 1341, R: 29.5 }}
>
  <Fragment slot="antes">
    <!-- ═══ 1 · JURAMENTO ════════════════════════════════════════════════ -->
    <path class="pie__regla" d="M62 1189H969" stroke-dasharray="2 6" />
    <path class="pie__regla" d="M62 1280H969" stroke-dasharray="2 6" />
    {[OATH, FIRMA].map((c) => (
      <g class="pie__esq">
        <path d={esquinaL(c.x0, c.y0, 1, 1)} />
        <path d={esquinaL(c.x1, c.y0, -1, 1)} />
        <path d={esquinaL(c.x0, c.y1, 1, -1)} />
        <path d={esquinaL(c.x1, c.y1, -1, -1)} />
      </g>
    ))}

    <text class="pie-t pie__t" x="85" y="1211" textLength={av(165)} lengthAdjust={modo("TRUTH CHAMBER OATH", av(165), 10.5)}>TRUTH CHAMBER OATH</text>
    {PROMESAS.map(([texto, y]) => (
      <text class="pie-t pie__voz" x={PROMESA_CX} y={y}>{texto}</text>
    ))}
    {DESEOS.map(([texto, y]) => (
      <text class="pie-t pie__voz" x={DESEO_CX} y={y}>{texto}</text>
    ))}

    <!-- Guías punteadas que entran al medallón desde los dos lados. -->
    <path class="pie__guia" d="M338 1238H372M476 1238H510" stroke-dasharray="1 5" />

    <!-- ═══ 2 · FIRMA ════════════════════════════════════════════════════ -->
    <text class="pie-t pie__t" x="736" y="1211" textLength={av(117)} lengthAdjust={modo("CHAMBER SIGNATURE", av(117), 10.5)}>CHAMBER SIGNATURE</text>
    <g class="pie__firma" data-symbolic="true">
      <path d={firmaD} />
      <path class="pie__cola" d={COLA} />
    </g>
    <text class="pie-t pie__marca" x="847" y="1274" textLength="60" lengthAdjust={modo("KODEX-∞", 60, 9.4)}>KODEX-∞</text>

    <!-- El sello de la firma comparte las clases del sello del remate: mismos
         valores medidos, así que también comparte el estilo. -->
    <g class="pie-sello">
      <polygon class="pie-sello__hex" points={hexPuntos(935, 1229, 23.5)} />
      <g class="pie-sello__rosa">
        {ROSA_FIRMA.pelos.map((d) => <path class="pie-sello__pelo" d={d} />)}
        {ROSA_FIRMA.brazos.map((b) => (
          <g>
            <path class={b.eje ? "pie-sello__eje" : "pie-sello__diag"} d={b.d} />
            {b.travesanos.map((d) => <path class="pie-sello__pelo" d={d} />)}
            {b.suelto && <circle class="pie-sello__punta" cx={b.suelto[0].toFixed(2)} cy={b.suelto[1].toFixed(2)} r="0.8" />}
            <rect class="pie-sello__punta" x={(b.punta[0] - 0.9).toFixed(2)} y={(b.punta[1] - 0.9).toFixed(2)} width="1.8" height="1.8" />
          </g>
        ))}
        <circle class="pie-sello__nucleo" cx="935" cy="1229" r="2" />
      </g>
    </g>
  </Fragment>

  {CRUCES.map((x) => (
    <g class="pie__cruz" slot="cruces">
      <rect x={x - 1.5} y="1333" width="3" height="3" />
      <path d={`M${x} 1329.4v2M${x} 1337.6v2M${x - 5.2} 1334.5H${x - 3.2}M${x + 3.2} 1334.5H${x + 5.2}`} />
    </g>
  ))}

  <!-- Cierre de la regla de abajo: rombo hueco flanqueado por dos tríos de
       puntos. Es simétrico respecto de x=513, que es donde la referencia
       interrumpe la regla inferior del marco. -->
  <g class="pie__cierre" slot="despues">
    <path d={romboR(513, 1381.5, 5)} />
    {[-52, -44, -38, 38, 44, 52].map((d) => (
      <circle cx={513 + d} cy="1381.5" r={Math.abs(d) === 52 ? 1.4 : 1} />
    ))}
  </g>
</PieUniverse>

<style>
  /* Sólo lo de esta lámina: la banda de tres columnas y los dos sellos los
     viste `PieUniverse` con las variables `--pi-*` de arriba. */
  .pie__regla {
    fill: none;
    stroke: #cfcfd2;
    stroke-width: 1;
    stroke-opacity: 0.1;
  }
  .pie__esq path {
    fill: none;
    stroke: #cfcfd2;
    stroke-width: 1;
    stroke-opacity: 0.35;
  }
  .pie__guia {
    fill: none;
    stroke: #b49ad8;
    stroke-width: 0.8;
    stroke-opacity: 0.35;
  }

  /* ── tipografía del juramento y la firma ──────────────────────────────── */
  .pie__t {
    font-size: 10.5px;
    fill: #b49ad8;
    fill-opacity: 0.34;
  }
  /* Las seis líneas del juramento son la voz de la lámina: van más brillantes
     que cualquier otro texto chico de la página, medido. */
  .pie__voz {
    font-size: 9.6px;
    letter-spacing: 0.075em;
    text-anchor: middle;
    fill: #cfcfd2;
    fill-opacity: 0.43;
    transform: translateX(0.36px);
  }
  .pie__marca {
    font-size: 9.4px;
    text-anchor: middle;
    fill: #cfcfd2;
    fill-opacity: 0.6;
  }

  /* ── firma ────────────────────────────────────────────────────────────── */
  .pie__firma path {
    fill: none;
    stroke: #d8d4dd;
    stroke-width: 1.15;
    stroke-opacity: 0.58;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pie__cola { stroke-width: 0.9 !important; stroke-opacity: 0.5 !important; }

  /* ── cruces y cierre ──────────────────────────────────────────────────── */
  .pie__cruz rect { fill: #b49ad8; fill-opacity: 0.4; }
  .pie__cruz path { stroke: #b49ad8; stroke-width: 0.9; stroke-opacity: 0.4; }

  .pie__cierre path {
    fill: none;
    stroke: #cfcfd2;
    stroke-width: 1;
    stroke-opacity: 0.4;
  }
  .pie__cierre circle { fill: #cfcfd2; fill-opacity: 0.35; }
</style>
