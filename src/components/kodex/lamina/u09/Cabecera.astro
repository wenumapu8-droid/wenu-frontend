  titInf={[523.5, 124.5, 33.2, 28.5]}
  titBarra="M606 91L611 91L591 155L586 155Z"
  titPalabra={{ x: 628.5, y: 153.5, size: 96, len: 316, t: "SOURCE" }}
  sig={{ x: 85, y: 191.5, len: 64, t: "A / -∞" }}
  lema={{ x: 351, y: 191.5, len: 344, t: "TRUTH CHAMBER" }}
  pag={{ x: 893, y: 191.5, len: 56, t: "PAGE 09" }}
  ejeI={EJE_I}
  ejeD={EJE_D}
  rielIzq={rielIzq}
  rielDer={rielDer}
  rielDash="1 5"
  nodosIzq={nodosIzq}
  nodosIzqR={1.4}
  nodosDer={nodosDer}
  micro={[
    { transform: "translate(13.6 852) rotate(-90)", len: 57, t: "XX KDX WEISSE" },
    { transform: "translate(1019.6 1167) rotate(-90)", len: 414, t: "KDX / 09 · 09 · 09   ·   TRUTH CHAMBER   ·   KDX / 09 · 09 · 09" },
  ]}
  folio={{ x: 1011, y: 548.5, len: 12.5, t: "09" }}
>
