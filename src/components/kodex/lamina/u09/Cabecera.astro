---
/**
 * KODEX-∞ · u09-source · CABECERA
 *
 * Marco exterior, rieles verticales, regla superior, título y bajada de
 * `reference/canon/u09-source.png` (1122×1402). Todo trazado en SVG por código:
 * ni un bitmap.
 *
 * El cromo lo pone `serie-universe/CabeceraUniverse.astro`. Las coordenadas de
 * acá salieron de barrer el PNG fila por fila y columna por columna con umbral
 * de luminancia (sonda propia, no estimación a ojo). Lo que conviene saber
 * antes de tocar nada:
 *
 *  · MARCO. Verticales en x=10,5 y x=1017,5; reglas en y=10,5 e y=1381,5, las
 *    dos recortadas por chaflanes de ~12 px en las cuatro esquinas. El póster NO
 *    está centrado en el lienzo: a la derecha quedan ~100 px de negro que están
 *    en la referencia. El eje de simetría del marco es x=514.
 *  · MARCO INTERIOR. Verticales en x=49 y x=978, de y≈100 a y≈1289, y una regla
 *    horizontal en y=1288,5 que es el techo del pie.
 *  · REGLA SUPERIOR. Cruces violeta en x=39 y x=990 (y=39,5). "KODEX-∞ UNIVERSE"
 *    ocupa x 56..231 y "OBSERVE. DECIPHER. TRANSCEND." x 735..966, las dos con
 *    versal de 9 px. El hexágono NO cae en el eje del marco: su centro medido es
 *    x=511, tres píxeles a la izquierda. Está así en la referencia.
 *  · TÍTULO. Y acá el hallazgo que separa esta lámina de la 02: KODEX y SOURCE
 *    SÍ comparten cuerpo. Las dos versales miden 93..153 —60 px exactos— así que
 *    va un solo cuerpo de 96 px (60 / 0,625 de altura de versal de Cormorant) y
 *    ninguno de los dos condensado. El reparto sigue en tres piezas porque el ∞,
 *    el guion y la barra van dibujados.
 *  · BAJADA. "TRUTH CHAMBER" ocupa x 352..694 con versal de 15 px, flanqueada
 *    por dos flechas de doble punta (216..320 y 725..828) que son simétricas
 *    respecto de x=522 — o sea que la bajada tiene su propio eje, ocho píxeles a
 *    la derecha del eje del marco. Medido, no elegido.
 *
 * LA PALETA NO ES LA DE u02. Medido sobre esta referencia, el violeta de los
 * rótulos tiene pico rgb(173,157,203) —r/b = 0,85— contra el 0,70 del #a77cf0
 * de la lámina 02: es un violeta MÁS GRIS. Y el texto de las celdas de la tabla
 * no es violeta en absoluto, su pico es rgb(122,127,126), un gris neutro. Usar
 * la paleta de u02 tiñe de lila toda la retícula.
 *
 * El peso del título es 300 y no 400: con 400 las astas engordan y el bloque
 * sale 2,5 puntos de luminancia por encima de la referencia.
 */
import CabeceraUniverse from "../serie-universe/CabeceraUniverse.astro";
import { rayos, rombo, hexPuntos, flechaDoble } from "../serie-universe/geom";

/* ── marco exterior ─────────────────────────────────────────────────────── */
/* Chaflán de 12 px sobre la diagonal en las cuatro esquinas, en sentido horario
   desde arriba a la izquierda. */
const chaflanes = [
  "M10.5 23L23 10.5",
  "M1005 10.5L1017.5 23",
  "M1017.5 1369L1005 1381.5",
  "M23 1381.5L10.5 1369",
];

/* Los rieles no son una línea continua: alternan tramos macizos, tramos de
   puntos y huecos, y no caen igual a izquierda y derecha.
   [y0, y1, macizo?] — medido segmento por segmento. */
const rielIzq: [number, number, boolean][] = [
  [26, 64, true], [112, 165, false], [198, 267, false], [365, 699, true],
  [868, 1170, true], [1173, 1230, false], [1234, 1294, true],
  [1298, 1334, false], [1338, 1366, true],
];
const rielDer: [number, number, boolean][] = [
  [26, 64, true], [120, 163, false], [285, 305, true], [310, 525, true],
  [571, 718, true], [753, 1167, true], [1171, 1228, false],
  [1253, 1295, true], [1298, 1335, false], [1338, 1366, true],
];

const EJE_I = 11;
const EJE_D = 1017;

/* Nodos sueltos de los rieles. */
const nodosIzq = [265.5, 358.5, 701.5, 711.5, 754.5, 863.5];
const nodosDer = [191.5, 214.5, 302.5, 563.5];

/* Calibrado contra la referencia caja por caja: la regla superior estaba 3,4
   puntos de luminancia POR DEBAJO y el resto de la franja 2-3 por encima. */
const vars = [
  "--cb-ink:#cfcfd2",
  "--cb-vio:#b07ecd",
  "--cb-tit:#dcd9e2",
  /* Mediana de luminancia de la regla superior en la ref: 36 → 36/207 = .174.
     La inferior mide mediana 24 (el .115 de siempre): va aparte, vía tenue. */
  "--cb-marco-op:.174",
  "--cb-marco-tenue-op:.115",
  "--cb-fantasma-op:.03",
  "--cb-interior-op:.05",
  "--cb-interior-esq-op:.12",
  "--cb-regla-op:.42",
  "--cb-regla-der-op:.36",
  "--cb-cruz-op:.4",
  "--cb-nodo-op:.3",
  "--cb-nodo-f-op:.42",
  "--cb-punteo-op:.09",
  "--cb-hex-borde-op:.1",
  "--cb-hex-tic-sw:1.3",
  "--cb-hex-tic-op:.18",
  "--cb-inf-sw:1.7",
  "--cb-inf-op:.72",
  "--cb-tit-inf-sw:4.6",
  "--cb-tit-inf-op:.82",
  "--cb-tit-peso:300",
  "--cb-tit-op:.98",
  "--cb-tit-fig-op:.8",
  "--cb-sig-size:15px",
  "--cb-sig-op:.44",
  "--cb-lema-size:20.5px",
  "--cb-lema-op:.5",
  "--cb-pag-size:13px",
  "--cb-pag-op:.44",
  "--cb-nota-size:11.8px",
  "--cb-nota-op:.31",
  "--cb-riel-op:.085",
  "--cb-glifo-op:.2",
  "--cb-micro-size:7px",
  "--cb-micro-op:.13",
  "--cb-folio-size:11px",
  "--cb-folio-op:.3",
].join(";");
---

<CabeceraUniverse
  gradId="u09"
  grad={["#f0eef3", "#dcd9e2", "#a9a3b6"]}
  ariaLabel="KODEX-∞ / SOURCE — página 09 · Truth chamber · Epistemic layers and provenance archive."
  vars={vars}
  marcoSup="M23 10.5H470M553 10.5H1005"
  marcoInf={{ d: "M23 1381.5H458M571 1381.5H1005", tenue: true }}
  fantasma="M10.5 23V1369M1017.5 23V1369"
  chaflanes={chaflanes}
  interior="M49.5 100V1289M978.5 100V1289"
  interiorRegla="M49.5 1288.5H978.5"
  interiorEsq="M49.5 224.5H66M978.5 224.5H962"
  cruces={[[39, 39.5], [990, 39.5]]}
