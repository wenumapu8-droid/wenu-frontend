  ["KX-CTRL_04", "SIGNAL ROUTER", 60],
];

/* ── piezas dibujadas a mano que no son del kit ───────────────────────── */

/** Peine de marcas de un troquel: los pines de un chip. */
function pines(x: number, y: number, n: number, largo: number, vert: boolean) {
  const r = rng(0x51 + n + x);
  return Array.from({ length: n }, (_, i) => {
    const t = i * (vert ? 1 : 1);
    const o = p2(0.35 + r() * 0.5);
    return vert
      ? { x: p2(x), y: p2(y + t * 2.6), w: p2(largo), h: 1, o }
      : { x: p2(x + t * 2.6), y: p2(y), w: 1, h: p2(largo), o };
  });
}

/** Marcas de esquina de una caja (los cuatro corchetes). */
function esquinas(x: number, y: number, w: number, h: number, l = 4) {
  const p: Array<[number, number, number, number]> = [];
  const add = (a: number, b: number, c: number, d: number) => p.push([a, b, c, d]);
  add(x, y, l, 1); add(x, y, 1, l);
  add(x + w - l, y, l, 1); add(x + w - 1, y, 1, l);
  add(x, y + h - 1, l, 1); add(x, y + h - l, 1, l);
  add(x + w - l, y + h - 1, l, 1); add(x + w - 1, y + h - l, 1, l);
  return p;
}

/** Retícula punteada de un monitor de señal. */
function reticula(x: number, y: number, w: number, h: number, nx: number, ny: number) {
  const v: string[] = [];
  for (let i = 1; i < nx; i++) v.push(`M${p2(x + (w * i) / nx)} ${y}V${y + h}`);
  for (let j = 1; j < ny; j++) v.push(`M${x} ${p2(y + (h * j) / ny)}H${x + w}`);
  return v.join("");
}

/* barras del OUTPUT FEED: espectro de columnas, determinista */
const rb = rng(0x0f16);
const barras = Array.from({ length: 40 }, (_, i) => {
  /* Un espectro NO es una campana: en la referencia hay picos altos aislados
     sobre un lecho bajo, y los picos se agrupan hacia la derecha. Con una
     envolvente suave sale una colina y se lee como un histograma de manual. */
  /* Un espectro NO es una campana. En la referencia hay agujas altas —que
     rozan el techo de la caja— cada dos o tres columnas, sobre un lecho bajo, y
     las columnas son de 1 px con hueco de 1. Con una envolvente suave sale una
     colina y se lee como el histograma de un manual. */
  const alta = rb() < 0.5; const v = alta ? 0.5 + rb() * 0.5 : 0.12 + rb() * 0.26; return { x: p2(430 + i * 1.95), h: p2(v * 60) };
});

/* micro-marcas de los chips: la columna de rayitas del canto derecho */
const rt = rng(0x2ac1);
const ticksChip = Array.from({ length: 14 }, (_, i) => ({
  y: p2(288 + i * 5.4),
  w: p2(3 + rt() * 9),
  o: p2(0.3 + rt() * 0.6),
}));
/* Trama de fondo del chip: la referencia no deja un chip vacío alrededor del
   troquel, lo llena de puntitos y rayitas de 1 px. Sin eso el bloque queda con
   un 23 % menos de tinta que el original y el diff estructural lo cobra. */
const rg = rng(0x77c3);
const tramaChip = Array.from({ length: 150 }, () => {
  const largo = rg() < 0.25 ? 2 + rg() * 5 : 1;
  return {
    x: p2(6 + rg() * 82),
    y: p2(286 + rg() * 84),
    w: p2(largo),
    o: p2(0.12 + rg() * 0.4),
  };
});

const pinta = (id: string, fill: string, op = 1) => {
  const a = ARTE[id];
  if (!a) return "";
  return (
    `<svg x="${a.x}" y="${a.y}" width="${a.w}" height="${a.h}" viewBox="0 0 ${a.vw} ${a.vh}" preserveAspectRatio="none">` +
    a.d.map(([d, tr]) => `<path d="${d}"${tr ? ` transform="${tr}"` : ""} fill="${fill}" opacity="${op}"/>`).join("") +
    `</svg>`
  );
};

const COLOR_ST = [CY, MG, "#a9afac", "#a291b1", "#c6c8c4", "#aaaaa7", "#b6b8b6"];
const COLOR_CHIP = ["#a473c3", "#35aaad", "#59b9d5", "#4abbcf"];
