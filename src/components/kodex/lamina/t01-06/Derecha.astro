    <g class="d6__crisp">
      {marcos.map(([x, y, w, h, f]) => <rect x={x} y={y} width={w} height={h} fill={f} />)}
      {cajas.map(([x, y, w, h, f]) => <rect x={x} y={y} width={w} height={h} fill={f} />)}
      {divGlifos.map(([x, y, w, h, f]) => <rect x={x} y={y} width={w} height={h} fill={f} />)}
      <!-- rayita decorativa a la derecha del título del panel 04 -->
      <rect x="504" y="23" width="138" height="1" fill={G(34)} />
      <rect x="504" y="20" width="1" height="4" fill={G(30)} />
