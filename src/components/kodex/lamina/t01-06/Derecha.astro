      <path d={reticula(431, 175, 197, 67, 8, 4)} />
    </g>
    <g stroke={G(46)} stroke-width="0.7" stroke-dasharray="3 3" fill="none">
      <path d="M366 173V241" />
      <path d="M579 175V242" />
      <path d="M431 208H500" />
    </g>
    <!-- el gancho que enlaza INPUT con OUTPUT -->
    <path d="M411 200c5 2 5 10 0 12" stroke={G(60)} stroke-width="0.9" fill="none" />

    <!-- OUTPUT FEED · espectro de barras -->
    <g fill={CY} data-symbolic="true">
      {barras.map((b) => <rect x={b.x} y={p2(238 - b.h)} width="1" height={b.h} opacity="0.9" />)}
    </g>

    <!-- OUTPUT FEED · globo polar (marca fija, trazada) -->
    <g set:html={pinta("globo", CY, 0.7)} />

    <!-- chips: troquel, pines, corchetes y micro-marcas -->
    {CH.map((cx, i) => (
      <g>
        <g class="d6__crisp" fill={G(58)}>
          {esquinas(cx + 3, 284, 88, 86, 4).map(([x, y, w, h]) => (
            <rect x={x} y={y} width={w} height={h} opacity="0.7" />
          ))}
          {ticksChip.map((t) => (
            <rect x={cx + 76} y={t.y} width={t.w} height="1" opacity={t.o} />
          ))}
          {tramaChip.map((t) => (
            <rect x={p2(cx + t.x)} y={t.y} width={t.w} height="1" opacity={t.o} />
          ))}
        </g>
        <rect x={cx + 33} y="323" width="38" height="34" rx="2" fill="none" stroke={G(74)} stroke-width="0.9" />
        <rect x={cx + 37} y="327" width="30" height="26" fill="#0b0910" stroke={G(64)} stroke-width="0.6" />
        <g class="d6__crisp" fill={G(96)}>
          {pines(cx + 36, 318, 12, 4, false).map((p) => (
            <rect x={p.x} y={p.y} width={p.w} height={p.h} opacity={p.o} />
          ))}
          {pines(cx + 36, 358, 12, 4, false).map((p) => (
            <rect x={p.x} y={p.y} width={p.w} height={p.h} opacity={p.o} />
          ))}
          {pines(cx + 27, 326, 11, 4, true).map((p) => (
            <rect x={p.x} y={p.y} width={p.w} height={p.h} opacity={p.o} />
          ))}
          {pines(cx + 71, 326, 11, 4, true).map((p) => (
            <rect x={p.x} y={p.y} width={p.w} height={p.h} opacity={p.o} />
          ))}
        </g>
        <g set:html={pinta(`chip${i + 1}`, COLOR_CHIP[i], 0.88)} />
        <g class="d6__tx">
          <text x={cx + 8} y="297" font-size="10" textLength="52" lengthAdjust="spacingAndGlyphs" fill="#c3c8c4">{CHIPS[i][0]}</text>
          <text x={cx + 8} y="307" font-size="9.6" textLength={CHIPS[i][2]} lengthAdjust="spacingAndGlyphs" fill="#8b918c">{CHIPS[i][1]}</text>
        </g>
      </g>
    ))}

    <!-- SYSTEM STATUS · los siete glifos (marca fija, trazados) -->
    <g role="img" aria-label="SYSTEM STATUS — POWER NOMINAL, LINK SECURE, SYNC LOCKED, THREAT NONE.">
      {[0, 1, 2, 3, 4, 5, 6].map((i) => (
        <g set:html={pinta(`st${i + 1}`, COLOR_ST[i], 0.62)} />
      ))}
    </g>

    <!-- ARCHIVE LINK -->
    <g class="d6__tx">
      <text x="547" y="433" font-size="13.4" textLength="72" lengthAdjust="spacingAndGlyphs" fill="#21afbd">ARCHIVE LINK</text>
      <text x="560" y="447" font-size="10" textLength="47" lengthAdjust="spacingAndGlyphs" fill="#0f9aa2">CONNECTED</text>
      <!-- El lemniscato NO va como <text>: U+221E no está en la cadena de mono
           del navegador de captura y sale en blanco. Dos anillos tangentes,
           que es lo que hay en la referencia (27×13 px, trazo de 2). -->
      <g stroke="#dfe1dd" stroke-width="2" fill="none">
        <circle cx="576" cy="462" r="5.6" />
        <circle cx="589" cy="462" r="5.6" />
      </g>
    </g>
  </svg>

  <!-- ── primitivas del kit, posicionadas sobre la caja ─────────────────── -->
  <!-- 01 GLYPH LOCK: anillos apretados y malla de fondo -->
  <span class="d6__p" style="left:224px;top:69px">
    <RadialScanner w={61} h={61} semilla={41} anillos={8} radios={32} rmax={30} razon={0.83} color={CY} frio="#cdeef2" nucleo={0} ticks={40} pesoRadios={2.2} grosorRadios={0.45} />
  </span>
  <!-- 02 FIELD DENSITY: acá los RADIOS son el dibujo, no la trama -->
  <span class="d6__p" style="left:302px;top:67px">
    <RadialScanner w={65} h={65} semilla={83} anillos={5} radios={44} rmax={29} razon={0.74} color={CY} frio="#a8e8ee" nucleo={0} ticks={44} pesoRadios={3} grosorRadios={0.5} />
  </span>
  <!-- 03 SIGNAL STRENGTH -->
  <span class="d6__p" style="left:386px;top:71px">
    <Waveform w={69} h={54} semilla={97} variante="peine" n={68} color={CY} grosor={0.7} inercia={0.05} envolvente={0.9} margen={2} />
  </span>
  <!-- 04 PHASE OFFSET -->
  <span class="d6__p" style="left:475px;top:68px">
    <RadialScanner w={64} h={64} semilla={17} anillos={1} radios={0} rmax={30}
      razon={0.7} color="#8d989a" frio={CY} nucleo={0} ticks={30} />
  </span>
  <!-- 05 CORE TEMP -->
  <span class="d6__p" style="left:559px;top:66px">
    <RadialScanner w={66} h={66} semilla={29} anillos={1} radios={0} rmax={32}
      razon={0.845} color={MG} frio={MG_HOT} nucleo={0} ticks={26} />
  </span>
  <!-- INPUT STREAM: ruido con picos, no una curva suave -->
  <span class="d6__p" style="left:224px;top:183px">
    <Waveform w={140} h={50} semilla={311} variante="linea" n={152} color="#9c6dc4"
      grosor={0.7} inercia={0.16} margen={2} />
  </span>

  {CH.map((cx) => (
    <span class="d6__p" style={`left:${cx + 8}px;top:311px`}>
      <Micrografia w={18} h={56} semilla={cx} renglon={5} marca={1} densidad={0.5}
        palabra={3} color="#7d8288" opacidad={0.42} huecos={0.3} />
    </span>
  ))}

  <!-- ── los dos diagramas del panel 03: código, no calco ──────────────── -->
  <canvas class="d6__cv" data-kdx="orbita" width="128" height="120"
    style="left:8px;top:58px;width:128px;height:120px"
    role="img" aria-label="ORBIT DIAGRAM — eje del núcleo, anillo de campo, órbita de glifos y flujo de datos."></canvas>
  <canvas class="d6__cv" data-kdx="campo" width="132" height="100"
    style="left:4px;top:205px;width:132px;height:100px"
    role="img" aria-label="FIELD LAYERS — campo interior, medio, exterior y cáscara nula."></canvas>
</div>

<style>
  /* position y overflow explícitos: el estilo con ámbito del componente le gana
     a la clase heredada, y lo que se sale de la caja pisa al vecino. */
  .d6 {
    position: absolute;
    overflow: hidden;
    background: transparent;
    font-family: var(--lam-mono);
  }
  .d6__art { position: absolute; left: 0; top: 0; }
  .d6__p { position: absolute; display: block; }
  .d6__cv { position: absolute; display: block; }

  /* Las tiras de marco son líneas de 1 px alineadas a la retícula: con
     antialias se parten en dos grises de medio brillo, que es justo lo que el
     diff estructural castiga. */
  .d6__crisp { shape-rendering: crispEdges; }

  .d6__tx {
    font-family: var(--lam-mono);
    letter-spacing: 0;
    white-space: pre;
  }
</style>

<script>
  /* ── ORBIT DIAGRAM y FIELD LAYERS ────────────────────────────────────────
   *
   * Los dos diagramas del panel 03 son lo único de este bloque que en la página
   * viva tiene estado, así que son los dos únicos <canvas>. Nada de esto es un
   * calco: el campo sale de la ecuación del dipolo (r = L·sen²θ) y la órbita de
   * un puñado de radios y fases. Cambiar un parámetro cambia el dibujo, que es
   * la prueba de que está construido y no trazado.
   *
   * Congelado: el banco captura con animations:disabled, que NO detiene un rAF
   * propio. La página expone __kdxFreeze(); acá se registra el pintor de un
   * cuadro concreto y se corta el bucle.
   */
  (() => {
    const cvOrb = document.querySelector('canvas[data-kdx="orbita"]');
    const cvCam = document.querySelector('canvas[data-kdx="campo"]');
    if (!cvOrb || !cvCam) return;

    const g1 = cvOrb.getContext("2d");
    const g2 = cvCam.getContext("2d");
    const CY = "#19b8cc", CYH = "#7ee1e2", MG = "#9b6cc4", MGH = "#cebddf";

    /* azar determinista: dos capturas del mismo cuadro deben dar lo mismo */
    function rng(seed) {
      let a = seed >>> 0;
      return () => {
        a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    const anillo = (g, cx, cy, r, col, w, op, dash) => {
      g.save();
      g.globalAlpha = op;
      g.strokeStyle = col;
      g.lineWidth = w;
      if (dash) g.setLineDash(dash);
      g.beginPath();
      g.arc(cx, cy, r, 0, Math.PI * 2);
      g.stroke();
      g.restore();
    };

    const punto = (g, x, y, r, col, halo) => {
      if (halo) {
        g.globalAlpha = 0.28;
        g.fillStyle = col;
        g.beginPath(); g.arc(x, y, r * 2.6, 0, Math.PI * 2); g.fill();
      }
      g.globalAlpha = 1;
      g.fillStyle = col;
      g.beginPath(); g.arc(x, y, r, 0, Math.PI * 2); g.fill();
    };

    /* ── ORBIT DIAGRAM ─────────────────────────────────────────────────── */
    const CX = 62, CY0 = 62;                 // centro medido: (1084, 208)
    const R = [13, 21, 30, 44, 53];          // radios medidos sobre la fila y=208
    const rO = rng(0x0be1);
    const motas = [];
    for (let i = 0; i < 26; i++) {
      motas.push({
        a: rO() * Math.PI * 2,
        r: 44 + rO() * 10,
        s: rO() < 0.3 ? 1.4 : 1,
        c: rO() < 0.25 ? MGH : "#cfd6dc",
      });
    }
    const radios = [];
    for (let i = 0; i < 12; i++) radios.push((i * Math.PI * 2) / 12 + 0.13);

    function orbita(t) {
      const g = g1;
      g.clearRect(0, 0, 128, 120);
      const gi = t * 0.00022;          // órbita de glifos: al derecho
      const gc = -t * 0.00014;         // flujo de datos: contra el campo
      const lat = 0.5 + 0.5 * Math.sin(t * 0.0016);

      /* telaraña de fondo: radios y una malla débil */
      g.save();
      g.globalAlpha = 0.5;
      g.strokeStyle = "#2b2440";
      g.lineWidth = 0.6;
      for (const a of radios) {
        g.beginPath();
        g.moveTo(CX + Math.cos(a) * 8, CY0 + Math.sin(a) * 8);
        g.lineTo(CX + Math.cos(a) * 40, CY0 + Math.sin(a) * 40);
        g.stroke();
      }
      g.restore();
      anillo(g, CX, CY0, 36, "#241d33", 0.6, 0.9);
      anillo(g, CX, CY0, 8, "#4a4560", 0.7, 0.8);

      /* ejes: la cruz que atraviesa el diagrama entero */
      g.save();
      g.globalAlpha = 0.45;
      g.strokeStyle = "#4b4358";
      g.lineWidth = 0.7;
      g.setLineDash([1, 3]);
      g.beginPath();
      g.moveTo(CX, 2); g.lineTo(CX, 118);
      g.moveTo(4, CY0); g.lineTo(124, CY0);
      g.stroke();
      g.restore();

      /* NULL SHELL: la cáscara punteada de afuera */
      anillo(g, CX, CY0, R[4] + 2, "#5c5169", 0.7, 0.5, [1, 3]);
      /* DATA FLOW: anillo discontinuo que gira al revés */
      g.save();
      g.translate(CX, CY0); g.rotate(gc); g.translate(-CX, -CY0);
      anillo(g, CX, CY0, R[4], MG, 0.8, 0.6, [5, 6]);
      g.restore();

      /* GLYPH ORBIT: el anillo frío, y las motas que orbitan con él */
      anillo(g, CX, CY0, R[3], CY, 1, 0.85);
      g.save();
      for (const m of motas) {
        const a = m.a + gi;
        const x = CX + Math.cos(a) * m.r;
        const y = CY0 + Math.sin(a) * m.r;
        g.globalAlpha = 0.75;
        g.fillStyle = m.c;
        g.fillRect(x - m.s / 2, y - m.s / 2, m.s, m.s);
      }
      g.restore();

      /* FIELD RING: anillo cálido con cuatro nodos cardinales */
      anillo(g, CX, CY0, R[1], MG, 1, 0.9);
      anillo(g, CX, CY0, R[0], MG, 0.7, 0.5);
      for (let i = 0; i < 4; i++) {
        const a = (i * Math.PI) / 2 - Math.PI / 2;
        punto(g, CX + Math.cos(a) * R[1], CY0 + Math.sin(a) * R[1], 1.5, "#f3ecff", true);
      }

      /* CORE AXIS: los dos nodos fríos del eje, arriba y abajo */
      punto(g, CX, CY0 - R[2], 2.1, CYH, true);
      punto(g, CX, CY0 + R[2], 2.1, CYH, true);

      /* satélites: el aro cálido a babor y el punto blanco a estribor */
      anillo(g, CX - 28, CY0, 5, MG, 1, 0.9);
      punto(g, CX + 26, CY0, 1.9, "#fff3ff", true);

      /* núcleo: late */
      g.globalAlpha = 0.16 + 0.1 * lat;
      g.fillStyle = CYH;
      g.beginPath(); g.arc(CX, CY0, 7, 0, Math.PI * 2); g.fill();
      punto(g, CX, CY0, 2.6 + 0.4 * lat, CYH, true);
      g.globalAlpha = 1;
    }

    /* ── FIELD LAYERS ──────────────────────────────────────────────────── */
    const FX = 66, FY = 49;                  // centro medido: (1084, 342)
    /* La huella medida del campo es 115×86 px, y la forma NO es la de un
       dipolo puntual. Medido sobre la referencia: a 2/3 de la altura el bucle
       exterior ya alcanza el 93 % de su ancho, y su punto más alto cae sobre el
       eje. Un dipolo r = L·sen²θ pone el punto más alto a 0,54·L del eje y sólo
       llega a y = 0,385·L: sale una pajarita aplastada, que es como salió la
       primera pasada de este bloque.

       Los dos pares (0,93 · 0,67) y (1 · 0) los resuelve una superelipse
         |x/A|^n + |y/B|^n = 1   con n ≈ 3,6
       que es el campo de un imán con dos polos sobre la espina —bucles que
       suben pegados al eje y se abren a media altura—, no el de un punto.
       Parametrizada con exponente e = 2/n para poder recorrerla de un tirón. */
    const EXP = 0.555;
    const sg = (v) => (v < 0 ? -1 : 1);

    function lineaCampo(g, A, B, col, op, w) {
      g.save();
      g.globalAlpha = op;
      g.strokeStyle = col;
      g.lineWidth = w;
      g.beginPath();
      for (let i = 0; i <= 160; i++) {
        const t = (i / 160) * Math.PI * 2;
        const st = Math.sin(t), ct = Math.cos(t);
        const x = FX + A * sg(st) * Math.pow(Math.abs(st), EXP);
        const y = FY - B * sg(ct) * Math.pow(Math.abs(ct), EXP);
        if (i === 0) g.moveTo(x, y); else g.lineTo(x, y);
      }
      g.stroke();
      g.restore();
    }

    const rF = rng(0x0fed);
    const toro = [];
    for (let i = 0; i < 14; i++) {
      toro.push({
        rx: 9 + i * 3.6,
        ry: 2 + i * 0.85,
        dy: (rF() - 0.5) * 3.2,
        op: 0.34 + rF() * 0.55,
        w: 0.5 + (rF() < 0.3 ? 0.4 : 0),
      });
    }

    function campo(t) {
      const g = g2;
      g.clearRect(0, 0, 132, 100);
      const resp = 0.94 + 0.06 * Math.sin(t * 0.0013);
      const giro = t * 0.00018;

      /* las capas del campo, de afuera hacia adentro */
      for (let i = 9; i >= 0; i--) {
        const A = (13 + i * 4.9) * resp;
        const B = (31 + i * 1.35) * resp;
        const frio = i < 3;
        lineaCampo(g, A, B, frio ? "#33566e" : "#4a3968", 0.6 + i * 0.03, 0.65);
      }
      /* NULL SHELL: la envolvente punteada */
      g.save();
      g.setLineDash([1, 3]);
      lineaCampo(g, 57 * resp, 44 * resp, "#6a5c7d", 0.75, 0.7);
      g.restore();

      /* el disco: elipses concéntricas achatadas, ninguna con el mismo peso */
      g.save();
      g.translate(FX, FY);
      for (const e of toro) {
        g.globalAlpha = e.op;
        g.strokeStyle = CY;
        g.lineWidth = e.w;
        g.beginPath();
        g.ellipse(0, e.dy, e.rx * resp, e.ry, Math.sin(giro + e.rx * 0.05) * 0.05, 0, Math.PI * 2);
        g.stroke();
      }
      /* el anillo cálido de en medio */
      g.globalAlpha = 0.95;
      g.strokeStyle = "#a86ec8";
      g.lineWidth = 1;
      g.beginPath();
      g.ellipse(0, 1, 24 * resp, 5.6, 0, 0, Math.PI * 2);
      g.stroke();
      g.restore();

      /* espina y núcleo */
      g.save();
      g.globalAlpha = 0.85;
      g.strokeStyle = CYH;
      g.lineWidth = 1.2;
      g.beginPath();
      g.moveTo(FX, FY - 14); g.lineTo(FX, FY + 14);
      g.stroke();
      g.restore();
      punto(g, FX, FY - 12, 1.8, "#dfeaff", true);
      punto(g, FX, FY + 12, 1.8, "#dfeaff", true);
      g.globalAlpha = 0.22;
      g.fillStyle = CYH;
      g.beginPath(); g.arc(FX, FY, 5.5 * resp, 0, Math.PI * 2); g.fill();
      punto(g, FX, FY, 2.4, CYH, true);
      g.globalAlpha = 1;
    }

    /* ── bucle y congelado ─────────────────────────────────────────────── */
    let raf = 0;
    let frozen = false;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const draw = (t) => { orbita(t); campo(t); };

    const bucle = (ts) => {
      if (frozen) return;
      draw(ts);
      raf = requestAnimationFrame(bucle);
    };

    draw(0);

    const freeze = (t) => {
      frozen = true;
      if (raf) cancelAnimationFrame(raf);
      draw(t || 0);
    };

    /* El congelador de la página puede definirse después que este módulo,
       según cómo Astro ordene los scripts empaquetados: se reintenta en vez de
       asumir el orden. */
    const w = window;
    if (typeof w.__kdxRegisterFreeze === "function") {
      w.__kdxRegisterFreeze(freeze);
    } else {
      let tries = 0;
      const id = setInterval(() => {
        if (typeof w.__kdxRegisterFreeze === "function") {
          clearInterval(id);
          w.__kdxRegisterFreeze(freeze);
        } else if (++tries > 240) clearInterval(id);
      }, 25);
    }

    if (!reduced) raf = requestAnimationFrame(bucle);
    else frozen = true;
  })();
</script>
