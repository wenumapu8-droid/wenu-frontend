/**
 * KODEX-∞ · t01-06 RITUAL DEVICE · DERECHA (1014,88 · 654×778)
 *
 * ── Qué cae en la caja y qué no ───────────────────────────────────────────
 *
 * El andamiaje me da 1014..1668 × 88..866, pero los RECORTES de esta lámina
 * dicen otra cosa: `crops/t01-06/iter1/Derecha.png` mide 654×486 —o sea
 * y=88..574— y existe además un `Bandas.png` de 1672×287 que es la banda de
 * abajo entera. Los recortes describen el reparto real; el JSON de paneles es
 * la salida genérica de `andamiar.mjs`, con los tres tercios a altura completa.
 *
 * Dibujo lo que me encargaron y lo que los recortes confirman como mío: los
 * paneles 03 y 04, de y=97 a y=569. NO dibujo el 07 HABITAT ni el 08 MOBILE
 * TILE, que caen dentro de mi caja del JSON pero son de la banda inferior.
 * Queda ANOTADO como el punto dudoso número uno: si nadie toma esa banda, el
 * tercio de abajo de mi caja queda negro y mi puntaje medido con la caja del
 * JSON lo paga entero. Medido con la caja real del recorte, no.
 *
 * ── De dónde salen las medidas ────────────────────────────────────────────
 *
 * Barrido fila por fila y columna por columna, quedándome con las líneas que
 * tienen tinta en más del 75 % de su largo. Nada estimado:
 *
 *   marco del póster   x=1665,1666 (toda la altura)
 *   panel 03           x=1014,1015 … 1216,1217 · y=97,98 … 568,569
 *                      reglas interiores y=123/124 · 268/269 · 397/398
 *   panel 04           x=1223,1224 … 1655,1656 · mismas tapas
 *                      reglas y=123/124 · 340/341 · 362/363 · 469/470
 *   medidores          y=148..226 · x 1233-1303 · 1313-1383 · 1393-1474 ·
 *                      1485-1558 · 1569-1644   ← NO son cinco cajas iguales:
 *                      miden 70, 70, 81, 73 y 75. Repartirlas parejo mueve
 *                      cuatro de los cinco.
 *   señales            INPUT 1233-1421 · OUTPUT 1442-1645, y=258..332
 *   chips              y=370..460 · 1233-1326 · 1339-1432 · 1445-1538 ·
 *                      1552-1645 (93 de ancho, 13 de aire)
 *   SYSTEM STATUS      caja 1230..1656 y=479..568 · tira 1233-1541 y=499..522
 *                      glifos y=525..566 · ARCHIVE LINK 1547-1648
 *   divisoria de banda y=579, de borde a borde del póster
 *
 * ── Procedural vs. trazado ────────────────────────────────────────────────
 *
 * Este bloque no tiene héroe: tiene INSTRUMENTOS, y un instrumento es
 * exactamente lo que el contrato manda dibujar. Van por código:
 *
 *  · el ORBIT DIAGRAM y el FIELD LAYERS, en dos <canvas> con su propio rAF —
 *    el primero hace girar la órbita de glifos y late el núcleo; el segundo
 *    calcula las líneas de campo de un dipolo (r = L·sen²θ, la fórmula, no un
 *    dibujo de una) y respira el toroide;
 *  · los cinco medidores, las dos señales y el cuerpo de los cuatro chips, con
 *    las primitivas del kit (RadialScanner, Waveform, Micrografía) — que es
 *    para lo que están.
 *
 * Va TRAZADO sólo lo que es marca fija y no tiene estado: los siete glifos de
 * SYSTEM STATUS, los cuatro emblemas del troquel de los chips y el globo polar
 * del OUTPUT FEED. Doce piezas, 238 paths. Se regeneran con
 *   node scripts/lamina/_t0106_der_arte.mjs
 *
 * El texto es TEXTO, no contorno: <text> con `textLength` +
 * `lengthAdjust="spacingAndGlyphs"`. La tipografía del póster es una mono
 * condensada —la relación alto de caja / avance ronda 1,45 contra el 1,17 de
 * una mono normal— y estirar el texto a la medida tomada es lo que la clava sin
 * pelearse con las métricas de la fuente del navegador.
 *
 * Las cifras del póster (+17.3°, 36.4°C, -24.8 dB, 7.83 kHz) son ficción: los
 * grupos que las contienen van con data-symbolic="true".
 *
 * Puntaje:
 *   node scripts/lamina/score-panel.mjs t01-06-ritual-device Derecha --triptico
 */
import { ARTE } from "./trazos/der";
import { rng, p2 } from "../kit/rng";
import RadialScanner from "../kit/RadialScanner.astro";
import Waveform from "../kit/Waveform.astro";
import Micrografia from "../kit/Micrografia.astro";

interface Props { box: string }
const { box } = Astro.props;

/* ── paleta medida sobre la referencia ─────────────────────────────────── */
const CY_TIT = "#22cfd8";   // títulos numerados
const INK = "#a5aaad";      // rótulos de sección
const DIM = "#7a7c79";      // leyendas
const NOTE = "#9ea49f";     // texto corrido
const CY = "#19b8cc";       // instrumento frío
const CY_HOT = "#7ee1e2";   // núcleos
const MG = "#9b6cc4";       // instrumento cálido
const MG_HOT = "#cebddf";

/* ── marcos: [x, y, ancho, alto, relleno] ──────────────────────────────────
   El brillo de cada línea es el promedio medido de esa fila/columna en la
   referencia. No hay dos iguales y emparejarlas aplana la lámina. */
const G = (v: number) => `rgb(${v},${v},${v})`;
const marcos: [number, number, number, number, string][] = [
  // panel 03 — tapas y reglas
  [0, 9, 204, 1, G(27)], [0, 10, 204, 1, G(13)],
  [1, 35, 202, 1, G(27)], [1, 36, 202, 1, G(18)],
  [1, 180, 202, 1, G(13)], [1, 181, 202, 1, G(40)],
  [1, 309, 202, 1, G(28)], [1, 310, 202, 1, G(19)],
  [0, 480, 204, 1, G(26)], [0, 481, 204, 1, G(21)],
  [0, 9, 1, 473, G(27)], [1, 9, 1, 473, G(33)],
  [202, 9, 1, 473, G(39)], [203, 9, 1, 473, G(19)],

  // panel 04 — tapas y reglas
  [209, 9, 434, 1, G(24)], [209, 10, 434, 1, G(12)],
  [210, 35, 432, 1, G(15)], [210, 36, 432, 1, G(12)],
  [210, 252, 432, 1, G(15)], [210, 253, 432, 1, G(18)],
  [210, 274, 432, 1, G(28)], [210, 275, 432, 1, G(12)],
  [210, 381, 432, 1, G(19)], [210, 382, 432, 1, G(13)],
  [209, 480, 434, 1, G(20)], [209, 481, 434, 1, G(15)],
  [209, 9, 1, 473, G(26)], [210, 9, 1, 473, G(25)],
  [641, 9, 1, 473, G(37)], [642, 9, 1, 473, G(13)],

  // marco derecho del póster y divisoria contra la banda de abajo
  [651, 0, 1, 778, G(24)], [652, 0, 1, 778, G(52)],
  [0, 491, 651, 1, G(37)],
];

/** Caja de 1 px: cuatro tiras en vez de un <rect stroke>, que a 1 px cae
 *  medio píxel fuera de la retícula y el diff estructural lo cobra. */
const caja = (x: number, y: number, w: number, h: number, f: string) =>
  [
    [x, y, w, 1, f],
    [x, y + h - 1, w, 1, f],
    [x, y, 1, h, f],
    [x + w - 1, y, 1, h, f],
  ] as [number, number, number, number, string][];

/* medidores · señales · chips · estado: los rectángulos medidos */
const GA = [
  { x: 219, w: 71 }, { x: 299, w: 71 }, { x: 379, w: 82 },
  { x: 471, w: 74 }, { x: 555, w: 76 },
];
const CH = [219, 325, 431, 538];
const cajas: [number, number, number, number, string][] = [
  ...GA.flatMap((g) => caja(g.x, 60, g.w, 79, G(29))),
  ...caja(219, 169, 189, 76, G(26)),   // INPUT STREAM
  ...caja(428, 171, 204, 75, G(26)),   // OUTPUT FEED
  ...CH.flatMap((x) => caja(x, 281, 94, 92, G(30))),
  ...caja(216, 391, 427, 90, G(17)),   // SYSTEM STATUS
  ...caja(219, 411, 309, 24, G(31)),   // tira de estado
  ...caja(219, 437, 309, 41, G(22)),   // fila de glifos
  ...caja(533, 411, 102, 67, G(28)),   // ARCHIVE LINK
];

/* divisores de la fila de glifos: siete celdas de 44 px */
const divGlifos = [1, 2, 3, 4, 5, 6].map((i) => [219 + i * 44, 438, 1, 39, G(20)] as
  [number, number, number, number, string]);

/* ── texto ─────────────────────────────────────────────────────────────────
   [x, línea de base, cadena, tamaño, largo medido, color]. El largo sale del
   barrido de columnas de la referencia; `textLength` lo clava. */
type Txt = [number, number, string, number, number, string];
const T03: Txt[] = [
  [9, 28, "03. ORBIT & FIELD MOTION", 12.4, 156, CY_TIT],
  [15, 56, "ORBIT DIAGRAM", 11.1, 70, INK],
  [13, 203, "FIELD LAYERS", 11.1, 65, INK],
  [13, 331, "FLOW NOTES", 11.1, 55, INK],
];
const LEY: Array<[number, string, number, string]> = [
  [96, "CORE AXIS", 35, CY], [114, "FIELD RING", 38, MG],
  [131, "GLYPH ORBIT", 43, CY], [148, "DATA FLOW", 36, MG],
  [231, "INNER FIELD", 43, MG], [248, "MID FIELD", 36, CY],
  [267, "OUTER FIELD", 43, CY], [285, "NULL SHELL", 39, CY],
];
const NOTAS: Array<[number, number, string, number, boolean]> = [
  [19, 349, "Energy rises through the spine.", 154, true],
  [19, 364, "Glyphs orbit counter to field.", 149, true],
  [19, 379, "Resonance forms interference", 141, true],
