  [19, 409, "Emission collapses outward", 133, true],
  [23, 423, "into broadcast lattice.", 113, false],
];
const T04: Txt[] = [
  [220, 28, "04. INTERFACE WIDGETS / CONTROLLERS", 12.4, 229, CY_TIT],
  [220, 55, "GLYPH LOCK", 9.8, 46, INK],
  [300, 55, "FIELD DENSITY", 9.8, 58, INK],
  [381, 55, "SIGNAL STRENGTH", 9.8, 69, INK],
  [473, 55, "PHASE OFFSET", 9.8, 54, INK],
  [559, 55, "CORE TEMP.", 9.8, 46, INK],
  [221, 164, "INPUT STREAM", 9.8, 57, INK],
  [429, 166, "OUTPUT FEED", 9.8, 52, INK],
  [219, 270, "CONTROLLER CHIPS", 10.4, 89, CY_TIT],
  [220, 407, "SYSTEM STATUS", 11.6, 70, CY_TIT],
];
const CIFRAS: Txt[] = [
  [372, 191, "THRESH", 9.2, 26, DIM],
