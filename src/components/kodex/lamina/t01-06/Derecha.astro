      {LEY.map(([y, s, tl, c]) => (
        <g>
          <rect x="138" y={y - 5} width="7" height="2" fill={c} />
          <text x="148" y={y} font-size="9.5" textLength={tl} lengthAdjust="spacingAndGlyphs" fill={DIM}>{s}</text>
        </g>
