---
/**
 * KODEX-∞ · u10-commons · PANELES LATERALES
 *
 * Marcos y textos de los paneles laterales, dibujados sobre el campo estelar.
 * Los paneles son transparentes; el héroe procedural se ve por detrás.
 *
 * LOS PANELES DE u10 NO LLEVAN MARCO (medido 2026-08-14). Se dibujaban ocho
 * `u10p-caja`, un rectángulo completo por panel, y la referencia no tiene
 * ninguno: barriendo `reference/canon/u10-commons.png` fila por fila, en las
 * dos columnas laterales hay CERO filas con tinta continua de 150 px o más,
 * mientras que el render tenía ocho, todas de 349 px exactos —los bordes
 * superior e inferior de los cuatro marcos de cada lado— en y=15, 279, 310,
 * 574, 605, 792, 823 y 1061 de la región.
 *
 * A `stroke-opacity: .14` el marco parecía inofensivo a ojo, y el banco lo
 * cobraba en las dos regiones a la vez: es tinta puesta donde la referencia no
 * tiene nada, y encima larga. Los ángulos de esquina (`u10p-esq`) SÍ se quedan:
 * son tramos de 12 px y no aparecen en ese barrido.
 *
 * La lámina no tiene paneles enmarcados: tiene un campo abierto con marcas
 * sueltas y texto encima.
 */
import { readFileSync } from "node:fs";
import { join } from "node:path";

/**
 * Pega un glifo TRAZADO de `scripts/lamina/glyphs.mjs` en coordenadas de lámina.
 *
 * La escritura a mano del centro no se dibuja: se traza. Es letra cursiva y la
 * tabla del método es explícita —clusters compactos de arte fija se trazan con
 * `glyphs.mjs`, no se reconstruyen a ojo—; el propio extractor lo dice midiendo
 * que las reconstrucciones «conservan el peso visual y la silueta» y ahí se
 * quedan.
 *
 * Los archivos salen con `viewBox="0 0 w*8 h*8"` porque el trazador sobremuestrea
 * ×8, así que se pegan con `scale(0.125)` y quedan en unidades de lámina. Se leen
 * en tiempo de build y no se transcriben a mano: son 16 KB de `d` y copiarlos es
 * una fuente de error sin ninguna ventaja.
 *
 * La colocación va en un `<g>` que ENVUELVE, y no en un `transform` por `<path>`.
 * vtracer ya emite su propio `transform="translate(...)"` en cada path, así que
 * agregarle un segundo atributo del mismo nombre no compone las dos: el parser se
 * queda con uno y tira el otro. Hecho así los glifos salieron a una fracción de
 * su tamaño y la región subió de 7,386 % a 7,409 %.
 */
const RAIZ = join(process.cwd(), "scripts", "lamina", "glyphs", "u10-commons");
const trazo = (carpeta: string, id: string, x: number, y: number) =>
  `<g transform="translate(${x} ${y}) scale(0.125)">` +
  readFileSync(join(RAIZ, carpeta, `${id}.svg`), "utf8")
    .replace(/[\s\S]*?<svg[^>]*>/, "")
    .replace(/<\/svg>\s*$/, "")
    .replace(/\sfill="[^"]*"/g, "") +
  "</g>";

/* Las cuatro piezas legibles del bloque, con la caja que devolvió el manifiesto.
   Se dejan fuera `mano-a/g03`, `mano-b/g01` y `mano-b/g04`: son motas del campo
   que pasaron el umbral, no escritura, y pintarlas con la tinta de la escritura
   sería ponerles un color que no tienen. */
const manoA = ["g01", "g02"].map((id, i) => trazo("mano-a", id, [445, 460][i], [420, 416][i])).join("");
const manoB = ["g02", "g03"].map((id, i) => trazo("mano-b", id, [463, 473][i], [460, 460][i])).join("");
---

