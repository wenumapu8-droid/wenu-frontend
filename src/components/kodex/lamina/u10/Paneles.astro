---
/**
 * KODEX-∞ · u10-commons · PANELES LATERALES
 *
 * Marcos y textos de los paneles laterales, dibujados sobre el campo estelar.
 * Los paneles son transparentes; el héroe procedural se ve por detrás.
 *
 * LOS PANELES DE u10 NO LLEVAN MARCO (medido 2026-08-14). Se dibujaban ocho
 * `u10p-caja`, un rectángulo completo por panel, y la referencia no tiene
 * ninguno: barriendo `reference/canon/u10-commons.png` fila por fila, en las
 * dos columnas laterales hay CERO filas con tinta continua de 150 px o más,
 * mientras que el render tenía ocho, todas de 349 px exactos —los bordes
 * superior e inferior de los cuatro marcos de cada lado— en y=15, 279, 310,
 * 574, 605, 792, 823 y 1061 de la región.
 *
 * A `stroke-opacity: .14` el marco parecía inofensivo a ojo, y el banco lo
 * cobraba en las dos regiones a la vez: es tinta puesta donde la referencia no
 * tiene nada, y encima larga. Los ángulos de esquina (`u10p-esq`) SÍ se quedan:
 * son tramos de 12 px y no aparecen en ese barrido.
 *
 * La lámina no tiene paneles enmarcados: tiene un campo abierto con marcas
 * sueltas y texto encima.
 */
---

<div data-bloque="Paneles" style="inset:0">
  <svg class="u10p" viewBox="0 0 1122 1402" width="1122" height="1402" aria-hidden="true">
    <!-- Los dos bloques de prosa de la columna izquierda. Faltaban ENTEROS: el
         barrido de bloques de texto entre x=85 y x=225, con el campo estelar
         apagado para no contaminar la medicion, da seis bloques en la referencia
         -256-353, 451-569, 599-705, 736-857, 904-985, 1052-1198- y solo cuatro en
         el build. Estos son los dos que no estaban.
         Lineas de base medidas fila por fila: 263, 284, 304 y 325 el primero;
         464, 483 y 503 el segundo. El interlineado da ~20 px en los dos, igual
         que el de los paneles. -->
    <g>
      <text class="u10p-txt" x="88" y="263">THE COMMONS IS A LIVING</text>
      <text class="u10p-txt" x="88" y="284">RECORD OF RETURN.</text>
      <text class="u10p-txt" x="88" y="304">EVERY TRACE IS A GIFT.</text>
      <text class="u10p-txt" x="88" y="325">EVERY GIFT, A LIGHT.</text>
    </g>
    <g>
      <text class="u10p-txt" x="88" y="464">WE RETURNED.</text>
      <text class="u10p-txt" x="88" y="483">WE REMEMBER.</text>
      <text class="u10p-txt" x="88" y="503">WE REWRITE.</text>
    </g>

    <!-- Subrayados de la columna izquierda. Medidos sobre la referencia con
         umbral 9: tres reglas en y=582, 736 y 886, de x=87 a x=219, con
         luminancia media 21,3 sobre tinta de 212,7 — o sea opacidad 0,100.
         No son cajas: barriendo la columna entera no hay una sola vertical de
         40 px o mas a esa altura. La referencia subraya, no encierra. -->
    <g class="u10p-regla">
      <path d="M87.5 582.5H219.5" />
      <path d="M87.5 736.5H219.5" />
      <path d="M87.5 886.5H219.5" />
    </g>

    <!-- Izquierda: WRITE -->
    <g>
      <text class="u10p-hdr" x="88" y="613" textLength="50" lengthAdjust="spacing">WRITE</text>
      <text class="u10p-txt" x="88" y="641" textLength="158" lengthAdjust="spacing">LEAVE A MESSAGE</text>
      <text class="u10p-txt" x="88" y="660" textLength="108" lengthAdjust="spacing">FOR THOSE</text>
      <text class="u10p-txt" x="88" y="678" textLength="134" lengthAdjust="spacing">WHO COME NEXT.</text>
      <!-- icono lápiz -->
      <path class="u10p-ico" d="M380 595l14 14M380 595l4 -4 14 14 -4 4M384 591l-8 22 8 -6" />
    </g>

    <!-- Izquierda: DRAW -->
    <g>
      <text class="u10p-hdr" x="88" y="768" textLength="46" lengthAdjust="spacing">DRAW</text>
      <text class="u10p-txt" x="88" y="796" textLength="120" lengthAdjust="spacing">LEAVE A MARK</text>
      <text class="u10p-txt" x="88" y="815" textLength="150" lengthAdjust="spacing">SKETCH AN INSIGHT</text>
      <text class="u10p-txt" x="88" y="834" textLength="134" lengthAdjust="spacing">SHARE A SYMBOL.</text>
      <!-- icono rombo -->
      <path class="u10p-ico" d="M387 755l10 10l-10 10l-10 -10Z" />
    </g>

    <!-- Izquierda: OBSERVE -->
    <g>
      <text class="u10p-hdr" x="88" y="919" textLength="72" lengthAdjust="spacing">OBSERVE</text>
      <text class="u10p-txt" x="88" y="946" textLength="164" lengthAdjust="spacing">WITNESS WITHOUT</text>
      <text class="u10p-txt" x="88" y="966" textLength="98" lengthAdjust="spacing">ALTERING.</text>
      <text class="u10p-txt" x="88" y="985" textLength="120" lengthAdjust="spacing">SEE WITH SOUL.</text>
      <!-- icono ojo -->
      <g class="u10p-ico" transform="translate(380 911)">
        <ellipse cx="0" cy="0" rx="14" ry="8" />
        <circle cx="0" cy="0" r="4" />
      </g>
    </g>

    <!-- Izquierda: FIELD CONDITIONS -->
    <g>
      <path class="u10p-esq" d="M69.5 1059.5V1047.5H81.5M405.5 1047.5H417.5V1059.5M417.5 1273.5V1285.5H405.5M81.5 1285.5H69.5V1273.5" />
      <text class="u10p-hdr" x="88" y="1086" textLength="134" lengthAdjust="spacing">FIELD CONDITIONS</text>
      <text class="u10p-txt" x="88" y="1118" textLength="258" lengthAdjust="spacing">COHERENCE ............ 92.1%</text>
      <text class="u10p-txt" x="88" y="1140" textLength="210" lengthAdjust="spacing">DENSITY ............... HIGH</text>
      <text class="u10p-txt" x="88" y="1162" textLength="220" lengthAdjust="spacing">FLUX ................. STABLE</text>
      <text class="u10p-txt" x="88" y="1184" textLength="248" lengthAdjust="spacing">HARMONIC RESONANCE ... ACTIVE</text>
      <text class="u10p-txt" x="88" y="1206" textLength="256" lengthAdjust="spacing">EMPATHIC BANDWIDTH ... OPEN</text>
      <text class="u10p-txt" x="88" y="1228" textLength="226" lengthAdjust="spacing">ACCESS ............... PUBLIC</text>
    </g>

    <!-- Derecha: CONSENT -->
    <g>
      <path class="u10p-esq" d="M696.5 251.5V239.5H708.5M1032.5 239.5H1044.5V251.5M1044.5 491.5V503.5H1032.5M708.5 503.5H696.5V491.5" />
      <text class="u10p-hdr" x="715" y="278" textLength="62" lengthAdjust="spacing">CONSENT</text>
      <text class="u10p-txt" x="715" y="305" textLength="122" lengthAdjust="spacing">SHARE ONLY WHAT</text>
      <text class="u10p-txt" x="715" y="325" textLength="92" lengthAdjust="spacing">YOU WISH.</text>
      <text class="u10p-txt" x="715" y="345" textLength="140" lengthAdjust="spacing">RESPECT EVERY</text>
      <text class="u10p-txt" x="715" y="365" textLength="92" lengthAdjust="spacing">BOUNDARY.</text>
      <!-- icono mano -->
      <path class="u10p-ico" d="M1005 270c0 0 -6 -8 -6 -14c0 -4 2 -7 5 -7s5 3 5 7v12M1009 268v-18c0 -4 2 -7 5 -7s5 3 5 7v16M1013 270v-14c0 -4 2 -6 5 -6s4 2 4 6v20M1017 272v-10c0 -3 2 -5 4 -5s4 2 4 5v24" />
    </g>

    <!-- Derecha: panel medio (vacío en v1) -->
    <g>
      <path class="u10p-esq" d="M696.5 546.5V534.5H708.5M1032.5 534.5H1044.5V546.5M1044.5 786.5V798.5H1032.5M708.5 798.5H696.5V786.5" />
    </g>

    <!-- Derecha: SYSTEM NOTICE -->
    <g>
      <path class="u10p-esq" d="M696.5 841.5V829.5H708.5M1032.5 829.5H1044.5V841.5M1044.5 1004.5V1016.5H1032.5M708.5 1016.5H696.5V1004.5" />
      <text class="u10p-hdr" x="715" y="868" textLength="118" lengthAdjust="spacing">SYSTEM NOTICE</text>
      <text class="u10p-txt" x="715" y="895" textLength="158" lengthAdjust="spacing">THIS SURFACE IS</text>
      <text class="u10p-txt" x="715" y="915" textLength="158" lengthAdjust="spacing">A MIRROR, NOT A MAP.</text>
      <text class="u10p-txt" x="715" y="935" textLength="140" lengthAdjust="spacing">YOU ARE FREE TO ADD.</text>
      <text class="u10p-txt" x="715" y="955" textLength="136" lengthAdjust="spacing">YOU ARE FREE TO REST.</text>
      <text class="u10p-txt" x="715" y="975" textLength="134" lengthAdjust="spacing">YOU ARE FREE TO BE.</text>
      <!-- icono corazón -->
      <path class="u10p-ico" d="M1005 880c-6 -6 -14 -2 -14 4c0 8 14 18 14 18s14 -10 14 -18c0 -6 -8 -10 -14 -4Z" />
    </g>

    <!-- Derecha: panel inferior (vacío en v1) -->
    <g>
      <path class="u10p-esq" d="M696.5 1059.5V1047.5H708.5M1032.5 1047.5H1044.5V1059.5M1044.5 1273.5V1285.5H1032.5M708.5 1285.5H696.5V1273.5" />
    </g>

    <!-- Centro inferior: PUBLIC TRACE -->
    <text class="u10p-hdr" x="561" y="1240" text-anchor="middle" textLength="116" lengthAdjust="spacing">PUBLIC TRACE</text>
    <text class="u10p-txt" x="561" y="1265" text-anchor="middle" textLength="212" lengthAdjust="spacing">EVERY TRACE IS REAL.</text>
    <text class="u10p-txt" x="561" y="1283" text-anchor="middle" textLength="226" lengthAdjust="spacing">EVERY BEING IS SEEN.</text>
    <text class="u10p-txt" x="561" y="1301" text-anchor="middle" textLength="210" lengthAdjust="spacing">EVERY RETURN MATTERS.</text>
  </svg>
</div>

<style is:global>
  .u10p {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .u10p text {
    font-family: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
    font-variant-ligatures: none;
    white-space: pre;
  }
  .u10p-caja { fill: none; stroke: #d8d4d0; stroke-width: 1; stroke-opacity: 0.14; }
  .u10p-esq { fill: none; stroke: #d8d4d0; stroke-width: 1; stroke-opacity: 0.28; }
  .u10p-regla { fill: none; stroke: #d8d4d0; stroke-width: 1; stroke-opacity: 0.1; }
  .u10p-hdr { font-size: 11.5px; fill: #b18ae0; fill-opacity: 0.62; }
  .u10p-txt { font-size: 9.5px; fill: #d8d4d0; fill-opacity: 0.45; }
  .u10p-ico { fill: none; stroke: #b18ae0; stroke-width: 1; stroke-opacity: 0.5; }
</style>
