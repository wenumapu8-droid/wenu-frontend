      <text class="u10p-txt" x="88" y="1118" textLength="258" lengthAdjust="spacing">COHERENCE ............ 92.1%</text>
      <text class="u10p-txt" x="88" y="1140" textLength="210" lengthAdjust="spacing">DENSITY ............... HIGH</text>
