---
/**
 * KODEX-∞ · u10-commons · HÉROE
 *
 * Campo estelar radial procedural que cubre el cuerpo de la lámina
 * (x 0..1122, y 224..1301). Los paneles laterales se dibujan encima.
 */
---

<div data-bloque="Heroe" style="left:0;top:224px;width:1122px;height:1077px">
  <canvas data-capa="fondo" width="1122" height="1077" aria-hidden="true"></canvas>
  <canvas data-capa="vivo" width="1122" height="1077" aria-hidden="true"></canvas>
</div>

<style>
  [data-bloque="Heroe"] { pointer-events: none; }
  [data-bloque="Heroe"] canvas {
    position: absolute;
    left: 0;
    top: 0;
    width: 1122px;
    height: 1077px;
  }
</style>

<script>
  const raiz = document.querySelector('[data-bloque="Heroe"]');
  if (raiz) {
    const W = 1122;
    const H = 1077;
    const TAU = Math.PI * 2;
    const CX = W / 2;
    const CY = H / 2;

    function azar(semilla) {
      let a = semilla >>> 0;
      return () => {
        a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    function preparar(cv) {
      cv.width = Math.round(W * dpr);
      cv.height = Math.round(H * dpr);
      const g = cv.getContext("2d");
      g.setTransform(dpr, 0, 0, dpr, 0, 0);
      g.lineCap = "round";
      g.lineJoin = "round";
      return g;
    }
    const gf = preparar(raiz.querySelector('[data-capa="fondo"]'));
    const gv = preparar(raiz.querySelector('[data-capa="vivo"]'));

    const VIO = "182,142,222";
    const CAL = "224,188,158";
    const NUC = "248,240,250";
    const AQUA = "140,200,210";
    const ROSA = "220,140,180";
    const tinta = (c, a) => "rgba(" + c + "," + a + ")";

    function espiral(g, cx, cy, rr, brazos, vueltas, alfa) {
      g.save();
      g.translate(cx, cy);
      g.strokeStyle = tinta(VIO, alfa);
      g.lineWidth = 0.7;
      for (let b = 0; b < brazos; b++) {
        g.beginPath();
        const off = (b / brazos) * TAU;
        for (let s = 0; s <= 160; s++) {
          const t = (s / 160) * vueltas * TAU;
          const r = 2 + (rr * s) / 160;
          const a = off + t;
          const x = r * Math.cos(a);
          const y = r * Math.sin(a) * 0.65;
          if (s === 0) g.moveTo(x, y);
          else g.lineTo(x, y);
        }
        g.stroke();
      }
      g.restore();
    }

    function flor(g, cx, cy, R, n, alfa) {
      g.save();
      g.translate(cx, cy);
      g.strokeStyle = tinta(VIO, alfa);
      g.lineWidth = 0.7;
      for (let k = 0; k < n; k++) {
        const a = (k / n) * TAU;
        g.beginPath();
        g.moveTo(0, 0);
        g.lineTo(R * Math.cos(a), R * Math.sin(a));
        g.stroke();
        g.beginPath();
        g.arc(R * Math.cos(a), R * Math.sin(a), R * 0.16, 0, TAU);
        g.stroke();
      }
      g.beginPath();
      g.arc(0, 0, R * 0.22, 0, TAU);
      g.stroke();
      g.restore();
    }

    function corazon(g, cx, cy, R, alfa) {
      g.save();
      g.translate(cx, cy);
      g.strokeStyle = tinta(ROSA, alfa);
      g.lineWidth = 1;
      g.beginPath();
      for (let i = 0; i <= 64; i++) {
        const t = (i / 64) * TAU;
        const x = R * 16 * Math.pow(Math.sin(t), 3) / 16;
        const y = -R * (13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t)) / 16;
        if (i === 0) g.moveTo(x, y);
        else g.lineTo(x, y);
      }
      g.closePath();
      g.stroke();
      g.restore();
    }

    function lemniscata(g, cx, cy, a, b, alfa) {
      g.save();
      g.translate(cx, cy);
      g.strokeStyle = tinta(NUC, alfa);
      g.lineWidth = 1.2;
      g.beginPath();
      for (let i = 0; i <= 96; i++) {
        const t = (i / 96) * TAU;
        const x = a * Math.cos(t);
        const y = (b / 2) * Math.sin(2 * t);
        if (i === 0) g.moveTo(x, y);
        else g.lineTo(x, y);
      }
      g.closePath();
      g.stroke();
      g.restore();
    }

    function anillos(g, cx, cy, rads, alfa) {
      g.save();
      g.translate(cx, cy);
      g.strokeStyle = tinta(VIO, alfa);
      g.lineWidth = 0.6;
      for (const r of rads) {
        g.beginPath();
        g.arc(0, 0, r, 0, TAU);
        g.stroke();
      }
      g.restore();
    }

    function radios(g, cx, cy, R, n, alfa) {
      g.save();
      g.translate(cx, cy);
      g.strokeStyle = tinta(VIO, alfa);
      g.lineWidth = 0.5;
      for (let k = 0; k < n; k++) {
        const a = (k / n) * TAU;
        g.beginPath();
        g.moveTo(0, 0);
        g.lineTo(R * Math.cos(a), R * Math.sin(a));
        g.stroke();
      }
      g.restore();
    }

    function organismo(g, cx, cy, R, alfa) {
      g.save();
      g.translate(cx, cy);
      g.strokeStyle = tinta(VIO, alfa);
      g.lineWidth = 0.9;

      /* Anillos concéntricos medidos sobre el cluster #1. */
      const rads = [16, 30, 46, 62, 78, 92];
      for (const r of rads) {
        g.beginPath();
        g.arc(0, 0, r, 0, TAU);
        g.stroke();
      }

      /* Radios desde el centro, más densos. */
      const nRadios = 24;
      for (let k = 0; k < nRadios; k++) {
        const a = (k / nRadios) * TAU;
        g.beginPath();
        g.moveTo(0, 0);
        g.lineTo(R * Math.cos(a), R * Math.sin(a));
        g.stroke();
      }

      /* Nodos en tres niveles del radio. */
      g.fillStyle = tinta(NUC, alfa * 1.2);
      for (let k = 0; k < nRadios; k++) {
        const a = (k / nRadios) * TAU;
        for (const rr of [0.30, 0.55, 0.80]) {
          g.beginPath();
          g.arc(R * rr * Math.cos(a), R * rr * Math.sin(a), 1.6, 0, TAU);
          g.fill();
        }
      }

      /* Red de constelación entre nodos exteriores. */
      g.lineWidth = 0.55;
      g.strokeStyle = tinta(VIO, alfa * 0.8);
      const puntos = [];
      const re = azar(0x1030);
      for (let k = 0; k < 36; k++) {
        const a = (k / 36) * TAU + re() * 0.3;
        const rr = R * (0.35 + 0.58 * re());
        puntos.push({ x: rr * Math.cos(a), y: rr * Math.sin(a) });
      }
      for (let i = 0; i < puntos.length; i++) {
        for (let j = i + 1; j < puntos.length; j++) {
          const dx = puntos[i].x - puntos[j].x;
          const dy = puntos[i].y - puntos[j].y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < R * 0.45 && d > R * 0.12) {
            g.beginPath();
            g.moveTo(puntos[i].x, puntos[i].y);
            g.lineTo(puntos[j].x, puntos[j].y);
            g.stroke();
          }
        }
      }

      g.restore();
    }

    function pintarFondo(g) {
      const r = azar(0x1000);
      g.clearRect(0, 0, W, H);
      g.save();
      g.globalCompositeOperation = "lighter";

      const grd = g.createRadialGradient(CX, CY, 0, CX, CY, Math.max(W, H) * 0.6);
      grd.addColorStop(0, tinta(VIO, 0.05));
      grd.addColorStop(0.5, tinta(VIO, 0.025));
      grd.addColorStop(1, tinta(VIO, 0));
      g.fillStyle = grd;
      g.fillRect(0, 0, W, H);

      for (let k = 0; k < 2600; k++) {
        const rr = Math.sqrt(r());
        const a = r() * TAU;
        const x = CX + rr * (W / 2 - 8) * Math.cos(a);
        const y = CY + rr * (H / 2 - 8) * Math.sin(a);
        const op = 0.04 + r() * 0.28;
        const s = 0.25 + r() * 0.9;
        const col = r() < 0.82 ? VIO : (r() < 0.92 ? CAL : AQUA);
        g.fillStyle = tinta(col, op);
        g.beginPath();
        g.arc(x, y, s, 0, TAU);
        g.fill();
      }

      const estrellas = [];
      const re = azar(0x1010);
      for (let k = 0; k < 220; k++) {
        const rr = Math.sqrt(re());
        const a = re() * TAU;
        estrellas.push({
          x: CX + rr * (W / 2 - 30) * Math.cos(a),
          y: CY + rr * (H / 2 - 30) * Math.sin(a),
          r: 1 + re() * 2.2,
          br: re(),
        });
      }
      g.strokeStyle = tinta(VIO, 0.08);
      g.lineWidth = 0.5;
      for (let i = 0; i < estrellas.length; i++) {
        for (let j = i + 1; j < estrellas.length; j++) {
          const dx = estrellas[i].x - estrellas[j].x;
          const dy = estrellas[i].y - estrellas[j].y;
          if (dx * dx + dy * dy < 3600) {
            g.beginPath();
            g.moveTo(estrellas[i].x, estrellas[i].y);
            g.lineTo(estrellas[j].x, estrellas[j].y);
            g.stroke();
          }
        }
      }
      for (const e of estrellas) {
        g.fillStyle = tinta(e.br > 0.75 ? NUC : VIO, 0.3 + e.br * 0.5);
        g.beginPath();
        g.arc(e.x, e.y, e.r, 0, TAU);
        g.fill();
      }

      /* Estructura central: anillos y radios. */
      anillos(g, CX, CY, [30, 55, 85, 120, 160, 200, 250, 310], 0.14);
      radios(g, CX, CY, 340, 24, 0.10);
      anillos(g, CX, CY, [8, 14], 0.35);

      /* Organismo #1 del hero-center, medido en (530,547) con R≈92. */
      organismo(g, 530, 547, 92, 0.32);

      /* Corazón arriba. */
      corazon(g, CX, CY - 360, 10, 0.35);
      corazon(g, CX, CY - 360, 6, 0.25);

      /* ∞ abajo. */
      lemniscata(g, CX, CY + 320, 22, 16, 0.45);
      anillos(g, CX, CY + 320, [35, 50, 65], 0.16);

      /* Flores y espirales. */
      const rc = azar(0x1020);
      const objetos = [
        { x: 0.43, y: 0.21, tipo: "espiral", r: 38 },
        { x: 0.56, y: 0.34, tipo: "flor", r: 28, n: 8 },
        { x: 0.50, y: 0.12, tipo: "flor", r: 24, n: 10 },
        { x: 0.47, y: 0.51, tipo: "espiral", r: 34 },
        { x: 0.57, y: 0.71, tipo: "torre", r: 32 },
        { x: 0.35, y: 0.55, tipo: "flor", r: 22, n: 12 },
        { x: 0.68, y: 0.48, tipo: "flor", r: 20, n: 6 },
      ];
      for (const o of objetos) {
        const x = o.x * W;
        const y = o.y * H;
        if (o.tipo === "espiral") espiral(g, x, y, o.r, 3, 1.8, 0.16 + rc() * 0.08);
        else if (o.tipo === "flor") flor(g, x, y, o.r, o.n, 0.14 + rc() * 0.06);
        else if (o.tipo === "torre") {
          g.strokeStyle = tinta(VIO, 0.16);
          g.lineWidth = 0.7;
          g.beginPath();
          g.moveTo(x, y - o.r);
          g.lineTo(x, y + o.r);
          g.stroke();
          for (let k = -2; k <= 2; k++) {
            g.beginPath();
            g.ellipse(x, y + k * o.r * 0.28, o.r * 0.35, o.r * 0.1, 0, 0, TAU);
            g.stroke();
          }
        }
      }

      g.restore();
    }

    function pintarVivo(g, fase) {
      g.clearRect(0, 0, W, H);
      g.save();
      g.globalCompositeOperation = "lighter";
      const lat = 0.78 + 0.22 * Math.sin(fase * TAU * 3);
      const halo = g.createRadialGradient(CX, CY, 0, CX, CY, 90);
      halo.addColorStop(0, tinta(NUC, 0.22 * lat));
      halo.addColorStop(0.4, tinta(VIO, 0.10 * lat));
      halo.addColorStop(1, tinta(VIO, 0));
      g.fillStyle = halo;
      g.beginPath();
      g.arc(CX, CY, 90, 0, TAU);
      g.fill();
      g.fillStyle = tinta(NUC, 0.9 * lat);
      g.beginPath();
      g.arc(CX, CY, 3, 0, TAU);
      g.fill();
      g.restore();
    }

    pintarFondo(gf);
    const reducido = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const PERIODO = reducido ? 42000 : 12000;
    const faseDe = (ms) => {
      const f = (ms / PERIODO) % 1;
      return f < 0 ? f + 1 : f;
    };
    const cuadro = (fase) => pintarVivo(gv, fase);
    cuadro(0);

    let corriendo = 0;
    let detenido = true;
    const parar = () => {
      detenido = true;
      if (corriendo) cancelAnimationFrame(corriendo);
      corriendo = 0;
    };
    let congelado = false;
    let visible = false;
    const arrancar = () => {
      if (corriendo || congelado || !visible || document.hidden) return;
      detenido = false;
      const t0 = performance.now();
      const paso = (ahora) => {
        if (detenido) return;
        cuadro(faseDe(ahora - t0));
        corriendo = requestAnimationFrame(paso);
      };
      corriendo = requestAnimationFrame(paso);
    };
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        (es) => {
          visible = es.some((e) => e.isIntersecting);
          visible ? arrancar() : parar();
        },
        { threshold: 0 },
      ).observe(raiz);
    } else {
      visible = true;
      arrancar();
    }
    document.addEventListener("visibilitychange", () => {
      document.hidden ? parar() : arrancar();
    });

    const sumidero = (t = 0) => {
      congelado = true;
      parar();
      cuadro(faseDe(typeof t === "number" ? t * 1000 : 0));
    };
    const bolsa = (window.__kdxSumideros = window.__kdxSumideros || []);
    bolsa.push(sumidero);
    const propio = (fn) => bolsa.push(fn);
    const congelar = (t = 0) => {
      for (const fn of bolsa.slice()) fn(t);
      document.documentElement.dataset.kdxFrozen = "1";
    };
    let intentos = 0;
    const registrar = () => {
      const reg = window.__kdxRegisterFreeze;
      if (typeof reg === "function" && reg !== propio) {
        reg(sumidero);
        return;
      }
      if (typeof reg !== "function") window.__kdxRegisterFreeze = propio;
      if (typeof window.__kdxFreeze !== "function") window.__kdxFreeze = congelar;
      if (intentos++ < 120) requestAnimationFrame(registrar);
    };
    registrar();
  }
</script>
