---
/**
 * KODEX-∞ · u02-threshold · CABECERA
 *
 * Franja superior (y=0..265, ancho completo) + los dos rieles verticales que
 * corren de canto a canto. Todo trazado en SVG por código: ni un bitmap.
 *
 * El cromo lo pone `serie-universe/CabeceraUniverse.astro`. Los valores por
 * defecto de ese componente SON los de esta lámina —fue la primera de la serie
 * y de acá salieron las otras cuatro—, así que este archivo no pisa ninguna
 * variable de calibrado: sólo la paleta, que nunca puede ser implícita.
 *
 * Ninguna coordenada de acá está estimada a ojo. Salieron de barrer
 * `reference/canon/u02-threshold.png` (1122×1402) fila por fila y columna por
 * columna con un umbral de luminancia, y quedan anotadas donde importan:
 *
 *  · marco exterior — vertical izq x=13, der x=1107; regla superior y=12,
 *    inferior y=1389. Las cuatro esquinas NO son en ángulo recto: son un chaflán
 *    a 45° de 14 px (13,26)→(30,12) arriba a la izquierda y sus tres espejos.
 *  · regla superior — tinta de "KODEX-∞ UNIVERSE" en x=65..249 y de
 *    "OBSERVE. DECIPHER. TRANSCEND." en x=804..1058, ambas con altura de
 *    versal 9 px (y=39..47). El tracking NO es el mismo en las dos: la
 *    izquierda avanza 11,7 px por carácter y la derecha 9,0. Se ve midiendo.
 *  · hexágono — de vértice arriba, centro (561,5 · 41,5), lados verticales en
 *    x=538 y x=585 entre y=30 e y=53, vértices en y=17 e y=66.
 *  · título — y acá está el hallazgo que costaba caro descubrir tarde:
 *    KODEX-∞ y THRESHOLD **no tienen el mismo cuerpo**. La versal de KODEX
 *    mide 55 px (y=112..166) y la de THRESHOLD 50 (y=114..164), y además
 *    THRESHOLD viene condensado: su H mide 45 px de ancho contra los 55 que le
 *    tocarían por proporción. Componerlo con un solo <text> deja el segundo
 *    bloque desbordado o el primero enano.
 *
 * Los valores de `textLength` salen de la métrica real de Cormorant Garamond
 * leída de su propio archivo (unitsPerEm 1000, sCapHeight 625, lsb/rsb por
 * glifo), no de una estimación:
 *   KODEX     → cuerpo 55/0,625 = 88 px
 *   THRESHOLD → cuerpo 50/0,625 = 80 px, y `spacingAndGlyphs` para el condensado
 *
 * El marco interior de esta página NO lleva travesaño superior — se comprobó
 * midiendo la fila y=76, que tiene 44 px de tinta en 990 de ancho, no 990.
 */
import CabeceraUniverse from "../serie-universe/CabeceraUniverse.astro";
import { rayos, rombo } from "../serie-universe/geom";

/* ── marco exterior ─────────────────────────────────────────────────────── */
/* Las cuatro esquinas achaflanadas, en sentido horario desde arriba a la
   izquierda. El chaflán mide 14 px medidos sobre la diagonal. */
const chaflanes = [
  "M13.5 26.5L30 12.5",
  "M1094 12.5L1106.5 26.5",
  "M1106.5 1375.5L1094 1389.5",
  "M27.5 1389.5L13.5 1375.5",
];

/* Los rieles no son una línea continua: alternan tramos macizos y tramos de
   puntos, y los tramos de puntos caen en zonas distintas a izquierda y derecha.
   [y0, y1, macizo?] — medido segmento por segmento sobre la referencia. */
const rielIzq: [number, number, boolean][] = [
  [43, 75, true], [120, 197, false], [261, 276, true], [427, 771, true],
  [956, 1187, true], [1214, 1314, false], [1319, 1365, true],
];
const rielDer: [number, number, boolean][] = [
  [43, 75, true], [128, 182, false], [459, 704, true], [723, 791, true],
  [831, 990, true], [1235, 1314, false], [1327, 1377, true],
];

/* ── glifos de riel ─────────────────────────────────────────────────────── */
/* Columna izquierda: dos racimos, uno alto (y=286..398) y otro bajo
   (y=783..950). El eje de la columna es x=13,5, el mismo del marco. */
const EJE_I = 13.5;
const EJE_D = 1106.5;

const puntosIzq = [287, 397.5, 783.5, 830, 845.5, 949.5];
const puntosDer = [794.5, 832.5, 574.5, 586.5, 625];

/* Micropunteado suelto entre glifo y glifo (no es el riel, es más corto y más
   tenue): [y0, y1] de cada tramo. */
const micropunteo: [number, number][] = [[328, 338], [834, 841]];

/* La paleta se declara acá y no en el componente compartido porque NO es
   común a la serie: u02 es violeta de punta a punta y u01, por ejemplo, es
   gris cálido con acento. Está medido. */
const vars = "--cb-ink:#cfc6e8;--cb-vio:#a77cf0;--cb-tit:#d8d3e6";
---

<CabeceraUniverse
  gradId="u02"
  grad={["#e9e5f3", "#d8d3e6", "#b0a9c4"]}
  ariaLabel="KODEX-∞ / THRESHOLD — página 02 · The first consequence · This is the obligatory common threshold."
  vars={vars}
  marcoSup="M31 12.5H502M620 12.5H1084"
  marcoInf={{ d: "M31 1389.5H1084", dash: "11 4.5" }}
  fantasma="M13.5 26.5V1375.5M1106.5 26.5V1375.5"
  chaflanes={chaflanes}
  nodosSup={[{ x: 509.5, y: 12.5 }, { x: 613.5, y: 12.5 }]}
  interior="M55.5 64V1253M1063.5 64V1253"
  interiorEsq="M55.5 76.5H89.5M1063.5 76.5H1029.5"
  cruces={[[40, 43.5], [1082, 43.5]]}
  reglaIzq={{ x: 64, y: 47.5, len: 186.5, t: "KODEX-∞ UNIVERSE" }}
  reglaDer={{ x: 803, y: 47.5, len: 256.5, t: "OBSERVE. DECIPHER. TRANSCEND." }}
  reglaCy={43.5}
  puntosRegla={[272, 332, 347]}
  nodosRegla={[516, 607, 780]}
  punteo={{ d: "M378 43.5H494M631 43.5H773", dash: "17 3" }}
  hex={{
    borde: "M561.5 17L585.5 30V53L561.5 66L537.5 53V30Z",
    tics: "M538 28.5h4M581 28.5h4M538 54.5h4M581 54.5h4",
    tallo: "M561.5 65.5V71",
    inf: [561.5, 42, 12.95, 10.4],
  }}
  titKodex={{ x: 87.7, y: 166.5, size: 88, len: 319, t: "KODEX" }}
  titGuion={{ x: 411, y: 139, w: 25, h: 3.8 }}
  titInf={[487.5, 141, 31.4, 25.8]}
  titBarra="M573.5 111L578 111L560.5 167L556 167Z"
  titPalabra={{ x: 604.25, y: 164.5, size: 80, len: 432.4, t: "THRESHOLD" }}
  sig={{ x: 89, y: 212.5, len: 74.5, t: "A / -∞" }}
  lema={{ x: 362, y: 210.5, len: 396.5, t: "THE FIRST CONSEQUENCE" }}
  pag={{ x: 967, y: 212.5, len: 64.5, t: "PAGE 02" }}
  ejeI={EJE_I}
  ejeD={EJE_D}
  rielIzq={rielIzq}
  rielDer={rielDer}
  nodosIzq={puntosIzq}
  nodosDer={puntosDer}
  micropunteo={micropunteo}
  micro={[
    { transform: "translate(1103.6 399) rotate(-90)", len: 182, t: "XX XX PDX-02 / THRESHOLD XX" },
    { transform: "translate(11 950) rotate(-90)", len: 75, t: "XX KDX-U02 XX" },
  ]}
  folio={{ x: 1100.5, y: 610.5, len: 14.5, t: "02" }}
>
  <!-- Separadores de la bajada. Son simétricos respecto de x=561 y así están
       medidos: rombo en 274,5 / 847,5 y punto en 320 / 802. -->
  <g class="cab__sep" slot="sep">
    <path d={rombo(274.5, 204.5, 12, 9)} />
    <path d={rombo(847.5, 204.5, 12, 9)} />
    <path class="cab__punteo" d="M286 204.5H313M809 204.5H836" stroke-dasharray="9 4" />
    <circle class="cab__nodo-f" cx="320" cy="204.5" r="1.9" />
    <circle class="cab__nodo-f" cx="802" cy="204.5" r="1.9" />
  </g>

  <Fragment slot="nota">
    <g class="cab__nodo">
      <circle cx="349" cy="241" r="1.9" />
      <circle cx="756.5" cy="241" r="1.9" />
    </g>
    <text class="cab__nota" x="366" y="245.5" textLength="373.5" lengthAdjust="spacing">THIS IS THE OBLIGATORY COMMON THRESHOLD.</text>
  </Fragment>

  <g class="cab__glifo" slot="glifos">
    <!-- Riel izquierdo · racimo alto -->
    <circle cx={EJE_I} cy="304.5" r="4.7" />
    <path d="M8.8 315.5H18.2L13.5 322.2ZM13.5 322.2V325" />
    <path d={rayos(EJE_I, 347.5, 5, 8)} />
    <path d={rayos(EJE_I, 364, 3.4, 6, Math.PI / 2)} />
    <path d={rayos(EJE_I, 378.5, 4, 8, Math.PI / 8)} />
    <!-- Riel izquierdo · racimo bajo -->
    <path d={rayos(EJE_I, 799, 4, 6)} />
    <path d={rombo(EJE_I, 814.5, 12, 9)} />
    <circle cx={EJE_I} cy="814.5" r="1.6" />
    <!-- Riel derecho -->
    <path d="M1106.5 801L1111.6 803.5V808.5L1106.5 811L1101.4 808.5V803.5Z" />
    <path d={rayos(EJE_D, 806, 2.4, 4)} />
  </g>
</CabeceraUniverse>
