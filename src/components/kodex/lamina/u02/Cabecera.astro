---
/**
 * KODEX-∞ · u02-threshold · CABECERA
 *
 * Franja superior (y=0..265, ancho completo) + los dos rieles verticales que
 * corren de canto a canto. Todo trazado en SVG por código: ni un bitmap.
 *
 * Ninguna coordenada de acá está estimada a ojo. Salieron de barrer
 * `reference/canon/u02-threshold.png` (1122×1402) fila por fila y columna por
 * columna con un umbral de luminancia, y quedan anotadas donde importan:
 *
 *  · marco exterior — vertical izq x=13, der x=1107; regla superior y=12,
 *    inferior y=1389. Las cuatro esquinas NO son en ángulo recto: son un chaflán
 *    a 45° de 14 px (13,26)→(30,12) arriba a la izquierda y sus tres espejos.
 *  · regla superior — tinta de "KODEX-∞ UNIVERSE" en x=65..249 y de
 *    "OBSERVE. DECIPHER. TRANSCEND." en x=804..1058, ambas con altura de
 *    versal 9 px (y=39..47). El tracking NO es el mismo en las dos: la
 *    izquierda avanza 11,7 px por carácter y la derecha 9,0. Se ve midiendo.
 *  · hexágono — de vértice arriba, centro (561,5 · 41,5), lados verticales en
 *    x=538 y x=585 entre y=30 e y=53, vértices en y=17 e y=66.
 *  · título — y acá está el hallazgo que costaba caro descubrir tarde:
 *    KODEX-∞ y THRESHOLD **no tienen el mismo cuerpo**. La versal de KODEX
 *    mide 55 px (y=112..166) y la de THRESHOLD 50 (y=114..164), y además
 *    THRESHOLD viene condensado: su H mide 45 px de ancho contra los 55 que le
 *    tocarían por proporción. Componerlo con un solo <text> deja el segundo
 *    bloque desbordado o el primero enano.
 *
 * Por qué el texto va con `textLength` y no con `letter-spacing`: la mono y la
 * serif del póster no existen en ninguna máquina, así que la métrica del avance
 * no se puede heredar. `textLength` clava el extremo de tinta donde lo tiene la
 * referencia sea cual sea la fuente que resuelva. Los valores salen de la
 * métrica real de Cormorant Garamond 300 leída de su propio archivo
 * (unitsPerEm 1000, sCapHeight 625, lsb/rsb por glifo), no de una estimación:
 *   KODEX  → cuerpo 55/0,625 = 88 px
 *   THRESHOLD → cuerpo 50/0,625 = 80 px, y `spacingAndGlyphs` para el condensado
 *
 * Los símbolos ∞ del título y del hexágono van dibujados, no tipografiados: el
 * ∞ de Cormorant es un signo matemático de caja chica y con descendente, no la
 * lemniscata de exhibición del póster. Los ∞ de 9 px (regla y bajada) sí van
 * como carácter — a ese cuerpo la diferencia no se lee.
 *
 * Nada de esto usa Math.random(): las tramas de puntos y los glifos de riel son
 * listas explícitas y las estrellas salen de una función de rayos determinista.
 */
import "@fontsource/cormorant-garamond/300.css";
import "@fontsource/cormorant-garamond/400.css";

/* ── helpers de dibujo, todos deterministas ─────────────────────────────── */

/** Estrella de n rayos desde el centro. Es el glifo que más se repite en los
 *  rieles: aparece con 8, 6 y 4 puntas y distintos radios. */
const rayos = (cx: number, cy: number, r: number, n: number, fase = 0): string =>
  Array.from({ length: n }, (_, i) => {
    const a = fase + (i * Math.PI * 2) / n;
    return `M${cx} ${cy}L${(cx + r * Math.cos(a)).toFixed(2)} ${(cy + r * Math.sin(a)).toFixed(2)}`;
  }).join("");

/** Lemniscata de exhibición (curva de Gerono):
 *      x = a·cos t          y = (b/2)·sen 2t
 *  Se traza como UNA curva cerrada que se cruza a sí misma en el centro, y va
 *  contorneada, no rellena.
 *
 *  El primer intento fue montar dos anillos elípticos con fill-rule="evenodd"
 *  contando con que el solape se cancelara solo. No funciona y se ve al
 *  compararlo contra la referencia: da dos circunferencias apretadas con una
 *  costura vertical en el medio, no un cruce. El ∞ del póster cruza en
 *  diagonal, que es justo lo que una paramétrica sí produce y dos anillos no
 *  pueden producir nunca.
 *
 *  `a` es el semieje horizontal de la línea media y `b` la altura total de esa
 *  misma línea media: al ancho y alto de tinta medidos hay que descontarles el
 *  grosor del trazo antes de pasarlos acá. */
const lemniscata = (cx: number, cy: number, a: number, b: number, pasos = 96): string =>
  Array.from({ length: pasos }, (_, i) => {
    const t = (i / pasos) * Math.PI * 2;
    const x = (cx + a * Math.cos(t)).toFixed(2);
    const y = (cy + (b / 2) * Math.sin(2 * t)).toFixed(2);
    return `${i ? "L" : "M"}${x} ${y}`;
  }).join("") + "Z";

/** Rombo hueco de los separadores de la bajada (medido: 12 px de ancho por 9
 *  de alto, en y=204). */
const rombo = (cx: number, cy: number, w: number, h: number): string =>
  `M${cx} ${cy - h / 2}L${cx + w / 2} ${cy}L${cx} ${cy + h / 2}L${cx - w / 2} ${cy}Z`;

/* ── marco exterior ─────────────────────────────────────────────────────── */
/* Las cuatro esquinas achaflanadas, en sentido horario desde arriba a la
   izquierda. El chaflán mide 14 px medidos sobre la diagonal. */
const chaflanes = [
  "M13.5 26.5L30 12.5",
  "M1094 12.5L1106.5 26.5",
  "M1106.5 1375.5L1094 1389.5",
  "M27.5 1389.5L13.5 1375.5",
];

/* Los rieles no son una línea continua: alternan tramos macizos y tramos de
   puntos, y los tramos de puntos caen en zonas distintas a izquierda y derecha.
   [y0, y1, macizo?] — medido segmento por segmento sobre la referencia. */
const rielIzq: [number, number, boolean][] = [
  [43, 75, true], [120, 197, false], [261, 276, true], [427, 771, true],
  [956, 1187, true], [1214, 1314, false], [1319, 1365, true],
];
const rielDer: [number, number, boolean][] = [
  [43, 75, true], [128, 182, false], [459, 704, true], [723, 791, true],
  [831, 990, true], [1235, 1314, false], [1327, 1377, true],
];

/* ── glifos de riel ─────────────────────────────────────────────────────── */
/* Columna izquierda: dos racimos, uno alto (y=286..398) y otro bajo
   (y=783..950). El eje de la columna es x=13,5, el mismo del marco. */
const EJE_I = 13.5;
const EJE_D = 1106.5;

const puntosIzq = [287, 397.5, 783.5, 830, 845.5, 949.5];
const puntosDer = [794.5, 832.5, 574.5, 586.5, 625];

/* Micropunteado suelto entre glifo y glifo (no es el riel, es más corto y más
   tenue): [y0, y1] de cada tramo. */
const micropunteo: [number, number][] = [[328, 338], [834, 841]];

/* ── ruler superior ─────────────────────────────────────────────────────── */
/* Puntos sueltos que separan el logotipo de la regla punteada. */
const puntosRegla = [272, 332, 347];
/* Puntos brillantes que flanquean el hexágono y cierran la regla. */
const nodosRegla = [516, 607, 780];
---

<div data-bloque="Cabecera" style="inset:0">
  <svg
    class="cab"
    viewBox="0 0 1122 1402"
    width="1122"
    height="1402"
    role="img"
    aria-label="KODEX-∞ / THRESHOLD — página 02 · The first consequence · This is the obligatory common threshold."
  >
    <defs>
      <!-- El título de la referencia no es de tinta plana: pierde ~15 % de luz
           del hombro al pie de las astas. Un color plano lo deja acartonado. -->
      <linearGradient id="u02TitGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e9e5f3" />
        <stop offset="0.45" stop-color="#d8d3e6" />
        <stop offset="1" stop-color="#b0a9c4" />
      </linearGradient>
      <!-- Halo corto de los acentos violeta. En la referencia el ∞ del hexágono
           sangra ~2 px sobre el negro; sin halo queda recortado y muerto. -->
      <filter id="u02Halo" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="1.1" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>

    <!-- ═══ 1 · MARCO EXTERIOR ═══════════════════════════════════════════ -->
    <g class="cab__marco">
      <!-- Reglas horizontales. La superior se parte en dos para dejar pasar el
           hexágono (hueco medido x=503..611) y la inferior va punteada porque
           el pie del póster la interrumpe. -->
      <path d="M31 12.5H502M620 12.5H1084" />
      <path class="cab__marco--tenue" d="M31 1389.5H1084" stroke-dasharray="11 4.5" />
      <!-- Verticales de fondo: hilo continuo casi apagado, sobre el que después
           montan los tramos macizos y punteados. -->
      <path class="cab__marco--fantasma" d="M13.5 26.5V1375.5M1106.5 26.5V1375.5" />
      {chaflanes.map((d) => <path d={d} />)}
    </g>

    <!-- Los dos puntos que rematan la regla superior contra el hueco del hexágono. -->
    <g class="cab__nodo">
      <circle cx="509.5" cy="12.5" r="2" />
      <circle cx="613.5" cy="12.5" r="2" />
    </g>

    <!-- Marco interior: sólo se ve por sus verticales y por las dos escuadras
         en L de la boca. No lleva travesaño superior — se comprobó midiendo la
         fila y=76, que tiene 44 px de tinta en 990 de ancho, no 990. -->
    <g class="cab__interior">
      <path d="M55.5 64V1253M1063.5 64V1253" />
      <path class="cab__interior--esq" d="M55.5 76.5H89.5M1063.5 76.5H1029.5" />
    </g>

    <!-- ═══ 2 · REGLA SUPERIOR ═══════════════════════════════════════════ -->

    <!-- Cruces violeta de los extremos. Medidas: 7 px de ancho por 9 de alto,
         centradas en (40 · 43,5) y (1082 · 43,5). -->
    <g class="cab__cruz" filter="url(#u02Halo)">
      <path d="M40 39L41.3 42.2L44.5 43.5L41.3 44.8L40 48L38.7 44.8L35.5 43.5L38.7 42.2Z" />
      <path d="M1082 39L1083.3 42.2L1086.5 43.5L1083.3 44.8L1082 48L1080.7 44.8L1077.5 43.5L1080.7 42.2Z" />
    </g>

    <text class="cab__regla" x="64" y="47.5" textLength="186.5" lengthAdjust="spacing">KODEX-∞ UNIVERSE</text>
    <text class="cab__regla cab__regla--der" x="803" y="47.5" textLength="256.5" lengthAdjust="spacing">OBSERVE. DECIPHER. TRANSCEND.</text>

    <g class="cab__nodo">
      {puntosRegla.map((x) => <circle cx={x} cy="43.5" r="1.6" />)}
      {nodosRegla.map((x) => <circle cx={x} cy="43.5" r="2" />)}
    </g>

    <!-- Reglas punteadas que corren hacia el hexágono. Muy por debajo del brillo
         del texto: 34 de luminancia contra 160. -->
    <path class="cab__punteo" d="M378 43.5H494M631 43.5H773" stroke-dasharray="17 3" />

    <!-- Hexágono de vértice arriba + tallo. Los cuatro tics de los vértices
         laterales están en la referencia y son lo que le da el aire de
         instrumento; sin ellos el hexágono se lee como un simple polígono. -->
    <g class="cab__hex">
      <path class="cab__hex-borde" d="M561.5 17L585.5 30V53L561.5 66L537.5 53V30Z" />
      <path class="cab__hex-tic" d="M538 28.5h4M581 28.5h4M538 54.5h4M581 54.5h4" />
      <path class="cab__hex-tallo" d="M561.5 65.5V71" />
      <path class="cab__inf" filter="url(#u02Halo)" d={lemniscata(561.5, 42, 12.95, 10.4)} />
    </g>

    <!-- ═══ 3 · TÍTULO ═══════════════════════════════════════════════════ -->
    <g class="cab__titulo">
      <!-- KODEX — versal 55 px, línea de base y=166,5, tinta x=91..404. -->
      <text x="87.7" y="166.5" font-size="88" textLength="319" lengthAdjust="spacingAndGlyphs">KODEX</text>
      <!-- El guion va como figura: en la referencia mide 25×3,8 y se apoya en
           y=139, más alto y más corto que el guion tipográfico de Cormorant. -->
      <rect x="411" y="139" width="25" height="3.8" />
      <!-- ∞ de exhibición, x=454..521 · y=126..156. Contorneado, no relleno:
           el descuento del grosor del trazo ya está hecho en a y b. -->
      <path class="cab__tit-inf" d={lemniscata(487.5, 141, 31.4, 25.8)} />
      <!-- Barra: cuadrilátero de 4,5 px de canto, x=556..578 · y=111..167. -->
      <path d="M573.5 111L578 111L560.5 167L556 167Z" />
      <!-- THRESHOLD — versal 50 px, base y=164,5, y condensado al 93 % con
           spacingAndGlyphs para que la tinta cierre en x=1033. -->
      <text x="604.25" y="164.5" font-size="80" textLength="432.4" lengthAdjust="spacingAndGlyphs">THRESHOLD</text>
    </g>

    <!-- ═══ 4 · LÍNEA BAJO EL TÍTULO ═════════════════════════════════════ -->
    <text class="cab__sig" x="89" y="212.5" textLength="74.5" lengthAdjust="spacing">A / -∞</text>
    <text class="cab__lema" x="362" y="210.5" textLength="396.5" lengthAdjust="spacing">THE FIRST CONSEQUENCE</text>
    <text class="cab__pag" x="967" y="212.5" textLength="64.5" lengthAdjust="spacing">PAGE 02</text>

    <!-- Separadores de la bajada. Son simétricos respecto de x=561 y así están
         medidos: rombo en 274,5 / 847,5 y punto en 320 / 802. -->
    <g class="cab__sep">
      <path d={rombo(274.5, 204.5, 12, 9)} />
      <path d={rombo(847.5, 204.5, 12, 9)} />
      <path class="cab__punteo" d="M286 204.5H313M809 204.5H836" stroke-dasharray="9 4" />
      <circle class="cab__nodo-f" cx="320" cy="204.5" r="1.9" />
      <circle class="cab__nodo-f" cx="802" cy="204.5" r="1.9" />
    </g>

    <!-- ═══ 5 · BAJADA CENTRADA ══════════════════════════════════════════ -->
    <g class="cab__nodo">
      <circle cx="349" cy="241" r="1.9" />
      <circle cx="756.5" cy="241" r="1.9" />
    </g>
    <text class="cab__nota" x="366" y="245.5" textLength="373.5" lengthAdjust="spacing">THIS IS THE OBLIGATORY COMMON THRESHOLD.</text>

    <!-- ═══ 6 · RIELES ═══════════════════════════════════════════════════ -->
    <g class="cab__riel">
      {rielIzq.map(([a, b, macizo]) => (
        <path d={`M${EJE_I} ${a}V${b}`} stroke-dasharray={macizo ? undefined : "1 5.5"} />
      ))}
      {rielDer.map(([a, b, macizo]) => (
        <path d={`M${EJE_D} ${a}V${b}`} stroke-dasharray={macizo ? undefined : "1 5.5"} />
      ))}
    </g>

    <g class="cab__glifo">
      <!-- Riel izquierdo · racimo alto -->
      <circle cx={EJE_I} cy="304.5" r="4.7" />
      <path d="M8.8 315.5H18.2L13.5 322.2ZM13.5 322.2V325" />
      <path d={rayos(EJE_I, 347.5, 5, 8)} />
      <path d={rayos(EJE_I, 364, 3.4, 6, Math.PI / 2)} />
      <path d={rayos(EJE_I, 378.5, 4, 8, Math.PI / 8)} />
      <!-- Riel izquierdo · racimo bajo -->
      <path d={rayos(EJE_I, 799, 4, 6)} />
      <path d={rombo(EJE_I, 814.5, 12, 9)} />
      <circle cx={EJE_I} cy="814.5" r="1.6" />
      <!-- Riel derecho -->
      <path d="M1106.5 801L1111.6 803.5V808.5L1106.5 811L1101.4 808.5V803.5Z" />
      <path d={rayos(EJE_D, 806, 2.4, 4)} />
    </g>

    <g class="cab__nodo">
      {puntosIzq.map((y) => <circle cx={EJE_I} cy={y} r="1.5" />)}
      {puntosDer.map((y) => <circle cx={EJE_D} cy={y} r="1.4" />)}
    </g>
    <path class="cab__punteo" d={micropunteo.map(([a, b]) => `M${EJE_I} ${a}V${b}`).join("")} stroke-dasharray="1 3" />

    <!-- Microtipografía rotada. Se lee de abajo hacia arriba, que es como está
         en el póster: rotate(-90) sobre el punto de anclaje bajo. -->
    <text class="cab__micro" transform="translate(1103.6 399) rotate(-90)" textLength="182" lengthAdjust="spacing">XX XX PDX-02 / THRESHOLD XX</text>
    <text class="cab__micro" transform="translate(11 950) rotate(-90)" textLength="75" lengthAdjust="spacing">XX KDX-U02 XX</text>

    <!-- El 02 grande del riel derecho, a media altura (y=602..610). -->
    <text class="cab__folio" x="1100.5" y="610.5" textLength="14.5" lengthAdjust="spacing">02</text>
  </svg>
</div>

<style>
  .cab {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
  }

  /* Paleta de la lámina. Se declara acá y no en :root porque la Cabecera es el
     único bloque que fija el marco y los rieles: si el resto la quiere, la
     hereda del contenedor .lam. */
  .cab {
    --u02-ink: #cfc6e8;
    --u02-vio: #a77cf0;
    --u02-vio-hondo: #6d4bb0;
    --u02-tit: #d8d3e6;
    --u02-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
  }

  .cab text {
    font-family: var(--u02-mono);
    font-variant-ligatures: none;
    white-space: pre;
    fill: var(--u02-ink);
  }

  /* ── marco ────────────────────────────────────────────────────────────── */
  .cab__marco path {
    fill: none;
    stroke: var(--u02-ink);
    stroke-width: 1;
    stroke-opacity: 0.1;
  }
  .cab__marco--tenue { stroke-opacity: 0.06 !important; }
  /* El hilo fantasma es el que sostiene la lectura del riel entre tramo y
     tramo. Medido sobre negro no pasa de 20 de luminancia: si se sube, el riel
     deja de ser un riel y se vuelve un borde. */
  .cab__marco--fantasma { stroke-opacity: 0.025 !important; }

  .cab__interior path {
    fill: none;
    stroke: var(--u02-ink);
    stroke-width: 1;
    stroke-opacity: 0.045;
  }
  .cab__interior--esq { stroke-opacity: 0.14 !important; }

  /* ── regla superior ───────────────────────────────────────────────────── */
  .cab__regla {
    font-size: 12.3px;
    fill: var(--u02-ink);
    fill-opacity: 0.27;
  }
  .cab__regla--der { fill-opacity: 0.21; }

  .cab__cruz path { fill: var(--u02-vio); fill-opacity: 0.36; }

  .cab__nodo circle { fill: var(--u02-ink); fill-opacity: 0.32; }
  .cab__nodo-f { fill: var(--u02-ink); fill-opacity: 0.4; }

  .cab__punteo {
    fill: none;
    stroke: var(--u02-ink);
    stroke-width: 1;
    stroke-opacity: 0.075;
  }

  /* ── hexágono ─────────────────────────────────────────────────────────── */
  .cab__hex-borde { fill: none; stroke: var(--u02-ink); stroke-width: 1; stroke-opacity: 0.085; }
  .cab__hex-tic { fill: none; stroke: var(--u02-ink); stroke-width: 1.4; stroke-opacity: 0.19; }
  .cab__hex-tallo { fill: none; stroke: var(--u02-ink); stroke-width: 1; stroke-opacity: 0.07; }
  .cab__inf {
    fill: none;
    stroke: var(--u02-vio);
    stroke-width: 1.6;
    stroke-opacity: 0.62;
    stroke-linejoin: round;
  }
  .cab__tit-inf {
    fill: none !important;
    stroke: var(--u02-tit);
    stroke-width: 4.2;
    stroke-opacity: 0.8;
    stroke-linejoin: round;
  }

  /* ── título ───────────────────────────────────────────────────────────── */
  /* Cormorant Garamond 300 es la serif de exhibición más cercana que tiene el
     repo: alto contraste y serifas de pelo, como el póster. El peso 300 no es
     capricho — con 400 las astas engordan y el título pierde el aire. */
  .cab__titulo text {
    font-family: "Cormorant Garamond", "Cormorant", Didot, "Times New Roman", serif;
    font-weight: 400;
    fill: url(#u02TitGrad);
    fill-opacity: 0.86;
  }
  .cab__titulo path,
  .cab__titulo rect { fill: var(--u02-tit); fill-opacity: 0.78; }

  /* ── línea bajo el título ─────────────────────────────────────────────── */
  .cab__sig { font-size: 15.4px; fill: var(--u02-vio); fill-opacity: 0.42; }
  /* El lema es la pieza de mayor cuerpo de toda la franja después del título:
     versal de 16 px, no de 9 como el resto de la mono. */
  .cab__lema { font-size: 22px; fill: var(--u02-vio); fill-opacity: 0.5; }
  .cab__pag { font-size: 13.7px; fill: var(--u02-vio); fill-opacity: 0.4; }

  .cab__sep path { fill: none; stroke: var(--u02-ink); stroke-width: 1; stroke-opacity: 0.28; }
  .cab__sep .cab__punteo { stroke-opacity: 0.1; }

  .cab__nota { font-size: 13.5px; fill: var(--u02-ink); fill-opacity: 0.37; }

  /* ── rieles ───────────────────────────────────────────────────────────── */
  .cab__riel path {
    fill: none;
    stroke: var(--u02-ink);
    stroke-width: 1;
    stroke-opacity: 0.075;
    stroke-linecap: butt;
  }

  .cab__glifo path { fill: none; stroke: var(--u02-ink); stroke-width: 1; stroke-opacity: 0.18; }
  .cab__glifo circle { fill: none; stroke: var(--u02-ink); stroke-width: 1; stroke-opacity: 0.18; }

  .cab__micro { font-size: 7.4px; fill: var(--u02-ink); fill-opacity: 0.11; }
  .cab__folio { font-size: 12.3px; fill: var(--u02-vio); fill-opacity: 0.2; }
</style>
