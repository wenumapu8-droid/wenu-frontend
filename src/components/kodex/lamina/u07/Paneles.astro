<style>
  /* La lámina fija la mono y el color base; acá van los cuerpos, los pesos y los
     tonos propios de esta región. */
  [data-bloque="Paneles"] {
    --u07-ink: #cfc6e8;
    --u07-acc: #a77cf0;
    --u07-deep: #3d2c5e;
    --u07-ok: #6fe3e8;
    pointer-events: none;
  }
  .pan {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
  }

  .pan__t {
    font-family: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
    font-variant-ligatures: none;
    white-space: pre;
    fill: var(--u07-ink);
  }
  /* Versal medida: 9 px en los títulos y 7 en los cuerpos. Con la razón de
     JetBrains Mono (cap 0,73 em) eso da 12,3 y 9,6 de cuerpo. */
  .pan__t--tit { font-size: 12.3px; fill: #b98cff; fill-opacity: 0.78; }
    /* Medido: la tinta del cuerpo de la referencia llega a 124 de luminancia y su
     percentil 5 está en 87. Con 0,8 de opacidad esta mono daba 159 y 135 — una
     página entera de texto un tercio más brillante de lo que debe. */
  .pan__t--cuerpo { font-size: 9.6px; fill-opacity: 0.56; }
  .pan__t--sello { font-size: 9.6px; fill-opacity: 0.5; }
  .pan__t--aviso { font-size: 11.5px; fill: var(--u07-acc); fill-opacity: 0.8; }
  .pan__t--rot { font-size: 10.5px; fill-opacity: 0.7; }
  /* El único valor de otro color de toda la lámina: la referencia lo saca del
     violeta y lo lleva al cian. Es el remate del panel y no debe fundirse. */
  .pan__t--activo { fill: var(--u07-ok); fill-opacity: 0.95; }

  /* ── marcos ────────────────────────────────────────────────────────────
     El rectángulo va casi apagado —medido, no pasa de 24 de luminancia— y toda
     la lectura la cargan las escuadras. Subirle el brillo al rectángulo
     convierte diez instrumentos en diez cajas. */
  .pan__marco rect { fill: none; stroke: var(--u07-deep); stroke-width: 1; stroke-opacity: 0.3; }
  .pan__esq path { fill: none; stroke: var(--u07-ink); stroke-width: 1; stroke-opacity: 0.42; }

  .pan__rot rect { fill: #000; fill-opacity: 0.72; stroke: var(--u07-ink); stroke-width: 1; stroke-opacity: 0.3; }
  .pan__rot path { fill: none; stroke: var(--u07-ink); stroke-width: 1.2; stroke-opacity: 0.6; }

  /* ── piezas comunes ──────────────────────────────────────────────────── */
  .pan__nuc { fill: #f2ecff; fill-opacity: 0.95; }
