      <path
        class="pan__dia--vesica"
        d={`M${DIA.cx} ${DIA.cy - 47}A56.7 56.7 0 0 1 ${DIA.cx} ${DIA.cy + 47}A56.7 56.7 0 0 1 ${DIA.cx} ${DIA.cy - 47}Z`}
