    <text class="pan__t pan__t--tit" x="824" y="1027.5" textLength="170" lengthAdjust="spacing">MIRROR CHAMBER DIAGRAM</text>
    <g class="pan__dia">
      <!-- Envolvente y ejes. Radios medidos, no supuestos: el aro brillante da
           879..942 en su fila (rx 32) y no los 44 que sugiere el aro tenue que
           lo rodea; los discos laterales caen en ±81 con anillos en 11 y 24; el
           eje punteado muere en ±106. -->
      <circle class="pan__dia--aro" cx={DIA.cx} cy={DIA.cy} r="68" />
      <path class="pan__dia--eje" d={`M${DIA.cx - 106} ${DIA.cy}H${DIA.cx + 106}M${DIA.cx} ${DIA.cy - 66}V${DIA.cy + 66}`} stroke-dasharray="5 3" />
