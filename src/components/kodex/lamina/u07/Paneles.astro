      />
      <!-- Discos laterales: tres anillos y núcleo, en ±81 -->
      {[-81, 81].map((dx) => (
        <g>
          <circle class="pan__dia--aro" cx={DIA.cx + dx} cy={DIA.cy} r="24" />
