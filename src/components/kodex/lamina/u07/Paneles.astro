  .pan__sello polygon { fill: none; stroke: var(--u07-acc); stroke-width: 1; stroke-opacity: 0.66; }
  .pan__sello--int { stroke-opacity: 0.55 !important; stroke-width: 0.8 !important; }
  .pan__sello path { fill: none; stroke: var(--u07-acc); stroke-width: 0.9; stroke-opacity: 0.7; }

  .pan__aviso path { fill: none; stroke: var(--u07-ink); stroke-width: 1; stroke-opacity: 0.8; }

  /* ── FEEDBACK LOOP ────────────────────────────────────────────────────── */
