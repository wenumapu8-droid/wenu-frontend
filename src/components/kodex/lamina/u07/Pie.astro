---
/**
 * KODEX-∞ · u07-observer · PIE — banda inferior, y 1210..1402 del póster.
 *
 * Cuatro piezas, de arriba a abajo:
 *   1. Caja de la sentencia    x 365..753   y 1219..1277
 *   2. Dos reglas laterales que la caja interrumpe   y 1244 y 1269
 *   3. Banda de cierre con las tres columnas          y 1291..1359
 *   4. Sello hexagonal                                 centro (1007 · 1324,5)
 *
 * COORDENADAS. El bloque va con `inset:0` sobre el lienzo entero, así que las
 * x/y de este archivo son las del póster sin corrimiento: lo que se lee acá se
 * puede buscar tal cual en `reference/canon/u07-observer.png`.
 *
 * MEDIDO, NO ELEGIDO:
 *   · caja de la sentencia — verticales en x=365,5 y 753,5; horizontales en
 *     y=1219,5 y 1277,5.
 *   · los dos rombos que flanquean la sentencia caen en 384 y 734,75, o sea
 *     simétricos respecto de 559,4: el eje del pie es 560, el mismo de la
 *     cabecera y el del héroe.
 *   · las dos líneas de la sentencia miden 214 y 301 px de tinta con 20 y 28
 *     caracteres. De ahí sale un avance de 10,875 px por carácter, que con
 *     cuerpo 12,3 obliga a 0,28 em de espaciado. Es muchísimo y es lo que tiene
 *     la referencia.
 *   · la regla de la banda de cierre NO llega al borde: muere en x=959, justo
 *     donde empieza el sello. Tirarla hasta 1062 le pasa por encima.
 *   · el sello mide 64 px de ancho por 74 de alto — proporción exacta de un
 *     hexágono de punta arriba (√3 : 2), así que su radio es 37 y no hay nada
 *     que estimar.
 *
 * LO QUE NO SE DIBUJA ACÁ. El marco exterior —los rieles, la regla de y=1380 y
 * sus chaflanes— cruza la banda pero pertenece a la Cabecera, que lo abre
 * arriba y lo baja de un solo trazo. Partirlo deja costura en las esquinas.
 *
 * TELEMETRÍA SIMBÓLICA. `KDX-OBSERVER-007 / PROTOCOL INITIATED` es ficción del
 * póster, no estado de ningún sistema: va marcado `data-symbolic="true"`.
 */

/** Eje de simetría, deducido de los rombos de la sentencia. */
const EJE = 560;

/* ── 1 · caja de la sentencia ──────────────────────────────────────────── */
const CAJA = { x: 365.5, y: 1219.5, w: 388, h: 58 };
const ESQ = 11;
const esquinas = [
  [CAJA.x + 3.5, CAJA.y + 3.5, 1, 1],
  [CAJA.x + CAJA.w - 3.5, CAJA.y + 3.5, -1, 1],
  [CAJA.x + 3.5, CAJA.y + CAJA.h - 3.5, 1, -1],
  [CAJA.x + CAJA.w - 3.5, CAJA.y + CAJA.h - 3.5, -1, -1],
];

/** Rombo hueco: aparece de flanco de la sentencia y de cierre de regla. Un solo
 *  generador, tres tamaños. */
const rombo = (cx: number, cy: number, r: number) =>
  `M${cx} ${cy - r}L${cx + r} ${cy}L${cx} ${cy + r}L${cx - r} ${cy}Z`;

/* ── 3 · banda de cierre ───────────────────────────────────────────────── */
const BANDA = { x: 55.5, y: 1291.5, w: 1007, h: 68 };
const esquinasBanda = [
  [BANDA.x, BANDA.y, 1, 1],
  [BANDA.x + BANDA.w, BANDA.y, -1, 1],
  [BANDA.x, BANDA.y + BANDA.h, 1, -1],
  [BANDA.x + BANDA.w, BANDA.y + BANDA.h, -1, -1],
];

/* ── 4 · sello hexagonal ───────────────────────────────────────────────── */
const SELLO = { cx: 1007, cy: 1324.5, R: 37 };
const hexPuntos = Array.from({ length: 6 }, (_, k) => {
  const a = ((-90 + k * 60) * Math.PI) / 180;
  return `${(SELLO.cx + SELLO.R * Math.cos(a)).toFixed(2)},${(SELLO.cy + SELLO.R * Math.sin(a)).toFixed(2)}`;
}).join(" ");

const pol = (r: number, a: number) => [
  SELLO.cx + r * Math.cos((a * Math.PI) / 180),
  SELLO.cy + r * Math.sin((a * Math.PI) / 180),
];

/**
 * Rosa de la estrella, paramétrica. Los ocho brazos NO son iguales —y esa
 * desigualdad es lo que la separa de un asterisco tipográfico:
 *   · las cuatro DIAGONALES son trazo grueso con un cuadradito en la punta;
 *   · el eje VERTICAL va cortado: tramo, hueco, punto, punta;
 *   · el eje HORIZONTAL es más largo y lleva tres travesaños graduados;
 *   · entre medio, ocho pelos cortos a 22,5°.
 */
const NUCLEO = 3.4;
const brazos = Array.from({ length: 8 }, (_, k) => {
  const a = k * 45;
  const eje = k % 2 === 0;
  const horiz = a === 0 || a === 180;
  const largo = eje ? (horiz ? 19 : 17) : 16.5;
  const [x1, y1] = pol(NUCLEO, a);
  const [x2, y2] = pol(eje && !horiz ? 10.5 : largo, a);
  const [px, py] = pol(largo + 1.6, a);
  return {
    eje,
    d: `M${x1.toFixed(2)} ${y1.toFixed(2)}L${x2.toFixed(2)} ${y2.toFixed(2)}`,
    punta: [px, py],
    travesanos: horiz
      ? [
          [7, 3.2],
          [11.5, 2.6],
          [15.5, 2],
        ].map(([r, h]) => {
          const [cx, cy] = pol(r, a);
          return `M${cx.toFixed(2)} ${(cy - h).toFixed(2)}L${cx.toFixed(2)} ${(cy + h).toFixed(2)}`;
        })
      : [],
    suelto: eje && !horiz ? pol(13.5, a) : null,
  };
});

const pelos = Array.from({ length: 8 }, (_, k) => {
  const a = 22.5 + k * 45;
  const [x1, y1] = pol(4.2, a);
  const [x2, y2] = pol(9.4, a);
  return `M${x1.toFixed(2)} ${y1.toFixed(2)}L${x2.toFixed(2)} ${y2.toFixed(2)}`;
});

/** Cruces de puntería que flanquean el lema del cierre. */
const CRUCES = [EJE - 234.5, EJE + 234.5];
---

<div data-bloque="Pie" style="inset:0">
  <svg class="pie" viewBox="0 0 1122 1402" width="1122" height="1402" aria-hidden="true">
    <!-- ═══ 2 · REGLAS LATERALES ═════════════════════════════════════════
         Dos hebras a cada lado que la caja de la sentencia interrumpe. La de
         arriba llega hasta el borde mismo de la caja; la de abajo se queda
         corta y termina en un punto. -->
    <g class="pie-regla">
      <path class="pie-regla__hebra" d={`M60 1244H${CAJA.x}M${CAJA.x + CAJA.w} 1244H1064`} />
      <path class="pie-regla__linea" d="M60 1269H324M790 1269H1058" />
      <path class="pie-regla__cierre" d="M50 1264.8v8.4m-4.2 -4.2h8.4" />
      <circle class="pie-regla__punto" cx="327" cy="1269" r="1.6" />
      <circle class="pie-regla__punto" cx="787" cy="1269" r="1.6" />
      <circle class="pie-regla__punto" cx="1061" cy="1269" r="1.6" />
    </g>

    <!-- ═══ 1 · CAJA DE LA SENTENCIA ═════════════════════════════════════ -->
    <g class="pie-caja">
      <rect x={CAJA.x} y={CAJA.y} width={CAJA.w} height={CAJA.h} />
      {
        esquinas.map(([x, y, sx, sy]) => (
          <path class="pie-caja__esq" d={`M${x + sx * ESQ} ${y}H${x}V${y + sy * ESQ}`} />
        ))
      }
      <path class="pie-caja__romb" d={rombo(384, 1248, 5.4)} />
      <path class="pie-caja__romb" d={rombo(734.75, 1248, 5.4)} />
    </g>
    <text class="pie-t pie-t--frase" x={EJE} y="1245.5">TO SEE IS TO CHANGE.</text>
    <text class="pie-t pie-t--frase" x={EJE} y="1262.5">TO CHANGE IS TO BECOME SEEN.</text>

    <!-- ═══ 3 · BANDA DE CIERRE ══════════════════════════════════════════ -->
    <g class="pie-cierre">
      {
        esquinasBanda.map(([x, y, sx, sy]) => (
          <path class="pie-caja__esq" d={`M${x + sx * 16} ${y}H${x}V${y + sy * 16}`} />
        ))
      }
      <!-- La regla muere en 959: de ahí para la derecha manda el sello. -->
      <path class="pie-regla__linea" d="M79 1293H959" />

      <g data-symbolic="true">
        <text class="pie-t pie-t--codigo" x="83" y="1321.5" textLength="141" lengthAdjust="spacing">KDX-OBSERVER-007</text>
        <text class="pie-t pie-t--codigo pie-t--codigo2" x="83" y="1339.5" textLength="130" lengthAdjust="spacing">PROTOCOL INITIATED</text>
      </g>

      <text class="pie-t pie-t--lema" x="354" y="1331.5" textLength="410" lengthAdjust="spacing">THE KODEX IS LIVING. YOU ARE PART OF IT.</text>
      {
        CRUCES.map((x) => (
          <g class="pie-cruz">
            <path d={`M${x} 1323.5v7M${x - 3.5} 1327H${x + 3.5}`} />
          </g>
        ))
      }

      <text class="pie-t pie-t--fuente" x="892" y="1321.5" textLength="67" lengthAdjust="spacing">ONE SOURCE</text>
      <text class="pie-t pie-t--expr" x="821" y="1339.5" textLength="139" lengthAdjust="spacing">INFINITE EXPRESSIONS</text>

      <!-- ═══ 4 · SELLO ══════════════════════════════════════════════════ -->
      <g class="pie-sello" role="img" aria-label="Sello KODEX-∞: una fuente, infinitas expresiones">
        <polygon class="pie-sello__hex" points={hexPuntos} />
        <g class="pie-sello__rosa">
          {pelos.map((d) => <path class="pie-sello__pelo" d={d} />)}
          {
            brazos.map((b) => (
              <g>
                <path class={b.eje ? "pie-sello__eje" : "pie-sello__diag"} d={b.d} />
                {b.travesanos.map((d) => <path class="pie-sello__pelo" d={d} />)}
                {b.suelto && (
                  <circle class="pie-sello__punta" cx={b.suelto[0].toFixed(2)} cy={b.suelto[1].toFixed(2)} r="0.9" />
                )}
                <rect
                  class="pie-sello__punta"
                  x={(b.punta[0] - 1.15).toFixed(2)}
                  y={(b.punta[1] - 1.15).toFixed(2)}
                  width="2.3"
                  height="2.3"
                />
              </g>
            ))
          }
          <circle class="pie-sello__nucleo" cx={SELLO.cx} cy={SELLO.cy} r="2.6" />
        </g>
      </g>
    </g>
  </svg>
</div>

<style>
  /* El bloque cubre el lienzo entero y no pinta fondo: todo lo suyo cae de
     y=1219 para abajo, y lo de arriba queda visible tal cual. */
  .pie {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
  }

  /* ── tipografía ─────────────────────────────────────────────────────── */
  /* En SVG el espaciado de letra se suma también DESPUÉS del último carácter,
     así que lo centrado se corrige con `translateX` de media letra. Sin eso la
     sentencia queda 1,7 px corrida a la izquierda y el banco lo ve. */
  .pie-t {
    font-family: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
    font-variant-ligatures: none;
    white-space: pre;
    fill: currentColor;
  }
  .pie-t--frase {
    font-size: 12.3px;
    /* 0,282 em. Parece un error de tipeo y no lo es: los arranques de carácter
       de la referencia caen cada 10,875 px con una versal de 9. */
    letter-spacing: 0.282em;
    text-anchor: middle;
    fill: #cfc6e8;
    fill-opacity: 0.88;
    transform: translateX(1.73px);
  }
  .pie-t--codigo {
    font-size: 12px;
    fill: #a77cf0;
    fill-opacity: 0.9;
  }
  .pie-t--codigo2 { font-size: 11px; }
  .pie-t--lema {
    font-size: 12px;
    fill: #cfc6e8;
    fill-opacity: 0.76;
  }
  .pie-t--fuente {
    font-size: 10.5px;
    fill: #a77cf0;
    fill-opacity: 0.82;
  }
  .pie-t--expr {
    font-size: 10.5px;
    fill: #cfc6e8;
    fill-opacity: 0.66;
  }

  /* ── caja y reglas ──────────────────────────────────────────────────── */
  .pie-caja rect {
    fill: none;
    stroke: #3d2c5e;
    stroke-width: 1;
    stroke-opacity: 0.75;
  }
  .pie-caja__esq {
    fill: none;
    stroke: #cfc6e8;
    stroke-width: 1.1;
    stroke-opacity: 0.5;
  }
  .pie-caja__romb {
    fill: none;
    stroke: #cfc6e8;
    stroke-width: 1;
    stroke-opacity: 0.62;
  }
  .pie-regla__linea {
    stroke: #cfc6e8;
    stroke-width: 1;
    stroke-opacity: 0.26;
  }
  .pie-regla__hebra {
    stroke: #3d2c5e;
    stroke-width: 1;
    stroke-opacity: 0.55;
  }
  .pie-regla__cierre {
    fill: none;
    stroke: #cfc6e8;
    stroke-width: 1;
    stroke-opacity: 0.55;
  }
  .pie-regla__punto {
    fill: none;
    stroke: #cfc6e8;
    stroke-width: 0.9;
    stroke-opacity: 0.5;
  }
  .pie-cruz path {
    stroke: #a77cf0;
    stroke-width: 0.9;
    stroke-opacity: 0.6;
  }

  /* ── sello ──────────────────────────────────────────────────────────── */
  .pie-sello__hex {
    fill: none;
    stroke: #cfc6e8;
    stroke-width: 1;
    stroke-opacity: 0.5;
  }
  .pie-sello__diag {
    stroke: #a77cf0;
    stroke-width: 1.5;
  }
  .pie-sello__eje {
    stroke: #a77cf0;
    stroke-width: 1;
  }
  .pie-sello__pelo {
    stroke: #a77cf0;
    stroke-width: 0.7;
    stroke-opacity: 0.75;
  }
  .pie-sello__punta {
    fill: #a77cf0;
  }
  .pie-sello__nucleo {
    fill: none;
    stroke: #a77cf0;
    stroke-width: 1;
  }
</style>
