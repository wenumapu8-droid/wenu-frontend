---
/**
 * KODEX-∞ · u07-observer · PIE — banda inferior, y 1210..1402 del póster.
 *
 * Cuatro piezas, de arriba a abajo:
 *   1. Caja de la sentencia    x 365..753   y 1219..1277        (acá)
 *   2. Dos reglas laterales que la caja interrumpe   y 1244 y 1269   (acá)
 *   3. Banda de cierre con las tres columnas          y 1291..1359
 *   4. Sello hexagonal                                 centro (1007 · 1324,5)
 *
 * Las piezas 3 y 4 —salvo el marco de la banda, que es de esta página— las pone
 * `serie-universe/PieUniverse.astro`, el mismo remate de las cinco láminas de
 * la serie. Lo propio de la u07 va por el slot `antes`.
 *
 * COORDENADAS. El bloque va con `inset:0` sobre el lienzo entero, así que las
 * x/y de este archivo son las del póster sin corrimiento: lo que se lee acá se
 * puede buscar tal cual en `reference/canon/u07-observer.png`.
 *
 * MEDIDO, NO ELEGIDO:
 *   · caja de la sentencia — verticales en x=365,5 y 753,5; horizontales en
 *     y=1219,5 y 1277,5.
 *   · los dos rombos que flanquean la sentencia caen en 384 y 734,75, o sea
 *     simétricos respecto de 559,4: el eje del pie es 560, el mismo de la
 *     cabecera y el del héroe.
 *   · las dos líneas de la sentencia miden 214 y 301 px de tinta con 20 y 28
 *     caracteres. De ahí sale un avance de 10,875 px por carácter, que con
 *     cuerpo 12,3 obliga a 0,28 em de espaciado. Es muchísimo y es lo que tiene
 *     la referencia.
 *   · la regla de la banda de cierre NO llega al borde: muere en x=959, justo
 *     donde empieza el sello. Tirarla hasta 1062 le pasa por encima.
 *   · el sello mide 64 px de ancho por 74 de alto — proporción exacta de un
 *     hexágono de punta arriba (√3 : 2), así que su radio es 37 y no hay nada
 *     que estimar.
 *
 * LO QUE NO SE DIBUJA ACÁ. El marco exterior —los rieles, la regla de y=1380 y
 * sus chaflanes— cruza la banda pero pertenece a la Cabecera, que lo abre
 * arriba y lo baja de un solo trazo. Partirlo deja costura en las esquinas.
 *
 * TELEMETRÍA SIMBÓLICA. `KDX-OBSERVER-007 / PROTOCOL INITIATED` es ficción del
 * póster, no estado de ningún sistema: va marcado `data-symbolic="true"`.
 */
import PieUniverse from "../serie-universe/PieUniverse.astro";
import { romboR, esquinaL } from "../serie-universe/geom";

/** Eje de simetría, deducido de los rombos de la sentencia. */
const EJE = 560;

/* ── 1 · caja de la sentencia ──────────────────────────────────────────── */
const CAJA = { x: 365.5, y: 1219.5, w: 388, h: 58 };
const ESQ = 11;
const esquinas = [
  [CAJA.x + 3.5, CAJA.y + 3.5, 1, 1],
  [CAJA.x + CAJA.w - 3.5, CAJA.y + 3.5, -1, 1],
  [CAJA.x + 3.5, CAJA.y + CAJA.h - 3.5, 1, -1],
  [CAJA.x + CAJA.w - 3.5, CAJA.y + CAJA.h - 3.5, -1, -1],
];

/* ── 3 · banda de cierre ───────────────────────────────────────────────── */
const BANDA = { x: 55.5, y: 1291.5, w: 1007, h: 68 };
const esquinasBanda = [
  [BANDA.x, BANDA.y, 1, 1],
  [BANDA.x + BANDA.w, BANDA.y, -1, 1],
  [BANDA.x, BANDA.y + BANDA.h, 1, -1],
  [BANDA.x + BANDA.w, BANDA.y + BANDA.h, -1, -1],
];

/** Cruces de puntería que flanquean el lema del cierre. */
const CRUCES = [EJE - 234.5, EJE + 234.5];

/* Las opacidades de esta lámina van por los mandos `-a` —las alfas de pintura,
   `fill-opacity` y `stroke-opacity`— porque es con esas propiedades que se
   calibró caja por caja contra la referencia. Ver la nota de `PieUniverse`. */
const vars = [
  "--pi-ink:#cfc6e8",
  "--pi-vio:#a77cf0",
  "--pi-cod-size:12px",
  "--pi-cod-a:.9",
  "--pi-est-size:11px",
  "--pi-lema-a:.76",
  "--pi-fuente-a:.82",
  "--pi-expr-a:.66",
  "--pi-hex-a:.5",
  "--pi-pelo-a:.75",
].join(";");
---

<PieUniverse
  vars={vars}
  codigo={{ x: 83, y: 1321.5, len: 141, t: "KDX-OBSERVER-007" }}
  estado={{ x: 83, y: 1339.5, len: 130, t: "PROTOCOL INITIATED" }}
  lema={{ x: 354, y: 1331.5, len: 410, t: "THE KODEX IS LIVING. YOU ARE PART OF IT." }}
  fuente={{ x: 892, y: 1321.5, len: 67, t: "ONE SOURCE" }}
  expr={{ x: 821, y: 1339.5, len: 139, t: "INFINITE EXPRESSIONS" }}
  sello={{ cx: 1007, cy: 1324.5, R: 37 }}
>
  <Fragment slot="antes">
    <!-- ═══ 2 · REGLAS LATERALES ═════════════════════════════════════════
         Dos hebras a cada lado que la caja de la sentencia interrumpe. La de
         arriba llega hasta el borde mismo de la caja; la de abajo se queda
         corta y termina en un punto. -->
    <g class="pie-regla">
      <path class="pie-regla__hebra" d={`M60 1244H${CAJA.x}M${CAJA.x + CAJA.w} 1244H1064`} />
      <path class="pie-regla__linea" d="M60 1269H324M790 1269H1058" />
      <path class="pie-regla__cierre" d="M50 1264.8v8.4m-4.2 -4.2h8.4" />
      <circle class="pie-regla__punto" cx="327" cy="1269" r="1.6" />
      <circle class="pie-regla__punto" cx="787" cy="1269" r="1.6" />
      <circle class="pie-regla__punto" cx="1061" cy="1269" r="1.6" />
    </g>

    <!-- ═══ 1 · CAJA DE LA SENTENCIA ═════════════════════════════════════ -->
    <g class="pie-caja">
      <rect x={CAJA.x} y={CAJA.y} width={CAJA.w} height={CAJA.h} />
      {esquinas.map(([x, y, sx, sy]) => <path class="pie-caja__esq" d={esquinaL(x, y, sx, sy, ESQ)} />)}
      <path class="pie-caja__romb" d={romboR(384, 1248, 5.4)} />
      <path class="pie-caja__romb" d={romboR(734.75, 1248, 5.4)} />
    </g>
    <text class="pie-t pie-t--frase" x={EJE} y="1245.5">TO SEE IS TO CHANGE.</text>
    <text class="pie-t pie-t--frase" x={EJE} y="1262.5">TO CHANGE IS TO BECOME SEEN.</text>

    <!-- ═══ 3 · MARCO DE LA BANDA DE CIERRE ══════════════════════════════ -->
    {esquinasBanda.map(([x, y, sx, sy]) => <path class="pie-caja__esq" d={esquinaL(x, y, sx, sy, 16)} />)}
    <!-- La regla muere en 959: de ahí para la derecha manda el sello. -->
    <path class="pie-regla__linea" d="M79 1293H959" />
  </Fragment>

  {
    CRUCES.map((x) => (
      <g class="pie-cruz" slot="cruces">
        <path d={`M${x} 1323.5v7M${x - 3.5} 1327H${x + 3.5}`} />
      </g>
    ))
  }
</PieUniverse>

<style>
  /* Sólo lo de esta lámina: la banda de tres columnas y el sello los viste
     `PieUniverse` con las variables `--pi-*` de arriba.

     En SVG el espaciado de letra se suma también DESPUÉS del último carácter,
     así que lo centrado se corrige con `translateX` de media letra. Sin eso la
     sentencia queda 1,7 px corrida a la izquierda y el banco lo ve. */
  .pie-t--frase {
    font-size: 12.3px;
    /* 0,282 em. Parece un error de tipeo y no lo es: los arranques de carácter
       de la referencia caen cada 10,875 px con una versal de 9. */
    letter-spacing: 0.282em;
    text-anchor: middle;
    fill: #cfc6e8;
    fill-opacity: 0.88;
    transform: translateX(1.73px);
  }

  /* ── caja y reglas ──────────────────────────────────────────────────── */
  .pie-caja rect {
    fill: none;
    stroke: #3d2c5e;
    stroke-width: 1;
    stroke-opacity: 0.75;
  }
  .pie-caja__esq {
    fill: none;
    stroke: #cfc6e8;
    stroke-width: 1.1;
    stroke-opacity: 0.5;
  }
  .pie-caja__romb {
    fill: none;
    stroke: #cfc6e8;
    stroke-width: 1;
    stroke-opacity: 0.62;
  }
  .pie-regla__linea {
    stroke: #cfc6e8;
    stroke-width: 1;
    stroke-opacity: 0.26;
  }
  .pie-regla__hebra {
    stroke: #3d2c5e;
    stroke-width: 1;
    stroke-opacity: 0.55;
  }
  .pie-regla__cierre {
    fill: none;
    stroke: #cfc6e8;
    stroke-width: 1;
    stroke-opacity: 0.55;
  }
  .pie-regla__punto {
    fill: none;
    stroke: #cfc6e8;
    stroke-width: 0.9;
    stroke-opacity: 0.5;
  }
  .pie-cruz path {
    stroke: #a77cf0;
    stroke-width: 0.9;
    stroke-opacity: 0.6;
  }
</style>
