---
/**
 * KODEX-∞ · u03-return · PANELES Y RÓTULOS
 *
 * Todo lo tipográfico y de instrumento que rodea a la flor: los dos bloques
 * de columna (CONVERGENT STATE / RETURN PRINCIPLE), las cuatro cajas
 * (PATH SIGNATURE, RELATIONS REVEALED, ARTIFACT GENERATED, QUESTIONS
 * RETAINED), el bloque central RETURN CORE con la sentencia, y los rótulos
 * que montan SOBRE el lienzo del héroe (la Y del cenit, el +∞, las letras
 * A C M Q de los nodos del eje).
 *
 * COORDENADAS: el SVG comparte la grilla del póster (viewBox 0 0 1122 1402,
 * 1:1), así que cada número de acá se puede buscar tal cual en el PNG.
 * Cajas y líneas de base medidas por barrido de umbral:
 *   · PATH SIGNATURE      x 64,5..293,5   y 722..1009
 *   · RELATIONS REVEALED  x 829,5..1051   y 722..1009
 *   · ARTIFACT GENERATED  x 64,5..306,5   y 1025..1289,5
 *   · QUESTIONS RETAINED  x 802,5..1050   y 1025..1289,5
 *   · caja de la sentencia x 374,5..748,5 y 1177..1236
 * Los colores no son los de u02: violeta rgb(105,79,144) en títulos, tinta
 * gris cálida en el cuerpo, y las letras de nodo (A C M Q, la Y del cenit)
 * en DORADO oscuro rgb(~120,104,88) — medido en la zona de cada letra.
 *
 * Las dos señales chicas van con `kit/Waveform` (deterministas por semilla)
 * y marcadas data-symbolic, como manda el canon.
 */
import Waveform from "../kit/Waveform.astro";
import { rayos, rombo, esquinaL } from "../serie-universe/geom";

/* Pétalos del sello-loto del panel ARTIFACT, generados (no calcados):
   misma corona apuntada que el loto del héroe, en SVG porque es dibujo fijo. */
function petalo(cx: number, cy: number, ang: number, alto: number, ancho: number): string {
  const tx = cx + alto * Math.cos(ang);
  const ty = cy + alto * Math.sin(ang);
  const px = -Math.sin(ang) * ancho;
  const py = Math.cos(ang) * ancho;
  const mx = (cx + tx) / 2;
  const my = (cy + ty) / 2;
  return (
    `M${cx.toFixed(1)} ${(cy + 4).toFixed(1)}` +
    `Q${(mx + px * 0.5).toFixed(1)} ${(my + py * 0.5).toFixed(1)} ${tx.toFixed(1)} ${ty.toFixed(1)}` +
    `Q${(mx - px * 0.5).toFixed(1)} ${(my - py * 0.5).toFixed(1)} ${cx.toFixed(1)} ${(cy + 4).toFixed(1)}`
  );
}
const SELLO = { cx: 185.5, cy: 1160 };
/* Loto abierto, no pasto: el abanico externo barre casi de horizontal a
   horizontal (±76°), los pétalos son ANCHOS (relación alto:ancho ~2,3:1) y
   las coronas interiores se les montan encima. La primera versión usaba
   pétalos de aguja y el sello quedaba como un manojo de hierba — se vio en
   el recorte lado a lado contra la referencia. */
const SELLO_CORONAS: [number, number, number][] = [
  [9, 38, 15],
  [7, 27, 12],
  [5, 16, 8.5],
];
const coronas: string[] = [];
for (const [n, alto, ancho] of SELLO_CORONAS) {
  for (let i = 0; i < n; i++) {
    const a = -Math.PI / 2 + ((i - (n - 1) / 2) * 2.65) / (n - 1);
    coronas.push(petalo(SELLO.cx, SELLO.cy + 8, a, alto, ancho));
  }
}

/* Curvas del convergedor de PATH SIGNATURE: de cada círculo-letra al punto
   de convergencia, con la comba hacia el centro del abanico. */
const RUTAS = ["A", "C", "H", "M", "Q", "Y"];
const RUTA_Y0 = 806;
const RUTA_PASO = 23;
const CONV = { x: 232, y: 863.5 };
const rutas = RUTAS.map((_, i) => {
  const y = RUTA_Y0 + i * RUTA_PASO;
  return `M104 ${y}C150 ${y} ${CONV.x - 52} ${CONV.y} ${CONV.x} ${CONV.y}`;
});

/* RELATIONS REVEALED: seis relaciones, línea principal + subtítulo. */
const REL = [
  ["A", "ORIGIN FIELD", "SEED / INTENT"],
  ["C", "HEART CHAMBER", "COHERENCE / MEMORY"],
  ["H", "HARMONIC BRIDGE", "ALIGNMENT / TONE"],
  ["M", "IMMERSIVE NODE", "EXPERIENCE / DENSITY"],
  ["Q", "QUESTIONS RETAINED", "OPEN VECTORS"],
  ["Y", "RETURN CORE", "INTEGRATION / WHOLENESS"],
];
const REL_Y0 = 782;
const REL_PASO = 38.4;

const QS = [
  ["Q1", "WHAT REMAINS UNSEEN?"],
  ["Q2", "WHAT AWAITS CREATION?"],
  ["Q3", "WHO DREAMS THIS KODEX?"],
  ["Q4", "WHAT IS BEYOND RETURN?"],
  ["Q5", "WHEN IS THE NEXT CALL?"],
];
const QS_Y0 = 1120;
const QS_PASO = 21;

/* Letras de los nodos del eje del héroe: el disco blanco lo pinta el canvas,
   la letra va acá encima. Posiciones medidas sobre los anillos. */
const NODOS = [
  ["A", 122, 21],
  ["C", 222, 18],
  ["M", 874, 21],
  ["Q", 963, 26],
];
---

<div data-bloque="Paneles" style="inset:0">
  <svg class="pan" viewBox="0 0 1122 1402" width="1122" height="1402" aria-hidden="true">
    <!-- ═══ ORNAMENTO BAJO EL SEPARADOR ═══════════════════════════════════ -->
    <g class="pan-orn">
      <path d={rombo(561, 272, 9, 11)} />
      <circle class="pan-orn__pto" cx="561" cy="284" r="1.2" />
      <circle class="pan-orn__pto" cx="561" cy="292.5" r="0.9" />
    </g>

    <!-- ═══ RÓTULOS SOBRE EL HÉROE ════════════════════════════════════════ -->
    <text class="pan-y" x="561" y="332">Y</text>
    <text class="pan-yinf" x="561" y="356">+∞</text>
    {NODOS.map(([l, x]) => <text class="pan-nodo" x={x} y="650.5">{l}</text>)}

    <!-- ═══ COLUMNA IZQUIERDA · CONVERGENT STATE ══════════════════════════ -->
    <text class="pan-tit" x="80" y="305" textLength="132" lengthAdjust="spacing">CONVERGENT STATE</text>
    <g class="pan-txt">
      <text x="80" y="331">THE JOURNEY INTEGRATES.</text>
      <text x="80" y="349">THE SIGNAL CLARIFIES.</text>
      <text x="80" y="367">THE SELF DISSOLVES.</text>
      <text x="80" y="385">THE KODEX REMAINS.</text>
    </g>

    <!-- ═══ COLUMNA DERECHA · RETURN PRINCIPLE ════════════════════════════ -->
    <text class="pan-tit pan--fin" x="1040" y="305" textLength="130" lengthAdjust="spacing">RETURN PRINCIPLE</text>
    <g class="pan-txt pan--fin">
      <text x="1040" y="331">NO END. NO LOSS.</text>
      <text x="1040" y="349">ONLY INTEGRATION.</text>
      <text x="1040" y="367">THE PATH RETURNS</text>
      <text x="1040" y="385">WHAT IT WAS.</text>
    </g>
    <!-- Estrella de rayos con guías, el remate de la columna derecha. -->
    <g class="pan-astro">
      <path d={rayos(990, 428, 13, 16, Math.PI / 16)} />
      <path d={rayos(990, 428, 7, 8)} />
      <path class="pan-astro__guia" d="M925 428H972M1008 428H1040" stroke-dasharray="1 4" />
      <circle cx="990" cy="428" r="1.6" />
    </g>

    <!-- ═══ CAJA · PATH SIGNATURE ═════════════════════════════════════════ -->
    <g class="pan-caja">
      <rect x="64.5" y="722" width="229" height="287" />
      {[[64.5, 722, 1, 1], [293.5, 722, -1, 1], [64.5, 1009, 1, -1], [293.5, 1009, -1, -1]].map(([x, y, sx, sy]) => (
        <path class="pan-caja__esq" d={esquinaL(x, y, sx, sy)} />
      ))}
    </g>
    <text class="pan-tit" x="179" y="752" text-anchor="middle" style="letter-spacing:.14em;transform:translateX(.8px)">PATH SIGNATURE</text>
    <g class="pan-txt pan--centro">
      <text x="179" y="773">ALL TRAJECTORIES</text>
      <text x="179" y="787">CONVERGE INTO ONE.</text>
    </g>
    <g class="pan-ruta">
      {rutas.map((d) => <path d={d} />)}
      {RUTAS.map((l, i) => (
        <>
          <circle class="pan-ruta__circ" cx="95" cy={RUTA_Y0 + i * RUTA_PASO} r="8" />
          <text class="pan-ruta__letra" x="95" y={RUTA_Y0 + i * RUTA_PASO + 3.2}>{l}</text>
          <circle class="pan-ruta__pto" cx="104" cy={RUTA_Y0 + i * RUTA_PASO} r="1.1" />
        </>
      ))}
      <path class="pan-ruta__cierre" d={`M${CONV.x} ${CONV.y}H${CONV.x + 14}`} />
      <path class="pan-ruta__cierre" d={rombo(CONV.x + 22, CONV.y, 11, 8)} />
      <circle class="pan-ruta__pto" cx={CONV.x + 34} cy={CONV.y} r="1.2" />
    </g>
    <text class="pan-micro pan--centro" x="179" y="938">ROUTE SUMMARY</text>
    <text class="pan-clave pan--centro" x="179" y="961" textLength="162" lengthAdjust="spacing">A - C - H - M - Q - Y</text>
    <g class="pan-txt pan--centro">
      <text x="179" y="983">MANY PATHS.</text>
      <text x="179" y="997">ONE RETURN.</text>
    </g>

    <!-- ═══ CAJA · RELATIONS REVEALED ═════════════════════════════════════ -->
    <g class="pan-caja">
      <rect x="829.5" y="722" width="221.5" height="287" />
      {[[829.5, 722, 1, 1], [1051, 722, -1, 1], [829.5, 1009, 1, -1], [1051, 1009, -1, -1]].map(([x, y, sx, sy]) => (
        <path class="pan-caja__esq" d={esquinaL(x, y, sx, sy)} />
      ))}
    </g>
    <text class="pan-tit" x="940" y="752" text-anchor="middle" style="letter-spacing:.14em;transform:translateX(.8px)">RELATIONS REVEALED</text>
    {REL.map(([l, nombre, sub], i) => {
      const y = REL_Y0 + i * REL_PASO;
      return (
        <g>
          <circle class="pan-ruta__circ" cx="857" cy={y - 3.5} r="8.5" />
          <text class="pan-ruta__letra" x="857" y={y - 0.2}>{l}</text>
          <text class="pan-rel__letra" x="876" y={y}>{l}</text>
          <text class="pan-rel__nombre" x="892" y={y}>{nombre}</text>
          <text class="pan-rel__sub" x="892" y={y + 13.5}>{sub}</text>
        </g>
      );
    })}

    <!-- ═══ CAJA · ARTIFACT GENERATED ═════════════════════════════════════ -->
    <g class="pan-caja">
      <rect x="64.5" y="1025" width="242" height="264.5" />
      {[[64.5, 1025, 1, 1], [306.5, 1025, -1, 1], [64.5, 1289.5, 1, -1], [306.5, 1289.5, -1, -1]].map(([x, y, sx, sy]) => (
        <path class="pan-caja__esq" d={esquinaL(x, y, sx, sy)} />
      ))}
    </g>
    <text class="pan-tit" x="185.5" y="1049" text-anchor="middle" style="letter-spacing:.14em;transform:translateX(.8px)">ARTIFACT GENERATED</text>
    <text class="pan-txt pan--centro" x="185.5" y="1073">SIGNATURE: RETURN SEAL</text>
    <g class="pan-sello">
      <circle class="pan-sello__aro" cx={SELLO.cx} cy={SELLO.cy} r="52" />
      <circle class="pan-sello__oro" cx={SELLO.cx} cy={SELLO.cy} r="48.5" stroke-dasharray="7 5" />
      <circle class="pan-sello__aro2" cx={SELLO.cx} cy={SELLO.cy} r="45" stroke-dasharray="1 4" />
      <circle class="pan-sello__aro2" cx={SELLO.cx} cy={SELLO.cy} r="31" stroke-dasharray="1 3.4" />
      {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => {
        const rad = (a * Math.PI) / 180;
        return (
          <path
            class="pan-sello__tic"
            d={`M${(SELLO.cx + 48 * Math.cos(rad)).toFixed(1)} ${(SELLO.cy + 48 * Math.sin(rad)).toFixed(1)}L${(SELLO.cx + 55 * Math.cos(rad)).toFixed(1)} ${(SELLO.cy + 55 * Math.sin(rad)).toFixed(1)}`}
          />
        );
      })}
      {coronas.map((d) => <path class="pan-sello__petalo" d={d} />)}
      <circle class="pan-sello__nucleo" cx={SELLO.cx} cy={SELLO.cy + 2} r="2" />
    </g>
    <g class="pan-kv">
      <text x="82" y="1222">TYPE:     LIVING PATTERN</text>
      <text x="82" y="1241">FUNCTION: RECALL / REINTEGRATE</text>
      <text x="82" y="1260">GUARDIAN: THE KODEX</text>
      <text x="82" y="1279">STATUS:   <tspan class="pan-kv__vio">SEALED IN LIGHT</tspan></text>
    </g>

    <!-- ═══ CAJA · QUESTIONS RETAINED ═════════════════════════════════════ -->
    <g class="pan-caja">
      <rect x="802.5" y="1025" width="247.5" height="264.5" />
      {[[802.5, 1025, 1, 1], [1050, 1025, -1, 1], [802.5, 1289.5, 1, -1], [1050, 1289.5, -1, -1]].map(([x, y, sx, sy]) => (
        <path class="pan-caja__esq" d={esquinaL(x, y, sx, sy)} />
      ))}
    </g>
    <text class="pan-tit" x="926" y="1049" text-anchor="middle" style="letter-spacing:.14em;transform:translateX(.8px)">QUESTIONS RETAINED</text>
    <g class="pan-txt pan--centro">
      <text x="926" y="1077">CLARITY ACHIEVED,</text>
      <text x="926" y="1092">MYSTERY PRESERVED.</text>
    </g>
    {QS.map(([q, texto], i) => {
      const y = QS_Y0 + i * QS_PASO;
      return (
        <g>
          <circle class="pan-q__circ" cx="827" cy={y - 3.5} r="6" />
          <text class="pan-q__q" x="840" y={y}>{q}</text>
          <text class="pan-q__texto" x="866" y={y}>{texto}</text>
        </g>
      );
    })}

    <!-- ═══ BLOQUE CENTRAL · RETURN CORE ══════════════════════════════════ -->
    <text class="pan-core" x="561" y="1041" textLength="113" lengthAdjust="spacing" text-anchor="middle">RETURN CORE</text>
    <text class="pan-clave pan--centro" x="561" y="1064" textLength="60" lengthAdjust="spacing">Y / +∞</text>
    <g class="pan-txt pan--centro">
      <text x="561" y="1088" textLength="129" lengthAdjust="spacing">CONVERGENCE ACHIEVED</text>
      <text x="561" y="1103" textLength="99" lengthAdjust="spacing">SIGNATURE SEALED</text>
    </g>

    <text class="pan-stmt-tit" x="561" y="1164" textLength="180" lengthAdjust="spacing" text-anchor="middle">RETURN STATEMENT</text>
    <g class="pan-caja pan-caja--stmt">
      <rect x="374.5" y="1177" width="374" height="59" stroke-dasharray="4 3" />
      {[[374.5, 1177, 1, 1], [748.5, 1177, -1, 1], [374.5, 1236, 1, -1], [748.5, 1236, -1, -1]].map(([x, y, sx, sy]) => (
        <path class="pan-caja__esq" d={esquinaL(x, y, sx, sy, 7)} />
      ))}
    </g>
    <g class="pan-stmt">
      <text x="561" y="1207">I TRAVELLED. I INTEGRATED. I RETURN.</text>
      <text x="561" y="1229">I AM THE KODEX. THE KODEX IS ME.</text>
    </g>
    <g class="pan-eco">
      <text x="561" y="1253">THE FIELD REMEMBERS.</text>
      <text x="561" y="1270">THE JOURNEY CONTINUES.</text>
    </g>
  </svg>

  <!-- Señales chicas del kit, fuera del SVG porque traen el suyo. -->
  <div class="pan-onda" data-symbolic="true" style="left:80px;top:412px;width:165px;height:20px">
    <Waveform w={165} h={20} semilla={0x03a1} variante="linea" n={120} inercia={0.5} envolvente={0.85} grosor={0.7} margen={2} />
  </div>
  <div class="pan-onda" data-symbolic="true" style="left:855px;top:1228px;width:150px;height:22px">
    <Waveform w={150} h={22} semilla={0x03b2} variante="peine" n={110} inercia={0.2} envolvente={0.9} grosor={0.55} margen={2} />
  </div>
</div>

<style>
  .pan {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .pan text {
    font-family: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
    font-variant-ligatures: none;
    white-space: pre;
  }

  /* ── paleta local, medida ───────────────────────────────────────────── */
  /* violeta rgb(105,79,144) · tinta rgb(~84,82,80) · oro rgb(~122,104,86) */

  .pan-orn path { fill: none; stroke: #4a4744; stroke-width: 1; opacity: 0.4; }
  .pan-orn__pto { fill: #4a4744; opacity: 0.4; }

  /* La Y del cenit es serif y dorada — medida rgb(152,136,120) en el asta. */
  .pan-y {
    font-family: "Cormorant Garamond", "Cormorant", Didot, serif !important;
    font-size: 30px;
    text-anchor: middle;
    fill: #7a6448;
    opacity: 0.85;
  }
  .pan-yinf { font-size: 13px; text-anchor: middle; fill: #7a6448; opacity: 0.7; }
  .pan-nodo { font-size: 15px; text-anchor: middle; fill: #6a5540; opacity: 0.9; }

  .pan-tit { font-size: 12.5px; letter-spacing: 0.12em; fill: #6a4f97; opacity: 0.8; }
  .pan--fin { text-anchor: end; }
  .pan--centro { text-anchor: middle; }
  /* Doble selector a propósito: la clase se usa en el <g> Y directamente en
     <text> sueltos (SIGNATURE, RETURN SEAL) — con `.pan-txt text` solo, esos
     sueltos caían al fill negro por defecto del SVG. Pasó y se vio. */
  .pan-txt text,
  text.pan-txt { font-size: 10.5px; letter-spacing: 0.06em; fill: #4a4744; opacity: 0.68; }
  .pan-micro { font-size: 9.5px; letter-spacing: 0.1em; fill: #4a4744; opacity: 0.55; }
  .pan-clave { font-size: 12px; fill: #6a4f97; opacity: 0.78; }

  .pan-astro path { fill: none; stroke: #6a4f97; stroke-width: 0.9; opacity: 0.6; }
  .pan-astro__guia { opacity: 0.35 !important; }
  .pan-astro circle { fill: #6a4f97; opacity: 0.7; }

  .pan-caja rect { fill: none; stroke: #4a4744; stroke-width: 1; opacity: 0.13; }
  .pan-caja__esq { fill: none; stroke: #4a4744; stroke-width: 1; opacity: 0.35; }
  .pan-caja--stmt rect { opacity: 0.22; }

  .pan-ruta path { fill: none; stroke: #6a4f97; stroke-width: 0.8; opacity: 0.45; }
  .pan-ruta__circ { fill: none; stroke: #4a4744; stroke-width: 0.8; opacity: 0.4; }
  .pan-ruta__letra {
    font-size: 8.5px;
    text-anchor: middle;
    fill: #6a5540;
    opacity: 0.85;
    stroke: none;
  }
  .pan-ruta__pto { fill: #6a4f97; opacity: 0.6; }
  .pan-ruta__cierre { stroke: #6a4f97 !important; opacity: 0.6 !important; }

  .pan-rel__letra { font-size: 11px; fill: #6a5540; opacity: 0.85; }
  .pan-rel__nombre { font-size: 10px; letter-spacing: 0.05em; fill: #4a4744; opacity: 0.75; }
  .pan-rel__sub { font-size: 8.5px; letter-spacing: 0.05em; fill: #4a4744; opacity: 0.45; }

  .pan-sello__aro { fill: none; stroke: #4a4744; stroke-width: 0.8; opacity: 0.3; }
  .pan-sello__oro { fill: none; stroke: #b08a50; stroke-width: 1; opacity: 0.45; }
  .pan-sello__aro2 { fill: none; stroke: #6a4f97; stroke-width: 0.7; opacity: 0.4; }
  .pan-sello__tic { stroke: #6a4f97; stroke-width: 0.7; opacity: 0.4; }
  .pan-sello__petalo { fill: rgba(200, 184, 216, 0.28); stroke: #6a4f97; stroke-width: 0.8; stroke-opacity: 0.55; }
  .pan-sello__nucleo { fill: #6a4f97; opacity: 0.6; }

  .pan-kv text { font-size: 10px; letter-spacing: 0.04em; fill: #4a4744; opacity: 0.7; }
  .pan-kv__vio { fill: #6a4f97; }

  .pan-q__circ { fill: none; stroke: #6a4f97; stroke-width: 0.7; opacity: 0.45; }
  .pan-q__q { font-size: 9.5px; fill: #6a4f97; opacity: 0.75; }
  .pan-q__texto { font-size: 9px; letter-spacing: 0.03em; fill: #4a4744; opacity: 0.62; }

  .pan-core { font-size: 15px; letter-spacing: 0.22em; fill: #6a4f97; opacity: 0.85; }
  .pan-stmt-tit { font-size: 12.5px; letter-spacing: 0.28em; fill: #4a4744; opacity: 0.6; }
  .pan-stmt text { font-size: 11.5px; letter-spacing: 0.12em; text-anchor: middle; fill: #3f3c3a; opacity: 0.8; }
  .pan-eco text { font-size: 10.5px; letter-spacing: 0.1em; text-anchor: middle; fill: #4a4744; opacity: 0.42; }

  .pan-onda { position: absolute; color: #6a4f97; opacity: 0.75; }
</style>
