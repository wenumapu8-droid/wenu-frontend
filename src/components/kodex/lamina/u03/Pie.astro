---
/**
 * KODEX-∞ · u03-return · PIE — banda inferior.
 *
 * Esta lámina remata sencillo: la frase de la serie MONTADA SOBRE la regla
 * (como u01), la banda de tres columnas y el sello. Medido por barrido:
 *   · regla y=1309 de 49,5 a 1072,5 con un hueco x≈340..782 donde vive la
 *     frase — tinta de la frase x=364..758, línea base 1308;
 *   · KDX-RETURN-0003 x=68..181, base 1331 — tinta gris;
 *   · PROTOCOL SEALED x=68..171, base 1350 — violeta;
 *   · ONE SOURCE base 1331 y INFINITE EXPRESSIONS base 1350, alineados a la
 *     derecha en x≈990 — tinta gris;
 *   · sello hexagonal centro (1028,1336), R 35,5 — vértices en y=1301 y 1371.
 *
 * `KDX-RETURN-0003 / PROTOCOL SEALED` es ficción del póster: PieUniverse ya
 * lo marca data-symbolic.
 */
import PieUniverse from "../serie-universe/PieUniverse.astro";
import { romboR } from "../serie-universe/geom";

const vars = [
  "--pi-ink:#4a4744",
  "--pi-vio:#6a4f97",
  "--pi-cod-fill:#4a4744",
  "--pi-cod-a:.72",
  "--pi-cod-ls:.04em",
  "--pi-est-fill:#6a4f97",
  "--pi-est-a:.68",
  "--pi-lema-ls:.22em",
  "--pi-lema-a:.7",
  "--pi-lema-tr:translateX(1.3px)",
  "--pi-fuente-fill:#4a4744",
  "--pi-fuente-ls:.08em",
  "--pi-fuente-a:.66",
  "--pi-fuente-tr:translateX(0.85px)",
  "--pi-expr-a:.66",
  "--pi-hex-a:.4",
  "--pi-rosa-a:.62",
  "--pi-pelo-a:.5",
].join(";");
---

<PieUniverse
  vars={vars}
  codigo={{ x: 68, y: 1331, t: "KDX-RETURN-0003" }}
  estado={{ x: 68, y: 1350, t: "PROTOCOL SEALED" }}
  lema={{ x: 561, y: 1308, anchor: "middle", len: 394, t: "THE KODEX IS LIVING. YOU ARE PART OF IT." }}
  fuente={{ x: 990, y: 1331, anchor: "end", t: "ONE SOURCE" }}
  expr={{ x: 990, y: 1350, anchor: "end", t: "INFINITE EXPRESSIONS" }}
  sello={{ cx: 1028, cy: 1336, R: 35.5 }}
>
  <Fragment slot="antes">
    <!-- La regla del pie, abierta en el medio para la frase. -->
    <path class="pie-regla__linea" d="M49.5 1309H340M782 1309H1072.5" />
    <!-- Ornamento central de la regla de cierre (y=1388,5): rombo con punto
         y punteo a los lados, centrado en el eje — col x=561 da tinta en
         y=1381..1395, es lo único que el marco no pone. -->
    <g class="pie-cierre">
      <path d="M561 1381.5L568 1388.5L561 1395.5L554 1388.5Z" />
      <circle cx="561" cy="1388.5" r="1.1" />
      <circle cx="545" cy="1388.5" r="1" />
      <circle cx="577" cy="1388.5" r="1" />
      <path class="pie-cierre__punteo" d="M480 1388.5H538M584 1388.5H642" stroke-dasharray="1.5 5" />
    </g>
  </Fragment>

  <Fragment slot="cruces">
    <g class="pie-cierre">
      <path d={romboR(347, 1305, 4)} />
      <path d={romboR(775, 1305, 4)} />
      <circle cx="356.5" cy="1305" r="1" />
      <circle cx="765.5" cy="1305" r="1" />
    </g>
  </Fragment>
</PieUniverse>

<style>
  .pie-regla__linea {
    fill: none;
    stroke: #4a4744;
    stroke-width: 1;
    stroke-opacity: 0.2;
  }
  .pie-cierre path {
    fill: none;
    stroke: #4a4744;
    stroke-width: 0.9;
    stroke-opacity: 0.5;
  }
  .pie-cierre circle {
    fill: #4a4744;
    fill-opacity: 0.5;
  }
  .pie-cierre__punteo {
    stroke-opacity: 0.3;
  }
</style>
