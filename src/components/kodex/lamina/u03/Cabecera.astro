---
/**
 * KODEX-∞ · u03-return · CABECERA
 *
 * El cromo lo pone `serie-universe/CabeceraUniverse.astro`; acá van sólo los
 * números medidos sobre `reference/canon/u03-return.png` (1122×1402) barriendo
 * filas y columnas con umbral de luminancia — ninguno estimado a ojo.
 *
 * LO PRIMERO QUE SE MIDIÓ ES EL FONDO, porque esta lámina NO es sobre negro:
 * diez muestras de zonas vacías dan rgb(247±2, 244±2, 241±3) — blanco hueso
 * cálido. Eso invierte el sentido de todas las opacidades: acá «tenue» es
 * CLARO, y la tinta es más oscura que el papel.
 *
 * Medidas clave:
 *  · marco exterior — verticales x=11,5 y 1111,5; regla superior y=11,
 *    inferior y=1388,5. Chaflán de esquina ~13 px.
 *  · marco interior — verticales x=49,5 y 1072,5 de y=82 a 1290; travesaño
 *    superior y=83,5 y separador de bajada y=264,5, los dos de lado a lado.
 *  · título — KODEX con versal 110..171 (cap 61) y tinta x=127..458; RETURN
 *    con versal 114..171 (cap 57) y tinta x=698..1006. NO tienen el mismo
 *    cuerpo, igual que en u02. OJO CON LA X: sus dos diagonales dan dos
 *    tramos de tinta por fila arriba y abajo y UNO en el centro (418..456,
 *    cruce en 438,141) — en la primera vuelta ese patrón se leyó como un
 *    ornamento aparte y KODEX quedó corto. El recorte lado a lado lo delató.
 *  · guion en x=475..495, y≈140 — sólo aparece en las filas del medio.
 *  · ∞ de exhibición centrado en (561,5 · 141,5), tinta x=512..612, y=120..163.
 *  · barra «/» de (649,171) a (670,111) — el corrimiento por fila da la
 *    pendiente: 667 en y=125, 652 en y=158.
 *  · OPEN WHITE — violeta, tinta x=454..663, versal 197..208.
 *  · bajada — sig x=81..148, lema x=342..779, pag x=977..1040, línea base 244.
 */
import CabeceraUniverse from "../serie-universe/CabeceraUniverse.astro";
import { rayos, rombo } from "../serie-universe/geom";

const chaflanes = [
  "M11.5 25L25 11.5",
  "M1098 11.5L1111.5 25",
  "M1111.5 1375L1098 1388.5",
  "M25 1388.5L11.5 1375",
];

/* Rieles exteriores: medidos por tramos sobre las columnas x=11 y x=1111.
   El izquierdo corre casi entero macizo de 403 a 780; el derecho tiene la
   zona alta ocupada por microtexto (va punteada). */
const rielIzq: [number, number, boolean][] = [
  [24, 111, true], [119, 178, false], [216, 286, true], [290, 347, false],
  [359, 398, false], [403, 780, true], [880, 1375, true],
];
const rielDer: [number, number, boolean][] = [
  [24, 82, true], [342, 579, true], [583, 1375, true],
];

const EJE_I = 11.5;
const EJE_D = 1111.5;

/* La paleta se declara acá porque NO es común a la serie, y ésta menos que
   ninguna: tinta gris cálida sobre papel hueso, violeta medido en OPEN WHITE
   rgb(105,79,144), título gris piedra rgb(~132,124,118) en el cuerpo de las
   astas. Las opacidades por defecto del cromo (calibradas sobre negro) siguen
   valiendo en espíritu —tenue sigue siendo tenue— pero la tinta de regla y
   bajada acá pesa más, y eso se pisa variable por variable. */
const vars = [
  "--cb-ink:#4a4744",
  "--cb-vio:#6a4f97",
  "--cb-tit:#79716b",
  "--cb-regla-op:.55",
  "--cb-regla-der-op:.48",
  "--cb-cruz-op:.5",
  "--cb-sig-size:13px",
  "--cb-lema-size:13px",
  "--cb-pag-size:13px",
  "--cb-sig-op:.68",
  "--cb-lema-op:.72",
  "--cb-pag-op:.6",
  "--cb-nota-size:16px",
  "--cb-nota-fill:#6a4f97",
  "--cb-nota-op:.85",
  "--cb-marco-op:.16",
  "--cb-interior-op:.09",
  "--cb-interior-tra-op:.09",
  "--cb-interior-regla-op:.12",
  "--cb-riel-op:.14",
  "--cb-folio-op:.3",
].join(";");
---

<CabeceraUniverse
  gradId="u03"
  grad={["#8a827b", "#79716b", "#6b635d"]}
  ariaLabel="KODEX-∞ / RETURN — página 03 · The convergent return · All paths lead home."
  vars={vars}
  marcoSup="M30 11.5H500M622 11.5H1092"
  marcoInf={{ d: "M30 1388.5H1092", tenue: false }}
  fantasma="M11.5 25V1375M1111.5 25V1375"
  chaflanes={chaflanes}
  nodosSup={[{ x: 495, y: 11.5, r: 1.8 }, { x: 627, y: 11.5, r: 1.8 }]}
  interior="M49.5 82V1290M1072.5 82V1290"
  interiorTra="M49.5 83.5H1072.5"
  interiorRegla="M49.5 264.5H1072.5"
  cruces={[[38, 45], [1086, 45]]}
  reglaIzq={{ x: 65, y: 49, len: 198, t: "KODEX-∞ UNIVERSE" }}
  reglaDer={{ x: 823, y: 49, len: 236, t: "OBSERVE. DECIPHER. TRANSCEND." }}
  reglaCy={45}
  puntosRegla={[276, 292, 330, 347, 750, 770, 784]}
  nodosRegla={[309, 800]}
  punteo={{ d: "M357 45H505M611 45H716" }}
  hex={{
    borde: "M560.5 14.5L590 29.5V59L560.5 74L531 59V29.5Z",
    tics: "M531.5 28.5h4M585.5 28.5h4M531.5 59.5h4M585.5 59.5h4",
    inf: [560.5, 44, 13, 10.5],
  }}
  titKodex={{ x: 127, y: 170.5, size: 97, len: 331, t: "KODEX" }}
  titGuion={{ x: 475, y: 139.7, w: 20, h: 3.8 }}
  titInf={[561.5, 141.5, 45.5, 34.5]}
  titBarra="M665.5 111.5L670 111.5L653.5 171.5L649 171.5Z"
  titPalabra={{ x: 698, y: 170.5, size: 91, len: 308, t: "RETURN" }}
  sig={{ x: 81, y: 244, len: 67, t: "Y / +∞" }}
  lema={{ x: 342, y: 243.5, len: 437, t: "THE CONVERGENT RETURN // ALL PATHS LEAD HOME" }}
  pag={{ x: 977, y: 244, len: 63, t: "PAGE 03" }}
  ejeI={EJE_I}
  ejeD={EJE_D}
  rielIzq={rielIzq}
  rielDer={rielDer}
  micropunteo={[[783, 795], [804, 875]]}
  micro={[
    { transform: "translate(8.5 950) rotate(-90)", len: 165, t: "* KODEX ARCHIVES // *" },
    { transform: "translate(1108.6 340) rotate(-90)", len: 250, t: "BB 03 / KDXR / 088 · BB" },
  ]}
  folio={{ x: 1096.5, y: 616, len: 20, t: "03" }}
>
  <!-- Separadores de la bajada: rombo a cada lado del lema más punteo. -->
  <g class="cab__sep" slot="sep">
    <path d={rombo(258, 239.5, 10, 8)} />
    <path d={rombo(863, 239.5, 10, 8)} />
    <path class="cab__punteo" d="M272 239.5H328M792 239.5H848" stroke-dasharray="9 4" />
  </g>

  <!-- OPEN WHITE: la línea violeta entre título y bajada, con sus puntos. -->
  <Fragment slot="nota">
    <text class="cab__nota" x="454" y="208.5" textLength="209" lengthAdjust="spacing">OPEN WHITE</text>
    <g class="cab__nodo">
      <circle cx="426" cy="204" r="2" />
      <circle cx="697" cy="204" r="2" />
      <circle cx="344" cy="204.5" r="1.3" />
      <circle cx="779" cy="204.5" r="1.3" />
    </g>
  </Fragment>

  <g class="cab__glifo" slot="glifos">
    <!-- Racimo del riel izquierdo, a la altura de OPEN WHITE. -->
    <path d={rayos(EJE_I, 200.5, 4.5, 8, Math.PI / 8)} />
    <circle cx={EJE_I} cy={200.5} r="1.4" />
  </g>
</CabeceraUniverse>
