---
/**
 * KODEX-∞ · u06-memory · PIE — y 1290..1402. Medido:
 *  · lema "TO REMEMBER IS TO CHOOSE A FUTURE." centrado en x=561, base 1304
 *    (tinta x 378..742 → 34 caracteres a ~10,7 px de paso), con reglas a los
 *    lados (60..330 / 792..1062), anillos abiertos y cruces de cierre;
 *  · caja de la banda x 60..985 · y 1323..1373, punteada tenue;
 *  · KDX-MEM-006 base 1344 y PROTOCOL ACTIVE base 1361, violeta, x 79;
 *  · ONE SOURCE / INFINITE EXPRESSIONS a la derecha contra x=958;
 *  · sello hexagonal cx 1012 · cy 1347 · R 28 (lados x 986..1038);
 *  · marco inferior y=1391,5 y el punteo con ◇ central en y=1396.
 *
 * `KDX-MEM-006 / PROTOCOL ACTIVE` es ficción del póster: PieUniverse ya lo
 * marca data-symbolic="true".
 */
import PieUniverse from "../serie-universe/PieUniverse.astro";
import { rombo } from "../serie-universe/geom";

/* Paleta de u06 + calibrado por alfas de pintura. */
const vars = [
  "--pi-ink:#d8d4d0",
  "--pi-vio:#b18ae0",
  "--pi-cod-size:10px",
  "--pi-cod-ls:.14em",
  "--pi-cod-a:.6",
  "--pi-lema-size:12px",
  "--pi-lema-ls:.175em",
  "--pi-lema-a:.55",
  "--pi-lema-tr:translateX(1.05px)",
  "--pi-fuente-size:9.6px",
  "--pi-fuente-ls:.12em",
  "--pi-fuente-a:.6",
  "--pi-fuente-tr:translateX(1.15px)",
  "--pi-expr-size:9.6px",
  "--pi-expr-a:.45",
  "--pi-hex-a:.38",
  "--pi-rosa-a:.65",
  "--pi-pelo-a:.5",
].join(";");
---

<PieUniverse
  vars={vars}
  codigo={{ x: 79, y: 1344, t: "KDX-MEM-006" }}
  estado={{ x: 79, y: 1361, t: "PROTOCOL ACTIVE" }}
  lema={{ x: 561, y: 1304, anchor: "middle", t: "TO REMEMBER IS TO CHOOSE A FUTURE." }}
  fuente={{ x: 958, y: 1344, anchor: "end", t: "ONE SOURCE" }}
  expr={{ x: 958, y: 1361, anchor: "end", t: "INFINITE EXPRESSIONS" }}
  sello={{ cx: 1012, cy: 1347, R: 28 }}
>
  <Fragment slot="antes">
    <!-- Regla del lema, partida por el texto, con anillos y cruces. -->
    <path class="u06pie__regla" d="M60 1300.5H330M792 1300.5H1062" />
    <path class="u06pie__cierre" d="M48 1296.3v8.4m-4.2 -4.2h8.4M1073.8 1296.3v8.4m-4.2 -4.2h8.4" />
    <circle class="u06pie__anillo" cx="344" cy="1300.5" r="2.4" />
    <circle class="u06pie__anillo" cx="778" cy="1300.5" r="2.4" />
    <path class="u06pie__cierre" d="M356 1296.3v8.4m-4.2 -4.2h8.4M766 1296.3v8.4m-4.2 -4.2h8.4" />

    <!-- Caja de la banda, con muescas en las esquinas. -->
    <path class="u06pie__banda" d="M66.5 1322.5H979.5M985.5 1328.5V1367.5M979.5 1373.5H66.5M60.5 1367.5V1328.5" />
    <path class="u06pie__muesca" d="M60.5 1328.5L66.5 1322.5M979.5 1322.5L985.5 1328.5M985.5 1367.5L979.5 1373.5M66.5 1373.5L60.5 1367.5" />

    <!-- Marco inferior y punteo ornamental con rombo central. -->
    <path class="u06pie__marco" d="M31 1391.5H1084" />
    <g class="u06pie__orna">
      <path class="u06pie__punteo" d="M497 1396.5H543M579 1396.5H625" stroke-dasharray="1.5 4" />
      <path d={rombo(561, 1396.5, 10, 8)} />
      <circle cx="561" cy="1396.5" r="1.2" />
    </g>
  </Fragment>
</PieUniverse>

<style is:global>
  .u06pie__regla {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 1;
    stroke-opacity: 0.12;
  }
  .u06pie__cierre {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 1;
    stroke-opacity: 0.4;
  }
  .u06pie__anillo {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 0.9;
    stroke-opacity: 0.4;
  }
  .u06pie__banda {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 1;
    stroke-opacity: 0.13;
  }
  .u06pie__muesca {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 1;
    stroke-opacity: 0.2;
  }
  .u06pie__marco {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 1;
    stroke-opacity: 0.11;
  }
  .u06pie__orna path {
    fill: none;
    stroke: #d8d4d0;
    stroke-width: 0.9;
    stroke-opacity: 0.4;
  }
  .u06pie__orna .u06pie__punteo {
    stroke-opacity: 0.18;
  }
  .u06pie__orna circle {
    fill: #d8d4d0;
    fill-opacity: 0.4;
  }
</style>
