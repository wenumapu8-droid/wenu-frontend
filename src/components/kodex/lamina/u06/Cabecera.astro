---
/**
 * KODEX-∞ · u06-memory · CABECERA
 *
 * Cromo compartido de la serie con las props medidas sobre
 * `reference/canon/u06-memory.png` (1122×1402), barriendo filas y columnas con
 * umbral de luminancia. Lo que distingue a esta lámina:
 *
 *  · FONDO negro puro: doce muestras dan rgb(0,0,0)–rgb(1,1,1).
 *  · PALETA: título plata neutra (top-2 % de tinta rgb 203,202,199), cuerpo
 *    gris neutro (~75 de canal con tinta #d8d4d0 → alfa 0,35) y violeta
 *    apagado: los rótulos rinden ~rgb(103,87,121) al top-10 %, que con
 *    #b18ae0 pide alfa ≈ 0,55.
 *  · HEXÁGONO centro x=560 (u02: 561,5; u05: 534,5), vértices y=16 e y=64.
 *  · MARCO INTERIOR: caja completa x 51..1063 · y 75..1276, mucho más
 *    presente que en u02 (columnas con frac 1,0 a umbral 18): sube
 *    --cb-interior-op a 0,15.
 *  · Marco inferior en y=1391,5 — lo dibuja el Pie con su ornamento.
 *  · Título y 100..155 (versal 55 → cuerpo 88): KODEX x 93..415,
 *    guion 423..442, ∞ 458..538, barra 564..587, MEMORY x 617..976.
 *  · Bajada IZQUIERDA: "TEMPORAL ARCHAEOLOGY" x 92..346, base 188 — esta
 *    lámina no tiene lema centrado; el centro lo ocupa la nota de dos líneas.
 *  · PAGE 06 x 962..1028, base 188.
 */
import CabeceraUniverse from "../serie-universe/CabeceraUniverse.astro";
import { rayos } from "../serie-universe/geom";

const chaflanes = [
  "M12.5 26.5L29 12.5",
  "M1094 12.5L1108.5 26.5",
  "M1108.5 1377.5L1094 1391.5",
  "M27.5 1391.5L12.5 1377.5",
];

/* Rieles medidos por corridas: casi todo punteado; un solo tramo macizo a la
   izquierda (y 695..777). */
const rielIzq: [number, number, boolean][] = [
  [417, 495, false], [517, 590, false], [604, 660, false], [695, 777, true],
  [987, 1046, false], [1072, 1108, false], [1150, 1205, false],
];
const rielDer: [number, number, boolean][] = [
  [361, 562, false], [632, 791, false], [826, 1262, false],
];

/* Paleta de u06, medida — no se hereda de la serie. */
const vars = [
  "--cb-ink:#d8d4d0",
  "--cb-vio:#b18ae0",
  "--cb-tit:#d6d4d0",
  "--cb-regla-op:0.25",
  "--cb-regla-der-op:0.21",
  "--cb-lema-size:14px",
  "--cb-lema-op:0.58",
  "--cb-pag-size:13px",
  "--cb-pag-op:0.5",
  "--cb-nota-size:12.4px",
  "--cb-nota-op:0.38",
  "--cb-interior-op:0.15",
  "--cb-interior-esq-op:0.3",
  "--cb-cruz-op:0.38",
  /* El título de la referencia es plata llena, no gris: con el peso y la
     opacidad por defecto la copia salía un tono más liviana. */
  "--cb-tit-peso:500",
  "--cb-tit-op:0.85",
  "--cb-tit-fig-op:0.78",
  "--cb-tit-inf-sw:4.6",
  "--cb-tit-inf-op:0.88",
  "--cb-punteo-op:0.05",
].join(";");

/* Barcode de los rieles inferiores (y 1265..1334): ticks de anchos
   irregulares, deterministas — la lista es explícita, no azar. */
const barcode = (eje: number): string =>
  [1265, 1270.5, 1276, 1281.5, 1287.5, 1294, 1299.5, 1305, 1310.5, 1316.5, 1322, 1327.5, 1333]
    .map((y, i) => `M${eje - (i % 3 ? 2.4 : 3.6)} ${y}H${eje + (i % 3 ? 2.4 : 3.6)}`)
    .join("");

const izq = ["MEMORY IS STRATIFIED.", "TRUTH IS REVISITED.", "MEANING EMERGES."];
const der = ["NOTHING IS LOST.", "EVERYTHING ERODES.", "ONLY PATTERNS ENDURE.", "REVISITATION IS CREATION."];
const CHAR = 7.6; // avance medido del bloque de intro (21 caracteres en 160 px)
---

<CabeceraUniverse
  gradId="u06"
  grad={["#eae8e4", "#d6d4d0", "#a6a49f"]}
  ariaLabel="KODEX-∞ / MEMORY — página 06 · Temporal archaeology · The Kodex does not store memories. It excavates them."
  vars={vars}
  marcoSup="M31 12.5H526M596 12.5H1084"
  fantasma="M12.5 26.5V1377.5M1108.5 26.5V1377.5"
  chaflanes={chaflanes}
  nodosSup={[{ x: 531, y: 12.5, r: 1.5 }, { x: 591, y: 12.5, r: 1.5 }]}
  interior="M51.5 75.5H1063.5V1276.5H51.5Z"
  interiorEsq="M51.5 89.5V75.5H65.5M1049.5 75.5H1063.5V89.5M1063.5 1262.5V1276.5H1049.5M65.5 1276.5H51.5V1262.5"
  cruces={[[38, 43], [1080.5, 43]]}
  reglaIzq={{ x: 64, y: 47, len: 177, t: "KODEX-∞ UNIVERSE" }}
  reglaDer={{ x: 801, y: 47, len: 244, t: "OBSERVE. DECIPHER. TRANSCEND." }}
  reglaCy={43}
  puntosRegla={[266, 781]}
  nodosRegla={[]}
  punteo={{ d: "M298 43H508M612 43H758", dash: "1 6" }}
  hex={{
    borde: "M560 16L583 29V51L560 64L537 51V29Z",
    tics: "M537.5 27.5h4M579.5 27.5h4M537.5 52.5h4M579.5 52.5h4",
    tallo: "M560 63.5V70",
    inf: [560, 40, 12.4, 10],
  }}
  titKodex={{ x: 93, y: 155.5, size: 88, len: 322, t: "KODEX" }}
  titGuion={{ x: 423, y: 125.6, w: 19.5, h: 3.7 }}
  titInf={[498, 127.5, 38, 29.5]}
  titBarra="M583.5 100.5L588 100.5L568.5 155.5L564 155.5Z"
  titPalabra={{ x: 617, y: 155.5, size: 88, len: 359, t: "MEMORY" }}
  sig={{ x: 75, y: 188, t: "" }}
  lema={{ x: 92, y: 188, len: 254, t: "TEMPORAL ARCHAEOLOGY" }}
  pag={{ x: 962, y: 188, len: 66, t: "PAGE 06" }}
  ejeI={12.5}
  ejeD={1108.5}
  rielIzq={rielIzq}
  rielDer={rielDer}
  nodosIzq={[292, 398.5, 785, 948.5, 1378.5]}
  nodosDer={[357.5, 564.5, 793.5, 822.5, 1378.5]}
  micro={[
    { transform: "translate(1111.8 232) rotate(-90)", len: 160, t: "BW 8B XR/XK X6 -- 8B" },
    { transform: "translate(11 936) rotate(-90)", len: 76, t: "KDX AECITE //" },
  ]}
  folio={{ x: 1099, y: 601, len: 14.5, t: "06" }}
>
  <Fragment slot="nota">
    <text class="cab__nota" x="437" y="195" textLength="303" lengthAdjust="spacing">THE KODEX DOES NOT STORE MEMORIES.</text>
    <text class="cab__nota" x="511" y="217" textLength="157" lengthAdjust="spacing">IT EXCAVATES THEM.</text>
  </Fragment>

  <g class="cab__glifo" slot="glifos">
    <!-- Riel izquierdo · escalerilla alta (y 113..183, ticks cada 6-7 px) -->
    <path d={Array.from({ length: 11 }, (_, i) => `M9.7 ${113.5 + i * 6.9}H15.3`).join("")} />
    <circle cx="12.5" cy="292" r="4.2" />
    <path d={rayos(12.5, 320, 4.2, 8)} />
    <path d="M8.5 336l4 5l4 -5M12.5 341v4" />
    <path d={rayos(12.5, 361, 3.4, 6, Math.PI / 6)} />
    <!-- micro-marcas de la columna (y 876..935) -->
    <path d={Array.from({ length: 9 }, (_, i) => `M10.6 ${876.5 + i * 7.2}H14.4`).join("")} />
    <path d={barcode(12.5)} />
    <!-- Riel derecho · escalerilla y barcode -->
    <path d={Array.from({ length: 9 }, (_, i) => `M1105.7 ${112.5 + i * 7.3}H1111.3`).join("")} />
    <path d={barcode(1108.5)} />
  </g>

  <!-- Bloques de intro, propios de esta lámina. -->
  <g class="u06-intro">
    {izq.map((t, i) => (
      <text class="u06-intro__lin" x="88" y={223 + i * 19} textLength={t.length * CHAR}>{t}</text>
    ))}
    <!-- Garabato de cierre bajo el bloque izquierdo (y ≈ 287): rayado + guiones. -->
    <path class="u06-intro__garabato" d="M89 289l4 -5m2 5l4 -5m2 5l4 -5m2 5l4 -5m2 5l4 -5m2 5l4 -5M126 287h7m5 0h3m7 0h2m6 0h8m6 0h3" />
    <text class="u06-intro__lab" x={1021 - 14 * CHAR} y="223" textLength={14 * CHAR}>ARCHIVE AXIOMS</text>
    {der.map((t, i) => (
      <text class="u06-intro__lin" x={1028 - t.length * CHAR} y={243 + i * 17.6} textLength={t.length * CHAR}>{t}</text>
    ))}
    <!-- Sismograma de cierre del bloque derecho (y ≈ 316). -->
    <path class="u06-intro__garabato" d="M905 317h14l2 -5l2 5l3 -9l3 9l2 -4l2 4h9l2 -7l2 7l3 -11l3 13l2 -2h8l2 -4l2 4h12m8 0h6m5 0h9" />
  </g>
</CabeceraUniverse>

<style is:global>
  .u06-intro__lab {
    font-size: 11px;
    fill: var(--cb-vio);
    fill-opacity: 0.55;
  }
  .u06-intro__lin {
    font-size: 11px;
    fill: var(--cb-ink);
    fill-opacity: 0.35;
  }
  .u06-intro__garabato {
    fill: none;
    stroke: var(--cb-ink);
    stroke-width: 0.8;
    stroke-opacity: 0.3;
    stroke-linejoin: round;
  }
</style>
