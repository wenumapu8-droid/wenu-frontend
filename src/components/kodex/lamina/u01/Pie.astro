---
/**
 * KODEX-∞ · u01-origin-field · PIE — banda inferior, y 1265..1400 del póster.
 *
 * Tres piezas:
 *   1. Regla con la frase montada encima      y 1275   (acá)
 *   2. Pie en tres columnas                   y 1327..1347
 *   3. Sello hexagonal                        centro (1011,5 · 1333) R 38
 *   4. Remate del canto                       y 1386   (acá)
 *
 * Las piezas 2 y 3 las pone `serie-universe/PieUniverse.astro`, que es el mismo
 * remate de las cinco láminas de la serie. Las otras dos son de esta página y
 * van por los slots `antes` y `despues`.
 *
 * COORDENADAS. El bloque va con `inset:0` sobre el lienzo entero, así que las
 * x/y de este archivo son las del póster sin corrimiento: lo que se lee acá se
 * puede buscar tal cual en `reference/canon/u01-origin-field.png`.
 *
 * DIFERENCIA CON u02, y no es de detalle: allá la frase «THE KODEX IS LIVING…»
 * vive ABAJO del todo, en y=1333, entre las dos columnas de códigos. Acá está
 * ARRIBA, montada sobre la regla de y=1275 que cierra la lámina, y sin el
 * artículo inicial: «KODEX IS LIVING. YOU ARE PART OF IT.». La banda de códigos
 * queda entonces sola, 45 px más abajo, y por eso esta lámina NO le pasa `lema`
 * al componente compartido: su frase no es la de la banda.
 *
 * MEDIDO, NO ELEGIDO:
 *   - la frase arranca en x=383 con un avance de 10,03 px por carácter (versal
 *     de 8 px, o sea 0,312em de interletrado). Puesto «a ojo» en 0,2em la línea
 *     sale 80 px corta.
 *   - los adornos que la flanquean —regla, punto, anillo, cruz— son simétricos
 *     respecto de x=557,5 y NO del eje del marco, que cae en 561.
 *   - `KDX-ORIGIN-0001` y `PROTOCOL INITIATED` tienen la misma versal (9 px) y
 *     el mismo ancho de caja (130 px), pero 15 y 18 caracteres: el póster ajustó
 *     cada uno a la caja, así que el interletrado es 0,144em y 0,007em. Un solo
 *     valor para los dos deja una de las dos líneas 20 px larga.
 *   - la rosa del sello de esta lámina NO es la de las otras cuatro: su núcleo
 *     mide 3,5 contra 3,4 y los travesaños del eje horizontal caen en otro
 *     sitio. No es un escalado del mismo dibujo, así que va con su propio juego
 *     de constantes (`ROSA_U01` en `geom.ts`) en vez de forzarse a un factor
 *     común que no existe.
 *
 * TELEMETRÍA SIMBÓLICA. `KDX-ORIGIN-0001 / PROTOCOL INITIATED` es ficción del
 * póster, no estado de ningún sistema. Va marcado `data-symbolic="true"`.
 */
import PieUniverse from "../serie-universe/PieUniverse.astro";
import { rombo, cruz } from "../serie-universe/geom";

const vars = [
  "--pi-ink:#cfccc6",
  "--pi-vio:#b79ee0",
  /* Versal 9 px → cuerpo 12. Los dos códigos comparten caja pero no
     interletrado: 8,93 y 7,29 de avance. */
  "--pi-cod-size:12px",
  "--pi-cod-ls:.144em",
  "--pi-cod-op:.58",
  "--pi-est-ls:.007em",
  "--pi-est-op:.56",
  /* Todo el pie de esta lámina se calibró con `opacity`, no con las alfas de
     pintura: los mandos `-op` son los que corresponden. */
  /* Alineados a la derecha: la corrección del interletrado sobrante es una
     letra entera, no media. */
  "--pi-fuente-size:11px",
  "--pi-fuente-ls:.026em",
  "--pi-fuente-op:.46",
  "--pi-fuente-tr:translateX(2.8px)",
  "--pi-expr-ls:.041em",
  "--pi-expr-op:.42",
  "--pi-expr-tr:translateX(2.9px)",
  "--pi-hex-sw:1.1",
  "--pi-hex-op:.55",
  "--pi-rosa-op:.9",
  "--pi-pelo-op:.7",
].join(";");
---

<PieUniverse
  vars={vars}
  codigo={{ x: 82, y: 1327.5, t: "KDX-ORIGIN-0001" }}
  estado={{ x: 82, y: 1346.5, t: "PROTOCOL INITIATED" }}
  fuente={{ x: 962, y: 1329.5, anchor: "end", t: "ONE SOURCE" }}
  expr={{ x: 962, y: 1346.5, anchor: "end", t: "INFINITE EXPRESSIONS" }}
  sello={{ cx: 1011.5, cy: 1333, R: 38, cfg: "u01" }}
>
  <Fragment slot="antes">
    <!-- ═══ 1 · REGLA CON LA FRASE ═══════════════════════════════════════ -->
    <g class="pie-regla">
      <path class="pie-regla__linea" d="M50 1275.5H310M806 1275.5H1066" />
      <circle class="pie-regla__pto" cx="313.5" cy="1275.5" r="1.2" />
      <circle class="pie-regla__pto" cx="802" cy="1275.5" r="1.2" />
      <circle class="pie-regla__aro" cx="318.5" cy="1275.5" r="3.4" />
      <circle class="pie-regla__aro" cx="796.5" cy="1275.5" r="3.4" />
      <path class="pie-regla__cruz" d={cruz(356, 1275.5, 4.6)} />
      <path class="pie-regla__cruz" d={cruz(762, 1275.5, 4.6)} />
      <circle class="pie-regla__pto" cx="1070.5" cy="1275.5" r="1.2" />
    </g>
    <text class="pie-t pie-t--frase" x="383" y="1277.5">KODEX IS LIVING. YOU ARE PART OF IT.</text>
  </Fragment>

  <Fragment slot="despues">
    <!-- ═══ 4 · REMATE DEL CANTO ═════════════════════════════════════════
         El rombo del borde inferior mide 8×13 y se apoya sobre la regla de
         cierre que traza la Cabecera. El tramo central va más brillante que el
         resto de la regla: medido, 26 contra 42 de media. -->
    <g class="pie-canto">
      <path class="pie-canto__realce" d="M499 1387.5H622" />
      <path class="pie-canto__rombo" d={rombo(561, 1386.5, 8, 13)} />
    </g>
  </Fragment>
</PieUniverse>

<style>
  /* Sólo lo de esta lámina: la banda de tres columnas y el sello los viste
     `PieUniverse` con las variables `--pi-*` de arriba. */
  /* Versal 8 px → cuerpo 11; avance medido 10,03 → 0,312em. */
  /* `opacity` y no `fill-opacity`/`stroke-opacity`: es la propiedad contra la
     que se calibró esta lámina y las dos NO rasterizan igual. Ver la nota de
     `PieUniverse`. */
  .pie-t--frase {
    font-size: 11px;
    letter-spacing: 0.312em;
    fill: #cfccc6;
    opacity: 0.58;
  }

  .pie-regla__linea {
    fill: none;
    stroke: #cfccc6;
    stroke-width: 1;
    opacity: 0.36;
  }
  .pie-regla__pto {
    fill: #cfccc6;
    opacity: 0.55;
  }
  .pie-regla__aro {
    fill: none;
    stroke: #cfccc6;
    stroke-width: 1;
    opacity: 0.55;
  }
  .pie-regla__cruz {
    fill: none;
    stroke: #cfccc6;
    stroke-width: 1.1;
    opacity: 0.5;
  }

  .pie-canto__realce {
    fill: none;
    stroke: #cfccc6;
    stroke-width: 1;
    opacity: 0.28;
  }
  .pie-canto__rombo {
    fill: none;
    stroke: #cfccc6;
    stroke-width: 1;
    opacity: 0.42;
  }
</style>
