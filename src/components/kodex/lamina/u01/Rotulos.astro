---
/**
 * KODEX-∞ · u01-origin-field · RÓTULOS
 *
 * Los cuatro bloques de texto que rodean al campo, con sus guías y sus dos
 * instrumentos. Medidos sobre `reference/canon/u01-origin-field.png` barriendo
 * fila por fila y columna por columna con umbral, no estimados a ojo:
 *
 *   UNINTEGRATED POTENTIAL  x  93– 266  y  285– 353   (+ trama y regla en 378)
 *   LATENT RELATIONS        x 903–1031  y  285– 353   (+ señal en 378)
 *   UNKNOWN STATE           x  92– 192  y  613– 620   (+ guía hasta x=303)
 *   UNDEFINED BOUNDARIES    x  91– 162  y  790– 814   (+ guía hasta x=215)
 *   POTENTIAL NODES         x 917–1031  y  811– 876
 *
 * LO QUE ENSEÑÓ LA MEDICIÓN Y NO SE VE A OJO: el rótulo y su cuerpo no llevan
 * el mismo color. Los títulos dan rgb(139,123,159) en sus píxeles más
 * brillantes —violeta— y las líneas de cuerpo dan rgb(104,106,102), que es gris
 * neutro. En la miniatura los dos parecen «gris claro». Pintarlos del mismo
 * color aplana la jerarquía de la lámina entera, porque este par —título
 * violeta / cuerpo gris— se repite en los paneles y en el pie.
 *
 * Y el avance de carácter tampoco es uno solo: 8,10 px en UNINTEGRATED
 * POTENTIAL, 8,27 en LATENT RELATIONS, 7,75 en UNKNOWN STATE y 7,25 en
 * UNDEFINED BOUNDARIES, todos con la misma versal de 8 px. El póster ajustó cada
 * rótulo a su caja. Un solo `letter-spacing` para los cuatro deja dos de ellos
 * cortos y uno largo, y el banco lo ve como corrimiento de bloque.
 *
 * (Cuidado al deducir el avance: se divide por el número de PASOS, no de letras,
 * y los espacios cuentan como paso. UNKNOWN STATE dio primero 8,45 por contar 11
 * pasos donde hay 12, y el rótulo salió 10 px largo.)
 *
 * LOS DOS INSTRUMENTOS VAN CON EL KIT, no redibujados acá: `Micrografia` para
 * la trama rayada de la izquierda y `Waveform` en variante peine para la señal
 * de la derecha. Los dos dibujan con `rng(semilla)` de `kit/rng.ts` y nunca con
 * Math.random(): sin semilla, dos capturas de esta misma página dan puntajes
 * distintos y el banco mide ruido en vez de convergencia (kit/README.md).
 */
import Micrografia from "../kit/Micrografia.astro";
import Waveform from "../kit/Waveform.astro";

/** Borde derecho de tinta de la columna derecha, medido en las cuatro líneas. */
const DER = 1031;

/* Bloque superior izquierdo. La interlínea es 17 px exactos. */
const IZQ_CUERPO = [
  "THE FIELD PRECEDES ORDER.",
  "POTENTIAL WITHOUT DEFINITION.",
  "ALL PATHS UNWRITTEN.",
];
/* Bloque superior derecho, alineado a la derecha. */
const DER_CUERPO = ["NOTHING IS ISOLATED.", "RELATIONS EXIST", "BEFORE THEY APPEAR."];
/* Bloque inferior derecho. */
const NODOS_CUERPO = ["DORMANT.", "UNRESOLVED.", "AWAITING CONTACT."];

/** Guía horizontal con anillo de cierre: aparece dos veces, a distinta escala. */
const guia = (x0: number, x1: number, y: number) => `M${x0} ${y}H${x1}`;
---

<div data-bloque="Rotulos" style="inset:0">
  <svg class="rot" viewBox="0 0 1122 1402" width="1122" height="1402" aria-hidden="true">
    <!-- ═══ 1 · UNINTEGRATED POTENTIAL ═══════════════════════════════════ -->
    <text class="rot-t rot-t--tit" x="93" y="292.5">UNINTEGRATED POTENTIAL</text>
    {
      IZQ_CUERPO.map((linea, i) => (
        <text class="rot-t rot-t--cuerpo" x="93" y={318.5 + i * 17.3}>{linea}</text>
      ))
    }

    <!-- ═══ 2 · LATENT RELATIONS ═════════════════════════════════════════ -->
    <!-- Alineado a la derecha. En SVG el interletrado se suma TAMBIÉN después
         del último carácter, así que `text-anchor:end` deja el bloque una letra
         corrido: la corrección va en el CSS con translateX. -->
    <text class="rot-t rot-t--tit rot-t--der" x={DER} y="292.5">LATENT RELATIONS</text>
    {
      DER_CUERPO.map((linea, i) => (
        <text class="rot-t rot-t--cuerpo rot-t--der" x={DER} y={318.5 + i * 17.3}>{linea}</text>
      ))
    }

    <!-- ═══ 3 · UNKNOWN STATE ════════════════════════════════════════════ -->
    <text class="rot-t rot-t--tit rot-t--suelto" x="92" y="620.5">UNKNOWN STATE</text>
    <g class="rot-guia">
      <!-- Cuadradito de arranque: 8×8 con un punto dentro. -->
      <rect x="89.5" y="633" width="8.5" height="8.5" rx="1" />
      <circle class="rot-guia__pto" cx="93.75" cy="637.25" r="1.5" />
      <path d={guia(101, 286, 637.25)} />
      <circle class="rot-guia__hito" cx="273" cy="637.25" r="1.6" />
      <circle class="rot-guia__anillo" cx="295.5" cy="637.25" r="7" />
      <circle class="rot-guia__pto" cx="295.5" cy="637.25" r="2.1" />
    </g>

    <!-- ═══ 4 · UNDEFINED BOUNDARIES ═════════════════════════════════════ -->
    <text class="rot-t rot-t--cuerpo rot-t--boun" x="91" y="797.5">UNDEFINED</text>
    <text class="rot-t rot-t--cuerpo rot-t--boun" x="91" y="814.5">BOUNDARIES</text>
    <g class="rot-guia">
      <!-- Saeta de arranque, rellena y violeta: es el único triángulo de la
           lámina y marca la dirección de lectura. -->
      <path class="rot-guia__saeta" d="M90 827.5L101.5 833.2L90 838.9Z" />
      <circle class="rot-guia__pto" cx="107" cy="833.2" r="1.5" />
      <path d={guia(112, 198, 833.2)} />
      <circle class="rot-guia__anillo" cx="207.5" cy="833.2" r="7.5" />
      <circle class="rot-guia__pto" cx="207.5" cy="833.2" r="2.2" />
    </g>

    <!-- ═══ 5 · POTENTIAL NODES ══════════════════════════════════════════ -->
    <circle class="rot-guia__anillo" cx="880.5" cy="814" r="5" />
    <text class="rot-t rot-t--tit rot-t--der" x={DER} y="819.5">POTENTIAL NODES</text>
    {
      NODOS_CUERPO.map((linea, i) => (
        <text class="rot-t rot-t--cuerpo rot-t--der" x={DER} y={841.5 + i * 17.3}>{linea}</text>
      ))
    }

    <!-- ═══ 6 · REGLA DE LA TRAMA IZQUIERDA ══════════════════════════════ -->
    <!-- Rayas de largo desparejo, no un `stroke-dasharray` regular: en la
         referencia miden entre 4 y 13 px y ése es el detalle que separa un
         registro de un borde punteado de navegador. -->
    <g class="rot-rayas">
      {
        [
          [133, 12], [148, 8], [159, 5], [168, 13], [184, 4],
        ].map(([x, w]) => <rect x={x} y="377.6" width={w} height="1.6" />)
      }
    </g>

    <!-- Marca de arranque de la señal derecha: una uve corta, medida en x=946. -->
    <path class="rot-señal__marca" d="M944 379.5L947 375.5L950 379.5" />
    <path class="rot-señal__base" d="M950 378.5H1032" />
  </svg>

  <!-- Los dos instrumentos van fuera del SVG porque el kit trae su propio
       <svg>. Deterministas por semilla: mismo dibujo en cada render. -->
  <div class="rot-trama" style="left:93px;top:373.5px">
    <Micrografia
      w={38}
      h={9}
      semilla={0x1a05}
      renglon={2.2}
      marca={1.4}
      densidad={0.9}
      palabra={3.4}
      huecos={0}
      color="#b79ee0"
      opacidad={0.62}
    />
  </div>

  <div class="rot-señal" data-symbolic="true" style="left:988px;top:363px">
    <Waveform
      w={44}
      h={31}
      semilla={0x4e21}
      variante="peine"
      n={26}
      color="#cfccc6"
      grosor={0.75}
      inercia={0.16}
      envolvente={0.9}
      margen={1}
    />
  </div>
</div>

<style>
  .rot {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
  }

  /* ── tipografía ─────────────────────────────────────────────────────── */
  /* Los cuerpos y los interletrados salen de la versal y del avance medidos en
     el PNG, no de una escala tipográfica inventada:
       versal 8 px → cuerpo 11    · versal 7 px → cuerpo 9,6
       avance 8,1 / 8,27 / 8,45 / 7,25 según el rótulo
       avance 6,7 en todas las líneas de cuerpo */
  .rot-t {
    font-family: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
    font-variant-ligatures: none;
    white-space: pre;
  }
  /* La opacidad NO se eligió: los rótulos salieron 1,3 veces más brillantes
     que la referencia en la primera pasada —color medio de la tinta rgb(117,101,143)
     contra rgb(98,83,115)— y ese factor se repetía en las quince líneas de texto
     de la lámina. Es el error más caro de los baratos: no se ve mirando, y
     ensucia todas las regiones de texto a la vez. */
  .rot-t--tit {
    font-size: 11px;
    letter-spacing: 0.136em;
    fill: #b79ee0;
    opacity: 0.62;
  }
  .rot-t--cuerpo {
    font-size: 9.6px;
    letter-spacing: 0.098em;
    fill: #cfccc6;
    opacity: 0.53;
  }
  /* UNKNOWN STATE va un poco más suelto que los otros títulos: avance 7,75
     contra 7,4. (La primera lectura dio 8,45 porque conté 11 pasos donde hay 12
     — la cadena lleva un espacio en el medio. El rótulo salía 10 px largo.) */
  .rot-t--suelto { letter-spacing: 0.105em; }
  /* UNDEFINED BOUNDARIES va más apretado que el resto del cuerpo (7,25). */
  .rot-t--boun {
    font-size: 11px;
    letter-spacing: 0.059em;
    opacity: 0.5;
  }
  /* Corrección del anclaje a la derecha. El interletrado se suma también
     DESPUÉS del último carácter, así que `text-anchor:end` cuelga el bloque una
     letra adentro; la letra entera no alcanzaba —las cuatro líneas cerraban 2 px
     cortas contra la referencia— y el valor final salió de medir, no de la
     fórmula. */
  .rot-t--der {
    text-anchor: end;
    transform: translateX(3.5px);
  }
  .rot-t--der.rot-t--cuerpo { transform: translateX(2.9px); }
  /* LATENT RELATIONS y POTENTIAL NODES van más sueltos que el título de la
     columna izquierda: avance 8,27 contra 8,10. */
  .rot-t--tit.rot-t--der { letter-spacing: 0.157em; }

  /* ── guías ──────────────────────────────────────────────────────────── */
  .rot-guia path {
    fill: none;
    stroke: #cfccc6;
    stroke-width: 1;
    opacity: 0.42;
  }
  .rot-guia rect {
    fill: none;
    stroke: #b79ee0;
    stroke-width: 1;
    opacity: 0.7;
  }
  .rot-guia__anillo {
    fill: none;
    stroke: #b79ee0;
    stroke-width: 1.3;
    opacity: 0.8;
  }
  .rot-guia__pto {
    fill: #cfccc6;
    opacity: 0.7;
  }
  .rot-guia__saeta {
    fill: #b79ee0 !important;
    stroke: none !important;
    opacity: 0.75;
  }

  .rot-rayas rect {
    fill: #cfccc6;
    opacity: 0.35;
  }

  .rot-señal__marca {
    fill: none;
    stroke: #cfccc6;
    stroke-width: 1;
    opacity: 0.5;
  }
  .rot-señal__base {
    fill: none;
    stroke: #cfccc6;
    stroke-width: 0.8;
    opacity: 0.4;
  }

  .rot-trama,
  .rot-señal {
    position: absolute;
  }
  .rot-señal { opacity: 0.85; }
</style>
