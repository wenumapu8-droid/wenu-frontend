---
/**
 * KODEX-∞ · u01-origin-field · CABECERA
 *
 * Franja superior (y=0..250) + el marco y los dos rieles que corren de canto a
 * canto. Todo trazado en SVG por código: ni un bitmap.
 *
 * El cromo lo pone `serie-universe/CabeceraUniverse.astro`, que es el mismo
 * para las cinco láminas de la serie. Acá quedan sólo las COTAS de esta página,
 * y ninguna se heredó: se volvieron a barrer sobre
 * `reference/canon/u01-origin-field.png` (1122×1402) y hay diferencias que se
 * ven midiendo y no a ojo:
 *
 *  · el marco de u01 es MÁS ANCHO. Vertical izquierda en x=12,5 contra 13,5 de
 *    u02, y derecha en x=1109,5 contra 1106,5 — tres píxeles de luz de más.
 *    El marco interior repite el corrimiento: 54,5 / 1066,5 contra 55,5 /
 *    1063,5. Copiar la cabecera de u02 tal cual deja el marco entero dos
 *    píxeles adentro y eso el banco lo ve en las cuatro esquinas.
 *  · el eje de la lámina cae en 561 (media de las dos verticales del marco), no
 *    en 560 como en u02.
 *  · el título: KODEX mide 55 px de versal (y=113..167) y ORIGIN FIELD mide 50
 *    (y=115..164). Igual que en u02, NO tienen el mismo cuerpo, y la segunda
 *    palabra además viene condensada. Los tramos de tinta medidos son
 *    KODEX x=91..404 · guion x=411..435 · ∞ x=454..520 · barra x=548..569 ·
 *    ORIGIN FIELD x=593..1043. Los tres primeros coinciden con u02 al píxel
 *    —la palabra KODEX está compuesta igual en las dos páginas— y a partir de
 *    la barra se separan.
 *  · la bajada NO es la de u02: acá el rótulo central tiene 53 caracteres con
 *    avance de 9,25 px (contra 21 caracteres de cuerpo 22 en u02), así que va
 *    con cuerpo 13,7 y no con 22.
 *  · las reglas que corren hacia el hexágono son CONTINUAS (medido: tinta
 *    ininterrumpida de x=366 a 506 y de 616 a 779 con luminancia 30-45),
 *    mientras que en u02 son un punteado 17/3.
 *
 * LA PALETA NO SE HEREDA, y esto está medido: el título y los filamentos del
 * campo son gris cálido casi neutro —rgb(228,225,219) en el título,
 * rgb(235,229,232) en los filamentos— y el violeta queda para los rótulos, el
 * núcleo y el emblema. u02 es violeta de punta a punta; copiarle la paleta acá
 * tiñe media lámina. Por eso va como prop y no como valor por defecto del
 * componente compartido.
 *
 * Y LA BAJADA NO ES TODA VIOLETA, cosa que sólo se ve midiendo el color de sus
 * píxeles más brillantes, uno por uno:
 *   A / -∞    rgb(180,156,200)  violeta franco
 *   la frase  rgb(140,142,139)  gris neutro
 *   PAGE 01   rgb(144,121,165)  violeta
 * O sea: los dos extremos van en acento y el rótulo largo del medio NO. En la
 * miniatura los tres parecen del mismo color —y en u02 el lema central sí es
 * violeta, que es de donde venía la suposición—. Pintar la frase de violeta
 * tiñe 486 px de ancho de la franja más visible de la lámina.
 */
import CabeceraUniverse from "../serie-universe/CabeceraUniverse.astro";
import { rayos, rombo } from "../serie-universe/geom";

/* ── marco exterior ─────────────────────────────────────────────────────── */
/* Verticales medidas en x=12,5 y x=1109,5; reglas en y=12,5 y y=1388. Las
   cuatro esquinas son un chaflán a 45° de 14 px, no un ángulo recto. */
const MARCO_I = 12.5;
const MARCO_D = 1109.5;
const chaflanes = [
  `M${MARCO_I} 26.5L29 12.5`,
  `M1093 12.5L${MARCO_D} 26.5`,
  `M${MARCO_D} 1374.5L1093 1388.5`,
  `M26.5 1388.5L${MARCO_I} 1374.5`,
];

/* Los rieles no son una línea continua: alternan tramos macizos y tramos de
   puntos. En u01 el tramo central es mucho más largo que en u02 —de y=403 a
   y=778 a la izquierda y de y=356 a y=800 a la derecha— y eso cambia el peso
   del canto. [y0, y1, macizo?] */
const rielIzq: [number, number, boolean][] = [
  [40, 76, true], [99, 206, false], [238, 295, false], [307, 398, false],
  [403, 778, true], [789, 940, false], [954, 1243, true],
  [1248, 1318, false], [1319, 1388, true],
];
const rielDer: [number, number, boolean][] = [
  [39, 75, true], [83, 224, false], [241, 350, false], [356, 800, true],
  [837, 1243, true], [1248, 1316, false], [1317, 1386, true],
];

/* ── glifos de riel ─────────────────────────────────────────────────────── */
const EJE_I = 12.5;
const EJE_D = 1109.5;

const puntosIzq = [218, 789, 835, 845, 850, 862, 892, 898, 917, 954];
const puntosDer = [208, 583, 619, 634, 798, 807];

/* ── paleta y calibrado ─────────────────────────────────────────────────── */
/* Cada número salió de comparar la caja contra la referencia, no de elegirlo.
   Se probó el peso 500 del título con contorno de 0,7 para engrosar las astas
   —parecía más cerca a ojo— y midió PEOR: 9,03 % contra 8,06 % en la región del
   título. Lo que la referencia tiene de más no es peso de asta sino contraste
   dentro del glifo, y engrosar el contorno lo aplana. */
const vars = [
  "--cb-ink:#cfccc6",
  "--cb-vio:#b79ee0",
  "--cb-tit:#dcd9d2",
  "--cb-marco-op:.11",
  "--cb-marco-tenue-op:.16",
  "--cb-fantasma-op:.03",
  "--cb-interior-op:.05",
  "--cb-regla-op:.3",
  "--cb-regla-der-op:.24",
  "--cb-cruz-op:.4",
  "--cb-nodo-f-op:.45",
  "--cb-punteo-op:.13",
  "--cb-inf-op:.66",
  "--cb-tit-inf-op:.82",
  "--cb-tit-op:.88",
  "--cb-tit-fig-op:.8",
  "--cb-sig-size:15px",
  "--cb-sig-op:.72",
  "--cb-lema-size:13.7px",
  "--cb-lema-fill:var(--cb-ink)",
  "--cb-lema-op:.63",
  "--cb-pag-size:13.7px",
  "--cb-pag-op:.6",
  "--cb-riel-op:.085",
  "--cb-micro-op:.12",
  "--cb-folio-op:.42",
].join(";");
---

<CabeceraUniverse
  gradId="u01"
  grad={["#eeece6", "#dcd9d2", "#b2afa8"]}
  ariaLabel="KODEX-∞ / ORIGIN FIELD — página 01 · Before language, the signal // before form, potential."
  vars={vars}
  marcoSup="M30 12.5H502M613 12.5H1092"
  marcoInf={{ d: "M40 1388H1090" }}
  fantasma={`M${MARCO_I} 26.5V1374.5M${MARCO_D} 26.5V1374.5`}
  chaflanes={chaflanes}
  nodosSup={[{ x: 509.5, y: 12.5 }, { x: 613.5, y: 12.5 }]}
  interior="M54.5 64V1258M1066.5 64V1258"
  interiorEsq="M54.5 76.5H88.5M1066.5 76.5H1032.5"
  cruces={[[40, 43.5], [1082, 43.5]]}
  reglaIzq={{ x: 63.6, y: 47.5, len: 187, t: "KODEX-∞ UNIVERSE" }}
  reglaDer={{ x: 802.6, y: 47.5, len: 257.5, t: "OBSERVE. DECIPHER. TRANSCEND." }}
  reglaCy={43.5}
  puntosRegla={[269, 328, 344]}
  nodosRegla={[511, 606, 777]}
  punteo={{ d: "M351 43.5H360M366 43.5H506M616 43.5H779" }}
  hex={{
    borde: "M561.5 17L585.5 30V53L561.5 66L537.5 53V30Z",
    tics: "M538 28.5h4M581 28.5h4M538 54.5h4M581 54.5h4",
    tallo: "M561.5 65.5V71",
    inf: [561.5, 42, 12.95, 10.4],
  }}
  titKodex={{ x: 87.7, y: 167, size: 88, len: 319, t: "KODEX" }}
  titGuion={{ x: 411, y: 139, w: 25, h: 3.8 }}
  titInf={[487, 141, 31.2, 25.8]}
  titBarra="M566.9 111.5L571.4 111.5L552.1 167.5L547.6 167.5Z"
  titPalabra={{ x: 592, y: 164.5, size: 80, len: 453, t: "ORIGIN FIELD" }}
  sig={{ x: 91.5, y: 214, len: 71, t: "A / -∞" }}
  lema={{ x: 320.5, y: 213.5, len: 486, t: "BEFORE LANGUAGE, THE SIGNAL // BEFORE FORM, POTENTIAL" }}
  pag={{ x: 973.5, y: 213.5, len: 60, t: "PAGE 01" }}
  ejeI={EJE_I}
  ejeD={EJE_D}
  rielIzq={rielIzq}
  rielDer={rielDer}
  nodosIzq={puntosIzq}
  nodosDer={puntosDer}
  micro={[
    { transform: "translate(1106.6 400) rotate(-90)", len: 164, t: "XX XX PDX-01 / ORIGIN XX" },
    { transform: "translate(10 1000) rotate(-90)", len: 86, t: "KDX · REVIEW ·" },
  ]}
  folio={{ x: 1103.5, y: 608.5, len: 14.5, t: "01" }}
>
  <!-- Guías de la bajada: anillo + raya a cada lado. NO son simétricas respecto
       del eje del marco (261 y 868 dan centro 564,5), y así están medidas. -->
  <g slot="sep">
    <circle class="cab__guia-anillo" cx="260.5" cy="208.5" r="4.2" />
    <circle class="cab__nodo-f" cx="260.5" cy="208.5" r="1.3" />
    <path class="cab__guia" d="M266 208.5H305" />
    <path class="cab__guia" d="M824 208.5H862" />
    <circle class="cab__guia-anillo" cx="868" cy="208.5" r="4.2" />
    <circle class="cab__nodo-f" cx="868" cy="208.5" r="1.3" />
  </g>

  <g class="cab__glifo" slot="glifos">
    <!-- Riel izquierdo · anillo alto y racimo de rayos -->
    <circle cx={EJE_I} cy="311" r="4.7" />
    <path d={rayos(EJE_I, 330, 4.6, 8)} />
    <path d={rayos(EJE_I, 347, 3.4, 6, Math.PI / 2)} />
    <path d={rayos(EJE_I, 363, 4, 8, Math.PI / 8)} />
    <path d="M7.8 375.5H17.2L12.5 382.2ZM12.5 382.2V385" />
    <!-- Riel izquierdo · racimo bajo -->
    <path d={rayos(EJE_I, 806, 4, 6)} />
    <path d={rombo(EJE_I, 822, 12, 9)} />
    <circle cx={EJE_I} cy="822" r="1.6" />
    <path d={rayos(EJE_I, 906, 3.2, 4)} />
    <!-- Riel derecho -->
    <path d="M1109.5 306L1114.6 308.5V313.5L1109.5 316L1104.4 313.5V308.5Z" />
    <path d={rayos(EJE_D, 337, 3.4, 8)} />
    <circle cx={EJE_D} cy="811" r="4.4" />
  </g>
</CabeceraUniverse>
