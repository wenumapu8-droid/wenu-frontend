---
/**
 * KODEX−∞ · SERIE ARCHIVO · CABECERA
 *
 * Cabecera del cromo de las páginas de archivo (a21..a30, 1229×1536).
 * El marco NO es idéntico entre páginas pero el vocabulario sí: marca
 * KODEX−∞ en serif espaciada + lema en versalita chica, y un bloque de
 * página en el borde opuesto.
 *
 * MEDIDO sobre reference/pendientes/ (perfil de tinta, umbral lum 80):
 * · a28-silence-engine: marca en la esquina izquierda, versal 13,5 px
 *   (banda y36..49) → cuerpo 21,6 px con la razón versal/cuerpo de
 *   Cormorant Garamond (sCapHeight 625 / unitsPerEm 1000 = 0,625 — la
 *   misma constante documentada en lamina/u10/Cabecera). Lema
 *   "UNIVERSAL ARCHIVE" y63..72 → versal 9 px → cuerpo 14,4 px.
 *   Bloque de página a la derecha: rótulo y31..44 (versal 13 → 21 px)
 *   sobre número y55..80 (versal 25 → 40 px), centrados entre sí.
 * · a21-void-orchard y a24-star-lattice centran la marca y el lema
 *   ("• LIVING ARCHIVE OF THE UNBOUND •" / "UNIVERSAL NAVIGATIONAL
 *   MATRIX"); a21 pone "// PAGE 21" a la izquierda y "SPECIMEN VØ-21"
 *   a la derecha → de ahí la variante `centrada` y que el rótulo de
 *   página sea prop y no texto fijo.
 *
 * REGLA DURA: todo texto visible es del creador y entra por props,
 * transcrito de la referencia. Sin defaults de contenido.
 */
interface Props {
  /** Marca de la serie, ej. "KODEX−∞" (transcrita, no inventada). */
  marca: string;
  /** Lema bajo la marca, ej. "UNIVERSAL ARCHIVE" (a28). */
  lema: string;
  /** Rótulo del bloque de página, ej. "PAGE" (a28) o "SPECIMEN" (a21). */
  rotuloPagina: string;
  /** Número o código de página, ej. "28" o "VØ-21". */
  pagina: string;
  /** a21/a24 centran la marca; a28 la lleva a la esquina izquierda. */
  centrada?: boolean;
}
const { marca, lema, rotuloPagina, pagina, centrada = false } = Astro.props;
---

<header class:list={["arch-cab", { "arch-cab--centrada": centrada }]}>
  <div class="arch-cab__marca-bloque">
    <p class="arch-cab__marca">{marca}</p>
    <p class="arch-cab__lema">{lema}</p>
  </div>

  {/* Adorno central opcional: en a28 es una regla con círculo y cruz.
      Es geometría por lámina, así que entra por slot y no se dibuja acá. */}
  <div class="arch-cab__adorno"><slot name="adorno" /></div>

  <div class="arch-cab__pagina-bloque">
    <p class="arch-cab__rotulo">{rotuloPagina}</p>
    <p class="arch-cab__numero">{pagina}</p>
  </div>
</header>

<style>
  .arch-cab {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    color: var(--arch-ink, #d8d4d0);
  }
  .arch-cab__marca-bloque p,
  .arch-cab__pagina-bloque p {
    margin: 0;
  }
  .arch-cab__marca {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 500;
    /* 21,6 px = versal medida 13,5 / 0,625 */
    font-size: var(--arch-cab-marca-size, 21.6px);
    letter-spacing: 0.22em;
    line-height: 1;
  }
  .arch-cab__lema {
    margin-top: 8px;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 600;
    /* 14,4 px = versal medida 9 / 0,625 */
    font-size: var(--arch-cab-lema-size, 14.4px);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.72;
  }
  .arch-cab__adorno {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-width: 0;
  }
  .arch-cab__pagina-bloque {
    text-align: center;
  }
  .arch-cab__rotulo {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 500;
    font-size: var(--arch-cab-rotulo-size, 21px);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    line-height: 1;
  }
  .arch-cab__numero {
    margin-top: 4px;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 500;
    /* 40 px = versal medida 25 / 0,625 */
    font-size: var(--arch-cab-numero-size, 40px);
    line-height: 1;
  }
  /* Variante a21/a24: la marca y el lema van centrados sobre el eje;
     el bloque de página queda en el borde. */
  .arch-cab--centrada .arch-cab__marca-bloque {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
  }
  .arch-cab--centrada {
    position: relative;
    justify-content: flex-end;
  }
</style>
