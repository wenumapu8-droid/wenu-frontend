---
/**
 * KODEX−∞ · SERIE ARCHIVO · RIEL DE MÉTRICAS
 *
 * El riel lateral de tarjetas apiladas del vocabulario de archivo.
 *
 * MEDIDO sobre reference/pendientes/a28-silence-engine.png (perfil de
 * columnas, umbral lum 35): bordes verticales del riel en x=35 y x=225
 * → caja de 190 px de ancho, desde la regla superior en y=299 hasta
 * ~y=1430 (≈1130 px de alto para 4 tarjetas, ~282 px por tarjeta).
 * El borde es fino y tenue: 1 px con ~16 % de la tinta llena.
 * Dentro, las tarjetas se separan con reglas horizontales completas
 * (fila ancha detectada en y≈550, y el remate punto+raya de cada
 * tarjeta las precede).
 *
 * En a24 el mismo vocabulario va en FILA de tarjetas con marco propio;
 * este componente cubre el caso riel (columna). No fija contenido:
 * las tarjetas entran por slot.
 */
interface Props {
  /** Ancho de la caja en px. Medido en a28: 190. */
  ancho?: number;
  /** Etiqueta accesible del riel (no se pinta). */
  rotulo?: string;
}
const { ancho = 190, rotulo } = Astro.props;
---

<aside class="arch-riel" style={`width:${ancho}px`} aria-label={rotulo}>
  <slot />
</aside>

<style>
  .arch-riel {
    box-sizing: border-box;
    /* Borde medido: 1 px, tinta al ~16 % (lum ~35 sobre tinta 212). */
    border: 1px solid color-mix(in srgb, var(--arch-ink, #d8d4d0) 18%, transparent);
    padding: 26px 12px 18px;
    display: flex;
    flex-direction: column;
    background: transparent;
  }
  /* Regla divisoria completa entre tarjetas, como en la referencia:
     va de borde a borde de la caja (los -12px anulan el padding). */
  .arch-riel > :global(* + *) {
    margin-top: 22px;
    padding-top: 24px;
    position: relative;
  }
  .arch-riel > :global(* + *)::before {
    content: "";
    position: absolute;
    top: 0;
    left: -12px;
    right: -12px;
    height: 1px;
    background: color-mix(in srgb, var(--arch-ink, #d8d4d0) 16%, transparent);
  }
</style>
