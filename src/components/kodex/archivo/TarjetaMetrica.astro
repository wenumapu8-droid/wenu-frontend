---
/**
 * KODEX−∞ · SERIE ARCHIVO · TARJETA DE MÉTRICA
 *
 * La celda de métrica del vocabulario de archivo: título bilingüe,
 * diagrama chico, valor grande y etiqueta. Aparece apilada en el riel
 * lateral (a28) y como tarjeta con marco propio en fila (a24).
 *
 * MEDIDO sobre reference/pendientes/a28-silence-engine.png, riel
 * izquierdo (caja x35..225, o sea 190 px de ancho — recorte a 1,5×):
 * · Título EN ("NOISE FLOOR"): en la referencia SIEMPRE cabe en una
 *   línea dentro de los 190 px — "PHASE CANCELLATION" mide ~147 px de
 *   ancho, o sea ~8 px por glifo con el tracking incluido → cuerpo
 *   14 px con tracking 0,12em (la primera estimación por altura de
 *   versal daba 18 px y desbordaba a dos líneas: el ancho manda).
 * · Subtítulo ES ("PISO DE RUIDO"): una línea también → ~10 px.
 * · Diagrama: ~170×80..130 px según tarjeta (onda, anillos, fases, flor).
 * · Valor ("−112.6 dB"): versal ~19 px → cuerpo ~30 px, serif.
 * · Etiqueta ("RELATIVE TO UNITY"): versal ~7 px → ~10,5 px.
 * · Pie de tarjeta: punto de acento (Ø ~7 px) centrado sobre una regla
 *   corta — es el remate que separa tarjetas dentro del riel.
 * En a24 las mismas piezas van más grandes (valor "7,777" versal ~28 px)
 * y con tabla clave/valor extra: esa tabla es contenido por lámina y
 * entra por slot, no se fija acá.
 *
 * REGLA DURA: títulos, valores y etiquetas son del creador — props sin
 * default de contenido, transcritos de la referencia.
 */
interface Props {
  /** Título en inglés, ej. "NOISE FLOOR". */
  tituloEn: string;
  /** Subtítulo en español, ej. "PISO DE RUIDO". */
  tituloEs: string;
  /** Valor grande, ej. "−112.6 dB" o "∞.00". */
  valor: string;
  /** Etiqueta bajo el valor, ej. "RELATIVE TO UNITY". */
  etiqueta: string;
  /** Punto + regla corta al pie (así remata cada tarjeta del riel a28). */
  conPie?: boolean;
}
const { tituloEn, tituloEs, valor, etiqueta, conPie = true } = Astro.props;
---

<article class="arch-tarjeta">
  <h3 class="arch-tarjeta__en">{tituloEn}</h3>
  <p class="arch-tarjeta__es">{tituloEs}</p>

  {/* El diagrama es geometría por métrica (onda, anillos, flor…): slot. */}
  <div class="arch-tarjeta__diagrama"><slot /></div>

  <p class="arch-tarjeta__valor">{valor}</p>
  <p class="arch-tarjeta__etiqueta">{etiqueta}</p>

  {conPie && (
    <div class="arch-tarjeta__pie" aria-hidden="true">
      <span class="arch-tarjeta__punto"></span>
      <span class="arch-tarjeta__raya"></span>
    </div>
  )}
</article>

<style>
  .arch-tarjeta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--arch-ink, #d8d4d0);
  }
  .arch-tarjeta h3,
  .arch-tarjeta p {
    margin: 0;
  }
  .arch-tarjeta__en {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 600;
    /* 12,5 px: el ancho de línea de la referencia manda (ver arriba) —
       "PHASE CANCELLATION" mide ~147 px y en Cormorant la versal avanza
       ~0,6em, así que 14 px seguía quebrando en dos líneas. */
    font-size: var(--arch-tarjeta-en-size, 12.5px);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.1;
    white-space: nowrap; /* en la referencia el título nunca quiebra */
  }
  .arch-tarjeta__es {
    margin-top: 4px;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 600;
    font-size: var(--arch-tarjeta-es-size, 9.5px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.6;
    white-space: nowrap; /* ídem: "PROFUNDIDAD DEL SILENCIO" va entera */
  }
  .arch-tarjeta__diagrama {
    margin: 14px 0 12px;
    width: 100%;
    display: flex;
    justify-content: center;
    color: var(--arch-ink, #d8d4d0);
  }
  .arch-tarjeta__valor {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 500;
    /* 30 px = versal medida ~19 / 0,625 */
    font-size: var(--arch-tarjeta-valor-size, 30px);
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .arch-tarjeta__etiqueta {
    margin-top: 8px;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 600;
    font-size: var(--arch-tarjeta-etq-size, 10.5px);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.62;
  }
  .arch-tarjeta__pie {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 100%;
  }
  .arch-tarjeta__punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--arch-acento, #cdbcf3);
  }
  .arch-tarjeta__raya {
    width: 62%;
    height: 1px;
    background: currentColor;
    opacity: 0.28;
  }
</style>
