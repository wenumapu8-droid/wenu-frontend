---
/**
 * KODEX−∞ · SERIE ARCHIVO · AFORISMO AL PIE
 *
 * Banda inferior del cromo: regla horizontal que cruza el ancho con un
 * emblema circular montado encima, aforismo centrado en una o dos
 * líneas con un fragmento en color de acento, y rótulo bilingüe de
 * esquina con barra de acento.
 *
 * MEDIDO sobre reference/pendientes/a28-silence-engine.png (perfil de
 * tinta del pie, x380..850, umbral lum 90):
 * · Regla horizontal en y≈1450; el emblema circular la interrumpe
 *   (círculo y1400..1452, Ø ~52 px, con cruz/espada adentro).
 * · Aforismo: dos líneas, versal 8–9 px → cuerpo ~14 px, interlínea de
 *   22 px (bandas y1476..1484 y y1498..1506), tracking muy amplio
 *   (~0,42em). El fragmento "PERFECT ORDER." va en acento: pico medido
 *   rgb(180,169,199) = #b4a9c7 — un violeta más apagado que el del
 *   subtítulo.
 * · Esquina izquierda: "CHAMBER OF NULLITY / CAMARA DE NULIDAD" en dos
 *   líneas (y1462..1492) con barra vertical de acento pegada al borde.
 *
 * REGLA DURA: el aforismo es del creador. Se transcribe de la
 * referencia, JAMÁS se inventa. Props sin default de contenido; los
 * segmentos marcan qué parte exacta lleva el acento en la referencia.
 */
export interface SegmentoAforismo {
  /** Texto transcrito de la referencia. */
  t: string;
  /** true si en la referencia ese tramo va en color de acento. */
  acento?: boolean;
}
interface Props {
  /** Líneas del aforismo; cada línea es una lista de segmentos. */
  lineas: SegmentoAforismo[][];
  /** Rótulo de esquina en inglés, ej. "CHAMBER OF NULLITY". */
  rotuloEn?: string;
  /** Rótulo de esquina en español, ej. "CAMARA DE NULIDAD". */
  rotuloEs?: string;
}
const { lineas, rotuloEn, rotuloEs } = Astro.props;
---

<footer class="arch-pie">
  <div class="arch-pie__regla" aria-hidden="true">
    <span class="arch-pie__linea"></span>
    <span class="arch-pie__emblema"><slot name="emblema" /></span>
    <span class="arch-pie__linea"></span>
  </div>

  <div class="arch-pie__aforismo">
    {lineas.map((linea) => (
      <p class="arch-pie__verso">
        {linea.map((s) =>
          s.acento ? <em class="arch-pie__acento">{s.t}</em> : <span>{s.t}</span>
        )}
      </p>
    ))}
  </div>

  {(rotuloEn || rotuloEs) && (
    <div class="arch-pie__rotulo">
      <span class="arch-pie__barra" aria-hidden="true"></span>
      <div>
        {rotuloEn && <p>{rotuloEn}</p>}
        {rotuloEs && <p>{rotuloEs}</p>}
      </div>
    </div>
  )}
</footer>

<style>
  .arch-pie {
    position: relative;
    /* Explícitos a propósito: los estilos globales del sitio tocan
       <footer> y sin esto el bloque del aforismo se encoge y el texto
       queda descentrado (visto en la captura de verificación). */
    display: block;
    width: 100%;
    color: var(--arch-ink, #d8d4d0);
  }
  .arch-pie__aforismo {
    width: 100%;
  }
  .arch-pie__regla {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .arch-pie__linea {
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.34;
  }
  .arch-pie__emblema {
    display: flex;
    align-items: center;
    justify-content: center;
    /* El emblema medido en a28 baja ~26 px por encima de la regla:
       el círculo la interrumpe centrado en ella. */
    min-width: 12px;
  }
  .arch-pie__emblema:empty {
    display: none;
  }
  .arch-pie__aforismo {
    /* De la regla (y1450) a la primera línea (y1476) hay ~26 px. */
    margin-top: 24px;
    text-align: center;
  }
  .arch-pie__verso {
    margin: 0;
    /* La tipografía global del sitio limita los <p> a ~65ch: acá eso
       dejaba el aforismo descentrado (medido en la verificación). */
    max-width: none;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 600;
    /* 14 px = versal medida ~9 / 0,625; interlínea medida 22 px. */
    font-size: var(--arch-pie-size, 14px);
    line-height: 22px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
  }
  .arch-pie__acento {
    font-style: normal;
    color: var(--arch-acento-pie, #b4a9c7);
  }
  .arch-pie__rotulo {
    position: absolute;
    left: 0;
    top: 24px;
    display: flex;
    align-items: stretch;
    gap: 10px;
  }
  .arch-pie__barra {
    width: 2px;
    background: var(--arch-acento, #cdbcf3);
    opacity: 0.85;
  }
  .arch-pie__rotulo p {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 600;
    font-size: var(--arch-pie-rotulo-size, 14px);
    line-height: 22px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.86;
  }
</style>
