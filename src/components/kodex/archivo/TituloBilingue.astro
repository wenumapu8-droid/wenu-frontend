---
/**
 * KODEX−∞ · SERIE ARCHIVO · TÍTULO BILINGÜE
 *
 * Bloque de título de las páginas de archivo: serif grande en inglés,
 * regla ornamental, y versalita menor en español con color de acento.
 *
 * MEDIDO sobre reference/pendientes/a28-silence-engine.png (perfil de
 * tinta, x150..1080, umbral lum 120):
 * · "SILENCE ENGINE": banda de versales y134..203 → versal 69–70 px →
 *   cuerpo 112 px con la razón 0,625 de Cormorant Garamond. Centrado,
 *   tracking amplio (~0,05em a ojo de recorte, la referencia respira
 *   entre glifos).
 * · Regla ornamental en y≈215: línea fina con rombos en las puntas,
 *   dos rombos menores hacia el centro y un punto de acento al medio.
 * · "MOTOR DEL SILENCIO": banda y280..298 → versal 19 px → cuerpo
 *   30,4 px. Color pico medido rgb(205,188,243) = #cdbcf3 (violeta
 *   claro), tracking ~0,38em.
 * · a21 y a24 usan el mismo vocabulario con otro acento (dorado /
 *   plateado): por eso los colores son variables y no constantes.
 *
 * REGLA DURA: título y subtítulo son del creador — se transcriben de la
 * referencia y entran por props sin default.
 */
interface Props {
  /** Título en inglés, ej. "SILENCE ENGINE" (tal cual la referencia). */
  titulo: string;
  /** Subtítulo en español, ej. "MOTOR DEL SILENCIO". */
  subtitulo: string;
}
const { titulo, subtitulo } = Astro.props;
---

<div class="arch-titulo">
  <h1 class="arch-titulo__en">{titulo}</h1>

  {/* Regla ornamental medida en a28 y≈215: rombos en las puntas, rombos
      menores intermedios y punto de acento central. */}
  <svg
    class="arch-titulo__regla"
    viewBox="0 0 700 16"
    width="700"
    height="16"
    fill="none"
    aria-hidden="true"
  >
    <line x1="14" y1="8" x2="686" y2="8" stroke="currentColor" stroke-opacity="0.5" stroke-width="1" />
    <rect x="6" y="4" width="8" height="8" transform="rotate(45 10 8)" stroke="currentColor" stroke-opacity="0.8" stroke-width="1" />
    <rect x="686" y="4" width="8" height="8" transform="rotate(45 690 8)" stroke="currentColor" stroke-opacity="0.8" stroke-width="1" />
    <rect x="286" y="5" width="6" height="6" transform="rotate(45 289 8)" stroke="currentColor" stroke-opacity="0.7" stroke-width="1" />
    <rect x="408" y="5" width="6" height="6" transform="rotate(45 411 8)" stroke="currentColor" stroke-opacity="0.7" stroke-width="1" />
    <circle cx="350" cy="8" r="4" fill="var(--arch-acento, #cdbcf3)" />
  </svg>

  <p class="arch-titulo__es">{subtitulo}</p>
</div>

<style>
  .arch-titulo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--arch-ink-titulo, #efece7);
  }
  .arch-titulo__en {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 500;
    /* 112 px = versal medida 70 / 0,625 */
    font-size: var(--arch-titulo-size, 112px);
    line-height: 1;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .arch-titulo__regla {
    /* De la base del título (y203) a la regla (y215) hay ~12 px. */
    margin-top: 12px;
    max-width: 100%;
  }
  .arch-titulo__es {
    /* De la regla (y215) al subtítulo (y280) hay ~60 px medidos. */
    margin: 46px 0 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 600;
    /* 30,4 px = versal medida 19 / 0,625 */
    font-size: var(--arch-sub-size, 30.4px);
    line-height: 1;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: var(--arch-acento, #cdbcf3);
  }
</style>
