---
interface Props {
  label?: string;
}

const { label = "DNA PASSAGE — biological reference / KODEX symbolic reading" } = Astro.props;
const rungs = Array.from({ length: 9 }, (_, index) => index + 1);
---

<section class="kdx-helix" data-kdx-helix-passage data-ready="false" data-mode="webgl" tabindex="0" aria-label={label}>
  <div class="kdx-helix__viewport">
    <svg class="kdx-helix__fallback" viewBox="0 0 600 900" role="img" aria-label="Static double helix fallback">
      <rect width="600" height="900" fill="#030306" />
      <path d="M190 40 C430 120 430 210 190 290 S-50 460 190 540 S430 710 190 860" fill="none" stroke="currentColor" stroke-width="8" />
      <path d="M410 40 C170 120 170 210 410 290 S650 460 410 540 S170 710 410 860" fill="none" stroke="currentColor" stroke-width="4" stroke-dasharray="14 12" opacity=".82" />
      {rungs.map((rung) => {
        const y = 80 + (rung - 1) * 92;
        return <line x1="210" y1={y} x2="390" y2={y} stroke="currentColor" stroke-width="2" opacity=".42" />;
      })}
    </svg>
    <canvas class="kdx-helix__canvas" data-helix-canvas aria-hidden="true"></canvas>

    <div class="kdx-helix__labels" aria-hidden="true">
      <span class="kdx-helix__label kdx-helix__label--bio">BIOLOGICAL REFERENCE<br/><small>recognizable form / not genetic data</small></span>
      <span class="kdx-helix__label kdx-helix__label--symbolic">KODEX SYMBOLIC<br/><small>lineage · memory · ascent</small></span>
    </div>

    <div class="kdx-helix__telemetry" aria-hidden="true">
      <span>DNA PASSAGE</span>
      <span>SYMBOLIC_ONLY</span>
      <span data-helix-renderer>WEBGL</span>
    </div>
  </div>

  <div class="kdx-helix__rail" aria-label="Passage rungs">
    <div class="kdx-helix__rail-copy">
      <p>SELECT / READ</p>
      <strong data-helix-selected>RUNG 01</strong>
    </div>
    <div class="kdx-helix__rungs" role="group" aria-label="Semantic rungs">
      {rungs.map((rung, index) => (
        <button
          type="button"
          data-helix-rung={index}
          aria-pressed={index === 0 ? "true" : "false"}
          aria-label={`Select rung ${rung}. Biological reference and KODEX symbolic reading.`}
        >
          {String(rung).padStart(2, "0")}
        </button>
      ))}
    </div>
    <p class="kdx-helix__hint">DRAG / ORBIT · ↑↓ SELECT · ENTER / TAP COMMIT</p>
  </div>

  <div class="sr-only" aria-live="polite" data-helix-live>
    Rung 1 selected. Biological reference: generic double-helix geometry. KODEX symbolic: lineage, memory and ascent are symbolic only.
  </div>
</section>

<script>
  import "./helix-passage-client";
</script>

<style>
  .kdx-helix {
    --bio: #86dcff;
    --symbolic: #9d7aff;
    --bone: #ebe7ef;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 8.5rem;
    width: 100%;
    min-height: min(82dvh, 58rem);
    overflow: hidden;
    border: 1px solid rgb(235 231 239 / .22);
    background: #030306;
    color: var(--bone);
    outline: none;
  }

  .kdx-helix:focus-visible { box-shadow: inset 0 0 0 2px rgb(157 122 255 / .75); }
  .kdx-helix__viewport { position: relative; min-width: 0; overflow: hidden; }
  .kdx-helix__canvas, .kdx-helix__fallback { position: absolute; inset: 0; width: 100%; height: 100%; }
  .kdx-helix__canvas { display: block; opacity: 0; }
  .kdx-helix[data-ready="true"] .kdx-helix__canvas { opacity: 1; }
  .kdx-helix__fallback { object-fit: cover; color: var(--bio); opacity: .78; }
  .kdx-helix[data-ready="true"] .kdx-helix__fallback { opacity: 0; }
  .kdx-helix[data-mode="fallback"] .kdx-helix__fallback { opacity: .86; }

  .kdx-helix__labels, .kdx-helix__telemetry { position: absolute; inset: 0; pointer-events: none; }
  .kdx-helix__label { position: absolute; top: 1rem; max-width: 13rem; font: 600 .58rem/1.35 ui-monospace, monospace; letter-spacing: .12em; }
  .kdx-helix__label small { display: block; margin-top: .28rem; font-weight: 400; letter-spacing: .04em; opacity: .62; }
  .kdx-helix__label--bio { left: 1rem; color: var(--bio); border-left: 2px solid currentColor; padding-left: .55rem; }
  .kdx-helix__label--symbolic { right: 1rem; color: var(--symbolic); border-left: 2px dashed currentColor; padding-left: .55rem; text-align: left; }

  .kdx-helix__telemetry { top: auto; bottom: .75rem; height: auto; display: flex; justify-content: space-between; gap: .6rem; padding: 0 1rem; font: 500 .52rem/1 ui-monospace, monospace; letter-spacing: .13em; color: rgb(235 231 239 / .52); }

  .kdx-helix__rail { position: relative; z-index: 2; display: grid; grid-template-rows: auto 1fr auto; gap: 1rem; padding: .8rem; border-left: 1px solid rgb(235 231 239 / .18); background: rgb(2 2 5 / .78); }
  .kdx-helix__rail-copy p, .kdx-helix__hint { margin: 0; font: 500 .5rem/1.35 ui-monospace, monospace; letter-spacing: .12em; color: rgb(235 231 239 / .48); }
  .kdx-helix__rail-copy strong { display: block; margin-top: .35rem; font: 500 .7rem/1 ui-monospace, monospace; letter-spacing: .08em; color: var(--bio); }
  .kdx-helix__rungs { display: grid; align-content: center; gap: .35rem; }
  .kdx-helix__rungs button { appearance: none; min-height: 2.5rem; border: 1px solid rgb(235 231 239 / .16); background: transparent; color: rgb(235 231 239 / .48); font: 500 .6rem/1 ui-monospace, monospace; cursor: pointer; }
  .kdx-helix__rungs button[aria-pressed="true"] { border-style: dashed; border-color: var(--symbolic); color: var(--bone); background: rgb(157 122 255 / .12); }
  .kdx-helix__rungs button:focus-visible { outline: 2px solid var(--bio); outline-offset: 1px; }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  @media (max-width: 700px) {
    .kdx-helix { grid-template-columns: 1fr; min-height: 72dvh; }
    .kdx-helix__viewport { min-height: 56dvh; }
    .kdx-helix__rail { grid-template-columns: auto 1fr; grid-template-rows: auto auto; border-left: 0; border-top: 1px solid rgb(235 231 239 / .18); }
    .kdx-helix__rungs { grid-column: 1 / -1; grid-row: 1; grid-template-columns: repeat(9, 1fr); gap: .2rem; }
    .kdx-helix__rungs button { min-height: 2.2rem; }
    .kdx-helix__rail-copy { grid-column: 1; grid-row: 2; }
    .kdx-helix__hint { grid-column: 2; grid-row: 2; text-align: right; }
    .kdx-helix__label { top: .7rem; font-size: .48rem; max-width: 9rem; }
    .kdx-helix__telemetry { font-size: .44rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kdx-helix__canvas, .kdx-helix__fallback { transition: none; }
  }
</style>
