---
import Logo from './Logo.astro';
import en from '../i18n/en.json';

const path = Astro.url.pathname;
const items = [
  { href: '/shop',    label: en.nav.shop,    match: '/shop' },
  { href: '/world',   label: en.nav.world,   match: '/world' },
  { href: '/local',   label: en.nav.local,   match: '/local' },
  { href: '/contact', label: en.nav.contact, match: '/contact' },
];
---
<nav class="nav">
  <div class="nav__inner">
    <a href="/" class="nav__logo" aria-label="Wenu Mapu home">
      <Logo height={32} />
    </a>
    <ul class="nav__links">
      {items.map(item => (
        <li>
          <a href={item.href} class={path.startsWith(item.match) ? 'active' : ''}>
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a href="https://www.wenumapuonline.com/cart" target="_blank" rel="noopener" class="text-accent">
          {en.nav.store}
        </a>
      </li>
    </ul>
  </div>
</nav>
