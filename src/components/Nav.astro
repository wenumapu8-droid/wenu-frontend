---
import en from '../i18n/en.json';
import { STORE_CART_URL } from '../lib/config';

const path = Astro.url.pathname;

/* Nav submenu — curated set per 2026-06-06 brand audit.
   Dropped diluting categories: Classic, Author, Simple, Decoration, Clothes,
   Steel. They split attention without converting. Kept canonical body
   jewelry categories + cosmovision + materials axes. */
const shopSubmenu = [
  { href: '/shop',           label: 'All pieces' },
  { href: '/piercing',       label: 'Piercing jewelry' },
  { href: '/hangers',        label: 'Hangers & weights' },
  { href: '/ear-cuffs',      label: 'Ornaments · amulets' },
  { href: '/ritual-objects', label: 'Ritual objects' },
  { href: '/custom-orders',  label: 'Atelier · author’s art' },
  { href: '/lines/antu',     label: 'Shop by element' },
  { href: '/materials',      label: 'Shop by material' },
  { href: '/collection',     label: 'Collections' },
];

const mainItems = [
  { href: '/piercing',                               label: 'Piercing',    match: '/piercing' },
  { href: '/hangers',                                label: 'Hangers',     match: '/hangers' },
  { href: '/materials',                              label: 'Materials',   match: '/material' },
  { href: '/custom-orders',                          label: 'Atelier',     match: '/custom-orders' },
  { href: '/about',                                  label: en.nav.about,  match: '/about' },
  { href: '/journal',                                label: en.nav.journal, match: '/journal' },
  { href: 'https://aftercare.wenumapuonline.com/',   label: 'Care',        match: '/aftercare', external: true },
];

// Split links around the centered logo
const leftItems = mainItems.slice(0, 3);   // Piercing, Hangers, Materials
const rightItems = mainItems.slice(3);     // Atelier, About, Journal, Care

const isActive = (m: string) => {
  if (m.startsWith('/')) return path.startsWith(m);
  return Astro.url.search.includes(`cat=${m}`);
};
---
<nav class="nav" aria-label="Primary">
  <div class="nav__inner">
    <ul class="nav__links nav__links--left" role="menubar">
      <li role="none" class="nav__shop-wrap">
        <button
          type="button"
          class={path === '/shop' ? 'nav__shop active' : 'nav__shop'}
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="nav-shop-menu"
          data-shop-trigger
        >
          {en.nav.shop} <span class="nav__chev" aria-hidden="true">▾</span>
        </button>
        <ul id="nav-shop-menu" class="nav__submenu" role="menu" data-shop-menu hidden>
          {shopSubmenu.map(item => (
            <li role="none">
              <a href={item.href} role="menuitem">{item.label}</a>
            </li>
          ))}
        </ul>
      </li>
      {leftItems.map(item => (
        <li role="none">
          <a
            href={item.href}
            role="menuitem"
            class={isActive(item.match) ? 'active' : ''}
            {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <a href="/" class="nav__logo nav__brand" aria-label="Wenu Mapu home">
      <span class="nav__brand-row">
        <img src="/logos/wenu-word-woven.webp" alt="" width="589" height="154" class="nav__brand-word-img nav__brand-word-img--wenu" aria-hidden="true" />
        <img src="/img/brand/wenu-mandala-transparent.webp" alt="" width="120" height="120" class="nav__brand-mark" aria-hidden="true" />
        <img src="/logos/mapu-word-woven.webp" alt="" width="613" height="136" class="nav__brand-word-img nav__brand-word-img--mapu" aria-hidden="true" />
      </span>
      <span class="nav__brand-tagline">Tribal Jewelry · Connected to the Cosmos</span>
    </a>

    <div class="nav__right">
      <ul class="nav__links nav__links--right" role="menubar">
        {rightItems.map(item => (
          <li role="none">
            <a
              href={item.href}
              role="menuitem"
              class={isActive(item.match) ? 'active' : ''}
              {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="nav__icons">
      <button
        type="button"
        class="nav__icon nav__search"
        aria-label={en.nav.search}
        data-search-trigger
        title="Search · press / or ⌘K"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5"/>
          <line x1="20" y1="20" x2="15.5" y2="15.5"/>
        </svg>
        <kbd class="nav__search-hint" aria-hidden="true">/</kbd>
      </button>
      <a
        href={STORE_CART_URL}
        target="_blank"
        rel="noopener"
        aria-label={en.nav.cart}
        class="nav__icon"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M3 5h2.5l2.4 11.2a2 2 0 0 0 2 1.6h7.5a2 2 0 0 0 2-1.5L21 8H6" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9.5" cy="20.5" r="1.2"/>
          <circle cx="17.5" cy="20.5" r="1.2"/>
        </svg>
      </a>
      <button
        type="button"
        class="nav__burger"
        aria-label={en.nav.menu}
        aria-controls="nav-drawer"
        aria-expanded="false"
        data-burger
      >
        <span class="nav__burger-bar"></span>
        <span class="nav__burger-bar"></span>
      </button>
      </div>
    </div>
  </div>

</nav>

{/* Drawer mobile — RENDERED OUTSIDE <nav> on purpose.
    El <nav> tiene backdrop-filter, lo que crea un containing block para
    position:fixed children y rompe inset:0 (queda anclado al nav, no al viewport).
    Como sibling de <nav>, el drawer queda libre y cubre todo bien. */}
<div id="nav-drawer" class="nav__drawer" data-drawer hidden aria-label="Mobile menu">
  <div class="nav__drawer-head">
    <span class="nav__drawer-title">{en.nav.menu}</span>
    <button type="button" class="nav__drawer-close" aria-label={en.nav.close} data-drawer-close>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18" stroke-linecap="round"/>
        <line x1="18" y1="6" x2="6" y2="18" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <ul class="nav__drawer-list">
    <li><span class="nav__drawer-section">{en.nav.shop}</span></li>
    {shopSubmenu.map(item => (
      <li><a href={item.href}>{item.label}</a></li>
    ))}
    <li class="nav__drawer-rule" aria-hidden="true"></li>
    {mainItems.map(item => (
      <li><a href={item.href}>{item.label}</a></li>
    ))}
    <li><a href="/contact">{en.nav.contact}</a></li>
    <li><a href="/local">{en.nav.local}</a></li>
    <li class="nav__drawer-rule" aria-hidden="true"></li>
    <li>
      <a href={STORE_CART_URL} target="_blank" rel="noopener">{en.nav.cart}</a>
    </li>
  </ul>
</div>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('[data-shop-trigger]');
  const menu = document.querySelector<HTMLUListElement>('[data-shop-menu]');
  const wrap = trigger?.closest('.nav__shop-wrap');

  const openMenu = () => {
    if (!menu || !trigger) return;
    menu.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
  };
  const closeMenu = () => {
    if (!menu || !trigger) return;
    menu.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
  };

  trigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (trigger.getAttribute('aria-expanded') === 'true') closeMenu();
    else openMenu();
  });
  wrap?.addEventListener('mouseenter', openMenu);
  wrap?.addEventListener('mouseleave', closeMenu);
  document.addEventListener('click', (e) => {
    if (!wrap?.contains(e.target as Node)) closeMenu();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const drawer = document.querySelector<HTMLDivElement>('[data-drawer]');
  const drawerClose = document.querySelector<HTMLButtonElement>('[data-drawer-close]');

  const openDrawer = () => {
    if (!drawer || !burger) return;
    drawer.hidden = false;
    requestAnimationFrame(() => drawer.classList.add('is-open'));
    burger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const closeDrawer = () => {
    if (!drawer || !burger) return;
    drawer.classList.remove('is-open');
    burger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => { if (drawer) drawer.hidden = true; }, 300);
  };

  burger?.addEventListener('click', openDrawer);
  drawerClose?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.hidden) closeDrawer();
  });

  /* Close drawer when user navigates via any link inside it (UX) */
  drawer?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      if (drawer && !drawer.hidden) closeDrawer();
    });
  });

  /* Close drawer if user taps the empty area to the side (defensive UX) */
  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer) closeDrawer();
  });
</script>
