---
/**
 * Nav — Kiwi-simple, Wenu-dark (2026-06-23 redesign).
 * Bar = hamburger · centered logo · search + cart. ALL navigation lives in a
 * calm slide-out drawer: one line per destination, hairline dividers, air.
 * Shop expands to the REAL brand collections (data/collections.ts).
 * Old mega-menu retired. Reversible via git.
 */
import en from '../i18n/en.json';
import { getProducts, getHeroImage, formatPrice, decodeEntities } from '../lib/woo';

// Account → on-brand apex page /account (2026-07-17, audit fix). Pointing the nav
// straight at the WordPress www /my-account/ broke apex-first coherence and returned
// 406 to non-browser clients. So the nav lands on /account (apex, 200, on-brand),
// and /account itself carries a clear "Sign in / create account" link to the real
// WordPress login (WooCommerce + Ultimate Member + Nextend). Login stays one click
// away; the broken cross-host link is gone.
const ACCOUNT_URL = '/account';

// ── "LO NUEVO" — newest published pieces for the New arrivals drawer preview.
// getProducts() is build-time and cached, so this is free. Filter to real macro
// photos (no placeholders), sort by WooCommerce date_created desc, take 4.
const PLACEHOLDER_IMG = /chatgpt-image|sin-?titulo|sin-?t[íi]tulo|placeholder|untitled/i;
const _allProducts = await getProducts();
const newArrivals = _allProducts
  .filter(p => p.images.length > 0 && p.images[0].src && !PLACEHOLDER_IMG.test(p.images[0].src))
  .sort((a, b) => {
    const da = a.date_created_gmt || a.date_created || '';
    const db = b.date_created_gmt || b.date_created || '';
    return db.localeCompare(da);
  })
  .slice(0, 4)
  .map(p => {
    const img = getHeroImage(p);
    return { slug: p.slug, name: decodeEntities(p.name), price: formatPrice(p.price), img: img?.src || null };
  });

// The FOUR doors of the site (Wültufe architecture 2026-06-29): shop · design ·
// book · care. Everything else is secondary, lower in the drawer.
const doors = [
  { href: '/shop',           label: 'Shop Jewelry' },
  { href: '/constelaciones', label: 'Design Your Ear · Wültufe' },
  { href: '/piercing',       label: 'Book a Piercing · Truckee' },
  { href: '/care-guide',     label: 'Care & Healing' },
];
// Collections door → the 10 REAL brand collections (each has its banner).
const collectionLinks = [
  { href: '/collection/origin',    label: 'Origin' },
  { href: '/collection/atacama',   label: 'Atacama' },
  { href: '/collection/araucania', label: 'Araucanía' },
  { href: '/collection/solar',     label: 'Solar' },
  { href: '/collection/neo',       label: 'Neo' },
  { href: '/collection/ornamental',label: 'Ornamental' },
  { href: '/collection/organic',   label: 'Organic' },
  { href: '/collection/fossil',    label: 'Fossil' },
  { href: '/collection/india',     label: 'India' },
  { href: '/collection/maya',      label: 'Maya' },
  { href: '/collections',          label: 'All collections' },
];
// New & Limited door → new + limited + one-of-one (renamed from "The Edit", Ocin 2026-06-25).
const editLinks = [
  { href: '/new-arrivals',     label: 'New arrivals' },
  { href: '/limited-objects',  label: 'Limited objects' },
  { href: '/stones-one-of-one',label: 'Stones & one of one' },
];
// Piercing · service door → expands to the high-value service sub-items.
const piercingLinks = [
  { href: '/piercing',            label: 'Book a session' },
  { href: '/care-guide',          label: 'Aftercare' },
  { href: '/care-guide#downsize', label: 'Downsize' },
  { href: '/piercing-jewelry',    label: 'Upgrade your jewelry' },
  { href: '/constelaciones',      label: 'Design your ear' },
  { href: '/shop',                label: 'Recommendations' },
  { href: '/sizing-guide',        label: 'Sizing guide' },
];
// Secondary — out of the main doors.
const secondary = [
  { href: '/shop',          label: 'Shop all' },
  { href: '/custom-orders', label: 'Atelier' },
  { href: '/about',         label: 'About' },
  { href: '/manifesto',     label: 'Manifesto' },
  { href: '/journal',       label: 'Journal' },
];
---
<nav class="navk" aria-label="Primary">
  <div class="navk__bar">
    <button type="button" class="navk__burger" data-burger aria-label={en.nav.menu} aria-controls="navk-drawer" aria-expanded="false">
      <span class="navk__burger-bar"></span>
      <span class="navk__burger-bar"></span>
    </button>

    <a href="/" class="navk__logo" aria-label="Wenu Mapu home">
      <span class="navk__brand-row">
        <img src="/logos/wenu-word-woven.webp" alt="" width="589" height="154" class="navk__word navk__word--wenu" aria-hidden="true" />
        <img src="/img/brand/wenu-mandala-transparent.webp" alt="" width="120" height="120" class="navk__mark" aria-hidden="true" />
        <img src="/logos/mapu-word-woven.webp" alt="" width="613" height="136" class="navk__word navk__word--mapu" aria-hidden="true" />
      </span>
    </a>

    <div class="navk__icons">
      <a
        href="https://www.instagram.com/wenu__mapu"
        target="_blank"
        rel="noopener me"
        class="navk__icon navk__icon--ig"
        aria-label="Instagram · @wenu__mapu"
        title="Instagram · @wenu__mapu"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/>
        </svg>
      </a>
      <button type="button" class="navk__icon" data-search-trigger aria-label={en.nav.search} title="Search · /">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5"/><line x1="20" y1="20" x2="15.5" y2="15.5"/>
        </svg>
      </button>
      <a href="/cart" class="navk__icon navk__cart" data-cart-open aria-label={en.nav.cart}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M3 5h2.5l2.4 11.2a2 2 0 0 0 2 1.6h7.5a2 2 0 0 0 2-1.5L21 8H6" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9.5" cy="20.5" r="1.2"/><circle cx="17.5" cy="20.5" r="1.2"/>
        </svg>
        <span class="navk__cart-count" data-cart-count hidden></span>
      </a>
    </div>
  </div>
</nav>

{/* Slide-out drawer — sibling of <nav> so position:fixed anchors to the viewport. */}
<div id="navk-drawer" class="navkd" data-drawer hidden aria-label={en.nav.menu}>
  <div class="navkd__panel">
    <button type="button" class="navkd__close" data-drawer-close aria-label={en.nav.close}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18" stroke-linecap="round"/><line x1="18" y1="6" x2="6" y2="18" stroke-linecap="round"/>
      </svg>
    </button>

    {/* Kai — recibe al usuario que abre el menú. Compañero de marca, no un
        asistente de soporte: sprite pixel-art animado por cuadros (12 poses,
        motor en public/kai/kai-anim.js), montado solo mientras el drawer está
        abierto (ver <script> abajo). Vive en su "niche" dorado (.kai-niche,
        global.css), ancho completo del contenido del drawer. Intensidad A
        (sutil) del efecto CRT — retro-glow pass 2026-07-12. */}
    <div class="navkd__kai" data-kai-menu>
      {/* ONE long screen (Ocin 2026-07-15): a single LCD holding Kai + his line,
          the living cosmos behind them. A black-and-white mapuche textile panel
          covers it by default — it reads as part of the page — and parts like a
          curtain on tap to reveal Kai. */}
      <button type="button" class="kai-niche kai-niche--a navkd__kai-screen" data-kai-reveal
              aria-label="Wake Kai">
        <span class="kai-niche__aura" aria-hidden="true"></span>
        <span class="kai-niche__scanlines" aria-hidden="true"></span>
        <span class="navkd__kai-inner">
          <span class="navkd__kai-stage">
            <canvas id="navkd-kai-canvas" class="navkd__kai-sprite" width="72" height="72" aria-hidden="true"></canvas>
          </span>
          <span class="navkd__kai-text">
            <span class="kai-niche__label" aria-hidden="true">KAI</span>
            <span class="navkd__kai-line" id="navkd-kai-line">Hey - I'm Kai. Need a paw?</span>
          </span>
        </span>
        <span class="navkd__kai-cover" data-kai-textile aria-hidden="true"></span>
      </button>
    </div>

    <ul class="navkd__list">
      {doors.map(d => (<li><a href={d.href}>{d.label}</a></li>))}
      <li class="navkd__has-sub">
        <button type="button" class="navkd__expand" data-acc-toggle aria-expanded="false">
          <span>Piercing · service</span>
          <span class="navkd__chev" aria-hidden="true">›</span>
        </button>
        <ul class="navkd__sub" data-acc hidden>
          {piercingLinks.map(l => (<li><a href={l.href}>{l.label}</a></li>))}
        </ul>
      </li>
      <li class="navkd__has-sub">
        <button type="button" class="navkd__expand" data-acc-toggle aria-expanded="false">
          <span>Collections</span>
          <span class="navkd__chev" aria-hidden="true">›</span>
        </button>
        <ul class="navkd__sub" data-acc hidden>
          {collectionLinks.map(l => (<li><a href={l.href}>{l.label}</a></li>))}
        </ul>
      </li>
      <li class="navkd__has-sub navkd__has-sub--new">
        <button type="button" class="navkd__expand" data-acc-toggle aria-expanded="false">
          <span class="navkd__new-label">New &amp; Limited <span class="navkd__pill" aria-hidden="true">Lo nuevo</span></span>
          <span class="navkd__chev" aria-hidden="true">›</span>
        </button>
        <div class="navkd__sub navkd__sub--new" data-acc hidden>
          {newArrivals.length > 0 && (
            <div class="navkd__newgrid" aria-label="Newest pieces">
              {newArrivals.map(p => (
                <a href={`/p/${p.slug}`} class="navkd__newcard">
                  <span class="navkd__newthumb">
                    {p.img
                      ? <img src={p.img} alt={p.name} width="120" height="120" loading="lazy" decoding="async" />
                      : <span class="navkd__newthumb-ph" aria-hidden="true">✦</span>}
                  </span>
                  <span class="navkd__newname">{p.name}</span>
                  {p.price && <span class="navkd__newprice">{p.price}</span>}
                </a>
              ))}
            </div>
          )}
          <ul class="navkd__newlinks">
            {editLinks.map(l => (<li><a href={l.href}>{l.label}</a></li>))}
          </ul>
        </div>
      </li>
    </ul>

    <ul class="navkd__list navkd__list--secondary">
      {secondary.map(l => (
        <li><a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a></li>
      ))}
    </ul>

    <div class="navkd__foot">
      <a href={ACCOUNT_URL} class="navkd__account">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6" stroke-linecap="round"/>
        </svg>
        <span>Account</span>
      </a>
    </div>
  </div>
</div>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const drawer = document.querySelector<HTMLDivElement>('[data-drawer]');
  const drawerClose = document.querySelector<HTMLButtonElement>('[data-drawer-close]');

  // Kai — motor de animación por cuadros (public/kai/kai-anim.js), montado
  // solo mientras el drawer está abierto (nada corre en segundo plano el
  // resto del tiempo).
  const kaiCanvas = document.getElementById('navkd-kai-canvas') as HTMLCanvasElement | null;
  const kaiLine = document.getElementById('navkd-kai-line');
  let kaiCtl: { trigger: (s: string) => void; poke: () => void; destroy: () => void } | null = null;
  let kaiGreetT: number | null = null;
  let kaiLineT: number | null = null;

  // Personality pass (2026-07-13, owner tone: cosmic/mystic + tender + soft
  // jokes, mapuche soul "connected to the cosmos"). ASCII punctuation only
  // (no em-dash/ellipsis glyphs - "-"/"."/"..." instead). Every bank rotates
  // at random via pick(), avoiding the same line twice in a row.
  const KAI_GREETINGS = [
    "Mari mari. The sky sent you here.",
    "Wander with me. Every path glows.",
    "Looking for a piece of the cosmos?",
    "The stars drew a map. Let's read it.",
  ];
  const KAI_PET_LINES = [
    "Aww. Cosmic scritches, yes please.",
    "*happy hum from the stars*",
    "You found me. Both my eyes agree: nice.",
  ];
  const KAI_WAKE_LINES = [
    "*yawn* dreaming of meteor showers.",
    "Oh, you're back. The stars missed you.",
  ];
  const KAI_SLEEP_LINES = ["*curls under the stars* wake me if you need me."];
  // Idle/ambient — fires off the engine's own ~9-15s "glance" timer while
  // resting; shows ~3s, then reverts to whatever was showing before. Soft
  // jokes mixed in at ~1-in-4/5 (see pickAmbientOrJoke()).
  const KAI_AMBIENT_LINES = [
    "Every stone fell from somewhere. Wild, right?",
    "I'm small, but I've seen galaxies.",
    "Take your time. Light travels slow out here.",
    "One eye of sky, one of earth. Both watching.",
    "*stargazing with you*",
    "Tell me your story. I'll find your piece.",
    "Need a paw? I read stars for a living.",
  ];
  const KAI_JOKE_LINES = [
    "I'm fluent in two tongues: bark and starlight.",
    "They said sit. I chose to guide you.",
    "Bob-tailed, yet the universe still spins.",
  ];

  let lastGreeting: string | null = null;
  let lastPet: string | null = null;
  let lastWake: string | null = null;
  let lastAmbient: string | null = null;
  let restingLine = '';

  function pick(arr: string[], avoid?: string | null): string {
    if (arr.length === 1) return arr[0];
    let choice = arr[Math.floor(Math.random() * arr.length)];
    let guard = 0;
    while (choice === avoid && guard++ < 6) choice = arr[Math.floor(Math.random() * arr.length)];
    return choice;
  }
  function pickAmbientOrJoke(): string {
    const line = Math.random() < 0.22 ? pick(KAI_JOKE_LINES, lastAmbient) : pick(KAI_AMBIENT_LINES, lastAmbient);
    lastAmbient = line;
    return line;
  }
  function showTemp(text: string, ms: number) {
    if (kaiLine) kaiLine.textContent = text;
    if (kaiLineT) window.clearTimeout(kaiLineT);
    kaiLineT = window.setTimeout(() => { if (kaiLine) kaiLine.textContent = restingLine; }, ms);
  }

  function kaiOnAmbient(kind: string, text?: string) {
    if (!kaiLine) return;
    if (kind === 'trick') {
      // 2026-07-17 (TRUCOS de Kai): the engine passes the trick's own fixed
      // phrase straight through — no host-side pick() bank for this one.
      if (text) showTemp(text, 2600);
    } else if (kind === 'pet') {
      lastPet = pick(KAI_PET_LINES, lastPet);
      showTemp(lastPet, 2200);
    } else if (kind === 'glance') {
      showTemp(pickAmbientOrJoke(), 3000);
    } else if (kind === 'sleep') {
      if (kaiLineT) { window.clearTimeout(kaiLineT); kaiLineT = null; }
      kaiLine.textContent = pick(KAI_SLEEP_LINES);
    } else if (kind === 'wake') {
      lastWake = pick(KAI_WAKE_LINES, lastWake);
      showTemp(lastWake, 2600);
    }
  }

  const openDrawer = () => {
    if (!drawer || !burger) return;
    drawer.hidden = false;
    requestAnimationFrame(() => drawer.classList.add('is-open'));
    burger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    document.querySelector('[data-kai-reveal]')?.classList.remove('is-open'); // cover Kai each open
    if (!kaiCtl && kaiCanvas && (window as any).kaiAnim) {
      kaiCtl = (window as any).kaiAnim(kaiCanvas, {
        width: 72, height: 72, targetHeight: 52,
        initial: 'alert', onAmbient: kaiOnAmbient,
      });
      lastGreeting = pick(KAI_GREETINGS, lastGreeting);
      restingLine = lastGreeting;
      if (kaiLine) kaiLine.textContent = lastGreeting;
      kaiGreetT = window.setTimeout(() => { kaiCtl?.trigger('idle'); }, 2600);
    }
  };
  const closeDrawer = () => {
    if (!drawer || !burger) return;
    drawer.classList.remove('is-open');
    burger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => { if (drawer) drawer.hidden = true; }, 320);
    if (kaiGreetT) { window.clearTimeout(kaiGreetT); kaiGreetT = null; }
    if (kaiLineT) { window.clearTimeout(kaiLineT); kaiLineT = null; }
    if (kaiCtl) { kaiCtl.destroy(); kaiCtl = null; }
  };
  // Kai reveal: the screen is covered by the B&W textile until tapped. First tap
  // parts the curtain (reveals Kai + cosmos); after that, taps fall through to
  // Kai's own handlers (long-press = home, etc). Reset to covered each open.
  const kaiScreen = document.querySelector('[data-kai-reveal]') as HTMLElement | null;
  let kaiTaps = 0; let kaiTapT: number | null = null;
  kaiScreen?.addEventListener('click', () => {
    if (kaiScreen.classList.contains('is-open')) return;  // already revealed → let Kai handle
    kaiTaps++;
    if (kaiTapT) window.clearTimeout(kaiTapT);
    if (kaiTaps >= 3) {                                    // three taps parts the curtain
      kaiTaps = 0;
      kaiScreen.classList.add('is-open');
      kaiCtl?.trigger('wake');
    } else {
      kaiTapT = window.setTimeout(() => { kaiTaps = 0; }, 900);
    }
  });

  burger?.addEventListener('click', openDrawer);
  drawerClose?.addEventListener('click', closeDrawer);
  drawer?.addEventListener('click', (e) => { if (e.target === drawer) closeDrawer(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer && !drawer.hidden) closeDrawer(); });
  drawer?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { if (drawer && !drawer.hidden) closeDrawer(); }));

  // Accordions (Collections · The Edit)
  document.querySelectorAll<HTMLButtonElement>('[data-acc-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const sub = btn.parentElement?.querySelector<HTMLElement>('[data-acc]');
      if (!sub) return;
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      sub.hidden = open;
    });
  });
</script>

<style>
  .navk {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 10, 10, 0.82);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .navk__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-3);
    max-width: var(--max-w);
    margin: 0 auto;
    padding: var(--space-3) var(--gutter);
  }
  .navk__burger {
    justify-self: start;
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    width: 30px;
    padding: 6px 0;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .navk__burger-bar { display: block; height: 1px; width: 24px; background: var(--bone); transition: background var(--t-fast); }
  .navk__burger:hover .navk__burger-bar { background: var(--ember); }

  .navk__logo { justify-self: center; display: inline-flex; text-decoration: none; }
  .navk__brand-row { display: inline-flex; align-items: center; gap: clamp(6px, 1.4vw, 14px); }
  .navk__word { height: clamp(16px, 2.4vw, 22px); width: auto; opacity: 0.95; }
  .navk__mark {
    height: clamp(26px, 3.4vw, 34px); width: auto;
    /* Slow continuous portal rotation — reconnected 2026-06-26 (the spin rule was
       orphaned on the old .nav__brand-mark class after the navk redesign). Uses
       transform only, so the Solar invert filter is untouched. Keyframes live in
       global.css (nav-mark-spin). */
    animation: nav-mark-spin 50s linear infinite;
    transform-origin: 50% 50%;
  }
  .navk__logo:hover .navk__mark { animation-duration: 18s; }
  @media (prefers-reduced-motion: reduce) {
    .navk__mark { animation: none; }
  }

  .navk__icons { justify-self: end; display: inline-flex; align-items: center; gap: var(--space-3); }
  .navk__icon { display: inline-flex; background: none; border: 0; color: var(--bone); cursor: pointer; padding: 4px; transition: color var(--t-fast); text-decoration: none; }
  .navk__icon:hover { color: var(--ember); }
  .navk__cart { position: relative; }
  .navk__cart-count {
    position: absolute; top: -2px; right: -4px;
    min-width: 16px; height: 16px; padding: 0 4px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--ember); color: var(--obsidian);
    font-family: var(--font-mono); font-size: 10px; line-height: 1; font-weight: 600;
    border-radius: 9px;
  }
  .navk__cart-count[hidden] { display: none; }

  /* ── Drawer ── */
  .navkd {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(6, 5, 4, 0.6);
    opacity: 0;
    transition: opacity var(--t-base);
  }
  .navkd.is-open { opacity: 1; }
  .navkd__panel {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: min(86vw, 420px);
    background: var(--obsidian);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    padding: var(--space-5) var(--space-5) var(--space-4);
    transform: translateX(-100%);
    transition: transform var(--t-slow);
    overflow-y: auto;
  }
  .navkd.is-open .navkd__panel { transform: none; }

  .navkd__close {
    align-self: flex-start;
    background: none; border: 0; color: var(--silver); cursor: pointer;
    padding: 4px; margin-bottom: var(--space-5);
    transition: color var(--t-fast);
  }
  .navkd__close:hover { color: var(--bone); }

  /* ── Kai — ONE long cosmos screen, revealed from behind a B&W textile
        (Ocin 2026-07-15). Single frame; Kai + his line live INSIDE it. ── */
  .navkd__kai {
    padding: 0 0 var(--space-4);
    margin-bottom: var(--space-2);
    border-bottom: 1px solid var(--line-soft);
  }
  /* the single long LCD (a <button>, so tap reveals Kai). Overrides the
     column .kai-niche into a wide horizontal screen. */
  .navkd__kai .navkd__kai-screen {
