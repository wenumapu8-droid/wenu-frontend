---
import en from '../i18n/en.json';

const FALLBACK_EMAIL = 'marimari@wenumapuonline.com';
const subject = encodeURIComponent(en.newsletter.fallback_subject);
const mailto = `mailto:${FALLBACK_EMAIL}?subject=${subject}`;
---
<section class="newsletter" aria-labelledby="newsletter-title">
  <div class="newsletter__media" aria-hidden="true">
    {/* Cinematic altar — three-step stone pedestal, central candle, ember halo,
        cardinal sigils at the corners, rising smoke. Pure SVG so it scales sharp
        on any viewport and respects prefers-reduced-motion. */}
    <svg
      class="newsletter__altar"
      viewBox="0 0 400 600"
      preserveAspectRatio="xMidYMax meet"
      role="img"
      aria-label="Wenu Mapu altar — a single candle flickering on a three-step stone pedestal under four cardinal sigils"
    >
      <defs>
        {/* Night sky behind the altar — obsidian + faint ember glow at base */}
        <radialGradient id="nl-sky" cx="50%" cy="78%" r="62%">
          <stop offset="0%"  stop-color="#3a2613" stop-opacity="0.85"/>
          <stop offset="35%" stop-color="#141210" stop-opacity="1"/>
          <stop offset="100%" stop-color="#080706" stop-opacity="1"/>
        </radialGradient>

        {/* Halo behind the flame — radial ember */}
        <radialGradient id="nl-halo" cx="50%" cy="50%" r="50%">
          <stop offset="0%"  stop-color="#ffd9a3" stop-opacity="0.85"/>
          <stop offset="25%" stop-color="#C4935A" stop-opacity="0.55"/>
          <stop offset="55%" stop-color="#8A6A43" stop-opacity="0.18"/>
          <stop offset="100%" stop-color="#080706" stop-opacity="0"/>
        </radialGradient>

        {/* Flame body — bright hot core to deeper ember outer */}
        <radialGradient id="nl-flame" cx="50%" cy="30%" r="65%">
          <stop offset="0%"  stop-color="#FFF6DA" stop-opacity="1"/>
          <stop offset="25%" stop-color="#FFD08A" stop-opacity="0.95"/>
          <stop offset="60%" stop-color="#C4935A" stop-opacity="0.85"/>
          <stop offset="100%" stop-color="#5a3719" stop-opacity="0"/>
        </radialGradient>

        {/* Wax candle gradient — bone shadowed by halo */}
        <linearGradient id="nl-wax" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%"  stop-color="#5a4434"/>
          <stop offset="45%" stop-color="#D6C1A3"/>
          <stop offset="65%" stop-color="#F2EDE4"/>
          <stop offset="100%" stop-color="#5a4434"/>
        </linearGradient>

        {/* Stone step gradient — top-lit by the candle */}
        <linearGradient id="nl-stone" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%"  stop-color="#2a221c"/>
          <stop offset="100%" stop-color="#0c0a08"/>
        </linearGradient>

        {/* Smoke gradient */}
        <linearGradient id="nl-smoke" x1="0%" y1="100%" x2="0%" y2="0%">
          <stop offset="0%"  stop-color="#A8A39A" stop-opacity="0.55"/>
          <stop offset="100%" stop-color="#A8A39A" stop-opacity="0"/>
        </linearGradient>

        {/* Cardinal sigil reused at corners */}
        <symbol id="nl-sigil" viewBox="0 0 32 32" overflow="visible">
          <g fill="none" stroke="#C4935A" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4 L24 16 L16 28 L8 16 Z" stroke-width="1.4"/>
            <path d="M16 4 L16 28 M4 16 L28 16"  stroke-width="0.9" stroke-opacity="0.55"/>
            <circle cx="16" cy="16" r="2"   stroke-width="1.2"/>
            <circle cx="16" cy="16" r="0.8" fill="#C4935A" stroke="none"/>
          </g>
        </symbol>
      </defs>

      {/* Night sky background */}
      <rect x="0" y="0" width="400" height="600" fill="url(#nl-sky)"/>

      {/* 4 corner sigils — meli witran mapu enmarcando el altar */}
      <use href="#nl-sigil" x="22"  y="22"  width="32" height="32" opacity="0.5"/>
      <use href="#nl-sigil" x="346" y="22"  width="32" height="32" opacity="0.5"/>
      <use href="#nl-sigil" x="22"  y="546" width="32" height="32" opacity="0.4"/>
      <use href="#nl-sigil" x="346" y="546" width="32" height="32" opacity="0.4"/>

      {/* Hairline frame */}
      <rect x="36" y="36" width="328" height="528" fill="none" stroke="#8A6A43" stroke-opacity="0.35" stroke-width="0.6"/>

      {/* Three-step altar — perspective: each step wider as it descends */}
      <g class="nl-altar-steps">
        {/* step 3 (bottom, widest) */}
        <path d="M60 540 L340 540 L320 580 L80 580 Z" fill="url(#nl-stone)" stroke="#3a2e22" stroke-width="0.5"/>
        {/* step 2 */}
        <path d="M90 500 L310 500 L300 540 L100 540 Z" fill="url(#nl-stone)" stroke="#3a2e22" stroke-width="0.5"/>
        {/* step 1 (top) */}
        <path d="M130 460 L270 460 L260 500 L140 500 Z" fill="url(#nl-stone)" stroke="#3a2e22" stroke-width="0.5"/>
        {/* small offerings on steps — tiny ember dots */}
        <circle cx="105" cy="540" r="1.6" fill="#C4935A" opacity="0.7"/>
        <circle cx="295" cy="540" r="1.6" fill="#C4935A" opacity="0.7"/>
        <circle cx="118" cy="500" r="1.2" fill="#C4935A" opacity="0.55"/>
        <circle cx="282" cy="500" r="1.2" fill="#C4935A" opacity="0.55"/>
      </g>

      {/* Pedestal directly under the candle */}
      <rect x="170" y="430" width="60" height="30" fill="url(#nl-stone)" stroke="#3a2e22" stroke-width="0.5"/>

      {/* Halo behind the candle (large radial ember) */}
      <circle class="nl-halo" cx="200" cy="370" r="170" fill="url(#nl-halo)"/>

      {/* Smoke rising from flame */}
      <path class="nl-smoke" d="M200 280 Q198 220 202 180 Q197 140 200 100" fill="none" stroke="url(#nl-smoke)" stroke-width="6" stroke-linecap="round" opacity="0.4"/>

      {/* Candle body */}
      <g class="nl-candle">
        <rect x="192" y="330" width="16" height="100" fill="url(#nl-wax)" stroke="#3a2e22" stroke-width="0.4"/>
        {/* small drip */}
        <path d="M196 360 Q195 372 198 376 Q201 372 200 360 Z" fill="#F2EDE4" opacity="0.6"/>
        {/* wick */}
        <line x1="200" y1="330" x2="200" y2="318" stroke="#1a1410" stroke-width="1.4"/>
      </g>

      {/* Flame — two layers (outer + bright core) with independent animation */}
      <g class="nl-flame-group">
        <ellipse class="nl-flame-outer" cx="200" cy="306" rx="14" ry="26" fill="url(#nl-flame)"/>
        <ellipse class="nl-flame-core"  cx="200" cy="302" rx="6"  ry="14" fill="#FFF6DA" opacity="0.95"/>
      </g>

      {/* Spark embers floating — 3 tiny dots that drift upward */}
      <g class="nl-sparks" fill="#FFD08A">
        <circle class="nl-spark nl-spark-1" cx="190" cy="290" r="0.8"/>
        <circle class="nl-spark nl-spark-2" cx="210" cy="280" r="0.6"/>
        <circle class="nl-spark nl-spark-3" cx="202" cy="270" r="0.5"/>
      </g>

      {/* Bottom hairline */}
      <line x1="60" y1="580" x2="340" y2="580" stroke="#C4935A" stroke-opacity="0.25" stroke-width="0.5"/>
    </svg>
  </div>

  <div class="newsletter__copy">
    <div class="newsletter__head">
      <span class="sacred-mark" style="width:18px;height:18px;color:var(--bronze);"></span>
      <p class="eyebrow">{en.newsletter.eyebrow}</p>
    </div>
    <h2 id="newsletter-title" class="newsletter__title">{en.newsletter.title}</h2>
    <p class="newsletter__body">{en.newsletter.body}</p>

    {/*
      Direct form submissions are temporarily disabled. Until a real
      subscription endpoint is provisioned, we route every interested
      visitor to a real human inbox via mailto. No fake submit, no fake
      success state.
    */}
    <p class="newsletter__fallback">{en.newsletter.fallback}</p>
    <a class="btn btn--solid newsletter__fallback-cta" href={mailto}>
      {en.newsletter.fallback_cta}
    </a>
  </div>
</section>

<style>
  /* The .newsletter / .newsletter__media / .newsletter__copy / .newsletter__title
     etc. base styles live in global.css. We only add the altar-specific bits here
     so the global file stays as-is. */

  .newsletter__altar {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .newsletter__media {
    position: relative;
    overflow: hidden;
  }

  /* Halo pulse — soft 4s breath */
  @media (prefers-reduced-motion: no-preference) {
    .nl-halo {
      transform-origin: 200px 370px;
      animation: nl-halo-pulse 4.6s ease-in-out infinite;
    }
    @keyframes nl-halo-pulse {
      0%, 100% { transform: scale(1);    opacity: 1; }
      50%      { transform: scale(1.08); opacity: 0.85; }
    }

    /* Flame outer — irregular flicker (scale + skew + slight horizontal nudge) */
    .nl-flame-outer {
      transform-origin: 200px 332px;
      animation: nl-flame-outer 2.7s ease-in-out infinite;
    }
    @keyframes nl-flame-outer {
      0%   { transform: scale(1, 1)       translateX(0)  skewX(0deg); opacity: 0.95; }
      18%  { transform: scale(0.96, 1.08) translateX(-1px) skewX(-1.5deg); opacity: 1; }
      35%  { transform: scale(1.04, 0.94) translateX(1px)  skewX(2deg); opacity: 0.9; }
      52%  { transform: scale(0.98, 1.05) translateX(-0.5px) skewX(-1deg); opacity: 0.98; }
      68%  { transform: scale(1.05, 1)    translateX(1.5px)  skewX(1.5deg); opacity: 1; }
      85%  { transform: scale(0.97, 1.03) translateX(-1px) skewX(-0.5deg); opacity: 0.92; }
      100% { transform: scale(1, 1)       translateX(0)  skewX(0deg); opacity: 0.95; }
    }
    /* Flame core — independent rhythm so layers separate */
    .nl-flame-core {
      transform-origin: 200px 312px;
      animation: nl-flame-core 1.8s ease-in-out infinite;
    }
    @keyframes nl-flame-core {
      0%, 100% { transform: scale(1, 1)    translateY(0); opacity: 0.95; }
      30%      { transform: scale(0.9, 1.1) translateY(-2px); opacity: 1; }
      60%      { transform: scale(1.05, 0.92) translateY(1px); opacity: 0.88; }
    }

    /* Smoke — slowly drifts up + opacity wave */
    .nl-smoke {
      transform-origin: 200px 280px;
      animation: nl-smoke-drift 7s ease-in-out infinite;
    }
    @keyframes nl-smoke-drift {
      0%   { transform: translateY(0)   skewX(0deg); opacity: 0.32; }
      40%  { transform: translateY(-20px) skewX(-2deg); opacity: 0.5; }
      80%  { transform: translateY(-40px) skewX(2deg); opacity: 0.2; }
      100% { transform: translateY(0)    skewX(0deg); opacity: 0.32; }
    }

    /* Sparks — 3 staggered drifts upward fading out */
    .nl-spark {
      transform-origin: center;
      animation: nl-spark-rise 3.8s ease-out infinite;
      opacity: 0;
    }
    .nl-spark-1 { animation-delay: 0s; }
    .nl-spark-2 { animation-delay: 1.4s; }
    .nl-spark-3 { animation-delay: 2.6s; }
    @keyframes nl-spark-rise {
      0%   { transform: translate(0, 0)     scale(1); opacity: 0; }
      15%  { transform: translate(0, -10px) scale(1.2); opacity: 0.9; }
      80%  { transform: translate(2px, -90px) scale(0.6); opacity: 0.3; }
      100% { transform: translate(-2px, -130px) scale(0.2); opacity: 0; }
    }

    /* Subtle altar steps glow on hover for desktop */
    .newsletter__media:hover .nl-halo { animation-duration: 3s; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nl-halo, .nl-flame-outer, .nl-flame-core, .nl-smoke, .nl-spark {
      animation: none !important;
    }
    .nl-spark { opacity: 0.7; }
  }

  @media (max-width: 900px) {
    .newsletter__altar { max-height: 360px; }
  }
</style>
