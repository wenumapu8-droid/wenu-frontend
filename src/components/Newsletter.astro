---
import en from '../i18n/en.json';

const FALLBACK_EMAIL = 'marimari@wenumapuonline.com';
const subject = encodeURIComponent(en.newsletter.fallback_subject);
const mailto = `mailto:${FALLBACK_EMAIL}?subject=${subject}`;
// Real email capture. Default = the live Wenu Platform backend (Postgres subscriber
// table + welcome email via Titan SMTP + Telegram owner notification). The old
// Formspree form (mblrgwya) was dead (404) and silently dropped every signup.
// Override with PUBLIC_NEWSLETTER_ENDPOINT, or use PUBLIC_KLAVIYO_* for the embed above.
const API_BASE = import.meta.env.PUBLIC_API_URL?.trim() || 'https://api.wenumapuonline.com';
const NEWSLETTER_ENDPOINT = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT?.trim() || `${API_BASE}/newsletter/subscribe`;
const KLAVIYO_COMPANY_ID = import.meta.env.PUBLIC_KLAVIYO_COMPANY_ID?.trim() ?? '';
const KLAVIYO_FORM_ID = import.meta.env.PUBLIC_KLAVIYO_NEWSLETTER_FORM_ID?.trim() ?? '';
const hasKlaviyoEmbed = Boolean(KLAVIYO_COMPANY_ID && KLAVIYO_FORM_ID);
---
<section id="newsletter-signup" class="newsletter" aria-labelledby="newsletter-title">
  {/* Real altar photograph from Wenu Mapu brand book (nueva identidad visual 2026).
      Mapuche sigil floating with rising smoke above a stone pedestal under starlit sky.
      No SVG approximation — this IS the brand. */}
  <div class="newsletter__media" aria-hidden="true">
    <picture>
      <source type="image/avif" srcset="/img/brand/wenu-altar-humo-real.avif"/>
      <source type="image/webp" srcset="/img/brand/wenu-altar-humo-real.webp"/>
      <img
        class="newsletter__altar-img"
        src="/img/brand/wenu-altar-humo-real.webp"
        alt="Wenu Mapu altar — Mapuche sigil with rising smoke over a stone pedestal under starlit sky"
        loading="lazy"
        decoding="async"
        width="1600"
        height="2400"
      />
    </picture>
    <div class="newsletter__media-veil" aria-hidden="true"></div>
    {/* Drifting incense smoke — soft wisps that rise + sway over the chakana. */}
    <div class="newsletter__smoke" aria-hidden="true">
      <span class="newsletter__wisp newsletter__wisp--1"></span>
      <span class="newsletter__wisp newsletter__wisp--2"></span>
      <span class="newsletter__wisp newsletter__wisp--3"></span>
    </div>
    {/* Floating embers — a living sahumerio around the sigil (more present). */}
    <div class="newsletter__sparks" aria-hidden="true">
      {Array.from({ length: 14 }).map((_, i) => (
        <span class={`newsletter__spark newsletter__spark--${i + 1}`}></span>
      ))}
    </div>
  </div>

  <div class="newsletter__copy">
    {/* Use the textile sello (sacred sigil) as the visual mark, not the generic dot */}
    <div class="newsletter__head">
      <picture class="newsletter__sello">
        <source type="image/avif" srcset="/img/brand/wenu-sigil-sacred-sello.avif"/>
        <source type="image/webp" srcset="/img/brand/wenu-sigil-sacred-sello.webp"/>
        <img src="/img/brand/wenu-sigil-sacred-sello.webp" alt="" width="48" height="48" loading="lazy" decoding="async"/>
      </picture>
      <p class="eyebrow">{en.newsletter.eyebrow}</p>
    </div>
    <h2 id="newsletter-title" class="newsletter__title">{en.newsletter.title}</h2>
    <p class="newsletter__body">{en.newsletter.body}</p>

    {hasKlaviyoEmbed ? (
      <>
        <div class="newsletter__embed" data-klaviyo-company-id={KLAVIYO_COMPANY_ID}>
          <div class={`klaviyo-form-${KLAVIYO_FORM_ID}`}></div>
        </div>
        <p class="newsletter__micro">{en.newsletter.microcopy}</p>
      </>
    ) : (
      <form class="newsletter__form" method="POST" action={NEWSLETTER_ENDPOINT} data-newsletter-form>
        <input type="hidden" name="_subject" value="Wenu Mapu — newsletter signup" />
        <input type="hidden" name="list" value="subscriber" />
        <input type="hidden" name="source" value="newsletter-block" />
        {/* honeypot — bots fill this, humans never see it */}
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="newsletter__honey" aria-hidden="true" />
        <label class="visually-hidden" for="nl-email">{en.newsletter.placeholder}</label>
        <div class="newsletter__row">
          <input id="nl-email" class="newsletter__input" type="email" name="email" required placeholder={en.newsletter.placeholder} autocomplete="email" />
          <button type="submit" class="btn btn--solid newsletter__submit">{en.newsletter.submit} <span aria-hidden="true">→</span></button>
        </div>
        <p class="newsletter__micro">{en.newsletter.microcopy}</p>
        <p class="newsletter__success" data-newsletter-success hidden role="status">Welcome to the circle. Watch your inbox for the first signal.</p>
        <p class="newsletter__error" data-newsletter-error hidden role="alert">Something interrupted the signal — <a href={mailto}>email us to join</a>.</p>
      </form>
    )}
  </div>
</section>

{hasKlaviyoEmbed && (
  <script is:inline>
    (() => {
      const host = document.querySelector('[data-klaviyo-company-id]');
      const companyId = host?.getAttribute('data-klaviyo-company-id');
      if (!companyId) return;

      const existing = document.querySelector('script[data-klaviyo-onsite="true"]');
      if (existing) return;

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=${companyId}`;
      script.setAttribute('data-klaviyo-onsite', 'true');
      document.head.appendChild(script);
    })();
  </script>
)}

<style>
  .newsletter__media {
    position: relative;
    overflow: hidden;
    background: var(--obsidian);
  }
  .newsletter__altar-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 50%;
    display: block;
    filter: brightness(0.92) contrast(1.04) saturate(0.92);
  }

  /* Soft ember gradient veil so the right-side copy stays legible */
  .newsletter__media-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 75%, rgba(196,147,90,0.10) 0%, transparent 55%),
      linear-gradient(90deg, transparent 0%, transparent 60%, rgba(8,7,6,0.55) 100%);
    pointer-events: none;
  }

  /* ── Drifting incense smoke — soft wisps over the chakana ── */
  .newsletter__smoke {
    position: absolute; inset: 0; pointer-events: none; overflow: hidden;
    mix-blend-mode: screen;
  }
  .newsletter__wisp {
    position: absolute;
    bottom: 22%;
    width: clamp(120px, 22vw, 240px);
    height: clamp(170px, 32vw, 340px);
    margin-left: calc(clamp(120px, 22vw, 240px) / -2);
    background: radial-gradient(ellipse 52% 62% at 50% 100%, rgba(216,202,182,0.22) 0%, rgba(188,172,150,0.11) 38%, transparent 72%);
    filter: blur(11px);
    border-radius: 50%;
    opacity: 0;
    animation: nl-smoke-rise 16s ease-in-out infinite;
    will-change: transform, opacity;
  }
  .newsletter__wisp--1 { left: 47%; animation-delay: 0s;  animation-duration: 15s; }
  .newsletter__wisp--2 { left: 53%; animation-delay: 5s;  animation-duration: 18s; }
  .newsletter__wisp--3 { left: 50%; animation-delay: 10s; animation-duration: 17s; }
  @keyframes nl-smoke-rise {
    0%   { transform: translate(0, 0) scale(0.8);          opacity: 0; }
    22%  { opacity: 0.5; }
    55%  { transform: translate(14px, -160px) scale(1.15); opacity: 0.34; }
    100% { transform: translate(-10px, -330px) scale(1.5); opacity: 0; }
  }

  /* ── Floating embers — a living sahumerio around the sigil (14, varied) ── */
  .newsletter__sparks { position: absolute; inset: 0; pointer-events: none; }
  .newsletter__spark {
    position: absolute;
    width: 3px; height: 3px;
    background: radial-gradient(circle, #FFE2AC 0%, rgba(201,168,76,0.55) 55%, transparent 100%);
    border-radius: 50%;
    box-shadow: 0 0 7px rgba(255, 210, 140, 0.72), 0 0 15px rgba(201,168,76,0.4);
    opacity: 0;
    animation: nl-spark-rise 5.4s ease-out infinite;
    will-change: transform, opacity;
  }
  .newsletter__spark--1  { left: 43%; bottom: 25%; animation-delay: 0.0s; animation-duration: 5.0s; }
  .newsletter__spark--2  { left: 49%; bottom: 30%; animation-delay: 0.5s; }
  .newsletter__spark--3  { left: 47%; bottom: 24%; animation-delay: 1.1s; animation-duration: 6.2s; }
  .newsletter__spark--4  { left: 52%; bottom: 31%; animation-delay: 1.6s; width: 4px; height: 4px; }
  .newsletter__spark--5  { left: 45%; bottom: 28%; animation-delay: 2.1s; animation-duration: 5.8s; }
  .newsletter__spark--6  { left: 55%; bottom: 26%; animation-delay: 2.6s; }
  .newsletter__spark--7  { left: 50%; bottom: 33%; animation-delay: 3.1s; width: 4px; height: 4px; animation-duration: 6.6s; }
  .newsletter__spark--8  { left: 42%; bottom: 31%; animation-delay: 3.5s; }
  .newsletter__spark--9  { left: 58%; bottom: 29%; animation-delay: 4.0s; animation-duration: 5.2s; }
  .newsletter__spark--10 { left: 53%; bottom: 23%; animation-delay: 0.9s; }
  .newsletter__spark--11 { left: 46%; bottom: 34%; animation-delay: 2.9s; width: 2px; height: 2px; }
  .newsletter__spark--12 { left: 51%; bottom: 27%; animation-delay: 4.4s; animation-duration: 6.0s; }
  .newsletter__spark--13 { left: 48%; bottom: 32%; animation-delay: 1.9s; width: 5px; height: 5px; }
  .newsletter__spark--14 { left: 56%; bottom: 33%; animation-delay: 3.8s; }
  @keyframes nl-spark-rise {
    0%   { transform: translate(0, 0) scale(0.6);        opacity: 0; }
    12%  { transform: translate(0, -16px) scale(1.35);   opacity: 1; }
    60%  { transform: translate(6px, -120px) scale(0.65);opacity: 0.5; }
    100% { transform: translate(-4px, -200px) scale(0.2);opacity: 0; }
  }

  /* Sello as the eyebrow visual */
  .newsletter__sello {
    display: inline-flex;
    width: 36px;
    height: 36px;
  }
  .newsletter__sello img {
    width: 100%;
    height: auto;
    filter: brightness(1.08);
    opacity: 0.9;
  }

  .newsletter__embed {
    margin-top: var(--space-5);
  }

  .newsletter__micro {
    margin: var(--space-3) 0 0;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(240, 237, 232, 0.72);
  }

  /* ── Email capture form ── */
  .newsletter__form { margin-top: var(--space-5); max-width: 30rem; }
  .newsletter__honey { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .newsletter__row { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .newsletter__input {
    flex: 1 1 12rem;
    min-width: 0;
    background: rgba(8, 7, 6, 0.5);
    border: 1px solid var(--line-bright);
    color: var(--bone);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    padding: var(--space-3) var(--space-4);
  }
  .newsletter__input::placeholder { color: var(--silver); }
  .newsletter__input:focus-visible { outline: none; border-color: var(--ember); }
  .newsletter__submit { flex: 0 0 auto; }
  .newsletter__success, .newsletter__error {
    margin: var(--space-3) 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--bone);
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  .newsletter__error { color: var(--clay); }
  .newsletter__error a, .newsletter__success a { color: var(--ember); }

  @media (prefers-reduced-motion: reduce) {
    .newsletter__spark { animation: none !important; opacity: 0.6; }
    .newsletter__wisp { animation: none !important; opacity: 0.18; }
  }
</style>

<script>
  /* Newsletter — AJAX submit so the visitor never leaves the page. Posts JSON
     to the Wenu Platform backend (/newsletter/subscribe), which upserts the
     subscriber, sends a welcome email and pings the owner. On success we swap
     the row for a confirmation. */
  const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const success = form.querySelector<HTMLElement>('[data-newsletter-success]');
      const error = form.querySelector<HTMLElement>('[data-newsletter-error]');
      const row = form.querySelector<HTMLElement>('.newsletter__row');
      if (error) error.hidden = true;
      // honeypot — bots fill this, real humans never see it
      const honey = (form.querySelector('input[name="_gotcha"]') as HTMLInputElement | null)?.value;
      const email = (form.querySelector('input[name="email"]') as HTMLInputElement | null)?.value?.trim();
      const source = (form.querySelector('input[name="source"]') as HTMLInputElement | null)?.value || 'newsletter-block';
      try {
        if (honey) { throw new Error('bot'); }
        const res = await fetch(form.action, {
          method: 'POST',
          body: JSON.stringify({ email, source, lang: 'en' }),
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        });
        if (res.ok) {
          if (row) row.hidden = true;
          const micro = form.querySelector<HTMLElement>('.newsletter__micro');
          if (micro) micro.hidden = true;
          if (success) success.hidden = false;
        } else if (error) {
          error.hidden = false;
        }
      } catch {
        if (error) error.hidden = false;
      }
    });
  }
</script>
