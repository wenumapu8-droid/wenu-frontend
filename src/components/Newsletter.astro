---
import en from '../i18n/en.json';

const FALLBACK_EMAIL = 'marimari@wenumapuonline.com';
const subject = encodeURIComponent(en.newsletter.fallback_subject);
const mailto = `mailto:${FALLBACK_EMAIL}?subject=${subject}`;
---
<section class="newsletter" aria-labelledby="newsletter-title">
  <div class="newsletter__media" aria-hidden="true">
    {/* Cinematic altar v2 — starfield night sky + light ray from above +
        three-step stone pedestal + central candle with twin-layer flicker +
        ember halo with breath pulse + rising smoke + drifting sparks +
        four cardinal sigils framing the corners. Pure SVG. */}
    <svg
      class="newsletter__altar"
      viewBox="0 0 400 600"
      preserveAspectRatio="xMidYMax meet"
      role="img"
      aria-label="Wenu Mapu altar — single candle flickering on a three-step stone pedestal beneath a starlit sky and a sacred light ray"
    >
      <defs>
        {/* Night sky — deep obsidian top, ember warmth at the altar floor */}
        <radialGradient id="nl-sky" cx="50%" cy="82%" r="68%">
          <stop offset="0%"   stop-color="#3a2613" stop-opacity="0.95"/>
          <stop offset="28%"  stop-color="#1a120c" stop-opacity="1"/>
          <stop offset="65%"  stop-color="#0c0a08" stop-opacity="1"/>
          <stop offset="100%" stop-color="#050403" stop-opacity="1"/>
        </radialGradient>

        {/* Light ray from above — soft conical descent onto the altar */}
        <linearGradient id="nl-ray" x1="50%" y1="0%" x2="50%" y2="100%">
          <stop offset="0%"  stop-color="#FFE7C4" stop-opacity="0"/>
          <stop offset="35%" stop-color="#FFD9A3" stop-opacity="0.18"/>
          <stop offset="100%" stop-color="#C4935A" stop-opacity="0"/>
        </linearGradient>

        {/* Halo behind the flame — radial ember */}
        <radialGradient id="nl-halo" cx="50%" cy="50%" r="50%">
          <stop offset="0%"   stop-color="#FFE7C4" stop-opacity="0.95"/>
          <stop offset="22%"  stop-color="#FFD08A" stop-opacity="0.62"/>
          <stop offset="50%"  stop-color="#C4935A" stop-opacity="0.22"/>
          <stop offset="100%" stop-color="#080706" stop-opacity="0"/>
        </radialGradient>

        {/* Flame body */}
        <radialGradient id="nl-flame" cx="50%" cy="30%" r="65%">
          <stop offset="0%"  stop-color="#FFFAE8" stop-opacity="1"/>
          <stop offset="25%" stop-color="#FFD08A" stop-opacity="0.95"/>
          <stop offset="62%" stop-color="#C4935A" stop-opacity="0.78"/>
          <stop offset="100%" stop-color="#5a3719" stop-opacity="0"/>
        </radialGradient>

        {/* Wax candle gradient */}
        <linearGradient id="nl-wax" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%"  stop-color="#5a4434"/>
          <stop offset="45%" stop-color="#D6C1A3"/>
          <stop offset="65%" stop-color="#F2EDE4"/>
          <stop offset="100%" stop-color="#5a4434"/>
        </linearGradient>

        {/* Stone step — top-lit by candle, very dark at base */}
        <linearGradient id="nl-stone" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%"  stop-color="#3a2e22"/>
          <stop offset="55%" stop-color="#1a1410"/>
          <stop offset="100%" stop-color="#080706"/>
        </linearGradient>

        {/* Smoke */}
        <linearGradient id="nl-smoke" x1="0%" y1="100%" x2="0%" y2="0%">
          <stop offset="0%"  stop-color="#D6C1A3" stop-opacity="0.45"/>
          <stop offset="100%" stop-color="#A8A39A" stop-opacity="0"/>
        </linearGradient>

        {/* Star — tiny ember dot */}
        <symbol id="nl-star" viewBox="0 0 2 2">
          <circle cx="1" cy="1" r="1" fill="#F2EDE4"/>
        </symbol>

        {/* Cardinal sigil — meli witran mapu, used at the four corners */}
        <symbol id="nl-sigil" viewBox="0 0 32 32" overflow="visible">
          <g fill="none" stroke="#C4935A" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4 L24 16 L16 28 L8 16 Z" stroke-width="1.4"/>
            <path d="M16 4 L16 28 M4 16 L28 16"  stroke-width="0.9" stroke-opacity="0.55"/>
            <circle cx="16" cy="16" r="2"   stroke-width="1.2"/>
            <circle cx="16" cy="16" r="0.8" fill="#C4935A" stroke="none"/>
          </g>
        </symbol>
      </defs>

      {/* Night sky background */}
      <rect x="0" y="0" width="400" height="600" fill="url(#nl-sky)"/>

      {/* Starfield — ~40 stars varying size + opacity, hand-placed to feel sacred,
          not random. Clustered loose around the ray, denser overhead, sparse low. */}
      <g class="nl-stars">
        <use href="#nl-star" x="42"  y="56"  width="1.6" height="1.6" opacity="0.85"/>
        <use href="#nl-star" x="88"  y="42"  width="1.2" height="1.2" opacity="0.6"/>
        <use href="#nl-star" x="122" y="78"  width="2.2" height="2.2" opacity="0.95"/>
        <use href="#nl-star" x="156" y="46"  width="1.4" height="1.4" opacity="0.7"/>
        <use href="#nl-star" x="200" y="32"  width="2.6" height="2.6" opacity="1" class="nl-star-bright"/>
        <use href="#nl-star" x="244" y="48"  width="1.4" height="1.4" opacity="0.7"/>
        <use href="#nl-star" x="278" y="76"  width="2"   height="2"   opacity="0.9"/>
        <use href="#nl-star" x="312" y="44"  width="1.2" height="1.2" opacity="0.6"/>
        <use href="#nl-star" x="358" y="58"  width="1.6" height="1.6" opacity="0.85"/>

        <use href="#nl-star" x="58"  y="118" width="1.4" height="1.4" opacity="0.7"/>
        <use href="#nl-star" x="108" y="138" width="2.2" height="2.2" opacity="0.95"/>
        <use href="#nl-star" x="178" y="98"  width="1.4" height="1.4" opacity="0.65"/>
        <use href="#nl-star" x="232" y="122" width="1.6" height="1.6" opacity="0.8"/>
        <use href="#nl-star" x="286" y="106" width="2"   height="2"   opacity="0.9" class="nl-star-bright"/>
        <use href="#nl-star" x="338" y="132" width="1.4" height="1.4" opacity="0.7"/>

        <use href="#nl-star" x="46"  y="188" width="1.2" height="1.2" opacity="0.55"/>
        <use href="#nl-star" x="92"  y="208" width="1.4" height="1.4" opacity="0.6"/>
        <use href="#nl-star" x="312" y="208" width="1.4" height="1.4" opacity="0.6"/>
        <use href="#nl-star" x="358" y="188" width="1.2" height="1.2" opacity="0.55"/>

        <use href="#nl-star" x="62"  y="256" width="1.2" height="1.2" opacity="0.45"/>
        <use href="#nl-star" x="338" y="256" width="1.2" height="1.2" opacity="0.45"/>
      </g>

      {/* 4 corner sigils */}
      <use href="#nl-sigil" x="22"  y="22"  width="32" height="32" opacity="0.5"/>
      <use href="#nl-sigil" x="346" y="22"  width="32" height="32" opacity="0.5"/>
      <use href="#nl-sigil" x="22"  y="546" width="32" height="32" opacity="0.4"/>
      <use href="#nl-sigil" x="346" y="546" width="32" height="32" opacity="0.4"/>

      {/* Hairline frame */}
      <rect x="36" y="36" width="328" height="528" fill="none" stroke="#8A6A43" stroke-opacity="0.32" stroke-width="0.6"/>

      {/* Sacred light ray — descends from top centre onto the altar */}
      <path
        class="nl-ray"
        d="M170 36 L230 36 L260 480 L140 480 Z"
        fill="url(#nl-ray)"
      />

      {/* Three-step altar — descending perspective */}
      <g class="nl-altar-steps">
        <path d="M60 540 L340 540 L320 580 L80 580 Z" fill="url(#nl-stone)" stroke="#3a2e22" stroke-width="0.5"/>
        <path d="M90 500 L310 500 L300 540 L100 540 Z" fill="url(#nl-stone)" stroke="#3a2e22" stroke-width="0.5"/>
        <path d="M130 460 L270 460 L260 500 L140 500 Z" fill="url(#nl-stone)" stroke="#3a2e22" stroke-width="0.5"/>
        {/* Offerings on steps — small ember dots */}
        <circle cx="105" cy="540" r="1.8" fill="#C4935A" opacity="0.8"/>
        <circle cx="295" cy="540" r="1.8" fill="#C4935A" opacity="0.8"/>
        <circle cx="120" cy="500" r="1.4" fill="#C4935A" opacity="0.65"/>
        <circle cx="280" cy="500" r="1.4" fill="#C4935A" opacity="0.65"/>
        <circle cx="155" cy="460" r="1.2" fill="#C4935A" opacity="0.55"/>
        <circle cx="245" cy="460" r="1.2" fill="#C4935A" opacity="0.55"/>
      </g>

      {/* Pedestal under candle */}
      <rect x="170" y="430" width="60" height="30" fill="url(#nl-stone)" stroke="#3a2e22" stroke-width="0.5"/>

      {/* Halo behind candle — larger, more intense */}
      <circle class="nl-halo" cx="200" cy="360" r="200" fill="url(#nl-halo)"/>

      {/* Smoke — wider curl */}
      <path class="nl-smoke" d="M200 280 Q194 220 204 180 Q195 140 200 95 Q202 70 198 50" fill="none" stroke="url(#nl-smoke)" stroke-width="7" stroke-linecap="round" opacity="0.4"/>

      {/* Candle body */}
      <g class="nl-candle">
        <rect x="192" y="330" width="16" height="100" fill="url(#nl-wax)" stroke="#3a2e22" stroke-width="0.4"/>
        <path d="M196 360 Q195 372 198 376 Q201 372 200 360 Z" fill="#F2EDE4" opacity="0.6"/>
        <line x1="200" y1="330" x2="200" y2="318" stroke="#1a1410" stroke-width="1.4"/>
      </g>

      {/* Flame — twin-layer */}
      <g class="nl-flame-group">
        <ellipse class="nl-flame-outer" cx="200" cy="306" rx="15" ry="28" fill="url(#nl-flame)"/>
        <ellipse class="nl-flame-core"  cx="200" cy="302" rx="6"  ry="14" fill="#FFFAE8" opacity="0.95"/>
      </g>

      {/* Floating sparks — 5 staggered drifts upward */}
      <g class="nl-sparks" fill="#FFD08A">
        <circle class="nl-spark nl-spark-1" cx="188" cy="290" r="0.9"/>
        <circle class="nl-spark nl-spark-2" cx="212" cy="280" r="0.7"/>
        <circle class="nl-spark nl-spark-3" cx="200" cy="270" r="0.5"/>
        <circle class="nl-spark nl-spark-4" cx="194" cy="276" r="0.8"/>
        <circle class="nl-spark nl-spark-5" cx="208" cy="286" r="0.6"/>
      </g>

      {/* Base hairline */}
      <line x1="60" y1="580" x2="340" y2="580" stroke="#C4935A" stroke-opacity="0.25" stroke-width="0.5"/>
    </svg>
  </div>

  <div class="newsletter__copy">
    <div class="newsletter__head">
      <span class="sacred-mark" style="width:18px;height:18px;color:var(--bronze);"></span>
      <p class="eyebrow">{en.newsletter.eyebrow}</p>
    </div>
    <h2 id="newsletter-title" class="newsletter__title">{en.newsletter.title}</h2>
    <p class="newsletter__body">{en.newsletter.body}</p>

    <p class="newsletter__fallback">{en.newsletter.fallback}</p>
    <a class="btn btn--solid newsletter__fallback-cta" href={mailto}>
      {en.newsletter.fallback_cta}
    </a>
  </div>
</section>

<style>
  .newsletter__altar {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .newsletter__media {
    position: relative;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Stars twinkle — two groups with different rhythms so the field feels alive */
    .nl-stars use {
      animation: nl-star-twinkle 4.2s ease-in-out infinite;
      transform-origin: center;
    }
    .nl-stars use:nth-child(3n)   { animation-duration: 3.2s; animation-delay: 0.4s; }
    .nl-stars use:nth-child(3n+1) { animation-duration: 5.1s; animation-delay: 1.2s; }
    .nl-stars use:nth-child(3n+2) { animation-duration: 4.6s; animation-delay: 2.0s; }
    .nl-stars .nl-star-bright {
      animation: nl-star-bright 3.8s ease-in-out infinite;
    }
    @keyframes nl-star-twinkle {
      0%, 100% { opacity: var(--o, 0.7); transform: scale(1); }
      50%      { opacity: calc(var(--o, 0.7) * 0.4); transform: scale(0.85); }
    }
    @keyframes nl-star-bright {
      0%, 100% { opacity: 1;   transform: scale(1); filter: drop-shadow(0 0 4px rgba(255, 224, 168, 0.9)); }
      50%      { opacity: 0.6; transform: scale(0.85); filter: drop-shadow(0 0 2px rgba(255, 224, 168, 0.4)); }
    }

    /* Sacred light ray — slow opacity pulse */
    .nl-ray {
      transform-origin: 200px 36px;
      animation: nl-ray-breathe 6s ease-in-out infinite;
    }
    @keyframes nl-ray-breathe {
      0%, 100% { opacity: 1;    transform: scaleX(1); }
      50%      { opacity: 0.78; transform: scaleX(1.06); }
    }

    /* Halo — soft 4.6s breath */
    .nl-halo {
      transform-origin: 200px 360px;
      animation: nl-halo-pulse 4.6s ease-in-out infinite;
    }
    @keyframes nl-halo-pulse {
      0%, 100% { transform: scale(1);    opacity: 1; }
      50%      { transform: scale(1.10); opacity: 0.82; }
    }

    /* Flame outer — irregular flicker */
    .nl-flame-outer {
      transform-origin: 200px 332px;
      animation: nl-flame-outer 2.7s ease-in-out infinite;
    }
    @keyframes nl-flame-outer {
      0%   { transform: scale(1, 1)         translateX(0)     skewX(0deg); opacity: 0.95; }
      18%  { transform: scale(0.94, 1.10)   translateX(-1.5px) skewX(-2deg); opacity: 1; }
      35%  { transform: scale(1.06, 0.92)   translateX(1.5px)  skewX(2.5deg); opacity: 0.88; }
      52%  { transform: scale(0.97, 1.06)   translateX(-0.5px) skewX(-1deg); opacity: 0.98; }
      68%  { transform: scale(1.07, 0.98)   translateX(2px)    skewX(2deg); opacity: 1; }
      85%  { transform: scale(0.96, 1.04)   translateX(-1.5px) skewX(-1deg); opacity: 0.9; }
      100% { transform: scale(1, 1)         translateX(0)     skewX(0deg); opacity: 0.95; }
    }
    .nl-flame-core {
      transform-origin: 200px 312px;
      animation: nl-flame-core 1.8s ease-in-out infinite;
    }
    @keyframes nl-flame-core {
      0%, 100% { transform: scale(1, 1)     translateY(0);   opacity: 0.95; }
      30%      { transform: scale(0.88, 1.12) translateY(-2.5px); opacity: 1; }
      60%      { transform: scale(1.08, 0.9)  translateY(1.5px);  opacity: 0.85; }
    }

    /* Smoke drift */
    .nl-smoke {
      transform-origin: 200px 280px;
      animation: nl-smoke-drift 7s ease-in-out infinite;
    }
    @keyframes nl-smoke-drift {
      0%   { transform: translateY(0)    skewX(0deg); opacity: 0.35; }
      40%  { transform: translateY(-22px) skewX(-2deg); opacity: 0.52; }
      80%  { transform: translateY(-44px) skewX(2deg); opacity: 0.22; }
      100% { transform: translateY(0)     skewX(0deg); opacity: 0.35; }
    }

    /* Sparks — 5 staggered drifts */
    .nl-spark {
      transform-origin: center;
      animation: nl-spark-rise 3.8s ease-out infinite;
      opacity: 0;
    }
    .nl-spark-1 { animation-delay: 0s; }
    .nl-spark-2 { animation-delay: 0.9s; }
    .nl-spark-3 { animation-delay: 1.7s; }
    .nl-spark-4 { animation-delay: 2.4s; }
    .nl-spark-5 { animation-delay: 3.1s; }
    @keyframes nl-spark-rise {
      0%   { transform: translate(0, 0)       scale(1);   opacity: 0; }
      15%  { transform: translate(0, -12px)   scale(1.3); opacity: 0.95; }
      80%  { transform: translate(3px, -100px) scale(0.6); opacity: 0.3; }
      100% { transform: translate(-3px, -140px) scale(0.2); opacity: 0; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nl-halo, .nl-flame-outer, .nl-flame-core, .nl-smoke, .nl-spark, .nl-ray, .nl-stars use {
      animation: none !important;
    }
    .nl-spark { opacity: 0.7; }
  }

  @media (max-width: 900px) {
    .newsletter__altar { max-height: 420px; }
  }
</style>
