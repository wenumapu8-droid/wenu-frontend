---
import en from '../i18n/en.json';

const FALLBACK_EMAIL = 'marimari@wenumapuonline.com';
const subject = encodeURIComponent(en.newsletter.fallback_subject);
const mailto = `mailto:${FALLBACK_EMAIL}?subject=${subject}`;
---
<section class="newsletter" aria-labelledby="newsletter-title">
  {/* Real altar photograph from Wenu Mapu brand book (nueva identidad visual 2026).
      Mapuche sigil floating with rising smoke above a stone pedestal under starlit sky.
      No SVG approximation — this IS the brand. */}
  <div class="newsletter__media" aria-hidden="true">
    <picture>
      <source type="image/avif" srcset="/img/brand/wenu-altar-humo-real.avif"/>
      <source type="image/webp" srcset="/img/brand/wenu-altar-humo-real.webp"/>
      <img
        class="newsletter__altar-img"
        src="/img/brand/wenu-altar-humo-real.webp"
        alt="Wenu Mapu altar — Mapuche sigil with rising smoke over a stone pedestal under starlit sky"
        loading="lazy"
        decoding="async"
        width="1600"
        height="2400"
      />
    </picture>
    <div class="newsletter__media-veil" aria-hidden="true"></div>
    {/* Subtle ember sparks layered on top of the photo */}
    <div class="newsletter__sparks" aria-hidden="true">
      <span class="newsletter__spark newsletter__spark--1"></span>
      <span class="newsletter__spark newsletter__spark--2"></span>
      <span class="newsletter__spark newsletter__spark--3"></span>
      <span class="newsletter__spark newsletter__spark--4"></span>
      <span class="newsletter__spark newsletter__spark--5"></span>
    </div>
  </div>

  <div class="newsletter__copy">
    {/* Use the textile sello (sacred sigil) as the visual mark, not the generic dot */}
    <div class="newsletter__head">
      <picture class="newsletter__sello">
        <source type="image/avif" srcset="/img/brand/wenu-sigil-sacred-sello.avif"/>
        <source type="image/webp" srcset="/img/brand/wenu-sigil-sacred-sello.webp"/>
        <img src="/img/brand/wenu-sigil-sacred-sello.webp" alt="" width="48" height="48" loading="lazy" decoding="async"/>
      </picture>
      <p class="eyebrow">{en.newsletter.eyebrow}</p>
    </div>
    <h2 id="newsletter-title" class="newsletter__title">{en.newsletter.title}</h2>
    <p class="newsletter__body">{en.newsletter.body}</p>

    <p class="newsletter__fallback">{en.newsletter.fallback}</p>
    <a class="btn btn--solid newsletter__fallback-cta" href={mailto}>
      {en.newsletter.fallback_cta}
    </a>
  </div>
</section>

<style>
  .newsletter__media {
    position: relative;
    overflow: hidden;
    background: #080706;
  }
  .newsletter__altar-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 50%;
    display: block;
    filter: brightness(0.92) contrast(1.04) saturate(0.92);
  }

  /* Soft ember gradient veil so the right-side copy stays legible */
  .newsletter__media-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 75%, rgba(196,147,90,0.10) 0%, transparent 55%),
      linear-gradient(90deg, transparent 0%, transparent 60%, rgba(8,7,6,0.55) 100%);
    pointer-events: none;
  }

  /* Floating ember sparks layered on top of photo (5 staggered) */
  .newsletter__sparks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .newsletter__spark {
    position: absolute;
    width: 3px;
    height: 3px;
    background: radial-gradient(circle, #FFD08A 0%, rgba(196,147,90,0.4) 60%, transparent 100%);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(255, 208, 138, 0.6);
    opacity: 0;
    animation: nl-spark-rise 4s ease-out infinite;
  }
  .newsletter__spark--1 { left: 46%; bottom: 28%; animation-delay: 0s; }
  .newsletter__spark--2 { left: 52%; bottom: 30%; animation-delay: 0.8s; }
  .newsletter__spark--3 { left: 48%; bottom: 26%; animation-delay: 1.6s; }
  .newsletter__spark--4 { left: 50%; bottom: 32%; animation-delay: 2.4s; }
  .newsletter__spark--5 { left: 54%; bottom: 27%; animation-delay: 3.2s; }
  @keyframes nl-spark-rise {
    0%   { transform: translate(0, 0)         scale(1);   opacity: 0; }
    15%  { transform: translate(0, -20px)     scale(1.3); opacity: 0.95; }
    65%  { transform: translate(3px, -100px)  scale(0.6); opacity: 0.4; }
    100% { transform: translate(-2px, -160px) scale(0.2); opacity: 0; }
  }

  /* Sello as the eyebrow visual */
  .newsletter__sello {
    display: inline-flex;
    width: 36px;
    height: 36px;
  }
  .newsletter__sello img {
    width: 100%;
    height: auto;
    filter: brightness(1.08);
    opacity: 0.9;
  }

  @media (prefers-reduced-motion: reduce) {
    .newsletter__spark { animation: none !important; opacity: 0.6; }
  }
</style>
