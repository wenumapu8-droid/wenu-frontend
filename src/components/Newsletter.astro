---
import en from '../i18n/en.json';
---
<section class="newsletter" aria-labelledby="newsletter-title">
  <div class="newsletter__media" aria-hidden="true">
    <span class="newsletter__flame"></span>
  </div>
  <div class="newsletter__copy">
    <div class="newsletter__head">
      <span class="sacred-mark" style="width:18px;height:18px;color:var(--bronze);"></span>
      <p class="eyebrow">{en.newsletter.eyebrow}</p>
    </div>
    <h2 id="newsletter-title" class="newsletter__title">{en.newsletter.title}</h2>
    <p class="newsletter__body">{en.newsletter.body}</p>
    <form
      class="newsletter__form"
      method="post"
      action="https://formspree.io/f/placeholder"
      data-newsletter
      novalidate
    >
      {/* honeypot — must remain empty; humans never see it */}
      <input type="text" name="hp_name" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />
      <label class="visually-hidden" for="nl-email">{en.newsletter.placeholder}</label>
      <div class="newsletter__field">
        <input
          id="nl-email"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder={en.newsletter.placeholder}
        />
        <button type="submit" aria-label={en.newsletter.submit}>
          <span class="sacred-mark" style="width:14px;height:14px;color:var(--bone);"></span>
        </button>
      </div>
      <label class="newsletter__consent">
        <input type="checkbox" name="consent" required />
        <span>{en.newsletter.consent}</span>
      </label>
    </form>
  </div>
</section>
