---
// Pattern band — Wenu Mapu canonical divider ("terminación").
// 2026-05-30 — minimal lockup: a thin hairline rule flanking the real stone
// chakana mandala (same asset as the nav centre mark). Lets the page breathe;
// the mandala is the focal motif instead of a repeating greca band.
//
// Variants (mandala size / band height):
//   - hairline — quiet rule between sections
//   - band     — footer / sacred bookends
//   - altar    — major separators
interface Props {
  variant?: 'hairline' | 'band' | 'altar';
  tone?: 'bone' | 'bronze' | 'silver' | 'mute';
  label?: string;
}
const { variant = 'hairline', tone = 'silver', label } = Astro.props;
const heights = { hairline: 40, band: 64, altar: 96 };
const marks  = { hairline: 24, band: 40, altar: 60 };
const h = heights[variant];
const m = marks[variant];

const MARK = '/logos/wenu-mandala-mark.png';
---
<div
  class={`pattern-band pattern-band--${variant} pattern-band--${tone}`}
  role={label ? 'separator' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  style={`--pb-height: ${h}px; --pb-mark: ${m}px`}
>
  <span class="pb-rule" aria-hidden="true"></span>
  <img class="pb-mark" src={MARK} alt="" width={m} height={m} loading="lazy" decoding="async" aria-hidden="true" />
  <span class="pb-rule" aria-hidden="true"></span>
</div>

<style>
  .pattern-band {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 3vw, 32px);
    width: 100%;
    height: var(--pb-height, 40px);
    padding: 0 clamp(16px, 6vw, 64px);
  }
  .pb-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, currentColor 45%, currentColor 55%, transparent 100%);
    opacity: 0.35;
  }
  .pb-mark {
    flex: none;
    height: var(--pb-mark, 24px);
    width: auto;
    display: block;
    opacity: 0.92;
  }

  .pattern-band--bone   { color: var(--bone, #F2EDE4); }
  .pattern-band--bronze { color: var(--ember, #C4935A); }
  .pattern-band--silver { color: var(--silver, #A8A39A); }
  .pattern-band--mute   { color: var(--bronze, #8A6A43); }
  .pattern-band--mute .pb-rule { opacity: 0.22; }

  @media (prefers-reduced-motion: no-preference) {
    .pattern-band--altar .pb-mark {
      animation: pb-mark-breathe 7s ease-in-out infinite;
    }
  }
  @keyframes pb-mark-breathe {
    0%, 100% { transform: scale(1);    opacity: 0.92; }
    50%      { transform: scale(1.05); opacity: 0.78; }
  }
</style>
