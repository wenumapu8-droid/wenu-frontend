---
// Pattern band — Wenu Mapu canonical divider.
// 2026-05-22 — replaced the placeholder geometric tile with a sigil-centred motif
// drawn from the cardinal-sigil (4 directions, meli witran mapu). Each tile is
// 320px wide with hairline runs between sigils so the eye breathes; nothing repeats
// densely enough to feel "AI textile pattern".
//
// Variants:
//   - hairline (32px tall) — between sections
//   - band     (72px tall) — footer / sacred bookends
//   - altar    (120px)     — major separators / page closings
interface Props {
  variant?: 'hairline' | 'band' | 'altar';
  tone?: 'bronze' | 'silver' | 'mute';
  label?: string;
}
const { variant = 'hairline', tone = 'bronze', label } = Astro.props;
const heights = { hairline: 32, band: 72, altar: 120 };
const h = heights[variant];
---
<div
  class={`pattern-band pattern-band--${variant} pattern-band--${tone}`}
  role={label ? 'separator' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  style={`--pb-height: ${h}px`}
>
  <svg
    viewBox={`0 0 320 ${h}`}
    preserveAspectRatio="xMidYMid meet"
    width="100%"
    height="100%"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <defs>
      {/* Cardinal sigil — meli witran mapu (4 directions). 32px tile. */}
      <symbol id={`wm-sigil-${variant}`} viewBox="0 0 32 32" overflow="visible">
        <path d="M16 4 L24 16 L16 28 L8 16 Z" stroke-width="1.6"/>
        <path d="M16 4 L16 28 M4 16 L28 16" stroke-width="1.1" stroke-opacity="0.55"/>
        <circle cx="16" cy="4"  r="1.4" fill="currentColor" stroke="none"/>
        <circle cx="16" cy="28" r="1.4" fill="currentColor" stroke="none"/>
        <circle cx="4"  cy="16" r="1.4" fill="currentColor" stroke="none"/>
        <circle cx="28" cy="16" r="1.4" fill="currentColor" stroke="none"/>
        <circle cx="16" cy="16" r="2.3" stroke-width="1.4"/>
        <circle cx="16" cy="16" r="0.9" fill="currentColor" stroke="none"/>
      </symbol>
    </defs>

    {variant === 'hairline' && (
      <>
        <line x1="0" y1="16" x2="320" y2="16" stroke-width="0.7" stroke-opacity="0.45"/>
        <use href={`#wm-sigil-${variant}`} x="80"  y="0" width="32" height="32"/>
        <use href={`#wm-sigil-${variant}`} x="208" y="0" width="32" height="32"/>
        <circle cx="40"  cy="16" r="0.9" fill="currentColor" stroke="none" opacity="0.6"/>
        <circle cx="160" cy="16" r="1.2" fill="currentColor" stroke="none"/>
        <circle cx="280" cy="16" r="0.9" fill="currentColor" stroke="none" opacity="0.6"/>
      </>
    )}

    {variant === 'band' && (
      <>
        <line x1="0" y1="36" x2="320" y2="36" stroke-width="0.7" stroke-opacity="0.35"/>
        <use href={`#wm-sigil-${variant}`} x="80"  y="20" width="32" height="32"/>
        <use href={`#wm-sigil-${variant}`} x="138" y="14" width="44" height="44"/>
        <use href={`#wm-sigil-${variant}`} x="208" y="20" width="32" height="32"/>
        <circle cx="40"  cy="36" r="1.1" fill="currentColor" stroke="none" opacity="0.55"/>
        <circle cx="280" cy="36" r="1.1" fill="currentColor" stroke="none" opacity="0.55"/>
        <line x1="20" y1="58" x2="300" y2="58" stroke-width="0.5" stroke-opacity="0.2"/>
      </>
    )}

    {variant === 'altar' && (
      <>
        <line x1="0" y1="60" x2="320" y2="60" stroke-width="0.6" stroke-opacity="0.3"/>
        <path d="M120 110 L120 96 L200 96 L200 110" stroke-width="0.9" stroke-opacity="0.55"/>
        <path d="M100 96 L100 88 L220 88 L220 96"  stroke-width="0.9" stroke-opacity="0.45"/>
        <path d="M80 88  L80 82  L240 82 L240 88"  stroke-width="0.9" stroke-opacity="0.35"/>
        <use href={`#wm-sigil-${variant}`} x="140" y="30" width="40" height="40"/>
        <circle cx="40"  cy="60" r="1.4" fill="currentColor" stroke="none" opacity="0.55"/>
        <circle cx="160" cy="60" r="1.8" fill="currentColor" stroke="none"/>
        <circle cx="280" cy="60" r="1.4" fill="currentColor" stroke="none" opacity="0.55"/>
        <use href={`#wm-sigil-${variant}`} x="60"  y="38" width="24" height="24" opacity="0.5"/>
        <use href={`#wm-sigil-${variant}`} x="236" y="38" width="24" height="24" opacity="0.5"/>
      </>
    )}
  </svg>
</div>

<style>
  .pattern-band {
    display: block;
    width: 100%;
    height: var(--pb-height, 32px);
    overflow: hidden;
  }
  .pattern-band--bronze { color: var(--ember, #C4935A); }
  .pattern-band--silver { color: var(--silver, #A8A39A); }
  .pattern-band--mute   { color: var(--bronze, #8A6A43); opacity: 0.55; }

  .pattern-band--band svg,
  .pattern-band--altar svg {
    filter: drop-shadow(0 0 6px rgba(196, 147, 90, 0.18));
  }

  @media (prefers-reduced-motion: no-preference) {
    .pattern-band--altar svg use[width="40"] {
      transform-origin: 160px 50px;
      animation: pb-altar-breathe 6s ease-in-out infinite;
    }
  }
  @keyframes pb-altar-breathe {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.78; }
  }
</style>
