---
// Pattern band — horizontal repeating motif inspired by Mapuche textile geometry
// (lozenge + step + cross). Placeholder until brand-supplied SVG arrives.
//
// Tile 80×24, stroked at 1px in currentColor. Repeats horizontally as a
// hairline divider OR a section bar depending on `variant`.

interface Props {
  /** 'hairline' = thin divider between sections.
   *  'band' = taller bar (footer, sacred). */
  variant?: 'hairline' | 'band';
  /** Tone applied to currentColor. Defaults to bronze. */
  tone?: 'bronze' | 'silver' | 'mute';
  /** Optional aria label (defaults aria-hidden). */
  label?: string;
}

const { variant = 'hairline', tone = 'bronze', label } = Astro.props;
---
<div
  class={`pattern-band pattern-band--${variant} pattern-band--${tone}`}
  role={label ? 'separator' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <svg
    viewBox="0 0 320 24"
    preserveAspectRatio="xMidYMid meet"
    width="100%"
    height="100%"
    fill="none"
    stroke="currentColor"
    stroke-width="0.9"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <defs>
      <pattern id="wm-textile" x="0" y="0" width="80" height="24" patternUnits="userSpaceOnUse">
        {/* lozenge cluster */}
        <path d="M10 12 L18 4 L26 12 L18 20 Z"/>
        <path d="M14 12 L18 8 L22 12 L18 16 Z"/>
        {/* step bridge */}
        <path d="M28 12 L34 12 L34 8 L40 8 L40 16 L46 16 L46 12 L52 12"/>
        {/* small cross */}
        <line x1="60" y1="6" x2="60" y2="18"/>
        <line x1="54" y1="12" x2="66" y2="12"/>
        <circle cx="60" cy="12" r="1.2" fill="currentColor"/>
        {/* terminal lozenge open */}
        <path d="M70 12 L76 6 L80 12 L76 18 Z"/>
      </pattern>
    </defs>
    <rect x="0" y="0" width="320" height="24" fill="url(#wm-textile)"/>
  </svg>
</div>
