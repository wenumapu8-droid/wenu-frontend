---
// Pattern band — horizontal repeating motif inspired by Mapuche textile geometry
// (lozenge + step + cross). Placeholder until brand-supplied SVG arrives.
//
// Tile 80×24, stroked at 1px in currentColor. Repeats horizontally as a
// hairline divider OR a section bar depending on `variant`.

interface Props {
  /** 'hairline' = thin divider between sections.
   *  'band' = taller bar (footer, sacred). */
  variant?: 'hairline' | 'band';
  /** Tone applied to currentColor. Defaults to bronze. */
  tone?: 'bronze' | 'silver' | 'mute';
  /** Optional aria label (defaults aria-hidden). */
  label?: string;
}

const { variant = 'hairline', tone = 'bronze', label } = Astro.props;
---
<div
  class={`pattern-band pattern-band--${variant} pattern-band--${tone}`}
  role={label ? 'separator' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <svg
    viewBox="0 0 320 24"
    preserveAspectRatio="xMidYMid meet"
    width="100%"
    height="100%"
    fill="none"
    stroke="currentColor"
    stroke-width="0.9"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <defs>
      <pattern id="wm-textile" x="0" y="0" width="96" height="24" patternUnits="userSpaceOnUse">
        {/* lukutuel — nested stepped diamond */}
        <path d="M4 12 L10 6 L16 12 L10 18 Z"/>
        <path d="M7 12 L10 9 L13 12 L10 15 Z"/>
        <circle cx="10" cy="12" r="0.85" fill="currentColor"/>
        {/* connector hairline */}
        <line x1="16" y1="12" x2="21" y2="12"/>
        {/* greca — stepped fret */}
        <path d="M21 17 L21 13 L26 13 L26 9 L31 9 L31 5 L36 5 L36 9 L41 9 L41 13 L46 13 L46 17"/>
        {/* connector hairline */}
        <line x1="46" y1="12" x2="53" y2="12"/>
        {/* cardinal cross — meli witran mapu, four directions */}
        <line x1="63" y1="4" x2="63" y2="20"/>
        <line x1="55" y1="12" x2="71" y2="12"/>
        <path d="M59 8 L67 8 M59 16 L67 16"/>
        <circle cx="63" cy="12" r="1.4" fill="currentColor"/>
        <circle cx="63" cy="4" r="0.8" fill="currentColor"/>
        <circle cx="63" cy="20" r="0.8" fill="currentColor"/>
        <circle cx="55" cy="12" r="0.8" fill="currentColor"/>
        <circle cx="71" cy="12" r="0.8" fill="currentColor"/>
        {/* connector hairline */}
        <line x1="71" y1="12" x2="76" y2="12"/>
        {/* terminal stepped triangles */}
        <path d="M76 17 L82 7 L88 17"/>
        <path d="M88 17 L92 11 L96 17"/>
      </pattern>
    </defs>
    <rect x="0" y="0" width="320" height="24" fill="url(#wm-textile)"/>
  </svg>
</div>
