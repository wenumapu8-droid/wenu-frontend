---
/**
 * DesignYourEarBanner — home invitation to CO-DESIGN a curated ear (Ocin 2026-07-06).
 *
 * REDESIGN (Ocin 2026-07-06 — "la cosa de la oreja no me gusta aún cómo se ve, hazlo
 * más atractivo como diseñador gráfico profesional"). The old banner used the busy
 * annotated ear-map (green labels + gold markers — the saturated diagram Ocin dislikes)
 * OR a washed-out ear brightened to 2.7×. This version treats the design like a graphic
 * designer:
 *   · PROTAGONIST VISUAL = the elegant dark 3D ear SCULPT (public/img/ear/ear-base.webp)
 *     — a lit sculpture on obsidian, given a SUBTLE exposure lift (not a hard wash) and a
 *     warm rim-glow so the helix→lobe reads as premium studio artwork, not a diagram.
 *   · A restrained CONSTELLATION of a few fine gold placement points connected by hairline
 *     tethers plots itself over the ear (transform/opacity only) — the ear reads as a
 *     living planning canvas, "a curated ear taking shape", never a labelled schematic.
 *   · TYPOGRAPHY with clear hierarchy: eyebrow → "Design your ear. Together." → one lede
 *     → three tight proof points → ONE primary CTA to /constelaciones (book link demoted
 *     to a quiet text link). Generous whitespace, editorial restraint.
 *
 * PERFORMANCE (efectos-livianos-mobile-wenu.md — canon):
 *  · Image + inline SVG + CSS only. NO JS, NO canvas, NO timers. The plotting dots +
 *    tether lines are GPU keyframes (transform/opacity), gentle + capped, never a flash.
 *    prefers-reduced-motion freezes them to a calm plotted state.
 *  · The section is pinned to intentional night in every theme via themes.css (.dye is
 *    already in the night-window + hard-black lists), so the dark ear artwork stays
 *    coherent in Solar / Sunset too.
 */
---
<section class="dye" aria-labelledby="dye-title">
  {/* ── the studio ear "canvas" — the elegant sculpt as protagonist ── */}
  <figure class="dye__stage">
    <span class="dye__aura" aria-hidden="true"></span>
    <picture class="dye__media">
      <img
        src="/img/ear/ear-base.webp"
        alt="Wenu Mapu — a clean ear sculpt, the canvas for a curated ear constellation"
        width="1024" height="1024"
        loading="eager" decoding="async"
      />
    </picture>
    <span class="dye__scrim" aria-hidden="true"></span>

    {/* the LIVING constellation (Ocin 2026-07-06) — a canvas star-map over/around
        the ear: gold points appear, drift and CONNECT into shifting constellations
        (hairline links draw between near points, re-form over time), like a living
        sky. THEME-REACTIVE: it reads html[data-theme] and INVERTS its palette — gold
        on the dark ear in Nocturne/Sunset, bright ivory (a "negative" star-map) in
        the light Solar theme. Performant (rAF + device-tiering + IntersectionObserver
        pause). prefers-reduced-motion → a single static plotted constellation, no
        animation. Progressive: with no JS the canvas is simply empty (ear intact).
        A static SVG fallback keeps the original 3 placements plotted pre-JS. */}
    <svg class="dye__plot dye__plot--fallback" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path class="dye__tether" d="M47 22 L52 47 L43 75" fill="none" />
      <circle class="dye__node dye__node--1" cx="47" cy="22" r="1.5" />
      <circle class="dye__node dye__node--2" cx="52" cy="47" r="1.5" />
      <circle class="dye__node dye__node--3" cx="43" cy="75" r="1.5" />
    </svg>
    <canvas class="dye__constellation" data-dye-constellation aria-hidden="true"></canvas>

    {/* corner HUD — a discreet planning-instrument frame */}
    <span class="dye__hud" aria-hidden="true">
      <span class="dye__bracket dye__bracket--tl"></span>
      <span class="dye__bracket dye__bracket--br"></span>
      <span class="dye__stamp">Wültufe · Ear studio</span>
    </span>
  </figure>

  {/* ── the invitation ── */}
  <div class="dye__copy">
    <p class="eyebrow dye__eyebrow">Wültufe · Curated ear · By appointment</p>
    <h2 id="dye-title" class="dye__title">Design your ear.<br/><span class="dye__title-em">Together.</span></h2>
    <p class="dye__lede">
      A curated ear is a project, not a single piercing. Plot new placements on your
      own anatomy, choose a jewellery direction, and build a constellation that is
      yours alone — evaluated in person, by the piercer.
    </p>
    <ul class="dye__points" role="list">
      <li>A bespoke constellation, plotted on your ear</li>
      <li>Every placement evaluated in person by the piercer</li>
      <li>Save, share and refine your draft before the chair</li>
    </ul>
    <div class="dye__cta">
      <a href="/constelaciones" class="dye__btn">Start your ear map <span aria-hidden="true">→</span></a>
      <a href="/piercing#book" class="dye__link">or book a session</a>
    </div>
  </div>
</section>

<style>
  .dye {
    position: relative;
    isolation: isolate;
    border-block: var(--border-thin);
    background: #060505;
    padding: var(--section-y-lg) var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
    max-width: var(--max-w);
    margin-inline: auto;
    /* deep studio ground with a faint ember bloom behind the copy side */
    background-image:
      radial-gradient(70% 120% at 84% 42%, rgba(201, 168, 76, 0.09) 0%, transparent 56%),
      radial-gradient(120% 130% at 16% 50%, #14100a 0%, #0a0806 55%, #060505 100%);
  }

  /* ── the ear stage — protagonist sculpt ── */
  .dye__stage {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--bronze) 46%, transparent);
    /* a warm studio ground so the near-black sculpt reads as LIT, elegant */
    background:
      radial-gradient(64% 70% at 52% 42%, rgba(201, 168, 76, 0.16) 0%, rgba(122, 96, 52, 0.07) 44%, transparent 76%),
      radial-gradient(120% 120% at 50% 48%, #191410 0%, #0e0b08 62%, #080604 100%);
    box-shadow:
      0 40px 90px -44px rgba(0, 0, 0, 0.9),
      inset 0 0 60px rgba(0, 0, 0, 0.35);
  }
  /* soft aura directly behind the ear so the sculpt lifts off the ground */
  .dye__aura {
    position: absolute; inset: 8% 12%; z-index: 0; pointer-events: none;
    background: radial-gradient(52% 56% at 50% 42%, rgba(201, 168, 76, 0.22) 0%, rgba(180, 120, 50, 0.09) 46%, transparent 72%);
    /* NO mix-blend-mode here: `screen` created a blend isolation group that left the
       ear <img> sibling unpainted in Chrome until a forced repaint (the ear vanished
       on first load). A warm radial over the dark stage ground reads the same without
       it, and the image now composites reliably from first paint. */
    opacity: 0.5;   /* base (used when reduced-motion freezes the keyframe) */
    animation: dye-aura 9s ease-in-out infinite;
  }
  .dye__media { position: absolute; inset: 0; display: block; z-index: 1; }
  .dye__media img {
    width: 100%; height: 100%; object-fit: contain; object-position: center;
    /* a MEASURED lift + warm tone so the sculpt reads as a lit sculpture — NOT the
       hard 2.7× wash that flattened it before. Normal blend: the asset's subject is
       defined by dark-on-darker gradients, so `screen` erased it into black. The warm
       studio glow is supplied by .dye__aura + the stage ground behind, not the blend. */
    filter: brightness(1.9) contrast(1.16) saturate(1.03);
    /* promote to its own compositing layer so it always paints on first frame
       (belt-and-suspenders alongside removing the aura's blend isolation). */
    transform: translateZ(0);
  }
  .dye__scrim {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    /* gentle edge vignette only — never crush the ear into black */
    background:
      radial-gradient(128% 128% at 52% 44%, transparent 62%, rgba(6, 5, 4, 0.5) 100%),
      linear-gradient(180deg, transparent 70%, rgba(6, 5, 4, 0.4) 100%);
  }

  /* ── the LIVING constellation canvas ── sits over the ear stage ── */
  .dye__constellation {
    position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%;
    pointer-events: none;
    /* once JS boots it paints; before that it's transparent (fallback SVG shows). */
  }
  /* the pre-JS static SVG plot; hidden the moment the canvas takes over. */
  .dye.is-constellation-live .dye__plot--fallback { display: none; }

  /* ── the constellation plot (static SVG fallback) ── fine gold nodes + tether ── */
  .dye__plot {
    position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%;
    pointer-events: none; overflow: visible;
  }
  .dye__tether {
    stroke: rgba(224, 180, 84, 0.62);
    stroke-width: 0.4;
    stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 3 160;
    stroke-dashoffset: 163;
    filter: drop-shadow(0 0 1.5px rgba(232, 196, 96, 0.6));
    animation: dye-trace 9s ease-in-out infinite;
  }
  .dye__node {
    /* brighter, warmer gold + softer glow so the plotted stars read clearly on the
       dark ear (Ocin 2026-07-07 — "que se noten más, dorados"). */
    fill: rgba(246, 214, 120, 1);
    filter: drop-shadow(0 0 3px rgba(232, 196, 96, 0.95));
    opacity: 0;
    transform-box: fill-box; transform-origin: center;
    animation: dye-node 9s ease-in-out infinite;
  }
  .dye__node--1 { animation-delay: 0.6s; }
  .dye__node--2 { animation-delay: 2.1s; }
  .dye__node--3 { animation-delay: 3.6s; }

  @keyframes dye-trace {
    0%       { stroke-dashoffset: 163; opacity: 0; }
    12%      { opacity: 1; }
    55%      { stroke-dashoffset: 3; opacity: 1; }
    78%      { stroke-dashoffset: 3; opacity: 0.85; }
    92%, 100% { stroke-dashoffset: 3; opacity: 0; }
  }
  @keyframes dye-node {
    0%, 100% { opacity: 0; transform: scale(0.3); }
    14%      { opacity: 1; transform: scale(1.15); }
    30%      { opacity: 0.9; transform: scale(0.95); }
    78%      { opacity: 0.9; transform: scale(1); }
    92%      { opacity: 0; transform: scale(0.6); }
  }

  /* corner HUD */
  .dye__hud { position: absolute; inset: 14px; pointer-events: none; z-index: 4; }
  .dye__bracket {
    position: absolute; width: 26px; height: 26px;
    border: 0 solid color-mix(in srgb, var(--ember) 55%, transparent);
  }
  .dye__bracket--tl { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; }
  .dye__bracket--br { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; }
  .dye__stamp {
    position: absolute; bottom: 0; left: 0;
    font-family: var(--font-mono, monospace); font-size: 0.56rem;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: color-mix(in srgb, var(--ember) 80%, #f0ede8);
    text-shadow: 0 0 10px rgba(201, 168, 76, 0.4);
  }

  /* ── copy ── */
  .dye__copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .dye__eyebrow { color: var(--ember); margin: 0; }
  .dye__title {
    font-family: var(--font-display); font-weight: var(--fw-regular);
    font-size: clamp(2.4rem, 5.8vw, 4.2rem); line-height: 1.0; letter-spacing: 0.005em;
    color: #f5efe4; margin: 0; text-wrap: balance;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.6);
  }
  .dye__title-em { color: var(--ember); font-style: italic; }
  .dye__lede {
    font-family: var(--font-serif); font-size: var(--fs-body-lg); line-height: 1.62;
    color: rgba(240, 237, 232, 0.82); max-width: 46ch; margin: 0;
  }
  .dye__points {
    list-style: none; margin: var(--space-1) 0 0; padding: 0;
    display: flex; flex-direction: column; gap: 10px;
  }
  .dye__points li {
    position: relative; padding-left: 24px;
    font-family: var(--font-sans); font-size: var(--fs-body); line-height: 1.5;
    color: rgba(240, 237, 232, 0.88);
  }
  .dye__points li::before {
    content: ''; position: absolute; left: 3px; top: 0.62em;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--ember);
    box-shadow: 0 0 8px rgba(201, 168, 76, 0.7);
  }
  .dye__cta {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4);
    margin-top: var(--space-3);
  }
  .dye__btn {
    display: inline-flex; align-items: center; gap: 0.5em;
    font-family: var(--font-sans); font-size: var(--fs-tiny);
    letter-spacing: var(--letter-spacing-ritual); text-transform: uppercase;
    color: #0a0a0a; text-decoration: none;
    background: var(--ember); border: 1px solid var(--ember); border-radius: 999px;
    padding: 15px 32px;
    box-shadow: 0 0 24px -4px rgba(201, 168, 76, 0.5);
    transition: background var(--t-base), color var(--t-base), box-shadow var(--t-base), transform var(--t-fast);
  }
  .dye__btn:hover {
    background: #e8c86a; border-color: #e8c86a; transform: translateY(-1px);
    box-shadow: 0 0 34px -2px rgba(232, 200, 106, 0.7);
  }
  .dye__btn:focus-visible { outline: 1px solid var(--ember); outline-offset: 4px; }
  .dye__link {
    font-family: var(--font-sans); font-size: var(--fs-eyebrow);
    letter-spacing: var(--letter-spacing-ritual); text-transform: uppercase;
    color: var(--sand); text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .dye__link:hover { color: var(--bone); border-bottom-color: var(--bronze); }

  /* ── responsive: stack, ear first, copy centred ── */
  @media (max-width: 820px) {
    .dye { grid-template-columns: 1fr; gap: clamp(28px, 7vw, 44px); }
    .dye__stage { max-width: 380px; margin-inline: auto; width: 100%; aspect-ratio: 1; }
    .dye__copy { align-items: center; text-align: center; }
    .dye__lede { max-width: 52ch; }
    .dye__points { align-items: flex-start; }
    .dye__cta { justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dye__aura { animation: none !important; }
    .dye__tether { animation: none !important; stroke-dashoffset: 3; stroke-dasharray: none; opacity: 0.55; }
    .dye__node { animation: none !important; opacity: 0.92; transform: scale(1); }
  }

  /* aura kept gentle so it lifts the sculpt off the ground without washing its dark
     modelling into the glow (which had made the ear disappear at low brightness). */
  @keyframes dye-aura { 0%, 100% { opacity: 0.4; transform: scale(0.98); } 50% { opacity: 0.62; transform: scale(1.04); } }
</style>

<script>
  // ── LIVING CONSTELLATION over the ear (Ocin 2026-07-06) ─────────────────────
  //  Gold points drift gently over/around the ear and CONNECT into shifting
  //  constellations: hairline links draw between points that fall within a radius,
  //  fading in/out as the points move so the figure keeps re-forming (a living sky).
  //  THEME-REACTIVE: reads html[data-theme] and inverts — gold on the dark ear in
  //  Nocturne/Sunset, bright ivory ("negative" star-map) in the light Solar theme.
  //  PERFORMANCE (efectos-livianos canon): rAF, device-tiered point count + DPR cap,
  //  IntersectionObserver pauses it off-screen / tab-hidden. prefers-reduced-motion
  //  → a single STATIC plotted constellation (no animation, drawn once).
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLCanvasElement>('[data-dye-constellation]').forEach((canvas) => {
      const stage = canvas.closest('.dye__stage') as HTMLElement | null;
      const section = canvas.closest('.dye') as HTMLElement | null;
      const ctx = canvas.getContext('2d');
      if (!ctx || !stage || !section) return;
      section.classList.add('is-constellation-live'); // hide the static SVG fallback

      // device tiering — fewer points on coarse/small/low-core devices
      const nav = navigator as Navigator & { deviceMemory?: number };
      const coarse = window.matchMedia('(pointer: coarse)').matches;
      const small = Math.min(window.innerWidth, window.innerHeight) <= 820;
      const lowCore = typeof nav.hardwareConcurrency === 'number' && nav.hardwareConcurrency <= 4;
      const lowMem = typeof nav.deviceMemory === 'number' && nav.deviceMemory <= 4;
      const lowPower = (coarse && small) || lowCore || lowMem;

      type P = { x: number; y: number; vx: number; vy: number; r: number; tw: number; ph: number };
      let W = 0, H = 0, dpr = 1, pts: P[] = [], raf = 0, running = false, visible = false;

      // theme palette — INVERTS with the day-cycle theme (theme-reactive, kept intact).
      const palette = () => {
        const t = document.documentElement.getAttribute('data-theme');
        // NOTE (Ocin 2026-07-07): stars pushed to read MORE — brighter/warmer gold in
        // the DARK themes (ember/gold of the brand), stronger contrast + glow so they no
        // longer look washed-out. The inversion is preserved: Solar/Sunset swap to a cool
        // bright IVORY "negative" star-map — visibly distinct from the gold. (This .dye
        // section is pinned to real black #060505 in EVERY theme via themes.css, so the
        // solar palette must stay BRIGHT to read on the dark banner; dark points would
        // vanish here — the section never actually turns light.)
        return t === 'solar'
          ? { dot: '250,246,238', line: '238,232,222', glow: '250,246,238' }  // cool bright ivory (negative star-map)
          : { dot: '246,214,120', line: '224,180,84',  glow: '232,196,96' }; // warm brand gold (ember-leaning)
      };
      let pal = palette();

      const LINK = () => Math.min(W, H) * (lowPower ? 0.34 : 0.30); // connection radius

      const build = () => {
        const rect = stage.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, lowPower ? 1 : 1.5);
        W = Math.max(1, Math.round(rect.width * dpr));
        H = Math.max(1, Math.round(rect.height * dpr));
        canvas.width = W; canvas.height = H;
        const n = lowPower ? 12 : 18;
        pts = [];
        for (let i = 0; i < n; i++) {
          pts.push({
            x: Math.random() * W, y: Math.random() * H,
            vx: (Math.random() - 0.5) * 0.10 * dpr,
            vy: (Math.random() - 0.5) * 0.10 * dpr,
            r: (Math.random() * 1.4 + 0.95) * dpr,
            tw: Math.random() * 1.8 + 0.6, ph: Math.random() * Math.PI * 2,
          });
        }
      };

      const draw = (now: number) => {
        ctx.clearRect(0, 0, W, H);
        const link = LINK();
        // links first (under the dots)
        for (let i = 0; i < pts.length; i++) {
          for (let j = i + 1; j < pts.length; j++) {
            const a = pts[i], b = pts[j];
            const dx = a.x - b.x, dy = a.y - b.y;
            const d = Math.hypot(dx, dy);
            if (d < link) {
              // fade with distance; gentle shimmer so the figure keeps re-forming
              const base = (1 - d / link);
              const shimmer = reduce ? 1 : (0.6 + 0.4 * Math.sin(now * 0.0006 + (i + j)));
              // a pelín more visible than before (0.5→0.62) but kept fine — stars stay
              // the protagonists, the tethers are a quiet lattice.
              const alpha = base * 0.62 * shimmer;
              if (alpha <= 0.01) continue;
              ctx.strokeStyle = `rgba(${pal.line},${alpha.toFixed(3)})`;
              ctx.lineWidth = Math.max(0.5, 0.6 * dpr);
              ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
            }
          }
        }
        // dots — brighter/higher-contrast (Ocin 2026-07-07): higher floor on the twinkle
        // so stars never fully wash out, stronger base opacity, and a soft gold glow.
        for (const p of pts) {
          const tw = reduce ? 1 : 0.72 + 0.28 * Math.sin(now * 0.001 * p.tw + p.ph);
          ctx.beginPath();
          ctx.fillStyle = `rgba(${pal.dot},${Math.min(1, 0.98 * tw).toFixed(3)})`;
          ctx.shadowColor = `rgba(${pal.glow},0.95)`;
          ctx.shadowBlur = 9 * dpr * tw;
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
          ctx.shadowBlur = 0;
        }
      };

      const step = (now: number) => {
        for (const p of pts) {
          p.x += p.vx; p.y += p.vy;
          if (p.x < 0 || p.x > W) p.vx *= -1;
          if (p.y < 0 || p.y > H) p.vy *= -1;
        }
        draw(now);
        if (running) raf = requestAnimationFrame(step);
      };
      const start = () => { if (running || reduce) return; running = true; raf = requestAnimationFrame(step); };
      const stop = () => { running = false; if (raf) cancelAnimationFrame(raf); raf = 0; };

      build();
      draw(performance.now());

      // pause off-screen / tab hidden
      const io = new IntersectionObserver((e) => {
        visible = e[0].isIntersecting;
        if (visible) { reduce ? draw(performance.now()) : start(); } else stop();
      }, { rootMargin: '120px' });
      io.observe(stage);
      document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else if (visible && !reduce) start(); });

      // theme-reactive: repaint palette when the day-cycle theme changes
      new MutationObserver(() => { pal = palette(); if (reduce || !running) draw(performance.now()); })
        .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

      // resize (debounced)
      let rt: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(rt);
        rt = window.setTimeout(() => { build(); if (reduce || !running) draw(performance.now()); }, 180);
      });
    })();
  })();
</script>
