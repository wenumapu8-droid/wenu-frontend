---
/**
 * ManifestoKultrunSection — landing manifesto + visual kultrún central.
 *
 * Reemplaza la sección anterior que mostraba CardinalGrid como 2×2 educacional.
 * Aquí el kultrún ES el corazón visual (mapa ceremonial, no infografía), con un
 * manifesto editorial al lado. Mobile = stacked, kultrún arriba.
 *
 * Símbolos canónicos: ver Obsidian → brand/01-identity/kultrun-simbologia-real.md
 *   · Puel  (Este)  → Antü (estrella de 8 puntas)
 *   · Will  (Sur)   → Küruf (espiral de 4 brazos horario)
 *   · Lafken (Oeste) → Ko (luna creciente)
 *   · Pikun (Norte) → Mapu (espiral de 4 brazos antihorario)
 *
 * Nota sobre nombres de cardinales: usamos los nombres canónicos del Wallmapu
 * (Lafken Mapu = Oeste hacia el mar, Pikun Mapu = Norte). El componente
 * antiguo `CardinalGrid` usaba "Pewen" (un árbol) y "Nüku" — quedan como
 * herencia editorial pero la versión canónica es la de abajo.
 */
---
<section class="manifesto-kultrun" aria-labelledby="manifesto-kultrun-title">
  <div class="manifesto-kultrun__inner">

    <div class="manifesto-kultrun__copy">
      <p class="manifesto-kultrun__eyebrow">Ancestral Manifesto</p>
      <h2 id="manifesto-kultrun-title" class="manifesto-kultrun__title">
        The body is sacred territory.
      </h2>
      <p class="manifesto-kultrun__body">
        Wenu Mapu was born from the relationship between body, earth and cosmos.
        Each piece is more than ornament: it is a small ritual of presence,
        memory and transformation.
      </p>
      <p class="manifesto-kultrun__italic">
        Crafted with intention. Worn with purpose.
      </p>
      <a href="/about" class="manifesto-kultrun__cta">
        Read our manifesto <span aria-hidden="true">→</span>
      </a>
      <p class="manifesto-kultrun__arn" lang="arn">
        <em>Küme kimün</em> — knowledge carried through the body.
      </p>
    </div>

    <div class="manifesto-kultrun__visual" data-cp-portal-host>
      {/* Central kultrún — vectorial reinterpretation, NOT a Google copy.
          Ver brand/01-identity/kultrun-simbologia-real.md para la simbología.
          2026-06-03 — el ombligo central ahora es un agujero negro interactivo
          (parallax con mouse + pulse al click). El resto del kultrún se mantiene. */}
      <svg
        viewBox="0 0 540 540"
        class="kultrun-symbol"
        role="img"
        aria-label="Kultrún — Mapuche sacred map of the four directions with cosmic portal at center"
        data-cp-kultrun
      >
        <title>Kultrún · sacred map with cosmic portal</title>
        <desc>A vectorial kultrún with four cardinal symbols and an interactive black hole portal at the center: Antü (sun, east), Küruf (wind, south), Ko (moon, west) and Mapu (earth, north).</desc>

        <defs>
          <radialGradient id="kultrun-halo" cx="50%" cy="50%" r="65%">
            <stop offset="0%" stop-color="rgba(198,168,106,0.18)"/>
            <stop offset="60%" stop-color="rgba(198,168,106,0.04)"/>
            <stop offset="100%" stop-color="transparent"/>
          </radialGradient>

          {/* ── BLACK HOLE PORTAL gradients ── */}
          {/* Photon ring (anillo dorado de fotones al borde del horizonte) */}
          <radialGradient id="kultrun-portal-ring" cx="50%" cy="50%" r="50%">
            <stop offset="0%"  stop-color="rgba(0,0,0,0)"/>
            <stop offset="55%" stop-color="rgba(0,0,0,0)"/>
            <stop offset="62%" stop-color="rgba(232,193,127,0.92)"/>
            <stop offset="72%" stop-color="rgba(196,147,90,0.55)"/>
            <stop offset="85%" stop-color="rgba(196,147,90,0.12)"/>
            <stop offset="100%" stop-color="rgba(196,147,90,0)"/>
          </radialGradient>
          {/* Doppler asymmetry */}
          <linearGradient id="kultrun-portal-doppler" x1="0%" y1="50%" x2="100%" y2="50%">
            <stop offset="0%"  stop-color="rgba(245,234,216,0.78)"/>
            <stop offset="50%" stop-color="rgba(196,147,90,0)"/>
            <stop offset="100%" stop-color="rgba(232,193,127,0.55)"/>
          </linearGradient>
          {/* Event horizon (singularity black) */}
          <radialGradient id="kultrun-portal-core" cx="50%" cy="50%" r="50%">
            <stop offset="0%"  stop-color="#000000"/>
            <stop offset="70%" stop-color="#030303"/>
            <stop offset="100%" stop-color="rgba(8,7,6,0.0)"/>
          </radialGradient>
          {/* Lensing halo soft */}
          <radialGradient id="kultrun-portal-halo" cx="50%" cy="50%" r="50%">
            <stop offset="0%"  stop-color="rgba(196,147,90,0.0)"/>
            <stop offset="60%" stop-color="rgba(196,147,90,0.18)"/>
            <stop offset="100%" stop-color="rgba(196,147,90,0)"/>
          </radialGradient>
        </defs>

        {/* halo (kultrún outer aura) */}
        <circle cx="270" cy="270" r="252" fill="url(#kultrun-halo)" stroke="none"/>

        {/* outer ring (sky) */}
        <circle cx="270" cy="270" r="232" class="kultrun-stroke" />
        {/* inner ring (horizon) */}
        <circle cx="270" cy="270" r="210" class="kultrun-stroke kultrun-stroke--soft" />

        {/* cardinal cross */}
        <line x1="270" y1="38"  x2="270" y2="502" class="kultrun-stroke" />
        <line x1="38"  y1="270" x2="502" y2="270" class="kultrun-stroke" />

        {/* sub-quadrant guide lines (very faint) */}
        <line x1="105" y1="105" x2="435" y2="435" class="kultrun-stroke kultrun-stroke--faint" />
        <line x1="105" y1="435" x2="435" y2="105" class="kultrun-stroke kultrun-stroke--faint" />

        {/* ── Quadrant symbols ── */}
        {/* NE — Küruf (Wind), spiral 4-arm clockwise */}
        <g class="kultrun-symbol__orbit" transform="translate(360 180)">
          <circle r="1.6" fill="currentColor" />
          <path d="M0 0 Q14 -22 36 -22" class="kultrun-stroke" />
          <path d="M0 0 Q22 14 22 36"   class="kultrun-stroke" />
          <path d="M0 0 Q-14 22 -36 22" class="kultrun-stroke" />
          <path d="M0 0 Q-22 -14 -22 -36" class="kultrun-stroke" />
        </g>

        {/* NW — Ko (Water), crescent moon */}
        <g transform="translate(180 180)">
          <path d="M14 -28 A 28 28 0 1 0 14 28 A 21 21 0 1 1 14 -28 Z" class="kultrun-stroke" />
        </g>

        {/* SE — Antü (Sun), 8-point star */}
        <g transform="translate(360 360)">
          <polygon
            points="0,-32 9,-9 32,0 9,9 0,32 -9,9 -32,0 -9,-9"
            class="kultrun-stroke"
          />
          <polygon
            points="0,-16 5,-5 16,0 5,5 0,16 -5,5 -16,0 -5,-5"
            class="kultrun-stroke kultrun-stroke--soft"
          />
        </g>

        {/* SW — Mapu (Earth), spiral 4-arm counter-clockwise (mirror of küruf) */}
        <g transform="translate(180 360)">
          <circle r="1.6" fill="currentColor" />
          <path d="M0 0 Q-14 -22 -36 -22" class="kultrun-stroke" />
          <path d="M0 0 Q22 -14 22 -36"   class="kultrun-stroke" />
          <path d="M0 0 Q14 22 36 22"     class="kultrun-stroke" />
          <path d="M0 0 Q-22 14 -22 36"   class="kultrun-stroke" />
        </g>

        {/* orbital dots — subtle "estrellas" en el anillo exterior */}
        <g class="kultrun-symbol__stars">
          <circle cx="270" cy="38"  r="1.6" fill="currentColor" />
          <circle cx="502" cy="270" r="1.6" fill="currentColor" />
          <circle cx="270" cy="502" r="1.6" fill="currentColor" />
          <circle cx="38"  cy="270" r="1.6" fill="currentColor" />
          <circle cx="105" cy="105" r="1" fill="currentColor" opacity="0.55"/>
          <circle cx="435" cy="105" r="1" fill="currentColor" opacity="0.55"/>
          <circle cx="105" cy="435" r="1" fill="currentColor" opacity="0.55"/>
          <circle cx="435" cy="435" r="1" fill="currentColor" opacity="0.55"/>
        </g>

        {/* ════════════════════════════════════════════════════════
             BLACK HOLE PORTAL — reemplaza el ombligo estático.
             Lensing halo + photon ring breathing + accretion ring
             spinning + singularity black core. Interactividad: mouse
             tilt + click pulse aplicada al grupo entero.
             ════════════════════════════════════════════════════════ */}
        <g class="kultrun-portal" data-cp-portal transform="translate(270 270)">
          {/* Lensing halo */}
          <circle r="70" fill="url(#kultrun-portal-halo)"/>
          {/* Accretion ring (spinning) */}
          <g class="kultrun-portal__accretion" data-cp-accretion>
            <ellipse cx="0" cy="0" rx="52" ry="14" fill="url(#kultrun-portal-ring)" opacity="0.95"/>
            <ellipse cx="0" cy="0" rx="52" ry="14" fill="url(#kultrun-portal-doppler)" opacity="0.55"/>
          </g>
          {/* Photon ring (breathing) */}
          <circle r="26" fill="none" stroke="rgba(232,193,127,0.88)" stroke-width="0.7" class="kultrun-portal__photon-ring"/>
          <circle r="26" fill="none" stroke="rgba(232,193,127,0.22)" stroke-width="2.4" class="kultrun-portal__photon-glow"/>
          {/* Event horizon (singularity) */}
          <circle r="24" fill="url(#kultrun-portal-core)"/>
          {/* Pulse trigger (animated by JS) */}
          <circle r="0" fill="none" stroke="rgba(232,193,127,0.6)" stroke-width="0.8" class="kultrun-portal__pulse" data-cp-pulse/>
        </g>
      </svg>

      {/* Direction labels around the circle — small, ritual cartography */}
      <span class="kultrun-label kultrun-label--north" lang="arn">Pikun Mapu</span>
      <span class="kultrun-label kultrun-label--east"  lang="arn">Puel Mapu</span>
      <span class="kultrun-label kultrun-label--south" lang="arn">Willi Mapu</span>
      <span class="kultrun-label kultrun-label--west"  lang="arn">Lafken Mapu</span>
    </div>

  </div>
</section>

<style>
  .manifesto-kultrun {
    position: relative;
    background:
      radial-gradient(circle at 72% 45%, rgba(198, 168, 106, 0.08), transparent 36%),
      linear-gradient(180deg, var(--obsidian) 0%, var(--charcoal) 100%);
    color: var(--bone);
    overflow: hidden;
    border-top: 1px solid rgba(201, 192, 174, 0.14);
    border-bottom: 1px solid rgba(201, 192, 174, 0.14);
  }

  /* Subtle pattern overlay */
  .manifesto-kultrun::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle 1px at 14% 24%, rgba(245, 234, 216, 0.18) 50%, transparent 51%),
      radial-gradient(circle 1px at 82% 18%, rgba(245, 234, 216, 0.14) 50%, transparent 51%),
      radial-gradient(circle 1px at 38% 78%, rgba(245, 234, 216, 0.12) 50%, transparent 51%),
      radial-gradient(circle 1px at 86% 76%, rgba(245, 234, 216, 0.14) 50%, transparent 51%);
    background-size: 700px 700px;
    opacity: 0.7;
    pointer-events: none;
  }

  .manifesto-kultrun__inner {
    position: relative;
    z-index: 1;
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(88px, 10vw, 160px) clamp(20px, 5vw, 72px);
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(48px, 8vw, 120px);
    align-items: center;
  }

  /* ── Copy column ───────────────────────────────────────────────── */
  .manifesto-kultrun__eyebrow {
    font-family: var(--font-sans);
    color: var(--ember);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    font-size: 0.74rem;
    margin: 0 0 24px;
  }

  .manifesto-kultrun__title {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    color: var(--bone);
    font-size: clamp(2.6rem, 6vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.018em;
    margin: 0 0 32px;
    max-width: 16ch;
  }

  .manifesto-kultrun__body {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    color: rgba(238, 232, 220, 0.7);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.7;
    max-width: 52ch;
    margin: 0 0 24px;
  }

  .manifesto-kultrun__italic {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ember);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    margin: 0 0 36px;
  }

  .manifesto-kultrun__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-height: 56px;
    padding: 0 32px;
    border: 1px solid rgba(238, 232, 220, 0.82);
    background: #eee8dc;
    color: var(--obsidian);
    font-family: var(--font-sans);
    font-weight: var(--fw-medium);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .manifesto-kultrun__cta:hover,
  .manifesto-kultrun__cta:focus-visible {
    background: transparent;
    color: var(--bone);
    border-color: var(--ember);
  }

  .manifesto-kultrun__arn {
    margin: 28px 0 0;
    font-family: var(--font-serif);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: rgba(198, 168, 106, 0.7);
  }
  .manifesto-kultrun__arn em {
    color: var(--ember);
    font-style: italic;
  }

  /* ── Visual column (kultrún) ───────────────────────────────────── */
  .manifesto-kultrun__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ember);
  }

  .kultrun-symbol {
    width: min(78vw, 520px);
    height: auto;
    opacity: 0.88;
    filter: drop-shadow(0 0 24px rgba(198, 168, 106, 0.16));
  }

  .kultrun-stroke {
    stroke: currentColor;
    stroke-width: 1;
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .kultrun-stroke--soft  { opacity: 0.55; }
  .kultrun-stroke--faint { opacity: 0.18; }

  /* Subtle orbital drift on the wind spiral — almost imperceptible */
  .kultrun-symbol__orbit {
    transform-box: fill-box;
    transform-origin: center;
    animation: kultrunDrift 56s linear infinite;
  }
  @keyframes kultrunDrift {
    from { transform: translate(360px, 180px) rotate(0deg); }
    to   { transform: translate(360px, 180px) rotate(360deg); }
  }
  /* ── BLACK HOLE PORTAL — central interactive singularity ────────── */
  .kultrun-portal {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.22s ease-out;
    will-change: transform;
  }
  .kultrun-portal__accretion {
    transform-box: fill-box;
    transform-origin: 0 0;
    animation: kultrunPortalSpin 14s linear infinite;
  }
  .kultrun-portal__photon-ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: kultrunPortalBreathe 5.5s ease-in-out infinite;
  }
  .kultrun-portal__photon-glow {
    transform-box: fill-box;
    transform-origin: center;
    animation: kultrunPortalBreatheGlow 5.5s ease-in-out infinite;
  }
  .kultrun-portal__pulse {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }
  .kultrun-portal__pulse.is-pulsing {
    animation: kultrunPortalPulse 1.1s ease-out;
  }
  @keyframes kultrunPortalSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @keyframes kultrunPortalBreathe {
    0%, 100% { transform: scale(1);    opacity: 0.88; }
    50%      { transform: scale(1.05); opacity: 1; }
  }
  @keyframes kultrunPortalBreatheGlow {
    0%, 100% { transform: scale(1.06); opacity: 0.22; }
    50%      { transform: scale(1.22); opacity: 0.48; }
  }
  @keyframes kultrunPortalPulse {
    0%   { r: 24; opacity: 0.85; stroke-width: 1; }
    100% { r: 220; opacity: 0; stroke-width: 0.3; }
  }
  .kultrun-portal { cursor: pointer; }

  @media (prefers-reduced-motion: reduce) {
    .kultrun-symbol__orbit { animation: none; }
    .kultrun-portal__accretion,
    .kultrun-portal__photon-ring,
    .kultrun-portal__photon-glow { animation: none; }
    .kultrun-portal { transition: none; }
    .kultrun-portal__pulse { animation: none !important; }
  }

  /* Direction labels — small, ritual cartography */
  .kultrun-label {
    position: absolute;
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(198, 168, 106, 0.6);
    white-space: nowrap;
    pointer-events: none;
  }
  .kultrun-label--north { top: 4%;    left: 50%; transform: translateX(-50%); }
  .kultrun-label--east  { top: 50%;   right: 4%; transform: translateY(-50%); }
  .kultrun-label--south { bottom: 4%; left: 50%; transform: translateX(-50%); }
  .kultrun-label--west  { top: 50%;   left: 4%;  transform: translateY(-50%); }

  /* ── Mobile — stacked, kultrún first ──────────────────────────── */
  @media (max-width: 900px) {
    .manifesto-kultrun__inner {
      grid-template-columns: 1fr;
      padding: 80px 20px;
      gap: 48px;
    }
    .manifesto-kultrun__visual {
      order: -1;
    }
    .manifesto-kultrun__title {
      font-size: clamp(2.4rem, 12vw, 4.2rem);
      max-width: 100%;
    }
    .manifesto-kultrun__cta {
      width: 100%;
      max-width: 420px;
      padding: 0 20px;
    }
    .kultrun-label--north { top: -4px; }
    .kultrun-label--south { bottom: -4px; }
  }
</style>

<script>
  /* Interactividad del black hole portal central del kultrún.
     Mouse over la sección → el portal central se inclina sutilmente siguiendo
     el cursor (parallax). Click/tap sobre el portal → onda dorada expansiva. */
  const hosts = document.querySelectorAll<HTMLElement>('[data-cp-portal-host]');
  hosts.forEach(host => {
    const portal = host.querySelector<SVGGElement>('[data-cp-portal]');
    const pulse  = host.querySelector<SVGCircleElement>('[data-cp-pulse]');
    if (!portal) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const MAX_TILT = prefersReduced ? 0 : 7; // grados — el kultrún no debe rotar mucho

    let raf = 0;
    let targetX = 0, targetY = 0;
    let currentX = 0, currentY = 0;

    const tick = () => {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;
      // El centro del portal está en (270,270) del viewBox; rotamos sobre ese punto
      portal.setAttribute('transform', `translate(270 270) rotate(${currentX * 0.3}) skewX(${currentX * 0.5}) skewY(${currentY * 0.5})`);
      raf = requestAnimationFrame(tick);
    };

    const onMove = (clientX: number, clientY: number) => {
      const rect = host.getBoundingClientRect();
      const x = (clientX - rect.left) / rect.width  - 0.5;
      const y = (clientY - rect.top)  / rect.height - 0.5;
      targetX = x * MAX_TILT;
      targetY = y * MAX_TILT;
    };

    host.addEventListener('mousemove', e => onMove(e.clientX, e.clientY));
    host.addEventListener('mouseleave', () => { targetX = 0; targetY = 0; });
    host.addEventListener('touchmove', e => {
      const t = e.touches[0];
      if (t) onMove(t.clientX, t.clientY);
    }, { passive: true });

    // Pulse al click/tap sobre el portal
    if (pulse) {
      const trigger = () => {
        pulse.classList.remove('is-pulsing');
        void (pulse as SVGCircleElement & { offsetWidth?: number }).getBoundingClientRect();
        pulse.classList.add('is-pulsing');
      };
      portal.addEventListener('click', trigger);
      portal.addEventListener('touchstart', trigger, { passive: true });
    }

    if (!prefersReduced) tick();
  });
</script>
