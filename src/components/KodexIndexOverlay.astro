---
/* EL NÚMERO DE LÁMINAS SE CUENTA, NO SE ESCRIBE.
   Este índice afirmaba "27 láminas". Medido hoy: 39 archivos en
   src/pages/kodex/lamina/ y 36 enlaces en la página publicada. El número se
   escribió una vez, llegaron láminas nuevas, y quedó mintiendo en producción.
   chatgpt-contenido lo detectó auditando el sitio en vivo.
   Se cuenta con el mismo glob que usa /kodex/lamina/, así no puede volver a
   desfasarse. */
import conteos from '../data/kodex-conteos.json';
const laminasContadas = conteos.laminas;

// KODEX−∞ · INDEX overlay — jump between the 7 scenes from anywhere in the
// codex (§2 arquitectura, §3 storyboard). Escape to close · focus trap on open.
// Opened by any [data-kdx-index-open] button (KodexChrome exposes one).
import { scenes } from '../lib/kodexScenes.js';
const currentPath = Astro.url.pathname.replace(/\/+$/, '') + '/';
const samePath = (href) => href.replace(/#.*$/, '').replace(/\/+$/, '') + '/' === currentPath;
---
<aside class="kdx-index" data-kdx-index hidden aria-hidden="true" aria-modal="true" role="dialog" aria-labelledby="kdx-index-title">
  <div class="kdx-index__inner">
    <header class="kdx-index__head">
      <span class="kdx-index__eyebrow">◉ SYSTEM INDEX</span>
      <h2 class="kdx-index__title" id="kdx-index-title">seven nodes</h2>
      <button class="kdx-index__close" data-kdx-index-close type="button" aria-label="close index">CLOSE ✕</button>
    </header>

    <ol class="kdx-index__list" role="list">
      {scenes.map((s) => (
        <li class={`kdx-scene kdx-scene--${s.accent}${(samePath(s.href) && s.hash === 'threshold') || s.href === currentPath ? ' is-current' : ''}`} style={`--kdx-scene-accent:${s.accentHex}`}>
          <a class="kdx-scene__link" href={s.href} data-kdx-scene={s.index} data-kdx-target={s.hash}>
            <span class="kdx-scene__idx">{s.index}</span>
            <span class="kdx-scene__emblem" aria-hidden="true">
              <img src={s.emblem} alt="" loading="lazy" />
            </span>
            <span class="kdx-scene__body">
              <span class="kdx-scene__code">{s.code}</span>
              <span class="kdx-scene__sub">{s.subtitle}</span>
            </span>
            <span class="kdx-scene__cta">{((samePath(s.href) && s.hash === 'threshold') || s.href === currentPath) ? 'YOU ARE HERE' : 'ENTER'} →</span>
          </a>
        </li>
      ))}
    </ol>

    {/* CÁMARAS Y ARCHIVOS. Existía todo esto y el índice no lo ofrecía: el
        visitante sólo podía llegar sabiendo la URL. La experiencia tiene que
        mostrar lo que el sistema tiene — "el archivo no almacena: recuerda",
        pero primero hay que poder entrar. */}
    <p class="kdx-index__eyebrow kdx-index__eyebrow--seccion">◈ CHAMBERS &amp; ARCHIVES</p>
    <ul class="kdx-index__camaras" role="list">
      <li><a href="/kodex/strata/"><b>STRATA</b><span>six layers · choose your descent</span></a></li>
      <li><a href="/kodex/lamina/"><b>THE PLATES</b><span>{laminasContadas} láminas · reference-measured codex</span></a></li>
      <li><a href="/kodex/lab/heart/"><b>HEART / NODE M</b><span>orientation — the heart does not score</span></a></li>
      <li><a href="/kodex/lab/altar/"><b>DIGITAL ALTAR</b><span>offer a word · local memory only</span></a></li>
      <li><a href="/kodex/lab/temple/"><b>SIGNAL TEMPLE</b><span>architecture built from your state</span></a></li>
      <li><a href="/kodex/lab/signal-vortex/"><b>SIGNAL VORTEX</b><span>translation field · internal proof</span></a></li>
      <li><a href="/kodex/lab/command-shell/"><b>COMMAND SHELL</b><span>keyboard-first · ⌘K palette</span></a></li>
      <li><a href="/kodex/lab/semantic-wheel/"><b>RELATION WHEEL</b><span>domain · process · scene</span></a></li>
      <li><a href="/kodex/archive/"><b>ARCHIVE</b><span>living memory</span></a></li>
      <li><a href="/kodex/works/"><b>WORKS</b><span>the collection</span></a></li>
    </ul>
  </div>
</aside>

<style is:global>
  .kdx-index{
    position:fixed; inset:0; z-index:180;
    background:rgba(10,10,10,.965); backdrop-filter:blur(14px);
    display:grid; place-items:center;
    opacity:0; pointer-events:none; transition:opacity .28s ease;
    overflow-y:auto; padding:clamp(20px,4vh,44px) clamp(16px,4vw,40px);
    color:var(--kdx-dust-white,#EDEDED);
    font-family:'Space Grotesk','Instrument Sans',system-ui,sans-serif;
  }
  .kdx-index[hidden]{ display:none; }
  .kdx-index[data-open]{ opacity:1; pointer-events:auto; }
  .kdx-index__inner{ width:min(1080px, 96vw); }
  .kdx-index__head{ display:flex; align-items:baseline; gap:14px; flex-wrap:wrap;
    padding:0 0 clamp(16px,3vh,28px); border-bottom:1px solid var(--kdx-line,rgba(237,237,237,.15)); }
  .kdx-index__eyebrow{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.24em; color:var(--kdx-cyan,#00F0FF); }
  .kdx-index__title{ font-family:'Archivo','Space Grotesk',system-ui,sans-serif; font-stretch:125%; font-weight:700;
    letter-spacing:.02em; text-transform:uppercase; font-size:clamp(1.4rem,3.5vw,2.1rem); margin:0 auto 0 4px; }
  .kdx-index__close{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.2em;
    background:transparent; border:1px solid var(--kdx-line,rgba(237,237,237,.15)); color:var(--kdx-muted,#88888A);
    padding:6px 12px; cursor:pointer; transition:color .2s,border-color .2s; }
  .kdx-index__close:hover, .kdx-index__close:focus-visible{ color:var(--kdx-dust-white,#EDEDED); border-color:var(--kdx-dust-white,#EDEDED); outline:none; }

  .kdx-index__eyebrow--seccion{ display:block; margin:clamp(20px,3.4vh,32px) 0 10px; opacity:.85; }
  .kdx-index__camaras{ list-style:none; padding:0; margin:0 0 clamp(16px,3vh,26px);
    display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:8px; }
  .kdx-index__camaras a{ display:flex; flex-direction:column; gap:3px; padding:11px 14px;
    text-decoration:none; border:1px solid rgba(230,230,230,.14); color:#e8e6e0;
    transition:border-color .2s ease, background .2s ease; }
  .kdx-index__camaras a:hover{ border-color:var(--kdx-cyan,#00F0FF); background:rgba(0,240,255,.05); }
  .kdx-index__camaras b{ font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; font-weight:600; }
  .kdx-index__camaras span{ font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.06em; color:rgba(230,230,230,.5); }
  .kdx-index__list{ list-style:none; padding:0; margin:clamp(18px,3vh,28px) 0; display:grid; gap:1px;
    background:var(--kdx-line,rgba(237,237,237,.15)); border:1px solid var(--kdx-line,rgba(237,237,237,.15)); }
  .kdx-scene{ background:var(--kdx-black,#0A0A0A); }
  .kdx-scene__link{ display:grid; grid-template-columns:52px 58px 1fr auto; gap:clamp(10px,1.8vw,22px);
    align-items:center; padding:clamp(14px,2.6vh,22px) clamp(14px,2.2vw,22px);
    text-decoration:none; color:var(--kdx-dust-white,#EDEDED); transition:background .2s; }
  .kdx-scene__link:hover, .kdx-scene__link:focus-visible{ background:var(--kdx-surface,#111113); outline:none; }
  .kdx-scene__link:hover .kdx-scene__cta, .kdx-scene__link:focus-visible .kdx-scene__cta{ color:var(--kdx-scene-accent, var(--kdx-cyan,#00F0FF)); }
  .kdx-scene__idx{ font-family:'JetBrains Mono',monospace; font-size:22px; font-weight:500;
    color:var(--kdx-scene-accent, var(--kdx-dust-white,#EDEDED)); letter-spacing:.06em; }
  .kdx-scene__emblem{ width:48px; aspect-ratio:1; display:grid; place-items:center; overflow:hidden;
    border:1px solid color-mix(in srgb,var(--kdx-scene-accent, #00F0FF) 34%, transparent);
    background:rgba(255,255,255,.025); }
  .kdx-scene__emblem img{ width:100%; height:100%; object-fit:cover; filter:grayscale(1) contrast(1.24); opacity:.9; }
  .kdx-scene__link:hover .kdx-scene__emblem img,
  .kdx-scene__link:focus-visible .kdx-scene__emblem img{ filter:grayscale(.35) contrast(1.18); }
  .kdx-scene__body{ display:flex; flex-direction:column; gap:4px; min-width:0; }
  .kdx-scene__code{ font-family:'Archivo','Space Grotesk',system-ui,sans-serif; font-stretch:125%; font-weight:700;
    letter-spacing:.02em; text-transform:uppercase; font-size:clamp(1rem,2.4vw,1.5rem); }
  .kdx-scene__sub{ font-family:'Space Grotesk',system-ui,sans-serif; font-size:12px; color:var(--kdx-muted,#88888A);
    letter-spacing:.06em; text-transform:uppercase; margin-left:6px; display:inline; }
  .kdx-scene__lede{ font-family:'Space Grotesk',system-ui,sans-serif; font-size:13px; line-height:1.5;
    color:var(--kdx-muted,#88888A); margin-top:4px; max-width:60ch; }
  .kdx-scene__cta{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.2em;
    color:var(--kdx-muted,#88888A); transition:color .2s; white-space:nowrap; }
  .kdx-scene.is-current .kdx-scene__link{ background:var(--kdx-surface,#111113); }
  .kdx-scene.is-current .kdx-scene__idx{ color:var(--kdx-scene-accent, var(--kdx-cyan,#00F0FF)); }
  .kdx-scene.is-current .kdx-scene__cta{ color:var(--kdx-scene-accent, var(--kdx-cyan,#00F0FF)); }

  .kdx-index__foot{ text-align:center; padding-top:clamp(12px,2vh,20px); }
  .kdx-index__tagline{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.24em;
    color:var(--kdx-muted,#88888A); margin:0; }

  @media (max-width:640px){
    .kdx-scene__link{ grid-template-columns:34px 44px 1fr; grid-template-rows:auto auto; }
    .kdx-scene__cta{ grid-column:1 / -1; text-align:right; padding-top:6px; }
    .kdx-scene__idx{ font-size:16px; }
    .kdx-scene__emblem{ width:40px; }
    .kdx-scene__code{ font-size:1.05rem; }
    .kdx-scene__sub{ display:block; margin-left:0; margin-top:2px; }
  }
</style>

<script is:inline>
  (() => {
    const overlay = document.querySelector('[data-kdx-index]');
    if (!overlay) return;
    const links = [...overlay.querySelectorAll('a[data-kdx-scene]')];
    const focusable = () => overlay.querySelectorAll('a[href],button:not([disabled])');
    const root = document.querySelector('[data-kx]');
    const basePath = `${location.pathname}${location.search}`;
    const normalizePath = (href) => new URL(href, location.origin).pathname.replace(/\/+$/, '') + '/';
    let lastFocus = null;
    let openedByHash = false;

    const applyCurrentState = () => {
      const current = location.pathname.replace(/\/+$/, '') + '/';
      const hash = (location.hash || '').replace('#', '');
      links.forEach((link) => {
        const li = link.closest('.kdx-scene');
        const target = link.dataset.kdxTarget || '';
        const pathMatch = normalizePath(link.href) === current;
        const isCurrent = pathMatch && ((hash && target === hash) || (!hash && (!target || target === 'threshold')));
        li?.classList.toggle('is-current', isCurrent);
        const cta = link.querySelector('.kdx-scene__cta');
        if (cta) cta.textContent = `${isCurrent ? 'YOU ARE HERE' : 'ENTER'} →`;
      });
    };

    const open = ({ fromHash = false } = {}) => {
      if (!fromHash) openedByHash = false;
      lastFocus = document.activeElement;
      overlay.hidden = false;
      requestAnimationFrame(() => overlay.setAttribute('data-open', ''));
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      document.querySelectorAll('[data-kdx-index-open]').forEach((b) => b.setAttribute('aria-expanded', 'true'));
      const first = focusable()[0]; if (first) first.focus();
      try { window.kdx && window.kdx('index_open'); } catch (_) {}
    };

    const close = ({ syncHash = true } = {}) => {
      overlay.removeAttribute('data-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      document.querySelectorAll('[data-kdx-index-open]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      setTimeout(() => { overlay.hidden = true; }, 300);
      if (lastFocus && lastFocus.focus) lastFocus.focus();
      if (!syncHash) return;
      if (location.hash === '#index' && !openedByHash && history.length > 1) history.back();
      else if (location.hash === '#index') history.replaceState(null, '', basePath);
    };

    document.querySelectorAll('[data-kdx-index-open]').forEach((b) => b.addEventListener('click', (e) => {
      e.preventDefault();
      if (location.hash !== '#index') {
        history.pushState(null, '', `${basePath}#index`);
        open();
        return;
      }
      open();
    }));
    overlay.querySelector('[data-kdx-index-close]')?.addEventListener('click', () => close());
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
    addEventListener('keydown', (e) => {
      if (overlay.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (e.key === 'Tab') {
        const els = [...focusable()]; if (!els.length) return;
        const first = els[0], last = els[els.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    const applyHash = () => {
      const h = (location.hash || '').replace('#', '');
      applyCurrentState();
      if (!h) {
        if (!overlay.hidden) close({ syncHash: false });
        return;
      }
      if (h === 'index') {
        openedByHash = true;
        if (overlay.hidden) open({ fromHash: true });
        return;
      }
      const link = links.find((a) => (a.dataset.kdxTarget || '').toLowerCase() === h.toLowerCase())
        || links.find((a) => a.href.toLowerCase().includes(h));
      if (link) {
        const samePath = normalizePath(link.href) === normalizePath(location.href);
        const targetHash = link.dataset.kdxTarget ? `#${link.dataset.kdxTarget}` : '';
        if (samePath && targetHash === location.hash) return;
        window.location.href = link.getAttribute('href');
        return;
      }
      if (root?.classList.contains('kx--threshold') && !overlay.hidden) close({ syncHash: false });
    };
    addEventListener('hashchange', applyHash);
    applyHash();
  })();
</script>
