        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.BufferAttribute(arr, 3));
        if (vc) g.setAttribute('color', new THREE.BufferAttribute(carr!, 3));
        const P = pts(g, { size, opacity, vertexColors: vc, color: vc ? null : color });
        scene.add(P);
        return P;
      }
      const NB = mobile ? 1400 : 2600;
      const plasma = cloudPts(
        NB,
        () => {
          const r = Math.random() * 24,
            a = Math.random() * 6.283;
          return { x: Math.cos(a) * r, y: L(PLASMA[0], PLASMA[1], Math.random()), z: Math.sin(a) * r, tint: 0xffffff, k: Math.random() * 0.6 };
