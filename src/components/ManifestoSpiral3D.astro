        const rim = new THREE.Mesh(new THREE.TorusGeometry(22, 0.9, 10, 72), new THREE.MeshStandardMaterial({ color: 0x6a4a28, roughness: 0.7, metalness: 0.2, emissive: 0x2a1c0e, emissiveIntensity: 0.4 }));
        rim.position.copy(kultrun.position);
        kultrun.add(rim);
        kultrunGlow = mandalaPlane(64, '#ffe6a8', new THREE.Color(0xffce70), 0.12);
        kultrunGlow.position.set(0, KULTRUN_Y, 0);

        // THE COSMIC DNA — bold glowing tubes + base-pair jewels
        dna = new THREE.Group();
        scene.add(dna);
        (function () {
          const STEPS = mobile ? 110 : 200,
            turns = 4.2, // fewer turns → elongated helix, not an accordion
            rad = 8.5,
            P1: any[] = [],
            P2: any[] = [],
            RA: any[] = [],
            RB: any[] = [];
          for (let i = 0; i <= STEPS; i++) {
            const u = i / STEPS,
              y = L(DNA_TOP, DNA_BOT, u),
              ang = u * turns * 6.283;
            const v1 = new THREE.Vector3(Math.cos(ang) * rad, y, Math.sin(ang) * rad),
              v2 = new THREE.Vector3(Math.cos(ang + Math.PI) * rad, y, Math.sin(ang + Math.PI) * rad);
            P1.push(v1);
            P2.push(v2);
            if (i % 6 === 0) {
