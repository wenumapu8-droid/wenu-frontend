            const pr = pairs[Math.random() < 0.5 ? 0 : 1],
              fl = Math.random() < 0.5,
              mats: any[] = [];
            [
              [pr[fl ? 1 : 0], 0.26],
              [pr[fl ? 0 : 1], 0.74],
            ].forEach((pc) => {
              const m = new THREE.MeshStandardMaterial({ color: pc[0], emissive: pc[0], emissiveIntensity: 0.6, roughness: 0.4, metalness: 0.1 });
              const bar = new THREE.Mesh(new THREE.BoxGeometry(len * 0.46, 0.5, 0.95), m);
              bar.position.copy(a).add(dir.clone().multiplyScalar(pc[1] as number));
              bar.quaternion.copy(q);
              dna.add(bar);
              mats.push(m);
