      // ── CINEMA grade pass — screen-space black-hole vortex + chromatic aberration
      // + teal/warm grade + vignette + film grain, all in one fused full-screen pass
      const CinemaShader = {
        uniforms: { tDiffuse: { value: null }, uTime: { value: 0 }, uAmt: { value: 1.0 }, uVortex: { value: 0.0 }, uAspect: { value: innerWidth / innerHeight } },
        vertexShader: `varying vec2 vUv; void main(){ vUv=uv; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}`,
