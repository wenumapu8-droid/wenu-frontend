      placeCamera(0);

      // ── scroll wiring — slow smooth + suction-to-void at the very end ──────
      gsap.registerPlugin(ScrollTrigger);
      const railEl = document.getElementById('ms3d-rail');
      const chapterEl = document.getElementById('ms3d-chapter');
      const lenis = new Lenis({ smoothWheel: true, lerp: 0.055, wheelMultiplier: 0.85, touchMultiplier: 1.1 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((t: number) => lenis.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);
      const scrollTween = gsap.to(progress, {
        p: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: '#ms3d-stations',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1.3,
          onUpdate: (s: any) => {
            if (railEl) railEl.style.width = s.progress * 100 + '%';
            const v = Math.max(0, (s.progress - 0.955) / 0.045);
            if (voidEl) voidEl.style.opacity = String(v);
            if (voidWord) voidWord.style.opacity = String(Math.min(1, v * 1.3));
          },
        },
      });
      const stationTriggers: any[] = [];
      document.querySelectorAll('#ms3d-stations .ms3d-station').forEach((sec) => {
        const rev = sec.querySelector('.ms3d-reveal') as HTMLElement | null;
        const ch = (sec as HTMLElement).dataset.chapter || '';
        if (!rev) return;
        stationTriggers.push(
          ScrollTrigger.create({ trigger: sec, start: 'top 80%', onEnter: () => rev.classList.add('in'), onLeaveBack: () => rev.classList.remove('in') })
        );
        stationTriggers.push(
          ScrollTrigger.create({
            trigger: sec,
            start: 'top 55%',
            end: 'bottom 45%',
            onToggle: (s: any) => {
              if (s.isActive && chapterEl) chapterEl.textContent = ch;
            },
          })
        );
      });

      // ── render loop (everything turns SLOWLY; fully stoppable) ────────────
      const clock = new THREE.Clock();
      let rafId: number | null = null;
      const loadingEl = document.getElementById('ms3d-loading');
      let firstFrame = true;
      function tick() {
        const dt = Math.min(clock.getDelta(), 0.05),
          t = clock.elapsedTime,
          p = progress.p;
        placeCamera(p);
        sun.rotation.y += dt * 0.008;
        proms.rotation.y += dt * 0.02;
        proms.children.forEach((pv: any) => {
          pv.children[0].scale.setScalar(1 + 0.1 * Math.sin(t * 1.1 + pv.userData.ph));
        });
        gasGiant.rotation.y += dt * 0.05;
        mars.rotation.y += dt * 0.05;
        moon.rotation.y += dt * 0.03;
        earth.rotation.y += dt * 0.02;
        plasma.rotation.y += dt * 0.15;
        (plasma.material as any).opacity = 0.7 + 0.22 * Math.sin(t * 3.0);
        gas.rotation.y -= dt * 0.03;
        liquid.position.x = Math.sin(t * 0.5) * 1.0;
        liquid.rotation.y += dt * 0.02;
        mandalaSun.quaternion.copy(camera.quaternion);
        mandalaSun.rotateZ(t * 0.014);
        if (kultrun) {
          kultrun.quaternion.copy(camera.quaternion);
          kultrun.rotateZ(t * 0.02);
          kultrunGlow.quaternion.copy(camera.quaternion);
        }
        if (dna) {
          dna.rotation.y += dt * 0.06;
          mandalaDna.quaternion.copy(camera.quaternion);
          mandalaDna.rotateZ(-t * 0.02);
          // a pulse of light travels up the ladder — the code of life "switching on"
          const rg = (dna.userData as any).rungs;
          if (rg) {
            const ph = (t * 0.12) % 1;
            for (const R of rg) {
              let d = Math.abs(R.u - ph);
              d = Math.min(d, 1 - d);
              const gl = Math.exp(-(d * d) / 0.004);
              for (const m of R.mats) m.emissiveIntensity = 0.6 + gl * 1.6;
            }
          }
        }
        if (eyeNet) {
          eyeIdle += dt;
          if (eyeIdle > 2) {
            eyeTarget.x = Math.sin(t * 0.3) * 0.6;
            eyeTarget.y = Math.cos(t * 0.22) * 0.45;
          }
          eyeLook.x += (eyeTarget.x - eyeLook.x) * 0.06;
          eyeLook.y += (eyeTarget.y - eyeLook.y) * 0.06;
          eyeNet.uniforms.uMouse.value.set(eyeLook.x, eyeLook.y);
          eyeNet.uniforms.uTime.value = t;
        }
        if (serpent) {
          serpent.rotation.y += dt * 0.014;
          const su = serpent.userData as any;
          if (su.bodyMat) su.bodyMat.emissiveIntensity = 0.85 + 0.2 * Math.sin(t * 0.5);
          if (su.glint) su.glint.offset.x += dt * 0.012;
          if (su.wave) su.wave.value += dt * 1.5; // serpentine: S-wave travels head->tail
          if (su.tongue) {
            const cc = (t * 0.42) % 1,
              ext = cc < 0.22 ? Math.sin((cc / 0.22) * Math.PI) : 0;
            su.tongue.scale.set(1, 0.12 + ext * 1.0, 1);
          }
          if (su.cosmos) su.cosmos.rotation.z += dt * 0.18;
        }
        if (eyeSource) eyeSource.scale.setScalar(1 + 0.12 * Math.sin(t * 1.5));
        if (eyeRays) eyeRays.rotation.y += dt * 0.02;
        if (blackhole) {
          const bh = blackhole.userData;
          mandalaBH.quaternion.copy(camera.quaternion);
          mandalaBH.rotateZ(t * 0.02);
          bh.disk.rotation.z += dt * 0.5;
          bh.disk2.rotation.z -= dt * 0.35;
          const d = bh.data,
            pos = bh.pos,
            suck = 1 + p * 3;
          for (let i = 0; i < d.length; i++) {
            const q = d[i];
            q.ang += (0.4 + 12 / (q.rad + 3)) * dt * 0.5;
            q.rad -= dt * (2.2 + 18 / (q.rad + 4)) * suck;
            if (q.rad < 2) {
              q.rad = 20 + Math.random() * 36;
              q.ang = Math.random() * 6.283;
            }
            pos[i * 3] = Math.cos(q.ang) * q.rad;
            pos[i * 3 + 1] = q.y * (q.rad / 56);
            pos[i * 3 + 2] = Math.sin(q.ang) * q.rad;
          }
          bh.geo.attributes.position.needsUpdate = true;
        }
        stars.rotation.y += dt * 0.002;
        if (galaxy) galaxy.rotation.z += dt * 0.006;
        // per-scene EXPOSURE ramp — lift the dark emissive scenes (DNA), ease down the bright sun + the void
        renderer.toneMappingExposure = 1.02 + 0.4 * Math.exp(-Math.pow((p - 0.8) / 0.1, 2)) - (p < 0.1 ? 0.07 * (1 - p / 0.1) : 0) - (p > 0.9 ? 0.16 * Math.min(1, (p - 0.9) / 0.08) : 0);
        cinemaPass.uniforms.uTime.value = t;
        cinemaPass.uniforms.uVortex.value = Math.max(0, Math.min(1, (p - 0.85) / 0.13));
        composer.render();
        if (firstFrame) {
          firstFrame = false;
          if (loadingEl) {
            (loadingEl as HTMLElement).style.opacity = '0';
            setTimeout(() => loadingEl.remove(), 800);
          }
        }
        rafId = requestAnimationFrame(tick);
      }
      function resume() {
        if (rafId == null) {
          clock.getDelta(); // drop the idle gap so dt doesn't spike on resume
          rafId = requestAnimationFrame(tick);
        }
      }
      function pause() {
        if (rafId != null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      }
      resume(); // called only while #ms3d is already intersecting

      function dispose() {
        pause();
        removeEventListener('resize', resize);
        removeEventListener('pointermove', onPointerMove as any);
        if (idleHandle != null) {
          if (idleIsTimeout) clearTimeout(idleHandle);
          else if ('cancelIdleCallback' in window) (window as any).cancelIdleCallback(idleHandle);
        }
        scrollTween.scrollTrigger?.kill();
        scrollTween.kill();
        stationTriggers.forEach((st) => st.kill());
        lenis.destroy();
        scene.traverse((obj: any) => {
          if (obj.geometry) obj.geometry.dispose();
          if (obj.material) {
            const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
            mats.forEach((m: any) => {
              if (m.map) m.map.dispose();
              m.dispose();
            });
          }
        });
        sprite.dispose();
        composer.passes.forEach((pass: any) => pass.dispose && pass.dispose());
        composer.dispose();
        renderer.dispose();
      }

      return { pause, resume, dispose };
    }
  }
</script>

