          const curve = new THREE.CatmullRomCurve3(P),
            tubeR = mobile ? 2.6 : 3.1,
            tubes = mobile ? 150 : 230;
          // TAPERED body — real snake radius profile: bulged head/neck ->
          // subtle neck pinch -> full body -> fine tapered tail (a uniform tube,
          // or even a linear taper, never reads as a snake). Ref: Codrops
          // procedural-snake technique (memory reference_webgl_snake_technique).
          const ss = (a: number, b: number, x: number) => {
            x = Math.max(0, Math.min(1, (x - a) / (b - a)));
            return x * x * (3 - 2 * x);
          };
          const rfn = (u: number) => {
            const headFull = ss(0.0, 0.1, u),
              neck = 1 - 0.26 * Math.exp(-Math.pow((u - 0.09) / 0.045, 2)),
              tail = 1 - ss(0.72, 1.0, u) * 0.93;
