          })();
          const ribMat = new THREE.MeshStandardMaterial({ color: 0x0c1020, emissive: 0xa8c4ff, emissiveMap: ribTex, emissiveIntensity: 0.85, roughness: 0.3, metalness: 0.55, side: THREE.DoubleSide });
          dna.add(new THREE.Mesh(ribbon(P1, 1.8), ribMat));
          dna.add(new THREE.Mesh(ribbon(P2, 1.8), ribMat));
          dna.add(new THREE.Mesh(new THREE.TubeGeometry(c1, seg, 1.2, 8, false), new THREE.MeshBasicMaterial({ color: 0x6a9ad0, transparent: true, opacity: 0.05, blending: THREE.AdditiveBlending, depthWrite: false })));
          dna.add(new THREE.Mesh(new THREE.TubeGeometry(c2, seg, 1.2, 8, false), new THREE.MeshBasicMaterial({ color: 0x8a6ec8, transparent: true, opacity: 0.05, blending: THREE.AdditiveBlending, depthWrite: false })));
          // BASE PAIRS — real 4-colour rungs: A-red pairs T-yellow, G-blue pairs C-green.
          // Each rung is two flat colour bars meeting in the middle (the two complementary bases).
