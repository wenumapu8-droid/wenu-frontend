     hand-coded SVG's second helix strand (#64e0d0); amethyst is new for the
     kultrún/DNA/eyes/black-hole chapters, requested by Ocin. Declared once
     here rather than repeated as raw hex through the rules below. */
  .ms3d {
    --ms3d-teal: #64e0d0;
    --ms3d-amethyst: #9a7ee0;
    position: relative;
    background: var(--obsidian);
  }
  .ms3d-poster[hidden],
  .ms3d-enhanced[hidden] {
    display: none;
  }

  /* ── enhanced (WebGL) layer ── */
  .ms3d-enhanced {
    position: relative;
  }
  .ms3d-webgl {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    display: block;
    z-index: 0;
  }
