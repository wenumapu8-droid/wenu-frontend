              arr.push(gx + rand(-0.5, 0.5), gy + rand(-0.5, 0.5), gz + rand(-0.5, 0.5));
            }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.BufferAttribute(new Float32Array(arr), 3));
        const P = pts(g, { size: 0.72, color: C.silver, opacity: 0.85 });
        scene.add(P);
        return P;
      })();

      // ── bloom + composer (mobile: cheaper — lower res, higher threshold) ───
      const composer = new EffectComposer(renderer);
