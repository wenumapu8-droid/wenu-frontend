        })();
        mandalaDna = mandalaPlane(118, '#c9b8ff', new THREE.Color(C.amethyst), 0.2);
        mandalaDna.position.set(0, (DNA_TOP + DNA_BOT) / 2, 0);

        // ITROFILL MONGEN — big toroidal net of eyes (Alex Grey "Net of Being")
        eyeNet = (function () {
          const Nu = mobile ? 26 : 42,
