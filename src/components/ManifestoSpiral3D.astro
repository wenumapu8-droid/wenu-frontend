---
/**
 * ManifestoSpiral3D.astro — WebGL "visionary" upgrade of the manifesto's
 * opening journey (Ocin's dream, prototype v5 — audited + approved, 2026-07-18).
 *
 * The journey (14 stations, mapuche cosmology): WENU MAPU / THE SUN (divine
 * source: granulated surface, prominences, corona, sacred-geometry mandala) ->
 * PLANETS (banded gas giant + ring, Mars) -> THE MOON -> NAG MAPU / THE EARTH
 * (procedural blue-marble + fresnel atmosphere, now properly LIT: key + rim
 * directional lights give every body a real terminator) -> the four forces
 * (Kütral·Kürüf·Ko·Kura = plasma/gas/liquid/solid) -> MELI WITRAN MAPU (an
 * authentic kultrún: canvas-drawn drumhead — 4-direction cross from the east,
 * choike/ñandú three-toed terminals, Antü sun + Küyen crescent moon + Melipal
 * Southern Cross + Wüñelfe morning star at the quadrants, wood rim) -> the
 * COSMIC DNA, now obsidian crystalline (MeshPhysicalMaterial iridescent
 * strands with a canvas star-glint skin, base pairs as glowing sacred-
 * geometry star-cross Sprites, not plain jewels) -> the primordial COSMIC
 * SERPENT, Wenumawiza australis, coiling in the cosmos NEAR THE PLANETS (not
 * around the DNA) — an obsidian MeshPhysicalMaterial body with a real
 * faceted diamond-scale lattice (map + bumpMap relief, each rhombus a
 * domed scale, plus an emissiveMap of crystalline glints and a spine
 * constellation line), an elongated head with four star-marks (the four
 * winds) and pupil-less white/electric-blue eyes, tail ending in a small
 * orbit/eclipse -> ITROFILL MONGEN (a toroidal net of hundreds of eyes —
 * InstancedBufferGeometry + ShaderMaterial, one draw call; pupils track the
 * pointer, idle-drift on touch, per-instance blink) converging on a NET OF
 * BEING (a bright central light + radiating gold rays at the torus' heart,
 * Alex Grey style) -> MIÑCHE MAPU (a whirlpool black hole that sucks every
 * particle into its centre) -> a fade to absolute black + "· nothing ·
 * everything ·" at the very end of the scroll.
 *
 * Ported 1:1 from the approved prototype:
 *   /private/tmp/.../scratchpad/manifesto3d/index.html
 *   (v5, kultrún-audited + contrast-veil + capability-gate fix + serpent
 *   repositioned/restyled 3x (Filu -> obsidian star-glint -> obsidian
 *   faceted diamond-scale w/ bump relief) + DNA restyled twice
 *   (de-saturated gold/teal -> obsidian crystalline), 2026-07-19)
 *
 * PROGRESSIVE ENHANCEMENT (non-negotiable, unchanged since v3):
 * - `ManifestoSpiral.astro` (hand-coded SVG) stays the DEFAULT served visual —
 *   only prefers-reduced-motion, no WebGL, or a genuinely tiny viewport
 *   (<360px) get it instead of the 3D. hardwareConcurrency/deviceMemory do
 *   NOT gate this fallback (fixed 2026-07-18 — low core counts are common on
 *   perfectly capable machines/VMs/previews and would wrongly hide the 3D);
 *   they only pick a lighter quality PRESET inside the engine (see `lowPerf`).
 * - A tiny synchronous `is:inline` script decides capability (matchMedia +
 *   WebGL feature-detect only — no Three.js touched) and flips which of the
 *   two blocks is `hidden`, before the user is likely to have scrolled.
 * - The engine (~500kb: three + gsap + lenis) is dynamic-import()'d only
 *   inside an IntersectionObserver callback — reduced-motion / no-WebGL /
 *   tiny-viewport visitors download none of it.
 * - Inside the engine itself, the HEAVY depth (kultrún, DNA tubes, the eye
 *   net, the black hole) is built in a deferred `buildDeep()` — requestIdle
 *   Callback (setTimeout fallback) — so the opening (sun/planets/earth) paints
 *   fast and the rest streams in "while you read" the first few stations.
 * - The render loop is fully paused (cancelAnimationFrame) whenever the
 *   section scrolls out of view, and the fixed canvas/UI chrome hides at the
 *   same moment (a `position:fixed` canvas would otherwise paint over the
 *   Kultrun section / Footer below once scrolled past).
 *
 * Lenis note: Lenis smooths the WHOLE window scroll while the engine is
 * loaded (its default mode, exactly like the approved prototype) — this only
 * ever happens on /manifesto (this component is imported nowhere else), so
 * it never touches scroll feel on Shop/Home/other pages.
 */
import ManifestoSpiral from './ManifestoSpiral.astro';

type Station = {
  chapter: string;
  eyebrow: string;
  eyebrowClass?: 'teal' | 'ame';
  heading: string;
  hero?: boolean;
  lede?: string;
  body?: string;
  phase?: string;
  es?: string;
};

// Copy verbatim from the approved v5 prototype (mapuche cosmology pass).
const STATIONS: Station[] = [
  {
    chapter: 'I · Wenu Mapu — the sky-world',
    eyebrow: 'Wenu Mapu — the manifesto',
    hero: true,
    heading: 'The body is<br>sacred territory',
    lede: 'An awakening · from the sky-world to the self',
  },
  {
    chapter: 'II · Antü — the first light',
    eyebrow: 'The source',
    heading: 'Everything begins<br>as light',
    body: 'The Mapuche name the world above Wenu Mapu — the land of light, where the ancestors dwell. A single radiance chose to become many. You are one of the ways it learned to see itself.',
  },
  {
    chapter: "III · Rüpü — the ancestors' road",
    eyebrow: 'The wandering fires',
    eyebrowClass: 'ame',
    heading: 'The fire that lit the stars<br>sleeps inside your bones',
    body: 'The Milky Way is Rüpü — the luminous road the ancestors walk. Iron, gold, calcium: every atom in you was forged along it. You are not watching the cosmos. You are the cosmos, remembering itself.',
  },
  {
    chapter: 'IV · Küyen — the tide within',
    eyebrow: 'The moon',
    eyebrowClass: 'teal',
    heading: 'She who moves the sea<br>moves the blood',
    body: 'Küyen never touches you, yet you answer her. Every rhythm in the body is a smaller echo of a larger sky.',
    es: 'Küyen ñi az',
  },
  {
    chapter: 'V · Nag Mapu — the living ground',
    eyebrow: 'The earth',
    heading: 'A blue seed<br>suspended in the dark',
    body: 'Nag Mapu — the land here, where we stand. Water, breath, soil and stone practiced making bodies long before they made ours. We are the earth, learning to walk and to wonder.',
  },
  {
    chapter: 'VI · The descent — toward Miñche Mapu',
    eyebrow: 'The threshold',
    eyebrowClass: 'ame',
    heading: 'Now we turn inward,<br>toward the world below',
    body: 'To descend into the body is to travel toward Miñche Mapu, the land beneath — through the four forces from which every living thing is woven.',
    phase: 'Kütral · Kürüf · Ko · Kura',
  },
  {
    chapter: 'VII · Kütral — the first fire',
    eyebrow: 'Plasma · fire',
    heading: 'Before form,<br>there was only fire',
    body: 'Kütral — the state of stars and lightning. Pure charge, undecided, still becoming. The first breath of creation, still glowing in the deep.',
  },
  {
    chapter: 'VIII · Kürüf — the breath',
    eyebrow: 'Gas · wind',
    eyebrowClass: 'teal',
    heading: 'Then the fire cooled<br>into breath',
    body: 'Kürüf — the wind, the air, the spirit that fills the lungs and moves the world. To breathe is to remember you were once wind.',
  },
  {
    chapter: 'IX · Ko — the flow',
    eyebrow: 'Liquid · water',
    eyebrowClass: 'teal',
    heading: 'Breath became water,<br>water became blood',
    body: 'Ko — water. The body is mostly ocean. What flows through the rivers flows through you: the same water, only borrowed for a lifetime.',
  },
  {
    chapter: 'X · Kura — the form',
    eyebrow: 'Solid · stone',
    heading: 'And water became<br>bone, stone, metal',
    body: 'Kura — stone. Matter finally holds a shape. Here adornment is born: form made sacred, the cosmos choosing to wear a face.',
  },
  {
    chapter: 'XI · Meli Witran Mapu — the four directions',
    eyebrow: 'The kultrún',
    eyebrowClass: 'ame',
    heading: 'The drum is a map<br>of the whole universe',
    body: 'Meli Witran Mapu — the four places, oriented from the east: Puel, Willi, Lafken, Pikun. The kultrún holds the three worlds at once. To adorn the body is to carry the cosmos, oriented.',
    es: 'Meli Witran Mapu',
  },
  {
    chapter: 'XII · The cosmic code',
    eyebrow: 'The spiral within',
    eyebrowClass: 'teal',
    heading: 'At the center of the body:<br>the same spiral as the sky',
    body: 'The strand that writes every living thing turns like a galaxy, coils like a serpent, rises like smoke. The ancestors read the spiral in the stars before we found it in the cell.',
  },
  {
    chapter: 'XIII · Itrofill Mongen — you are seen',
    eyebrow: 'The net of eyes',
    eyebrowClass: 'ame',
    heading: 'You were never<br>watching alone',
    body: 'Itrofill Mongen — all life, whole and interwoven. The Ngen — spirits of water, forest and stone — are watching. The cosmos looks back at you through a thousand eyes.',
  },
  {
    chapter: 'XIV · Miñche Mapu — the return',
    eyebrow: 'The source, again',
    heading: 'All that spirals out<br>spirals home',
    body: 'The whirlpool takes the sun, the stars, the body, the name — everything returns to the still center, the great mystery. And from the nothing, it all begins again.',
    es: 'Wenu mapu ñi kimün',
  },
];
---

<section id="ms3d" class="ms3d" aria-label="The manifesto — a cosmic journey">
  <p class="visually-hidden">
    A visionary journey through Mapuche cosmology: Wenu Mapu, the sky-world and
    its sun, the ancestors' road of stars, the moon, Nag Mapu the living earth,
    descending through the four forces — fire, wind, water, stone — to the
    kultrún as a map of the universe, the cosmic double helix at the center, a
    toroidal net of eyes that watches back, and Miñche Mapu — the whirlpool
    that returns everything to the still center, to nothing, to begin again.
  </p>

  {/* DEFAULT — the existing hand-coded SVG spiral. Untouched. Visible unless
      the inline capability check below decides the device can run the 3D. */}
  <div id="ms3d-poster" class="ms3d-poster">
    <ManifestoSpiral />
  </div>

  {/* ENHANCED — WebGL journey + real HTML station text. `hidden` until JS
      confirms the device qualifies (see the is:inline script). */}
  <div id="ms3d-enhanced" class="ms3d-enhanced" hidden>
    <canvas id="ms3d-webgl" class="ms3d-webgl" aria-hidden="true"></canvas>
    <div class="ms3d-vignette" aria-hidden="true"></div>
    <div id="ms3d-void" class="ms3d-void" aria-hidden="true"></div>
    <div id="ms3d-voidword" class="ms3d-voidword" aria-hidden="true">· nothing · everything ·</div>
    <div id="ms3d-rail" class="ms3d-rail" aria-hidden="true"></div>
    <div id="ms3d-chapter" class="ms3d-chapter" aria-hidden="true"></div>
    <p class="ms3d-hint" aria-hidden="true">Scroll slowly — from Wenu Mapu to the world below</p>
    <div id="ms3d-loading" class="ms3d-loading" aria-hidden="true">Opening the eye of the sky…</div>

    <main id="ms3d-stations" class="ms3d-stations">
      {STATIONS.map((s) => (
        <section class="ms3d-station" data-chapter={s.chapter}>
          <div class="ms3d-reveal">
            <p class:list={['ms3d-eyebrow', s.eyebrowClass && `ms3d-eyebrow--${s.eyebrowClass}`]}>{s.eyebrow}</p>
            {s.hero
              ? <h2 class="ms3d-heading ms3d-heading--hero" set:html={s.heading} />
              : <h2 class="ms3d-heading" set:html={s.heading} />}
            {s.lede && <p class="ms3d-lede">{s.lede}</p>}
            {s.body && (
              <p class="ms3d-body">
                {s.body}
                {s.es && <span class="ms3d-es" lang="arn">{s.es}</span>}
              </p>
            )}
            {s.phase && <p class="ms3d-phase">{s.phase}</p>}
          </div>
        </section>
      ))}
    </main>
  </div>
</section>

{/* Cheap, synchronous, BEFORE the heavy engine: decides once whether this
    device qualifies for 3D, and flips the two blocks' visibility immediately
    (no Three.js loaded yet — just a WebGL context probe). Runs at parse time
    (classic inline script), before the deferred module below and before the
    user is likely to have scrolled — avoids a visible layout jump.

    IMPORTANT (fixed 2026-07-18, owner catch): the SVG fallback is for
    devices that genuinely CAN'T run this — no WebGL, prefers-reduced-motion,
    or a truly tiny viewport (<360px). hardwareConcurrency/deviceMemory do
    NOT gate the fallback — low core counts are common and harmless (VMs,
    some laptops, browser previews) and would wrongly hide the 3D from
    perfectly capable machines. Those two signals only pick a lower-quality
    PRESET (fewer particles/segments, lower DPR, half-res bloom) via the
    existing `mobile` branches inside the engine — see __ms3dLowPerf below. */}
<script is:inline>
(function () {
  function ms3dCapable() {
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
      if (innerWidth < 360) return false;
      var probe = document.createElement('canvas');
      var gl = probe.getContext('webgl2') || probe.getContext('webgl');
      if (!gl) return false;
      return true;
    } catch (e) {
      return false;
    }
  }
  function ms3dLowPerf() {
    try {
      var nav = navigator;
      return !!((nav.deviceMemory && nav.deviceMemory < 4) || (nav.hardwareConcurrency && nav.hardwareConcurrency <= 2));
    } catch (e) {
      return false;
    }
  }
  var ok = ms3dCapable();
  window.__ms3dCapable = ok;
  window.__ms3dLowPerf = ms3dLowPerf();
  if (ok) {
    var poster = document.getElementById('ms3d-poster');
    var enhanced = document.getElementById('ms3d-enhanced');
    if (poster) poster.hidden = true;
    if (enhanced) enhanced.hidden = false;
  }
})();
</script>

{/* Heavy engine — lazy, gated. Astro bundles this as a module via Vite, so
    the dynamic import()s below are code-split into their own chunks and are
    only fetched over the network once loadEngine() actually runs (never, for
    reduced-motion / no-WebGL / low-end visitors — window.__ms3dCapable is
    false and this whole block short-circuits at the top). */}
<script>
  const section = document.getElementById('ms3d');
  const enhanced = document.getElementById('ms3d-enhanced');

  if (section && enhanced && (window as any).__ms3dCapable) {
    let engine: { pause: () => void; resume: () => void; dispose: () => void } | null = null;
    let loading = false;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            enhanced.classList.add('is-active');
            if (engine) engine.resume();
            else if (!loading) {
              loading = true;
              loadEngine().finally(() => {
                loading = false;
              });
            }
          } else {
            enhanced.classList.remove('is-active');
            if (engine) engine.pause();
          }
        }
      },
      { threshold: 0 }
    );
    io.observe(section);

    window.addEventListener('pagehide', () => {
      io.disconnect();
      engine?.dispose();
    });

    async function loadEngine() {
      // `mobile` doubles as the quality PRESET switch (segments, particle
      // counts, DPR cap, bloom resolution — all the existing branches below).
      // A small/narrow viewport forces it; a weak-but-wide device (low core
      // count or <4GB reported memory) also gets the lighter preset, without
      // ever being denied the 3D itself (that gate lives in the is:inline
      // script above and does NOT look at hardwareConcurrency/deviceMemory).
      const lowPerf = (window as any).__ms3dLowPerf === true;
      const mobile = innerWidth < 760 || lowPerf;
      const [THREE, { EffectComposer }, { RenderPass }, { UnrealBloomPass }, { ShaderPass }, { OutputPass }, gsapMod, stMod, lenisMod] =
        await Promise.all([
          import('three'),
          import('three/addons/postprocessing/EffectComposer.js'),
          import('three/addons/postprocessing/RenderPass.js'),
          import('three/addons/postprocessing/UnrealBloomPass.js'),
          import('three/addons/postprocessing/ShaderPass.js'),
          import('three/addons/postprocessing/OutputPass.js'),
          import('gsap'),
          import('gsap/ScrollTrigger'),
          import('lenis'),
        ]);
      const gsap = (gsapMod as any).gsap || (gsapMod as any).default;
      const ScrollTrigger = (stMod as any).ScrollTrigger || (stMod as any).default;
      const Lenis = (lenisMod as any).default;
      engine = buildEngine({ THREE, EffectComposer, RenderPass, UnrealBloomPass, ShaderPass, OutputPass, gsap, ScrollTrigger, Lenis, mobile });
    }

    function buildEngine({
      THREE,
      EffectComposer,
      RenderPass,
      UnrealBloomPass,
      ShaderPass,
      OutputPass,
      gsap,
      ScrollTrigger,
      Lenis,
      mobile,
    }: any) {
      const SEG = mobile ? 28 : 56;
      const C = { obsidian: 0x07070c, bone: 0xf0ede8, ember: 0xc9a84c, teal: 0x64e0d0, amethyst: 0x9a7ee0, silver: 0xb8b4aa };
      const L = THREE.MathUtils.lerp;
      const rand = (a: number, b: number) => a + Math.random() * (b - a);

      const canvas = document.getElementById('ms3d-webgl') as HTMLCanvasElement;
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: !mobile, powerPreference: 'high-performance' });
      renderer.setPixelRatio(Math.min(devicePixelRatio, mobile ? 1.75 : 2));
      renderer.setClearColor(C.obsidian, 1);
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      // cinema: NEUTRAL tone mapping (Khronos PBR Neutral) — gently rolls off the
      // brightest highlights WITHOUT crushing the mid/low emissive scenes (DNA, eye
      // net) the way AgX/ACES do; the scene's emissive values were tuned for ~linear
      renderer.toneMapping = THREE.NeutralToneMapping;
      renderer.toneMappingExposure = 1.05;

      const scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(C.obsidian, 0.0034);
      const camera = new THREE.PerspectiveCamera(60, innerWidth / innerHeight, 0.1, 2200);

      const sprite = (() => {
        const c = document.createElement('canvas');
        c.width = c.height = 64;
        const x = c.getContext('2d')!;
        const g = x.createRadialGradient(32, 32, 0, 32, 32, 32);
        g.addColorStop(0, '#fff');
        g.addColorStop(0.4, 'rgba(255,255,255,.55)');
        g.addColorStop(1, 'rgba(255,255,255,0)');
        x.fillStyle = g;
        x.fillRect(0, 0, 64, 64);
        return new THREE.CanvasTexture(c);
      })();
      const pts = (geo: any, { size = 0.5, opacity = 1, color = null as any, vertexColors = false }) =>
        new THREE.Points(
          geo,
          new THREE.PointsMaterial({
            size,
            map: sprite,
            transparent: true,
            depthWrite: false,
            blending: THREE.AdditiveBlending,
            sizeAttenuation: true,
            opacity,
            vertexColors,
            ...(color != null ? { color } : {}),
          })
        );

      // ── sacred-geometry mandala (Flower of Life + Sri Yantra hint) ───────
      function mandala(px: number, hex: string) {
        const c = document.createElement('canvas');
        c.width = c.height = px;
        const x = c.getContext('2d')!;
        x.translate(px / 2, px / 2);
        x.strokeStyle = hex;
        x.lineWidth = Math.max(1, px / 640);
        x.lineJoin = 'round';
        const R = px * 0.085,
          seeds: [number, number][] = [[0, 0]];
        for (let k = 0; k < 6; k++) {
          const a = (k * Math.PI) / 3;
          seeds.push([Math.cos(a) * R, Math.sin(a) * R]);
        }
        for (let k = 0; k < 6; k++) {
          const a = (k * Math.PI) / 3;
          seeds.push([Math.cos(a) * R * 2, Math.sin(a) * R * 2]);
        }
        for (let k = 0; k < 6; k++) {
          const a = (k * Math.PI) / 3 + Math.PI / 6,
            d = R * Math.sqrt(3);
          seeds.push([Math.cos(a) * d, Math.sin(a) * d]);
        }
        x.globalAlpha = 0.5;
        for (const [ax, ay] of seeds) {
          x.beginPath();
          x.arc(ax, ay, R, 0, 6.283);
          x.stroke();
        }
        x.globalAlpha = 0.85;
        for (const rr of [R * 2, R * 3, R * 3.5]) {
          x.beginPath();
          x.arc(0, 0, rr, 0, 6.283);
          x.stroke();
        }
        x.globalAlpha = 0.3;
        for (let k = 0; k < 24; k++) {
          const a = (k * Math.PI) / 12;
          x.beginPath();
          x.moveTo(Math.cos(a) * R * 1.2, Math.sin(a) * R * 1.2);
          x.lineTo(Math.cos(a) * R * 3.5, Math.sin(a) * R * 3.5);
          x.stroke();
        }
        x.globalAlpha = 0.55;
        const tri = (rot: number) => {
          x.beginPath();
          for (let k = 0; k < 3; k++) {
            const a = rot + (k * 2 * Math.PI) / 3,
              tx = Math.cos(a) * R * 2.7,
              ty = Math.sin(a) * R * 2.7;
            k ? x.lineTo(tx, ty) : x.moveTo(tx, ty);
          }
          x.closePath();
          x.stroke();
        };
        tri(-Math.PI / 2);
        tri(Math.PI / 2);
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        return t;
      }
      function mandalaPlane(size: number, texColor: string, tint: any, opacity: number) {
        const m = new THREE.Mesh(
          new THREE.PlaneGeometry(size, size),
          new THREE.MeshBasicMaterial({
            map: mandala(mobile ? 512 : 1024, texColor),
            color: tint,
            transparent: true,
            opacity,
            blending: THREE.AdditiveBlending,
            depthWrite: false,
          })
        );
        scene.add(m);
        return m;
      }
      function fresnelMat(color: number, power: number, scaleV: number) {
        return new THREE.ShaderMaterial({
          uniforms: { glow: { value: new THREE.Color(color) }, p: { value: power }, s: { value: scaleV } },
          vertexShader: `varying float i; uniform float p; uniform float s;
            void main(){ vec3 n=normalize(normalMatrix*normal); vec3 v=normalize((modelViewMatrix*vec4(position,1.0)).xyz);
            i=pow(clamp(s - dot(n,-v),0.0,1.0),p); gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}`,
          fragmentShader: `varying float i; uniform vec3 glow; void main(){ gl_FragColor=vec4(glow,1.0)*i; }`,
          blending: THREE.AdditiveBlending,
          transparent: true,
          depthWrite: false,
          side: THREE.BackSide,
        });
      }

      // ── world Y map ────────────────────────────────────────────────────────
      const SUN_Y = 320,
        PLANET_Y = 228,
        MARS_Y = 182,
        MOON_Y = 140,
        EARTH_Y = 104;
      const PLASMA = [40, 84],
        GAS = [-8, 38],
        LIQUID = [-60, -12],
        SOLID = [-108, -64];
      const KULTRUN_Y = -134,
        DNA_TOP = -164,
        DNA_BOT = -256,
        EYES_C = -290,
        BH_Y = -338,
        CAM_BOT = -352;
      const SUN_R = 34,
        EARTH_R = 15;

      // ── LIGHTS — key + rim, so every body has a real terminator ─────────────
      scene.add(new THREE.AmbientLight(0x161f2e, 0.34));
      const sunLight = new THREE.PointLight(0xfff0d0, 2.0, 1700, 0.4);
      sunLight.position.set(0, SUN_Y, 0);
      scene.add(sunLight);
      const keyLight = new THREE.DirectionalLight(0xffe7c4, 1.5);
      keyLight.position.set(0.55, 0.9, 0.4);
      scene.add(keyLight);
      const rimLight = new THREE.DirectionalLight(0x6f5fb0, 0.7);
      rimLight.position.set(-0.6, -0.35, -0.55);
      scene.add(rimLight);
      // dedicated fill lights for the deep scenes (DNA ribbon + net of eyes) so the MeshStandard elements read
      const dnaFill = new THREE.PointLight(0xbcd0ff, 1.8, 240, 1.0);
      dnaFill.position.set(34, -205, 50);
      scene.add(dnaFill);
      const eyesFill = new THREE.PointLight(0x9fb4e0, 1.2, 200, 1.0);
      eyesFill.position.set(0, -286, 60);
      scene.add(eyesFill);

      // ── starfield ─────────────────────────────────────────────────────────
      let stars: any;
      (function () {
        const N = mobile ? 1500 : 3000,
          a = new Float32Array(N * 3),
          col = new Float32Array(N * 3),
          t = new THREE.Color(),
          cB = new THREE.Color(C.bone),
          cA = new THREE.Color(C.amethyst);
        for (let i = 0; i < N; i++) {
          const r = 320 + Math.random() * 560,
            th = Math.random() * 6.283,
            ph = Math.acos(2 * Math.random() - 1);
          a[i * 3] = r * Math.sin(ph) * Math.cos(th);
          a[i * 3 + 1] = (SUN_Y + BH_Y) / 2 + r * Math.cos(ph) * 0.8;
          a[i * 3 + 2] = r * Math.sin(ph) * Math.sin(th);
          const rr = Math.random(); // spectral classes — mostly dim, a few bright blue/gold/red
          if (rr < 0.05) t.setRGB(0.6, 0.74, 1.0);
          else if (rr < 0.12) t.setRGB(1.0, 0.97, 0.88);
          else if (rr < 0.22) t.setRGB(1.0, 0.82, 0.52);
          else if (rr < 0.28) t.setRGB(1.0, 0.62, 0.5);
          else t.copy(cB).lerp(cA, Math.random() * 0.5);
          col[i * 3] = t.r;
          col[i * 3 + 1] = t.g;
          col[i * 3 + 2] = t.b;
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.BufferAttribute(a, 3));
        g.setAttribute('color', new THREE.BufferAttribute(col, 3));
        stars = pts(g, { size: 1.0, vertexColors: true, opacity: 0.7 });
        scene.add(stars);
      })();

      // ── nebulae (soft additive clouds) + a distant spiral galaxy ─────────────
      let galaxy: any;
      (function () {
        const nebulaTex = (hex: string) => {
          const s = 256,
            c = document.createElement('canvas');
          c.width = c.height = s;
          const x = c.getContext('2d')!;
          x.fillStyle = '#000';
          x.fillRect(0, 0, s, s);
          for (let i = 0; i < 110; i++) {
            const px = Math.random() * s,
              py = Math.random() * s,
              r = 10 + Math.random() * 46,
              gr = x.createRadialGradient(px, py, 0, px, py, r);
            gr.addColorStop(0, hex + '26');
            gr.addColorStop(1, 'rgba(0,0,0,0)');
            x.fillStyle = gr;
            x.beginPath();
            x.arc(px, py, r, 0, 6.283);
            x.fill();
          }
          const tx = new THREE.CanvasTexture(c);
          tx.colorSpace = THREE.SRGBColorSpace;
          return tx;
        };
        const nebs: [string, number, number, number, number][] = [
          ['#3f7fd0', 360, -120, 60, -560],
          ['#9a7ee0', 420, 420, -160, -620],
          ['#64e0d0', 280, -460, -80, -500],
          ['#c9a84c', 240, 300, 240, -540],
          ['#7a3ea8', 380, -40, -360, -660],
          ['#9a7ee0', 400, -140, -190, -470], // extra nebulae for atmospheric depth in the deep scenes
          ['#64e0d0', 360, 300, -250, -430],
          ['#4a6cc8', 440, 120, -110, -640],
          ['#7a3ea8', 320, -280, -320, -560],
        ];
        nebs.forEach(([hex, sz, px, py, pz]) => {
          const m = new THREE.Mesh(
            new THREE.PlaneGeometry(sz, sz),
            new THREE.MeshBasicMaterial({ map: nebulaTex(hex), transparent: true, opacity: 0.5, blending: THREE.AdditiveBlending, depthWrite: false, fog: false })
          );
          m.position.set(px, py, pz);
          m.lookAt(0, py * 0.4, 0);
          scene.add(m);
        });
        // spiral galaxy (reimplemented technique: particles on tight log-spiral
        // arms + dense bright bulge, colour lerp warm core -> cool rim)
        const N = mobile ? 3000 : 6000,
          a = new Float32Array(N * 3),
          col = new Float32Array(N * 3),
          t = new THREE.Color(),
          cCore = new THREE.Color(0xfff2d8),
          cMid = new THREE.Color(0xe0c6ff),
          cOut = new THREE.Color(0x5a7ad8),
          arms = 2,
          spin = 6.2,
          R = 180;
        for (let i = 0; i < N; i++) {
          let x, y, z, u;
          if (i % 5 === 0) {
            const br = Math.pow(Math.random(), 2.2) * R * 0.28,
              ph = Math.random() * 6.283,
              el = (Math.random() - 0.5) * R * 0.14;
            x = Math.cos(ph) * br;
            z = Math.sin(ph) * br;
            y = el;
            u = br / R;
          } else {
            const rad = Math.pow(Math.random(), 0.6) * R,
              arm = ((i % arms) / arms) * 6.283,
              ang = arm + (rad * spin) / R,
              spread = (0.05 + (0.14 * rad) / R) * R,
              rp = (Math.random() - 0.5) * spread,
              rz = (Math.random() - 0.5) * spread;
            x = Math.cos(ang) * rad + rp;
            z = Math.sin(ang) * rad + rz;
            y = (Math.random() - 0.5) * R * 0.04;
            u = rad / R;
          }
          a[i * 3] = x;
          a[i * 3 + 1] = y;
          a[i * 3 + 2] = z;
          t.copy(cCore)
            .lerp(cMid, Math.min(1, u * 1.6))
            .lerp(cOut, Math.min(1, Math.max(0, (u - 0.4) / 0.6)));
          col[i * 3] = t.r;
          col[i * 3 + 1] = t.g;
          col[i * 3 + 2] = t.b;
        }
        const gg = new THREE.BufferGeometry();
        gg.setAttribute('position', new THREE.BufferAttribute(a, 3));
        gg.setAttribute('color', new THREE.BufferAttribute(col, 3));
        galaxy = new THREE.Points(
          gg,
          new THREE.PointsMaterial({ size: 2.1, map: sprite, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending, sizeAttenuation: false, opacity: 0.9, vertexColors: true, fog: false })
        );
        galaxy.position.set(-540, 150, -880);
        galaxy.rotation.set(1.12, 0.35, 0.35);
        scene.add(galaxy);
      })();

      // ── procedural textures ──────────────────────────────────────────────────
      function sunTexture() {
        const s = 512,
          c = document.createElement('canvas');
        c.width = c.height = s;
        const x = c.getContext('2d')!;
        x.fillStyle = '#ffae3a';
        x.fillRect(0, 0, s, s);
        for (let i = 0; i < 1800; i++) {
          const bx = Math.random() * s,
            by = Math.random() * s,
            r = 2 + Math.random() * 11,
            b = Math.random();
          const g = x.createRadialGradient(bx, by, 0, bx, by, r);
          g.addColorStop(0, b > 0.72 ? 'rgba(255,252,225,.95)' : 'rgba(255,206,96,.7)');
          g.addColorStop(1, 'rgba(255,150,40,0)');
          x.fillStyle = g;
          x.fillRect(bx - r, by - r, r * 2, r * 2);
        }
        for (let i = 0; i < 9; i++) {
          const bx = Math.random() * s,
            by = Math.random() * s,
            r = 6 + Math.random() * 15;
          x.fillStyle = 'rgba(150,66,18,.5)';
          x.beginPath();
          x.arc(bx, by, r, 0, 6.283);
          x.fill();
        }
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        return t;
      }
      function bandedTexture() {
        const w = 512,
          h = 256,
          c = document.createElement('canvas');
        c.width = w;
        c.height = h;
        const x = c.getContext('2d')!;
        let y = 0;
        while (y < h) {
          const bh = 5 + Math.random() * 20,
            sh = Math.random();
          x.fillStyle = sh > 0.66 ? '#d9b98a' : sh > 0.33 ? '#b98a5c' : '#9c7048';
          x.fillRect(0, y, w, bh);
          x.globalAlpha = 0.12;
          x.fillStyle = '#fff';
          if (Math.random() > 0.6) x.fillRect(0, y, w, bh * 0.4);
          x.globalAlpha = 1;
          y += bh;
        }
        x.fillStyle = 'rgba(178,74,46,.85)';
        x.beginPath();
        x.ellipse(w * 0.66, h * 0.62, 30, 17, 0, 0, 6.283);
        x.fill();
        x.fillStyle = 'rgba(210,120,80,.4)';
        x.beginPath();
        x.ellipse(w * 0.66, h * 0.62, 20, 10, 0, 0, 6.283);
        x.fill();
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        return t;
      }
      function marsTexture() {
        const s = 512,
          c = document.createElement('canvas');
        c.width = c.height = s;
        const x = c.getContext('2d')!;
        x.fillStyle = '#a8482a';
        x.fillRect(0, 0, s, s);
        for (let i = 0; i < 60; i++) {
          const bx = Math.random() * s,
            by = Math.random() * s,
            r = 8 + Math.random() * 46;
          x.fillStyle = `rgba(${(90 + Math.random() * 40) | 0},${(40 + Math.random() * 20) | 0},20,.35)`;
          x.beginPath();
          x.arc(bx, by, r, 0, 6.283);
          x.fill();
        }
        x.fillStyle = 'rgba(240,235,230,.9)';
        x.beginPath();
        x.arc(s / 2, 20, 40, 0, 6.283);
        x.fill();
        x.beginPath();
        x.arc(s / 2, s - 20, 34, 0, 6.283);
        x.fill();
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        return t;
      }
      function moonTexture() {
        const s = 512,
          c = document.createElement('canvas');
        c.width = c.height = s;
        const x = c.getContext('2d')!;
        x.fillStyle = '#9a9a9a';
        x.fillRect(0, 0, s, s);
        for (let i = 0; i < 10; i++) {
          const bx = Math.random() * s,
            by = Math.random() * s,
            r = 30 + Math.random() * 70;
          x.fillStyle = 'rgba(120,120,124,.5)';
          x.beginPath();
          x.arc(bx, by, r, 0, 6.283);
          x.fill();
        }
        for (let i = 0; i < 90; i++) {
          const bx = Math.random() * s,
            by = Math.random() * s,
            r = 2 + Math.random() * 13;
          x.fillStyle = `rgba(70,70,72,${0.2 + Math.random() * 0.35})`;
          x.beginPath();
          x.arc(bx, by, r, 0, 6.283);
          x.fill();
        }
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        return t;
      }
      function earthTexture() {
        const c = document.createElement('canvas');
        c.width = 1024;
        c.height = 512;
        const x = c.getContext('2d')!;
        const og = x.createLinearGradient(0, 0, 0, 512);
        og.addColorStop(0, '#0a3a5c');
        og.addColorStop(0.5, '#0f5a82');
        og.addColorStop(1, '#0a3a5c');
        x.fillStyle = og;
        x.fillRect(0, 0, 1024, 512);
        const blob = (cx: number, cy: number, r: number, color: string) => {
          x.fillStyle = color;
          x.beginPath();
          for (let a = 0; a < 6.283; a += 0.24) {
            const rr = r * (0.55 + Math.random() * 0.6),
              pxp = cx + Math.cos(a) * rr,
              pyp = cy + Math.sin(a) * rr * 0.7;
            a === 0 ? x.moveTo(pxp, pyp) : x.lineTo(pxp, pyp);
          }
          x.closePath();
          x.fill();
        };
        const greens = ['#3a7d42', '#4a8f4e', '#6b8f3a', '#7a7538', '#356b3a'];
        for (let i = 0; i < 32; i++) blob(Math.random() * 1024, 120 + Math.random() * 280, 26 + Math.random() * 80, greens[i % greens.length]);
        x.fillStyle = 'rgba(244,248,252,.95)';
        x.fillRect(0, 0, 1024, 38);
        x.fillRect(0, 474, 1024, 38);
        x.globalAlpha = 0.1;
        x.fillStyle = '#fff';
        for (let i = 0; i < 34; i++) blob(Math.random() * 1024, Math.random() * 512, 16 + Math.random() * 40, '#fff');
        x.globalAlpha = 1;
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        return t;
      }
      // authentic kultrún drumhead — audited pass: 4-direction cross from the
      // east, choike/ñandú three-toed terminals (the signature kultrún foot),
      // and the four quadrant motifs each centered on its diagonal: Antü the
      // sun (rays), Küyen the crescent moon, Melipal the Southern Cross (four
      // stars), Wüñelfe the eight-point morning star.
      function kultrunTexture() {
        const s = 512,
          c = document.createElement('canvas');
        c.width = c.height = s;
        const x = c.getContext('2d')!;
        x.translate(s / 2, s / 2);
        const R = 6.283;
        x.fillStyle = '#0d0a07';
        x.beginPath();
        x.arc(0, 0, s * 0.47, 0, R);
        x.fill(); // leather membrane
        x.strokeStyle = '#c9a84c';
        x.fillStyle = '#c9a84c';
        x.globalAlpha = 0.97;
        x.lineCap = 'round';
        x.lineJoin = 'round';
        x.lineWidth = 7;
        x.beginPath();
        x.arc(0, 0, s * 0.45, 0, R);
        x.stroke(); // rim
        const arm = s * 0.37;
        x.lineWidth = 9;
        x.beginPath();
        x.moveTo(-arm, 0);
        x.lineTo(arm, 0);
        x.moveTo(0, -arm);
        x.lineTo(0, arm);
        x.stroke(); // 4-direction cross (from the east)
        // choike (ñandú) three-toed feet at each cardinal end — the signature kultrún terminal
        x.lineWidth = 6;
        const foot = (ang: number) => {
          x.save();
          x.rotate(ang);
          const b = arm,
            tp = s * 0.455;
          x.beginPath();
          x.moveTo(b, 0);
          x.lineTo(tp, 0);
          x.moveTo(b, 0);
          x.lineTo(tp * 0.97, -s * 0.085);
          x.moveTo(b, 0);
          x.lineTo(tp * 0.97, s * 0.085);
          x.stroke();
          x.restore();
        };
        for (let k = 0; k < 4; k++) foot((k * Math.PI) / 2);
        x.lineWidth = 3;
        x.beginPath();
        x.arc(0, 0, s * 0.13, 0, R);
        x.stroke(); // inner circle — centre of the world
        x.strokeStyle = '#e8c766';
        x.fillStyle = '#e8c766';
        const q = s * 0.215; // mid-quadrant, on the diagonals (nudged toward centre)
        // Antü — the sun (upper-right / east): disc + rays
        ((cx: number, cy: number, r: number) => {
          x.lineWidth = 4;
          x.beginPath();
          x.arc(cx, cy, r * 0.42, 0, R);
          x.fill();
          for (let k = 0; k < 12; k++) {
            const a = (k * R) / 12;
            x.beginPath();
            x.moveTo(cx + Math.cos(a) * r * 0.55, cy + Math.sin(a) * r * 0.55);
            x.lineTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r);
            x.stroke();
          }
        })(q, -q, 30);
        // Küyen — the moon (upper-left): filled crescent
        ((cx: number, cy: number, r: number) => {
          x.beginPath();
          x.arc(cx, cy, r, Math.PI * 0.5, Math.PI * 1.5, false);
          x.arc(cx + r * 0.55, cy, r * 0.92, Math.PI * 1.5, Math.PI * 0.5, true);
          x.closePath();
          x.fill();
        })(-q, -q, 26);
        // Melipal — the Southern Cross (lower-left): four stars
        ((cx: number, cy: number) => {
          const points: [number, number][] = [
            [0, -22],
            [0, 16],
            [-14, -2],
            [13, 4],
          ];
          for (const [dx, dy] of points) {
            x.beginPath();
            x.arc(cx + dx, cy + dy, 3.4, 0, R);
            x.fill();
            x.lineWidth = 2;
            for (let k = 0; k < 4; k++) {
              const a = (k * Math.PI) / 2;
              x.beginPath();
              x.moveTo(cx + dx, cy + dy);
              x.lineTo(cx + dx + Math.cos(a) * 6, cy + dy + Math.sin(a) * 6);
              x.stroke();
            }
          }
        })(-q, q);
        // Wüñelfe — the morning star (lower-right): eight-point star
        ((cx: number, cy: number, r: number) => {
          x.lineWidth = 4;
          for (let k = 0; k < 8; k++) {
            const a = (k * R) / 8,
              len = k % 2 ? r * 0.5 : r;
            x.beginPath();
            x.moveTo(cx, cy);
            x.lineTo(cx + Math.cos(a) * len, cy + Math.sin(a) * len);
            x.stroke();
          }
          x.beginPath();
          x.arc(cx, cy, 3.6, 0, R);
          x.fill();
        })(q, q, 24);
        x.fillStyle = '#f0ede8';
        x.beginPath();
        x.arc(0, 0, 9, 0, R);
        x.fill(); // centre — the world / the machi's land
        const t = new THREE.CanvasTexture(c);
        t.colorSpace = THREE.SRGBColorSpace;
        return t;
      }

      // ── THE SUN — Wenu Mapu / the source ─────────────────────────────────────
      const sun = new THREE.Mesh(new THREE.SphereGeometry(SUN_R, SEG, SEG), new THREE.MeshBasicMaterial({ map: sunTexture() }));
      sun.position.set(0, SUN_Y, 0);
      scene.add(sun);
      const sunGlow = new THREE.Mesh(new THREE.SphereGeometry(SUN_R * 1.14, SEG, SEG), fresnelMat(0xffcf70, 3.0, 1.0));
      sunGlow.position.copy(sun.position);
      scene.add(sunGlow);
      (function () {
        const N = mobile ? 1200 : 2200,
          a = new Float32Array(N * 3),
          col = new Float32Array(N * 3),
          c1 = new THREE.Color(0xffe19a),
          c2 = new THREE.Color(C.ember),
          t = new THREE.Color();
        for (let i = 0; i < N; i++) {
          const r = SUN_R + Math.pow(Math.random(), 2) * 54,
            th = Math.random() * 6.283,
            ph = Math.acos(2 * Math.random() - 1);
          a[i * 3] = r * Math.sin(ph) * Math.cos(th);
          a[i * 3 + 1] = SUN_Y + r * Math.cos(ph);
          a[i * 3 + 2] = r * Math.sin(ph) * Math.sin(th);
          t.copy(c1).lerp(c2, Math.random());
          col[i * 3] = t.r;
          col[i * 3 + 1] = t.g;
          col[i * 3 + 2] = t.b;
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.BufferAttribute(a, 3));
        g.setAttribute('color', new THREE.BufferAttribute(col, 3));
        scene.add(pts(g, { size: 1.5, vertexColors: true, opacity: 0.9 }));
      })();
      const proms = new THREE.Group();
      proms.position.copy(sun.position);
      scene.add(proms);
      for (let i = 0; i < (mobile ? 4 : 6); i++) {
        const tm = new THREE.Mesh(
          new THREE.TorusGeometry(SUN_R * 0.5, SUN_R * 0.028, 8, 44, Math.PI * rand(0.5, 0.9)),
          new THREE.MeshBasicMaterial({ color: 0xff9a3c, transparent: true, opacity: 0.7, blending: THREE.AdditiveBlending })
        );
        tm.position.set(0, SUN_R * 0.92, 0);
        const piv = new THREE.Group();
        piv.rotation.set(rand(0, 6.28), rand(0, 6.28), rand(0, 6.28));
        piv.add(tm);
        (piv.userData as any).ph = rand(0, 6.28);
        proms.add(piv);
      }
      const mandalaSun = mandalaPlane(SUN_R * 7.5, '#ffe6a8', new THREE.Color(0xffd070), 0.26);
      mandalaSun.position.copy(sun.position);

      // ── PLANETS + MOON (lit for contrast) ─────────────────────────────────
      const gasGiant = new THREE.Mesh(new THREE.SphereGeometry(16, SEG, SEG), new THREE.MeshStandardMaterial({ map: bandedTexture(), roughness: 0.95, metalness: 0.0 }));
      gasGiant.position.set(13, PLANET_Y, -8);
      gasGiant.rotation.z = 0.18;
      scene.add(gasGiant);
      (function () {
        const ring = new THREE.Mesh(
          new THREE.RingGeometry(20, 30, 72),
          new THREE.MeshBasicMaterial({ color: 0xe0c79c, transparent: true, opacity: 0.4, side: THREE.DoubleSide, blending: THREE.AdditiveBlending })
        );
        ring.position.copy(gasGiant.position);
        ring.rotation.x = Math.PI * 0.42;
        ring.rotation.y = 0.3;
        scene.add(ring);
      })();
      const mars = new THREE.Mesh(new THREE.SphereGeometry(8, SEG, SEG), new THREE.MeshStandardMaterial({ map: marsTexture(), roughness: 1, metalness: 0 }));
      mars.position.set(-14, MARS_Y, 6);
      scene.add(mars);
      const moon = new THREE.Mesh(new THREE.SphereGeometry(5.4, SEG, SEG), new THREE.MeshStandardMaterial({ map: moonTexture(), roughness: 1, metalness: 0 }));
      moon.position.set(16, MOON_Y, 7);
      scene.add(moon);

      // ── THE EARTH — Nag Mapu ───────────────────────────────────────────────
      const earth = new THREE.Mesh(
        new THREE.SphereGeometry(EARTH_R, SEG, SEG),
        new THREE.MeshStandardMaterial({ map: earthTexture(), roughness: 0.9, metalness: 0.02, emissive: 0x08203a, emissiveIntensity: 0.22 })
      );
      earth.position.set(0, EARTH_Y, 0);
      scene.add(earth);
      const earthAtmo = new THREE.Mesh(new THREE.SphereGeometry(EARTH_R * 1.09, SEG, SEG), fresnelMat(0x7fc4ec, 3.4, 1.0));
      earthAtmo.position.copy(earth.position);
      scene.add(earthAtmo);

      // ── connective spiral thread (earth -> into DNA) ──────────────────────
      (function () {
        const N = mobile ? 5000 : 9000,
          a = new Float32Array(N * 3),
          col = new Float32Array(N * 3);
        const top = EARTH_Y - 18,
          bot = DNA_TOP + 4,
          turns = 8,
          cE = new THREE.Color(C.ember),
          cT = new THREE.Color(C.teal),
          cA = new THREE.Color(C.amethyst),
          cB = new THREE.Color(C.bone),
          t = new THREE.Color();
        for (let i = 0; i < N; i++) {
          const u = i / N,
            y = L(top, bot, u),
            rad = 3 + 16 * Math.pow(1 - u, 0.7),
            strand = i % 3;
          let ang = u * turns * 6.283 + (strand === 1 ? Math.PI : 0),
            r = rad;
          if (strand === 2) {
            r = rad * (0.3 + Math.random() * 1.1);
            ang += (Math.random() - 0.5) * 1.2;
          } else {
            r += (Math.random() - 0.5) * 1.6;
          }
          a[i * 3] = Math.cos(ang) * r;
          a[i * 3 + 1] = y + (strand === 2 ? (Math.random() - 0.5) * 5 : 0);
          a[i * 3 + 2] = Math.sin(ang) * r;
          t.copy(strand === 1 ? cT : cE)
            .lerp(cA, Math.pow(u, 2) * 0.4)
            .lerp(cB, Math.pow(u, 1.6) * 0.3);
          col[i * 3] = t.r;
          col[i * 3 + 1] = t.g;
          col[i * 3 + 2] = t.b;
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.BufferAttribute(a, 3));
        g.setAttribute('color', new THREE.BufferAttribute(col, 3));
        scene.add(pts(g, { size: 0.55, vertexColors: true, opacity: 0.9 }));
      })();

      // ── states of matter (Kütral · Kürüf · Ko · Kura) ─────────────────────
      function cloudPts(n: number, fn: (i: number) => any, color: any, { size = 0.6, opacity = 0.8, vc = false } = {}) {
        const arr = new Float32Array(n * 3),
          carr = vc ? new Float32Array(n * 3) : null,
          base = new THREE.Color(color),
          t = new THREE.Color();
        for (let i = 0; i < n; i++) {
          const p = fn(i);
          arr[i * 3] = p.x;
          arr[i * 3 + 1] = p.y;
          arr[i * 3 + 2] = p.z;
          if (vc) {
            t.copy(base).lerp(new THREE.Color(p.tint || color), p.k || 0);
            carr![i * 3] = t.r;
            carr![i * 3 + 1] = t.g;
            carr![i * 3 + 2] = t.b;
