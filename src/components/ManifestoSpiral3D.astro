              RB.push(v2);
            }
          }
          const c1 = new THREE.CatmullRomCurve3(P1),
            c2 = new THREE.CatmullRomCurve3(P2),
            seg = mobile ? 140 : 240;
          // FLAT RIBBON backbone (the sugar-phosphate skeleton) — a twisting flat band
          // (width along the radial so it twists as it spirals, like a real DNA render)
          function ribbon(pts: any[], width: number) {
            const N = pts.length,
              pos: number[] = [],
              uvs: number[] = [],
              idx: number[] = [];
            for (let i = 0; i < N; i++) {
