  .ms3d-phase {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--ms3d-teal);
    opacity: 0.75;
    margin-top: 2.2rem;
  }
  .ms3d-reveal {
    position: relative;
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 1.4s ease, transform 1.4s ease;
  }
  /* Soft dark veil behind the text box — legibility fix over bright zones
     (Sun, DNA, eyes), owner-requested 2026-07-18. Sits between the canvas and
     the text (z-index:-1 inside .ms3d-reveal's own stacking context), so it
     never covers the art itself — just softens what's directly behind the
     words. Verified in the v5 prototype: title/eyebrow/lede read cleanly over
     the bright Sun. */
  .ms3d-reveal::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(820px, 130%);
    height: 200%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse 66% 60% at 50% 50%, rgba(4, 4, 9, 0.78), rgba(4, 4, 9, 0.58) 50%, transparent 82%);
    filter: blur(14px);
  }
  .ms3d-reveal.in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .ms3d-hint { display: none; }
    .ms3d-reveal { opacity: 1; transform: none; transition: none; }
  }
</style>
