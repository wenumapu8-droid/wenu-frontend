          const nucleus = new THREE.Group();
          nucleus.position.set(0, DNA_TOP + 9, 0);
          dna.add(nucleus);
          nucleus.add(new THREE.Mesh(new THREE.SphereGeometry(14, 32, 24), new THREE.MeshPhysicalMaterial({ color: 0x1c2c44, transparent: true, opacity: 0.09, roughness: 0.6, metalness: 0, transmission: 0.3, side: THREE.DoubleSide, depthWrite: false }))); // cell membrane
          nucleus.add(new THREE.Mesh(new THREE.SphereGeometry(14.2, 24, 18), fresnelMat(0x4a6c98, 3.2, 1.0))); // cell membrane rim
          nucleus.add(new THREE.Mesh(new THREE.SphereGeometry(7.5, 28, 22), new THREE.MeshPhysicalMaterial({ color: 0x2a3a58, transparent: true, opacity: 0.18, roughness: 0.5, metalness: 0, transmission: 0.4, side: THREE.DoubleSide, depthWrite: false }))); // nucleus
          nucleus.add(new THREE.Mesh(new THREE.SphereGeometry(7.7, 20, 16), fresnelMat(0x6f8fc0, 4.0, 1.0))); // nucleus rim
          nucleus.add(new THREE.Mesh(new THREE.SphereGeometry(1.7, 16, 16), new THREE.MeshBasicMaterial({ color: 0x8aa8d8, transparent: true, opacity: 0.13, blending: THREE.AdditiveBlending, depthWrite: false }))); // nucleolus
          for (let si = 0; si < 5; si++) {
            const cp: any[] = [];
            for (let ti = 0; ti < 6; ti++) cp.push(new THREE.Vector3(rand(-5, 5), rand(-5, 5), rand(-5, 5)));
            const cc = new THREE.CatmullRomCurve3(cp);
            nucleus.add(new THREE.Mesh(new THREE.TubeGeometry(cc, 24, 0.24, 5, false), new THREE.MeshBasicMaterial({ color: 0x9ab0e0, transparent: true, opacity: 0.5, blending: THREE.AdditiveBlending, depthWrite: false }))); // chromatin
