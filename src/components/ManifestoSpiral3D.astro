    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--sand);
    transition: opacity 0.8s ease;
  }
  @keyframes ms3d-bob {
    0%, 100% { transform: translate(-50%, 0); opacity: 0.6; }
    50%      { transform: translate(-50%, 7px); opacity: 1; }
  }

  /* Fixed chrome only shows while #ms3d is actually on screen — prevents a
     fixed canvas from painting over the Kultrun section / Footer below once
     the user has scrolled past this component. The void/voidword fade is
     driven by inline styles set from scroll progress (higher specificity),
     so this group only gates their baseline visibility. */
  .ms3d-webgl, .ms3d-vignette, .ms3d-void, .ms3d-voidword, .ms3d-rail, .ms3d-chapter, .ms3d-hint {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease;
  }
  .ms3d-enhanced.is-active .ms3d-webgl,
  .ms3d-enhanced.is-active .ms3d-vignette,
  .ms3d-enhanced.is-active .ms3d-void,
  .ms3d-enhanced.is-active .ms3d-voidword,
  .ms3d-enhanced.is-active .ms3d-rail,
  .ms3d-enhanced.is-active .ms3d-chapter,
  .ms3d-enhanced.is-active .ms3d-hint {
    visibility: visible;
  }
  .ms3d-enhanced.is-active .ms3d-webgl,
  .ms3d-enhanced.is-active .ms3d-vignette,
  .ms3d-enhanced.is-active .ms3d-rail,
  .ms3d-enhanced.is-active .ms3d-chapter,
  .ms3d-enhanced.is-active .ms3d-hint {
    opacity: 1;
  }

  /* ── station text (real HTML, always in the flow when enhanced is active) ── */
  .ms3d-stations {
    position: relative;
