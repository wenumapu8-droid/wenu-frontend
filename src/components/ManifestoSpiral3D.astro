          };
          function taperTube(T: number, Rs: number, rf: (u: number) => number) {
            const fr = curve.computeFrenetFrames(T, false),
              pos: number[] = [],
              nor: number[] = [],
              uv: number[] = [],
              idx: number[] = [],
