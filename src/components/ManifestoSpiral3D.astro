      const gas = cloudPts(
        NB,
        () => {
          const r = Math.random() * 32,
            a = Math.random() * 6.283;
          return { x: Math.cos(a) * r, y: L(GAS[0], GAS[1], Math.random()), z: Math.sin(a) * r };
        },
        C.teal,
        { size: 0.72, opacity: 0.5 }
      );
      const liquid = cloudPts(
        NB,
        (i) => {
          const u = i / NB,
            a = u * 6.283 * 30,
            r = 8 + 6 * Math.sin(u * 40);
          return { x: Math.cos(a) * r, y: L(LIQUID[0], LIQUID[1], u), z: Math.sin(a) * r };
