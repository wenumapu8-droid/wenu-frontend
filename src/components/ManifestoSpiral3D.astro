  }
  .ms3d-body {
    max-width: 39ch;
    margin: 1.5rem auto 0;
    font-size: clamp(1.06rem, 2.4vw, 1.5rem);
    line-height: 1.55;
    color: #d8d3c8;
    text-shadow: 0 1px 18px rgba(3, 3, 8, 0.9);
