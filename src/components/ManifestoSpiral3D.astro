              }
            }
          const lg = new THREE.BufferGeometry();
          lg.setAttribute('position', new THREE.BufferAttribute(new Float32Array(lp), 3));
          scene.add(new THREE.LineSegments(lg, new THREE.LineBasicMaterial({ color: 0x9a7ee0, transparent: true, opacity: 0.2, blending: THREE.AdditiveBlending })));
          return mat;
        })();

        // COSMIC SERPENT — the primordial serpent coiling through the cosmos
        // (with the planets, near the source — not the DNA; owner catch 2026-07-18:
        // it belongs up in the primordial cosmos, not coiled around the double helix).
        serpent = new THREE.Group();
        scene.add(serpent);
        (function () {
          const TOP = 250,
            BOT = 146,
            coils = 2.15,
            STEPS = mobile ? 120 : 190,
            P: any[] = [];
          for (let i = 0; i <= STEPS; i++) {
            const u = i / STEPS,
              y = L(BOT, TOP, u) + 4 * Math.sin(u * 5),
              ang = u * coils * 6.283,
              r = 28 + 15 * Math.sin(u * Math.PI);
