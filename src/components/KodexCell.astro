---
// KODEX−∞ · curated cell — a work presented as an ART PLATE, never a naked
// design: number + title on the cell, full curation (reading, technique,
// inspiration, decoded operations, own sigil) carried in data-attrs for the
// viewer. Plate 009 is a VIDEO work: renders <video> with the still as poster,
// so it degrades gracefully until the file lands in public/img/kodex/video/.
import { opName, sigilSvg } from '../lib/kodexBook.js';
const { fam } = Astro.props;
const opsFull = fam.ops.map((c) => `${c} ${opName(c)}`).join(' · ');
---
<figure
  class="kx-cell" data-spec
  data-files={fam.files.join(',')} data-rep={fam.rep}
  data-title={`${fam.n} · ${fam.t || ''}`} data-read={fam.read || ''}
  data-fx={fam.fx || ''} data-insp={fam.insp || ''} data-opsfull={opsFull}
  data-video={fam.video || undefined}
  style={fam.th ? `--acc:${fam.th.c}` : undefined}
>
  {fam.video ? (
    <video muted loop autoplay playsinline preload="metadata"
      poster={`/img/kodex/${fam.dir}/${fam.rep}.jpg`} aria-label={`KODEX−∞ — ${fam.t || fam.n}, video work`}>
      <source src={`${fam.video}.webm`} type="video/webm" />
      <source src={`${fam.video}.mp4`} type="video/mp4" />
    </video>
  ) : (
    <img src={`/img/kodex/${fam.dir}/${fam.rep}.jpg`} loading="lazy" alt={`KODEX−∞ — ${fam.t || 'work ' + fam.n}`} />
  )}
  <figcaption><b>{fam.n}</b>{fam.t && <span> · {fam.t}</span>}</figcaption>
  {fam.files.length > 1 && !fam.video && <span class="kx-cell__count">×{fam.files.length}</span>}
  {fam.video && <span class="kx-cell__count">▶ VIDEO</span>}
  <span class="kx-cell__ops">{fam.ops.join(' · ')}</span>
  <span class="kx-cell__sigil" hidden set:html={sigilSvg(fam.seed || 111)}></span>
</figure>
