  /* ── the IGNITION flare — off at rest, revealed on reveal/press ── */
  .ember__flare {
    position: absolute; inset: -26%; z-index: 0; pointer-events: none;
    background:
      radial-gradient(circle at 50% 50%,
        rgba(255, 236, 190, 0.85) 0%,
        rgba(255, 190, 96, 0.55) 20%,
        rgba(230, 130, 44, 0.30) 40%,
        rgba(150, 66, 20, 0.12) 60%,
        transparent 74%);
    mix-blend-mode: screen;
    opacity: 0; transform: scale(0.7);
    transition: opacity 0.4s ease, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: opacity, transform;
  }

  /* two faint instrument rings — hidden at rest, fade in when revealed */
  .ember__ring {
    position: absolute; border-radius: 50%; pointer-events: none;
    border: 1px solid color-mix(in srgb, var(--ember) 26%, transparent);
    opacity: 0;
    transition: border-color var(--t-base, 0.4s) ease, opacity var(--t-base, 0.4s) ease;
  }
  .ember__ring--a {
    inset: 3%;
    border-style: dashed;
    animation: ember-spin 44s linear infinite;
  }
  .ember__ring--b {
    inset: 14%;
    border-color: color-mix(in srgb, var(--ember) 14%, transparent);
    animation: ember-spin 66s linear infinite reverse;
  }

  /* ── the morphing centre ── */
  .ember__morph {
    position: relative; z-index: 1;
    width: clamp(200px, 34vw, 320px); aspect-ratio: 1;
    display: grid; place-items: center;
