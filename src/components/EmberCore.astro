  .ember__state :global(svg) { width: clamp(200px, 34vw, 320px); height: auto; }

  /* State A — wüñelfe sigil: visible at morph 0, gone at morph 1 */
  .ember__state--sigil {
    opacity: calc(1 - var(--morph, 0));
    transform: scale(calc(1 - 0.12 * var(--morph, 0))) rotate(calc(-24deg * var(--morph, 0)));
