---
/**
 * EmberCore — the burning centre that OPENS into the kültrún (Ocin 2026-07-06).
 *
 * REDESIGN (Ocin 2026-07-06 — "se ve súper cargado; la idea era que si lo TOCAS se
 * transforma en un kültrún"). The old version showed EVERYTHING at once — full wheel
 * + four direction labels + symbols + HUD + readouts — which read as saturated. This
 * version follows the brief literally: a CLEAN, elegant DEFAULT (only the burning
 * wüñelfe sigil over obsidian, a title and one CTA, generous air) that TRANSFORMS
 * into the full kültrún WHEN TOUCHED — the four-lands wheel, the direction labels and
 * the land-readout are hidden until the centre is revealed. Clean → touch → kültrún.
 *
 * Two states, one section:
 *   · REST  → the wüñelfe sigil glowing on obsidian, title + CTA, a subtle affordance
 *     hint ("✷ touch to reveal the kültrún"). No wheel, no labels, no readouts.
 *   · REVEALED (tap / hold / Enter / choose a land) → the section adds `.is-revealed`:
 *     the sigil morphs to an SVG-drawn kültrún (moon · two kürüf whorls · wüñelfe
 *     star), the four lands (Meli Witran Mapu) fade in around the drum and the
 *     land-readout appears. Idle / deselect → it collapses back to the clean centre.
 *
 * ── AUTHENTICITY CLAIM REMOVED (2026-08-08) ────────────────────────────────
 * This file described the drawing above as "the authentic kültrún" in three
 * places. The assertion is gone; the drawing is untouched. What went is the
 * CLAIM, not the depiction — the project's own stance (manuscrito.md) is that
 * mapuche passages are NAMED AS DOCUMENTED TRADITION, not asserted to be
 * authentic, and "authentic" is a different speech act from naming. This is
 * the same correction already made in `ManifestoSpiral3D.astro`
 * ("an authentic kultrún: canvas-drawn drumhead" → "a canvas-drawn kultrún
 * drumhead"); here the medium is inline SVG rather than canvas, so the wording
 * follows the medium.
 *
 * NO CITATION IS ASSERTED HERE, deliberately. The repo's canonical source is
 * Canio Llanquinao & Pozo Menares, "Wenumapu — Astronomía y Cosmología
 * Mapuche" (Ocho Libros, 2015, ISBN 978-956-335-205-4), and
 * public/kodex-content/sources/wenu-mapu.md does attribute *some* of what this
 * component names — Meli Witran Mapu, küyen, and wüñelfe (the last
 * [VERIFICADO 2026-08-01]). But it does NOT cover kürüf, "mapu" as an
 * elemental symbol, or the four land names and their glosses in `LANDS` below,
 * and that file's standing rule is that "cualquier término mapudungun que no
 * esté en esta tabla sigue sin verificar y no se glosa". A citation attached
 * to this component as a whole would therefore lend the book's authority to
 * glosses the book was not shown to support. Partial coverage is not coverage.
 * Reported to the creator rather than papered over.
 *
 * The four-lands interaction (turn the drum toward a direction, name the land) lives
 * INSIDE the revealed state, not all the time. Tap the centre once to reveal/latch;
 * tap again (or deselect the land) to calm back to the clean sigil.
 *
 * PERFORMANCE (efectos-livianos-mobile-wenu.md — canon):
 *   · Base look is layered radial-gradients painted ONCE + CSS keyframes that move
 *     ONLY transform / opacity (GPU compositor). Interaction adds ONE small rAF that
 *     runs ONLY when in viewport AND (pressed OR easing OR the idle breathing cycle is
 *     alive); it self-parks otherwise. Paused on visibilitychange + out of view.
 *   · Glow/flare are static gradients toggled by opacity/scale — no animated blur, no
 *     animated box-shadow, never a hard flash → far under 3 flashes/sec.
 *   · prefers-reduced-motion → no flare/inertia; reveal shows the kültrún static
 *     (short crossfade), nothing else.
 */
import WenuSigil from './WenuSigil.astro';
import RitualGlyph from './RitualGlyph.astro';
import MandalaPortal from './MandalaPortal.astro';

interface Props {
  eyebrow?: string;
  arn?: string;        // mapudungun ritual line (lang="arn")
  title?: string;
  body?: string;
  ctaHref?: string;
  ctaLabel?: string;
  /** interactive affordance hint */
  hint?: string;
}
const {
  eyebrow = 'Meli Witran Mapu · The burning drum',
  arn = 'Meli witran mapu — the four lands, one drum',
  title = 'The sky, still burning.',
  body = 'A signal older than the map. Touch the centre — the ember opens into the ' +
         'kültrún, the four directions of the Wallmapu written in fire.',
  ctaHref = '/experience/cosmos',
  ctaLabel = 'Enter the transmission',
  hint = 'touch to reveal the kültrún',
} = Astro.props;

// ── The four lands of the Wallmapu (Meli Witran Mapu) ────────────────────────
// pos = cardinal angle (deg, 0 = North/top). Selecting a land turns the burning
// drum so that quadrant faces up, and names the direction below the flame. These
// only become interactive once the centre is REVEALED.
const LANDS = [
  { key: 'pikun',  label: 'Pikun Mapu',  cardinal: 'North', pos: 0,
    line: 'Wind over the open north — stone that was once the sky.' },
  { key: 'puel',   label: 'Puel Mapu',   cardinal: 'East',  pos: 90,
    line: 'Where the sun is born — radiant metal that holds the day.' },
  { key: 'willi',  label: 'Willi Mapu',  cardinal: 'South', pos: 180,
    line: 'The forest and the cold — rooted in the Wallmapu.' },
  { key: 'lafken', label: 'Lafken Mapu', cardinal: 'West',  pos: 270,
    line: 'The sea and the mist — deep time, the ocean that remembers.' },
] as const;
---
<section class="ember" aria-labelledby="ember-title" data-ember-section>
  {/* ── deep cosmic ground + ember bloom (painted once) ── */}
  <span class="ember__ground" aria-hidden="true"></span>
  <span class="ember__bloom" aria-hidden="true"></span>

  <div class="ember__inner">
    {/* ── copy ABOVE the flame — eyebrow + title, clean and airy ── */}
    <div class="ember__lede">
      <p class="ember__eyebrow eyebrow">{eyebrow}</p>
      <p class="ember__arn" lang="arn">{arn}</p>
      <h2 id="ember-title" class="ember__title">{title}</h2>
    </div>

    {/* ── the burning stage ── the INTERACTIVE surface.
        REST: the wüñelfe sigil glowing on obsidian.
        REVEALED (press/hold/tap/Enter, or choose a land): morphs to the kültrún,
        the four lands + readout fade in. role=button + tabindex = keyboard-operable. ── */}
    <div
      class="ember__stage"
      data-ember-core
      role="button"
      tabindex="0"
      aria-pressed="false"
      aria-label="The burning centre — touch to reveal the kültrún, drag to turn the drum"
    >
      <span class="ember__halo" aria-hidden="true"></span>
      <span class="ember__heat" aria-hidden="true"></span>
      <span class="ember__flare" aria-hidden="true"></span>
      <span class="ember__ring ember__ring--a" aria-hidden="true"></span>
      <span class="ember__ring ember__ring--b" aria-hidden="true"></span>

      {/* ── the morphing centre ── sigil (rest) ↔ kültrún (revealed) ── */}
      <span class="ember__morph" aria-hidden="true">
        {/* STATE A — the wüñelfe sigil (rest) */}
        <span class="ember__ember-glyph ember__state ember__state--sigil">
          <WenuSigil size={320} label="Wüñelfe — the burning sigil of Wenu Mapu" />
        </span>

        {/* STATE B — the SVG-drawn kültrún of four symbols (revealed; turns with drag).
            "Authentic" was removed here 2026-08-08: this file carries no
            ethnographic verification, so it cannot assert one. See the
            AUTHENTICITY CLAIM REMOVED note in the file header. */}
        <span class="ember__ember-glyph ember__state ember__state--kultrun">
          <svg viewBox="0 0 540 540" class="ember-kultrun" role="img"
               aria-label="Kültrún — the four elemental symbols">
            {/* outer sky ring + inner ring + cardinal cross */}
            <g class="ember-kultrun__frame" fill="none" stroke="currentColor"
               stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke">
              <circle cx="270" cy="270" r="232" stroke-width="1.4" />
              <circle cx="270" cy="270" r="210" stroke-width="1" opacity="0.55" />
              <line x1="270" y1="38" x2="270" y2="502" stroke-width="1.2" />
              <line x1="38" y1="270" x2="502" y2="270" stroke-width="1.2" />
            </g>

            {/* NE · KÜRÜF (wind) — spiralling comma-whorls, clockwise */}
            <g transform="translate(360 180)" class="ember-kultrun__sym">
              <g class="ember-kultrun__whorl-arms">
                <path class="ember-kultrun__whorl" d="M0 -1 C -3 -16 5 -26 21 -27 C 12 -22 8 -13 2 -4" />
                <path class="ember-kultrun__whorl" d="M0 -1 C -3 -16 5 -26 21 -27 C 12 -22 8 -13 2 -4" transform="rotate(90)" />
                <path class="ember-kultrun__whorl" d="M0 -1 C -3 -16 5 -26 21 -27 C 12 -22 8 -13 2 -4" transform="rotate(180)" />
                <path class="ember-kultrun__whorl" d="M0 -1 C -3 -16 5 -26 21 -27 C 12 -22 8 -13 2 -4" transform="rotate(270)" />
              </g>
              <circle r="2.6" fill="currentColor" />
            </g>

            {/* NW · KÜYEN (crescent moon) — clean sickle */}
            <g transform="translate(180 180)" class="ember-kultrun__sym">
              <path class="ember-kultrun__moon" d="M13 -32 A 33 33 0 1 0 13 32 A 25 25 0 1 1 13 -32 Z" />
            </g>

            {/* SE · WÜÑELFE (morning star) — 8-point star of two squares */}
            <g transform="translate(360 360)" class="ember-kultrun__sym">
              <polygon class="ember-kultrun__star" points="0,-34 5.4,-12.9 24,-24 12.9,-5.4 34,0 12.9,5.4 24,24 5.4,12.9 0,34 -5.4,12.9 -24,24 -12.9,5.4 -34,0 -12.9,-5.4 -24,-24 -5.4,-12.9" />
              <rect x="-4.5" y="-4.5" width="9" height="9" transform="rotate(45)" fill="currentColor" />
            </g>

            {/* SW · MAPU (earth) — mirrored kürüf whorl, counter-clockwise */}
            <g transform="translate(180 360)" class="ember-kultrun__sym ember-kultrun__sym--ccw">
              <g class="ember-kultrun__whorl-arms">
                <path class="ember-kultrun__whorl" d="M0 -1 C -3 -16 5 -26 21 -27 C 12 -22 8 -13 2 -4" />
                <path class="ember-kultrun__whorl" d="M0 -1 C -3 -16 5 -26 21 -27 C 12 -22 8 -13 2 -4" transform="rotate(90)" />
                <path class="ember-kultrun__whorl" d="M0 -1 C -3 -16 5 -26 21 -27 C 12 -22 8 -13 2 -4" transform="rotate(180)" />
                <path class="ember-kultrun__whorl" d="M0 -1 C -3 -16 5 -26 21 -27 C 12 -22 8 -13 2 -4" transform="rotate(270)" />
              </g>
              <circle r="2.6" fill="currentColor" />
            </g>

            {/* central portal dot */}
            <circle cx="270" cy="270" r="21" fill="none" stroke="currentColor" stroke-width="1.3" />
            <circle cx="270" cy="270" r="3.4" fill="currentColor" />
          </svg>
        </span>
      </span>

      <span class="ember__spark ember__spark--1" aria-hidden="true"></span>
      <span class="ember__spark ember__spark--2" aria-hidden="true"></span>
      <span class="ember__spark ember__spark--3" aria-hidden="true"></span>
      <span class="ember__spark ember__spark--4" aria-hidden="true"></span>
      <span class="ember__spark ember__spark--5" aria-hidden="true"></span>

      {/* interactive affordance — only in REST; hides once revealed */}
      <span class="ember__hint" aria-hidden="true"><span class="ember__hint-star">✷</span> {hint}</span>

      {/* ── the four lands ── ONLY interactive + visible once REVEALED.
          Anchored to the stage so N/E/S/W frame the drum, not the whole section. ── */}
      <div class="ember__lands" data-ember-lands aria-hidden="true">
        {LANDS.map((l) => (
          <button
            type="button"
            class={`ember__land ember__land--${l.cardinal.toLowerCase()}`}
            data-ember-land={l.key}
            data-ember-pos={l.pos}
            aria-pressed="false"
            tabindex="-1"
            aria-label={`Turn the drum to ${l.label} — the ${l.cardinal.toLowerCase()}`}
          >
            <span lang="arn">{l.label}</span>
            <small>{l.cardinal}</small>
          </button>
        ))}
      </div>
    </div>

    {/* ── revealed detail — land readout + body + CTA ──
        The land-readout only shows in the revealed state; the body + CTA stay. ── */}
    <div class="ember__copy">
      <p class="ember__land-read" data-ember-land-read aria-live="polite">
        <span class="ember__land-name" data-ember-land-name>Choose a direction</span>
        <span class="ember__land-line" data-ember-land-line>Turn the drum — the world above, written overhead.</span>
      </p>
      <p class="ember__body">{body}</p>
      <div class="ember__cta-row">
        <a href={ctaHref} class="ember__cta">
          {ctaLabel} <span aria-hidden="true">→</span>
        </a>
        <MandalaPortal variant="inline" size="48px" label={ctaLabel} class="ember__cta-mandala" />
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var stage = document.querySelector('[data-ember-core]');
    if (!stage || stage.dataset.emberReady) return;
    stage.dataset.emberReady = '1';
    var section = stage.closest('[data-ember-section]');

    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── live state ──
    var morph = 0;          // 0 = wüñelfe sigil, 1 = kültrún
    var morphTarget = 0;    // where morph is easing toward
    var revealed = false;   // is the kültrún revealed (lands visible, drum lit)
    var spin = 0;           // wheel rotation, degrees
    var spinVel = 0;        // deg/frame for inertia
    var spinTarget = null;  // when a land is chosen, ease the wheel to face it up
    var currentLand = null; // selected land key (or null)
    var dragging = false;
    var pressed = false;    // finger/pointer currently down
    var moved = false;      // drag exceeded the tap threshold
    var wasRevealed = false;// revealed-state snapshot at pointerdown (for tap toggle)
    var lastAngle = 0;      // last pointer angle around centre (for drag rotation)
    var inView = false;
    var rafId = 0;
    var lastT = 0;

    function centre() {
      var r = stage.getBoundingClientRect();
      return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
    }
    function angleTo(e) {
      var c = centre();
      return Math.atan2(e.clientY - c.y, e.clientX - c.x) * 180 / Math.PI;
    }

    function paint() {
      stage.style.setProperty('--morph', morph.toFixed(3));
      stage.style.setProperty('--spin', spin.toFixed(2) + 'deg');
    }
    paint();

    function needsFrame() {
      if (!inView) return false;
      if (pressed || dragging) return true;
      if (Math.abs(morph - morphTarget) > 0.002) return true;
      if (Math.abs(spinVel) > 0.02) return true;
      if (spinTarget !== null) return true;   // easing toward a chosen land
      return false;                            // no idle breathing — calm at rest
    }

    function frame(t) {
      rafId = 0;
      if (!lastT) lastT = t;
      var dt = Math.min(64, t - lastT);
      lastT = t;

      // ── ease morph toward its target (snappier while pressed) ──
      var ease = pressed ? 0.24 : 0.10;
      if (reduce) morph = morphTarget;
      else morph += (morphTarget - morph) * ease;
      if (Math.abs(morphTarget - morph) < 0.002) morph = morphTarget;

      // ── ease the wheel toward a chosen land (overrides free inertia) ──
      if (spinTarget !== null && !dragging) {
        if (reduce) { spin = spinTarget; spinTarget = null; spinVel = 0; }
        else {
          spin += (spinTarget - spin) * 0.12;
          spinVel = 0;
          if (Math.abs(spinTarget - spin) < 0.15) { spin = spinTarget; spinTarget = null; }
        }
      } else if (!dragging && !reduce) {
        // ── spin inertia when released after a drag ──
        spin += spinVel;
        spinVel *= 0.94;
        if (Math.abs(spinVel) < 0.02) spinVel = 0;
      }

      paint();

      if (needsFrame()) rafId = requestAnimationFrame(frame);
      else lastT = 0;
    }
    function kick() {
      if (!rafId && needsFrame()) { lastT = 0; rafId = requestAnimationFrame(frame); }
    }
    // a user interaction on the stage proves it is on-screen; force the loop live so
    // the morph easing always completes even if the IntersectionObserver callback for
    // inView hasn't fired yet (fast scroll-then-tap).
    function wake() { inView = true; kick(); }

    var landBtns = section ? Array.prototype.slice.call(section.querySelectorAll('[data-ember-land]')) : [];
    var landsWrap = section ? section.querySelector('[data-ember-lands]') : null;
    var landNameEl = section ? section.querySelector('[data-ember-land-name]') : null;
    var landLineEl = section ? section.querySelector('[data-ember-land-line]') : null;
    var LAND_LINES = {
      pikun:  ['Pikun Mapu · North', 'Wind over the open north — stone that was once the sky.'],
      puel:   ['Puel Mapu · East',   'Where the sun is born — radiant metal that holds the day.'],
      willi:  ['Willi Mapu · South', 'The forest and the cold — rooted in the Wallmapu.'],
      lafken: ['Lafken Mapu · West',  'The sea and the mist — deep time, the ocean that remembers.'],
    };

    // ── REVEAL / COLLAPSE — the whole point: clean ↔ kültrún ──
    function reveal() {
      if (revealed) return;
      revealed = true;
      morphTarget = 1;
      if (section) section.classList.add('is-revealed');
      stage.setAttribute('aria-pressed', 'true');
      // the lands become real controls only once revealed
      if (landsWrap) landsWrap.setAttribute('aria-hidden', 'false');
      landBtns.forEach(function (b) { b.setAttribute('tabindex', '0'); });
      kick();
    }
    function collapse() {
      revealed = false;
      pressed = false;
      dragging = false;
      morphTarget = 0;
      currentLand = null;
      spinTarget = reduce ? 0 : shortestTo(0);
      if (section) section.classList.remove('is-revealed', 'is-pressing');
      stage.setAttribute('aria-pressed', 'false');
      if (landsWrap) landsWrap.setAttribute('aria-hidden', 'true');
      landBtns.forEach(function (b) { b.setAttribute('tabindex', '-1'); b.setAttribute('aria-pressed', 'false'); });
      if (landNameEl) landNameEl.textContent = 'Choose a direction';
      if (landLineEl) landLineEl.textContent = 'Turn the drum — the world above, written overhead.';
      kick();
    }
    function toggleReveal() { if (revealed) collapse(); else reveal(); }

    // ── ignite look while a finger is down (a brighter flare on top of revealed) ──
    function pressOn() {
      pressed = true;
      if (section) section.classList.add('is-pressing');
    }
    function pressOff() {
      pressed = false;
      if (section) section.classList.remove('is-pressing');
    }

    // ── pointer wiring (touch + mouse + pen) ──
    stage.addEventListener('pointerdown', function (e) {
      moved = false;
      wasRevealed = revealed;       // remember state so a clean tap can toggle it
      lastAngle = angleTo(e);
      spinVel = 0;
      spinTarget = null;
      dragging = true;
      pressOn();
      // reveal WHILE the finger is down so hold-to-preview + drag-to-spin work
      // immediately; a clean tap (no drag) is reconciled on release below.
      if (!revealed) reveal();
      wake();
      try { stage.setPointerCapture(e.pointerId); } catch (x) {}
      e.preventDefault();
    });
    stage.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      var a = angleTo(e);
      var da = a - lastAngle;
      if (da > 180) da -= 360; else if (da < -180) da += 360;
      lastAngle = a;
      if (Math.abs(da) > 0.6) moved = true;
      if (!reduce) {
        spin += da;
        spinVel = da;
      }
      paint();
    });
    function release(e) {
      if (!pressed && !dragging) return;
      dragging = false;
      pressOff();
      // a press with no meaningful drag = a TAP. pointerdown already revealed if we
      // started from rest, so: tap-from-rest → STAY revealed; tap-while-revealed →
      // collapse back to the clean sigil. (Toggle relative to the pre-press state.)
      if (!moved && wasRevealed) {
        collapse();
      }
      // a drag just turned the wheel; stay revealed with inertia
      wake();
      try { stage.releasePointerCapture(e.pointerId); } catch (x) {}
    }
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', function () {
      dragging = false; pressOff(); kick();
    });
    stage.addEventListener('pointerleave', function () {
      if (dragging) return;         // capture keeps drag alive
      pressOff();
    });

    // ── keyboard: Enter / Space reveal + collapse ──
    stage.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
        e.preventDefault();
        toggleReveal();
        wake();
      } else if (e.key === 'Escape' && revealed) {
        collapse();
        wake();
      }
    });

    // normalise the current spin to the nearest equivalent of a target angle so the
    // wheel takes the SHORT way round.
    function shortestTo(targetDeg) {
      var cur = spin % 360;
      var t = ((targetDeg % 360) + 360) % 360;
      var delta = t - ((cur % 360) + 360) % 360;
      if (delta > 180) delta -= 360; else if (delta < -180) delta += 360;
      return spin + delta;
    }

    function selectLand(key) {
      if (!revealed) reveal();
      var same = currentLand === key;
      currentLand = same ? null : key;

      landBtns.forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.dataset.emberLand === currentLand));
      });

      if (currentLand) {
        var btn = landBtns.filter(function (b) { return b.dataset.emberLand === currentLand; })[0];
        var pos = btn ? parseFloat(btn.dataset.emberPos) : 0;
        spinTarget = reduce ? -pos : shortestTo(-pos);
        var meta = LAND_LINES[currentLand];
        if (landNameEl && meta) landNameEl.textContent = meta[0];
        if (landLineEl && meta) landLineEl.textContent = meta[1];
      } else {
        // deselect the land → return to the neutral revealed drum
        spinTarget = reduce ? 0 : shortestTo(0);
        if (landNameEl) landNameEl.textContent = 'Choose a direction';
        if (landLineEl) landLineEl.textContent = 'Turn the drum — the world above, written overhead.';
      }
      wake();
    }

    landBtns.forEach(function (b) {
      b.addEventListener('click', function (e) { e.stopPropagation(); selectLand(b.dataset.emberLand); });
    });

    // ── run the loop ONLY while in viewport ──
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        inView = entries[0].isIntersecting;
        if (inView) kick();
        else if (rafId) { cancelAnimationFrame(rafId); rafId = 0; lastT = 0; }
      }, { threshold: 0.08 });
      io.observe(stage);
    } else {
      inView = true; kick();
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        if (rafId) { cancelAnimationFrame(rafId); rafId = 0; lastT = 0; }
      } else {
        kick();
      }
    });
  })();
</script>

<style>
  .ember {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-block: var(--border-thin);
    padding: var(--section-y-lg) var(--gutter);
    background: #060505;
  }

  /* ── grounds (painted once, no animated blur) ── */
  .ember__ground {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(120% 120% at 50% 44%, #17110a 0%, #0b0806 52%, #050403 100%);
  }
  /* the ember bloom behind the glyph — calmer at rest, swells when revealed */
  .ember__bloom {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(42% 48% at 50% 46%,
        rgba(201, 168, 76, 0.22) 0%,
        rgba(180, 110, 40, 0.11) 34%,
        rgba(120, 60, 20, 0.04) 56%,
        transparent 72%);
    animation: ember-bloom 9s ease-in-out infinite;
    transition: opacity var(--t-base, 0.4s) ease;
  }

  /* ── layout ── */
  .ember__inner {
    position: relative; z-index: 2;
    max-width: 720px; margin: 0 auto;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: clamp(28px, 5vw, 52px);
