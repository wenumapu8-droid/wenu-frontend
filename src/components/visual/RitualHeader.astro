---
// Sacred header — reproduces the layout of the Ritual Guardian mockup
// (img-5 of the brand book) on any page. Centred wordmark textil + tagline,
// flanked by ceremonial eyebrows ("SACRED ARTIFACTS" / "CONNECTED TO THE COSMOS")
// and small mandala accents.
interface Props {
  /** Left eyebrow (default: SACRED ARTIFACTS) */
  leftEyebrow?: string;
  /** Right eyebrow (default: CONNECTED TO THE COSMOS) */
  rightEyebrow?: string;
  /** Top sigil — small, sits above the wordmark. Defaults to sello sacred. */
  sigilSrc?: string;
  /** If true, render as a quieter footer-style ribbon (smaller paddings). */
  compact?: boolean;
}
const {
  leftEyebrow = 'SACRED ARTIFACTS',
  rightEyebrow = 'CONNECTED TO THE COSMOS',
  sigilSrc = '/img/brand/wenu-sigil-sacred-sello.webp',
  compact = false,
} = Astro.props;
---
<header class={`ritual-header ${compact ? 'ritual-header--compact' : ''}`} aria-label="Wenu Mapu sacred header">
  {/* Left flank: eyebrow + small mandala */}
  <div class="ritual-header__flank ritual-header__flank--left">
    <span class="ritual-header__eyebrow">{leftEyebrow}</span>
    <picture class="ritual-header__flank-mark">
      <source type="image/avif" srcset="/img/brand/wenu-mandala-textil-4svastikas.avif"/>
      <img src="/img/brand/wenu-mandala-textil-4svastikas.webp" alt="" width="28" height="28" loading="lazy" decoding="async"/>
    </picture>
  </div>

  {/* Centre: sigil sello + wordmark textil + tagline */}
  <div class="ritual-header__centre">
    <picture class="ritual-header__sigil">
      <source type="image/avif" srcset={sigilSrc.replace('.webp', '.avif')}/>
      <img src={sigilSrc} alt="Wenu Mapu sacred mark" width="40" height="40" loading="eager" decoding="async"/>
    </picture>
    <p class="ritual-header__wordmark">WENÜ MAPÜ</p>
    <p class="ritual-header__tagline">TRIBAL · RITUAL · JEWELRY</p>
  </div>

  {/* Right flank: mandala + eyebrow */}
  <div class="ritual-header__flank ritual-header__flank--right">
    <picture class="ritual-header__flank-mark">
      <source type="image/avif" srcset="/img/brand/wenu-mandala-textil-4svastikas.avif"/>
      <img src="/img/brand/wenu-mandala-textil-4svastikas.webp" alt="" width="28" height="28" loading="lazy" decoding="async"/>
    </picture>
    <span class="ritual-header__eyebrow">{rightEyebrow}</span>
  </div>
</header>

<style>
  .ritual-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(16px, 4vw, 64px);
    padding: clamp(28px, 5vw, 56px) clamp(24px, 5vw, 80px) clamp(20px, 3vw, 36px);
    background: var(--obsidian, #080706);
    text-align: center;
  }
  .ritual-header--compact {
    padding: clamp(16px, 3vw, 32px) clamp(20px, 4vw, 64px);
  }

  .ritual-header__flank {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 24px);
    color: var(--silver, #A8A39A);
    min-width: 0;
  }
  .ritual-header__flank--left { justify-content: flex-end; }
  .ritual-header__flank--right { justify-content: flex-start; }

  .ritual-header__eyebrow {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--silver, #A8A39A);
    line-height: 1.4;
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .ritual-header__eyebrow { font-size: 9px; letter-spacing: 0.24em; }
  }
  @media (max-width: 480px) {
    .ritual-header__flank { display: none; }
    .ritual-header { grid-template-columns: 1fr; }
  }

  .ritual-header__flank-mark { display: inline-block; opacity: 0.45; }
  .ritual-header__flank-mark img {
    display: block;
    filter: brightness(1.2) sepia(0.18) hue-rotate(-12deg);
    height: auto;
  }

  .ritual-header__centre {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .ritual-header__sigil {
    display: block;
    opacity: 0.92;
  }
  .ritual-header__sigil img {
    display: block;
    width: clamp(36px, 4vw, 44px);
    height: auto;
    filter: brightness(1.06);
  }

  .ritual-header__wordmark {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1;
    color: var(--bone, #F2EDE4);
    margin: 4px 0 0;
  }
  .ritual-header__tagline {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 10px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--ember, #C4935A);
    margin: 6px 0 0;
  }
</style>
