---
import { decodeEntities } from '../../lib/woo';
import type { WooProduct } from '../../lib/woo';
import en from '../../i18n/en.json';

interface Props {
  product: WooProduct;
}

const { product } = Astro.props;

const sourceText = [
  decodeEntities(product.name),
  product.sku,
  ...product.categories.flatMap(category => [category.slug, category.name]),
  ...product.attributes.flatMap(attribute => [attribute.name, ...attribute.options]),
].join(' ').toLowerCase();

const materialLockups = [
  {
    keys: ['silver', 'sterling', '925', '950', 'plata'],
    text: 'Sterling Silver 950 — Pure, durable, and alive with light.',
  },
  {
    keys: ['gold', '14k', 'oro'],
    text: '14k Gold — heirloom-grade. Warm. Made to outlast the wearer.',
  },
  {
    keys: ['titanium', 'titanio'],
    text: 'ASTM F-136 implant-grade titanium — hypoallergenic, durable, lightweight.',
  },
  {
    keys: ['vacamuerta', 'meteorite', 'atacama', 'meteorito'],
    text: 'Vaca Muerta mesosiderite — rare stony-iron meteorite from Chile’s Atacama Desert.',
  },
  {
    keys: ['walnut', 'wood', 'madera'],
    text: 'Walnut & tropical wood — sustainably sourced, warm, and grounded.',
  },
  {
    keys: ['brass', 'bronze', 'laton', 'latón', 'bronce'],
    text: 'Brass & bronze — bold ancestral metals with deep tribal roots.',
  },
];

const materialText = materialLockups
  .filter(material => material.keys.some(key => sourceText.includes(key)))
  .map(material => material.text)
  .join(' · ');

const gaugeAttributes = product.attributes.filter(attribute => {
  const name = attribute.name.toLowerCase();
  return ['gauge', 'size', 'caliber', 'calibre', 'diameter', 'diametro', 'diámetro', 'post', 'length', 'mm']
    .some(key => name.includes(key));
});

const gaugeText = gaugeAttributes
  .flatMap(attribute => attribute.options)
  .filter(Boolean)
  .map(decodeEntities)
  .slice(0, 3)
  .join(' · ');

// Origin detection (mirrors logic in src/pages/p/[slug].astro)
// Honest labeling: never claim "hand-forged" for imported pieces.
const originAttr = product.attributes.find(a => /origen|origin|made by|fabricaci/i.test(a.name));
const originRaw = (originAttr?.options?.[0] || '').toLowerCase().trim();

// Smart fallback by keywords when Origen attribute not set in WC.
// 5 honest categories:
// - hand-forged: forged from raw material in studio (meteorite rings, Vacamuerta)
// - handmade: made entirely by Nico (picoyo wire-wrap, Author Jewelry, collabs)
// - hand-assembled: Nico assembles imported parts into unique pieces (serpent hangers,
//   colgante earrings — sold in branded carton)
// - curated-independent: made by other independent artists Wenu Mapu curates
//   (Alai Wakan / @alaiwakan — Spanish silversmith, handmade hangers)
// - imported-curated: curated selection from international suppliers, sold as-is
type Origin = 'handmade' | 'hand-forged' | 'hand-assembled' | 'curated-independent' | 'imported-curated';

const inferredOrigin: Origin =
  /vacamuerta|meteorite|meteorito|atacama/.test(sourceText) ? 'hand-forged' :
  /picoyo|wire-wrap|wirewrap/.test(sourceText)              ? 'handmade' :
  /author-jewelry|author jewelry|one-of-a-kind|custom-forged|tipichill|cami/.test(sourceText) ? 'handmade' :
  /alai|alaiwakan|wakan/.test(sourceText)                   ? 'curated-independent' :
  /serpent|serpiente|filu|colgante|treng/.test(sourceText) && /hanger|earring|pendant/.test(sourceText) ? 'hand-assembled' :
  'imported-curated';

const origin: Origin =
  /imported|ali|china|sourced|import/.test(originRaw) ? 'imported-curated' :
  /assembled|ensambl/.test(originRaw)                 ? 'hand-assembled' :
  /independent|curat/.test(originRaw)                 ? 'curated-independent' :
  /handmade|hecho/.test(originRaw)                    ? 'handmade' :
  /forged|forjad/.test(originRaw)                     ? 'hand-forged' :
  inferredOrigin;

const originRow =
  origin === 'hand-forged'        ? { label: en.spec.label_made_in, value: 'Truckee, CA — hand-forged in studio' } :
  origin === 'handmade'           ? { label: en.spec.label_made_in, value: 'Truckee, CA — handmade in studio' } :
  origin === 'hand-assembled'     ? { label: en.spec.label_made_in, value: 'Truckee, CA — hand-assembled by the maker · components sourced, composition is ours' } :
  origin === 'curated-independent' ? { label: 'Origin', value: 'Curated · handmade by an independent silversmith partner' } :
                                    { label: 'Origin', value: 'Curated · international suppliers · not made in our studio' };

const rows = [
  materialText && { label: en.spec.label_material, value: materialText },
  gaugeText && { label: en.spec.label_gauge, value: gaugeText },
  originRow,
  { label: en.spec.label_sizing, href: '/sizing-guide', value: en.spec.sizing_cta },
  { label: en.spec.label_aftercare, href: '/care-guide', value: en.spec.aftercare_cta },
  { label: en.spec.label_returns, href: '/shipping', value: en.spec.returns_cta },
  { label: en.spec.label_custom, href: '/custom-orders', value: en.spec.custom_cta },
].filter(Boolean);
---

<section class="spec-block" aria-label="Product details">
  <dl class="spec-block__table">
    {rows.map(row => (
      <div class="spec-block__row">
        <dt>{row.label}</dt>
        <dd>
          {row.href ? <a href={row.href}>{row.value}</a> : row.value}
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .spec-block {
    border: var(--border-thin);
    background: var(--bone);
    margin: var(--space-4) 0 var(--space-5);
  }

  .spec-block__table {
    margin: 0;
  }

  .spec-block__row {
    display: grid;
    grid-template-columns: minmax(7.5rem, 0.34fr) 1fr;
    border-bottom: var(--border-thin);
  }

  .spec-block__row:last-child {
    border-bottom: 0;
  }

  .spec-block dt,
  .spec-block dd {
    margin: 0;
    padding: var(--space-3);
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  .spec-block dt {
    border-right: var(--border-thin);
    color: var(--fg-soft);
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    letter-spacing: var(--letter-spacing-ritual);
    text-transform: uppercase;
  }

  .spec-block dd {
    color: var(--fg);
  }

  .spec-block a {
    color: var(--ember);
    text-decoration: none;
  }

  .spec-block a:hover {
    color: var(--bronze);
  }

  @media (max-width: 600px) {
    .spec-block__row {
      grid-template-columns: 1fr;
    }

    .spec-block dt {
      border-right: 0;
      padding-bottom: var(--space-1);
    }

    .spec-block dd {
      padding-top: 0;
    }
  }
</style>
