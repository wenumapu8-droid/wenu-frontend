---
// Ritual product hero — frames a product macro photo inside an obsidian
// atmosphere (textile pattern + smoke veil + vignette + ember halo) so any
// product photo, even on a neutral background, reads as "museum sagrado"
// rather than e-commerce listing. Reproduces the energy of the Ritual
// Guardian mockup (img-5) without needing a re-shoot.
interface Props {
  imgSrc: string;
  imgAlt: string;
  imgWidth?: number;
  imgHeight?: number;
  /** Eyebrow above the title (category, e.g. "SEPTUM PIERCING") */
  eyebrow: string;
  /** Main piece name */
  title: string;
  /** Material line (e.g. "STERLING SILVER") */
  material?: string;
  /** Optional limited / one-of-a-kind badge */
  badge?: string;
}
const { imgSrc, imgAlt, imgWidth = 1200, imgHeight = 1500, eyebrow, title, material, badge } = Astro.props;
---
<section class="rph" aria-labelledby="rph-title">
  {/* Atmosphere layers — all decorative, behind the product */}
  <div class="rph__atmosphere" aria-hidden="true">
    {/* Subtle textile pattern as background texture */}
    <picture class="rph__textile">
      <source type="image/avif" srcset="/img/brand/wenu-textil-pattern-real.avif"/>
      <img src="/img/brand/wenu-textil-pattern-real.webp" alt="" loading="lazy" decoding="async"/>
    </picture>
    {/* Radial ember halo under the piece */}
    <div class="rph__halo"></div>
    {/* Smoke veil — uses the altar photo as a soft drift */}
    <picture class="rph__smoke">
      <source type="image/avif" srcset="/img/brand/wenu-altar-humo-real.avif"/>
      <img src="/img/brand/wenu-altar-humo-real.webp" alt="" loading="lazy" decoding="async"/>
    </picture>
    {/* Vignette so edges fall to pure obsidian */}
    <div class="rph__vignette"></div>
    {/* Hidden sigil — small, faint mandala watermark tucked in the upper corner.
        A quiet "you found it" mark, like the homepage symbol but smaller. */}
    <picture class="rph__watermark">
      <source type="image/avif" srcset="/img/brand/wenu-mandala-textil-4svastikas.avif"/>
      <img src="/img/brand/wenu-mandala-textil-4svastikas.webp" alt="" width="72" height="72" loading="lazy" decoding="async"/>
    </picture>
  </div>

  {/* The piece itself — centred, on a "stone slab" plinth */}
  <div class="rph__piece">
    {badge && <span class="rph__badge">{badge}</span>}
    <div class="rph__plinth">
      <img
        class="rph__img"
        src={imgSrc}
        alt={imgAlt}
        width={imgWidth}
        height={imgHeight}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  {/* Symmetric caption — eyebrow / title / material with bullet dividers */}
  <figcaption class="rph__caption">
    <span class="rph__eyebrow">{eyebrow}</span>
    <h1 id="rph-title" class="rph__title">{title}</h1>
    {material && (
      <span class="rph__material">· {material} ·</span>
    )}
  </figcaption>

  {/* Cosmos access — the same spinning portal seal used on the landing, kept
       small and non-invasive. A quiet doorway to the dimensional map. */}
  <a class="rph__portal portal-seal" href="/experience/" title="Enter the cosmic dimensional portal" aria-label="Enter the dimensional portal — a map of Mapuche cosmovision">
    <svg class="portal-seal__text" viewBox="0 0 200 200" aria-hidden="true">
      <defs>
        <path id="rph-portal-textpath" d="M 100,100 m -84,0 a 84,84 0 1,1 168,0 a 84,84 0 1,1 -168,0" fill="none"/>
      </defs>
      <circle cx="100" cy="100" r="92" fill="none" stroke="rgba(245,234,216,0.4)" stroke-width="0.6"/>
      <circle cx="100" cy="100" r="68" fill="none" stroke="rgba(245,234,216,0.2)" stroke-width="0.4"/>
      <text font-size="9.5" letter-spacing="3.5" fill="rgba(245,234,216,0.8)" style="font-family: var(--font-sans, 'Inter', sans-serif);">
        <textPath href="#rph-portal-textpath" startOffset="0%">WENU · MAPU · COSMIC PORTAL · ENTER · WENU · MAPU · COSMIC PORTAL · ENTER · </textPath>
      </text>
    </svg>
    <img class="portal-seal__mandala" src="/img/portal-mandala-white.png" alt="" loading="lazy" decoding="async"/>
  </a>
</section>

<style>
  .rph {
    position: relative;
    background: var(--obsidian, #080706);
    padding: clamp(18px, 2.6vw, 36px) clamp(16px, 3vw, 48px) clamp(28px, 4vw, 48px);
    overflow: hidden;
    isolation: isolate;
  }

  /* Atmosphere stack */
  .rph__atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .rph__textile,
  .rph__textile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.12;
    mix-blend-mode: screen;
  }
  .rph__halo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -42%);
    width: clamp(520px, 76vw, 900px);
    height: clamp(520px, 76vw, 900px);
    background: radial-gradient(circle, rgba(196, 147, 90, 0.22) 0%, rgba(196, 147, 90, 0.08) 28%, transparent 60%);
    border-radius: 50%;
    filter: blur(20px);
  }
  .rph__smoke,
  .rph__smoke img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.28;
    mix-blend-mode: screen;
    filter: blur(2px);
  }
  .rph__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 30%, rgba(8, 7, 6, 0.6) 75%, rgba(8, 7, 6, 0.95) 100%);
  }
  .rph__watermark {
    position: absolute;
    top: clamp(16px, 3vw, 36px);
    right: clamp(16px, 3vw, 40px);
    width: clamp(44px, 5vw, 72px);
    opacity: 0.12;
    mix-blend-mode: screen;
  }
  .rph__watermark img {
    display: block;
    width: 100%;
    height: auto;
    filter: brightness(1.2) sepia(0.18) hue-rotate(-12deg);
  }
  @media (max-width: 480px) {
    .rph__watermark { opacity: 0.09; }
  }

  /* Piece + plinth */
  .rph__piece {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: clamp(20px, 3vw, 36px);
  }
  .rph__badge {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 9.5px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ember, #C4935A);
    background: rgba(8, 7, 6, 0.72);
    border: 1px solid rgba(196, 147, 90, 0.4);
    padding: 6px 14px;
    margin-bottom: 22px;
  }
  .rph__plinth {
    width: min(760px, 92vw);
    aspect-ratio: 1;
    /* Ambient ember bloom behind the piece — gives the orb a warm halo so it
       reads as a luminous body floating in obsidian, not a pasted cut-out. */
    background: radial-gradient(circle at 50% 54%, rgba(196, 147, 90, 0.12) 0%, rgba(196, 147, 90, 0.04) 34%, transparent 60%);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  .rph__img {
    position: relative;
    z-index: 1;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    /* Luminous-orb feather — radial mask dissolves the photo's square edges into
       the obsidian. A white studio background melts to a glowing sphere of light
       presenting the piece; a dark background simply fades into the theme. One
       universal treatment for all products, no per-photo retouching. */
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 54%, #000 48%, rgba(0, 0, 0, 0.55) 67%, transparent 84%);
    mask-image: radial-gradient(ellipse 70% 70% at 50% 54%, #000 48%, rgba(0, 0, 0, 0.55) 67%, transparent 84%);
    filter: drop-shadow(0 18px 52px rgba(8, 7, 6, 0.85)) drop-shadow(0 0 40px rgba(196, 147, 90, 0.16));
  }

  /* Caption — perfectly axial, generous spacing */
  .rph__caption {
    position: relative;
    z-index: 1;
    text-align: center;
    color: var(--bone, #F2EDE4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .rph__eyebrow {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 10.5px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--silver, #A8A39A);
  }
  .rph__title {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1;
    margin: 0;
    color: var(--bone, #F2EDE4);
    text-transform: uppercase;
  }
  .rph__material {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 10.5px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: var(--ember, #C4935A);
    margin-top: 4px;
  }

  /* Cosmos access — spinning portal seal, small + non-invasive.
     Mirrors the landing's .portal-seal (text ring + slow-spinning mandala). */
  .rph__portal {
    position: relative;
    z-index: 1;
    display: block;
    width: clamp(72px, 9vw, 104px);
    height: clamp(72px, 9vw, 104px);
    margin: clamp(28px, 4vw, 44px) auto 0;
    opacity: 0.78;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.4s ease, filter 0.5s ease;
  }
  .rph__portal:hover { opacity: 1; filter: brightness(1.08); }
  .rph__portal:focus-visible {
    outline: 1px solid rgba(245, 234, 216, 0.5);
    outline-offset: 6px;
    border-radius: 50%;
  }
  .portal-seal__text {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: rph-portal-text-spin 28s linear infinite;
    pointer-events: none;
  }
  .portal-seal__mandala {
    position: absolute;
    top: 50%; left: 50%;
    width: 58%;
    height: 58%;
    object-fit: contain;
    transform: translate(-50%, -50%);
    animation: rph-portal-mandala-spin 50s linear infinite;
    pointer-events: none;
  }
  .rph__portal:hover .portal-seal__text { animation-duration: 14s; }
  .rph__portal:hover .portal-seal__mandala { animation-duration: 18s; }
  @keyframes rph-portal-text-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @keyframes rph-portal-mandala-spin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to   { transform: translate(-50%, -50%) rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .portal-seal__text,
    .portal-seal__mandala,
    .rph__portal:hover .portal-seal__text,
    .rph__portal:hover .portal-seal__mandala { animation: none !important; }
  }
</style>
