---
/**
 * Footer — Kiwi-simple, Wenu-dark (2026-06-23 redesign).
 * One Company column · a Newsletter block · social · copyright. Generous air,
 * hairline rules, one accent (ember). The textile crest stays as the single
 * brand touch (the soul), kept subtle. Reversible via git.
 */
const year = new Date().getFullYear();

const API_BASE = import.meta.env.PUBLIC_API_URL?.trim() || 'https://api.wenumapuonline.com';
// Live Wenu Platform backend (Postgres + welcome email + Telegram). The old
// Formspree form (mblrgwya) was dead (404) and dropped every footer signup.
const NEWSLETTER_ENDPOINT = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT?.trim() || `${API_BASE}/newsletter/subscribe`;
// On the HOME, the "Join the First Circle" block is the single signup (Ocin
// 2026-06-26) — hide the flat footer newsletter there to avoid a duplicate.
const isHome = Astro.url.pathname === '/';

const company = [
  { href: '/about',      label: 'About' },
  { href: '/manifesto',  label: 'Manifesto' },
  { href: '/contact',    label: 'Contact' },
  { href: '/shipping',   label: 'Shipping & returns' },
  { href: '/care-guide', label: 'Care' },
  { href: '/initial-jewelry', label: 'Initial jewelry' },
  { href: '/lexicon',    label: 'Lexicon' },
  { href: '/privacy',    label: 'Privacy' },
  { href: '/terms',      label: 'Terms' },
  { href: '/accessibility', label: 'Accessibility' },
];

const socials = [
  { href: 'https://www.instagram.com/wenu__mapu',  label: 'Instagram', glyph: 'ig' },
  { href: 'https://www.facebook.com/wenumapu8',    label: 'Facebook',  glyph: 'fb' },
  { href: 'https://wa.me/message/UKOICGSNP332H1',  label: 'WhatsApp',  glyph: 'wa' },
  { href: 'mailto:marimari@wenumapuonline.com',    label: 'Email',     glyph: 'mail' },
];
---
<footer class="footk" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="visually-hidden">Site footer</h2>

  {/* Brand band — Ocin's own woven Mapuche pattern (IMG_0011, keyed
      white-on-transparent). Replaces the old geometric crest. White on the dark
      footer (Nocturne/Atardecer); flips to dark ink in the light Solar footer
      via the --adapt theme filter. */}
  <div class="wm-textile-band wm-textile-band--adapt footk__textile" aria-hidden="true"></div>

  {/* Moving tagline band (marquee) — seamless infinite loop, gold separators.
      Two identical groups; the track shifts -50% so the second lands exactly where
      the first began. prefers-reduced-motion freezes it (stays readable). */}
  <div class="footk__marquee" aria-hidden="true">
    <div class="footk__marquee-track">
      <span class="footk__marquee-group">
        {Array.from({ length: 4 }).map(() => (
          <>Wenü Mapü <span class="footk__sep">·</span> Tribal ritual jewelry <span class="footk__sep">·</span> Connected to the cosmos <span class="footk__sep">·</span> </>
        ))}
      </span>
      <span class="footk__marquee-group">
        {Array.from({ length: 4 }).map(() => (
          <>Wenü Mapü <span class="footk__sep">·</span> Tribal ritual jewelry <span class="footk__sep">·</span> Connected to the cosmos <span class="footk__sep">·</span> </>
        ))}
      </span>
    </div>
  </div>
  <p class="visually-hidden">Wenü Mapü · Tribal ritual jewelry · Connected to the cosmos</p>

  {/* Wordmark — the closing signature of the site (PNG logo, per brand rule). */}
  <a href="/" class="footk__wordmark" aria-label="Wenu Mapu — home">
    <img src="/logos/wenu-mapu-logo-white.png" alt="Wenü Mapü" width="520" height="150" loading="lazy" decoding="async" />
  </a>

  {/* KODEX −∞ — the signal beneath Wenu Mapu (the living art laboratory).
      A glitching portal; the archive lives at /kodex. */}
  <a href="/kodex" class="footk__kodex" aria-label="Enter KODEX −∞ — the living archive">
    <span class="footk__kodex-mark" data-kodex-glitch>KODEX −∞</span>
    <span class="footk__kodex-sub">the architecture beneath · enter the signal</span>
  </a>
  <script is:inline>
    (() => {
      const el = document.querySelector('[data-kodex-glitch]'); if (!el) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const G = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789∞ΩΔ/#·', t = el.textContent;
      const scr = () => { const t0 = performance.now(); clearInterval(el.__g); el.__g = setInterval(() => { const p = Math.min(1, (performance.now() - t0) / 650); let o = ''; for (let i = 0; i < t.length; i++) o += t[i] === ' ' ? ' ' : (i / t.length < p ? t[i] : G[Math.random() * G.length | 0]); el.textContent = o; if (p >= 1) { el.textContent = t; clearInterval(el.__g); } }, 45); };
      setInterval(() => { if (Math.random() < 0.55) scr(); }, 5200);
      el.closest('a').addEventListener('mouseenter', scr);
    })();
  </script>

  <div class="footk__inner">
    <nav class="footk__company" aria-label="Company">
      <p class="footk__heading">Company</p>
      <ul>
        {company.map(l => (<li><a href={l.href}>{l.label}</a></li>))}
      </ul>
    </nav>

    {!isHome && (
    <div class="footk__news">
      <p class="footk__heading">Newsletter</p>
      <p class="footk__news-line">First access to one-off pieces and quiet announcements from the maker. Sent rarely.</p>
      <form class="footk__form" method="POST" action={NEWSLETTER_ENDPOINT} data-footk-form>
        <input type="hidden" name="_subject" value="Wenu Mapu — newsletter signup (footer)" />
        <input type="hidden" name="list" value="subscriber" />
        <input type="hidden" name="source" value="footer" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="footk__honey" aria-hidden="true" />
        <label class="visually-hidden" for="footk-email">Your email</label>
        <div class="footk__row">
          <input id="footk-email" class="footk__input" type="email" name="email" required placeholder="E-mail" autocomplete="email" />
          <button type="submit" class="btn btn--solid footk__submit">Subscribe</button>
        </div>
        <p class="footk__ok" data-footk-ok hidden role="status">Welcome to the circle.</p>
      </form>
    </div>
    )}
  </div>

  <div class="footk__base">
    <ul class="footk__socials">
      {socials.map(s => (
        <li>
          <a href={s.href} target="_blank" rel="noopener me" aria-label={s.label} class="footk__social">
            {s.glyph === 'ig' && (<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/></svg>)}
            {s.glyph === 'fb' && (<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3 h-3 a3 3 0 0 0 -3 3 v3 H7 v3 h3 v9 h3 v-9 h3 l1 -3 h-4 V7 a1 1 0 0 1 1 -1 h3 z"/></svg>)}
            {s.glyph === 'wa' && (<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"/><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"/></svg>)}
            {s.glyph === 'mail' && (<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 7 L12 13 L21 7"/></svg>)}
          </a>
        </li>
      ))}
    </ul>
    <p class="footk__rights">© {year} Wenu Mapu · Tribal ritual jewelry · Truckee, California</p>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-footk-form]');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const honey = (form.querySelector('input[name="_gotcha"]') as HTMLInputElement | null)?.value;
      const email = (form.querySelector('input[name="email"]') as HTMLInputElement | null)?.value?.trim();
      const source = (form.querySelector('input[name="source"]') as HTMLInputElement | null)?.value || 'footer';
      try {
        if (honey) { throw new Error('bot'); }
        const res = await fetch(form.action, {
          method: 'POST',
          body: JSON.stringify({ email, source, lang: 'en' }),
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        });
        if (res.ok) {
          const row = form.querySelector<HTMLElement>('.footk__row');
          const ok = form.querySelector<HTMLElement>('[data-footk-ok]');
          if (row) row.hidden = true;
          if (ok) ok.hidden = false;
        }
      } catch { /* let the user retry */ }
    });
  }
</script>

<style>
  .footk {
    background: var(--obsidian);
    border-top: 1px solid var(--line);
    color: var(--bone);
  }
  /* KODEX −∞ portal — the hidden signal beneath the site */
  .footk__kodex { display:block; text-align:center; margin:28px auto 0; text-decoration:none; width:max-content; max-width:90vw; }
  .footk__kodex-mark { font-family:'JetBrains Mono', ui-monospace, monospace; font-size:14px; letter-spacing:.3em;
    color:#7a7a7a; transition:color .3s, text-shadow .3s; }
  .footk__kodex:hover .footk__kodex-mark, .footk__kodex:focus-visible .footk__kodex-mark { color:#00f0ff; text-shadow:0 0 14px rgba(0,240,255,.55); }
  .footk__kodex-sub { display:block; font-family:'JetBrains Mono', monospace; font-size:8.5px; letter-spacing:.22em;
    color:#3a3a3a; margin-top:8px; transition:color .3s; }
  .footk__kodex:hover .footk__kodex-sub { color:#6a6a6a; }
  /* Brand textile band (Ocin's pattern) at the footer head — replaces the crest. */
  .footk__textile {
    height: clamp(34px, 5.2vw, 60px);
    margin: clamp(28px, 5vw, 52px) 0 var(--space-2);
    opacity: 0.55;
  }
  /* ── Moving tagline marquee ── */
  .footk__marquee {
    margin-top: var(--space-5);
    overflow: hidden;
    white-space: nowrap;
    border-block: 1px solid var(--line);
    padding: var(--space-3) 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  .footk__marquee-track {
    display: inline-flex;
    width: max-content;
    will-change: transform;
    animation: footk-marquee 42s linear infinite;
  }
  .footk__marquee-group {
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    letter-spacing: var(--letter-spacing-archive);
    text-transform: uppercase;
    color: var(--fg-mute);
    white-space: nowrap;
  }
  .footk__sep { color: var(--ember); margin: 0 0.4em; }
  @keyframes footk-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .footk__marquee:hover .footk__marquee-track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .footk__marquee-track { animation: none; transform: none; }
  }

  .footk__wordmark {
    display: block; text-align: center;
    padding: var(--space-6) var(--gutter) 0;
  }
  .footk__wordmark img {
    width: clamp(220px, 40vw, 360px); height: auto; display: inline-block;
    opacity: 0.95;
  }

  .footk__inner {
    max-width: var(--max-w-narrow);
    margin: 0 auto;
    padding: var(--space-6) var(--gutter) var(--space-6);
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-7);
    align-items: start;
  }
  .footk__heading {
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    letter-spacing: var(--letter-spacing-ritual);
    text-transform: uppercase;
    color: var(--ember);
    margin: 0 0 var(--space-4);
  }
  .footk__company ul { list-style: none; margin: 0; padding: 0; }
  .footk__company li { margin: 0 0 var(--space-3); }
  .footk__company a {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    color: var(--fg-soft);
    text-decoration: none;
    transition: color var(--t-fast);
  }
  .footk__company a:hover { color: var(--ember); }

  .footk__news-line {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--fg-soft);
    margin: 0 0 var(--space-4);
    max-width: 42ch;
  }
  .footk__honey { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .footk__row { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .footk__input {
    flex: 1 1 12rem; min-width: 0;
    background: rgba(8, 7, 6, 0.5);
    border: 1px solid var(--line-bright);
    color: var(--bone);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    padding: var(--space-3) var(--space-4);
  }
  .footk__input::placeholder { color: var(--silver); }
  .footk__input:focus-visible { outline: none; border-color: var(--ember); }
  .footk__ok { margin: var(--space-3) 0 0; font-family: var(--font-serif); font-style: italic; color: var(--bone); }

  .footk__base {
    border-top: 1px solid var(--line);
    max-width: var(--max-w-narrow);
    margin: 0 auto;
    padding: var(--space-5) var(--gutter) var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .footk__socials { list-style: none; display: flex; gap: var(--space-4); margin: 0; padding: 0; }
  .footk__social { color: var(--silver); transition: color var(--t-fast); display: inline-flex; }
  .footk__social:hover { color: var(--ember); }
  .footk__rights {
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    letter-spacing: var(--letter-spacing-archive);
    text-transform: uppercase;
    color: var(--fg-mute);
    text-align: center;
    margin: 0;
  }

  @media (max-width: 640px) {
    .footk__inner { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>
