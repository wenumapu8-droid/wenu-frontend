---
import Logo from './Logo.astro';
import en from '../i18n/en.json';

const year = new Date().getFullYear();

/* Footer simplificado 2026-05-29 (per UX audit jerarquía comercial):
   4 columnas claras (Shop / Learn / Visit / Legal). Antes había 27 links
   repartidos en categorías solapadas — ahora ~18 con intención clara. */
const cols = [
  {
    heading: 'Shop',
    links: [
      { href: '/shop',           label: 'All pieces' },
      { href: '/piercing',       label: 'Piercing jewelry' },
      { href: '/hangers',        label: 'Hangers & weights' },
      { href: '/ear-cuffs',      label: 'Ornaments · amulets' },
      { href: '/custom-orders',  label: 'Atelier · author’s art' },
      { href: '/ritual-objects', label: 'Ritual objects' },
    ],
  },
  {
    heading: 'Learn',
    links: [
      { href: '/about',        label: 'Our story' },
      { href: '/manifesto',    label: 'Manifesto' },
      { href: '/canon',        label: 'Source · the book' },
      { href: '/materials',    label: 'Materials' },
      { href: '/sizing-guide', label: 'Sizing guide' },
      { href: '/care-guide',   label: 'Aftercare' },
      { href: '/journal',      label: 'Journal' },
    ],
  },
  {
    heading: 'Visit',
    links: [
      { href: '/stockists', label: 'Private appointments' },
      { href: '/local',     label: 'Local delivery · Truckee' },
      { href: '/shipping',  label: 'Shipping & returns' },
      { href: '/contact',   label: 'Contact' },
      { href: '/feedback',  label: 'Feedback · share your ritual' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { href: '/terms',         label: 'Terms' },
      { href: '/privacy',       label: 'Privacy' },
      { href: '/accessibility', label: 'Accessibility' },
    ],
  },
];

const socials = [
  { href: 'https://www.instagram.com/wenu__mapu',                 label: 'Instagram', glyph: 'ig' },
  { href: 'https://www.behance.net/wenumapu',                     label: 'Behance',   glyph: 'be' },
  { href: 'https://www.facebook.com/wenumapu8',                   label: 'Facebook',  glyph: 'fb' },
  { href: 'https://wa.me/message/UKOICGSNP332H1',                 label: 'WhatsApp',  glyph: 'wa' },
  { href: 'mailto:marimari@wenumapuonline.com',                   label: 'Email',     glyph: 'mail' },
];
---
<footer class="footer-v2 has-cosmic-veil" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="visually-hidden">Site footer</h2>
  <div class="cosmic-veil cosmic-veil--soft" aria-hidden="true"><span class="cosmic-veil__stars"></span></div>
  <div class="footer-v2__crest" aria-hidden="true">
    <picture>
      <source
        type="image/avif"
        srcset="/img/brand/footer-crest-800w.avif 800w, /img/brand/footer-crest-1200w.avif 1200w, /img/brand/footer-crest-1600w.avif 1600w, /img/brand/footer-crest.avif 1983w"
        sizes="100vw"
      />
      <img
        src="/img/brand/footer-crest-1200w.webp"
        srcset="/img/brand/footer-crest-800w.webp 800w, /img/brand/footer-crest-1200w.webp 1200w, /img/brand/footer-crest-1600w.webp 1600w, /img/brand/footer-crest.webp 1983w"
        sizes="100vw"
        alt=""
        width="1983"
        height="793"
        loading="lazy"
        decoding="async"
      />
    </picture>
  </div>
  <div class="footer-v2__inner">
    <div class="footer-v2__brand">
      <a href="/" class="footer-v2__logo" aria-label="Wenu Mapu home">
        <Logo variant="white" height={64} />
      </a>
    </div>

    {cols.map(col => (
      <nav class="footer-v2__col" aria-label={col.heading}>
        <p class="footer-v2__heading">{col.heading}</p>
        <ul>
          {col.links.map(l => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}

    <div class="footer-v2__follow">
      <p class="footer-v2__heading">{en.footer.follow}</p>
      <ul class="footer-v2__socials">
        {socials.map(s => (
          <li>
            <a href={s.href} target="_blank" rel="noopener me" aria-label={s.label} class="footer-v2__social">
              {s.glyph === 'ig' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="4"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/>
                </svg>
              )}
              {s.glyph === 'be' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 6.5 H9 a3 3 0 0 1 0 6 H3 z"/>
                  <path d="M3 12.5 H9.5 a3 3 0 0 1 0 6 H3 z"/>
                  <path d="M14.5 13.5 a3.5 3 0 1 1 7 0 H14.5 a3.5 3 0 0 0 6 3"/>
                  <path d="M15.5 7.5 H20.5"/>
                </svg>
              )}
              {s.glyph === 'fb' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M16 3 h-3 a3 3 0 0 0 -3 3 v3 H7 v3 h3 v9 h3 v-9 h3 l1 -3 h-4 V7 a1 1 0 0 1 1 -1 h3 z"/>
                </svg>
              )}
              {s.glyph === 'wa' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 21 l1.6 -4.8 a8 8 0 1 1 3.2 3.2 z"/>
                  <path d="M9 10 c0 3 2 5 5 5 l1.4 -1.4 a0.6 0.6 0 0 1 0.7 -0.1 l1.7 0.9 a0.6 0.6 0 0 1 0.3 0.7 c-0.3 1 -1.3 2 -2.4 2 -3.6 0 -7.4 -3.8 -7.4 -7.4 0 -1.1 1 -2.1 2 -2.4 a0.6 0.6 0 0 1 0.7 0.3 l0.9 1.7 a0.6 0.6 0 0 1 -0.1 0.7 z"/>
                </svg>
              )}
              {s.glyph === 'mail' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="1"/>
                  <path d="M3 7 L12 13 L21 7"/>
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer-v2__bar">
    <p class="footer-v2__rights">© {year} {en.footer.rights}</p>
  </div>
</footer>
