---
import en from '../i18n/en.json';
import map from '../i18n/mapudungun.json';
---
<footer class="footer">
  <div class="footer__inner">
    <div>
      <div class="footer__logo">Wenu Mapu</div>
      <p class="footer__ritual">{map.phrases.forged_with_force} {en.footer.ritual.replace('Forged with newen · ', '')}</p>
    </div>
    <div>
      <ul class="footer__links">
        <li><a href="/shop">{en.nav.shop}</a></li>
        <li><a href="/world">{en.nav.world}</a></li>
        <li><a href="/local">{en.nav.local}</a></li>
        <li><a href="/contact">{en.nav.contact}</a></li>
        <li><a href="https://instagram.com/wenu__mapu" target="_blank" rel="noopener">@wenu__mapu</a></li>
        <li><a href="https://www.wenumapuonline.com" target="_blank" rel="noopener">Store</a></li>
      </ul>
      <p class="footer__rights">© {new Date().getFullYear()} {en.footer.rights}</p>
    </div>
  </div>
</footer>
