---
import Logo from './Logo.astro';
import PatternBand from './PatternBand.astro';
import en from '../i18n/en.json';
import map from '../i18n/mapudungun.json';

const year = new Date().getFullYear();

const cols = [
  {
    heading: 'Shop',
    links: [
      { href: '/shop',         label: 'All pieces' },
      { href: '/piercing',     label: 'Piercing' },
      { href: '/hangers',      label: 'Hangers' },
      { href: '/ear-weights',  label: 'Ear weights' },
      { href: '/amulets',      label: 'Amulets' },
      { href: '/ear-cuffs',    label: 'Ear cuffs' },
      { href: '/ritual-objects', label: 'Ritual objects' },
    ],
  },
  {
    heading: 'Materials',
    links: [
      { href: '/materials',               label: 'All materials' },
      { href: '/material/sterling-silver', label: 'Sterling silver' },
      { href: '/material/14k-gold',        label: '14k gold' },
      { href: '/material/titanium',        label: 'Titanium' },
      { href: '/material/vacamuerta',      label: 'Vacamuerta meteorite' },
      { href: '/material/walnut-wood',     label: 'Walnut & wood' },
      { href: '/material/brass-bronze',    label: 'Brass & bronze' },
    ],
  },
  {
    heading: 'Atelier',
    links: [
      { href: '/about',           label: 'Our story' },
      { href: '/artistry',        label: 'Artistry' },
      { href: '/custom-orders',   label: 'Commissions' },
      { href: '/jewelry-styling', label: 'Jewelry curation' },
      { href: '/collection',      label: 'Collections' },
      { href: '/journal',         label: 'Journal' },
    ],
  },
  {
    heading: 'Visit & Help',
    links: [
      { href: '/stockists',    label: 'Appointments' },
      { href: '/care-guide',   label: 'Aftercare' },
      { href: '/sizing-guide', label: 'Sizing guide' },
      { href: '/shipping',     label: 'Shipping & returns' },
      { href: '/faq',          label: 'FAQ' },
      { href: '/contact',      label: 'Contact' },
      { href: '/local',        label: 'Local pickup' },
    ],
  },
];

const socials = [
  { href: 'https://instagram.com/wenu__mapu',     label: 'Instagram', glyph: 'ig' },
  { href: 'https://tiktok.com/@wenumapu',          label: 'TikTok',    glyph: 'tt' },
  { href: 'https://pinterest.com/wenumapu',        label: 'Pinterest', glyph: 'pin' },
  { href: 'mailto:marimari@wenumapuonline.com',    label: 'Email',     glyph: 'mail' },
];
---
<footer class="footer-v2" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="visually-hidden">Site footer</h2>
  <div class="footer-v2__band" aria-hidden="true">
    <PatternBand variant="band" tone="bronze" />
  </div>
  <div class="footer-v2__inner">
    <div class="footer-v2__brand">
      <a href="/" class="footer-v2__logo" aria-label="Wenu Mapu home">
        <Logo height={36} />
      </a>
      <p class="footer-v2__ritual">{map.phrases.forged_with_force}</p>
      <p class="footer-v2__tagline">Truckee, California — private appointments + free local delivery in the Truckee / North Lake Tahoe area.</p>
      <p class="footer-v2__contact-line">
        <a href="mailto:marimari@wenumapuonline.com">marimari@wenumapuonline.com</a>
        <span class="footer-v2__sep">·</span>
        <a href="tel:+14085006211">+1 (408) 500-6211</a>
      </p>
    </div>

    {cols.map(col => (
      <nav class="footer-v2__col" aria-label={col.heading}>
        <p class="footer-v2__heading">{col.heading}</p>
        <ul>
          {col.links.map(l => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}

    <div class="footer-v2__follow">
      <p class="footer-v2__heading">{en.footer.follow}</p>
      <ul class="footer-v2__socials">
        {socials.map(s => (
          <li>
            <a href={s.href} target="_blank" rel="noopener me" aria-label={s.label} class="footer-v2__social">
              {s.glyph === 'ig' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="4"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/>
                </svg>
              )}
              {s.glyph === 'tt' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 4 L14 15 a4 4 0 1 1 -4 -4"/>
                  <path d="M14 4 c0 3 2 5 5 5"/>
                </svg>
              )}
              {s.glyph === 'pin' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="11" r="8"/>
                  <path d="M11 11 L9.5 21"/>
                </svg>
              )}
              {s.glyph === 'mail' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="1"/>
                  <path d="M3 7 L12 13 L21 7"/>
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer-v2__bar">
    <p class="footer-v2__rights">© {year} {en.footer.rights}</p>
    <ul class="footer-v2__legal">
      <li><a href="/terms">{en.footer.terms}</a></li>
      <li><a href="/privacy">{en.footer.privacy}</a></li>
      <li><a href="/accessibility">{en.footer.accessibility}</a></li>
    </ul>
  </div>
</footer>
