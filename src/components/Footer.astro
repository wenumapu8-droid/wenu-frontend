---
import Logo from './Logo.astro';
import en from '../i18n/en.json';
import map from '../i18n/mapudungun.json';

const year = new Date().getFullYear();

const cols = [
  {
    heading: en.footer.shop_heading,
    links: [
      { href: '/shop',                  label: en.footer.all_pieces },
      { href: '/shop?cat=piercing',     label: en.nav.piercing },
      { href: '/shop?cat=hangers',      label: en.nav.hangers },
      { href: '/shop?cat=ear-weights',  label: en.nav.ear_weights },
      { href: '/shop?cat=amulets',      label: en.nav.amulets },
      { href: '/shop?cat=ritual',       label: en.nav.ritual_pieces },
    ],
  },
  {
    heading: en.footer.about_heading,
    links: [
      { href: '/about',         label: en.footer.our_story },
      { href: '/about#materials', label: en.footer.materials },
      { href: '/about#artistry',  label: en.footer.artistry },
      { href: '/about#care',      label: en.footer.care_guide },
      { href: '/about#stockists', label: en.footer.stockists },
    ],
  },
  {
    heading: en.footer.journal_heading,
    links: [
      { href: '/journal#rituals',   label: en.footer.rituals },
      { href: '/journal#cosmology', label: en.footer.cosmology },
      { href: '/journal#ancestry',  label: en.footer.ancestry },
      { href: '/journal#stories',   label: en.footer.stories },
    ],
  },
  {
    heading: en.footer.support_heading,
    links: [
      { href: '/contact#faq',      label: en.footer.faq },
      { href: '/contact#shipping', label: en.footer.shipping_returns },
      { href: '/contact',          label: en.footer.contact_link },
      { href: '/contact#sizing',   label: en.footer.sizing_guide },
    ],
  },
];

const socials = [
  { href: 'https://instagram.com/wenu__mapu',     label: 'Instagram', glyph: 'ig' },
  { href: 'https://tiktok.com/@wenumapu',          label: 'TikTok',    glyph: 'tt' },
  { href: 'https://pinterest.com/wenumapu',        label: 'Pinterest', glyph: 'pin' },
  { href: 'mailto:contact@wenumapuonline.com',     label: 'Email',     glyph: 'mail' },
];
---
<footer class="footer-v2" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="visually-hidden">Site footer</h2>
  <div class="footer-v2__inner">
    <div class="footer-v2__brand">
      <a href="/" class="footer-v2__logo" aria-label="Wenu Mapu home">
        <Logo height={36} />
      </a>
      <p class="footer-v2__ritual">{map.phrases.forged_with_force}</p>
    </div>

    {cols.map(col => (
      <nav class="footer-v2__col" aria-label={col.heading}>
        <p class="footer-v2__heading">{col.heading}</p>
        <ul>
          {col.links.map(l => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}

    <div class="footer-v2__follow">
      <p class="footer-v2__heading">{en.footer.follow}</p>
      <ul class="footer-v2__socials">
        {socials.map(s => (
          <li>
            <a href={s.href} target="_blank" rel="noopener me" aria-label={s.label} class="footer-v2__social">
              {s.glyph === 'ig' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="4"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/>
                </svg>
              )}
              {s.glyph === 'tt' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 4 L14 15 a4 4 0 1 1 -4 -4"/>
                  <path d="M14 4 c0 3 2 5 5 5"/>
                </svg>
              )}
              {s.glyph === 'pin' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="11" r="8"/>
                  <path d="M11 11 L9.5 21"/>
                </svg>
              )}
              {s.glyph === 'mail' && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="1"/>
                  <path d="M3 7 L12 13 L21 7"/>
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer-v2__bar">
    <p class="footer-v2__rights">© {year} Wenu Mapu. All rights reserved.</p>
    <p class="footer-v2__credit">Web design by Northbound</p>
    <ul class="footer-v2__legal">
      <li><a href="/contact#terms">{en.footer.terms}</a></li>
      <li><a href="/contact#privacy">{en.footer.privacy}</a></li>
      <li><a href="/contact#accessibility">{en.footer.accessibility}</a></li>
    </ul>
  </div>
</footer>
