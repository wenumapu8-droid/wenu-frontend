---
/**
 * HeroCarousel — hero rotativo full-bleed con 4-5 slides en crossfade automático.
 * El wordmark WENU MAPU queda fijo; las imágenes (cosmos · cuerpo · paisajes · pieza)
 * se mueven solas cada ~5.5s. El eyebrow cambia con cada slide.
 *
 * Respeta prefers-reduced-motion (muestra el 1º, sin auto-avance) y pausa en hover/focus.
 * Imágenes atmosféricas (regla marca: AI solo atmosférica, nunca producto).
 */
interface Slide {
  img: string; alt: string;
  eyebrow: string; headline: string; sub: string;
  cta: { label: string; href: string };
}
/* 5 slides, 5 doors into the brand. Each = a CLEAN (text-free) image + its own
   copy overlay (HTML, theme-aware) + a CTA to a different area. No baked text. */
const slides: Slide[] = [
  {
    img: '/img/hero/hero-cosmos-eclipse.webp', alt: 'Wenu Mapu — eclipse over the Wallmapu sky',
    eyebrow: 'The Collections', headline: 'Worlds you can wear.',
    sub: 'Each collection is a different sky — forest, volcano, cosmos. Find the one that calls you.',
    cta: { label: 'Explore the collections', href: '/collections' },
  },
  {
    img: '/img/banners/hero/atelier-forge.webp', alt: 'The atelier — silver and gold worked at the forge in Truckee',
    eyebrow: 'The Atelier', headline: "Commission a piece that's only yours.",
    sub: 'Work directly with the maker to forge something one of one — your stone, your story, your sky.',
    cta: { label: 'Start a commission', href: '/custom-orders' },
  },
  {
    /* Ritual piercing slide (Ocin 2026-07-07): piercing lives inside the hero
       rotation, mid-order. Clean text-free body image; copy overlays per the
       shared PiercingBanner language. The section-level PiercingBanner stays. */
    img: '/img/hero/hero-body-eclipse.webp', alt: 'Wenu Mapu — ritual body piercing, Truckee California',
    eyebrow: 'Ritual piercing · Truckee, California', headline: 'Piercing as a passage, not a transaction.',
    sub: 'Ritual body piercing by private appointment in the high Sierra — implant-grade titanium, a sterile single-use needle, and a slow conversation about placement.',
    cta: { label: 'Book a session', href: '/piercing' },
  },
  {
    img: '/img/banners/hero/araucania-lake.webp', alt: 'Araucanía — a moonlit lake among ancient araucaria forest',
    eyebrow: 'Collection · Araucanía', headline: "Rooted in the araucaria's shadow.",
    sub: 'Wood and seed from the old forests of the south.',
    cta: { label: 'Enter Araucanía', href: '/collection/araucania' },
  },
  {
    img: '/img/hero/hero-body-eclipse.webp', alt: 'Adorned body — tribal piercings and ritual silver',
    eyebrow: 'The Studio · Truckee', headline: 'Pierced clean. Healed right.',
    sub: 'APP-trained piercing in the high Sierra — precise, sterile, jewelry that honors the body.',
    cta: { label: 'Book a session', href: '/piercing' },
  },
  {
    img: '/img/banners/hero/atacama-meteorite.webp', alt: 'Atacama — the desert where meteorites fall',
    eyebrow: 'Collection · Atacama Meteorite', headline: 'Worn from what fell from the sky.',
    sub: 'Mesosiderite from the Atacama, hand-cast into ritual silver.',
    cta: { label: 'Enter the collection', href: '/collection/atacama' },
  },
];
const s0 = slides[0];
---

<section class="hero-cx" aria-label="Wenu Mapu — tribal ritual jewelry" data-hero-cx>
  <div class="hero-cx__slides">
    {slides.map((s, i) => (
      <figure class={`hero-cx__slide${i === 0 ? ' is-active' : ''}`} data-slide aria-hidden={i === 0 ? 'false' : 'true'}>
        <img
          src={s.img}
          alt={s.alt}
          width="1920" height="1000"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          decoding="async"
        />
      </figure>
    ))}
    <div class="hero-cx__scrim" aria-hidden="true"></div>
    {/* Per-theme sky wash — same photo, the sky changes colour with the theme.
        Sits above the image + scrim (z 0) but below the copy (z 1). */}
    <div class="hero-cx__wash" aria-hidden="true"></div>
    {/* EXPLORATION (Ocin): maze-emboss carved frame on the dark margins.
        Off by default (clean hero). Toggle for review with #frameA / #frameB. */}
    <div class="hero-cx__frame" aria-hidden="true"></div>
  </div>

  <div class="hero-cx__copy">
    <p class="hero-cx__eyebrow" data-hero-eyebrow>{s0.eyebrow}</p>
    <h1 class="hero-cx__wordmark" data-hero-headline>{s0.headline}</h1>
    <p class="hero-cx__sub" data-hero-sub>{s0.sub}</p>
    <div class="hero-cx__ctas">
      <a href={s0.cta.href} class="hero-cx__cta hero-cx__cta--primary" data-hero-cta>
        <span class="hero-cx__cta-line" aria-hidden="true"></span>
        <span class="hero-cx__cta-label" data-hero-cta-label>{s0.cta.label}</span>
        <span class="hero-cx__cta-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>

  <button type="button" class="hero-cx__arrow hero-cx__arrow--prev" data-hero-prev aria-label="Previous slide">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <button type="button" class="hero-cx__arrow hero-cx__arrow--next" data-hero-next aria-label="Next slide">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
  </button>

  <div class="hero-cx__dots" role="tablist" aria-label="Hero slides" data-hero-dots>
    {slides.map((s, i) => (
      <button type="button" class={`hero-cx__dot${i === 0 ? ' is-active' : ''}`} data-dot={i}
        role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={s.eyebrow}></button>
    ))}
  </div>
</section>

<script is:inline data-hero-copy={JSON.stringify(slides.map(s => ({ e: s.eyebrow, h: s.headline, s: s.sub, l: s.cta.label, u: s.cta.href })))}>
  (function () {
    const root = document.querySelector('[data-hero-cx]');
    if (!root) return;
    // Exploration toggle (Ocin): #frameA / #frameB enable a maze-emboss treatment.
    if (location.hash.includes('frameA')) root.classList.add('is-frame-a');
    else if (location.hash.includes('frameB')) root.classList.add('is-frame-b');
    const slidesEls = Array.from(root.querySelectorAll('[data-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-dot]'));
    const copyEl = root.querySelector('.hero-cx__copy');
    const eyebrowEl = root.querySelector('[data-hero-eyebrow]');
    const headlineEl = root.querySelector('[data-hero-headline]');
    const subEl = root.querySelector('[data-hero-sub]');
    const ctaEl = root.querySelector('[data-hero-cta]');
    const ctaLabelEl = root.querySelector('[data-hero-cta-label]');
    const copy = JSON.parse(document.currentScript.getAttribute('data-hero-copy') || '[]');
    let i = 0, timer = null;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DUR = 6000;

    function go(n) {
      i = (n + slidesEls.length) % slidesEls.length;
      slidesEls.forEach((el, k) => {
        const on = k === i;
        el.classList.toggle('is-active', on);
        el.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
      dots.forEach((d, k) => {
        d.classList.toggle('is-active', k === i);
        d.setAttribute('aria-selected', k === i ? 'true' : 'false');
      });
      const c = copy[i];
      if (c && copyEl) {
        copyEl.style.opacity = '0';
        setTimeout(() => {
          if (eyebrowEl) eyebrowEl.textContent = c.e;
          if (headlineEl) headlineEl.textContent = c.h;
          if (subEl) subEl.textContent = c.s;
          if (ctaLabelEl) ctaLabelEl.textContent = c.l;
          if (ctaEl) ctaEl.setAttribute('href', c.u);
          copyEl.style.opacity = '1';
        }, 240);
      }
    }
    function start() { if (reduce) return; stop(); timer = setInterval(() => go(i + 1), DUR); }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    dots.forEach((d, k) => d.addEventListener('click', () => { go(k); start(); }));
    root.querySelector('[data-hero-prev]')?.addEventListener('click', () => { go(i - 1); start(); });
    root.querySelector('[data-hero-next]')?.addEventListener('click', () => { go(i + 1); start(); });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => { document.hidden ? stop() : start(); });
    start();
  })();
</script>

<style>
  .hero-cx {
    position: relative;
    min-height: 92svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--obsidian);
    isolation: isolate;
  }
  .hero-cx__slides { position: absolute; inset: 0; z-index: -2; }
  .hero-cx__slide {
    position: absolute; inset: 0; margin: 0;
    opacity: 0;
    transition: opacity 1.4s ease, transform 7s ease;
    transform: scale(1.06);
    will-change: opacity;
  }
  .hero-cx__slide.is-active { opacity: 1; transform: scale(1); }
  .hero-cx__slide img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  /* SOLAR (Ocin 2026-06-27): show the hero photos as a NEGATIVE — invert luminance
     but hue-rotate 180° so warm golds stay presentable, not a muddy grey negative.
     The dark scrim + light copy stay (copy sits over the scrimmed band → legible). */
  html[data-theme="solar"] .hero-cx__slide img {
    filter: invert(1) hue-rotate(180deg) saturate(0.9) brightness(0.96);
  }
  /* keep the text band readable over the inverted (lighter) image */
  html[data-theme="solar"] .hero-cx__scrim {
    background:
      radial-gradient(120% 90% at 50% 62%, transparent 0%, rgba(10,10,10,0.55) 62%, rgba(10,10,10,0.9) 100%),
      linear-gradient(180deg, rgba(10,10,10,0.4) 0%, transparent 32%, transparent 50%, rgba(10,10,10,0.92) 100%);
  }
  html[data-theme="solar"] .hero-cx__wash { opacity: 0; }
  /* The inverted hero photo is mostly LIGHT, so flip the copy to dark ink with a
     soft light halo — legible negative, not faint white-on-white. */
  html[data-theme="solar"] :is(.hero-cx__wordmark, .hero-cx__sub) {
    color: #14110c;
    text-shadow: 0 1px 12px rgba(245,240,230,0.75), 0 0 2px rgba(245,240,230,0.9);
  }
  /* Primary CTA is now a solid pill (bone fill / obsidian label). In Solar the
     tokens already invert it to a dark button with a light label — leave it. */
  html[data-theme="solar"] .hero-cx__eyebrow { color: #3a2c10; }

  .hero-cx__scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(120% 90% at 50% 40%, transparent 0%, rgba(10,10,10,0.45) 70%, rgba(10,10,10,0.82) 100%),
      linear-gradient(180deg, rgba(10,10,10,0.55) 0%, transparent 30%, transparent 55%, rgba(10,10,10,0.85) 100%);
  }

  /* ── PER-THEME SKY WASH ──────────────────────────────────────────
     One photo, the sky shifts colour by theme. soft-light keeps the photo
     readable (it tints, doesn't paint over). Nocturne = cool blue-silver dusk;
     Solar = barely-there warm neutral; Atardecer = violet→amber real sunset. */
  .hero-cx__wash {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    mix-blend-mode: soft-light;
    background: linear-gradient(180deg, rgba(38,54,86,0.55) 0%, rgba(20,28,52,0.35) 50%, rgba(10,12,22,0.50) 100%);
    transition: background 0.5s ease;
  }
  html[data-theme="solar"] .hero-cx__wash {
    mix-blend-mode: soft-light;
    background: linear-gradient(180deg, rgba(255,244,220,0.30) 0%, rgba(255,228,188,0.14) 60%, rgba(250,236,214,0.20) 100%);
  }
  html[data-theme="sunset"] .hero-cx__wash {
    mix-blend-mode: overlay;
    background:
      linear-gradient(165deg,
        rgba(108,38,128,0.62) 0%,
        rgba(168,58,118,0.46) 42%,
        rgba(232,150,84,0.40) 78%,
        rgba(246,196,120,0.46) 100%);
  }
  /* second, gentler sunset layer for depth (violet shadow up top) */
  html[data-theme="sunset"] .hero-cx__wash::after {
    content: ''; position: absolute; inset: 0;
    mix-blend-mode: soft-light;
    background: linear-gradient(180deg, rgba(70,24,96,0.55) 0%, transparent 55%);
  }
  @media (prefers-reduced-motion: reduce) { .hero-cx__wash { transition: none; } }

  /* ── MAZE-EMBOSS FRAME (exploration A/B) ─────────────────────────────────────
     Carved stone texture on the dark top/bottom margins of the hero. The eclipse
     photo + copy stay untouched (the mask fades the texture out of the centre).
     Off by default; .is-frame-a / .is-frame-b enable a treatment for review. */
  .hero-cx__frame {
    position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0;
    background: url('/img/brand/textures/maze-emboss-tile.png') repeat center / 300px;
  }
  /* A — subtle carved frame: debossed (invert), low opacity, soft-light, only the
     top & bottom margins (centre masked out so the photo reads clean). */
  .hero-cx.is-frame-a .hero-cx__frame {
    opacity: 0.14;
    filter: invert(1) contrast(0.9) brightness(0.9);   /* debossed (carved-in) */
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 12%, transparent 30%, transparent 70%, #000 88%, #000 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 12%, transparent 30%, transparent 70%, #000 88%, #000 100%);
  }
  /* B — marked inverted accent: a carved bronze frame around all four edges,
     a touch more present (warm tint, radial frame mask). */
  .hero-cx.is-frame-b .hero-cx__frame {
    opacity: 0.30;
    background-size: 240px;
    filter: invert(1) sepia(0.6) saturate(2) hue-rotate(-6deg) brightness(0.7);
    -webkit-mask-image: radial-gradient(128% 98% at 50% 50%, transparent 50%, #000 86%);
    mask-image: radial-gradient(128% 98% at 50% 50%, transparent 50%, #000 86%);
  }
  /* In the light Solar hero, soft-light keeps it from greying out the daylight. */
  html[data-theme="solar"] .hero-cx.is-frame-a .hero-cx__frame,
  html[data-theme="solar"] .hero-cx.is-frame-b .hero-cx__frame { mix-blend-mode: soft-light; }

  .hero-cx__copy { position: relative; text-align: center; padding: 0 24px; z-index: 1; transition: opacity 0.24s ease; }

  /* Prev / next arrows — quiet, on the dark margins, gold on hover. */
  .hero-cx__arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    z-index: 4;
    display: inline-flex; align-items: center; justify-content: center;
    width: clamp(40px, 5vw, 54px); height: clamp(40px, 5vw, 54px);
    background: var(--scrim-soft); color: var(--brand-bone);
    border: 1px solid rgba(201, 168, 76, 0.35);
    -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
    cursor: pointer;
    transition: color var(--t-fast), border-color var(--t-fast), background var(--t-fast);
  }
  .hero-cx__arrow--prev { left: clamp(10px, 2vw, 26px); }
  .hero-cx__arrow--next { right: clamp(10px, 2vw, 26px); }
  .hero-cx__arrow:hover { color: var(--ember); border-color: var(--ember); background: var(--scrim-mid); }
  .hero-cx__arrow:focus-visible { outline: 1px solid var(--ember); outline-offset: 2px; }
  @media (max-width: 540px) {
    .hero-cx__arrow { width: 38px; height: 38px; }
  }

  .hero-cx__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-tiny, 0.72rem);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ember);
    margin: 0 0 var(--space-4, 22px);
    transition: opacity 0.4s ease;
  }
  .hero-cx__wordmark {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 6.5vw, 4.6rem);
    line-height: 1.06;
    letter-spacing: 0.01em;
    color: var(--bone);
    margin: 0;
    text-shadow: 0 2px 40px rgba(0,0,0,0.6);
    max-width: 16ch;
    margin-inline: auto;
    transition: opacity 0.4s ease;
    text-wrap: balance;
  }
  .hero-cx__cta {
    display: inline-flex; align-items: center; gap: 14px;
    margin-top: clamp(28px, 4vw, 48px);
    font-family: var(--font-sans);
    font-size: 0.78rem; letter-spacing: 0.26em; text-transform: uppercase;
    color: var(--bone); text-decoration: none;
    transition: color var(--t-fast, 0.2s);
  }
  .hero-cx__cta-line { width: 30px; height: 1px; background: var(--ember); transition: width var(--t-base, 0.3s); }
  /* Primary CTA reads as a real, legible button (Ocin 2026-06-27): a solid pill
     matching .btn--solid — bone fill, obsidian label — theme-aware via tokens
     (in Solar bone→dark, obsidian→light, so it stays a high-contrast button on
     the inverted hero). The decorative side-lines are dropped here. */
  .hero-cx__cta--primary {
    gap: 0;
    padding: var(--space-3, 14px) var(--space-5, 28px);
    background: var(--bone);
    color: var(--obsidian);
    border: 1px solid var(--bone);
    font-weight: var(--fw-medium, 500);
    transition: background var(--t-base), color var(--t-base), border-color var(--t-base), transform var(--t-fast);
  }
  .hero-cx__cta--primary .hero-cx__cta-line { display: none; }
  .hero-cx__cta--primary:hover {
    background: var(--ember);
    border-color: var(--ember);
    color: var(--obsidian);
    transform: translateY(-2px);
  }

  /* Fixed commercial subline under the rotating headline */
  .hero-cx__sub {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin, 300);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.6;
    color: rgba(240, 237, 232, 0.86);
    max-width: 46ch;
    margin: var(--space-4, 22px) auto 0;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.6);
    text-wrap: balance;
  }

  .hero-cx__ctas {
    display: flex;
    gap: clamp(16px, 3vw, 32px);
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: clamp(24px, 3.5vw, 40px);
  }
  .hero-cx__cta--secondary {
    margin-top: 0;
    color: rgba(240, 237, 232, 0.82);
    border-bottom: 1px solid rgba(198, 168, 106, 0.45);
    padding-bottom: 3px;
    letter-spacing: 0.18em;
  }
  .hero-cx__cta--secondary:hover { color: var(--bone); border-color: var(--bone); }


  .hero-cx__dots {
    position: absolute; left: 0; right: 0; bottom: clamp(20px, 4vh, 40px);
    display: flex; gap: 12px; justify-content: center; z-index: 1;
  }
  .hero-cx__dot {
    width: 8px; height: 8px; border-radius: 50%; padding: 0;
    border: 1px solid rgba(240,237,232,0.5);
    background: transparent; cursor: pointer;
    transition: background var(--t-fast, 0.2s), border-color var(--t-fast, 0.2s), transform var(--t-fast, 0.2s);
  }
  .hero-cx__dot.is-active { background: var(--ember); border-color: var(--ember); transform: scale(1.15); }
  .hero-cx__dot:hover { border-color: var(--ember); }

  @media (prefers-reduced-motion: reduce) {
    .hero-cx__slide { transition: opacity 0.3s ease; transform: none; }
    .hero-cx__slide.is-active { transform: none; }
  }
  @media (max-width: 600px) {
    .hero-cx { min-height: 86svh; }
  }
</style>
