---
/* HeroBookCover — hero rediseñado al lenguaje visual de la tapa
   del libro Wenumapu (Canio & Pozo, OCHOLIBROS 2015).
   Spec: ~/Obsidian/WenuAgent/brand/02-visual-system/spec-hero-rediseno-tapa-libro.md

   Lógica: nebula muy sutil + polvo estelar + constelaciones (Mañke + Trarinmansun +
   Wüñelfe destacada) + wordmark vertical roto WE/NU/MA/PU + sello ritual mínimo +
   CTA "enter the threshold". Sin foto, sin nebula con copyright — todo SVG generado.
*/

interface Props {
  /** Override del CTA — por default va a /shop con copy del spec. */
  ctaHref?: string;
  ctaLabel?: string;
}

const { ctaHref = '/shop', ctaLabel = 'enter the threshold' } = Astro.props;

// Polvo estelar — 220 puntos pseudo-random determinísticos (no animan position,
// solo opacity, así no recomponen layout en mobile). Seed simple para que el
// patrón sea estable build-to-build y no parpadee al SSR.
const STAR_COUNT = 220;
function seededRandom(seed: number) {
  let x = Math.sin(seed) * 10000;
  return x - Math.floor(x);
}
const stardust = Array.from({ length: STAR_COUNT }, (_, i) => ({
  cx: Math.round(seededRandom(i * 1.37 + 1) * 1440),
  cy: Math.round(seededRandom(i * 2.91 + 7) * 900),
  r: 0.4 + seededRandom(i * 3.11 + 13) * 1.3,
  o: 0.35 + seededRandom(i * 4.21 + 19) * 0.55,
}));
---

<section class="hero-book" aria-label="Wenu Mapu — astronomy of the body">
  <!-- Sky background: nebula glow + stardust + constellations -->
  <svg
    class="hero-book__sky"
    viewBox="0 0 1440 900"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <defs>
      <radialGradient id="hb-nebula-purple" cx="20%" cy="30%" r="42%">
        <stop offset="0%" stop-color="#3a1c5e" stop-opacity="0.32" />
        <stop offset="100%" stop-color="#3a1c5e" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="hb-nebula-cyan" cx="82%" cy="62%" r="38%">
        <stop offset="0%" stop-color="#1a4a5e" stop-opacity="0.28" />
        <stop offset="100%" stop-color="#1a4a5e" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="hb-nebula-rose" cx="50%" cy="88%" r="34%">
        <stop offset="0%" stop-color="#5e2c3a" stop-opacity="0.22" />
        <stop offset="100%" stop-color="#5e2c3a" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="hb-milky-way" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#f2ede4" stop-opacity="0.06" />
        <stop offset="60%" stop-color="#f2ede4" stop-opacity="0.02" />
        <stop offset="100%" stop-color="#f2ede4" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Nebula layers — muy sutiles, no compiten con el wordmark -->
    <rect width="100%" height="100%" fill="url(#hb-nebula-purple)" />
    <rect width="100%" height="100%" fill="url(#hb-nebula-cyan)" />
    <rect width="100%" height="100%" fill="url(#hb-nebula-rose)" />

    <!-- Rüpü / Vía Láctea — banda diagonal de polvo más denso -->
    <g class="hero-book__milkyway">
      <ellipse
        cx="720"
        cy="450"
        rx="980"
        ry="55"
        fill="url(#hb-milky-way)"
        transform="rotate(-16 720 450)"
      />
    </g>

    <!-- Polvo estelar -->
    <g class="hero-book__stardust" fill="#F2EDE4">
      {stardust.map(s => (
        <circle cx={s.cx} cy={s.cy} r={s.r.toFixed(2)} opacity={s.o.toFixed(2)} />
      ))}
    </g>

    <!-- CONSTELACIONES — líneas finas + estrellas brillantes -->

    <!-- Mañke (El Cóndor) — top-left, pájaro alas abiertas -->
    <g class="hero-book__constellation" stroke="#F2EDE4" stroke-width="0.4" fill="none" opacity="0.6">
      <line x1="220" y1="180" x2="280" y2="160" />
      <line x1="280" y1="160" x2="340" y2="150" />
      <line x1="280" y1="160" x2="300" y2="220" />
      <line x1="300" y1="220" x2="350" y2="260" />
      <line x1="280" y1="160" x2="240" y2="240" />
    </g>
    <g fill="#F2EDE4">
      <circle cx="220" cy="180" r="1.6" opacity="0.95" />
      <circle cx="280" cy="160" r="2.2" opacity="1" />
      <circle cx="340" cy="150" r="1.8" opacity="0.9" />
      <circle cx="300" cy="220" r="1.4" opacity="0.85" />
      <circle cx="350" cy="260" r="1.5" opacity="0.9" />
      <circle cx="240" cy="240" r="1.3" opacity="0.8" />
    </g>

    <!-- Trarinmansun (Bueyes Enyugados) — bottom-right cuadrado -->
    <g class="hero-book__constellation hero-book__constellation--right" stroke="#F2EDE4" stroke-width="0.4" fill="none" opacity="0.55">
      <line x1="1180" y1="640" x2="1240" y2="620" />
      <line x1="1240" y1="620" x2="1300" y2="660" />
      <line x1="1300" y1="660" x2="1240" y2="700" />
      <line x1="1240" y1="700" x2="1180" y2="640" />
    </g>
    <g class="hero-book__constellation--right" fill="#F2EDE4">
      <circle cx="1180" cy="640" r="1.5" opacity="0.9" />
      <circle cx="1240" cy="620" r="1.7" opacity="0.95" />
      <circle cx="1300" cy="660" r="1.5" opacity="0.9" />
      <circle cx="1240" cy="700" r="1.4" opacity="0.85" />
    </g>

    <!-- Wüñelfe — el lucero del amanecer, una estrella destacada -->
    <g class="hero-book__wunelfe">
      <circle cx="180" cy="780" r="3.5" fill="#F2EDE4" opacity="1" />
      <circle cx="180" cy="780" r="6" fill="none" stroke="#F2EDE4" stroke-width="0.5" opacity="0.4" />
      <circle cx="180" cy="780" r="10" fill="none" stroke="#F2EDE4" stroke-width="0.3" opacity="0.2" />
    </g>
  </svg>

  <!-- Vignette scrim — suaviza el contraste del wordmark sobre la nebula -->
  <div class="hero-book__scrim" aria-hidden="true"></div>

  <!-- Foreground: wordmark + tagline + seal + CTA -->
  <div class="hero-book__copy">
    <h1 class="hero-book__wordmark" aria-label="Wenu Mapu">
      <span class="hero-book__row">WE</span>
      <span class="hero-book__row">NU</span>
      <span class="hero-book__row">MA</span>
      <span class="hero-book__row">PU</span>
    </h1>

    <p class="hero-book__tagline">astronomy of the body</p>

    <!-- Sello ritual mínimo — chakana stepped pattern reducido -->
    <svg
      class="hero-book__seal"
      viewBox="0 0 24 24"
      width="22"
      height="22"
      aria-hidden="true"
    >
      <path
        d="M12 2 L14 6 L18 6 L14.5 9 L16 13 L12 11 L8 13 L9.5 9 L6 6 L10 6 Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        stroke-linejoin="round"
      />
    </svg>

    <a href={ctaHref} class="hero-book__cta">
      <span class="hero-book__cta-line" aria-hidden="true"></span>
      <span class="hero-book__cta-label">{ctaLabel}</span>
      <span class="hero-book__cta-line" aria-hidden="true"></span>
    </a>
  </div>
</section>
