---
/**
 * CertificationsGallery — espacio visual para las certificaciones de Nicolás Ortega.
 * Imágenes reales (JPG/Drive → webp local) en /public/img/piercing/certs/*.webp.
 * Click → abre el certificado completo en pestaña nueva.
 *
 * Para agregar una certificación nueva: optimiza a webp (~80KB), déjala en
 * /public/img/piercing/certs/ y añade una entrada al array `certs` abajo.
 */
interface Cert {
  img: string;
  href?: string;     // documento completo a abrir (PDF). Si falta, abre la imagen.
  title: string;     // qué acredita
  issuer: string;    // organización
  date: string;      // legible, ej "Nov 2025"
  mentor?: string;   // instructor/mentor si aplica
}
import MarqueeDrag from './MarqueeDrag.astro';

const certs: Cert[] = [
  {
    img: '/img/piercing/certs/app-conference-2026.webp',
    title: 'Annual Conference & Exposition 2026 — Recognition of Attendance',
    issuer: 'Association of Professional Piercers (APP)',
    date: 'Jun 2026',
  },
  {
    img: '/img/piercing/certs/app-transcript-2026.webp',
    href: '/img/piercing/certs/app-transcript-2026.pdf',
    title: 'Official Transcript — Continuing Education Units (CEUs) · 29th Annual Conference 2026',
    issuer: 'Association of Professional Piercers (APP)',
    date: 'Jun 2026',
  },
  {
    img: '/img/piercing/certs/corpo-territorio-2026.webp',
    title: 'Simpósio Solidário para Piercers — Participation',
    issuer: 'Corpo Território · Coletivo Sala Solidária',
    date: 'Apr 2026',
  },
  {
    img: '/img/piercing/certs/aha-bbp-2023.webp',
    title: 'Heartsaver — Bloodborne Pathogens Course',
    issuer: 'American Heart Association',
    date: 'Jul 2023',
  },
  {
    img: '/img/piercing/certs/aha-firstaid-cpr-aed-2023.webp',
    title: 'Heartsaver — First Aid · CPR · AED',
    issuer: 'American Heart Association',
    date: 'Mar 2023',
  },
  {
    img: '/img/piercing/certs/ppc-2026-01-11-nasal-masterclass.webp',
    title: 'Master Class — Nasal Piercings',
    issuer: 'Professional Piercers Collective',
    date: 'Jan 2026',
    mentor: 'Javier Techera',
  },
  {
    img: '/img/piercing/certs/ppc-2025-11-23-continuing.webp',
    title: 'Continuing Education — Technique & Solutions',
    issuer: 'Professional Piercers Collective',
    date: 'Nov 2025',
    mentor: 'Raúl Rak',
  },
  {
    img: '/img/piercing/certs/ppc-2025-11-16-anatomy.webp',
    title: 'Continuing Education — Anatomy & Needle Technique',
    issuer: 'Professional Piercers Collective',
    date: 'Nov 2025',
    mentor: 'Bryan Gutiérrez',
  },
  {
    img: '/img/piercing/certs/ppc-2025-11-02-business.webp',
    title: 'Continuing Education — Studio Practice',
    issuer: 'Professional Piercers Collective',
    date: 'Nov 2025',
  },
  {
    img: '/img/piercing/certs/bbp-bloodborne-2026.webp',
    title: 'Bloodborne Pathogens — Exposure Control Training',
    issuer: 'Body Art Training Group (OSHA / CA Safe Body Art Act)',
    date: 'Apr 2026',
  },
];
---

<section class="certs" aria-labelledby="certs-title">
  <div class="container certs__head">
    <p class="eyebrow">Certifications</p>
    <h2 id="certs-title" class="certs__title">Trained, certified, accountable.</h2>
    <p class="certs__lede">
      Ongoing education with the Professional Piercers Collective and mentors across
      the craft. Tap any certificate to see it in full.
    </p>
  </div>

  <div class="certs__marquee" data-explore-marquee>
    <ul class="certs__track">
    {[...certs, ...certs].map((c, i) => (
      <li class="cert-card" aria-hidden={i >= certs.length ? 'true' : undefined}>
        <a href={c.href || c.img} target="_blank" rel="noopener noreferrer" class="cert-card__link"
           tabindex={i >= certs.length ? -1 : undefined}
           aria-label={`${c.title} — ${c.issuer}, ${c.date}. View full certificate`}>
          <div class="cert-card__img-wrap">
            <img src={c.img} alt={`${c.title} — ${c.issuer}`} loading="lazy" decoding="async" width="850" height="1100" />
          </div>
          <div class="cert-card__caption">
            <p class="cert-card__title">{c.title}</p>
            <p class="cert-card__meta">
              <span>{c.issuer}</span>
              <span aria-hidden="true">·</span>
              <span>{c.date}</span>
            </p>
            {c.mentor && <p class="cert-card__mentor">Mentor · {c.mentor}</p>}
          </div>
        </a>
      </li>
    ))}
    </ul>
  </div>
  <MarqueeDrag />
</section>

<style>
  .certs {
    background: var(--obsidian);
    padding: clamp(72px, 9vw, 128px) 0;
    border-top: var(--border-thin);
  }
  .certs__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--space-6);
  }
  .certs__title {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.05;
    color: var(--bone);
    margin: var(--space-3) 0 var(--space-4);
  }
  .certs__lede {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-style: italic;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.6;
    color: var(--fg-soft);
    margin: 0;
  }
  /* Auto-scrolling certificate band (marquee) — list rendered twice, shifts
     -50% for a seamless loop. Hover/focus pause; reduced-motion → manual scroll. */
  .certs__marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }
  .certs__track {
    list-style: none; padding: 0; margin: 0;
    display: flex; gap: var(--space-4); width: max-content;
    animation: certs-scroll 80s linear infinite; will-change: transform;
  }
  .certs__marquee:hover .certs__track,
  .certs__marquee:focus-within .certs__track { animation-play-state: paused; }
  @keyframes certs-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .cert-card { flex: 0 0 clamp(200px, 22vw, 264px); }
  @media (prefers-reduced-motion: reduce) {
    .certs__marquee { overflow-x: auto; }
    .certs__track { animation: none; }
  }
  .certs__grid-unused {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-4);
  }
  .cert-card { background: var(--bg-alt); border: var(--border-thin); }
  .cert-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: background var(--t-base), transform var(--t-base);
  }
  .cert-card__link:hover,
  .cert-card__link:focus-visible { background: var(--bg-lift); outline: none; }
  .cert-card__img-wrap {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--product-panel);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cert-card__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--t-slow);
  }
  .cert-card__link:hover .cert-card__img-wrap img { transform: scale(1.03); }
  .cert-card__caption { padding: var(--space-3) var(--space-3) var(--space-4); border-top: var(--border-accent); }
  .cert-card__title {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: 1.02rem;
    line-height: 1.2;
    color: var(--bone);
    margin: 0 0 var(--space-1);
  }
  .cert-card__meta {
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    letter-spacing: var(--letter-spacing-ritual);
    text-transform: uppercase;
    color: var(--silver);
    margin: 0;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .cert-card__mentor {
    font-family: var(--font-sans);
    font-size: var(--fs-tiny);
    letter-spacing: var(--letter-spacing-ritual);
    text-transform: uppercase;
    color: var(--ember);
    margin: var(--space-1) 0 0;
  }
  @media (max-width: 600px) {
    .certs__grid { grid-template-columns: 1fr 1fr; }
  }
</style>
