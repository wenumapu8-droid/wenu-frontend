      rotate(calc((var(--z) - 5) * 1.4deg))
      scale(1);
    transition: transform 0.55s cubic-bezier(0.65, 0, 0.2, 1), opacity 0.4s ease;
  }
  /* only the top card (highest --z == CARD_COUNT) is crisp; lower ones recede */
  .oracle__fan.is-stacked .oracle-card:not([style*="--z:5"]) {
