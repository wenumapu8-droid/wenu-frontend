<script>
  /* PowerAnimalsOracle — card-draw deck, vanilla JS, sin frameworks. */
  type AnimalPiece = {
    slug: string;
    name: string;
    price: string;
    img: string | null;
    imgAlt: string;
  };

  type AnimalData = {
    slug: string;
    name: string;
    arn: string;
    meaning: string;
    reading: string;
    avif: string;
    webp: string;
    alt: string;
    pieces: AnimalPiece[];
  };

  const root = document.querySelector<HTMLElement>('[data-oracle-root]');
  if (root) {
    const payloadEl = root.querySelector<HTMLScriptElement>('[data-oracle-payload]');
    const data: AnimalData[] = payloadEl ? JSON.parse(payloadEl.textContent || '[]') : [];

    const stage   = root.querySelector<HTMLElement>('[data-oracle-stage]');
    const fan      = root.querySelector<HTMLElement>('[data-oracle-fan]');
    const caption  = root.querySelector<HTMLElement>('[data-oracle-caption]');
    const cards    = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-oracle-card]'));
    const againBtn = root.querySelector<HTMLButtonElement>('[data-oracle-again]');

    const arnEl      = root.querySelector<HTMLElement>('[data-oracle-arn]');
    const nameEl     = root.querySelector<HTMLElement>('[data-oracle-name]');
    const meaningEl  = root.querySelector<HTMLElement>('[data-oracle-meaning]');
    const readingEl  = root.querySelector<HTMLElement>('[data-oracle-reading]');
    const shopLink   = root.querySelector<HTMLAnchorElement>('[data-oracle-shop]');
    const piecesWrap   = root.querySelector<HTMLElement>('[data-oracle-pieces]');
    const piecesList   = root.querySelector<HTMLElement>('[data-oracle-pieces-list]');
    const piecesLabel  = root.querySelector<HTMLElement>('[data-oracle-pieces-label]');
    const piecesEmpty  = root.querySelector<HTMLElement>('[data-oracle-pieces-empty]');

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const revealBtn = root.querySelector<HTMLButtonElement>('[data-oracle-reveal]');
    const promptEn  = root.querySelector<HTMLElement>('.oracle__prompt-en');
    const PROMPT_IDLE    = 'Tap the deck to shuffle';
    const PROMPT_SHUFFLE = 'Shuffling the deck…';
    const PROMPT_CHOOSE  = 'Choose the card that calls you';
    const PROMPT_PICK    = 'Tap the card again to reveal · or choose another';

    const deckHint = root.querySelector<HTMLElement>('[data-oracle-deck-hint]');

    let selectedCard: HTMLButtonElement | null = null;
    let revealed = false;
    let deckOpen = false;
    let shuffling = false;
    let shuffleTimer = 0;

    /* Stage 0 — the deck starts stacked (collapsed). First tap SHUFFLES the deck
       (a slow, calm riffle) and THEN fans it open. No card is auto-selected — the
       user chooses one afterwards. reduced-motion → spread instantly, no shuffle. */
    const SHUFFLE_MS = 2200;   // must match the shuffle CSS animation duration
    const openDeck = () => {
      if (deckOpen || shuffling) return;

      const finishOpen = () => {
        shuffling = false;
        deckOpen = true;
        stage?.classList.remove('is-stacked');
        fan?.classList.remove('is-stacked', 'is-shuffling');
        fan?.classList.add('is-opening');
        fan?.setAttribute('aria-expanded', 'true');
        // Once open the wrapper is no longer the tap target; cards take over.
        fan?.removeAttribute('role');
        fan?.setAttribute('tabindex', '-1');
        if (promptEn) promptEn.textContent = PROMPT_CHOOSE;
        // Drop the deal-animation class only AFTER every card has landed, so no
        // card snaps mid-flight. Last card: delay (4·0.16s) + duration (0.92s)
        // ≈ 1.56s; give it a little headroom.
        window.setTimeout(() => fan?.classList.remove('is-opening'), 1750);
      };

      if (prefersReduced) { finishOpen(); return; }

      // Ceremonial phase: rock + riffle the stacked deck in place, then spread.
      shuffling = true;
      if (promptEn) promptEn.textContent = PROMPT_SHUFFLE;
      if (deckHint) deckHint.style.display = 'none';
      fan?.classList.add('is-shuffling');
      shuffleTimer = window.setTimeout(finishOpen, SHUFFLE_MS);
    };

    /* Return to the stacked deck (used by "Draw again"). */
    const closeDeck = () => {
      deckOpen = false;
      shuffling = false;
      if (shuffleTimer) { window.clearTimeout(shuffleTimer); shuffleTimer = 0; }
      stage?.classList.add('is-stacked');
      fan?.classList.add('is-stacked');
      fan?.classList.remove('is-shuffling', 'is-opening');
      fan?.setAttribute('role', 'button');
      fan?.setAttribute('tabindex', '0');
      fan?.setAttribute('aria-expanded', 'false');
      if (deckHint) deckHint.style.display = '';
      if (promptEn) promptEn.textContent = PROMPT_IDLE;
    };

    /* prefers-reduced-motion → skip the ritual open, present the fan directly. */
    if (prefersReduced) {
      openDeck();
      if (deckHint) deckHint.style.display = 'none';
    }

    /* Stage 1 — a tap selects a card (lifts + glows, others dim). */
    const select = (card: HTMLButtonElement) => {
      if (!deckOpen) return;   // ignore until the deck is fanned open
      if (revealed) return;
      if (selectedCard === card) { reveal(); return; }  // second tap on same card reveals
      selectedCard = card;
      cards.forEach(c => c.classList.toggle('is-selected', c === card));
      stage?.classList.add('is-selecting');
      fan?.classList.add('is-selecting');
      if (promptEn) promptEn.textContent = PROMPT_PICK;
      if (revealBtn) {
        revealBtn.hidden = false;
        void revealBtn.offsetWidth;
        revealBtn.classList.add('is-shown');
      }
    };

    /* Stage 2 — the chosen card flips and the guardian is revealed. */
    const reveal = () => {
      if (revealed || !selectedCard || !fan || !caption || data.length === 0) return;
      revealed = true;
      const card = selectedCard;

      if (revealBtn) { revealBtn.classList.remove('is-shown'); revealBtn.hidden = true; }
      stage?.classList.remove('is-selecting');
      fan.classList.remove('is-selecting');
      card.classList.remove('is-selected');

      const chosen = data[Math.floor(Math.random() * data.length)];

      // Fill the chosen card's front face with the guardian
      const avifSrc = card.querySelector<HTMLSourceElement>('[data-card-avif]');
      const imgEl   = card.querySelector<HTMLImageElement>('[data-card-img]');
      const arnMini = card.querySelector<HTMLElement>('[data-card-arn-mini]');
      if (avifSrc) avifSrc.setAttribute('srcset', chosen.avif);
      if (imgEl)   { imgEl.src = chosen.webp; imgEl.alt = chosen.alt; }
      if (arnMini) arnMini.textContent = chosen.arn;

      // Centre the drawn card within the fan (layout-space, transform-agnostic)
      if (fan) {
        const shift = fan.clientWidth / 2 - (card.offsetLeft + card.offsetWidth / 2);
        card.style.setProperty('--draw-shift', `${shift}px`);
      }

      stage?.classList.add('is-drawing');
      fan.classList.add('is-drawing');
      card.classList.add('is-chosen');

      // Caption content
      if (arnEl)     arnEl.textContent = `${chosen.arn} · ${chosen.name}`;
      if (nameEl)    nameEl.textContent = chosen.name;
      if (meaningEl) meaningEl.textContent = chosen.meaning;
      if (readingEl) readingEl.textContent = chosen.reading;
      if (shopLink)  shopLink.href = `/shop?guardian=${chosen.slug}`;

      // Pieces aligned with the guardian — populate or fall back
      if (piecesWrap && piecesList && piecesEmpty) {
        piecesList.innerHTML = '';
        const pieces = Array.isArray(chosen.pieces) ? chosen.pieces : [];
        if (pieces.length > 0) {
          if (piecesLabel) {
            piecesLabel.textContent = `Pieces aligned with ${chosen.name}`;
          }
          pieces.forEach(piece => {
            const li = document.createElement('li');
            li.className = 'oracle-piece';
            const safeName = piece.name.replace(/</g, '&lt;');
            const safeAlt  = (piece.imgAlt || piece.name).replace(/"/g, '&quot;');
            const media = piece.img
              ? `<span class="oracle-piece__media"><img src="${piece.img}" alt="${safeAlt}" loading="lazy" decoding="async" /></span>`
              : `<span class="oracle-piece__media" aria-hidden="true"></span>`;
            li.innerHTML = `
              <a href="/p/${piece.slug}">
                ${media}
                <p class="oracle-piece__name">${safeName}</p>
                <p class="oracle-piece__price">${piece.price}</p>
              </a>
            `;
            piecesList.appendChild(li);
          });
          piecesWrap.hidden = false;
          piecesEmpty.hidden = true;
        } else {
          piecesWrap.hidden = true;
          piecesEmpty.hidden = false;
        }
      }

      const delay = prefersReduced ? 200 : 900;
      window.setTimeout(() => {
        caption.hidden = false;
        void caption.offsetWidth;
        caption.classList.add('is-shown');
      }, delay);
    };

    const reset = () => {
      if (!fan || !caption) return;
      caption.classList.remove('is-shown');
      window.setTimeout(() => {
        caption.hidden = true;
        stage?.classList.remove('is-drawing');
        fan.classList.remove('is-drawing');
        stage?.classList.remove('is-selecting');
        fan.classList.remove('is-selecting');
        cards.forEach(c => {
          c.classList.remove('is-chosen');
          c.classList.remove('is-selected');
          c.style.removeProperty('--draw-shift');
        });
        // Reset guardian-pieces preview between draws
        if (piecesWrap)  piecesWrap.hidden  = true;
        if (piecesEmpty) piecesEmpty.hidden = true;
        if (piecesList)  piecesList.innerHTML = '';
        if (revealBtn) { revealBtn.classList.remove('is-shown'); revealBtn.hidden = true; }
        if (promptEn) promptEn.textContent = PROMPT_IDLE;
        selectedCard = null;
        revealed = false;
        // Re-stack the deck for a fresh draw (unless reduced-motion keeps it open).
        if (!prefersReduced) closeDeck();
      }, prefersReduced ? 120 : 320);
    };

    // Open the deck. On mobile the stacked wrapper collapses oddly and touch
    // events can be swallowed, so we listen for BOTH pointerup and click and
    // guard against double-firing. A single confirmed tap opens the fan.
    let openingLock = false;
    const tryOpenDeck = (e?: Event) => {
      if (deckOpen || shuffling) return;
      // pointerup fires before the synthetic click; lock so click doesn't re-run.
      if (openingLock) return;
      openingLock = true;
      window.setTimeout(() => { openingLock = false; }, 400);
      e?.preventDefault?.();
      openDeck();
    };
    // pointerup covers touch + mouse + pen reliably; click is the fallback.
    fan?.addEventListener('pointerup', tryOpenDeck);
    fan?.addEventListener('click', tryOpenDeck);
    fan?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (deckOpen || shuffling) return;
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
        e.preventDefault();
        openDeck();
      }
    });

    // Each card: if the deck is still stacked, a tap opens it (belt-and-
    // suspenders with the wrapper handler above, since the sized wrapper and
    // the cards both sit under the finger). Once open, a tap selects.
    cards.forEach(card => {
      card.addEventListener('click', () => {
        if (!deckOpen) { tryOpenDeck(); return; }
        select(card);
      });
    });
    revealBtn?.addEventListener('click', reveal);
    againBtn?.addEventListener('click', reset);
  }
</script>
