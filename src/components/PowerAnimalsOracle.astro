---
/**
 * PowerAnimalsOracle — interactive Mapuche guardian oracle (CARD DECK edition).
 *
 * UX: el usuario saca una carta de verdad de nuestro oráculo.
 *   1. Un abanico de cartas boca-abajo (dorso = chakana sagrada).
 *   2. Al elegir una → las demás se desvanecen, la elegida se centra y gira (flip 3D).
 *   3. Reveal del animal-guardián en la cara de la carta + nombre EN + Mapudungun +
 *      significado + CTA a explorar piezas + "Draw again".
 *
 * Datos en `en.power_animals.items`.
 * Assets: dorso /logos/wenu-chakana.png · guardianes /img/power-animals/<slug>-560w.{avif,webp}
 */
import en from '../i18n/en.json';
import { getProducts, formatPrice, decodeEntities } from '../lib/woo';
import type { WooProduct } from '../lib/woo';

const ANIMALS = ['puma', 'condor', 'serpiente', 'zorro', 'ballena', 'pudu'] as const;
const items = en.power_animals.items as Record<string, { name: string; arn: string; meaning: string }>;

/**
 * Guardian → product mapping (heuristic, server-side, build-time).
 * Sin tags WC todavía → matcheamos por palabras clave en slug + name + description +
 * categorías + atributos (material). Cada animal lleva un set de keywords que reflejan
 * su "energía" según la dirección visual ritual:
 *   - puma:      poder/peso/titanio → hangers gruesos, ear weights
 *   - condor:    altura/silver/plata → plumas, ear weights livianos en plata
 *   - serpiente: bronze/snake/ouroboros/spiral → bronce, espirales, serpientes
 *   - zorro:     intricate/small/septum → piezas pequeñas detalladas
 *   - ballena:   onyx/lapis/depth/azul/oscuro → piedras azules/profundas
 *   - pudu:      wood/madera/small/soft/horn → piezas pequeñas en madera/asta
 */
const GUARDIAN_KEYWORDS: Record<string, RegExp> = {
  puma:      /titanium|titanio|heavy|hanger|weight|peso|grande|large|black/i,
  condor:    /silver|plata|feather|pluma|condor|sterling|light|earring/i,
  serpiente: /bronze|bronce|brass|serpent|snake|serpiente|spiral|espiral|ouroboros|cobre|copper/i,
  zorro:     /intricate|ornament|carved|nose|septum|small|fine|delicate|filigree|filigrana/i,
  ballena:   /onyx|lapis|blue|azul|depth|deep|stone|piedra|amethyst|amatista|dark|obsidian/i,
  pudu:      /wood|madera|horn|asta|bone|hueso|organic|natural|small|pequeñ/i,
};

const PLACEHOLDER_IMG_RE = /chatgpt-image|sin-?titulo|sin-?t[íi]tulo|placeholder|untitled/i;

let allProducts: WooProduct[] = [];
try {
  allProducts = await getProducts();
} catch (err) {
  console.warn('[PowerAnimalsOracle] getProducts failed, oracle will render without suggestions:', err);
}

function scoreProduct(p: WooProduct, re: RegExp): number {
  const hay =
    p.slug + ' ' +
    p.name + ' ' +
    (p.short_description || '') + ' ' +
    (p.description || '') + ' ' +
    p.categories.map(c => c.slug + ' ' + c.name).join(' ') + ' ' +
    p.attributes.flatMap(a => a.options).join(' ');
  const matches = hay.match(new RegExp(re, 'gi'));
  return matches ? matches.length : 0;
}

function pickGuardianProducts(animal: string): Array<{
  slug: string;
  name: string;
  price: string;
  img: string | null;
  imgAlt: string;
}> {
  if (allProducts.length === 0) return [];
  const re = GUARDIAN_KEYWORDS[animal];
  if (!re) return [];

  const eligible = allProducts.filter(p =>
    p.images.length > 0 &&
    p.images[0]?.src &&
    !PLACEHOLDER_IMG_RE.test(p.images[0].src) &&
    p.status === 'publish'
  );

  const ranked = eligible
    .map(p => ({ p, score: scoreProduct(p, re) }))
    .filter(x => x.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, 3)
    .map(x => ({
      slug: x.p.slug,
      name: decodeEntities(x.p.name),
      price: formatPrice(x.p.price),
      img: x.p.images[0]?.src ?? null,
      imgAlt: x.p.images[0]?.alt || decodeEntities(x.p.name),
    }));

  return ranked;
}

const guardianProducts: Record<string, ReturnType<typeof pickGuardianProducts>> = Object.fromEntries(
  ANIMALS.map(slug => [slug, pickGuardianProducts(slug)])
);

/**
 * Oracle readings — 2 líneas en voz dark-luxury ritual, una por guardián.
 * No académicas, no decorativas: cada lectura le da al usuario un espejo breve.
 * (Si Ocin valida los textos en Mapudungun con un kimche, mover lectures a i18n.)
 */
const READINGS: Record<string, string> = {
  puma:      'The Puma appears when your presence must become your statement. Stand in your territory without asking for permission.',
  condor:    'The Condor circles above what you cannot yet see. Trust the height — the wider view is waiting for your patience.',
  serpiente: 'The Serpent moves between what was and what becomes. Shed what no longer fits. The body remembers, the body renews.',
  zorro:     'The Fox walks the threshold others miss. Listen for the path that doesn\'t announce itself — yours is the doubled trail.',
  ballena:   'The Whale carries the long memory. Slow down. The deep current already knows the way you are searching for.',
  pudu:      'The Pudú appears when softness is the medicine. The smallest body still casts its shadow — move quietly, but move.',
};

const oracleData = ANIMALS.map(slug => ({
  slug,
  name: items[slug].name,
  arn: items[slug].arn,
  meaning: items[slug].meaning,
  reading: READINGS[slug],
  avif: `/img/power-animals/${slug}-560w.avif`,
  webp: `/img/power-animals/${slug}-560w.webp`,
  alt: `Wenu Mapu — ${items[slug].name} (${items[slug].arn}) power-animal edition`,
  pieces: guardianProducts[slug] ?? [],
}));

// Fanned deck — 5 cards. Pre-compute the arc so each card sits in the spread.
const CARD_COUNT = 5;
const mid = (CARD_COUNT - 1) / 2;
const cards = Array.from({ length: CARD_COUNT }, (_, i) => ({
  i,
  rot: (i - mid) * 7,                 // -14° … +14°
  lift: Math.abs(i - mid) * 16,       // outer cards drop, center rides high
  z: CARD_COUNT - Math.abs(i - mid),  // center card on top
  // deal order: cards leave the stack from the top of the pile downward
  // (top card = highest --z deals first), so the fan builds outward-in.
  deal: CARD_COUNT - (CARD_COUNT - Math.abs(i - mid)),
}));
---

<section class="oracle" aria-labelledby="oracle-title" data-oracle-root>
  <div class="container oracle__inner">
    <p class="eyebrow">{en.power_animals.eyebrow}</p>
    <h2 id="oracle-title" class="oracle__title">{en.power_animals.title}</h2>
    <p class="oracle__lede">{en.power_animals.lede}</p>

    <div class="oracle__stage is-stacked" data-oracle-stage>
      <p class="oracle__prompt" data-oracle-prompt>
        <span class="oracle__prompt-en">Tap the deck to shuffle</span>
        <span class="oracle__prompt-arn" lang="arn">Witrañpüramün ñi pewma — draw your dream</span>
      </p>

      <div class="oracle__fan is-stacked" data-oracle-fan role="button" tabindex="0"
           aria-label="Open the oracle deck — tap to fan out the guardian cards"
           aria-expanded="false">
        {cards.map(card => (
          <button
            type="button"
            class="oracle-card"
            data-oracle-card
            style={`--rot:${card.rot}deg; --lift:${card.lift}px; --z:${card.z}; --i:${card.i}; --deal:${card.deal};`}
            aria-label="Draw a guardian card from the oracle"
          >
            <span class="oracle-card__flip">
              {/* Dorso — chakana sagrada con filigrana */}
              <span class="oracle-card__face oracle-card__back" aria-hidden="true">
                <span class="oracle-card__edge"></span>
                <span class="oracle-card__edge-inner"></span>
                {/* Filigree corners — 1 SVG · 4 rotaciones via CSS */}
                <svg class="oracle-card__corner oracle-card__corner--tl" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.55" stroke-linecap="round"><path d="M2 12 V4 a2 2 0 0 1 2 -2 H12"/><path d="M6 8 q3 -2 6 0"/><path d="M5 12 q1 -3 4 -4"/><circle cx="9" cy="9" r="0.9" fill="currentColor"/></svg>
                <svg class="oracle-card__corner oracle-card__corner--tr" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.55" stroke-linecap="round"><path d="M2 12 V4 a2 2 0 0 1 2 -2 H12"/><path d="M6 8 q3 -2 6 0"/><path d="M5 12 q1 -3 4 -4"/><circle cx="9" cy="9" r="0.9" fill="currentColor"/></svg>
                <svg class="oracle-card__corner oracle-card__corner--bl" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.55" stroke-linecap="round"><path d="M2 12 V4 a2 2 0 0 1 2 -2 H12"/><path d="M6 8 q3 -2 6 0"/><path d="M5 12 q1 -3 4 -4"/><circle cx="9" cy="9" r="0.9" fill="currentColor"/></svg>
                <svg class="oracle-card__corner oracle-card__corner--br" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.55" stroke-linecap="round"><path d="M2 12 V4 a2 2 0 0 1 2 -2 H12"/><path d="M6 8 q3 -2 6 0"/><path d="M5 12 q1 -3 4 -4"/><circle cx="9" cy="9" r="0.9" fill="currentColor"/></svg>

                <img class="oracle-card__chakana" src="/logos/wenu-chakana.png" alt="" loading="lazy" decoding="async" />
                <span class="oracle-card__wordmark">Wenu Mapu</span>
                <span class="oracle-card__sub">Oracle</span>

                <span class="oracle-card__sparkle oracle-card__sparkle--1" aria-hidden="true"></span>
                <span class="oracle-card__sparkle oracle-card__sparkle--2" aria-hidden="true"></span>
                <span class="oracle-card__sparkle oracle-card__sparkle--3" aria-hidden="true"></span>
                <span class="oracle-card__star oracle-card__star--tl">✦</span>
                <span class="oracle-card__star oracle-card__star--br">✦</span>
              </span>

              {/* Cara — guardián (rellenado al sacar la carta) */}
              <span class="oracle-card__face oracle-card__front">
                <picture>
                  <source type="image/avif" data-card-avif />
                  <img data-card-img alt="" loading="lazy" decoding="async" />
                </picture>
                <span class="oracle-card__glow" aria-hidden="true"></span>
                <span class="oracle-card__edge"></span>
                <span class="oracle-card__edge-inner"></span>
                <svg class="oracle-card__corner oracle-card__corner--tl" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.55" stroke-linecap="round"><path d="M2 12 V4 a2 2 0 0 1 2 -2 H12"/><path d="M6 8 q3 -2 6 0"/><path d="M5 12 q1 -3 4 -4"/><circle cx="9" cy="9" r="0.9" fill="currentColor"/></svg>
                <svg class="oracle-card__corner oracle-card__corner--tr" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.55" stroke-linecap="round"><path d="M2 12 V4 a2 2 0 0 1 2 -2 H12"/><path d="M6 8 q3 -2 6 0"/><path d="M5 12 q1 -3 4 -4"/><circle cx="9" cy="9" r="0.9" fill="currentColor"/></svg>
                <svg class="oracle-card__corner oracle-card__corner--bl" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.55" stroke-linecap="round"><path d="M2 12 V4 a2 2 0 0 1 2 -2 H12"/><path d="M6 8 q3 -2 6 0"/><path d="M5 12 q1 -3 4 -4"/><circle cx="9" cy="9" r="0.9" fill="currentColor"/></svg>
                <svg class="oracle-card__corner oracle-card__corner--br" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.55" stroke-linecap="round"><path d="M2 12 V4 a2 2 0 0 1 2 -2 H12"/><path d="M6 8 q3 -2 6 0"/><path d="M5 12 q1 -3 4 -4"/><circle cx="9" cy="9" r="0.9" fill="currentColor"/></svg>
                {/* Mapudungun nameplate strip — filled by JS al revelar */}
                <span class="oracle-card__nameplate">
                  <span class="oracle-card__nameplate-rule" aria-hidden="true"></span>
                  <span class="oracle-card__nameplate-arn" data-card-arn-mini lang="arn"></span>
                </span>
              </span>
            </span>
          </button>
        ))}
      </div>

      {/* Deck hint — visible only while the deck is stacked (collapsed). */}
      <p class="oracle__deck-hint" data-oracle-deck-hint aria-hidden="true">
        <span class="oracle__deck-hint-pulse"></span>
        Tap the deck to shuffle
      </p>

      {/* Confirm step — appears once a card is selected (stage 1). Second tap reveals. */}
      <button type="button" class="oracle__reveal" data-oracle-reveal hidden>
        Reveal this guardian <span aria-hidden="true">→</span>
      </button>

      {/* Reveal caption — appears once a card is drawn. Order ritual:
          native · display → display title → keywords → reading → pieces preview → CTA → again */}
      <div class="oracle__caption" data-oracle-caption hidden aria-live="polite">
        <p class="oracle__arn" data-oracle-arn></p>
        <h3 class="oracle__name" data-oracle-name></h3>
        <p class="oracle__meaning" data-oracle-meaning></p>
        <p class="oracle__reading" data-oracle-reading></p>

        {/* Pieces aligned with the guardian — 3 mini product previews.
            Filled by JS using the chosen animal's `pieces` payload.
            Hidden when no pieces match — fallback to elegant forge-placeholder. */}
        <div class="oracle__pieces" data-oracle-pieces hidden>
          <p class="oracle__pieces-label" data-oracle-pieces-label>Pieces aligned with this energy</p>
          <ul class="oracle__pieces-list" data-oracle-pieces-list role="list">
            {/* JS injects 3 <li class="oracle-piece">…</li> entries */}
          </ul>
        </div>
        <p class="oracle__pieces-empty" data-oracle-pieces-empty hidden>
          No piece is aligned to this guardian yet. <a href="/custom-orders">Start a commission →</a>
        </p>

        <div class="oracle__actions">
          <a href="/shop" class="btn btn--solid oracle__shop" data-oracle-shop>
            Shop pieces aligned with this guardian <span aria-hidden="true">→</span>
          </a>
          <button type="button" class="oracle__again" data-oracle-again>
            <span aria-hidden="true">↻</span> Draw again
          </button>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-oracle-payload set:html={JSON.stringify(oracleData)}></script>
</section>

<style>
  .oracle {
    position: relative;
    padding: var(--space-8) 0;
    background: var(--obsidian);
    border-top: var(--border-thin);
    border-bottom: var(--border-thin);
    overflow: hidden;
  }

  /* subtle starfield background */
  .oracle::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle 1px at 12% 18%, rgba(255, 240, 220, 0.35) 50%, transparent 51%),
      radial-gradient(circle 1px at 78% 32%, rgba(255, 240, 220, 0.3) 50%, transparent 51%),
      radial-gradient(circle 1px at 38% 72%, rgba(255, 240, 220, 0.25) 50%, transparent 51%),
      radial-gradient(circle 1px at 88% 82%, rgba(255, 240, 220, 0.3) 50%, transparent 51%),
      radial-gradient(circle 1px at 22% 88%, rgba(255, 240, 220, 0.2) 50%, transparent 51%);
    background-size: 800px 800px;
    pointer-events: none;
    opacity: 0.6;
  }

  .oracle__inner {
    position: relative;
    text-align: center;
    z-index: 1;
  }

  .oracle__title {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(2rem, 5vw, 3.4rem);
    color: var(--bone);
    margin: var(--space-3) 0 var(--space-3);
    line-height: 1.05;
  }

  .oracle__lede {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-style: italic;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.55;
    color: var(--fg-soft);
    max-width: 56ch;
    margin: 0 auto var(--space-5);
  }

  .oracle__stage {
    position: relative;
    min-height: clamp(440px, 62vh, 640px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    padding: var(--space-4) 0;
  }

  /* ── Prompt ── */
  .oracle__prompt {
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: opacity var(--t-base), transform var(--t-base);
  }
  .oracle__prompt-en {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bone);
  }
  .oracle__prompt-arn {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-tiny);
    letter-spacing: 0.04em;
    color: var(--bronze);
  }
  .oracle__stage.is-drawing .oracle__prompt {
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
  }

  /* ── The fan ── */
  .oracle__fan {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding-top: var(--space-5);
  }

  .oracle-card {
    --rot: 0deg;
    --lift: 0px;
    --z: 1;
    flex: 0 0 auto;
    width: clamp(118px, 15vw, 172px);
    aspect-ratio: 3 / 5;
    margin: 0 -16px;          /* overlap into a fan */
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    perspective: 1200px;
    transform: translateY(var(--lift)) rotate(var(--rot));
    transform-origin: bottom center;
    transition:
      transform 0.55s cubic-bezier(0.65, 0, 0.2, 1),
      opacity 0.5s ease,
      filter 0.45s ease;
    z-index: var(--z);
  }
  /* ══ Dealing the fan — each card travels from the pile to its slot ══
     Instead of every card sliding at once, each one is DEALT individually:
     it starts stacked at the deck centre (tight, slightly rotated), then flies
     out to its fan position with a staggered delay so you SEE the cards land
     one after another. GPU-only (transform/opacity). The card's resting
     transform (translateY(--lift) rotate(--rot)) is the animation's end state,
     so it settles exactly where the static fan expects it. */
  .oracle__fan.is-opening .oracle-card {
    /* deal strictly left → right (--i is 0…4) so each of the five cards lands
       distinctly, one after another. 0.15s between cards → a calm, readable
       reparto that ends ~1.5s in. */
    animation: oracle-card-deal 0.9s cubic-bezier(0.22, 0.68, 0.16, 1) both;
    animation-delay: calc(var(--i, 0) * 0.15s);
  }
  @keyframes oracle-card-deal {
    0% {
      /* still on the pile: pulled toward the deck centre (each card slides in by
         its distance from the middle slot, index 2), tight rotation, sitting low
         and faint — reads as lifting off the stack. */
      transform:
        translateX(calc((2 - var(--i)) * 46px))
        translateY(calc((5 - var(--z)) * 4px + 16px))
        rotate(calc((var(--z) - 5) * 1.2deg))
        scale(0.92);
      opacity: 0;
    }
    16% { opacity: 1; }
    40% {
      /* mid-flight — still travelling toward the slot */
      transform:
        translateX(calc((2 - var(--i)) * 14px))
        translateY(calc(var(--lift) - 18px))
        rotate(calc(var(--rot) * 0.7))
        scale(1.02);
      opacity: 1;
    }
    /* a gentle overshoot past the slot, then it eases back — a card being tossed
       into place and settling. */
    68% {
      transform:
        translateY(calc(var(--lift) - 12px))
        rotate(calc(var(--rot) * 1.08))
        scale(1.03);
      opacity: 1;
    }
    100% {
      transform: translateY(var(--lift)) rotate(var(--rot)) scale(1);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .oracle__fan.is-opening .oracle-card { animation: none; }
  }
  .oracle-card:hover,
  .oracle-card:focus-visible {
    transform: translateY(calc(var(--lift) - 26px)) rotate(calc(var(--rot) * 0.35)) scale(1.05);
    z-index: 25;
    outline: none;
  }
  .oracle-card:focus-visible .oracle-card__back {
    box-shadow: 0 0 0 2px var(--ember), 0 20px 48px -16px rgba(0, 0, 0, 0.7);
  }

  /* ══ Shuffling — the deliberate riffle/mix before the fan opens ══
     A calm, ceremonial gesture: the deck rocks and the cards riffle in place
     (staggered up/down + slight rotation) a couple of times, THEN they spread.
     No card is selected during or after — the spread is a clean, open fan. */
  .oracle__fan.is-shuffling {
    cursor: default;
    animation: oracle-deck-rock 2.2s ease-in-out both;
  }
  .oracle__fan.is-shuffling .oracle-card {
    /* each card lifts/drops on its own beat → a slow riffle, not a snap */
    animation: oracle-card-riffle 2.2s ease-in-out both;
    animation-delay: calc((5 - var(--z)) * 0.09s);
  }
  @keyframes oracle-deck-rock {
    0%   { transform: translateY(0) rotate(0deg); }
    22%  { transform: translateY(-4px) rotate(-1.4deg); }
    50%  { transform: translateY(-2px) rotate(1.2deg); }
    74%  { transform: translateY(-5px) rotate(-0.8deg); }
    100% { transform: translateY(0) rotate(0deg); }
  }
  @keyframes oracle-card-riffle {
    0% {
      transform:
        translateX(calc(-50% + (var(--z) - 5) * 3px))
        translateY(calc((5 - var(--z)) * 4px))
        rotate(calc((var(--z) - 5) * 1.4deg));
    }
    /* riffle out — cards fan up and apart, then settle back into a tighter stack */
    30% {
      transform:
        translateX(calc(-50% + (var(--z) - 5) * 15px))
        translateY(calc((5 - var(--z)) * 3px - 26px))
        rotate(calc((var(--z) - 5) * 6deg));
    }
    55% {
      transform:
        translateX(calc(-50% + (var(--z) - 5) * 5px))
        translateY(calc((5 - var(--z)) * 4px - 4px))
        rotate(calc((var(--z) - 5) * 2deg));
    }
    78% {
      transform:
        translateX(calc(-50% + (var(--z) - 5) * 12px))
        translateY(calc((5 - var(--z)) * 3px - 16px))
        rotate(calc((var(--z) - 5) * 4.5deg));
    }
    100% {
      transform:
        translateX(calc(-50% + (var(--z) - 5) * 3px))
        translateY(calc((5 - var(--z)) * 4px))
        rotate(calc((var(--z) - 5) * 1.4deg));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .oracle__fan.is-shuffling,
    .oracle__fan.is-shuffling .oracle-card { animation: none; }
  }

  /* ══ Stacked deck (collapsed default) ══
     Cards pile up: cancel the fan arc, overlap tightly, tiny offset/rotation so
     it reads as a real deck. Only the top card sits fully lit; the deck is one
     tap target (the fan wrapper carries role=button). */
  .oracle__fan.is-stacked {
    cursor: pointer;
    padding-top: var(--space-4);
    transition: transform var(--t-fast);
    /* CRITICAL: with every card position:absolute, the flex wrapper would
       collapse to width:0 and its tap target (role=button) would be an
       invisible zero-width strip — a tap on the visible deck would miss it
       entirely (the bug: deck never opened on touch). Give the stacked deck
       a real, card-sized hit box so a tap anywhere on it reaches the handler. */
    width: clamp(150px, 46vw, 210px);
    aspect-ratio: 3 / 5;
    max-width: 210px;
    margin: 0 auto;
    /* the whole box is the tap target */
    touch-action: manipulation;
  }
