---
import en from '../i18n/en.json';

interface CatItem {
  slug: string;
  label: string;
  img: string;
  /** Optional AVIF source for browsers that support it. */
  avif?: string;
}

const items: CatItem[] = [
  { slug: 'piercing',     label: en.categories.piercing.label,     img: '/img/categories/piercing.png' },
  { slug: 'hangers',      label: en.categories.hangers.label,      img: '/img/categories/hangers.png' },
  { slug: 'ear-weights',  label: en.categories.ear_weights.label,  img: '/img/categories/ear-weights.webp', avif: '/img/categories/ear-weights.avif' },
  { slug: 'amulets',      label: en.categories.amulets.label,      img: '/img/categories/amulets.webp',     avif: '/img/categories/amulets.avif' },
  { slug: 'ritual',       label: en.categories.ritual_pieces.label, img: '/img/categories/ritual-pieces.png' },
];
---
<section class="category-strip" aria-label="Browse categories">
  <ul class="category-strip__list">
    {items.map(item => (
      <li class="category-strip__item">
        <a href={`/shop?cat=${item.slug}`} class="category-strip__tile">
          <span class="category-strip__media">
            <picture>
              {item.avif && <source srcset={item.avif} type="image/avif" />}
              <img src={item.img} alt="" loading="lazy" decoding="async" />
            </picture>
            <span class="category-strip__veil" aria-hidden="true"></span>
          </span>
          <span class="category-strip__label">
            <span>{item.label}</span>
            <span class="category-strip__arrow" aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
