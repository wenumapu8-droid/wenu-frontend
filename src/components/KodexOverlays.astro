---
// KODEX−∞ · full-screen overlays shared by cover + folios:
// ARTWORK VIEWER (a work read through live effects, presented with its FULL
// museum plate: title, reading, technique, inspiration, decoded operations
// and its own sigil) and GALLERY WALK (journey through curated rooms).
// Bound by kodex-engine.js only when present.
import { families, opName } from '../lib/kodexBook.js';
const { gallery = true } = Astro.props;
---
<!-- ARTWORK VIEWER — open a work, read it through live effects + curation -->
<div class="kx-viewer" data-viewer hidden aria-hidden="true">
  <div class="kx-viewer__bar">
    <span class="kx-viewer__title" data-viewer-title>SPECIMEN</span>
    <div class="kx-viewer__fx" data-viewer-fx></div>
    <button class="kx-viewer__close" data-viewer-close aria-label="close">CLOSE ✕</button>
  </div>
  <div class="kx-viewer__stage">
    <canvas data-viewer-canvas></canvas>
    <video data-viewer-video hidden controls loop playsinline></video>
  </div>
  <aside class="kx-viewer__meta" data-viewer-meta hidden>
    <span class="kx-viewer__meta-sigil" data-viewer-sigil aria-hidden="true"></span>
    <div class="kx-viewer__meta-body">
      <p class="kx-viewer__meta-read" data-viewer-read></p>
      <p class="kx-viewer__meta-row"><b>TECHNIQUE</b> <span data-viewer-fxline></span></p>
      <p class="kx-viewer__meta-row"><b>INSPIRATION</b> <span data-viewer-insp></span></p>
      <p class="kx-viewer__meta-row"><b>OPERATIONS</b> <span data-viewer-ops></span></p>
    </div>
  </aside>
  <p class="kx-viewer__hint" data-viewer-hint>Each reading is an effect. The work itself never changes.</p>
</div>

{gallery && (
  <div class="kx-gallery" data-gallery hidden aria-hidden="true">
    <div class="kx-gallery__rail" data-gallery-rail>
      {families.map((fam) => (
        <article class="kx-room" data-room data-files={fam.files.join(',')} data-rep={fam.rep} style={`--acc:${fam.th.c}`}>
          <figure class="kx-room__wall">
            <img src={`/img/kodex/archive/${fam.rep}.jpg`} alt={`KODEX−∞ — ${fam.t || 'plate ' + fam.n}`} loading="lazy" />
          </figure>
          <figcaption class="kx-room__label">
            <span class="kx-room__plate">PLATE {fam.n} · {fam.t}</span>
            <span class="kx-room__read">{fam.read}</span>
            <span class="kx-room__medium">{fam.fx}</span>
            <span class="kx-room__ops">{fam.ops.map((c) => `${c} ${opName(c)}`).join(' · ')}</span>
            <span class="kx-room__states">{fam.video ? 'video work' : `${fam.files.length} readings · tap to shift`}</span>
          </figcaption>
        </article>
      ))}
    </div>
    <button class="kx-gallery__nav kx-gallery__nav--prev" data-gallery-prev aria-label="previous room">←</button>
    <button class="kx-gallery__nav kx-gallery__nav--next" data-gallery-next aria-label="next room">→</button>
    <div class="kx-gallery__hud"><b data-gallery-idx>01</b> / {String(families.length).padStart(2, '0')} · WALK THE GALLERY</div>
    <button class="kx-gallery__exit" data-gallery-exit aria-label="leave the gallery">LEAVE ✕</button>
  </div>
)}
