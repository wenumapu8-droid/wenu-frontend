---
/**
 * MiniCatalog — compact real-product escaparate for the home (Ocin 2026-07-05).
 *
 * Replaces the abstract CollectionCarousel with REAL catalogue pieces read from
 * WooCommerce (passed in from index.astro via getProducts()). Each card shows the
 * real macro photo, name and price, and links to its PDP; the whole strip leads to
 * /shop. It's a horizontal snap-scroll rail (mobile-first) so it stays compact and
 * navigable — a mini shop window, not a full grid — distinct from FeaturedShowcase.
 *
 * Effects budget: native CSS scroll-snap + a small scroll-by-arrow handler on
 * desktop. No canvas, no rAF, no timers. Honours reduced-motion (smooth→auto).
 */
import { formatPrice, decodeEntities, getHeroImage } from '../lib/woo';
import type { WooProduct } from '../lib/woo';

interface Props {
  products: WooProduct[];
  eyebrow?: string;
  title?: string;
  ctaHref?: string;
  ctaLabel?: string;
}
const {
  products,
  eyebrow = 'Ngen · From the catalogue',
  title = 'Pieces, in the flesh',
  ctaHref = '/shop',
  ctaLabel = 'Shop all pieces',
} = Astro.props;

// Only pieces with a real hero image — no placeholders in the shop window.
const items = products
  .map(p => ({ p, img: getHeroImage(p) }))
  .filter(x => x.img)
  .slice(0, 10);
---
{items.length > 0 && (
  <section class="mcat" aria-labelledby="mcat-title">
    <div class="container mcat__head">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="mcat-title" class="mcat__title">{title}</h2>
      </div>
      <a href={ctaHref} class="mcat__viewall">{ctaLabel} <span aria-hidden="true">→</span></a>
    </div>

    <div class="mcat__rail-wrap">
      <button type="button" class="mcat__arrow mcat__arrow--prev" data-mcat-prev aria-label="Previous pieces">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <ul class="mcat__rail" data-mcat-rail role="list">
        {items.map(({ p, img }) => (
          <li class="mcat__cell">
            <a href={`/p/${p.slug}`} class="mcat__card">
              <span class="mcat__media">
                <img src={img!.src} alt={img!.alt || decodeEntities(p.name)} width={img!.width} height={img!.height}
                     loading="lazy" decoding="async"
                     onerror="this.onerror=null; this.src='/img/products/placeholder-cardinal-bronze.webp';" />
              </span>
              <span class="mcat__name">{decodeEntities(p.name)}</span>
              <span class="mcat__price">{formatPrice(p.price)}</span>
            </a>
          </li>
        ))}
      </ul>
      <button type="button" class="mcat__arrow mcat__arrow--next" data-mcat-next aria-label="More pieces">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>

    <div class="container mcat__foot">
      <a href={ctaHref} class="btn btn--ghost">{ctaLabel} <span aria-hidden="true">→</span></a>
    </div>
  </section>
)}

<style>
  .mcat { padding: var(--space-7) 0; border-top: var(--border-thin); }
  .mcat__head {
    display: flex; align-items: flex-end; justify-content: space-between;
    flex-wrap: wrap; gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-5);
  }
  .mcat__title {
    font-family: var(--font-display); font-weight: var(--fw-regular);
    font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.05;
    color: var(--bone); margin: var(--space-1) 0 0;
  }
  .mcat__viewall {
    font-family: var(--font-sans); font-size: var(--fs-eyebrow);
    letter-spacing: var(--letter-spacing-ritual); text-transform: uppercase;
    color: var(--ember); text-decoration: none; white-space: nowrap;
    transition: color var(--t-fast);
  }
  .mcat__viewall:hover { color: var(--bone); }

  .mcat__rail-wrap { position: relative; }
  /* Horizontal snap rail — the mini shop window. Full-bleed edges so cards run
     to the gutter on mobile; padding keeps first/last card aligned to container. */
  .mcat__rail {
    list-style: none; margin: 0;
    display: flex; gap: var(--space-3);
    padding: 0 var(--gutter);
    overflow-x: auto; scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .mcat__rail::-webkit-scrollbar { display: none; }
  .mcat__cell {
    flex: 0 0 clamp(150px, 44vw, 240px);
    scroll-snap-align: start;
  }
  .mcat__card {
    display: flex; flex-direction: column; gap: var(--space-1);
    text-decoration: none; color: inherit; height: 100%;
  }
  .mcat__media {
    display: block; aspect-ratio: 1 / 1; overflow: hidden;
    background: var(--bg-alt); border: var(--border-thin);
  }
  .mcat__media img {
    width: 100%; height: 100%; object-fit: cover;
    filter: saturate(0.95) contrast(1.03);
    transition: transform var(--t-slow);
  }
  .mcat__card:hover .mcat__media img { transform: scale(1.04); }
  .mcat__name {
    margin-top: var(--space-2);
    font-family: var(--font-serif); font-size: var(--fs-small); line-height: 1.3;
    color: var(--bone);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    transition: color var(--t-fast);
  }
  .mcat__card:hover .mcat__name { color: var(--ember); }
  .mcat__price {
    font-family: var(--font-sans); font-size: var(--fs-tiny);
    letter-spacing: 0.02em; color: var(--sand);
  }

  /* Arrows — desktop only; touch devices swipe the rail directly. */
  .mcat__arrow {
    position: absolute; top: calc(50% - var(--space-4)); transform: translateY(-50%); z-index: 3;
    display: none; align-items: center; justify-content: center;
    width: 44px; height: 44px;
    background: var(--scrim-soft); color: var(--brand-bone);
    border: 1px solid rgba(201, 168, 76, 0.35); cursor: pointer;
    transition: color var(--t-fast), border-color var(--t-fast), background var(--t-fast);
  }
  .mcat__arrow--prev { left: clamp(4px, 1vw, 12px); }
  .mcat__arrow--next { right: clamp(4px, 1vw, 12px); }
  .mcat__arrow:hover { color: var(--ember); border-color: var(--ember); background: var(--scrim-mid); }
  .mcat__arrow:focus-visible { outline: 1px solid var(--ember); outline-offset: 2px; }
  @media (hover: hover) and (min-width: 900px) {
    .mcat__arrow { display: inline-flex; }
  }

  .mcat__foot { margin-top: var(--space-6); text-align: center; }

  @media (prefers-reduced-motion: reduce) {
    .mcat__rail { scroll-behavior: auto; }
    .mcat__media img { transition: none; }
  }
</style>

<script>
  // Scroll-by-page arrows for the mini catalogue (desktop). Reads one measurement
  // per click; no hot-path layout thrash. Touch users swipe natively.
  document.querySelectorAll('.mcat__rail-wrap').forEach(wrap => {
    const rail = wrap.querySelector('[data-mcat-rail]') as HTMLElement | null;
    if (!rail) return;
    const page = () => Math.max(rail.clientWidth * 0.8, 220);
    wrap.querySelector('[data-mcat-prev]')?.addEventListener('click', () => rail.scrollBy({ left: -page(), behavior: 'smooth' }));
    wrap.querySelector('[data-mcat-next]')?.addEventListener('click', () => rail.scrollBy({ left: page(), behavior: 'smooth' }));
  });
</script>
