---
import en from '../i18n/en.json';

const items = [
  { key: 'puel',  label: en.sacred.puel.label,  axis: en.sacred.puel.axis },
  { key: 'will',  label: en.sacred.will.label,  axis: en.sacred.will.axis },
  { key: 'pewen', label: en.sacred.pewen.label, axis: en.sacred.pewen.axis },
  { key: 'nüku',  label: en.sacred['nüku'].label, axis: en.sacred['nüku'].axis },
];
---
<ul class="cardinal-grid" role="list" data-fade-in-stagger>
  <li class="cardinal-grid__item">
    <span class="cardinal-grid__symbol" aria-hidden="true">
      {/* Puel Mapu — East · Air · New Beginnings — sun rising on east arm */}
      <svg viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
        <line x1="24" y1="6" x2="24" y2="42"/>
        <line x1="6" y1="24" x2="42" y2="24"/>
        <circle cx="24" cy="24" r="2.4" fill="currentColor"/>
        <circle cx="38" cy="24" r="4.5"/>
        <line x1="44" y1="20" x2="46" y2="20"/>
        <line x1="44" y1="24" x2="47" y2="24"/>
        <line x1="44" y1="28" x2="46" y2="28"/>
      </svg>
    </span>
    <span class="cardinal-grid__label" lang="arn">{items[0].label}</span>
    <span class="cardinal-grid__axis">{items[0].axis}</span>
  </li>

  <li class="cardinal-grid__item">
    <span class="cardinal-grid__symbol" aria-hidden="true">
      {/* Will Mapu — South · Fire · Transformation — triangles ascending on south arm */}
      <svg viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
        <line x1="24" y1="6" x2="24" y2="42"/>
        <line x1="6" y1="24" x2="42" y2="24"/>
        <circle cx="24" cy="24" r="2.4" fill="currentColor"/>
        <path d="M19 42 L24 34 L29 42 Z"/>
        <path d="M21 38 L24 32 L27 38" opacity="0.55"/>
      </svg>
    </span>
    <span class="cardinal-grid__label" lang="arn">{items[1].label}</span>
    <span class="cardinal-grid__axis">{items[1].axis}</span>
  </li>

  <li class="cardinal-grid__item">
    <span class="cardinal-grid__symbol" aria-hidden="true">
      {/* Pewen Mapu — West · Water · Intuition — wave arcs on west arm */}
      <svg viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
        <line x1="24" y1="6" x2="24" y2="42"/>
        <line x1="6" y1="24" x2="42" y2="24"/>
        <circle cx="24" cy="24" r="2.4" fill="currentColor"/>
        <path d="M14 21 Q11 24 14 27"/>
        <path d="M10 19 Q5 24 10 29" opacity="0.7"/>
        <path d="M6 17 Q-1 24 6 31" opacity="0.4"/>
      </svg>
    </span>
    <span class="cardinal-grid__label" lang="arn">{items[2].label}</span>
    <span class="cardinal-grid__axis">{items[2].axis}</span>
  </li>

  <li class="cardinal-grid__item">
    <span class="cardinal-grid__symbol" aria-hidden="true">
      {/* Nüku Mapu — North · Earth · Ancestry — diamond + roots on north arm */}
      <svg viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
        <line x1="24" y1="6" x2="24" y2="42"/>
        <line x1="6" y1="24" x2="42" y2="24"/>
        <circle cx="24" cy="24" r="2.4" fill="currentColor"/>
        <path d="M24 4 L29 12 L24 20 L19 12 Z"/>
        <line x1="24" y1="20" x2="20" y2="22" opacity="0.55"/>
        <line x1="24" y1="20" x2="28" y2="22" opacity="0.55"/>
      </svg>
    </span>
    <span class="cardinal-grid__label" lang="arn">{items[3].label}</span>
    <span class="cardinal-grid__axis">{items[3].axis}</span>
  </li>
</ul>
