---
/**
 * CardinalGrid — 4 puntos cardinales Mapuche con simbología real del kultrún.
 *
 * Símbolos canónicos (ver Obsidian: brand/01-identity/kultrun-simbologia-real.md):
 *   - Puel  (Este  · Air · New Beginnings)  → Antü   = estrella de 8 puntas (sol naciente).
 *   - Will  (Sur   · Fire · Transformation) → Küruf  = espiral de 4 brazos (viento).
 *   - Pewen (Oeste · Water · Intuition)     → Ko     = luna creciente (agua/luna).
 *   - Nüku  (Norte · Earth · Ancestry)      → Mapu   = espiral de 4 brazos contra-rotatorio (tierra).
 *
 * Cada SVG conserva el círculo + cruz (estructura base del kultrún) con líneas tenues,
 * y el símbolo elemental al frente. NO usar swirls genéricos ni soles random — esta
 * simbología es específica y reconocible para la comunidad Mapuche.
 */
import en from '../i18n/en.json';

const items = [
  { key: 'puel',  label: en.sacred.puel.label,  axis: en.sacred.puel.axis,  element: 'Antü · Sol'   },
  { key: 'will',  label: en.sacred.will.label,  axis: en.sacred.will.axis,  element: 'Küruf · Viento' },
  { key: 'pewen', label: en.sacred.pewen.label, axis: en.sacred.pewen.axis, element: 'Ko · Agua'     },
  { key: 'nüku',  label: en.sacred['nüku'].label, axis: en.sacred['nüku'].axis, element: 'Mapu · Tierra' },
];
---
<ul class="cardinal-grid" role="list" data-fade-in-stagger>
  <li class="cardinal-grid__item">
    <span class="cardinal-grid__symbol" aria-hidden="true">
      {/* Puel Mapu — East · Antü · estrella de 8 puntas */}
      <svg viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="24" cy="24" r="20" opacity="0.32"/>
        <line x1="24" y1="4" x2="24" y2="44" opacity="0.32"/>
        <line x1="4" y1="24" x2="44" y2="24" opacity="0.32"/>
        <circle cx="24" cy="24" r="1.6" fill="currentColor"/>
        {/* 8-point star — 4 puntas mayores + 4 menores entre ellas */}
        <polygon points="24,10 27,18 34,15 31,22 38,24 31,26 34,33 27,30 24,38 21,30 14,33 17,26 10,24 17,22 14,15 21,18" stroke-width="1.1"/>
      </svg>
    </span>
    <span class="cardinal-grid__label" lang="arn">{items[0].label}</span>
    <span class="cardinal-grid__axis">{items[0].axis}</span>
    <span class="cardinal-grid__element">{items[0].element}</span>
  </li>

  <li class="cardinal-grid__item">
    <span class="cardinal-grid__symbol" aria-hidden="true">
      {/* Will Mapu — South · Küruf · espiral de 4 brazos (viento, sentido horario) */}
      <svg viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="24" cy="24" r="20" opacity="0.32"/>
        <line x1="24" y1="4" x2="24" y2="44" opacity="0.32"/>
        <line x1="4" y1="24" x2="44" y2="24" opacity="0.32"/>
        <circle cx="24" cy="24" r="1.6" fill="currentColor"/>
        {/* Küruf — 4 brazos curvos saliendo del centro en sentido horario */}
        <path d="M24 24 Q28 17 36 17" stroke-width="1.1"/>
        <path d="M24 24 Q31 28 31 36" stroke-width="1.1"/>
        <path d="M24 24 Q20 31 12 31" stroke-width="1.1"/>
        <path d="M24 24 Q17 20 17 12" stroke-width="1.1"/>
      </svg>
    </span>
    <span class="cardinal-grid__label" lang="arn">{items[1].label}</span>
    <span class="cardinal-grid__axis">{items[1].axis}</span>
    <span class="cardinal-grid__element">{items[1].element}</span>
  </li>

  <li class="cardinal-grid__item">
    <span class="cardinal-grid__symbol" aria-hidden="true">
      {/* Pewen Mapu — West · Ko · luna creciente (agua/luna) */}
      <svg viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="24" cy="24" r="20" opacity="0.32"/>
        <line x1="24" y1="4" x2="24" y2="44" opacity="0.32"/>
        <line x1="4" y1="24" x2="44" y2="24" opacity="0.32"/>
        <circle cx="24" cy="24" r="1.6" fill="currentColor"/>
        {/* Crescent moon — outer circle minus offset inner circle */}
        <path d="M28 12 A 12 12 0 1 0 28 36 A 9 9 0 1 1 28 12 Z" stroke-width="1.1"/>
      </svg>
    </span>
    <span class="cardinal-grid__label" lang="arn">{items[2].label}</span>
    <span class="cardinal-grid__axis">{items[2].axis}</span>
    <span class="cardinal-grid__element">{items[2].element}</span>
  </li>

  <li class="cardinal-grid__item">
    <span class="cardinal-grid__symbol" aria-hidden="true">
      {/* Nüku Mapu — North · Mapu · espiral de 4 brazos (tierra, sentido antihorario) */}
      <svg viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="24" cy="24" r="20" opacity="0.32"/>
        <line x1="24" y1="4" x2="24" y2="44" opacity="0.32"/>
        <line x1="4" y1="24" x2="44" y2="24" opacity="0.32"/>
        <circle cx="24" cy="24" r="1.6" fill="currentColor"/>
        {/* Mapu — espejo del küruf, sentido antihorario, brazos más redondos */}
        <path d="M24 24 Q20 17 12 17" stroke-width="1.1"/>
        <path d="M24 24 Q31 20 31 12" stroke-width="1.1"/>
        <path d="M24 24 Q28 31 36 31" stroke-width="1.1"/>
        <path d="M24 24 Q17 28 17 36" stroke-width="1.1"/>
      </svg>
    </span>
    <span class="cardinal-grid__label" lang="arn">{items[3].label}</span>
    <span class="cardinal-grid__axis">{items[3].axis}</span>
    <span class="cardinal-grid__element">{items[3].element}</span>
  </li>
</ul>
