---
// Newsletter subscription popup. Lives in Base layout. Hidden by default.
// Auto-opens once per visitor (localStorage 'wm-news-v1') after a short delay
// or on exit-intent. Manual trigger via [data-newsletter-trigger].
// Submits to /api/subscribe (inactive in static build) and falls back to mailto.
// Esc / backdrop / close button dismiss it. Honors prefers-reduced-motion via CSS.
import en from '../i18n/en.json';
const n = en.newsletterModal;
const EMAIL = 'marimari@wenumapuonline.com';
const mailtoHref = `mailto:${EMAIL}?subject=${encodeURIComponent(n.fallback_subject)}&body=${encodeURIComponent(n.fallback_body)}`;
---
<dialog id="newsletter-modal" class="nlm" aria-labelledby="nlm-title">
  <div class="nlm__inner">
    <picture class="nlm__bg" aria-hidden="true">
      <source type="image/avif" srcset="/img/banners/cosmic/cosmos-field-900w.avif 900w, /img/banners/cosmic/cosmos-field-1200w.avif 1200w" sizes="(max-width:720px) 90vw, 520px" />
      <img src="/img/banners/cosmic/cosmos-field-900w.webp" srcset="/img/banners/cosmic/cosmos-field-900w.webp 900w, /img/banners/cosmic/cosmos-field-1200w.webp 1200w" sizes="(max-width:720px) 90vw, 520px" alt="" width="1672" height="941" loading="lazy" decoding="async" />
    </picture>
    <div class="nlm__veil" aria-hidden="true"></div>

    <button type="button" class="nlm__close" aria-label={n.close} data-newsletter-close>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="18" y1="6" x2="6" y2="18"/>
      </svg>
    </button>

    <div class="nlm__body">
      <p class="eyebrow nlm__eyebrow">{n.eyebrow}</p>
      <h2 id="nlm-title" class="nlm__title">{n.title}</h2>
      <p class="nlm__text">{n.body}</p>

      <form class="nlm__form" novalidate data-newsletter-form data-fallback={mailtoHref}>
        <label class="visually-hidden" for="nlm-email">{n.placeholder}</label>
        <div class="nlm__field">
          <input
            id="nlm-email"
            type="email"
            name="email"
            placeholder={n.placeholder}
            autocomplete="email"
            required
          />
          <button type="submit" class="btn btn--solid nlm__submit">{n.submit}</button>
        </div>
        <label class="nlm__consent">
          <input type="checkbox" name="consent" required />
          <span>{n.consent}</span>
        </label>
        <p class="nlm__error" data-newsletter-error hidden>{n.error}</p>
      </form>

      <button type="button" class="nlm__dismiss" data-newsletter-close>{n.dismiss}</button>
    </div>

    <div class="nlm__success" data-newsletter-success hidden>
      <h2 class="nlm__title">{n.success_title}</h2>
      <p class="nlm__text">{n.success_body}</p>
      <button type="button" class="btn btn--ghost" data-newsletter-close>{n.close}</button>
    </div>
  </div>
</dialog>

<script>
  const KEY = 'wm-news-v1';
  const dlg = document.getElementById('newsletter-modal') as HTMLDialogElement | null;
  if (dlg) {
    const form = dlg.querySelector<HTMLFormElement>('[data-newsletter-form]');
    const bodyEl = dlg.querySelector<HTMLElement>('.nlm__body');
    const successEl = dlg.querySelector<HTMLElement>('[data-newsletter-success]');
    const errorEl = dlg.querySelector<HTMLElement>('[data-newsletter-error]');
    const emailInput = dlg.querySelector<HTMLInputElement>('#nlm-email');
    const consentInput = dlg.querySelector<HTMLInputElement>('input[name="consent"]');
    const fallbackHref = form?.getAttribute('data-fallback') || '';

    let seen = false;
    try { seen = localStorage.getItem(KEY) !== null; } catch { seen = false; }

    function remember(value: string) {
      try { localStorage.setItem(KEY, value); } catch { /* private mode */ }
    }

    function open() {
      if (!dlg) return;
      if (typeof dlg.showModal === 'function') dlg.showModal();
      else dlg.setAttribute('open', '');
    }
    function close() {
      if (!dlg) return;
      if (typeof dlg.close === 'function') dlg.close();
      else dlg.removeAttribute('open');
    }

    function showSuccess() {
      bodyEl?.setAttribute('hidden', '');
      successEl?.removeAttribute('hidden');
    }

    // Manual trigger (e.g. footer link) — always works, even if already seen.
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest('[data-newsletter-trigger]');
      if (t) { e.preventDefault(); open(); }
    });

    // Dismiss controls
    dlg.querySelectorAll('[data-newsletter-close]').forEach((el) => {
      el.addEventListener('click', () => { remember('dismissed'); close(); });
    });
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) { remember('dismissed'); close(); } // backdrop
    });
    dlg.addEventListener('cancel', () => { remember('dismissed'); }); // Esc

    // Submit → POST /api/subscribe, fall back to mailto.
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl?.setAttribute('hidden', '');
      const email = emailInput?.value.trim() || '';
      const validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      if (!validEmail) { emailInput?.focus(); return; }
      if (consentInput && !consentInput.checked) { consentInput.focus(); return; }

      let delivered = false;
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, source: 'site-popup' }),
        });
        if (res.ok) {
          const data = await res.json().catch(() => null);
          delivered = Boolean(data && data.ok);
        }
      } catch { delivered = false; }

      if (!delivered && fallbackHref) {
        // Static build: API route inactive → open prefilled email as graceful fallback.
        window.location.href = fallbackHref;
      }
      remember('subscribed');
      showSuccess();
    });

    // Auto-open once per visitor: 25s dwell OR exit-intent, whichever first.
    if (!seen) {
      let armed = true;
      const fire = () => {
        if (!armed) return;
        armed = false;
        window.clearTimeout(timer);
        document.removeEventListener('mouseout', exitIntent);
        open();
      };
      const timer = window.setTimeout(fire, 25000);
      const exitIntent = (ev: MouseEvent) => {
        if (ev.clientY <= 0 && !ev.relatedTarget) fire();
      };
      document.addEventListener('mouseout', exitIntent);
    }
  }
</script>

<style>
  .nlm {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 560px;
    width: min(92vw, 560px);
    color: var(--bone);
    overflow: visible;
  }
  .nlm::backdrop {
    background: rgba(8, 7, 6, 0.78);
    backdrop-filter: blur(3px);
  }
  .nlm__inner {
    position: relative;
    border: var(--border-thin);
    background: var(--obsidian);
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }
  .nlm__bg, .nlm__bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nlm__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(8,7,6,0.35), rgba(8,7,6,0.9) 75%),
      linear-gradient(180deg, rgba(8,7,6,0.55), rgba(8,7,6,0.92));
  }
  .nlm__body, .nlm__success {
    position: relative;
    padding: var(--space-6) var(--space-5) var(--space-5);
    text-align: center;
  }
  .nlm__eyebrow { color: var(--ember); }
  .nlm__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: var(--fw-regular);
    line-height: 1.08;
    color: var(--bone);
    margin: var(--space-2) 0 var(--space-3);
  }
  .nlm__text {
    font-family: var(--font-serif);
    font-weight: var(--fw-thin);
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--fg-soft);
    max-width: 42ch;
    margin: 0 auto var(--space-4);
  }
  .nlm__form { display: block; }
  .nlm__field {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
  }
  .nlm__field input[type="email"] {
    flex: 1 1 220px;
    min-width: 0;
    padding: 0.85rem 1rem;
    background: rgba(242, 237, 228, 0.06);
    border: var(--border-thin);
    color: var(--bone);
    font-family: var(--font-ui);
    font-size: var(--fs-body);
  }
  .nlm__field input[type="email"]::placeholder { color: var(--silver); }
  .nlm__field input[type="email"]:focus-visible {
    outline: none;
    border-color: var(--ember);
  }
  .nlm__submit { flex: 0 0 auto; white-space: nowrap; }
  .nlm__consent {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    justify-content: center;
    margin-top: var(--space-3);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--silver);
    text-align: left;
    max-width: 40ch;
    margin-left: auto;
    margin-right: auto;
  }
  .nlm__consent input { margin-top: 0.15rem; accent-color: var(--ember); }
  .nlm__error {
    margin-top: var(--space-3);
    color: var(--ember);
    font-family: var(--font-ui);
    font-size: 0.82rem;
  }
  .nlm__dismiss {
    margin-top: var(--space-4);
    background: none;
    border: none;
    color: var(--silver);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .nlm__dismiss:hover { color: var(--bone); }
  .nlm__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    background: rgba(8, 7, 6, 0.5);
    border: var(--border-thin);
    color: var(--bone);
    cursor: pointer;
  }
  .nlm__close:hover { background: rgba(8, 7, 6, 0.8); }
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Entrance — honored only when motion is allowed. */
  @media (prefers-reduced-motion: no-preference) {
    .nlm[open] .nlm__inner {
      animation: nlm-rise 0.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    @keyframes nlm-rise {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  }

  @media (max-width: 720px) {
    .nlm__field input[type="email"] { flex: 1 1 100%; }
    .nlm__submit { width: 100%; }
  }
</style>
