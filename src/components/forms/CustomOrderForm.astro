---
import en from '../../i18n/en.json';

const f = en.custom.form;

// ─── Fase 3 — commission API ────────────────────────────────────────────────
// Read at BUILD time and handed to the script below through define:vars. It
// cannot be read inside that script: define:vars makes a script inline, and
// Astro does not process inline scripts at all — no bundling, no imports, and
// no import.meta.env substitution. Reading it there would silently yield
// undefined and the form would look wired while quietly posting nowhere.
//
// Unset in a plain build. Every path below still ends at mailto, so an
// unconfigured deploy degrades to a working form instead of a dead fetch.
// Set PUBLIC_WENU_API in Cloudflare Pages (see .env.example) to turn it on.
const API = (import.meta.env.PUBLIC_WENU_API ?? '').replace(/\/+$/, '');

const pieceTypes = [
  'Ring',
  'Amulet / pendant',
  'Hanger',
  'Ear weight',
  'Piercing top',
  'Other',
];

const materials = [f.material_silver, f.material_gold, f.material_open];

const budgets = [
  { value: 'under-400', label: f.budget_under_400 },
  { value: '400-800', label: '$400–$800' },
  { value: '800-1500', label: '$800–$1500' },
  { value: '1500-2500', label: '$1500–$2500' },
  { value: '2500-plus', label: '$2500+' },
  { value: 'open', label: f.budget_open },
];

const timings = [
  { value: 'standard', label: f.timing_standard },
  { value: 'specific-date', label: f.timing_specific },
  { value: 'no-rush', label: f.timing_no_rush },
];
---
<form class="custom-form__form" data-custom-order-form>
  <div class="custom-form__row">
    <label class="custom-form__field">
      <span>{f.name_label}</span>
      <input name="name" autocomplete="name" required />
    </label>
    <label class="custom-form__field">
      <span>{f.email_label}</span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
  </div>

  <div class="custom-form__row">
    <label class="custom-form__field">
      <span>{f.type_label}</span>
      <select name="pieceType" required>
        <option value="">{f.select_placeholder}</option>
        {pieceTypes.map(option => <option value={option}>{option}</option>)}
      </select>
    </label>
    <label class="custom-form__field">
      <span>{f.placement_label}</span>
      <input name="placement" placeholder={f.placement_placeholder} />
    </label>
  </div>

  <div class="custom-form__row">
    <label class="custom-form__field">
      <span>{f.material_label}</span>
      <select name="material" required>
        <option value="">{f.select_placeholder}</option>
        {materials.map(option => <option value={option}>{option}</option>)}
      </select>
    </label>
    <label class="custom-form__field">
      <span>{f.stone_label}</span>
      <input name="stone" placeholder={f.stone_placeholder} />
    </label>
  </div>

  <div class="custom-form__row">
    <label class="custom-form__field">
      <span>{f.budget_label}</span>
      <select name="budget" required>
        <option value="">{f.select_placeholder}</option>
        {budgets.map(option => <option value={option.value}>{option.label}</option>)}
      </select>
    </label>
    <label class="custom-form__field">
      <span>{f.timing_label}</span>
      <select name="timing" required data-custom-order-timing>
        <option value="">{f.select_placeholder}</option>
        {timings.map(option => <option value={option.value}>{option.label}</option>)}
      </select>
    </label>
  </div>

  <label class="custom-form__field" data-custom-order-date hidden>
    <span>{f.deadline_label}</span>
    <input name="specificDate" type="date" />
  </label>

  <label class="custom-form__field custom-form__field--full">
    <span>{f.story_label}</span>
    <textarea name="story" rows="7" minlength="50" maxlength="1000" placeholder={f.story_placeholder} required></textarea>
  </label>

  <label class="custom-form__field custom-form__field--full">
    <span>{f.inspiration_label}</span>
    <input name="inspirationUrl" type="url" placeholder={f.inspiration_placeholder} />
  </label>

  <label class="custom-form__consent">
    <input name="consent" type="checkbox" required />
    <span>{f.consent}</span>
  </label>

  <div class="custom-form__fallback-panel" data-custom-order-panel hidden aria-live="polite"></div>

  <button class="btn btn--solid custom-form__submit" type="submit">{f.submit}</button>

  <p class="custom-form__fallback">
    {f.fallback_direct} <a href={`mailto:marimari@wenumapuonline.com?subject=${encodeURIComponent(f.fallback_subject)}`}>marimari@wenumapuonline.com</a>
  </p>
</form>

<script define:vars={{ f, API }}>
  const form = document.querySelector('[data-custom-order-form]');
  const timing = form?.querySelector('[data-custom-order-timing]');
  const dateField = form?.querySelector('[data-custom-order-date]');
  const panel = form?.querySelector('[data-custom-order-panel]');

  const sixMonthsFromNow = () => {
    const date = new Date();
    date.setMonth(date.getMonth() + 6);
    date.setHours(0, 0, 0, 0);
    return date;
  };

  const fieldValue = (data, key) => String(data.get(key) || '').trim();

  const buildSummary = payload => [
    `Name: ${payload.name}`,
    `Email: ${payload.email}`,
    `Type: ${payload.pieceType}`,
    `Placement: ${payload.placement || 'N/A'}`,
    `Material: ${payload.material}`,
    `Stone / inclusion: ${payload.stone || 'N/A'}`,
    `Budget: ${payload.budget}`,
    `Timing: ${payload.timing}`,
    `Specific date: ${payload.specificDate || 'N/A'}`,
    `Inspiration URL: ${payload.inspirationUrl || 'N/A'}`,
    '',
    'Story:',
    payload.story,
  ].join('\n');

  const showPanel = (...children) => {
    if (!panel) return;
    panel.replaceChildren(...children);
    panel.hidden = false;
  };

  const fallbackNodes = payload => {
    const summary = buildSummary(payload);
    const href = `mailto:marimari@wenumapuonline.com?subject=${encodeURIComponent(f.fallback_subject)}&body=${encodeURIComponent(summary)}`;

    const intro = document.createElement('p');
    intro.className = 'custom-form__fallback-intro';
    intro.textContent = f.fallback_local;

    const textarea = document.createElement('textarea');
    textarea.className = 'custom-form__field';
    textarea.setAttribute('rows', '10');
    textarea.setAttribute('readonly', '');
    textarea.value = summary;

    const link = document.createElement('a');
    link.className = 'btn btn--solid custom-form__submit';
    link.setAttribute('href', href);
    link.textContent = f.fallback_cta;

    return [intro, textarea, link];
  };

  /**
   * The API answers with the CustomOrder id once the brief is stored. Show it:
   * a reference the person can quote back is the difference between "we got
   * it" and "trust us".
   *
   * Deliberately NOT a receipt code (src/lib/receipt.ts). A commission at this
   * point is an inquiry — the API creates CustomOrder(status:new) and payment
   * happens later through the deposit link. Minting a WM-ENC-… receipt here
   * would hand someone a purchase artifact for something they have not bought.
   */
  const successNodes = id => {
    const intro = document.createElement('p');
    intro.className = 'custom-form__fallback-intro';
    intro.textContent = f.success_message;
    if (!id) return [intro];

    const ref = document.createElement('p');
    ref.className = 'custom-form__reference';
    ref.append(
      document.createTextNode('Commission reference: '),
      Object.assign(document.createElement('strong'), { textContent: `#${id}` }),
    );
    return [intro, ref];
  };

  const noteIntro = notes => {
    const intro = document.createElement('p');
    intro.className = 'custom-form__fallback-intro';
    notes.forEach((note, index) => {
      if (index > 0) intro.appendChild(document.createElement('br'));
      intro.append(...note);
    });
    return intro;
  };

  timing?.addEventListener('change', () => {
    if (!dateField) return;
    dateField.hidden = timing.value !== 'specific-date';
  });

  form?.addEventListener('submit', async event => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = new FormData(form);
    const payload = {
      name: fieldValue(data, 'name'),
      email: fieldValue(data, 'email'),
      pieceType: fieldValue(data, 'pieceType'),
      placement: fieldValue(data, 'placement'),
      material: fieldValue(data, 'material'),
      stone: fieldValue(data, 'stone'),
      budget: fieldValue(data, 'budget'),
      timing: fieldValue(data, 'timing'),
      specificDate: fieldValue(data, 'specificDate'),
      story: fieldValue(data, 'story'),
      inspirationUrl: fieldValue(data, 'inspirationUrl'),
      consent: data.get('consent') === 'on',
    };

    const notes = [];
    if (payload.budget === 'under-400') {
      const link = document.createElement('a');
      link.className = 'text-accent';
      link.setAttribute('href', '/jewelry-styling');
      link.textContent = f.curation_link;
      notes.push([document.createTextNode(`${f.budget_soft_note} `), link]);
    }
    if (payload.timing === 'specific-date' && payload.specificDate) {
      const selected = new Date(`${payload.specificDate}T00:00:00`);
      if (selected < sixMonthsFromNow()) notes.push([document.createTextNode(f.date_soft_note)]);
    }

    if (notes.length > 0) {
      showPanel(noteIntro(notes), ...fallbackNodes(payload));
      return;
    }

    // Fase 3. This used to POST to /api/custom-order — an Astro route that
    // output: 'static' never builds. The fetch therefore threw on every single
    // submission and every commission silently fell through to mailto. It now
    // posts to the real commission API, which validates the brief, upserts the
    // Customer, creates the CustomOrder and notifies the studio.
    //
    // The site stays static: this is a client-side fetch to an external origin,
    // not an SSR migration. The API's ALLOWED_ORIGINS must include this host.
    if (API) {
      try {
        const response = await fetch(`${API}/custom-orders`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            email: payload.email,
            name: payload.name,
            // The API takes the commission as a free-form brief object. Send the
            // whole shape rather than a flattened string, so the studio reads
            // fields back out instead of re-parsing prose.
            brief: {
              pieceType: payload.pieceType,
              placement: payload.placement,
              material: payload.material,
              stone: payload.stone,
              budget: payload.budget,
              timing: payload.timing,
              specificDate: payload.specificDate,
              inspirationUrl: payload.inspirationUrl,
              story: payload.story,
              consent: payload.consent,
            },
          }),
        });
        const result = await response.json().catch(() => null);
        if (response.ok && result?.ok) {
          showPanel(...successNodes(result?.customOrder?.id));
          form.reset();
          if (dateField) dateField.hidden = true;
          return;
        }
      } catch {
        // Network, CORS, or a cold API. The commission is worth more than the
        // error state, so fall through to mailto rather than losing the lead.
      }
    }

    showPanel(...fallbackNodes(payload));
  });
</script>
