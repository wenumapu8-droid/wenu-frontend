---
interface Props {
  text?: string;
  size?: number;
}
const { text = 'WENU · MAPU · 2026', size = 120 } = Astro.props;
const id = `seal-${Math.random().toString(36).slice(2, 8)}`;
const r = size / 2 - 6;
const cx = size / 2;
const cy = size / 2;
const pathR = r - 8;
---
<svg
  width={size}
  height={size}
  viewBox={`0 0 ${size} ${size}`}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  style="display:inline-block;"
>
  <defs>
    <path
      id={id}
      d={`M ${cx},${cy} m -${pathR},0 a ${pathR},${pathR} 0 1,1 ${pathR * 2},0 a ${pathR},${pathR} 0 1,1 -${pathR * 2},0`}
      fill="none"
    />
  </defs>
  <circle cx={cx} cy={cy} r={r} fill="none" stroke="currentColor" stroke-width="1" />
  <circle cx={cx} cy={cy} r={r - 12} fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.5" />
  <circle cx={cx} cy={cy} r="3" fill="currentColor" />
  <text fill="currentColor" font-family="var(--font-sans)" font-size="9" letter-spacing="3">
    <textPath href={`#${id}`} startOffset="0%">{text}</textPath>
  </text>
</svg>
