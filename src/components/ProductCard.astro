---
import { formatPrice, localizeCategory, decodeEntities, getHeroImage } from '../lib/woo';
import type { WooProduct } from '../lib/woo';

interface Props {
  product: WooProduct;
  /** archive mode: renders as ritual archive object with fragment index */
  archive?: boolean;
  /** fragment number displayed as "FRAGMENT 01" label */
  fragmentIndex?: number;
  /** corner badge — e.g. "NEW", "LIMITED" */
  badge?: string | null;
}
const { product: p, archive = false, fragmentIndex, badge = null } = Astro.props;

const fragLabel = fragmentIndex !== undefined
  ? `FRAGMENT ${String(fragmentIndex).padStart(2, '0')}`
  : null;

const material = p.attributes?.find(a => a.name.toLowerCase() === 'material')?.options?.[0] || null;
const catName  = p.categories[0] ? localizeCategory(p.categories[0]) : 'Jewelry';

// Hero image: prefer editorial/macro over reference/ruler shots.
const heroImg = getHeroImage(p);
---

{archive ? (
  <a
    href={`/p/${p.slug}`}
    class="archive-card"
    data-cats={p.categories.map(c => c.slug).join(' ')}
  >
    <div class="archive-card__img-wrap">
      {fragLabel && <span class="archive-card__index">{fragLabel}</span>}
      {heroImg
        ? <img src={heroImg.src} alt={heroImg.alt || decodeEntities(p.name)} width={heroImg.width} height={heroImg.height} loading="lazy" />
        : <span class="product-card__placeholder" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="24" cy="24" r="14"/>
              <line x1="24" y1="6" x2="24" y2="42"/>
              <line x1="6" y1="24" x2="42" y2="24"/>
              <circle cx="24" cy="24" r="2.4" fill="currentColor"/>
            </svg>
          </span>
      }
    </div>
    <div class="archive-card__body">
      <p class="archive-card__meta">
        <span>{catName}</span>
        {material && (
          <>
            <span class="archive-card__meta-dot"></span>
            <span>{material}</span>
          </>
        )}
      </p>
      <p class="archive-card__name">{decodeEntities(p.name)}</p>
      <p class="archive-card__price">{formatPrice(p.price)}</p>
    </div>
  </a>
) : (
  <a
    href={`/p/${p.slug}`}
    class="product-card"
    data-cats={p.categories.map(c => c.slug).join(' ')}
  >
    <div class="product-card__img-wrap">
      {badge && <span class="product-card__badge">{badge}</span>}
      {heroImg
        ? <img src={heroImg.src} alt={heroImg.alt || decodeEntities(p.name)} width={heroImg.width} height={heroImg.height} loading="lazy" />
        : <span class="product-card__placeholder" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="24" cy="24" r="14"/>
              <line x1="24" y1="6" x2="24" y2="42"/>
              <line x1="6" y1="24" x2="42" y2="24"/>
              <circle cx="24" cy="24" r="2.4" fill="currentColor"/>
            </svg>
          </span>
      }
    </div>
    <div class="product-card__body">
      <p class="product-card__cat">{catName}</p>
      <p class="product-card__name">{decodeEntities(p.name)}</p>
      <p class="product-card__price">{formatPrice(p.price)}</p>
    </div>
  </a>
)}
