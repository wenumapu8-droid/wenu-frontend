---
/* CosmicLinesRail — tira horizontal de 6 cards mini (Antü/Küyen/Wüñelfe/
   Wanlen/Rüpü/Pewma), las 6 líneas canónicas del libro Wenumapu (Cap. 1-7).
   Spec: ~/Obsidian/WenuAgent/brand/01-identity/spec-coleccion-6-lineas-canonicas.md

   Cada card linkea a /lines/<slug>. Los 6 slugs coinciden con los rutas
   estáticas generadas por src/pages/lines/[slug].astro vía getStaticPaths.
   Copy editorial completo llega cuando Ocin fotografíe los capítulos del libro.
*/

interface Props {
  /** Eyebrow optional override */
  eyebrow?: string;
  /** Title optional override */
  title?: string;
}

const {
  eyebrow = 'SHOP BY ELEMENT',
  title = 'Six lines, one sky.',
} = Astro.props;

type Line = {
  slug: string;
  name: string;
  english: string;
  chapter: string;
  glyph: 'sun' | 'moon' | 'star' | 'constellation' | 'path' | 'dream';
};

const lines: Line[] = [
  { slug: 'antu',    name: 'ANTÜ',    english: 'the sun',         chapter: 'Cap. 4',  glyph: 'sun' },
  { slug: 'kuyen',   name: 'KÜYEN',   english: 'the moon',        chapter: 'Cap. 1',  glyph: 'moon' },
  { slug: 'wunelfe', name: 'WÜÑELFE', english: 'the first light', chapter: 'Cap. 2',  glyph: 'star' },
  { slug: 'wanlen',  name: 'WANLEN',  english: 'the constellation', chapter: 'Cap. 3', glyph: 'constellation' },
  { slug: 'rupu',    name: 'RÜPÜ',    english: 'the path',        chapter: 'Cap. 3',  glyph: 'path' },
  { slug: 'pewma',   name: 'PEWMA',   english: 'the dream',       chapter: 'Cap. 7',  glyph: 'dream' },
];
---

<section class="cosmic-lines has-cosmic-veil" aria-labelledby="cosmic-lines-title">
  <div class="cosmic-veil" aria-hidden="true"><span class="cosmic-veil__stars"></span></div>
  <div class="cosmic-lines__head">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="cosmic-lines-title" class="cosmic-lines__title">{title}</h2>
    <p class="cosmic-lines__lede">
      Six cosmological archetypes from <cite>Wenumapu — Astronomía y Cosmología Mapuche</cite> (Canio &amp; Pozo, 2015).
      Each line is a way of wearing the sky.
    </p>
  </div>

  <ul class="cosmic-lines__rail" role="list">
    {lines.map(line => (
      <li class="cosmic-lines__cell">
        <a href={`/lines/${line.slug}`} class="cosmic-line-card" aria-label={`${line.name} — ${line.english}`}>
          <span class="cosmic-line-card__glyph" aria-hidden="true">
            {line.glyph === 'sun' && (
              <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
                <circle cx="24" cy="24" r="7" />
                <line x1="24" y1="6"  x2="24" y2="12" />
                <line x1="24" y1="36" x2="24" y2="42" />
                <line x1="6"  y1="24" x2="12" y2="24" />
                <line x1="36" y1="24" x2="42" y2="24" />
                <line x1="11" y1="11" x2="15" y2="15" />
                <line x1="33" y1="33" x2="37" y2="37" />
                <line x1="11" y1="37" x2="15" y2="33" />
                <line x1="33" y1="15" x2="37" y2="11" />
              </svg>
            )}
            {line.glyph === 'moon' && (
              <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M30 8 a18 18 0 1 0 0 32 a14 14 0 1 1 0 -32 Z" />
              </svg>
            )}
            {line.glyph === 'star' && (
              <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round">
                <path d="M24 6 L27 21 L42 24 L27 27 L24 42 L21 27 L6 24 L21 21 Z" />
              </svg>
            )}
            {line.glyph === 'constellation' && (
              <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="0.8">
                <line x1="10" y1="14" x2="22" y2="20" />
                <line x1="22" y1="20" x2="36" y2="12" />
                <line x1="22" y1="20" x2="26" y2="34" />
                <line x1="26" y1="34" x2="38" y2="36" />
                <circle cx="10" cy="14" r="1.6" fill="currentColor" />
                <circle cx="22" cy="20" r="2.2" fill="currentColor" />
                <circle cx="36" cy="12" r="1.6" fill="currentColor" />
                <circle cx="26" cy="34" r="1.8" fill="currentColor" />
                <circle cx="38" cy="36" r="1.4" fill="currentColor" />
              </svg>
            )}
            {line.glyph === 'path' && (
              <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
                <line x1="6"  y1="38" x2="42" y2="10" stroke-dasharray="2 3" />
                <circle cx="10" cy="36" r="1.2" fill="currentColor" />
                <circle cx="18" cy="30" r="1"   fill="currentColor" />
                <circle cx="26" cy="24" r="1.2" fill="currentColor" />
                <circle cx="34" cy="18" r="1"   fill="currentColor" />
                <circle cx="40" cy="12" r="1.4" fill="currentColor" />
              </svg>
            )}
            {line.glyph === 'dream' && (
              <svg viewBox="0 0 48 48" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M30 10 a16 16 0 1 0 0 28 a12 12 0 1 1 0 -28 Z" />
                <path d="M36 16 L37.5 19 L40.5 19 L38 20.8 L39 24 L36 22 L33 24 L34 20.8 L31.5 19 L34.5 19 Z" />
              </svg>
            )}
          </span>
          <span class="cosmic-line-card__name">{line.name}</span>
          <span class="cosmic-line-card__english">{line.english}</span>
          <span class="cosmic-line-card__chapter">{line.chapter}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
