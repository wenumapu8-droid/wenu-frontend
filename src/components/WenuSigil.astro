---
/**
 * WenuSigil — sello ritual de marca (emblema oficial 2026).
 *
 * Simetría rotacional de 4 (Meli Witran Mapu / 4 direcciones): cuatro brazos
 * creciente-garra en molinete horario, estrella-brújula de 8 puntas al centro,
 * cuatro dagas cardinales con puntos, enmarcado por anillos de instrumento.
 *
 * Diseño ORIGINAL — no es calco de ninguna referencia (regla de originalidad/IP).
 * Vectorial, escalable, monocromo. Hereda color vía `currentColor`
 * (usar var(--ember) sobre obsidiana, var(--bone) sobre claro, etc.).
 *
 * Este componente es la ÚNICA fuente de verdad del emblema. Reusar en cualquier
 * lugar decorativo (sellos, divisores). No re-dibujar el path a mano en otro lado.
 *
 * Master SVG idéntico: public/img/brand/wenu-sigil.svg + LaCie/Wenu-Sigil-2026/.
 */
interface Props {
  /** Tamaño en px (cuadrado). Default 120. */
  size?: number;
  /** Mostrar los anillos de instrumento exteriores. Default true. */
  rings?: boolean;
  /** Texto accesible. Default marca. */
  label?: string;
  /** Clase extra opcional. */
  class?: string;
}
const {
  size = 120,
  rings = true,
  label = 'Wenu Mapu',
  class: className = '',
} = Astro.props;
const arm = 'M121 46 A70 70 0 0 1 156 104 C154 112 147 114 141 111 A44 44 0 0 0 121 46 Z';
const rot = (a: number) => `rotate(${a} 100 100)`;
---
<svg
  class:list={['wenu-sigil', className]}
  width={size}
  height={size}
  viewBox="0 0 200 200"
  fill="currentColor"
  stroke="currentColor"
  role="img"
  aria-label={label}
  xmlns="http://www.w3.org/2000/svg"
>
  {rings && (
    <g fill="none" stroke-width="1">
      <circle cx="100" cy="100" r="92" opacity="0.34" />
      <circle cx="100" cy="100" r="86" opacity="0.16" />
    </g>
  )}
  <g>
    <path d={arm} />
    <path transform={rot(90)} d={arm} />
    <path transform={rot(180)} d={arm} />
    <path transform={rot(270)} d={arm} />
  </g>
  <g>
    {[0, 90, 180, 270].map((a) => (
      <g transform={rot(a)}>
        <path d="M100 22 L103.4 41 L100 51 L96.6 41 Z" />
        <circle cx="100" cy="14" r="2.4" />
      </g>
    ))}
  </g>
  <circle cx="100" cy="100" r="21" fill="none" stroke-width="1.3" />
  <g>
    {[0, 90, 180, 270].map((a) => (
      <path transform={rot(a)} d="M100 78 L103 99 L100 100 L97 99 Z" />
    ))}
    {[45, 135, 225, 315].map((a) => (
      <path transform={rot(a)} d="M100 88 L101.6 98 L100 100 L98.4 98 Z" />
    ))}
  </g>
  <circle cx="100" cy="100" r="2.8" />
</svg>

<style>
  .wenu-sigil { display: inline-block; line-height: 0; }
</style>
