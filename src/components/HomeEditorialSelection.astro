---
/**
 * HomeEditorialSelection — actual WooCommerce products, not AI-made SKUs.
 * Render only in optional home V3 when three distinct product photos exist.
 * Existing animated category rails remain in index.astro for baseline/fallback.
 */
interface Door {
  key: string;
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  image: string;
  alt: string;
}
interface Props { items: Door[]; }
const { items } = Astro.props;
---

<section class="wes" aria-labelledby="wes-title">
  <div class="wes__intro">
    <div>
      <p class="wes__eyebrow">THE OBJECT / A FORM OF EXPRESSION</p>
      <h2 id="wes-title" class="wes__heading">Discover your form.</h2>
      <p class="wes__lead">Considered adornment for a body that tells its own story.</p>
    </div>
    <a class="wes__viewall" href="/shop">View all jewelry <span aria-hidden="true">↗</span></a>
  </div>

  <div class="wes__grid">
    {items.map(item => (
      <a href={item.href} class={'wes__tile wes__tile--' + item.key} aria-label={'Explore ' + item.title}>
        <div class="wes__media">
          <img src={item.image} alt={item.alt} loading="lazy" decoding="async"
               width="960" height="1140" />
          <span class="wes__veil" aria-hidden="true"></span>
        </div>
        <div class="wes__detail">
          <span class="wes__index">{item.eyebrow}</span>
          <h3 class="wes__title">{item.title}</h3>
          <p class="wes__description">{item.description}</p>
          <span class="wes__arrow" aria-hidden="true">Explore collection ↗</span>
        </div>
      </a>
    ))}
  </div>

  <nav class="wes__other" aria-label="More ways to explore">
    <a href="/piercing-jewelry">All piercing forms <span aria-hidden="true">↗</span></a>
    <a href="/collections">All collections <span aria-hidden="true">↗</span></a>
    <a href="/constelaciones">Wültufe · Design your ear <span aria-hidden="true">↗</span></a>
  </nav>
</section>

<style>
  .wes {
    --wes-ink:#f0ede8; --wes-line:rgba(240,237,232,.16);
    background:var(--obsidian,#0a0a0a);
    color:var(--wes-ink);
    padding:clamp(64px,8vw,124px) var(--gutter,5vw) clamp(56px,7vw,100px);
    overflow:clip;
  }
  .wes__intro,.wes__grid,.wes__other { width:min(100%,1500px); margin-inline:auto; }
  .wes__intro {
    display:flex; justify-content:space-between; align-items:end;
    gap:24px; margin-bottom:clamp(26px,3vw,50px);
  }
  .wes__eyebrow,.wes__index,.wes__viewall,.wes__arrow,.wes__other {
    font-family:var(--font-sans);
    font-size:.67rem; letter-spacing:.14em; text-transform:uppercase;
  }
  .wes__eyebrow { color:var(--ember,#c9a84c); margin:0 0 14px; }
  .wes__heading {
    font-family:var(--font-display); font-weight:400;
    line-height:1.04; letter-spacing:-.018em;
    font-size:clamp(2.45rem,5vw,5.6rem); margin:0;
    text-wrap:balance;
  }
  .wes__lead {
    margin:15px 0 0; color:var(--sand,#9a948a);
    font-family:var(--font-sans);
    font-size:clamp(.88rem,1.1vw,1.08rem);
    line-height:1.7; max-width:48ch;
  }
  .wes a { color:inherit; text-decoration:none; }
  .wes__viewall {
    border-bottom:1px solid var(--wes-line);
    padding-bottom:8px; white-space:nowrap;
    transition:color .2s ease;
  }
  .wes__viewall:hover,.wes__viewall:focus-visible { color:var(--ember); }
  .wes__grid {
    display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px;
  }
  .wes__tile {
    position:relative; display:flex; flex-direction:column;
    min-width:0; min-height:clamp(420px,42vw,670px);
    overflow:hidden; border:1px solid var(--wes-line);
    background:#171510; isolation:isolate;
  }
  .wes__media { position:absolute; inset:0; z-index:-1; background:#16130f; }
  .wes__media img {
    width:100%; height:100%; object-fit:cover;
    filter:saturate(.83) contrast(1.05);
    transition:transform 850ms cubic-bezier(.22,1,.36,1), filter 850ms ease;
  }
  .wes__veil { position:absolute; inset:0;
    background:linear-gradient(180deg,rgba(6,5,4,.10) 20%,rgba(6,5,4,.16) 48%,rgba(6,5,4,.96) 100%);
  }
  .wes__detail {
    display:flex; flex-direction:column; align-items:flex-start;
    margin-top:auto; padding:clamp(22px,3vw,44px); min-width:0;
  }
  .wes__index { color:var(--ember,#c9a84c); font-size:.61rem; margin-bottom:12px; }
  .wes__title {
    margin:0; font-family:var(--font-display);
    font-size:clamp(2rem,3.2vw,3.5rem); font-weight:400;
    line-height:1.04; text-wrap:balance;
  }
  .wes__description {
    max-width:36ch; color:rgba(240,237,232,.78);
    font-family:var(--font-sans); line-height:1.6;
    font-size:.82rem; margin:16px 0 23px;
  }
  .wes__arrow {
    display:inline-block; padding:7px 0;
    border-bottom:1px solid rgba(240,237,232,.48);
  }
  .wes__tile:hover .wes__media img,.wes__tile:focus-visible .wes__media img {
    transform:scale(1.035); filter:saturate(.94) contrast(1.02);
  }
  .wes__tile:focus-visible,.wes__other a:focus-visible,.wes__viewall:focus-visible {
    outline:2px solid var(--ember,#c9a84c); outline-offset:3px;
  }
  .wes__other {
    display:flex; align-items:center; gap:22px 32px; justify-content:center;
    flex-wrap:wrap; padding-top:25px; color:var(--sand);
  }
  .wes__other a { min-height:44px; display:inline-flex; align-items:center; gap:8px; }
  .wes__other a:hover,.wes__other a:focus-visible { color:var(--bone); }
  @media(max-width:1000px) {
    .wes__grid { gap:8px; }
    .wes__tile { min-height:470px; }
    .wes__detail { padding:23px; }
    .wes__description { font-size:.79rem; }
  }
  @media(max-width:680px) {
    .wes { padding:68px 0 56px; }
    .wes__intro { padding-inline:22px; display:block; }
    .wes__viewall {
      display:inline-flex; margin-top:24px;
      min-height:44px; align-items:center;
    }
    .wes__grid {
      padding:0 22px 10px;
      display:grid; grid-auto-flow:column;
      grid-auto-columns:minmax(76vw,1fr); grid-template-columns:none;
      overflow-x:auto; overscroll-behavior-x:contain;
      scroll-snap-type:x mandatory; scrollbar-width:thin;
      scroll-padding-left:22px; -webkit-overflow-scrolling:touch;
    }
    .wes__tile { scroll-snap-align:start; min-height:min(540px,66svh); }
    .wes__title { font-size:clamp(2.2rem,9vw,3.4rem); }
    .wes__other {
      justify-content:flex-start; padding:14px 22px 0; gap:2px 18px;
    }
    .wes__other a { font-size:.6rem; }
  }
  @media(prefers-reduced-motion:reduce) {
    .wes__media img { transition:none; }
    .wes__tile:hover .wes__media img,.wes__tile:focus-visible .wes__media img { transform:none; }
    .wes__grid { scroll-behavior:auto; }
  }
</style>
