{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KODEX Node",
  "type": "object",
  "required": [
    "id",
    "slug",
    "type",
    "title",
    "status",
    "mode",
    "accent",
    "summary",
    "proposition",
    "visualAnchor",
    "relationships",
    "symbols",
    "protocols",
    "sources",
    "behavior",
    "visibility",
    "version",
    "checksum"
  ],
  "properties": {
    "id": { "type": "string" },
    "slug": { "type": "string" },
    "type": {
      "enum": ["work", "symbol", "protocol", "book", "myth", "system", "node"]
    },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "status": {
      "enum": ["dormant", "active", "unstable", "sealed"]
    },
    "mode": {
      "enum": ["dark-archive", "technical-plate"]
    },
    "accent": {
      "enum": ["gold", "red", "violet", "cyan", "acid", "magenta", "indigo", "bone"]
    },
    "summary": { "type": "string" },
    "proposition": { "type": "string" },
    "visualAnchor": { "$ref": "#/$defs/assetReference" },
    "specimens": {
      "type": "array",
      "items": { "$ref": "#/$defs/assetReference" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "symbols": {
      "type": "array",
      "items": { "type": "string" }
    },
    "protocols": {
      "type": "array",
      "items": { "$ref": "#/$defs/protocol" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceReference" }
    },
    "behavior": {
      "type": "object",
      "required": ["engine", "tempo", "entropy", "responsiveness", "persistence", "topology"],
      "properties": {
        "engine": { "type": "string" },
        "tempo": { "type": "number", "minimum": 0, "maximum": 1 },
        "entropy": { "type": "number", "minimum": 0, "maximum": 1 },
        "responsiveness": { "type": "number", "minimum": 0, "maximum": 1 },
        "persistence": { "type": "number", "minimum": 0, "maximum": 1 },
        "topology": { "type": "string" }
      },
      "additionalProperties": true
    },
    "visibility": {
      "enum": ["surface", "deep", "sealed"]
    },
    "version": { "type": "string" },
    "checksum": { "type": "string" },
    "editorial": {
      "type": "object",
      "properties": {
        "language": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "assetReference": {
      "type": "object",
      "required": ["kind", "label"],
      "properties": {
        "kind": { "type": "string" },
        "label": { "type": "string" },
        "src": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" },
        "href": { "type": "string" }
      }
    },
    "protocol": {
      "type": "object",
      "required": ["id", "label", "steps"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "required": ["label", "type"],
      "properties": {
        "label": { "type": "string" },
        "type": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string" },
        "href": { "type": "string" },
        "primary": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": true
}
