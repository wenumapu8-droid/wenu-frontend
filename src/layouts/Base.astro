---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import NewsletterModal from '../components/NewsletterModal.astro';
import Analytics from '../components/Analytics.astro';
import { STORE_ORIGIN } from '../lib/config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Descriptive alt text for the OG image (improves social card a11y). */
  ogImageAlt?: string;
  /** OG image pixel dimensions. Default 1200×630 (standard social card). */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article' | 'product';
  noNav?: boolean;
  noFooter?: boolean;
  /** Hide global overlays (search + newsletter modal) — for immersive/standalone pages. */
  noOverlays?: boolean;
  /** Hide the editorial prefooter quote (Montecino) — for checkout, /p/[slug],
   *  /shop and other commerce pages where the rhythm shouldn't break. */
  noQuote?: boolean;
  /** Optional JSON-LD object to inject as structured data */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** Optional LCP image to preload (with AVIF/WebP source set if both provided). */
  preloadImage?: { avif?: string; webp?: string; alt?: string } | null;
}

const SITE = 'https://wenumapuonline.com';
const {
  title = 'Wenu Mapu — Adornment for the sacred body',
  description = 'Ancestral-cosmic body jewelry forged by hand in Truckee, California. Implant-grade titanium, sterling silver, 14k gold. Ships across the US · Local pickup.',
  ogImage = '/img/hero/hero-portrait.webp',
  ogImageAlt,
  ogImageWidth = 1800,
  ogImageHeight = 900,
  ogType = 'website',
  noNav = false,
  noFooter = false,
  noOverlays = false,
  noQuote = false,
  jsonLd,
  preloadImage = null,
} = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, SITE).toString();
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE).toString();
const ogImageAltText = ogImageAlt || title;

const ldArray = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
  : null;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAltText} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Wenu Mapu" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/png" href="/logos/wenu-mapu-square.png" />
    <link rel="apple-touch-icon" href="/logos/wenu-mapu-square.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index, follow" />

    {/* DNS prefetch + preconnect to third-party origins we always hit */}
    <link rel="preconnect" href={STORE_ORIGIN} crossorigin />
    <link rel="dns-prefetch" href={STORE_ORIGIN} />
    <link rel="dns-prefetch" href="https://formspree.io" />

    {/* Fonts — self-hosted via @fontsource (imported in global.css). No render-blocking CDN. */}

    {preloadImage?.avif && (
      <link rel="preload" as="image" href={preloadImage.avif} type="image/avif" fetchpriority="high" />
    )}
    {preloadImage?.webp && !preloadImage.avif && (
      <link rel="preload" as="image" href={preloadImage.webp} type="image/webp" fetchpriority="high" />
    )}

    {ldArray && ldArray.map(obj => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    <Analytics />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    {!noNav && <Nav />}
    <main id="main">
      <slot />
    </main>
    {!noFooter && <Footer />}
    {!noOverlays && <SearchModal />}
    {!noOverlays && <NewsletterModal />}
    <script>
      // IntersectionObserver-driven fade-in for elements marked with
      // data-fade-in or data-fade-in-stagger. Triggers when ANY pixel enters
      // viewport; respects prefers-reduced-motion (handled via CSS).
      // threshold: 0 critical for tall grids (e.g. HandmadeArchive ~7800px)
      // where 12% would exceed viewport height and observer never fires.
      if ('IntersectionObserver' in window) {
        const targets = document.querySelectorAll('[data-fade-in], [data-fade-in-stagger]');
        if (targets.length > 0) {
          const obs = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            }
          }, { rootMargin: '0px 0px -60px 0px', threshold: 0 });
          targets.forEach(el => obs.observe(el));
        }
      } else {
        document.querySelectorAll('[data-fade-in], [data-fade-in-stagger]')
          .forEach(el => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
