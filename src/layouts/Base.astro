---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  noNav?: boolean;
  noFooter?: boolean;
  /** Optional JSON-LD object to inject as structured data */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** Optional LCP image to preload (with AVIF/WebP source set if both provided). */
  preloadImage?: { avif?: string; webp?: string; alt?: string } | null;
}

const SITE = 'https://wenumapuonline.com';
const {
  title = 'Wenu Mapu — Adornment for the sacred body',
  description = 'Ancestral-cosmic body jewelry forged by hand in Truckee, California. Implant-grade titanium, sterling silver, 14k gold. Ships across the US · Local pickup.',
  ogImage = '/img/hero/hero-portrait.webp',
  ogType = 'website',
  noNav = false,
  noFooter = false,
  jsonLd,
  preloadImage = null,
} = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, SITE).toString();
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE).toString();

const ldArray = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
  : null;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Wenu Mapu" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/png" href="/logos/wenu-mapu-square.png" />
    <link rel="apple-touch-icon" href="/logos/wenu-mapu-square.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#080706" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index, follow" />

    {preloadImage?.avif && (
      <link rel="preload" as="image" href={preloadImage.avif} type="image/avif" fetchpriority="high" />
    )}
    {preloadImage?.webp && !preloadImage.avif && (
      <link rel="preload" as="image" href={preloadImage.webp} type="image/webp" fetchpriority="high" />
    )}

    {ldArray && ldArray.map(obj => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    {!noNav && <Nav />}
    <main id="main">
      <slot />
    </main>
    {!noFooter && <Footer />}
    <SearchModal />
    <script>
      // IntersectionObserver-driven fade-in for elements marked with
      // data-fade-in or data-fade-in-stagger. Triggers once when 12% of the
      // element is in view; respects prefers-reduced-motion (handled via CSS).
      if ('IntersectionObserver' in window) {
        const targets = document.querySelectorAll('[data-fade-in], [data-fade-in-stagger]');
        if (targets.length > 0) {
          const obs = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            }
          }, { rootMargin: '0px 0px -60px 0px', threshold: 0.12 });
          targets.forEach(el => obs.observe(el));
        }
      } else {
        document.querySelectorAll('[data-fade-in], [data-fade-in-stagger]')
          .forEach(el => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
