---
// KODEX SHELL — isolated layout for the audiovisual app. NO commerce components
// (no Cart / checkout / Venmo / Zelle / Mercado Pago / orders). KODEX runs alone.
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {
  title = 'KODEX −∞ · A Living Audiovisual System',
  description = 'KODEX −∞ — a living audiovisual instrument. Sound and graphics respond to your movement.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <!-- KODEX DISPLAY ≈ Space Grotesk (free) · KDX_MONO = JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <style is:global>
      /* KODEX DISPLAY — wordmark + display titles (brand identity) */
      .kxm-mark, .kw-gate__title, .ar-title, .ar-home, .wk-home, .kw-word,
      .kx-word, .kxm-trigger + * { font-family:'Space Grotesk','Instrument Serif',system-ui,sans-serif; }
      .kxm-mark, .kw-gate__title, .ar-title{ font-weight:700; letter-spacing:-.01em; }
    </style>
  </head>
  <body style="margin:0;background:#000;">
    <slot />

    <!-- KODEX crosshair — a cross that spans the screen and follows you (the axis) -->
    <div class="kxc" data-kxc aria-hidden="true"><i class="kxc-h"></i><i class="kxc-v"></i><i class="kxc-o"></i></div>

    <!-- KODEX menu — clean, organized navigation (site-wide, all kodex pages) -->
    <button class="kxm-trigger" data-kxm-open aria-label="menu"><i></i><i></i><i></i></button>
    <nav class="kxm" data-kxm hidden aria-hidden="true">
      <button class="kxm-x" data-kxm-close aria-label="close">✕</button>
      <div class="kxm-inner">
        <p class="kxm-mark">KODEX<span>−∞</span></p>
        <ul class="kxm-nav">
          <li><a href="/kodex/"><span class="kxm-i">01</span> <span class="kxm-t">The Codex</span></a></li>
          <li><a href="/kodex/works/"><span class="kxm-i">02</span> <span class="kxm-t">The Archive</span></a></li>
          <li><a href="/kodex/store/"><span class="kxm-i">03</span> <span class="kxm-t">Store</span> <em>· download free · print / sticker / tee / NFT</em></a></li>
          <li><a href="/kodex/work/001/"><span class="kxm-i">04</span> <span class="kxm-t">Enter a Work</span></a></li>
          <li><a href="/kodex/return/"><span class="kxm-i">05</span> <span class="kxm-t">The Return</span> <em>· complete the cycle</em></a></li>
        </ul>
        <div class="kxm-foot">
          <p class="kxm-state">A living archive of matter, symbol and technology · Nicolás Ortega · Wenu Mapu.<br />Un archivo vivo de materia, símbolo y tecnología.</p>
          <p class="kxm-social">
            <a href="https://instagram.com/wenu.mapu" target="_blank" rel="noopener">Instagram</a> ·
            <a href="https://www.pinterest.com/" target="_blank" rel="noopener">Pinterest</a> ·
            <a href="https://www.behance.net/" target="_blank" rel="noopener">Behance</a> ·
            <a href="mailto:marimari@wenumapuonline.com">Contact</a>
          </p>
          <p class="kxm-cr">© KODEX −∞ · a possibility given form · belongs to no one, and to all.</p>
        </div>
      </div>
    </nav>

    <style is:global>
      /* give page headers room so their tools clear the menu trigger */
      .wk-top, .ar-top, .kw-hud{ padding-right:clamp(58px,8vw,86px) !important; }
      /* while a work's ABOUT modal is open, drop the shell chrome beneath it */
      body:has(.wk-about:not([hidden])) .kxc,
      body:has(.wk-about:not([hidden])) .kxm-trigger{ opacity:0 !important; pointer-events:none !important; }
      /* full-screen crosshair cursor — the axis, in system cyan */
      .kxc{ position:fixed; inset:0; z-index:115; pointer-events:none; opacity:.85; transition:opacity .3s; }
      .kxc-h{ position:absolute; left:0; right:0; top:0; height:1px; transform:translateY(-2px); will-change:transform;
        background:linear-gradient(90deg, transparent, rgba(0,240,255,.22) 12%, rgba(0,240,255,.22) 88%, transparent); }
      .kxc-v{ position:absolute; top:0; bottom:0; left:0; width:1px; transform:translateX(-2px); will-change:transform;
        background:linear-gradient(180deg, transparent, rgba(0,240,255,.22) 12%, rgba(0,240,255,.22) 88%, transparent); }
      .kxc-o{ position:absolute; top:0; left:0; width:16px; height:16px; margin:-8px 0 0 -8px; will-change:transform;
        border:1px solid rgba(0,240,255,.5); border-radius:50%; box-shadow:0 0 10px rgba(0,240,255,.35); }
      .kxc.kxc-hot .kxc-h, .kxc.kxc-hot .kxc-v{ background:linear-gradient(90deg, transparent, rgba(201,168,76,.5) 12%, rgba(201,168,76,.5) 88%, transparent); }
      .kxc.kxc-hot .kxc-v{ background:linear-gradient(180deg, transparent, rgba(201,168,76,.5) 12%, rgba(201,168,76,.5) 88%, transparent); }
      .kxc.kxc-hot .kxc-o{ border-color:rgba(201,168,76,.8); box-shadow:0 0 14px rgba(201,168,76,.5); transform:scale(1.5); }
      @media (hover:none){ .kxc{ display:none; } }
      .kxm-trigger{ position:fixed; top:16px; right:clamp(14px,4vw,40px); z-index:120; width:34px; height:26px;
        display:flex; flex-direction:column; justify-content:center; gap:5px; background:none; border:0; cursor:pointer; padding:0; }
      .kxm-trigger i{ display:block; height:1.5px; width:26px; margin-left:auto; background:#c9a84c; transition:.3s; }
      .kxm-trigger:hover i{ width:26px; background:#f0ede8; }
      .kxm-trigger i:nth-child(2){ width:18px; } .kxm-trigger:hover i:nth-child(2){ width:26px; }
      @media (max-width:640px){ .kxm-trigger{ top:14px; } }

      .kxm{ position:fixed; inset:0; z-index:119; background:rgba(4,4,6,.97); backdrop-filter:blur(10px);
        display:grid; place-items:center; opacity:0; pointer-events:none; transition:opacity .5s ease; }
      .kxm[hidden]{ display:none; }               /* honour the hidden attr over display:grid */
      .kxm[data-open]{ opacity:1; pointer-events:auto; }  /* only capture clicks while open */
      .kxm-x{ position:fixed; top:16px; right:clamp(14px,4vw,40px); z-index:121; font-size:15px; color:#9a948a; background:none; border:0; cursor:pointer; }
      .kxm-x:hover{ color:#f0ede8; }
      .kxm-inner{ width:min(90vw,760px); padding:0 24px; }
      .kxm-mark{ font-family:'Instrument Serif',serif; font-size:clamp(2rem,6vw,3.2rem); color:#f0ede8; margin:0 0 clamp(24px,5vh,44px); }
      .kxm-mark span{ color:#8f8f8f; }
      .kxm-nav{ list-style:none; margin:0; padding:0; }
      .kxm-nav li{ border-top:1px solid #1c1c1c; }
      .kxm-nav li:last-child{ border-bottom:1px solid #1c1c1c; }
      .kxm-nav a{ display:flex; align-items:baseline; gap:18px; padding:clamp(14px,2.4vh,22px) 4px; color:#c8c2b6;
        font-family:'Instrument Serif',serif; font-size:clamp(1.5rem,4vw,2.4rem); text-decoration:none; transition:padding-left .35s, color .35s; }
      .kxm-nav a:hover{ padding-left:18px; color:#f0ede8; }
      .kxm-nav a:hover .kxm-i{ color:#00f0ff; text-shadow:0 0 10px rgba(0,240,255,.5); }
      .kxm-t{ transition:color .2s; }
      .kxm-nav a:hover .kxm-t{ color:#f0ede8; }
      .kxm-i{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.2em; color:#c9a84c; transition:color .25s, text-shadow .25s; }
      .kxm-nav em{ font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.1em; color:#585858; font-style:normal; }
      .kxm-foot{ margin:clamp(30px,6vh,54px) 0 0; }
      .kxm-state{ font-family:'Cormorant Garamond',serif; font-size:14px; line-height:1.6; color:#8f8f8f; margin:0; }
      .kxm-social{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.12em; margin:18px 0 0; }
      .kxm-social a{ color:#c9a84c; text-decoration:none; } .kxm-social a:hover{ color:#f0ede8; }
      .kxm-cr{ font-family:'JetBrains Mono',monospace; font-size:9.5px; letter-spacing:.1em; color:#3a3a3a; margin:16px 0 0; }
    </style>
    <script is:inline>
      (() => {
        const menu = document.querySelector('[data-kxm]');
        const open = () => { menu.hidden = false; requestAnimationFrame(() => menu.setAttribute('data-open', '')); menu.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; };
        const close = () => { menu.removeAttribute('data-open'); menu.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; setTimeout(() => { menu.hidden = true; }, 500); };
        document.querySelector('[data-kxm-open]').addEventListener('click', open);
        document.querySelector('[data-kxm-close]').addEventListener('click', close);
        menu.addEventListener('click', (e) => { if (e.target === menu) close(); });
        addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
        // COEVAL-style bar interaction — nav labels glitch/decode on hover
        const GLY = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789∞ΩΔ/#·';
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.querySelectorAll('.kxm-t').forEach((el) => {
          const link = el.closest('a'); const t = el.textContent;
          const scr = () => { const t0 = performance.now(); clearInterval(el.__g); el.__g = setInterval(() => { const p = Math.min(1, (performance.now() - t0) / 380); let o = ''; for (let i = 0; i < t.length; i++) o += t[i] === ' ' ? ' ' : (i / t.length < p ? t[i] : GLY[Math.random() * GLY.length | 0]); el.textContent = o; if (p >= 1) clearInterval(el.__g); }, 28); };
          if (!reduce) link.addEventListener('mouseenter', scr);
        });
        // crosshair cursor — a cross that spans the screen and follows you
        const kxc = document.querySelector('[data-kxc]');
        if (kxc && matchMedia('(hover:hover)').matches) {
          const h = kxc.querySelector('.kxc-h'), v = kxc.querySelector('.kxc-v'), o = kxc.querySelector('.kxc-o');
          let x = innerWidth / 2, y = innerHeight / 2, tx = x, ty = y;
          addEventListener('mousemove', (e) => { tx = e.clientX; ty = e.clientY; }, { passive: true });
          const loop = () => { x += (tx - x) * 0.4; y += (ty - y) * 0.4; h.style.transform = 'translateY(' + y + 'px)'; v.style.transform = 'translateX(' + x + 'px)'; o.style.transform = 'translate(' + x + 'px,' + y + 'px)'; requestAnimationFrame(loop); };
          loop();
          const hot = 'a,button,input,textarea,[role=button],.ar-cell,.wk-work,.kxm-trigger,.kw-dbtn,.wk-act,.wk-chip,.kxm-nav a';
          document.addEventListener('mouseover', (e) => { if (e.target.closest(hot)) kxc.classList.add('kxc-hot'); }, { passive: true });
          document.addEventListener('mouseout', (e) => { if (e.target.closest(hot)) kxc.classList.remove('kxc-hot'); }, { passive: true });
        }
      })();
    </script>
    <script>
      // record the journey across every KODEX world (feeds the RETURN specimen)
      import { record } from '../kodex/return/memory.js';
      try { record({ type: 'view', work: location.pathname }); } catch (e) {}
    </script>
  </body>
</html>
