{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodex.local/schema/kdx-element-contract-v0.1.json",
  "title": "KODEX ElementContract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "element_id",
    "family",
    "version",
    "status",
    "allowed_plate_types",
    "allowed_scene_roles",
    "semantic_role",
    "slot_types",
    "geometry",
    "responsive_behavior",
    "states",
    "inputs_tokens",
    "motion_cost",
    "fallback",
    "accessibility",
    "provenance",
    "rights",
    "incompatibilities",
    "source_ref"
  ],
  "properties": {
    "element_id": { "type": "string", "minLength": 3 },
    "family": {
      "type": "string",
      "enum": ["GRID", "MOTION", "EFFECT", "STRUCTURE", "GLYPH", "DATA_UI", "SURFACE_FX", "NAVIGATION", "FALLBACK", "PLATE_TEMPLATE", "OPERATIONAL_GRAPHIC"]
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": {
      "type": "string",
      "enum": ["PRODUCTION_CANDIDATE", "IMPLEMENTED_CANDIDATE", "IMPLEMENTED", "TESTED", "CANON_CANDIDATE", "DEPRECATED", "HOLD"]
    },
    "allowed_plate_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["KNOWLEDGE_PLATE", "JUNCTION_PLATE", "ACTIVATOR_PLATE"] }
    },
    "allowed_scene_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "semantic_role": { "type": "string", "minLength": 2 },
    "slot_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_size", "max_size", "aspect_behavior"],
      "properties": {
        "min_size": { "type": "string" },
        "max_size": { "type": "string" },
        "aspect_behavior": { "type": "string", "enum": ["FLEXIBLE", "PRESERVE", "DECLARED_ASPECTS", "FULL_VIEW_CONTAIN", "N_A"] }
      }
    },
    "responsive_behavior": { "type": "string", "minLength": 2 },
    "states": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "inputs_tokens": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "motion_cost": { "type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH"] },
    "fallback": { "type": "string", "minLength": 2 },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyboard_safe", "touch_safe", "reduced_motion", "meaning_preserved_without_motion"],
      "properties": {
        "keyboard_safe": { "type": "boolean" },
        "touch_safe": { "type": "boolean" },
        "reduced_motion": { "type": "string" },
        "meaning_preserved_without_motion": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status"],
      "properties": {
        "kind": { "type": "string", "enum": ["REPO_SOURCE", "DRIVE_SOURCE", "CANON_DOC", "EXTERNAL_REFERENCE"] },
        "status": { "type": "string", "enum": ["VERIFIED", "NEEDS_CONFIRMATION", "REFERENCE_ONLY"] }
      }
    },
    "rights": { "type": "string", "enum": ["PROJECT_SOURCE", "OCIN_AUTHORIAL", "REFERENCE_ONLY", "NEEDS_CONFIRMATION"] },
    "incompatibilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "source_ref": { "type": "string", "minLength": 3 }
  }
}
