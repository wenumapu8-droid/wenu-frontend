{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenumapuonline.com/schemas/kdx-visual-grammar.schema.json",
  "title": "KODEX Visual Grammar Record",
  "type": "object",
  "required": [
    "id",
    "source",
    "semantics",
    "composition",
    "palette",
    "typography",
    "geometry",
    "texture",
    "motion",
    "derivation",
    "generation"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "semantics": {
      "type": "object"
    },
    "composition": {
      "type": "object",
      "required": [
        "grid_id",
        "columns",
        "rows",
        "zones"
      ],
      "properties": {
        "grid_id": {
          "type": "string"
        },
        "columns": {
          "type": "integer"
        },
        "rows": {
          "type": "integer"
        },
        "margin_pct": {
          "type": "number"
        },
        "gutter_pct": {
          "type": "number"
        },
        "density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "negative_space_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "quadrant_density": {
          "type": "object"
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/zone"
          }
        }
      }
    },
    "palette": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "array"
        },
        "coverage_pct": {
          "type": "object"
        },
        "contrast_level": {
          "type": "number"
        }
      }
    },
    "typography": {
      "type": "object"
    },
    "geometry": {
      "type": "object"
    },
    "texture": {
      "type": "object"
    },
    "motion": {
      "type": "object",
      "properties": {
        "profile_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/motionLayer"
          }
        }
      }
    },
    "derivation": {
      "type": "object",
      "required": [
        "transfer_rule",
        "forbidden_literal_reuse",
        "allowed_abstractions"
      ],
      "properties": {
        "transfer_rule": {
          "type": "string"
        },
        "forbidden_literal_reuse": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_abstractions": {
          "type": "array",
          "items": {
            "enum": [
              "grid",
              "color_ratio",
              "reading_path",
              "density",
              "motion_tempo",
              "primitive_family",
              "hierarchy",
              "negative_space",
              "semantic_role"
            ]
          }
        },
        "similarity_ceiling": {
          "type": "number",
          "default": 0.35
        }
      }
    },
    "generation": {
      "type": "object",
      "properties": {
        "recipe_id": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "renderer": {
          "enum": [
            "dom_svg",
            "canvas_2d",
            "webgl",
            "hybrid"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "zone": {
      "type": "object",
      "required": [
        "id",
        "type",
        "x",
        "y",
        "w",
        "h",
        "z",
        "priority",
        "occupancy",
        "color_role",
        "motion_role"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "priority": {
          "type": "number"
        },
        "occupancy": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "color_role": {
          "type": "string"
        },
        "motion_role": {
          "type": "string"
        },
        "anchor": {
          "type": "string"
        }
      }
    },
    "motionLayer": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "behavior": {
          "type": "string"
        },
        "speed_sec": {
          "type": "number"
        },
        "amplitude": {
          "type": "number"
        },
        "trigger": {
          "type": "string"
        },
        "loop": {
          "type": "boolean"
        },
        "priority": {
          "type": "string"
        },
        "reduced_motion_fallback": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}